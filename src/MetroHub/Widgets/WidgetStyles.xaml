<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:widgets="clr-namespace:MetroHub.Widgets"
                    xmlns:controls="clr-namespace:MetroHub.Presentation.Controls"
                    xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml">

    <!-- Fallback Design Tokens for Parse-Time Safety -->
    <CornerRadius x:Key="ControlCornerRadius">2</CornerRadius>
    <SolidColorBrush x:Key="FluentHoverBrush" Color="#12FFFFFF" />
    <SolidColorBrush x:Key="FluentPressedBrush" Color="#1EFFFFFF" />

    <!-- 
        Shared WidgetCard Shell Style (Phase 0.2)
        Consistent dark card surface, hairline border, uniform corner radius, and internal padding.
        Every widget DataTemplate wraps its interior content in this shell.
    -->
    <Style x:Key="WidgetCardStyle" TargetType="{x:Type widgets:WidgetCard}">
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="BorderBrush" Value="Transparent" />
        <Setter Property="BorderThickness" Value="0" />
        <Setter Property="CornerRadius" Value="2" />
        <Setter Property="Padding" Value="10" />
        <Setter Property="SnapsToDevicePixels" Value="True" />
        <Setter Property="UseLayoutRounding" Value="True" />
        <Setter Property="Focusable" Value="False" />
        <Setter Property="HorizontalContentAlignment" Value="Stretch" />
        <Setter Property="VerticalContentAlignment" Value="Stretch" />
        <Setter Property="RenderOptions.ClearTypeHint" Value="Enabled" />
        <Setter Property="TextOptions.TextFormattingMode" Value="Ideal" />
        <Setter Property="TextOptions.TextRenderingMode" Value="ClearType" />
        <Setter Property="TextOptions.TextHintingMode" Value="Fixed" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="{x:Type widgets:WidgetCard}">
                    <Border Background="{TemplateBinding Background}"
                            BorderBrush="{TemplateBinding BorderBrush}"
                            BorderThickness="{TemplateBinding BorderThickness}"
                            CornerRadius="{TemplateBinding CornerRadius}"
                            RenderOptions.ClearTypeHint="Enabled"
                            SnapsToDevicePixels="True"
                            UseLayoutRounding="True">
                        <ContentPresenter Margin="{TemplateBinding Padding}"
                                          Content="{TemplateBinding Content}"
                                          ContentTemplate="{TemplateBinding ContentTemplate}"
                                          ContentStringFormat="{TemplateBinding ContentStringFormat}"
                                          HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}"
                                          VerticalAlignment="{TemplateBinding VerticalContentAlignment}"
                                          SnapsToDevicePixels="True"
                                          UseLayoutRounding="True" />
                    </Border>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- Implicit default style for WidgetCard -->
    <Style TargetType="{x:Type widgets:WidgetCard}" BasedOn="{StaticResource WidgetCardStyle}" />

    <!-- 
        Shared WidgetSegmentedItem Style
        Clean borderless typography with Fluent glass hover reveal and selection state.
    -->
    <Style x:Key="WidgetSegmentedItemStyle" TargetType="{x:Type widgets:WidgetSegmentedItem}">
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="BorderThickness" Value="0" />
        <Setter Property="Foreground" Value="#70FFFFFF" />
        <Setter Property="FontSize" Value="12" />
        <Setter Property="FontWeight" Value="SemiBold" />
        <Setter Property="Height" Value="28" />
        <Setter Property="Cursor" Value="Hand" />
        <Setter Property="Focusable" Value="False" />
        <Setter Property="FocusVisualStyle" Value="{x:Null}" />
        <Setter Property="HorizontalContentAlignment" Value="Center" />
        <Setter Property="VerticalContentAlignment" Value="Center" />
        <Setter Property="Tag" Value="InteractiveControl" />
        <Setter Property="SnapsToDevicePixels" Value="True" />
        <Setter Property="UseLayoutRounding" Value="True" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="{x:Type widgets:WidgetSegmentedItem}">
                    <Border x:Name="ButtonBackground"
                            Background="{TemplateBinding Background}"
                            CornerRadius="{DynamicResource ControlCornerRadius}"
                            SnapsToDevicePixels="True">
                        <ContentPresenter HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}"
                                          VerticalAlignment="{TemplateBinding VerticalContentAlignment}"
                                          SnapsToDevicePixels="True" />
                    </Border>
                    <ControlTemplate.Triggers>
                        <!-- Hover state: soft text brighten, subtle glass sheen, zero borders -->
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="ButtonBackground" Property="Background" Value="{DynamicResource FluentHoverBrush}" />
                            <Setter Property="Foreground" Value="#E0FFFFFF" />
                        </Trigger>
                        <!-- Pressed state -->
                        <Trigger Property="IsPressed" Value="True">
                            <Setter TargetName="ButtonBackground" Property="Background" Value="{DynamicResource FluentPressedBrush}" />
                            <Setter Property="Foreground" Value="#FFFFFF" />
                        </Trigger>
                        <!-- Selected state: bright pure white text -->
                        <Trigger Property="IsSelected" Value="True">
                            <Setter Property="Foreground" Value="#FFFFFF" />
                        </Trigger>
                        <!-- Selected + Hover -->
                        <MultiTrigger>
                            <MultiTrigger.Conditions>
                                <Condition Property="IsMouseOver" Value="True" />
                                <Condition Property="IsSelected" Value="True" />
                            </MultiTrigger.Conditions>
                            <Setter TargetName="ButtonBackground" Property="Background" Value="{DynamicResource FluentHoverBrush}" />
                            <Setter Property="Foreground" Value="#FFFFFF" />
                        </MultiTrigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style TargetType="{x:Type widgets:WidgetSegmentedItem}" BasedOn="{StaticResource WidgetSegmentedItemStyle}" />

    <!-- 
        Shared WidgetSegmentedControl Style
        Modular segmented toggle / tab bar with built-in Fluent sliding active indicator.
    -->
    <Style x:Key="WidgetSegmentedControlStyle" TargetType="{x:Type widgets:WidgetSegmentedControl}">
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="BorderThickness" Value="0" />
        <Setter Property="Height" Value="28" />
        <Setter Property="Focusable" Value="False" />
        <Setter Property="Tag" Value="InteractiveControl" />
        <Setter Property="SnapsToDevicePixels" Value="True" />
        <Setter Property="UseLayoutRounding" Value="True" />
        <Setter Property="ItemsPanel">
            <Setter.Value>
                <ItemsPanelTemplate>
                    <UniformGrid Rows="1" SnapsToDevicePixels="True" />
                </ItemsPanelTemplate>
            </Setter.Value>
        </Setter>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="{x:Type widgets:WidgetSegmentedControl}">
                    <Grid x:Name="PART_HostGrid" Background="Transparent" SnapsToDevicePixels="True">
                        <!-- Segment Items Host -->
                        <ItemsPresenter SnapsToDevicePixels="True" />

                        <!-- Sliding Active Indicator (Hardware BitmapCached for silky 120fps GPU translation) -->
                        <Border x:Name="PART_SlidingIndicator"
                                Height="{TemplateBinding IndicatorHeight}"
                                VerticalAlignment="Bottom"
                                HorizontalAlignment="Left"
                                Width="0"
                                Background="{TemplateBinding IndicatorBrush}"
                                CornerRadius="{TemplateBinding IndicatorCornerRadius}"
                                Opacity="0"
                                Panel.ZIndex="25"
                                SnapsToDevicePixels="True">
                            <Border.CacheMode>
                                <BitmapCache EnableClearType="False" RenderAtScale="1" SnapsToDevicePixels="True" />
                            </Border.CacheMode>
                            <Border.RenderTransform>
                                <TranslateTransform x:Name="PART_IndicatorTransform" X="0" />
                            </Border.RenderTransform>
                            <Border.Effect>
                                <DropShadowEffect Color="{Binding IndicatorShadowColor, RelativeSource={RelativeSource TemplatedParent}}"
                                                  BlurRadius="{Binding IndicatorShadowBlurRadius, RelativeSource={RelativeSource TemplatedParent}}"
                                                  ShadowDepth="0"
                                                  Opacity="0.8"
                                                  RenderingBias="Performance" />
                            </Border.Effect>
                        </Border>
                    </Grid>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style TargetType="{x:Type widgets:WidgetSegmentedControl}" BasedOn="{StaticResource WidgetSegmentedControlStyle}" />

    <!-- 
        Shared WidgetTile Style
        Header action tile with Segoe Fluent Icon, Header label, glass hover reveal, and borderless adjacent layout.
    -->
    <Style x:Key="WidgetTileStyle" TargetType="{x:Type widgets:WidgetTile}">
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="BorderBrush" Value="Transparent" />
        <Setter Property="BorderThickness" Value="1,0,1,0" />
        <Setter Property="Margin" Value="-1,0,0,0" />
        <Setter Property="Height" Value="76" />
        <Setter Property="Foreground" Value="#FFFFFF" />
        <Setter Property="IconSize" Value="24" />
        <Setter Property="Cursor" Value="Hand" />
        <Setter Property="Focusable" Value="False" />
        <Setter Property="FocusVisualStyle" Value="{x:Null}" />
        <Setter Property="HorizontalContentAlignment" Value="Center" />
        <Setter Property="VerticalContentAlignment" Value="Center" />
        <Setter Property="Tag" Value="InteractiveControl" />
        <Setter Property="SnapsToDevicePixels" Value="True" />
        <Setter Property="UseLayoutRounding" Value="True" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="{x:Type widgets:WidgetTile}">
                    <Border x:Name="TileBorder"
                            Background="{TemplateBinding Background}"
                            BorderBrush="{TemplateBinding BorderBrush}"
                            BorderThickness="{TemplateBinding BorderThickness}"
                            SnapsToDevicePixels="True"
                            UseLayoutRounding="True">
                        <Grid HorizontalAlignment="Stretch"
                              VerticalAlignment="Center"
                              Margin="0,0,0,2"
                              SnapsToDevicePixels="True">
                            <Grid.RowDefinitions>
                                <!-- Fixed 28px height for optical icon center -->
                                <RowDefinition Height="28" />
                                <!-- Fixed 5px spacing -->
                                <RowDefinition Height="5" />
                                <!-- Fixed 18px height for text baseline -->
                                <RowDefinition Height="18" />
                            </Grid.RowDefinitions>

                            <!-- Standardized Icon / Symbol: Centered in exact 28x28 box -->
                            <Grid Grid.Row="0"
                                  HorizontalAlignment="Center"
                                  VerticalAlignment="Center"
                                  SnapsToDevicePixels="True">
                                <!-- Primary: Fluent System Icon (standardized 24px grid) -->
                                <ui:SymbolIcon x:Name="PART_SymbolIcon"
                                               Symbol="{TemplateBinding Symbol}"
                                               FontSize="{TemplateBinding IconSize}"
                                               Foreground="{TemplateBinding Foreground}"
                                               HorizontalAlignment="Center"
                                               VerticalAlignment="Center"
                                               SnapsToDevicePixels="True"
                                               Visibility="Collapsed" />

                                <!-- Fallback / Custom Visual / Segoe Glyph Icon -->
                                <ContentControl x:Name="PART_IconContent"
                                                Content="{TemplateBinding Icon}"
                                                FontFamily="{DynamicResource AppIconFontFamily}"
                                                FontSize="{TemplateBinding IconSize}"
                                                Foreground="{TemplateBinding Foreground}"
                                                HorizontalAlignment="Center"
                                                VerticalAlignment="Center"
                                                SnapsToDevicePixels="True" />
                            </Grid>

                            <!-- Header Text: Pinned to exact identical baseline across every single tile -->
                            <TextBlock Grid.Row="2"
                                       Text="{TemplateBinding Header}"
                                       FontSize="11.5"
                                       FontWeight="SemiBold"
                                       Foreground="#FFFFFF"
                                       HorizontalAlignment="Center"
                                       VerticalAlignment="Center"
                                       TextAlignment="Center"
                                       SnapsToDevicePixels="True" />
                        </Grid>
                    </Border>
                    <ControlTemplate.Triggers>
                        <!-- Automatically activate SymbolIcon when Symbol property is populated -->
                        <Trigger Property="HasSymbol" Value="True">
                            <Setter TargetName="PART_SymbolIcon" Property="Visibility" Value="Visible" />
                            <Setter TargetName="PART_IconContent" Property="Visibility" Value="Collapsed" />
                        </Trigger>
                        <!-- Hover state: illuminates continuous vertical dividing borders without any background highlight -->
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="TileBorder" Property="BorderBrush" Value="#55FFFFFF" />
                            <Setter Property="Panel.ZIndex" Value="10" />
                        </Trigger>
                        <!-- Pressed state -->
                        <Trigger Property="IsPressed" Value="True">
                            <Setter TargetName="TileBorder" Property="BorderBrush" Value="#75FFFFFF" />
                            <Setter Property="Panel.ZIndex" Value="10" />
                        </Trigger>
                        <!-- Disabled state -->
                        <Trigger Property="IsEnabled" Value="False">
                            <Setter Property="Opacity" Value="0.3" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style TargetType="{x:Type widgets:WidgetTile}" BasedOn="{StaticResource WidgetTileStyle}" />

    <!-- 
        Shared WidgetTiles Style
        Container for WidgetTile items with continuous 1px bottom border and Fluent reveal + 120fps sliding indicator.
    -->
    <Style x:Key="WidgetTilesStyle" TargetType="{x:Type widgets:WidgetTiles}">
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="BorderThickness" Value="0" />
        <Setter Property="Height" Value="76" />
        <Setter Property="Focusable" Value="False" />
        <Setter Property="Tag" Value="InteractiveControl" />
        <Setter Property="SnapsToDevicePixels" Value="True" />
        <Setter Property="UseLayoutRounding" Value="True" />
        <Setter Property="ItemsPanel">
            <Setter.Value>
                <ItemsPanelTemplate>
                    <UniformGrid Rows="1" SnapsToDevicePixels="True" />
                </ItemsPanelTemplate>
            </Setter.Value>
        </Setter>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="{x:Type widgets:WidgetTiles}">
                    <Grid x:Name="PART_HostGrid" Background="Transparent" SnapsToDevicePixels="True">
                        <!-- Tiles Host -->
                        <ItemsPresenter SnapsToDevicePixels="True" />

                        <!-- Continuous 1px bottom border across all tiles with Fluent Reveal mouse tracking -->
                        <Grid VerticalAlignment="Bottom" Height="1" SnapsToDevicePixels="True">
                            <Border Background="#22FFFFFF" SnapsToDevicePixels="True" />
                            <Border x:Name="PART_BottomRevealBorder" SnapsToDevicePixels="True" Opacity="0">
                                <Border.Background>
                                    <RadialGradientBrush x:Name="PART_BottomRevealBrush" MappingMode="Absolute" RadiusX="160" RadiusY="160">
                                        <GradientStop Color="#FFFFFFFF" Offset="0.0" />
                                        <GradientStop Color="#60FFFFFF" Offset="0.5" />
                                        <GradientStop Color="#00000000" Offset="1.0" />
                                    </RadialGradientBrush>
                                </Border.Background>
                            </Border>
                        </Grid>

                        <!-- Hardware-Accelerated Sliding Colored Active Indicator -->
                        <Border x:Name="PART_SlidingIndicator"
                                Height="{TemplateBinding IndicatorHeight}"
                                VerticalAlignment="Bottom"
                                HorizontalAlignment="Left"
                                Width="0"
                                CornerRadius="{TemplateBinding IndicatorCornerRadius}"
                                Opacity="0"
                                Panel.ZIndex="25"
                                SnapsToDevicePixels="True">
                            <Border.RenderTransform>
                                <TranslateTransform x:Name="PART_IndicatorTransform" X="0" />
                            </Border.RenderTransform>
                            <Border.Effect>
                                <DropShadowEffect x:Name="PART_IndicatorShadow"
                                                  Color="#00E676"
                                                  BlurRadius="8"
                                                  ShadowDepth="0"
                                                  Opacity="0.8"
                                                  RenderingBias="Performance" />
                            </Border.Effect>
                        </Border>
                    </Grid>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style TargetType="{x:Type widgets:WidgetTiles}" BasedOn="{StaticResource WidgetTilesStyle}" />

    <!-- ========================================================================= -->
    <!-- SHARED FLUENT FLOATING SCROLLBAR SYSTEM (Phase 0.2 Design System)         -->
    <!-- ========================================================================= -->
    <!-- 
        Standard Across All MetroHub Widgets (Network, Volume, Notepad, etc.):
        - Width / Thickness: 4px Ultra-Slim Floating Pill.
        - CornerRadius: 2px (full pill rounding).
        - Track: 100% Transparent, zero border, zero background gutter.
        - Resting State: Invisible (Opacity="0.0") so content stays clean and uninterrupted.
        - Interaction: Auto-reveals on hover/scroll via AutoHideScrollBehavior.
        - Colors: #40FFFFFF (resting thumb), #90FFFFFF (hover), #D0FFFFFF (active dragging).

        USAGE IN WIDGETS:
        1. On any ScrollViewer:
           Style="{StaticResource WidgetFloatingScrollViewerStyle}"
           (Automatically applies 4px scrollbar, AutoHideScrollBehavior, and disabled horizontal scrolling).

        2. On any ListView / ListBox / ItemsControl with built-in ScrollViewer:
           controls:AutoHideScrollBehavior.IsEnabled="True"
           And ensure local or implicit Style targets ScrollBar with BasedOn="{StaticResource WidgetFloatingScrollBarStyle}".

        3. On any TextBox (e.g., multi-line notes editor):
           controls:AutoHideScrollBehavior.IsEnabled="True"
           And ensure local or implicit Style targets ScrollBar with BasedOn="{StaticResource WidgetFloatingScrollBarStyle}".
    -->

    <!-- 4px Ultra-Slim Floating ScrollBar (Vertical & Horizontal support) with Smooth Expand-on-Hover -->
    <Style x:Key="WidgetFloatingScrollBarStyle" TargetType="{x:Type ScrollBar}">
        <Setter Property="OverridesDefaultStyle" Value="True" />
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="BorderThickness" Value="0" />
        <Setter Property="Width" Value="10" />
        <Setter Property="MinWidth" Value="10" />
        <Setter Property="Opacity" Value="0.0" />
        <Setter Property="SnapsToDevicePixels" Value="True" />
        <Setter Property="FocusVisualStyle" Value="{x:Null}" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="{x:Type ScrollBar}">
                    <Grid Background="Transparent">
                        <Track x:Name="PART_Track" IsDirectionReversed="True" Focusable="False">
                            <Track.Thumb>
                                <Thumb x:Name="Thumb" Focusable="False">
                                    <Thumb.Template>
                                        <ControlTemplate TargetType="{x:Type Thumb}">
                                            <Grid Background="Transparent">
                                                <Border x:Name="ThumbBorder"
                                                        Width="4"
                                                        HorizontalAlignment="Right"
                                                        Margin="0,2,1,2"
                                                        Background="#45FFFFFF"
                                                        CornerRadius="2"
                                                        SnapsToDevicePixels="True" />
                                            </Grid>
                                            <ControlTemplate.Triggers>
                                                <Trigger Property="Tag" Value="Expanded">
                                                    <Trigger.EnterActions>
                                                        <BeginStoryboard>
                                                            <Storyboard>
                                                                <DoubleAnimation Storyboard.TargetName="ThumbBorder"
                                                                                 Storyboard.TargetProperty="Width"
                                                                                 To="8"
                                                                                 Duration="0:0:0.12">
                                                                    <DoubleAnimation.EasingFunction>
                                                                        <CubicEase EasingMode="EaseOut" />
                                                                    </DoubleAnimation.EasingFunction>
                                                                </DoubleAnimation>
                                                            </Storyboard>
                                                        </BeginStoryboard>
                                                    </Trigger.EnterActions>
                                                    <Trigger.ExitActions>
                                                        <BeginStoryboard>
                                                            <Storyboard>
                                                                <DoubleAnimation Storyboard.TargetName="ThumbBorder"
                                                                                 Storyboard.TargetProperty="Width"
                                                                                 To="4"
                                                                                 Duration="0:0:0.16">
                                                                    <DoubleAnimation.EasingFunction>
                                                                        <CubicEase EasingMode="EaseOut" />
                                                                    </DoubleAnimation.EasingFunction>
                                                                </DoubleAnimation>
                                                            </Storyboard>
                                                        </BeginStoryboard>
                                                    </Trigger.ExitActions>
                                                    <Setter TargetName="ThumbBorder" Property="Background" Value="#95FFFFFF" />
                                                    <Setter TargetName="ThumbBorder" Property="CornerRadius" Value="4" />
                                                </Trigger>
                                                <Trigger Property="IsMouseOver" Value="True">
                                                    <Setter TargetName="ThumbBorder" Property="Width" Value="8" />
                                                    <Setter TargetName="ThumbBorder" Property="CornerRadius" Value="4" />
                                                    <Setter TargetName="ThumbBorder" Property="Background" Value="#95FFFFFF" />
                                                </Trigger>
                                                <Trigger Property="IsDragging" Value="True">
                                                    <Setter TargetName="ThumbBorder" Property="Width" Value="8" />
                                                    <Setter TargetName="ThumbBorder" Property="CornerRadius" Value="4" />
                                                    <Setter TargetName="ThumbBorder" Property="Background" Value="#D0FFFFFF" />
                                                </Trigger>
                                            </ControlTemplate.Triggers>
                                        </ControlTemplate>
                                    </Thumb.Template>
                                </Thumb>
                            </Track.Thumb>
                        </Track>
                    </Grid>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="Thumb" Property="Tag" Value="Expanded" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
        <Style.Triggers>
            <Trigger Property="Orientation" Value="Horizontal">
                <Setter Property="Width" Value="Auto" />
                <Setter Property="MinWidth" Value="0" />
                <Setter Property="Height" Value="10" />
                <Setter Property="MinHeight" Value="10" />
                <Setter Property="Template">
                    <Setter.Value>
                        <ControlTemplate TargetType="{x:Type ScrollBar}">
                            <Grid Background="Transparent">
                                <Track x:Name="PART_Track" Focusable="False">
                                    <Track.Thumb>
                                        <Thumb x:Name="Thumb" Focusable="False">
                                            <Thumb.Template>
                                                <ControlTemplate TargetType="{x:Type Thumb}">
                                                    <Grid Background="Transparent">
                                                        <Border x:Name="ThumbBorder"
                                                                Height="4"
                                                                VerticalAlignment="Bottom"
                                                                Margin="2,0,2,1"
                                                                Background="#45FFFFFF"
                                                                CornerRadius="2"
                                                                SnapsToDevicePixels="True" />
                                                    </Grid>
                                                    <ControlTemplate.Triggers>
                                                        <Trigger Property="Tag" Value="Expanded">
                                                            <Trigger.EnterActions>
                                                                <BeginStoryboard>
                                                                    <Storyboard>
                                                                        <DoubleAnimation Storyboard.TargetName="ThumbBorder"
                                                                                         Storyboard.TargetProperty="Height"
                                                                                         To="8"
                                                                                         Duration="0:0:0.12">
                                                                            <DoubleAnimation.EasingFunction>
                                                                                <CubicEase EasingMode="EaseOut" />
                                                                            </DoubleAnimation.EasingFunction>
                                                                        </DoubleAnimation>
                                                                    </Storyboard>
                                                                </BeginStoryboard>
                                                            </Trigger.EnterActions>
                                                            <Trigger.ExitActions>
                                                                <BeginStoryboard>
                                                                    <Storyboard>
                                                                        <DoubleAnimation Storyboard.TargetName="ThumbBorder"
                                                                                         Storyboard.TargetProperty="Height"
                                                                                         To="4"
                                                                                         Duration="0:0:0.16">
                                                                            <DoubleAnimation.EasingFunction>
                                                                                <CubicEase EasingMode="EaseOut" />
                                                                            </DoubleAnimation.EasingFunction>
                                                                        </DoubleAnimation>
                                                                    </Storyboard>
                                                                </BeginStoryboard>
                                                            </Trigger.ExitActions>
                                                            <Setter TargetName="ThumbBorder" Property="Background" Value="#95FFFFFF" />
                                                            <Setter TargetName="ThumbBorder" Property="CornerRadius" Value="4" />
                                                        </Trigger>
                                                        <Trigger Property="IsMouseOver" Value="True">
                                                            <Setter TargetName="ThumbBorder" Property="Height" Value="8" />
                                                            <Setter TargetName="ThumbBorder" Property="CornerRadius" Value="4" />
                                                            <Setter TargetName="ThumbBorder" Property="Background" Value="#95FFFFFF" />
                                                        </Trigger>
                                                        <Trigger Property="IsDragging" Value="True">
                                                            <Setter TargetName="ThumbBorder" Property="Height" Value="8" />
                                                            <Setter TargetName="ThumbBorder" Property="CornerRadius" Value="4" />
                                                            <Setter TargetName="ThumbBorder" Property="Background" Value="#D0FFFFFF" />
                                                        </Trigger>
                                                    </ControlTemplate.Triggers>
                                                </ControlTemplate>
                                            </Thumb.Template>
                                        </Thumb>
                                    </Track.Thumb>
                                </Track>
                            </Grid>
                            <ControlTemplate.Triggers>
                                <Trigger Property="IsMouseOver" Value="True">
                                    <Setter TargetName="Thumb" Property="Tag" Value="Expanded" />
                                </Trigger>
                            </ControlTemplate.Triggers>
                        </ControlTemplate>
                    </Setter.Value>
                </Setter>
            </Trigger>
        </Style.Triggers>
    </Style>

    <!-- Shared Floating ScrollViewer Style: Auto-attaches AutoHideScrollBehavior and 4px floating scrollbar -->
    <Style x:Key="WidgetFloatingScrollViewerStyle" TargetType="{x:Type ScrollViewer}">
        <Setter Property="OverridesDefaultStyle" Value="True" />
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="BorderBrush" Value="Transparent" />
        <Setter Property="BorderThickness" Value="0" />
        <Setter Property="HorizontalScrollBarVisibility" Value="Disabled" />
        <Setter Property="VerticalScrollBarVisibility" Value="Auto" />
        <Setter Property="Focusable" Value="False" />
        <Setter Property="FocusVisualStyle" Value="{x:Null}" />
        <Setter Property="controls:AutoHideScrollBehavior.IsEnabled" Value="True" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="{x:Type ScrollViewer}">
                    <Grid Background="Transparent" SnapsToDevicePixels="True">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <ScrollContentPresenter Grid.Column="0"
                                               Margin="{TemplateBinding Padding}"
                                               CanContentScroll="{TemplateBinding CanContentScroll}" />
                        <ScrollBar Grid.Column="1"
                                   x:Name="PART_VerticalScrollBar"
                                   Style="{StaticResource WidgetFloatingScrollBarStyle}"
                                   Value="{TemplateBinding VerticalOffset}"
                                   Maximum="{TemplateBinding ScrollableHeight}"
                                   ViewportSize="{TemplateBinding ViewportHeight}"
                                   Visibility="{TemplateBinding ComputedVerticalScrollBarVisibility}"
                                   Margin="0,0,0,0" />
                    </Grid>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

</ResourceDictionary>
