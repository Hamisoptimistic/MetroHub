<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:widgets="clr-namespace:MetroHub.Widgets"
                    xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml">
    <!-- Universal Converters -->
    <BooleanToVisibilityConverter x:Key="BoolToVis" />

    <!-- ========================================================================= -->
    <!-- WIDGET COMPOSITE COMPONENTS & CONTAINERS                                  -->
    <!-- All atomic control styles (Buttons, TextBoxes, ToggleSwitches, Menus)      -->
    <!-- are defined in ControlStyles.xaml. This dictionary defines widget surfaces,-->
    <!-- tab strips, floating scrollbars, and header action tiles.                 -->
    <!-- ========================================================================= -->

    <!-- 
        Shared WidgetCard Shell Style (Phase 0.2)
        Consistent dark card surface, hairline border, uniform corner radius, and internal padding.
        Every widget DataTemplate wraps its interior content in this shell.
    -->
    <Style x:Key="WidgetCardStyle" TargetType="{x:Type widgets:WidgetCard}">
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="BorderBrush" Value="Transparent" />
        <Setter Property="BorderThickness" Value="0" />
        <Setter Property="CornerRadius" Value="{DynamicResource TileCornerRadius}" />
        <Setter Property="Padding" Value="10" />
        <Setter Property="SnapsToDevicePixels" Value="True" />
        <Setter Property="UseLayoutRounding" Value="True" />
        <Setter Property="Focusable" Value="False" />
        <Setter Property="HorizontalContentAlignment" Value="Stretch" />
        <Setter Property="VerticalContentAlignment" Value="Stretch" />
        <Setter Property="RenderOptions.ClearTypeHint" Value="Enabled" />
        <Setter Property="TextOptions.TextFormattingMode" Value="Ideal" />
        <Setter Property="TextOptions.TextRenderingMode" Value="ClearType" />
        <Setter Property="TextOptions.TextHintingMode" Value="Fixed" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="{x:Type widgets:WidgetCard}">
                    <Border Background="{TemplateBinding Background}"
                            BorderBrush="{TemplateBinding BorderBrush}"
                            BorderThickness="{TemplateBinding BorderThickness}"
                            CornerRadius="{TemplateBinding CornerRadius}"
                            RenderOptions.ClearTypeHint="Enabled"
                            >
                        <ContentPresenter Margin="{TemplateBinding Padding}"
                                          Content="{TemplateBinding Content}"
                                          ContentTemplate="{TemplateBinding ContentTemplate}"
                                          ContentStringFormat="{TemplateBinding ContentStringFormat}"
                                          HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}"
                                          VerticalAlignment="{TemplateBinding VerticalContentAlignment}"
                                          />
                    </Border>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- Implicit default style for WidgetCard -->
    <Style TargetType="{x:Type widgets:WidgetCard}" BasedOn="{StaticResource WidgetCardStyle}" />


    <!-- 
        Shared WidgetTile Style
        Header action tile with Segoe Fluent Icon, Header label, glass hover reveal, and borderless adjacent layout.
    -->
    <Style x:Key="WidgetTileStyle" TargetType="{x:Type widgets:WidgetTile}">
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="BorderBrush" Value="Transparent" />
        <Setter Property="BorderThickness" Value="1,0,1,0" />
        <Setter Property="Margin" Value="-1,0,0,0" />
        <Setter Property="Height" Value="76" />
        <Setter Property="Foreground" Value="{DynamicResource TextPrimaryBrush}" />
        <Setter Property="IconSize" Value="24" />
        <Setter Property="Focusable" Value="False" />
        <Setter Property="FocusVisualStyle" Value="{x:Null}" />
        <Setter Property="HorizontalContentAlignment" Value="Center" />
        <Setter Property="VerticalContentAlignment" Value="Center" />
        <Setter Property="Tag" Value="InteractiveControl" />
        <Setter Property="SnapsToDevicePixels" Value="True" />
        <Setter Property="UseLayoutRounding" Value="True" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="{x:Type widgets:WidgetTile}">
                    <Border x:Name="TileBorder"
                            Background="{TemplateBinding Background}"
                            BorderBrush="{TemplateBinding BorderBrush}"
                            BorderThickness="{TemplateBinding BorderThickness}"
                            >
                        <Grid HorizontalAlignment="Stretch"
                              VerticalAlignment="Center"
                              Margin="0,0,0,2"
                              >
                            <Grid.RowDefinitions>
                                <!-- Fixed 28px height for optical icon center -->
                                <RowDefinition Height="28" />
                                <!-- Fixed 5px spacing -->
                                <RowDefinition Height="5" />
                                <!-- Fixed 18px height for text baseline -->
                                <RowDefinition Height="18" />
                            </Grid.RowDefinitions>

                            <!-- Standardized Icon / Symbol: Centered in exact 28x28 box -->
                            <Grid Grid.Row="0"
                                  HorizontalAlignment="Center"
                                  VerticalAlignment="Center"
                                  >
                                <!-- Primary: Fluent System Icon (standardized 24px grid) -->
                                <ui:SymbolIcon x:Name="PART_SymbolIcon"
                                               Symbol="{TemplateBinding Symbol}"
                                               FontSize="{TemplateBinding IconSize}"
                                               Foreground="{TemplateBinding Foreground}"
                                               HorizontalAlignment="Center"
                                               VerticalAlignment="Center"
                                               Visibility="Collapsed" />

                                <!-- Fallback / Custom Visual / Segoe Glyph Icon -->
                                <ContentControl x:Name="PART_IconContent"
                                                Content="{TemplateBinding Icon}"
                                                FontFamily="{DynamicResource AppIconFontFamily}"
                                                FontSize="{TemplateBinding IconSize}"
                                                Foreground="{TemplateBinding Foreground}"
                                                HorizontalAlignment="Center"
                                                VerticalAlignment="Center"
                                                />
                            </Grid>

                            <!-- Header Text: Pinned to exact identical baseline across every single tile -->
                            <TextBlock Grid.Row="2"
                                       Text="{TemplateBinding Header}"
                                       FontSize="{DynamicResource TypeCaptionFontSize}"
                                       FontWeight="{DynamicResource TypeBodyStrongFontWeight}"
                                       Foreground="{DynamicResource TextPrimaryBrush}"
                                       HorizontalAlignment="Center"
                                       VerticalAlignment="Center"
                                       TextAlignment="Center"
                                       />
                        </Grid>
                    </Border>
                    <ControlTemplate.Triggers>
                        <!-- Automatically activate SymbolIcon when Symbol property is populated -->
                        <Trigger Property="HasSymbol" Value="True">
                            <Setter TargetName="PART_SymbolIcon" Property="Visibility" Value="Visible" />
                            <Setter TargetName="PART_IconContent" Property="Visibility" Value="Collapsed" />
                        </Trigger>
                        <!-- Hover state: illuminates continuous vertical dividing borders without any background highlight -->
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="TileBorder" Property="BorderBrush" Value="#55FFFFFF" />
                            <Setter Property="Panel.ZIndex" Value="10" />
                        </Trigger>
                        <!-- Pressed state -->
                        <Trigger Property="IsPressed" Value="True">
                            <Setter TargetName="TileBorder" Property="BorderBrush" Value="#75FFFFFF" />
                            <Setter Property="Panel.ZIndex" Value="10" />
                        </Trigger>
                        <!-- Disabled state -->
                        <Trigger Property="IsEnabled" Value="False">
                            <Setter Property="Opacity" Value="0.3" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style TargetType="{x:Type widgets:WidgetTile}" BasedOn="{StaticResource WidgetTileStyle}" />

    <!-- 
        Shared WidgetTiles Style
        Container for WidgetTile items with continuous 1px bottom border and Fluent reveal + 120fps sliding indicator.
    -->
    <Style x:Key="WidgetTilesStyle" TargetType="{x:Type widgets:WidgetTiles}">
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="BorderThickness" Value="0" />
        <Setter Property="Height" Value="76" />
        <Setter Property="Focusable" Value="False" />
        <Setter Property="Tag" Value="InteractiveControl" />
        <Setter Property="SnapsToDevicePixels" Value="True" />
        <Setter Property="UseLayoutRounding" Value="True" />
        <Setter Property="ItemsPanel">
            <Setter.Value>
                <ItemsPanelTemplate>
                    <UniformGrid Rows="1" />
                </ItemsPanelTemplate>
            </Setter.Value>
        </Setter>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="{x:Type widgets:WidgetTiles}">
                    <Grid x:Name="PART_HostGrid" Background="Transparent">
                        <!-- Tiles Host -->
                        <ItemsPresenter />

                        <!-- Continuous 1px bottom border across all tiles with Fluent Reveal mouse tracking -->
                        <Grid VerticalAlignment="Bottom" Height="1">
                            <Border Background="{DynamicResource WidgetDividerBrush}" />
                            <Border x:Name="PART_BottomRevealBorder" Opacity="0">
                                <Border.Background>
                                    <RadialGradientBrush x:Name="PART_BottomRevealBrush" MappingMode="Absolute" RadiusX="160" RadiusY="160">
                                        <GradientStop Color="#FFFFFFFF" Offset="0.0" />
                                        <GradientStop Color="#60FFFFFF" Offset="0.5" />
                                        <GradientStop Color="#00000000" Offset="1.0" />
                                    </RadialGradientBrush>
                                </Border.Background>
                            </Border>
                        </Grid>

                        <!-- Hardware-Accelerated Sliding Colored Active Indicator -->
                        <Border x:Name="PART_SlidingIndicator"
                                Height="{TemplateBinding IndicatorHeight}"
                                VerticalAlignment="Bottom"
                                HorizontalAlignment="Left"
                                Width="0"
                                CornerRadius="{TemplateBinding IndicatorCornerRadius}"
                                Opacity="0"
                                Panel.ZIndex="25"
                                >
                            <Border.RenderTransform>
                                <TranslateTransform x:Name="PART_IndicatorTransform" X="0" />
                            </Border.RenderTransform>
                            <Border.Effect>
                                <DropShadowEffect x:Name="PART_IndicatorShadow"
                                                  Color="{DynamicResource StatusSuccessColor}"
                                                  BlurRadius="8"
                                                  ShadowDepth="0"
                                                  Opacity="0.8"
                                                  RenderingBias="Performance" />
                            </Border.Effect>
                        </Border>
                    </Grid>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style TargetType="{x:Type widgets:WidgetTiles}" BasedOn="{StaticResource WidgetTilesStyle}" />


    <!-- Universal 28x28 Micro Ghost Button Style (Audio mute, quick action, radio volume, refresh) -->
    <Style x:Key="WidgetMicroButtonStyle" TargetType="Button" BasedOn="{StaticResource SubtleButtonStyle}">
        <Setter Property="Width" Value="28" />
        <Setter Property="Height" Value="28" />
        <Setter Property="Padding" Value="0" />
        <Setter Property="Focusable" Value="False" />
        <Setter Property="FocusVisualStyle" Value="{x:Null}" />
        <Setter Property="Tag" Value="InteractiveControl" />
    </Style>

    <!-- Universal 32x28 Medium Ghost Button Style (Media transport, pomodoro timer, gallery) -->
    <Style x:Key="WidgetMediumButtonStyle" TargetType="Button" BasedOn="{StaticResource SubtleButtonStyle}">
        <Setter Property="Width" Value="32" />
        <Setter Property="Height" Value="28" />
        <Setter Property="Padding" Value="0" />
        <Setter Property="Focusable" Value="False" />
        <Setter Property="FocusVisualStyle" Value="{x:Null}" />
        <Setter Property="Tag" Value="InteractiveControl" />
    </Style>

    <!-- Universal 28x28 Stepper Navigation Button (Calendar, Habit, Pagination) -->
    <Style x:Key="WidgetNavButtonStyle" TargetType="Button" BasedOn="{StaticResource SubtleButtonStyle}">
        <Setter Property="Width" Value="28" />
        <Setter Property="Height" Value="28" />
        <Setter Property="Padding" Value="0" />
        <Setter Property="Foreground" Value="{DynamicResource TextSecondaryBrush}" />
        <Setter Property="Focusable" Value="False" />
        <Setter Property="FocusVisualStyle" Value="{x:Null}" />
        <Setter Property="Tag" Value="InteractiveControl" />
    </Style>

    <!-- Universal 38px Sound / Media List Item Row Button Style -->
    <Style x:Key="WidgetListItemButtonStyle" TargetType="Button">
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="BorderThickness" Value="0" />
        <Setter Property="Foreground" Value="{DynamicResource TextPrimaryBrush}" />
        <Setter Property="Height" Value="38" />
        <Setter Property="Margin" Value="0,2,0,2" />
        <Setter Property="Focusable" Value="False" />
        <Setter Property="FocusVisualStyle" Value="{x:Null}" />
        <Setter Property="HorizontalContentAlignment" Value="Stretch" />
        <Setter Property="Tag" Value="InteractiveControl" />
        <Setter Property="SnapsToDevicePixels" Value="True" />
        <Setter Property="UseLayoutRounding" Value="True" />
    </Style>

    <!-- Universal 1px Horizontal Hairline Divider -->
    <Style x:Key="WidgetHairlineDividerStyle" TargetType="Border">
        <Setter Property="Height" Value="1" />
        <Setter Property="Background" Value="{DynamicResource WidgetDividerBrush}" />
        <Setter Property="SnapsToDevicePixels" Value="True" />
        <Setter Property="UseLayoutRounding" Value="True" />
    </Style>

    <!-- Universal 1px Vertical Hairline Divider -->
    <Style x:Key="WidgetVerticalHairlineDividerStyle" TargetType="Border">
        <Setter Property="Width" Value="1" />
        <Setter Property="Background" Value="{DynamicResource WidgetDividerBrush}" />
        <Setter Property="SnapsToDevicePixels" Value="True" />
        <Setter Property="UseLayoutRounding" Value="True" />
    </Style>

    <!-- Universal 7px Round Indicator Dot (Pomodoro cycles, Network status, Activity pips) -->
    <Style x:Key="WidgetIndicatorDotStyle" TargetType="Border">
        <Setter Property="Width" Value="7" />
        <Setter Property="Height" Value="7" />
        <Setter Property="CornerRadius" Value="3.5" />
        <Setter Property="Margin" Value="2.5,0" />
        <Setter Property="Background" Value="{DynamicResource IndicatorDotInactiveBrush}" />
        <Setter Property="SnapsToDevicePixels" Value="True" />
        <Setter Property="UseLayoutRounding" Value="True" />
    </Style>

</ResourceDictionary>
