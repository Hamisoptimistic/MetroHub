<UserControl x:Class="MetroHub.Widgets.Catalog.Network.NetworkWidgetView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:widgets="clr-namespace:MetroHub.Widgets"
             xmlns:network="clr-namespace:MetroHub.Widgets.Catalog.Network"
             xmlns:corenet="clr-namespace:MetroHub.Core.Network"
             xmlns:conv="clr-namespace:MetroHub.Presentation.Converters"
             xmlns:controls="clr-namespace:MetroHub.Presentation.Controls"
             xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
             mc:Ignorable="d" 
             d:DataContext="{d:DesignInstance Type=network:NetworkWidgetViewModel}"
             Focusable="False"
             FocusVisualStyle="{x:Null}"
             ClipToBounds="True"
             SnapsToDevicePixels="True"
             UseLayoutRounding="True"
             TextOptions.TextFormattingMode="Ideal"
             TextOptions.TextRenderingMode="ClearType"
             TextOptions.TextHintingMode="Fixed"
             RenderOptions.ClearTypeHint="Enabled">

    <UserControl.Resources>
        <BooleanToVisibilityConverter x:Key="BoolToVis" />
        <conv:StringToBrushConverter x:Key="StringToBrush" />

        <!-- Strips default dotted focus border across all controls -->
        <Style TargetType="{x:Type Control}">
            <Setter Property="FocusVisualStyle" Value="{x:Null}" />
        </Style>

        <!-- Sleek Micro Copy Button Style -->
        <Style x:Key="MicroCopyButtonStyle" TargetType="Button">
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="BorderBrush" Value="Transparent" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="Width" Value="20" />
            <Setter Property="Height" Value="20" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Focusable" Value="False" />
            <Setter Property="FocusVisualStyle" Value="{x:Null}" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Border"
                                Background="{TemplateBinding Background}"
                                CornerRadius="2"
                                SnapsToDevicePixels="True">
                            <ui:SymbolIcon x:Name="CopyIcon"
                                           Symbol="Copy16"
                                           FontSize="11"
                                           Foreground="#80FFFFFF"
                                           HorizontalAlignment="Center"
                                           VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Border" Property="Background" Value="#1CFFFFFF" />
                                <Setter TargetName="CopyIcon" Property="Foreground" Value="#FFFFFF" />
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="Border" Property="Background" Value="#2EFFFFFF" />
                                <Setter TargetName="CopyIcon" Property="Foreground" Value="#FFFFFF" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Sleek Micro Icon Button Style (Generic ContentPresenter) matching Media Player Style -->
        <Style x:Key="MicroIconButtonStyle" TargetType="Button">
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="BorderBrush" Value="Transparent" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="Width" Value="32" />
            <Setter Property="Height" Value="28" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Focusable" Value="False" />
            <Setter Property="FocusVisualStyle" Value="{x:Null}" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Border"
                                Background="{TemplateBinding Background}"
                                CornerRadius="2"
                                SnapsToDevicePixels="True">
                            <ContentPresenter HorizontalAlignment="Center"
                                              VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Border" Property="Background" Value="#25FFFFFF" />
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="Border" Property="Background" Value="#45FFFFFF" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Universal 4px Fluent Floating ScrollBar: Invisible by default, reveals on scroll/hover via AutoHideScrollBehavior -->
        <Style TargetType="{x:Type ScrollBar}" BasedOn="{StaticResource WidgetFloatingScrollBarStyle}" />

        <!-- Cohesive Fluent Button Style for Wi-Fi Network Actions (Connect / Disconnect) -->
        <Style x:Key="FluentWifiActionButtonStyle" TargetType="Button">
            <Setter Property="Background" Value="#1CFFFFFF" />
            <Setter Property="BorderBrush" Value="#2AFFFFFF" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="Foreground" Value="#F5FFFFFF" />
            <Setter Property="FontFamily" Value="{DynamicResource AppFontFamily}" />
            <Setter Property="FontSize" Value="12" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="Width" Value="76" />
            <Setter Property="Height" Value="28" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Focusable" Value="False" />
            <Setter Property="FocusVisualStyle" Value="{x:Null}" />
            <Setter Property="HorizontalContentAlignment" Value="Center" />
            <Setter Property="VerticalContentAlignment" Value="Center" />
            <Setter Property="SnapsToDevicePixels" Value="True" />
            <Setter Property="UseLayoutRounding" Value="True" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="ButtonBorder"
                                Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="2"
                                SnapsToDevicePixels="True">
                            <ContentPresenter HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}"
                                              VerticalAlignment="{TemplateBinding VerticalContentAlignment}"
                                              SnapsToDevicePixels="True" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="ButtonBorder" Property="Background" Value="#30FFFFFF" />
                                <Setter TargetName="ButtonBorder" Property="BorderBrush" Value="#48FFFFFF" />
                                <Setter Property="Foreground" Value="#FFFFFF" />
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="ButtonBorder" Property="Background" Value="#14FFFFFF" />
                                <Setter TargetName="ButtonBorder" Property="BorderBrush" Value="#20FFFFFF" />
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter TargetName="ButtonBorder" Property="Opacity" Value="0.35" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="FluentWifiDisconnectButtonStyle" TargetType="Button" BasedOn="{StaticResource FluentWifiActionButtonStyle}">
            <Setter Property="Background" Value="#10FFFFFF" />
            <Setter Property="BorderBrush" Value="#1CFFFFFF" />
            <Setter Property="Foreground" Value="#B5FFFFFF" />
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Background" Value="#22FFFFFF" />
                    <Setter Property="BorderBrush" Value="#38FFFFFF" />
                    <Setter Property="Foreground" Value="#FFFFFF" />
                </Trigger>
            </Style.Triggers>
        </Style>

        <!-- Clean Modern "START" Action Button (Pure typography, zero circular box, electric blue hover glow) -->
        <Style x:Key="SpeedPureGoButtonStyle" TargetType="Button">
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="BorderBrush" Value="Transparent" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="Foreground" Value="#FFFFFF" />
            <Setter Property="FontFamily" Value="{DynamicResource AppDisplayFontFamily}" />
            <Setter Property="FontSize" Value="36" />
            <Setter Property="FontWeight" Value="Bold" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Focusable" Value="False" />
            <Setter Property="FocusVisualStyle" Value="{x:Null}" />
            <Setter Property="HorizontalContentAlignment" Value="Center" />
            <Setter Property="VerticalContentAlignment" Value="Center" />
            <Setter Property="SnapsToDevicePixels" Value="True" />
            <Setter Property="UseLayoutRounding" Value="True" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Grid Background="Transparent" SnapsToDevicePixels="True" HorizontalAlignment="Center" VerticalAlignment="Center">
                            <TextBlock x:Name="StartLabel"
                                       Text="START"
                                       FontFamily="{TemplateBinding FontFamily}"
                                       FontSize="{TemplateBinding FontSize}"
                                       FontWeight="{TemplateBinding FontWeight}"
                                       Foreground="{TemplateBinding Foreground}"
                                       HorizontalAlignment="Center"
                                       VerticalAlignment="Center" />
                        </Grid>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="StartLabel" Property="Foreground" Value="#0091FF" />
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="StartLabel" Property="Foreground" Value="#0078D4" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Speed Test Focus-Timer Progress Dot Styles -->
        <Style x:Key="SpeedTestBaseDotStyle" TargetType="Border">
            <Setter Property="Width" Value="7" />
            <Setter Property="Height" Value="7" />
            <Setter Property="CornerRadius" Value="3.5" />
            <Setter Property="Margin" Value="3.5,0" />
            <Setter Property="Background" Value="#22FFFFFF" />
            <Setter Property="SnapsToDevicePixels" Value="True" />
        </Style>

        <!-- Dot 1: Latency (Yellow #FFB703) -->
        <Style x:Key="SpeedTestDot1Style" TargetType="Border" BasedOn="{StaticResource SpeedTestBaseDotStyle}">
            <Style.Triggers>
                <DataTrigger Binding="{Binding IsLatencyPhaseActive}" Value="True">
                    <Setter Property="Background" Value="#FFB703" />
                    <Setter Property="Effect">
                        <Setter.Value>
                            <DropShadowEffect Color="#FFB703" BlurRadius="7" Opacity="0.9" ShadowDepth="0" />
                        </Setter.Value>
                    </Setter>
                    <DataTrigger.EnterActions>
                        <BeginStoryboard x:Name="Dot1Blink">
                            <Storyboard RepeatBehavior="Forever" AutoReverse="True">
                                <DoubleAnimation Storyboard.TargetProperty="Opacity"
                                                 From="1.0" To="0.25"
                                                 Duration="0:0:0.4" />
                            </Storyboard>
                        </BeginStoryboard>
                    </DataTrigger.EnterActions>
                    <DataTrigger.ExitActions>
                        <StopStoryboard BeginStoryboardName="Dot1Blink" />
                    </DataTrigger.ExitActions>
                </DataTrigger>
                <DataTrigger Binding="{Binding IsDownloadPhaseActive}" Value="True">
                    <Setter Property="Background" Value="#FFB703" />
                    <Setter Property="Opacity" Value="0.75" />
                </DataTrigger>
                <DataTrigger Binding="{Binding IsUploadPhaseActive}" Value="True">
                    <Setter Property="Background" Value="#FFB703" />
                    <Setter Property="Opacity" Value="0.75" />
                </DataTrigger>
            </Style.Triggers>
        </Style>

        <!-- Dot 2: Download (Blue #0091FF) -->
        <Style x:Key="SpeedTestDot2Style" TargetType="Border" BasedOn="{StaticResource SpeedTestBaseDotStyle}">
            <Style.Triggers>
                <DataTrigger Binding="{Binding IsDownloadPhaseActive}" Value="True">
                    <Setter Property="Background" Value="#0091FF" />
                    <Setter Property="Effect">
                        <Setter.Value>
                            <DropShadowEffect Color="#0091FF" BlurRadius="7" Opacity="0.9" ShadowDepth="0" />
                        </Setter.Value>
                    </Setter>
                    <DataTrigger.EnterActions>
                        <BeginStoryboard x:Name="Dot2Blink">
                            <Storyboard RepeatBehavior="Forever" AutoReverse="True">
                                <DoubleAnimation Storyboard.TargetProperty="Opacity"
                                                 From="1.0" To="0.25"
                                                 Duration="0:0:0.4" />
                            </Storyboard>
                        </BeginStoryboard>
                    </DataTrigger.EnterActions>
                    <DataTrigger.ExitActions>
                        <StopStoryboard BeginStoryboardName="Dot2Blink" />
                    </DataTrigger.ExitActions>
                </DataTrigger>
                <DataTrigger Binding="{Binding IsUploadPhaseActive}" Value="True">
                    <Setter Property="Background" Value="#0091FF" />
                    <Setter Property="Opacity" Value="0.75" />
                </DataTrigger>
            </Style.Triggers>
        </Style>

        <!-- Dot 3: Upload (Purple #A855F7) -->
        <Style x:Key="SpeedTestDot3Style" TargetType="Border" BasedOn="{StaticResource SpeedTestBaseDotStyle}">
            <Style.Triggers>
                <DataTrigger Binding="{Binding IsUploadPhaseActive}" Value="True">
                    <Setter Property="Background" Value="#A855F7" />
                    <Setter Property="Effect">
                        <Setter.Value>
                            <DropShadowEffect Color="#A855F7" BlurRadius="7" Opacity="0.9" ShadowDepth="0" />
                        </Setter.Value>
                    </Setter>
                    <DataTrigger.EnterActions>
                        <BeginStoryboard x:Name="Dot3Blink">
                            <Storyboard RepeatBehavior="Forever" AutoReverse="True">
                                <DoubleAnimation Storyboard.TargetProperty="Opacity"
                                                 From="1.0" To="0.25"
                                                 Duration="0:0:0.4" />
                            </Storyboard>
                        </BeginStoryboard>
                    </DataTrigger.EnterActions>
                    <DataTrigger.ExitActions>
                        <StopStoryboard BeginStoryboardName="Dot3Blink" />
                    </DataTrigger.ExitActions>
                </DataTrigger>
            </Style.Triggers>
        </Style>

        <!-- Fluent Green ToggleSwitch Style (Matches Windows 11 Fluent style: See-through / transparent track when OFF; Active Green #00E676 track with Solid Black knob #000000 when ON) -->
        <Style x:Key="FluentGreenToggleSwitchStyle" TargetType="{x:Type ui:ToggleSwitch}" BasedOn="{StaticResource {x:Type ui:ToggleSwitch}}">
            <Setter Property="VerticalAlignment" Value="Center" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="FocusVisualStyle" Value="{x:Null}" />
            <Style.Resources>
                <!-- ON state (Checked / Enabled): Green track (#00E676) + Solid Black knob (#000000) -->
                <SolidColorBrush x:Key="ToggleSwitchFillOn" Color="#00E676" />
                <SolidColorBrush x:Key="ToggleSwitchFillOnPointerOver" Color="#00FF85" />
                <SolidColorBrush x:Key="ToggleSwitchFillOnPressed" Color="#00CC6A" />
                <SolidColorBrush x:Key="ToggleSwitchFillOnDisabled" Color="#8000E676" />
                <SolidColorBrush x:Key="ToggleSwitchStrokeOn" Color="#00E676" />
                <SolidColorBrush x:Key="ToggleSwitchStrokeOnPointerOver" Color="#00FF85" />
                <SolidColorBrush x:Key="ToggleSwitchStrokeOnPressed" Color="#00CC6A" />
                <SolidColorBrush x:Key="ToggleSwitchKnobFillOn" Color="#000000" />
                <SolidColorBrush x:Key="ToggleSwitchKnobFillOnPointerOver" Color="#1A1A1A" />
                <SolidColorBrush x:Key="ToggleSwitchKnobFillOnPressed" Color="#000000" />
                <SolidColorBrush x:Key="ToggleSwitchKnobFillOnDisabled" Color="#000000" />

                <!-- OFF state (Unchecked / Disabled): See-through transparent track, subtle fluent outline (#70FFFFFF), light silver-white knob (#CECECE) -->
                <SolidColorBrush x:Key="ToggleSwitchFillOff" Color="Transparent" />
                <SolidColorBrush x:Key="ToggleSwitchFillOffPointerOver" Color="#0DFFFFFF" />
                <SolidColorBrush x:Key="ToggleSwitchFillOffPressed" Color="#18FFFFFF" />
                <SolidColorBrush x:Key="ToggleSwitchFillOffDisabled" Color="Transparent" />
                <SolidColorBrush x:Key="ToggleSwitchStrokeOff" Color="#70FFFFFF" />
                <SolidColorBrush x:Key="ToggleSwitchStrokeOffPointerOver" Color="#90FFFFFF" />
                <SolidColorBrush x:Key="ToggleSwitchStrokeOffPressed" Color="#55FFFFFF" />
                <SolidColorBrush x:Key="ToggleSwitchStrokeOffDisabled" Color="#35FFFFFF" />
                <SolidColorBrush x:Key="ToggleSwitchKnobFillOff" Color="#CECECE" />
                <SolidColorBrush x:Key="ToggleSwitchKnobFillOffPointerOver" Color="#FFFFFF" />
                <SolidColorBrush x:Key="ToggleSwitchKnobFillOffPressed" Color="#B0B0B0" />
                <SolidColorBrush x:Key="ToggleSwitchKnobFillOffDisabled" Color="#60FFFFFF" />

                <!-- Accent overrides -->
                <SolidColorBrush x:Key="SystemAccentColorBrush" Color="#00E676" />
                <SolidColorBrush x:Key="SystemAccentColorSecondaryBrush" Color="#00E676" />
                <SolidColorBrush x:Key="SystemAccentColorTertiaryBrush" Color="#00CC6A" />
            </Style.Resources>
        </Style>
    </UserControl.Resources>

    <!-- Outer Widget Card with Padding="0" so dividing borders run border-to-border -->
    <widgets:WidgetCard Padding="0" Background="Transparent" CornerRadius="2">
        <Grid SnapsToDevicePixels="True" UseLayoutRounding="True" ClipToBounds="True" Background="Transparent">
            <Grid.RowDefinitions>
                <!-- Row 0: Top 5-Tile Segmented Region (Height 76px, with seamless bottom separator) -->
                <RowDefinition Height="76" />
                <!-- Row 1: Lower Panel Region -->
                <RowDefinition Height="*" />
            </Grid.RowDefinitions>

            <!-- ========================================================================= -->
            <!-- ROW 0: TOP 5-TILE REGION (Transparent Acrylic Backdrop)                   -->
            <!-- [ Ethernet ] | [ WIFI ] | [ Kill Net ] | [ Speed ] | [ Hotspot ]          -->
            <!-- ========================================================================= -->
            <widgets:WidgetTiles Grid.Row="0"
                                 SelectedValue="{Binding CurrentPanel, Mode=TwoWay}"
                                 Height="76">
                <widgets:WidgetTile Value="Ethernet"
                                    Icon="{Binding EthernetTileIcon}"
                                    IconSize="18"
                                    Header="{Binding EthernetTileHeader}"
                                    IndicatorBrush="{Binding EthernetStatusBrush}"
                                    IsEnabled="{Binding HasEthernetAdapter}"
                                    ToolTip="{Binding EthernetTileTooltip}" />
                <widgets:WidgetTile Value="Wifi"
                                    Symbol="{Binding WifiPanelSymbol}"
                                    Header="Wi-Fi"
                                    IndicatorBrush="{Binding WifiStatusBrush}"
                                    IsEnabled="{Binding HasWifiAdapter}"
                                    ToolTip="Wi-Fi Networks &amp; Details" />
                <widgets:WidgetTile Value="Adapters"
                                    Symbol="WrenchScrewdriver24"
                                    Header="Adapters"
                                    IndicatorBrush="{Binding AdaptersStatusBrush}"
                                    ToolTip="Hardware Network Adapters &amp; Controls" />
                <widgets:WidgetTile Value="Speed"
                                    Symbol="TopSpeed24"
                                    Header="Speed"
                                    IndicatorBrush="{Binding SpeedStatusBrush}"
                                    ToolTip="Live Throughput &amp; Bandwidth Diagnostics" />
                <widgets:WidgetTile Value="Usage"
                                    Symbol="DataPie24"
                                    Header="Usage"
                                    IndicatorBrush="{Binding DataUsageStatusBrush}"
                                    ToolTip="Network Data Usage &amp; Analytics" />
            </widgets:WidgetTiles>

            <!-- ========================================================================= -->
            <!-- ROW 1: LOWER PANEL REGION                                                 -->
            <!-- ========================================================================= -->
            <Grid Grid.Row="1" Background="Transparent" SnapsToDevicePixels="True">

                <!-- ==================== 1. ETHERNET PANEL ==================== -->
                <Grid Visibility="{Binding IsEthernetPanel, Converter={StaticResource BoolToVis}}"
                      Margin="20,14,20,14"
                      SnapsToDevicePixels="True">
                    <Grid.RowDefinitions>
                        <!-- Row 0: Top Header: [ 🖧 ] Ethernet + Standard Windows 11 ToggleSwitch -->
                        <RowDefinition Height="Auto" />
                        <!-- Row 1: Hairline Separator -->
                        <RowDefinition Height="Auto" />
                        <!-- Row 2: Content (Properties Grid OR Turned Off Banner) -->
                        <RowDefinition Height="*" />
                    </Grid.RowDefinitions>

                    <!-- Top Header: [ 🖧 ] Ethernet -->
                    <Grid Grid.Row="0" Height="26" Margin="0,0,0,10">
                        <!-- Left: Icon + Title (Alters to Connected / No Internet / Disconnected dynamically) -->
                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                            <TextBlock Text="{Binding EthernetPanelIcon}"
                                       FontFamily="{DynamicResource AppIconFontFamily}"
                                       FontSize="18"
                                       Foreground="{Binding EthernetPanelTitleColor}"
                                       VerticalAlignment="Center"
                                       Margin="0,0,10,0" />
                            <TextBlock Text="{Binding EthernetPanelTitle}"
                                       FontFamily="{DynamicResource AppDisplayFontFamily}"
                                       FontSize="16"
                                       FontWeight="SemiBold"
                                       Foreground="{Binding EthernetPanelTitleColor}"
                                       VerticalAlignment="Center" />
                        </StackPanel>
                    </Grid>

                    <!-- Hairline Divider -->
                    <Border Grid.Row="1"
                            Height="1"
                            Background="#14FFFFFF"
                            Margin="0,0,0,14"
                            SnapsToDevicePixels="True" />

                    <!-- Content Row: View 1 - Full Properties (When Ethernet is Enabled) -->
                    <Grid Grid.Row="2"
                          Visibility="{Binding IsEthernetEnabled, Converter={StaticResource BoolToVis}}"
                          SnapsToDevicePixels="True">
                        <Grid.Style>
                            <Style TargetType="Grid">
                                <Style.Triggers>
                                    <Trigger Property="Visibility" Value="Visible">
                                        <Trigger.EnterActions>
                                            <BeginStoryboard>
                                                <Storyboard>
                                                    <DoubleAnimation Storyboard.TargetProperty="Opacity"
                                                                     From="0.0" To="1.0"
                                                                     Duration="0:0:0.2" />
                                                </Storyboard>
                                            </BeginStoryboard>
                                        </Trigger.EnterActions>
                                    </Trigger>
                                </Style.Triggers>
                            </Style>
                        </Grid.Style>
                        <Grid.RowDefinitions>
                            <!-- 0: 5 Core Specs Grid -->
                            <RowDefinition Height="*" />
                        </Grid.RowDefinitions>

                        <!-- 0: Clean Vertical Spec List (Adapter, DNS, IPv4, MAC, Session Uptime) -->
                        <Grid Grid.Row="0" Margin="0,4,0,4" VerticalAlignment="Center">
                            <Grid.RowDefinitions>
                                <!-- 0: Adapter -->
                                <RowDefinition Height="Auto" />
                                <!-- 1: DNS -->
                                <RowDefinition Height="Auto" />
                                <!-- 2: IPv4 -->
                                <RowDefinition Height="Auto" />
                                <!-- 3: MAC -->
                                <RowDefinition Height="Auto" />
                                <!-- 4: Session Uptime -->
                                <RowDefinition Height="Auto" />
                            </Grid.RowDefinitions>
                            <Grid.ColumnDefinitions>
                                <!-- Left Column: Label (Bold) -->
                                <ColumnDefinition Width="Auto" />
                                <!-- Right Column: Value (Normal, Right-aligned) -->
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>

                            <!-- 1. ADAPTER -->
                            <TextBlock Grid.Row="0" Grid.Column="0"
                                       Text="Adapter:"
                                       FontSize="14"
                                       FontWeight="SemiBold"
                                       Foreground="#FFFFFF"
                                       VerticalAlignment="Center"
                                       Margin="0,0,0,8" />
                            <TextBlock Grid.Row="0" Grid.Column="1"
                                       Text="{Binding Ethernet.Description}"
                                       FontSize="13.5"
                                       FontWeight="Normal"
                                       Foreground="#D0FFFFFF"
                                       HorizontalAlignment="Right"
                                       TextAlignment="Right"
                                       TextTrimming="CharacterEllipsis"
                                       ToolTip="{Binding Ethernet.Description}"
                                       VerticalAlignment="Center"
                                       Margin="16,0,0,8" />

                            <!-- 2. DNS -->
                            <TextBlock Grid.Row="1" Grid.Column="0"
                                       Text="DNS:"
                                       FontSize="14"
                                       FontWeight="SemiBold"
                                       Foreground="#FFFFFF"
                                       VerticalAlignment="Center"
                                       Margin="0,0,0,8" />
                            <TextBlock Grid.Row="1" Grid.Column="1"
                                       Text="{Binding Ethernet.DnsServersString}"
                                       Typography.NumeralAlignment="Tabular"
                                       FontSize="13.5"
                                       FontWeight="Normal"
                                       Foreground="#D0FFFFFF"
                                       HorizontalAlignment="Right"
                                       TextAlignment="Right"
                                       TextTrimming="CharacterEllipsis"
                                       ToolTip="{Binding Ethernet.DnsServersString}"
                                       VerticalAlignment="Center"
                                       Margin="16,0,0,8" />

                            <!-- 3. IPV4 -->
                            <StackPanel Grid.Row="2" Grid.Column="0"
                                        Orientation="Horizontal"
                                        VerticalAlignment="Center"
                                        Margin="0,0,0,8">
                                <TextBlock Text="IPv4:"
                                           FontSize="14"
                                           FontWeight="SemiBold"
                                           Foreground="#FFFFFF"
                                           VerticalAlignment="Center" />
                                <Button Style="{StaticResource MicroCopyButtonStyle}"
                                        Margin="6,0,0,0"
                                        VerticalAlignment="Center"
                                        Command="{Binding CopyEthernetIpCommand}"
                                        ToolTip="{Binding CopyEthernetIpTooltip}" />
                            </StackPanel>
                            <TextBlock Grid.Row="2" Grid.Column="1"
                                       Text="{Binding Ethernet.IpAddress}"
                                       Typography.NumeralAlignment="Tabular"
                                       FontSize="13.5"
                                       FontWeight="Normal"
                                       Foreground="#D0FFFFFF"
                                       HorizontalAlignment="Right"
                                       TextAlignment="Right"
                                       TextTrimming="CharacterEllipsis"
                                       VerticalAlignment="Center"
                                       Margin="16,0,0,8" />

                            <!-- 4. MAC -->
                            <StackPanel Grid.Row="3" Grid.Column="0"
                                        Orientation="Horizontal"
                                        VerticalAlignment="Center"
                                        Margin="0,0,0,8">
                                <TextBlock Text="MAC:"
                                           FontSize="14"
                                           FontWeight="SemiBold"
                                           Foreground="#FFFFFF"
                                           VerticalAlignment="Center" />
                                <Button Style="{StaticResource MicroCopyButtonStyle}"
                                        Margin="6,0,0,0"
                                        VerticalAlignment="Center"
                                        Command="{Binding CopyEthernetMacCommand}"
                                        ToolTip="{Binding CopyEthernetMacTooltip}" />
                            </StackPanel>
                            <TextBlock Grid.Row="3" Grid.Column="1"
                                       Text="{Binding Ethernet.MacAddress}"
                                       Typography.NumeralAlignment="Tabular"
                                       FontSize="13.5"
                                       FontWeight="Normal"
                                       Foreground="#D0FFFFFF"
                                       HorizontalAlignment="Right"
                                       TextAlignment="Right"
                                       TextTrimming="CharacterEllipsis"
                                       VerticalAlignment="Center"
                                       Margin="16,0,0,8" />

                            <!-- 5. SESSION UPTIME -->
                            <TextBlock Grid.Row="4" Grid.Column="0"
                                       Text="Session Uptime:"
                                       FontSize="14"
                                       FontWeight="SemiBold"
                                       Foreground="#FFFFFF"
                                       VerticalAlignment="Center"
                                       Margin="0,0,0,0" />
                            <TextBlock Grid.Row="4" Grid.Column="1"
                                       Text="{Binding Ethernet.DurationString}"
                                       Typography.NumeralAlignment="Tabular"
                                       FontSize="13.5"
                                       FontWeight="Normal"
                                       Foreground="#D0FFFFFF"
                                       HorizontalAlignment="Right"
                                       TextAlignment="Right"
                                       TextTrimming="CharacterEllipsis"
                                       VerticalAlignment="Center"
                                       Margin="16,0,0,0" />
                        </Grid>
                    </Grid>

                    <!-- Content Row: View 2 - Clean Professional Fluent Banner (When Ethernet is Turned OFF) -->
                    <Grid Grid.Row="2"
                          Visibility="{Binding IsEthernetDisabled, Converter={StaticResource BoolToVis}}"
                          VerticalAlignment="Center"
                          HorizontalAlignment="Center"
                          Margin="0,32,0,32"
                          SnapsToDevicePixels="True">
                        <Grid.Style>
                            <Style TargetType="Grid">
                                <Style.Triggers>
                                    <Trigger Property="Visibility" Value="Visible">
                                        <Trigger.EnterActions>
                                            <BeginStoryboard>
                                                <Storyboard>
                                                    <DoubleAnimation Storyboard.TargetProperty="Opacity"
                                                                     From="0.0" To="1.0"
                                                                     Duration="0:0:0.2" />
                                                </Storyboard>
                                            </BeginStoryboard>
                                        </Trigger.EnterActions>
                                    </Trigger>
                                </Style.Triggers>
                            </Style>
                        </Grid.Style>
                        <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center">
                            <TextBlock Text="&#xEB55;"
                                       FontFamily="{DynamicResource AppIconFontFamily}"
                                       FontSize="38"
                                       Foreground="#45FFFFFF"
                                       HorizontalAlignment="Center"
                                       Margin="0,0,0,12" />
                            <TextBlock Text="{Binding EthernetTurnedOffBannerTitle}"
                                       FontFamily="{DynamicResource AppDisplayFontFamily}"
                                       FontSize="16"
                                       FontWeight="Bold"
                                       Foreground="#D0FFFFFF"
                                       HorizontalAlignment="Center" />
                        </StackPanel>
                    </Grid>
                </Grid>

                <!-- ==================== 2. WI-FI PANEL ==================== -->
                <Grid Visibility="{Binding IsWifiPanel, Converter={StaticResource BoolToVis}}"
                      Margin="20,14,20,14"
                      SnapsToDevicePixels="True">
                    <Grid.RowDefinitions>
                        <!-- Row 0: Top Header: [ 📶 ] Wi-Fi + Scan/Refresh + ToggleSwitch -->
                        <RowDefinition Height="Auto" />
                        <!-- Row 1: Hairline Separator -->
                        <RowDefinition Height="Auto" />
                        <!-- Row 2: Content (Available Networks List OR Turned Off Banner) -->
                        <RowDefinition Height="*" />
                    </Grid.RowDefinitions>

                    <!-- Top Header: [ 📶 ] Wi-Fi  [ RefreshButton ] [ ToggleSwitch ] -->
                    <Grid Grid.Row="0" Height="26" Margin="0,0,0,10">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>

                        <!-- Left: Icon + Title ("Connected" / "Disconnected" / "Turned Off") -->
                        <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center">
                            <TextBlock Text="{Binding WifiPanelIcon}"
                                       FontFamily="{DynamicResource AppIconFontFamily}"
                                       FontSize="18"
                                       Foreground="{Binding WifiPanelTitleColor}"
                                       VerticalAlignment="Center"
                                       Margin="0,0,10,0" />
                            <TextBlock Text="{Binding WifiPanelTitle}"
                                       FontFamily="{DynamicResource AppDisplayFontFamily}"
                                       FontSize="16"
                                       FontWeight="SemiBold"
                                       Foreground="{Binding WifiPanelTitleColor}"
                                       VerticalAlignment="Center" />
                        </StackPanel>

                        <!-- Right: Scan/Refresh Button + Standard Windows 11 ToggleSwitch for Wi-Fi Radio -->
                        <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                            <Button Style="{StaticResource MicroIconButtonStyle}"
                                    Width="32"
                                    Height="28"
                                    Margin="0,0,8,0"
                                    VerticalAlignment="Center"
                                    Command="{Binding RefreshWifiCommand}"
                                    Visibility="{Binding IsWifiRadioOn, Converter={StaticResource BoolToVis}}"
                                    ToolTip="Scan for Wi-Fi networks">
                                <ui:SymbolIcon Symbol="ArrowClockwise24"
                                               FontSize="16"
                                               Foreground="#D0FFFFFF"
                                               RenderTransformOrigin="0.5,0.5">
                                    <ui:SymbolIcon.RenderTransform>
                                        <RotateTransform Angle="0" />
                                    </ui:SymbolIcon.RenderTransform>
                                    <ui:SymbolIcon.Style>
                                        <Style TargetType="{x:Type ui:SymbolIcon}">
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding IsScanningWifiVisual}" Value="True">
                                                    <DataTrigger.EnterActions>
                                                        <BeginStoryboard x:Name="SpinRefreshStoryboard">
                                                            <Storyboard RepeatBehavior="Forever">
                                                                <DoubleAnimation Storyboard.TargetProperty="(UIElement.RenderTransform).(RotateTransform.Angle)"
                                                                                 From="0" To="360"
                                                                                 Duration="0:0:0.75" />
                                                            </Storyboard>
                                                        </BeginStoryboard>
                                                    </DataTrigger.EnterActions>
                                                    <DataTrigger.ExitActions>
                                                        <StopStoryboard BeginStoryboardName="SpinRefreshStoryboard" />
                                                    </DataTrigger.ExitActions>
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </ui:SymbolIcon.Style>
                                </ui:SymbolIcon>
                            </Button>

                            <ui:ToggleSwitch x:Name="WifiRadioToggleSwitch"
                                             Style="{StaticResource FluentGreenToggleSwitchStyle}"
                                             IsChecked="{Binding IsWifiRadioEnabled, Mode=TwoWay}"
                                             IsEnabled="{Binding CanToggleWifiRadio}"
                                             VerticalAlignment="Center"
                                             Focusable="True"
                                             Cursor="Hand" />
                        </StackPanel>
                    </Grid>

                    <!-- Hairline Divider -->
                    <Border Grid.Row="1"
                            Height="1"
                            Background="#14FFFFFF"
                            Margin="0,0,0,14"
                            SnapsToDevicePixels="True" />

                    <!-- Content Row: View 1 - Available Networks (When Wi-Fi Radio is ON and Ready) -->
                    <Grid Grid.Row="2"
                          Visibility="{Binding IsWifiContentVisible, Converter={StaticResource BoolToVis}}"
                          SnapsToDevicePixels="True">

                        <!-- Empty State (No Networks Detected Yet) -->
                        <StackPanel Visibility="{Binding HasNoAvailableNetworks, Converter={StaticResource BoolToVis}}"
                                    HorizontalAlignment="Center"
                                    VerticalAlignment="Center">
                            <ui:SymbolIcon Symbol="Wifi124"
                                           FontSize="28"
                                           Foreground="#40FFFFFF"
                                           HorizontalAlignment="Center"
                                           Margin="0,0,0,8" />
                            <TextBlock Text="Scanning for available networks..."
                                       FontSize="13"
                                       Foreground="#75FFFFFF"
                                       HorizontalAlignment="Center" />
                        </StackPanel>

                        <!-- Available Networks ListView (using ui:ListView with AutoHide ScrollBar) -->
                        <ui:ListView x:Name="AvailableNetworksListView"
                                     controls:AutoHideScrollBehavior.IsEnabled="True"
                                     Visibility="{Binding HasAvailableNetworks, Converter={StaticResource BoolToVis}}"
                                     ItemsSource="{Binding AvailableNetworks}"
                                     Background="Transparent"
                                     BorderThickness="0"
                                     Padding="0,0,10,0"
                                     ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                                     ScrollViewer.VerticalScrollBarVisibility="Auto"
                                     ScrollViewer.CanContentScroll="True"
                                     VirtualizingPanel.IsVirtualizing="True"
                                     VirtualizingPanel.VirtualizationMode="Recycling"
                                     VirtualizingPanel.ScrollUnit="Pixel"
                                     VirtualizingPanel.CacheLength="1,1"
                                     VirtualizingPanel.CacheLengthUnit="Page"
                                     SelectionMode="Single"
                                     Focusable="False">
                            <ui:ListView.Resources>
                                <!-- Universal 4px Fluent Floating ScrollBar from WidgetStyles.xaml -->
                                <Style TargetType="{x:Type ScrollBar}" BasedOn="{StaticResource WidgetFloatingScrollBarStyle}" />
                            </ui:ListView.Resources>
                            <ui:ListView.ItemContainerStyle>
                                <Style TargetType="{x:Type ListViewItem}">
                                    <Setter Property="HorizontalContentAlignment" Value="Stretch" />
                                    <Setter Property="Padding" Value="0" />
                                    <Setter Property="Margin" Value="0,2" />
                                    <Setter Property="Background" Value="Transparent" />
                                    <Setter Property="BorderBrush" Value="Transparent" />
                                    <Setter Property="BorderThickness" Value="1" />
                                    <Setter Property="FocusVisualStyle" Value="{x:Null}" />
                                    <Setter Property="Template">
                                        <Setter.Value>
                                            <ControlTemplate TargetType="{x:Type ListViewItem}">
                                                <Border x:Name="ItemBorder"
                                                        Background="{TemplateBinding Background}"
                                                        BorderBrush="{TemplateBinding BorderBrush}"
                                                        BorderThickness="{TemplateBinding BorderThickness}"
                                                        CornerRadius="2"
                                                        SnapsToDevicePixels="True">
                                                    <ContentPresenter />
                                                </Border>
                                                <ControlTemplate.Triggers>
                                                    <Trigger Property="IsMouseOver" Value="True">
                                                        <Setter Property="Background" Value="#0AFFFFFF" />
                                                        <Setter Property="BorderBrush" Value="#14FFFFFF" />
                                                    </Trigger>
                                                    <DataTrigger Binding="{Binding IsExpanded}" Value="True">
                                                        <Setter Property="Background" Value="#0DFFFFFF" />
                                                        <Setter Property="BorderBrush" Value="#25FFFFFF" />
                                                    </DataTrigger>
                                                    <MultiDataTrigger>
                                                        <MultiDataTrigger.Conditions>
                                                            <Condition Binding="{Binding IsExpanded}" Value="True" />
                                                            <Condition Binding="{Binding RelativeSource={RelativeSource Self}, Path=IsMouseOver}" Value="True" />
                                                        </MultiDataTrigger.Conditions>
                                                        <Setter Property="Background" Value="#12FFFFFF" />
                                                        <Setter Property="BorderBrush" Value="#32FFFFFF" />
                                                    </MultiDataTrigger>
                                                    <Trigger Property="IsSelected" Value="True">
                                                        <Setter Property="Background" Value="#0DFFFFFF" />
                                                        <Setter Property="BorderBrush" Value="#25FFFFFF" />
                                                    </Trigger>
                                                </ControlTemplate.Triggers>
                                            </ControlTemplate>
                                        </Setter.Value>
                                    </Setter>
                                </Style>
                            </ui:ListView.ItemContainerStyle>
                            <ui:ListView.ItemTemplate>
                                <DataTemplate DataType="{x:Type network:WifiNetworkItemViewModel}">
                                    <Grid SnapsToDevicePixels="True">
                                        <Grid.RowDefinitions>
                                            <RowDefinition Height="Auto" />
                                            <RowDefinition Height="Auto" />
                                        </Grid.RowDefinitions>

                                        <!-- Row 0: Summary Row — full-width clickable button -->
                                        <Button Grid.Row="0"
                                                Command="{Binding DataContext.ToggleNetworkExpandCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                CommandParameter="{Binding}"
                                                Background="Transparent"
                                                BorderThickness="0"
                                                Padding="8,8"
                                                HorizontalAlignment="Stretch"
                                                HorizontalContentAlignment="Stretch"
                                                Focusable="False"
                                                Cursor="Hand">
                                            <Button.Template>
                                                <ControlTemplate TargetType="Button">
                                                    <Border Background="{TemplateBinding Background}"
                                                            Padding="{TemplateBinding Padding}"
                                                            HorizontalAlignment="Stretch">
                                                        <ContentPresenter HorizontalAlignment="Stretch"
                                                                          VerticalAlignment="Center" />
                                                    </Border>
                                                </ControlTemplate>
                                            </Button.Template>

                                            <Grid HorizontalAlignment="Stretch">
                                                <Grid.ColumnDefinitions>
                                                    <!-- Column 0: Left Pill Indicator (Green = Connected, White = Disconnected) -->
                                                    <ColumnDefinition Width="Auto" />
                                                    <!-- Column 1: Wi-Fi Signal Icon -->
                                                    <ColumnDefinition Width="Auto" />
                                                    <!-- Column 2: SSID + Subtitle -->
                                                    <ColumnDefinition Width="*" />
                                                </Grid.ColumnDefinitions>

                                                <!-- Far-Left Status Pill: Green when connected, White when disconnected -->
                                                <Border Grid.Column="0"
                                                        Width="3"
                                                        Height="16"
                                                        Background="{Binding IndicatorPillColor, Converter={StaticResource StringToBrush}}"
                                                        CornerRadius="1.5"
                                                        VerticalAlignment="Center"
                                                        Margin="0,0,8,0"
                                                        SnapsToDevicePixels="True" />

                                                <!-- Segoe Fluent Icons TextBlock: uniform signal glyph, clean neutral white -->
                                                <TextBlock Grid.Column="1"
                                                           Text="{Binding WifiSignalGlyph}"
                                                           FontFamily="{DynamicResource AppIconFontFamily}"
                                                           FontSize="18"
                                                           Foreground="{Binding WifiIconColor, Converter={StaticResource StringToBrush}}"
                                                           VerticalAlignment="Center"
                                                           Margin="0,0,12,0"
                                                           SnapsToDevicePixels="True" />

                                                <!-- SSID + Subtitle (neutral typography) -->
                                                <StackPanel Grid.Column="2" VerticalAlignment="Center">
                                                    <TextBlock Text="{Binding Ssid}"
                                                               FontSize="13"
                                                               FontWeight="SemiBold"
                                                               Foreground="#F2FFFFFF"
                                                               TextTrimming="CharacterEllipsis"
                                                               ToolTip="{Binding Ssid}" />
                                                    <TextBlock Text="{Binding SubtitleText}"
                                                               FontSize="11"
                                                               Foreground="{Binding SubtitleColor, Converter={StaticResource StringToBrush}}"
                                                               Margin="0,2,0,0" />
                                                </StackPanel>
                                            </Grid>
                                        </Button>

                                        <!-- Row 1: Animated Accordion Drawer (Seamless unified card content, zero nested border conflict) -->
                                        <Border Grid.Row="1"
                                                x:Name="AccordionDrawer"
                                                ClipToBounds="True"
                                                Background="Transparent"
                                                BorderThickness="0"
                                                Margin="0"
                                                SnapsToDevicePixels="True"
                                                IsVisibleChanged="AccordionDrawer_IsVisibleChanged"
                                                SizeChanged="AccordionDrawer_SizeChanged">
                                            <Border.Style>
                                                <Style TargetType="Border">
                                                    <Setter Property="MaxHeight" Value="0" />
                                                    <Setter Property="Opacity" Value="0.0" />
                                                    <Setter Property="Visibility" Value="Collapsed" />
                                                    <Style.Triggers>
                                                        <DataTrigger Binding="{Binding IsExpanded}" Value="True">
                                                            <Setter Property="Visibility" Value="Visible" />
                                                            <Setter Property="MaxHeight" Value="260" />
                                                            <Setter Property="Opacity" Value="1.0" />
                                                            <DataTrigger.EnterActions>
                                                                <BeginStoryboard>
                                                                    <Storyboard>
                                                                        <DoubleAnimation Storyboard.TargetProperty="MaxHeight"
                                                                                         From="0" To="240"
                                                                                         Duration="0:0:0.24">
                                                                            <DoubleAnimation.EasingFunction>
                                                                                <CubicEase EasingMode="EaseOut" />
                                                                            </DoubleAnimation.EasingFunction>
                                                                        </DoubleAnimation>
                                                                        <DoubleAnimation Storyboard.TargetProperty="Opacity"
                                                                                         From="0.0" To="1.0"
                                                                                         Duration="0:0:0.20">
                                                                            <DoubleAnimation.EasingFunction>
                                                                                <CubicEase EasingMode="EaseOut" />
                                                                            </DoubleAnimation.EasingFunction>
                                                                        </DoubleAnimation>
                                                                    </Storyboard>
                                                                </BeginStoryboard>
                                                            </DataTrigger.EnterActions>
                                                            <DataTrigger.ExitActions>
                                                                <BeginStoryboard>
                                                                    <Storyboard>
                                                                        <DoubleAnimation Storyboard.TargetProperty="MaxHeight"
                                                                                         To="0"
                                                                                         Duration="0:0:0.16">
                                                                            <DoubleAnimation.EasingFunction>
                                                                                <CubicEase EasingMode="EaseIn" />
                                                                            </DoubleAnimation.EasingFunction>
                                                                        </DoubleAnimation>
                                                                        <DoubleAnimation Storyboard.TargetProperty="Opacity"
                                                                                         To="0.0"
                                                                                         Duration="0:0:0.12">
                                                                            <DoubleAnimation.EasingFunction>
                                                                                <CubicEase EasingMode="EaseIn" />
                                                                            </DoubleAnimation.EasingFunction>
                                                                        </DoubleAnimation>
                                                                    </Storyboard>
                                                                </BeginStoryboard>
                                                            </DataTrigger.ExitActions>
                                                        </DataTrigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </Border.Style>

                                            <StackPanel Margin="12,2,12,12">
                                                <!-- Wi-Fi Standard + Security -->
                                                <TextBlock Text="{Binding SecurityDetailsDisplay}"
                                                           FontSize="11.5"
                                                           FontWeight="SemiBold"
                                                           Foreground="#70FFFFFF"
                                                           Margin="0,0,0,8" />

                                                <!-- Password section (only for unsaved secured non-connected networks) -->
                                                <StackPanel Visibility="{Binding IsPasswordPromptOpen, Converter={StaticResource BoolToVis}}"
                                                            Margin="0,0,0,8">
                                                    <!-- Error indicator positioned where "Network password" was -->
                                                    <TextBlock Text="Incorrect password"
                                                               Visibility="{Binding HasConnectionError, Converter={StaticResource BoolToVis}}"
                                                               FontSize="11"
                                                               FontWeight="SemiBold"
                                                               Foreground="#FF4D4D"
                                                               Margin="0,0,0,4" />

                                                    <!-- WPF-UI ui:PasswordBox: transparent background, no orange indicator -->
                                                    <ui:PasswordBox x:Name="WifiPasswordBox"
                                                                    Height="32"
                                                                    FontSize="12.5"
                                                                    Foreground="#FFFFFF"
                                                                    Background="Transparent"
                                                                    BorderBrush="#25FFFFFF"
                                                                    BorderThickness="1"
                                                                    PlaceholderText="Password..."
                                                                    ClearButtonEnabled="False"
                                                                    RevealButtonEnabled="True"
                                                                    Icon="{ui:SymbolIcon Key20}"
                                                                    KeyDown="WifiPasswordBox_KeyDown">
                                                        <ui:PasswordBox.Resources>
                                                            <SolidColorBrush x:Key="TextControlFocusedBorderBrush" Color="Transparent" />
                                                            <SolidColorBrush x:Key="ControlStrokeColorDefaultBrush" Color="Transparent" />
                                                            <SolidColorBrush x:Key="TextControlBackground" Color="Transparent" />
                                                            <SolidColorBrush x:Key="TextControlBackgroundFocused" Color="Transparent" />
                                                            <SolidColorBrush x:Key="TextControlBackgroundPointerOver" Color="Transparent" />
                                                        </ui:PasswordBox.Resources>
                                                    </ui:PasswordBox>
                                                </StackPanel>

                                                <!-- Action Buttons (Right-Aligned) -->
                                                <StackPanel HorizontalAlignment="Right" Orientation="Horizontal">

                                                    <!-- Forget (shown next to Connect / Disconnect for saved profiles) -->
                                                    <Button Content="Forget"
                                                            Command="{Binding DataContext.ForgetWifiNetworkCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                            CommandParameter="{Binding}"
                                                            Width="80"
                                                            Height="26"
                                                            Margin="0,0,6,0">
                                                        <Button.Style>
                                                            <Style TargetType="Button" BasedOn="{StaticResource FluentWifiDisconnectButtonStyle}">
                                                                <Setter Property="Visibility" Value="Collapsed" />
                                                                <Style.Triggers>
                                                                    <MultiDataTrigger>
                                                                        <MultiDataTrigger.Conditions>
                                                                            <Condition Binding="{Binding IsProfileKnown}" Value="True" />
                                                                            <Condition Binding="{Binding IsConnecting}" Value="False" />
                                                                            <Condition Binding="{Binding IsPasswordPromptOpen}" Value="False" />
                                                                        </MultiDataTrigger.Conditions>
                                                                        <Setter Property="Visibility" Value="Visible" />
                                                                    </MultiDataTrigger>
                                                                </Style.Triggers>
                                                            </Style>
                                                        </Button.Style>
                                                    </Button>

                                                    <!-- Connecting spinner -->
                                                    <Border Visibility="{Binding IsConnecting, Converter={StaticResource BoolToVis}}"
                                                            Background="#10FFFFFF"
                                                            BorderBrush="#18FFFFFF"
                                                            BorderThickness="1"
                                                            CornerRadius="2"
                                                            Width="80"
                                                            Height="26">
                                                        <ui:ProgressRing IsIndeterminate="True"
                                                                         Width="14"
                                                                         Height="14"
                                                                         Foreground="#FFFFFF"
                                                                         HorizontalAlignment="Center"
                                                                         VerticalAlignment="Center" />
                                                    </Border>

                                                    <!-- Disconnect (connected, not connecting) -->
                                                    <Button Content="Disconnect"
                                                            Command="{Binding DataContext.DisconnectWifiNetworkCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                            CommandParameter="{Binding}"
                                                            Width="80"
                                                            Height="26">
                                                        <Button.Style>
                                                            <Style TargetType="Button" BasedOn="{StaticResource FluentWifiDisconnectButtonStyle}">
                                                                <Setter Property="Visibility" Value="Collapsed" />
                                                                <Style.Triggers>
                                                                    <MultiDataTrigger>
                                                                        <MultiDataTrigger.Conditions>
                                                                            <Condition Binding="{Binding IsConnected}" Value="True" />
                                                                            <Condition Binding="{Binding IsConnecting}" Value="False" />
                                                                        </MultiDataTrigger.Conditions>
                                                                        <Setter Property="Visibility" Value="Visible" />
                                                                    </MultiDataTrigger>
                                                                </Style.Triggers>
                                                            </Style>
                                                        </Button.Style>
                                                    </Button>

                                                    <!-- Connect (not connected, not connecting, no password prompt) -->
                                                    <Button Content="Connect"
                                                            Command="{Binding DataContext.ConnectWifiNetworkCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                            CommandParameter="{Binding}"
                                                            Width="80"
                                                            Height="26">
                                                        <Button.Style>
                                                            <Style TargetType="Button" BasedOn="{StaticResource FluentWifiActionButtonStyle}">
                                                                <Setter Property="Visibility" Value="Collapsed" />
                                                                <Style.Triggers>
                                                                    <MultiDataTrigger>
                                                                        <MultiDataTrigger.Conditions>
                                                                            <Condition Binding="{Binding IsNotConnected}" Value="True" />
                                                                            <Condition Binding="{Binding IsConnecting}" Value="False" />
                                                                            <Condition Binding="{Binding IsPasswordPromptOpen}" Value="False" />
                                                                        </MultiDataTrigger.Conditions>
                                                                        <Setter Property="Visibility" Value="Visible" />
                                                                    </MultiDataTrigger>
                                                                </Style.Triggers>
                                                            </Style>
                                                        </Button.Style>
                                                    </Button>

                                                    <!-- Cancel + Connect (password prompt open) -->
                                                    <StackPanel Orientation="Horizontal">
                                                        <StackPanel.Style>
                                                            <Style TargetType="StackPanel">
                                                                <Setter Property="Visibility" Value="Collapsed" />
                                                                <Style.Triggers>
                                                                    <MultiDataTrigger>
                                                                        <MultiDataTrigger.Conditions>
                                                                            <Condition Binding="{Binding IsPasswordPromptOpen}" Value="True" />
                                                                            <Condition Binding="{Binding IsConnecting}" Value="False" />
                                                                        </MultiDataTrigger.Conditions>
                                                                        <Setter Property="Visibility" Value="Visible" />
                                                                    </MultiDataTrigger>
                                                                </Style.Triggers>
                                                            </Style>
                                                        </StackPanel.Style>

                                                        <Button Content="Cancel"
                                                                Style="{StaticResource FluentWifiDisconnectButtonStyle}"
                                                                Command="{Binding DataContext.CancelWifiPasswordCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                                CommandParameter="{Binding ElementName=WifiPasswordBox}"
                                                                Width="80"
                                                                Height="26"
                                                                Margin="0,0,6,0" />

                                                        <Button Content="Connect"
                                                                Style="{StaticResource FluentWifiActionButtonStyle}"
                                                                Command="{Binding DataContext.ConnectWithPasswordCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                                CommandParameter="{Binding ElementName=WifiPasswordBox}"
                                                                Width="80"
                                                                Height="26" />
                                                    </StackPanel>
                                                </StackPanel>
                                            </StackPanel>
                                        </Border>
                                    </Grid>
                                </DataTemplate>
                            </ui:ListView.ItemTemplate>
                        </ui:ListView>
                    </Grid>

                    <!-- Content Row: View 2 - Clean Professional Fluent Banner (When Wi-Fi Radio is Turned OFF) -->
                    <Grid Grid.Row="2"
                          Visibility="{Binding IsWifiTurnedOffBannerVisible, Converter={StaticResource BoolToVis}}"
                          VerticalAlignment="Center"
                          HorizontalAlignment="Center"
                          Margin="0,32,0,32"
                          SnapsToDevicePixels="True">
                        <Grid.Style>
                            <Style TargetType="Grid">
                                <Style.Triggers>
                                    <Trigger Property="Visibility" Value="Visible">
                                        <Trigger.EnterActions>
                                            <BeginStoryboard>
                                                <Storyboard>
                                                    <DoubleAnimation Storyboard.TargetProperty="Opacity"
                                                                     From="0.0" To="1.0"
                                                                     Duration="0:0:0.2" />
                                                </Storyboard>
                                            </BeginStoryboard>
                                        </Trigger.EnterActions>
                                    </Trigger>
                                </Style.Triggers>
                            </Style>
                        </Grid.Style>
                        <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center">
                            <ui:SymbolIcon Symbol="WifiOff24"
                                           FontSize="38"
                                           Foreground="#45FFFFFF"
                                           HorizontalAlignment="Center"
                                           Margin="0,0,0,12" />
                            <TextBlock Text="{Binding WifiTurnedOffBannerTitle}"
                                       FontFamily="{DynamicResource AppDisplayFontFamily}"
                                       FontSize="16"
                                       FontWeight="Bold"
                                       Foreground="#D0FFFFFF"
                                       HorizontalAlignment="Center" />
                        </StackPanel>
                    </Grid>

                    <!-- Content Row: View 3 - Centered Fluent Progress Ring (When Wi-Fi Radio is Transitioning / Turning On or Off) -->
                    <Grid Grid.Row="2"
                          Visibility="{Binding IsWifiRadioBusy, Converter={StaticResource BoolToVis}}"
                          VerticalAlignment="Center"
                          HorizontalAlignment="Center"
                          Margin="0,32,0,32"
                          SnapsToDevicePixels="True">
                        <Grid.Style>
                            <Style TargetType="Grid">
                                <Style.Triggers>
                                    <Trigger Property="Visibility" Value="Visible">
                                        <Trigger.EnterActions>
                                            <BeginStoryboard>
                                                <Storyboard>
                                                    <DoubleAnimation Storyboard.TargetProperty="Opacity"
                                                                     From="0.0" To="1.0"
                                                                     Duration="0:0:0.15" />
                                                </Storyboard>
                                            </BeginStoryboard>
                                        </Trigger.EnterActions>
                                    </Trigger>
                                </Style.Triggers>
                            </Style>
                        </Grid.Style>
                        <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center">
                            <ui:ProgressRing IsIndeterminate="True"
                                             Width="36"
                                             Height="36"
                                             Foreground="#FFFFFF"
                                             HorizontalAlignment="Center"
                                             Margin="0,0,0,12" />
                            <TextBlock Text="{Binding WifiTransitionStatusText}"
                                       FontSize="13"
                                       FontWeight="SemiBold"
                                       Foreground="#B0FFFFFF"
                                       HorizontalAlignment="Center" />
                        </StackPanel>
                    </Grid>
                </Grid>

                <!-- ==================== 3. ADAPTERS PANEL ==================== -->
                <Grid Visibility="{Binding IsAdaptersPanel, Converter={StaticResource BoolToVis}}"
                      Margin="20,14,20,14"
                      SnapsToDevicePixels="True">
                    <Grid.RowDefinitions>
                        <!-- Row 0: Top Header: [ 🛠️ ] Disable network adapters (requires admin rights) + Refresh -->
                        <RowDefinition Height="Auto" />
                        <!-- Row 1: Hairline Separator -->
                        <RowDefinition Height="Auto" />
                        <!-- Row 2: Adapters List or Empty State -->
                        <RowDefinition Height="*" />
                    </Grid.RowDefinitions>

                    <!-- Top Header: [ 🛡️ ] Disable Network Adapters   [ Refresh Button ] -->
                    <Grid Grid.Row="0" Height="26" Margin="0,0,0,10">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>

                        <!-- Left: Icon + Title -->
                        <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center">
                            <ui:SymbolIcon Symbol="ShieldQuestion32"
                                           FontSize="18"
                                           Foreground="#FFFFFF"
                                           VerticalAlignment="Center"
                                           Margin="0,0,10,0" />
                            <TextBlock Text="Disable Network Adapters"
                                       FontFamily="{DynamicResource AppDisplayFontFamily}"
                                       FontSize="16"
                                       FontWeight="SemiBold"
                                       Foreground="#FFFFFF"
                                       VerticalAlignment="Center"
                                       TextTrimming="CharacterEllipsis" />
                        </StackPanel>

                        <!-- Right: Refresh Button -->
                        <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                            <Button Style="{StaticResource MicroIconButtonStyle}"
                                    Width="32"
                                    Height="28"
                                    VerticalAlignment="Center"
                                    Command="{Binding RefreshAdaptersCommand}"
                                    ToolTip="Scan for hardware adapters">
                            <ui:SymbolIcon Symbol="ArrowClockwise24"
                                           FontSize="16"
                                           Foreground="#D0FFFFFF"
                                           RenderTransformOrigin="0.5,0.5">
                                <ui:SymbolIcon.RenderTransform>
                                    <RotateTransform Angle="0" />
                                </ui:SymbolIcon.RenderTransform>
                                <ui:SymbolIcon.Style>
                                    <Style TargetType="{x:Type ui:SymbolIcon}">
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding IsRefreshingAdaptersVisual}" Value="True">
                                                <DataTrigger.EnterActions>
                                                    <BeginStoryboard x:Name="SpinRefreshAdaptersStoryboard">
                                                        <Storyboard RepeatBehavior="Forever">
                                                            <DoubleAnimation Storyboard.TargetProperty="(UIElement.RenderTransform).(RotateTransform.Angle)"
                                                                             From="0" To="360"
                                                                             Duration="0:0:0.75" />
                                                        </Storyboard>
                                                    </BeginStoryboard>
                                                </DataTrigger.EnterActions>
                                                <DataTrigger.ExitActions>
                                                    <StopStoryboard BeginStoryboardName="SpinRefreshAdaptersStoryboard" />
                                                </DataTrigger.ExitActions>
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </ui:SymbolIcon.Style>
                            </ui:SymbolIcon>
                        </Button>
                        </StackPanel>
                    </Grid>

                    <!-- Row 1: Hairline Divider (Same as Ethernet & Wi-Fi) -->
                    <Border Grid.Row="1"
                            Height="1"
                            Background="#14FFFFFF"
                            Margin="0,0,0,14"
                            SnapsToDevicePixels="True" />

                    <!-- Row 2: Content (List of Adapters or Empty State) -->
                    <Grid Grid.Row="2" SnapsToDevicePixels="True">
                        <!-- 1. Adapter List with Floating Scrollbar -->
                        <ScrollViewer Visibility="{Binding HasPhysicalAdapters, Converter={StaticResource BoolToVis}}"
                                      Style="{StaticResource WidgetFloatingScrollViewerStyle}"
                                      VerticalScrollBarVisibility="Auto"
                                      HorizontalScrollBarVisibility="Disabled"
                                      Focusable="False"
                                      SnapsToDevicePixels="True">
                            <ItemsControl ItemsSource="{Binding PhysicalAdapters}">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate DataType="{x:Type network:PhysicalAdapterItemViewModel}">
                                        <!-- 56px Card Matching Wi-Fi UI Convention, hover-only container, 2px CornerRadius -->
                                        <Border Height="56"
                                                CornerRadius="2"
                                                BorderThickness="1"
                                                Margin="0,0,0,4"
                                                SnapsToDevicePixels="True">
                                            <Border.Style>
                                                <Style TargetType="Border">
                                                    <Setter Property="Background" Value="Transparent" />
                                                    <Setter Property="BorderBrush" Value="Transparent" />
                                                    <Style.Triggers>
                                                        <Trigger Property="IsMouseOver" Value="True">
                                                            <Setter Property="Background" Value="#14FFFFFF" />
                                                            <Setter Property="BorderBrush" Value="#25FFFFFF" />
                                                        </Trigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </Border.Style>

                                            <Grid Margin="14,0,14,0">
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="Auto" />
                                                    <ColumnDefinition Width="*" />
                                                    <ColumnDefinition Width="Auto" />
                                                </Grid.ColumnDefinitions>

                                                <!-- Left: Hardware Icon (Dimmed when disabled) -->
                                                <TextBlock Grid.Column="0"
                                                           Text="{Binding Glyph}"
                                                           FontFamily="{DynamicResource AppIconFontFamily}"
                                                           FontSize="18"
                                                           Foreground="#FFFFFF"
                                                           Opacity="{Binding IconOpacity}"
                                                           VerticalAlignment="Center"
                                                           Margin="0,0,14,0"
                                                           SnapsToDevicePixels="True" />

                                                <!-- Center: Name + Subtitle (Description • Status) -->
                                                <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                                    <TextBlock Text="{Binding Name}"
                                                               FontSize="13"
                                                               FontWeight="SemiBold"
                                                               Foreground="#F2FFFFFF"
                                                               TextTrimming="CharacterEllipsis"
                                                               ToolTip="{Binding Name}" />
                                                    <TextBlock Text="{Binding SubtitleText}"
                                                               FontSize="11"
                                                               Foreground="#85FFFFFF"
                                                               TextWrapping="Wrap"
                                                               TextTrimming="CharacterEllipsis"
                                                               ToolTip="{Binding SubtitleText}"
                                                               Margin="0,2,0,0" />
                                                </StackPanel>

                                                <!-- Right: Fixed 76px container so toggle switch NEVER jumps left/right -->
                                                <Grid Grid.Column="2" VerticalAlignment="Center" Width="76" HorizontalAlignment="Right">
                                                    <!-- Smooth Micro Progress Ring (Left slot) -->
                                                    <ui:ProgressRing Visibility="{Binding IsBusy, Converter={StaticResource BoolToVis}}"
                                                                     IsIndeterminate="True"
                                                                     Width="14"
                                                                     Height="14"
                                                                     Foreground="#FFFFFF"
                                                                     HorizontalAlignment="Left"
                                                                     VerticalAlignment="Center"
                                                                     Margin="4,0,0,0" />

                                                    <!-- Fluent Green ToggleSwitch (Anchored to right, locked in position, never collapses) -->
                                                    <ui:ToggleSwitch Style="{StaticResource FluentGreenToggleSwitchStyle}"
                                                                     IsChecked="{Binding IsAdminEnabled, Mode=TwoWay}"
                                                                     IsEnabled="{Binding CanToggle}"
                                                                     PreviewMouseLeftButtonDown="AdapterToggleSwitch_PreviewMouseLeftButtonDown"
                                                                     KeyDown="AdapterToggleSwitch_KeyDown"
                                                                     HorizontalAlignment="Right"
                                                                     VerticalAlignment="Center"
                                                                     Focusable="True"
                                                                     Cursor="Hand" />
                                                </Grid>
                                            </Grid>
                                        </Border>
                                    </DataTemplate>
                                 </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </ScrollViewer>

                        <!-- 2. Empty State (Aligned to Ethernet & Wi-Fi Banner Scale) -->
                        <Grid Visibility="{Binding HasNoPhysicalAdapters, Converter={StaticResource BoolToVis}}"
                              VerticalAlignment="Center"
                              HorizontalAlignment="Center"
                              Margin="0,32,0,32"
                              SnapsToDevicePixels="True">
                            <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center">
                                <ui:SymbolIcon Symbol="DismissCircle24"
                                               FontSize="38"
                                               Foreground="#45FFFFFF"
                                               HorizontalAlignment="Center"
                                               Margin="0,0,0,12" />
                                <TextBlock Text="No Adapters Detected"
                                           FontFamily="{DynamicResource AppDisplayFontFamily}"
                                           FontSize="16"
                                           FontWeight="Bold"
                                           Foreground="#D0FFFFFF"
                                           HorizontalAlignment="Center" />
                                <TextBlock Text="No physical Ethernet or Wi-Fi hardware interfaces available"
                                           FontSize="12"
                                           FontWeight="SemiBold"
                                           Foreground="#85FFFFFF"
                                           HorizontalAlignment="Center"
                                           Margin="0,6,0,0" />
                            </StackPanel>
                        </Grid>
                    </Grid>
                </Grid>

                <!-- ==================== 4. SPEED TEST PANEL ==================== -->
                <Grid Visibility="{Binding IsSpeedPanel, Converter={StaticResource BoolToVis}}"
                      Margin="20,10,20,14"
                      SnapsToDevicePixels="True">
                    <Grid.RowDefinitions>
                        <!-- Row 0: Center Stage (Gauge when running / "GO" when stopped - scaled to panel size) -->
                        <RowDefinition Height="136" />
                        <!-- Row 1: Unified Dual Metrics Card (Download | Upload) + Horizontal Status Bar -->
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>

                    <!-- ROW 0: CENTER STAGE -->
                    <Grid Grid.Row="0" HorizontalAlignment="Center" VerticalAlignment="Center" SnapsToDevicePixels="True">

                        <!-- A. RUNNING GAUGE STAGE (Smoothly appears ONLY when running, pure gauge without speed text) -->
                        <Grid x:Name="RunningGaugeStage"
                              HorizontalAlignment="Center"
                              VerticalAlignment="Center">
                            <Grid.Style>
                                <Style TargetType="Grid">
                                    <Setter Property="Opacity" Value="0.0" />
                                    <Setter Property="IsHitTestVisible" Value="False" />
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding IsSpeedTestRunning}" Value="True">
                                            <DataTrigger.EnterActions>
                                                <BeginStoryboard>
                                                    <Storyboard>
                                                        <DoubleAnimation Storyboard.TargetProperty="Opacity"
                                                                         To="1.0" Duration="0:0:0.35" />
                                                    </Storyboard>
                                                </BeginStoryboard>
                                            </DataTrigger.EnterActions>
                                            <DataTrigger.ExitActions>
                                                <BeginStoryboard>
                                                    <Storyboard>
                                                        <DoubleAnimation Storyboard.TargetProperty="Opacity"
                                                                         To="0.0" Duration="0:0:0.25" />
                                                    </Storyboard>
                                                </BeginStoryboard>
                                            </DataTrigger.ExitActions>
                                            <Setter Property="IsHitTestVisible" Value="True" />
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </Grid.Style>

                            <!-- Clean 180° Fluent Semi-Circle Gauge (pure arc with clean spacious numbers) -->
                            <network:SpeedometerArcControl Width="270" Height="124"
                                                          HorizontalAlignment="Center"
                                                          VerticalAlignment="Center"
                                                          SpeedMbps="{Binding SpeedTestGaugeMbps}"
                                                          ProgressBrush="{Binding SpeedTestArcBrush}"
                                                          IsActive="{Binding IsSpeedTestRunning}" />
                        </Grid>

                        <!-- B. STOPPED / IDLE "GO" STAGE (Smoothly appears ONLY when stopped / idle) -->
                        <Grid x:Name="IdleGoStage"
                              HorizontalAlignment="Center"
                              VerticalAlignment="Center">
                            <Grid.Style>
                                <Style TargetType="Grid">
                                    <Setter Property="Opacity" Value="1.0" />
                                    <Setter Property="IsHitTestVisible" Value="True" />
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding IsSpeedTestRunning}" Value="True">
                                            <DataTrigger.EnterActions>
                                                <BeginStoryboard>
                                                    <Storyboard>
                                                        <DoubleAnimation Storyboard.TargetProperty="Opacity"
                                                                         To="0.0" Duration="0:0:0.25" />
                                                    </Storyboard>
                                                </BeginStoryboard>
                                            </DataTrigger.EnterActions>
                                            <DataTrigger.ExitActions>
                                                <BeginStoryboard>
                                                    <Storyboard>
                                                        <DoubleAnimation Storyboard.TargetProperty="Opacity"
                                                                         To="1.0" Duration="0:0:0.35" />
                                                    </Storyboard>
                                                </BeginStoryboard>
                                            </DataTrigger.ExitActions>
                                            <Setter Property="IsHitTestVisible" Value="False" />
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </Grid.Style>

                            <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center">
                                <Button Style="{StaticResource SpeedPureGoButtonStyle}"
                                        Command="{Binding StartSpeedTestCommand}"
                                        ToolTip="{Binding SpeedTestStatusMessage}" />
                                <TextBlock Text="{Binding SpeedTestStatusMessage}"
                                           FontSize="13"
                                           FontWeight="SemiBold"
                                           Foreground="#FF6B6B"
                                           HorizontalAlignment="Center"
                                           TextAlignment="Center"
                                           TextWrapping="Wrap"
                                           MaxWidth="240"
                                           Margin="0,8,0,0"
                                           Visibility="{Binding IsSpeedTestFailed, Converter={StaticResource BoolToVis}}" />
                            </StackPanel>
                        </Grid>
                    </Grid>

                    <!-- ROW 1: METRICS REGION (Flush with panel bounds, matching Ethernet and Wi-Fi separator) -->
                    <Grid Grid.Row="1"
                          HorizontalAlignment="Stretch"
                          SnapsToDevicePixels="True">
                        <Grid.RowDefinitions>
                            <!-- Row 0: Top Metrics (Download on Left, Upload on Right) -->
                            <RowDefinition Height="56" />
                            <!-- Row 1: Separator matching Ethernet & Wi-Fi (1px, #14FFFFFF) -->
                            <RowDefinition Height="1" />
                            <!-- Row 2: Bottom Status (Ping Left, 3 Dots Center, Jitter Right) -->
                            <RowDefinition Height="32" />
                        </Grid.RowDefinitions>

                        <!-- ROW 0: TOP METRICS (Download flush-left, Upload flush-right with separator) -->
                        <Grid Grid.Row="0" Margin="0" VerticalAlignment="Center">
                            <Grid.ColumnDefinitions>
                                <!-- Left: Download -->
                                <ColumnDefinition Width="*" />
                                <!-- Right: Upload -->
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>

                            <!-- Left: Download (Flush with left end of separator) -->
                            <StackPanel Grid.Column="0" HorizontalAlignment="Left" VerticalAlignment="Center">
                                <TextBlock Text="Download"
                                           FontSize="12"
                                           FontWeight="Medium"
                                           Foreground="#95FFFFFF"
                                           Margin="0,0,0,3" />
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock Text="{Binding SpeedTestDownloadDisplay}"
                                               FontFamily="{DynamicResource AppDisplayFontFamily}"
                                               FontSize="22"
                                               FontWeight="Bold"
                                               Foreground="#FFFFFF"
                                               Typography.NumeralAlignment="Tabular" />
                                    <TextBlock Text=" Mbps"
                                               FontSize="12.5"
                                               Foreground="#80FFFFFF"
                                               VerticalAlignment="Bottom"
                                               Margin="0,0,0,2" />
                                </StackPanel>
                            </StackPanel>

                            <!-- Right: Upload (Flush with right end of separator) -->
                            <StackPanel Grid.Column="1" HorizontalAlignment="Right" VerticalAlignment="Center">
                                <TextBlock Text="Upload"
                                           FontSize="12"
                                           FontWeight="Medium"
                                           Foreground="#95FFFFFF"
                                           HorizontalAlignment="Right"
                                           Margin="0,0,0,3" />
                                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                                    <TextBlock Text="{Binding SpeedTestUploadDisplay}"
                                               FontFamily="{DynamicResource AppDisplayFontFamily}"
                                               FontSize="22"
                                               FontWeight="Bold"
                                               Foreground="#FFFFFF"
                                               Typography.NumeralAlignment="Tabular" />
                                    <TextBlock Text=" Mbps"
                                               FontSize="12.5"
                                               Foreground="#80FFFFFF"
                                               VerticalAlignment="Bottom"
                                               Margin="0,0,0,2" />
                                </StackPanel>
                            </StackPanel>
                        </Grid>

                        <!-- ROW 1: SEPARATOR (Exact same length, thickness, and color as Ethernet & Wi-Fi) -->
                        <Border Grid.Row="1"
                                Height="1"
                                HorizontalAlignment="Stretch"
                                Background="#14FFFFFF"
                                SnapsToDevicePixels="True" />

                        <!-- ROW 2: BOTTOM STATUS BAR (Ping flush-left, 3 Dots Center, Jitter flush-right) -->
                        <Grid Grid.Row="2" Margin="0" VerticalAlignment="Center">
                            <Grid.ColumnDefinitions>
                                <!-- Left: Ping -->
                                <ColumnDefinition Width="*" />
                                <!-- Center: 3 Focus-Timer Progress Dots -->
                                <ColumnDefinition Width="Auto" />
                                <!-- Right: Jitter -->
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>

                            <!-- Left: Ping (Flush with left end of separator) -->
                            <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center" HorizontalAlignment="Left">
                                <TextBlock Text="Ping "
                                           FontSize="11.5"
                                           Foreground="#75FFFFFF"
                                           VerticalAlignment="Center" />
                                <TextBlock Text="{Binding SpeedTestPingDisplay}"
                                           FontSize="11.5"
                                           FontWeight="SemiBold"
                                           Foreground="#FFFFFF"
                                           VerticalAlignment="Center"
                                           Typography.NumeralAlignment="Tabular" />
                            </StackPanel>

                            <!-- Center: 3 Progress Dots (Latency Yellow, Download Blue, Upload Purple) -->
                            <StackPanel Grid.Column="1"
                                        Orientation="Horizontal"
                                        HorizontalAlignment="Center"
                                        VerticalAlignment="Center">
                                <!-- Dot 1: Latency (Yellow #FFB703) -->
                                <Border x:Name="DotLatency" Style="{StaticResource SpeedTestDot1Style}" />

                                <!-- Dot 2: Download (Blue #0091FF) -->
                                <Border x:Name="DotDownload" Style="{StaticResource SpeedTestDot2Style}" />

                                <!-- Dot 3: Upload (Purple #A855F7) -->
                                <Border x:Name="DotUpload" Style="{StaticResource SpeedTestDot3Style}" />
                            </StackPanel>

                            <!-- Right: Jitter (Flush with right end of separator) -->
                            <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center" HorizontalAlignment="Right">
                                <TextBlock Text="Jitter "
                                           FontSize="11.5"
                                           Foreground="#75FFFFFF"
                                           VerticalAlignment="Center" />
                                <TextBlock Text="{Binding SpeedTestJitterDisplay}"
                                           FontSize="11.5"
                                           FontWeight="SemiBold"
                                           Foreground="#FFFFFF"
                                           VerticalAlignment="Center"
                                           Typography.NumeralAlignment="Tabular" />
                            </StackPanel>
                        </Grid>
                    </Grid>
                </Grid>

                <!-- ==================== 5. DATA USAGE & ANALYTICS PANEL ==================== -->
                <Grid Visibility="{Binding IsDataUsagePanel, Converter={StaticResource BoolToVis}}"
                      Margin="20,12,20,14"
                      Background="Transparent"
                      SnapsToDevicePixels="True">
                    <Grid.RowDefinitions>
                        <!-- Row 0: Centered Master Timeframe Segmented Control -->
                        <RowDefinition Height="Auto" />
                        <!-- Row 1: Top Hairline Divider -->
                        <RowDefinition Height="Auto" />
                        <!-- Row 2: Dual Interfaces (Wired & Wi-Fi) -->
                        <RowDefinition Height="*" />
                        <!-- Row 3: Bottom Hairline Divider -->
                        <RowDefinition Height="Auto" />
                        <!-- Row 4: Total Consumed Bottom Summary -->
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>

                    <!-- ROW 0: CENTERED MASTER TIMEFRAME SELECTOR -->
                    <widgets:WidgetSegmentedControl Grid.Row="0"
                                                    HorizontalAlignment="Center"
                                                    VerticalAlignment="Center"
                                                    Width="340"
                                                    Height="32"
                                                    Margin="0,0,0,8"
                                                    SelectedValue="{Binding SelectedDataUsageTimeframe, Mode=TwoWay}">
                        <widgets:WidgetSegmentedItem Content="Session" Value="{x:Static corenet:DataUsageTimeframe.Session}" Height="32" FontSize="13" />
                        <widgets:WidgetSegmentedItem Content="24h" Value="{x:Static corenet:DataUsageTimeframe.Last24Hours}" Height="32" FontSize="13" />
                        <widgets:WidgetSegmentedItem Content="7d" Value="{x:Static corenet:DataUsageTimeframe.Last7Days}" Height="32" FontSize="13" />
                        <widgets:WidgetSegmentedItem Content="30d" Value="{x:Static corenet:DataUsageTimeframe.Last30Days}" Height="32" FontSize="13" />
                    </widgets:WidgetSegmentedControl>

                    <!-- ROW 1: TOP HAIRLINE DIVIDER -->
                    <Border Grid.Row="1"
                            Height="1"
                            Background="#14FFFFFF"
                            Margin="0,4,0,16"
                            SnapsToDevicePixels="True" />

                    <!-- ROW 2: DUAL INTERFACES (Clean, Borderless, Monochromatic) -->
                    <Grid Grid.Row="2" VerticalAlignment="Center" SnapsToDevicePixels="True">
                        <Grid.ColumnDefinitions>
                            <!-- Column 0: Wired / USB Tethering -->
                            <ColumnDefinition Width="*" />
                            <!-- Column 1: Subtle Vertical Hairline Separator -->
                            <ColumnDefinition Width="Auto" />
                            <!-- Column 2: Wi-Fi -->
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>

                        <!-- ================= COLUMN 0: WIRED / USB TETHERING ================= -->
                        <StackPanel Grid.Column="0" HorizontalAlignment="Center" VerticalAlignment="Center">
                            <!-- Header: Icon + Title -->
                            <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" VerticalAlignment="Center">
                                <TextBlock Text="{Binding UsageWiredIcon}"
                                           FontFamily="{DynamicResource AppIconFontFamily}"
                                           FontSize="15"
                                           Foreground="#FFFFFF"
                                           VerticalAlignment="Center"
                                           Margin="0,0,7,0" />
                                <TextBlock Text="{Binding UsageWiredTitle}"
                                           FontSize="12"
                                           FontWeight="Bold"
                                           Foreground="#E0FFFFFF"
                                           VerticalAlignment="Center" />
                            </StackPanel>

                            <!-- Hero Big Usage Number -->
                            <TextBlock Text="{Binding EthernetUsageTotalDisplay}"
                                       FontFamily="{DynamicResource AppDisplayFontFamily}"
                                       FontSize="26"
                                       FontWeight="Bold"
                                       Foreground="#FFFFFF"
                                       HorizontalAlignment="Center"
                                       Margin="0,8,0,4"
                                       Typography.NumeralAlignment="Tabular" />

                            <!-- Rx / Tx Breakdown (when adapter exists) -->
                            <StackPanel Orientation="Horizontal"
                                        HorizontalAlignment="Center"
                                        Visibility="{Binding ShowEthernetUsageDetails, Converter={StaticResource BoolToVis}}">
                                <TextBlock Text="&#xE896;"
                                           FontFamily="{DynamicResource AppIconFontFamily}"
                                           FontSize="10"
                                           Foreground="#85FFFFFF"
                                           VerticalAlignment="Center"
                                           Margin="0,0,4,0" />
                                <TextBlock Text="{Binding EthernetDataUsage.FormattedReceived}"
                                           FontSize="11.5"
                                           Foreground="#90FFFFFF"
                                           VerticalAlignment="Center"
                                           Typography.NumeralAlignment="Tabular" />
                                <TextBlock Text="   " />
                                <TextBlock Text="&#xE898;"
                                           FontFamily="{DynamicResource AppIconFontFamily}"
                                           FontSize="10"
                                           Foreground="#85FFFFFF"
                                           VerticalAlignment="Center"
                                           Margin="0,0,4,0" />
                                <TextBlock Text="{Binding EthernetDataUsage.FormattedSent}"
                                           FontSize="11.5"
                                           Foreground="#90FFFFFF"
                                           VerticalAlignment="Center"
                                           Typography.NumeralAlignment="Tabular" />
                            </StackPanel>

                            <!-- No Adapter Fallback Text -->
                            <TextBlock Text="No adapter detected"
                                       FontSize="11.5"
                                       Foreground="#60FFFFFF"
                                       HorizontalAlignment="Center"
                                       VerticalAlignment="Center"
                                       Visibility="{Binding ShowEthernetNoAdapterText, Converter={StaticResource BoolToVis}}" />
                        </StackPanel>

                        <!-- Subtle 1px Vertical Separator -->
                        <Border Grid.Column="1"
                                Width="1"
                                Background="#14FFFFFF"
                                Margin="20,2,20,2"
                                SnapsToDevicePixels="True" />

                        <!-- ================= COLUMN 2: WI-FI ================= -->
                        <StackPanel Grid.Column="2" HorizontalAlignment="Center" VerticalAlignment="Center">
                            <!-- Header: Icon + Title -->
                            <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" VerticalAlignment="Center">
                                <TextBlock Text="&#xE701;"
                                           FontFamily="{DynamicResource AppIconFontFamily}"
                                           FontSize="15"
                                           Foreground="#FFFFFF"
                                           VerticalAlignment="Center"
                                           Margin="0,0,7,0" />
                                <TextBlock Text="Wi-Fi"
                                           FontSize="12"
                                           FontWeight="Bold"
                                           Foreground="#E0FFFFFF"
                                           VerticalAlignment="Center" />
                            </StackPanel>

                            <!-- Hero Big Usage Number -->
                            <TextBlock Text="{Binding WifiUsageTotalDisplay}"
                                       FontFamily="{DynamicResource AppDisplayFontFamily}"
                                       FontSize="26"
                                       FontWeight="Bold"
                                       Foreground="#FFFFFF"
                                       HorizontalAlignment="Center"
                                       Margin="0,8,0,4"
                                       Typography.NumeralAlignment="Tabular" />

                            <!-- Rx / Tx Breakdown (when adapter exists) -->
                            <StackPanel Orientation="Horizontal"
                                        HorizontalAlignment="Center"
                                        Visibility="{Binding ShowWifiUsageDetails, Converter={StaticResource BoolToVis}}">
                                <TextBlock Text="&#xE896;"
                                           FontFamily="{DynamicResource AppIconFontFamily}"
                                           FontSize="10"
                                           Foreground="#85FFFFFF"
                                           VerticalAlignment="Center"
                                           Margin="0,0,4,0" />
                                <TextBlock Text="{Binding WifiDataUsage.FormattedReceived}"
                                           FontSize="11.5"
                                           Foreground="#90FFFFFF"
                                           VerticalAlignment="Center"
                                           Typography.NumeralAlignment="Tabular" />
                                <TextBlock Text="   " />
                                <TextBlock Text="&#xE898;"
                                           FontFamily="{DynamicResource AppIconFontFamily}"
                                           FontSize="10"
                                           Foreground="#85FFFFFF"
                                           VerticalAlignment="Center"
                                           Margin="0,0,4,0" />
                                <TextBlock Text="{Binding WifiDataUsage.FormattedSent}"
                                           FontSize="11.5"
                                           Foreground="#90FFFFFF"
                                           VerticalAlignment="Center"
                                           Typography.NumeralAlignment="Tabular" />
                            </StackPanel>

                            <!-- No Adapter Fallback Text -->
                            <TextBlock Text="No adapter detected"
                                       FontSize="11.5"
                                       Foreground="#60FFFFFF"
                                       HorizontalAlignment="Center"
                                       VerticalAlignment="Center"
                                       Visibility="{Binding ShowWifiNoAdapterText, Converter={StaticResource BoolToVis}}" />
                        </StackPanel>
                    </Grid>

                    <!-- ROW 3: BOTTOM HAIRLINE DIVIDER -->
                    <Border Grid.Row="3"
                            Height="1"
                            Background="#14FFFFFF"
                            Margin="0,16,0,12"
                            SnapsToDevicePixels="True" />

                    <!-- ROW 4: TOTAL CONSUMED (BELOW ETHERNET & WI-FI) -->
                    <Grid Grid.Row="4" Margin="4,0,4,2" SnapsToDevicePixels="True">
                        <Grid.ColumnDefinitions>
                            <!-- Left: TOTAL CONSUMED + Big Value -->
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                            <!-- Right: Total Rx / Tx Breakdown -->
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>

                        <!-- Left: TOTAL CONSUMED Label + Hero Combined Total (Typographic Baseline Locked) -->
                        <TextBlock Grid.Column="0"
                                   VerticalAlignment="Center"
                                   Typography.NumeralAlignment="Tabular">
                            <Run Text="TOTAL CONSUMED"
                                 FontSize="11"
                                 FontWeight="Bold"
                                 Foreground="#70FFFFFF" />
                            <Run Text="  "
                                 FontSize="14" />
                            <Run Text="{Binding TotalCombinedDisplay, Mode=OneWay}"
                                 FontFamily="{DynamicResource AppDisplayFontFamily}"
                                 FontSize="20"
                                 FontWeight="Bold"
                                 Foreground="#FFFFFF" />
                        </TextBlock>

                        <!-- Right: Combined Rx / Tx Breakdown -->
                        <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center">
                            <TextBlock Text="&#xE896;"
                                       FontFamily="{DynamicResource AppIconFontFamily}"
                                       FontSize="10"
                                       Foreground="#85FFFFFF"
                                       VerticalAlignment="Center"
                                       Margin="0,0,4,0" />
                            <TextBlock Text="{Binding TotalCombinedReceivedDisplay}"
                                       FontSize="11.5"
                                       FontWeight="SemiBold"
                                       Foreground="#95FFFFFF"
