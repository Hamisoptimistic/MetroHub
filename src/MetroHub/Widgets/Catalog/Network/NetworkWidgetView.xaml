<UserControl x:Class="MetroHub.Widgets.Catalog.Network.NetworkWidgetView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:widgets="clr-namespace:MetroHub.Widgets"
             xmlns:network="clr-namespace:MetroHub.Widgets.Catalog.Network"
             xmlns:corenet="clr-namespace:MetroHub.Core.Network"
             xmlns:conv="clr-namespace:MetroHub.Presentation.Converters"
             xmlns:controls="clr-namespace:MetroHub.Presentation.Controls"
             xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
             mc:Ignorable="d" 
             d:DataContext="{d:DesignInstance Type=network:NetworkWidgetViewModel}"
             Focusable="False"
             FocusVisualStyle="{x:Null}"
             ClipToBounds="True"
             SnapsToDevicePixels="True"
             UseLayoutRounding="True"
             TextOptions.TextFormattingMode="Ideal"
             TextOptions.TextRenderingMode="Grayscale"
             TextOptions.TextHintingMode="Animated">

    <UserControl.Resources>
        <BooleanToVisibilityConverter x:Key="BoolToVis" />
        <conv:StringToBrushConverter x:Key="StringToBrush" />

        <!-- Strips default dotted focus border across all controls -->
        <Style TargetType="{x:Type Control}">
            <Setter Property="FocusVisualStyle" Value="{x:Null}" />
        </Style>

        <!-- Sleek Micro Copy Button Style -->
        <Style x:Key="MicroCopyButtonStyle" TargetType="Button">
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="BorderBrush" Value="Transparent" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="Width" Value="24" />
            <Setter Property="Height" Value="24" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Focusable" Value="False" />
            <Setter Property="FocusVisualStyle" Value="{x:Null}" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Border"
                                Background="{TemplateBinding Background}"
                                CornerRadius="4"
                                SnapsToDevicePixels="True">
                            <ui:SymbolIcon x:Name="CopyIcon"
                                           Symbol="Copy16"
                                           FontSize="13"
                                           Foreground="#80FFFFFF"
                                           HorizontalAlignment="Center"
                                           VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Border" Property="Background" Value="#1CFFFFFF" />
                                <Setter TargetName="CopyIcon" Property="Foreground" Value="#FFFFFF" />
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="Border" Property="Background" Value="#2EFFFFFF" />
                                <Setter TargetName="CopyIcon" Property="Foreground" Value="#FFFFFF" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Sleek Micro Icon Button Style (Generic ContentPresenter) -->
        <Style x:Key="MicroIconButtonStyle" TargetType="Button">
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="BorderBrush" Value="Transparent" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="Width" Value="24" />
            <Setter Property="Height" Value="24" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Focusable" Value="False" />
            <Setter Property="FocusVisualStyle" Value="{x:Null}" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Border"
                                Background="{TemplateBinding Background}"
                                CornerRadius="4"
                                SnapsToDevicePixels="True">
                            <ContentPresenter HorizontalAlignment="Center"
                                              VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Border" Property="Background" Value="#1CFFFFFF" />
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="Border" Property="Background" Value="#2EFFFFFF" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <!-- Sleek Monochrome Fluent Action Button Style for Adapter Controls -->
        <Style x:Key="AdapterActionButtonStyle" TargetType="Button">
            <Setter Property="Background" Value="#14FFFFFF" />
            <Setter Property="BorderBrush" Value="#22FFFFFF" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="Foreground" Value="#FFFFFF" />
            <Setter Property="FontFamily" Value="Segoe UI Variable Text, Segoe UI, sans-serif" />
            <Setter Property="FontSize" Value="12" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="Height" Value="32" />
            <Setter Property="MinWidth" Value="92" />
            <Setter Property="Padding" Value="14,0,14,0" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Focusable" Value="False" />
            <Setter Property="FocusVisualStyle" Value="{x:Null}" />
            <Setter Property="HorizontalContentAlignment" Value="Center" />
            <Setter Property="VerticalContentAlignment" Value="Center" />
            <Setter Property="SnapsToDevicePixels" Value="True" />
            <Setter Property="UseLayoutRounding" Value="True" />
            <Setter Property="Tag" Value="InteractiveControl" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="ButtonBorder"
                                Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="4"
                                Padding="{TemplateBinding Padding}"
                                SnapsToDevicePixels="True">
                            <ContentPresenter HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}"
                                              VerticalAlignment="{TemplateBinding VerticalContentAlignment}"
                                              SnapsToDevicePixels="True" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="ButtonBorder" Property="Background" Value="#25FFFFFF" />
                                <Setter TargetName="ButtonBorder" Property="BorderBrush" Value="#40FFFFFF" />
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="ButtonBorder" Property="Background" Value="#35FFFFFF" />
                                <Setter TargetName="ButtonBorder" Property="BorderBrush" Value="#55FFFFFF" />
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter TargetName="ButtonBorder" Property="Opacity" Value="0.35" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Ultra-Slim 3px Fluent ScrollBar (Transparent track, no arrows, subtle pill thumb) -->
        <Style x:Key="FluentSlimScrollBarStyle" TargetType="{x:Type ScrollBar}">
            <Setter Property="OverridesDefaultStyle" Value="True" />
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="Width" Value="3" />
            <Setter Property="SnapsToDevicePixels" Value="True" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="{x:Type ScrollBar}">
                        <Track x:Name="PART_Track" IsDirectionReversed="True" Focusable="False">
                            <Track.Thumb>
                                <Thumb x:Name="Thumb">
                                    <Thumb.Template>
                                        <ControlTemplate TargetType="{x:Type Thumb}">
                                            <Border x:Name="ThumbBorder"
                                                    Background="#55FFFFFF"
                                                    CornerRadius="1.5"
                                                    SnapsToDevicePixels="True" />
                                            <ControlTemplate.Triggers>
                                                <Trigger Property="IsMouseOver" Value="True">
                                                    <Setter TargetName="ThumbBorder" Property="Background" Value="#95FFFFFF" />
                                                </Trigger>
                                                <Trigger Property="IsDragging" Value="True">
                                                    <Setter TargetName="ThumbBorder" Property="Background" Value="#D0FFFFFF" />
                                                </Trigger>
                                            </ControlTemplate.Triggers>
                                        </ControlTemplate>
                                    </Thumb.Template>
                                </Thumb>
                            </Track.Thumb>
                        </Track>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Universal Implicit ScrollBar Style: Sleek 4px Fluent Floating Pill (Invisible by default) -->
        <Style TargetType="{x:Type ScrollBar}" BasedOn="{StaticResource FluentSlimScrollBarStyle}">
            <Setter Property="Width" Value="4" />
            <Setter Property="MinWidth" Value="4" />
            <Setter Property="Opacity" Value="0.0" />
        </Style>

        <!-- Windows 11 Auto-Hiding ScrollViewer: Hidden by default (Opacity 0), appears on hover/scroll -->
        <Style x:Key="MinimalScrollViewerStyle" TargetType="ScrollViewer">
            <Setter Property="OverridesDefaultStyle" Value="True" />
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="BorderBrush" Value="Transparent" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="HorizontalScrollBarVisibility" Value="Disabled" />
            <Setter Property="VerticalScrollBarVisibility" Value="Auto" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ScrollViewer">
                        <Grid Background="Transparent" SnapsToDevicePixels="True">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <!-- 10px right margin ensures list content NEVER collides with the scrollbar -->
                            <ScrollContentPresenter Grid.Column="0"
                                                   Margin="0,0,10,0"
                                                   CanContentScroll="{TemplateBinding CanContentScroll}" />
                            <ScrollBar Grid.Column="1"
                                       x:Name="PART_VerticalScrollBar"
                                       Style="{StaticResource FluentSlimScrollBarStyle}"
                                       Value="{TemplateBinding VerticalOffset}"
                                       Maximum="{TemplateBinding ScrollableHeight}"
                                       ViewportSize="{TemplateBinding ViewportHeight}"
                                       Visibility="{TemplateBinding ComputedVerticalScrollBarVisibility}"
                                       Opacity="0"
                                       Margin="2,0,0,0" />
                        </Grid>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Trigger.EnterActions>
                                    <BeginStoryboard>
                                        <Storyboard>
                                            <DoubleAnimation Storyboard.TargetName="PART_VerticalScrollBar"
                                                             Storyboard.TargetProperty="Opacity"
                                                             To="0.85"
                                                             Duration="0:0:0.18" />
                                        </Storyboard>
                                    </BeginStoryboard>
                                </Trigger.EnterActions>
                                <Trigger.ExitActions>
                                    <BeginStoryboard>
                                        <Storyboard>
                                            <DoubleAnimation Storyboard.TargetName="PART_VerticalScrollBar"
                                                             Storyboard.TargetProperty="Opacity"
                                                             To="0.0"
                                                             Duration="0:0:0.35" />
                                        </Storyboard>
                                    </BeginStoryboard>
                                </Trigger.ExitActions>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Cohesive Fluent Button Style for Wi-Fi Network Actions (Connect / Disconnect) -->
        <Style x:Key="FluentWifiActionButtonStyle" TargetType="Button">
            <Setter Property="Background" Value="#1CFFFFFF" />
            <Setter Property="BorderBrush" Value="#2AFFFFFF" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="Foreground" Value="#F5FFFFFF" />
            <Setter Property="FontFamily" Value="Segoe UI Variable Text, Segoe UI, sans-serif" />
            <Setter Property="FontSize" Value="12" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="Width" Value="76" />
            <Setter Property="Height" Value="28" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Focusable" Value="False" />
            <Setter Property="FocusVisualStyle" Value="{x:Null}" />
            <Setter Property="HorizontalContentAlignment" Value="Center" />
            <Setter Property="VerticalContentAlignment" Value="Center" />
            <Setter Property="SnapsToDevicePixels" Value="True" />
            <Setter Property="UseLayoutRounding" Value="True" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="ButtonBorder"
                                Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="4"
                                SnapsToDevicePixels="True">
                            <ContentPresenter HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}"
                                              VerticalAlignment="{TemplateBinding VerticalContentAlignment}"
                                              SnapsToDevicePixels="True" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="ButtonBorder" Property="Background" Value="#30FFFFFF" />
                                <Setter TargetName="ButtonBorder" Property="BorderBrush" Value="#48FFFFFF" />
                                <Setter Property="Foreground" Value="#FFFFFF" />
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="ButtonBorder" Property="Background" Value="#14FFFFFF" />
                                <Setter TargetName="ButtonBorder" Property="BorderBrush" Value="#20FFFFFF" />
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter TargetName="ButtonBorder" Property="Opacity" Value="0.35" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="FluentWifiDisconnectButtonStyle" TargetType="Button" BasedOn="{StaticResource FluentWifiActionButtonStyle}">
            <Setter Property="Background" Value="#10FFFFFF" />
            <Setter Property="BorderBrush" Value="#1CFFFFFF" />
            <Setter Property="Foreground" Value="#B5FFFFFF" />
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Background" Value="#22FFFFFF" />
                    <Setter Property="BorderBrush" Value="#38FFFFFF" />
                    <Setter Property="Foreground" Value="#FFFFFF" />
                </Trigger>
            </Style.Triggers>
        </Style>
    </UserControl.Resources>

    <!-- Outer Widget Card with Padding="0" so dividing borders run border-to-border -->
    <widgets:WidgetCard Padding="0" Background="Transparent" CornerRadius="2">
        <Grid SnapsToDevicePixels="True" UseLayoutRounding="True" ClipToBounds="True" Background="Transparent">
            <Grid.RowDefinitions>
                <!-- Row 0: Top 5-Tile Segmented Region (Height 76px, with seamless bottom separator) -->
                <RowDefinition Height="76" />
                <!-- Row 1: Lower Panel Region -->
                <RowDefinition Height="*" />
            </Grid.RowDefinitions>

            <!-- ========================================================================= -->
            <!-- ROW 0: TOP 5-TILE REGION (Transparent Acrylic Backdrop)                   -->
            <!-- [ Ethernet ] | [ WIFI ] | [ Kill Net ] | [ Speed ] | [ Hotspot ]          -->
            <!-- ========================================================================= -->
            <widgets:WidgetTiles Grid.Row="0"
                                 SelectedValue="{Binding CurrentPanel, Mode=TwoWay}"
                                 Height="76">
                <widgets:WidgetTile Value="Ethernet"
                                    Icon="{Binding EthernetTileIcon}"
                                    Header="{Binding EthernetTileHeader}"
                                    IndicatorBrush="{Binding EthernetStatusBrush}"
                                    IsEnabled="{Binding HasEthernetAdapter}"
                                    ToolTip="{Binding EthernetTileTooltip}" />
                <widgets:WidgetTile Value="Wifi"
                                    Icon="&#xE701;"
                                    Header="WIFI"
                                    IndicatorBrush="{Binding WifiStatusBrush}"
                                    IsEnabled="{Binding HasWifiAdapter}"
                                    ToolTip="Wi-Fi Networks &amp; Details" />
                <widgets:WidgetTile Value="KillNet"
                                    Icon="&#xEB55;"
                                    Header="Disconnect"
                                    IndicatorBrush="{Binding KillNetStatusBrush}"
                                    ToolTip="Disconnect / Disable Internet Connection" />
                <widgets:WidgetTile Value="Speed"
                                    Header="Speed"
                                    IndicatorBrush="{Binding SpeedStatusBrush}"
                                    ToolTip="Live Throughput &amp; Bandwidth Diagnostics">
                    <widgets:WidgetTile.Icon>
                        <ui:SymbolIcon Symbol="TopSpeed20" FontSize="20" Foreground="#FFFFFF" />
                    </widgets:WidgetTile.Icon>
                </widgets:WidgetTile>
                <widgets:WidgetTile Value="Hotspot"
                                    Icon="&#xE88A;"
                                    Header="Hotspot"
                                    IndicatorBrush="{Binding HotspotStatusBrush}"
                                    ToolTip="Windows Mobile Hotspot Settings" />
            </widgets:WidgetTiles>

            <!-- ========================================================================= -->
            <!-- ROW 1: LOWER PANEL REGION                                                 -->
            <!-- ========================================================================= -->
            <Grid Grid.Row="1" Background="Transparent" SnapsToDevicePixels="True">

                <!-- ==================== 1. ETHERNET PANEL ==================== -->
                <Grid Visibility="{Binding IsEthernetPanel, Converter={StaticResource BoolToVis}}"
                      Margin="24,14,24,14"
                      SnapsToDevicePixels="True">
                    <Grid.RowDefinitions>
                        <!-- Row 0: Top Header: [ 🖧 ] Ethernet + Standard Windows 11 ToggleSwitch -->
                        <RowDefinition Height="Auto" />
                        <!-- Row 1: Hairline Separator -->
                        <RowDefinition Height="Auto" />
                        <!-- Row 2: Content (Properties Grid OR Turned Off Banner) -->
                        <RowDefinition Height="*" />
                    </Grid.RowDefinitions>

                    <!-- Top Header: [ 🖧 ] Ethernet  [ ToggleSwitch ] -->
                    <Grid Grid.Row="0" Height="26" Margin="0,0,0,10">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>

                        <!-- Left: Icon + Title (Alters to Connected / No Internet / Disconnected dynamically) -->
                        <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center">
                            <TextBlock Text="{Binding EthernetPanelIcon}"
                                       FontFamily="Segoe Fluent Icons, Segoe MDL2 Assets, sans-serif"
                                       FontSize="18"
                                       Foreground="{Binding EthernetPanelTitleColor}"
                                       VerticalAlignment="Center"
                                       Margin="0,0,10,0" />
                            <TextBlock Text="{Binding EthernetPanelTitle}"
                                       FontFamily="Segoe UI Variable Display, Segoe UI, sans-serif"
                                       FontSize="16"
                                       FontWeight="SemiBold"
                                       Foreground="{Binding EthernetPanelTitleColor}"
                                       VerticalAlignment="Center" />
                        </StackPanel>

                        <!-- Right: Standard Windows 11 ToggleSwitch (Coordinated with API) -->
                        <ui:ToggleSwitch x:Name="EthernetToggleSwitch"
                                         Grid.Column="1"
                                         IsChecked="{Binding IsEthernetEnabled, Mode=OneWay}"
                                         IsEnabled="{Binding CanToggleEthernet}"
                                         PreviewMouseLeftButtonDown="EthernetToggleSwitch_PreviewMouseLeftButtonDown"
                                         KeyDown="EthernetToggleSwitch_KeyDown"
                                         VerticalAlignment="Center"
                                         Focusable="True"
                                         Cursor="Hand" />
                    </Grid>

                    <!-- Hairline Divider -->
                    <Border Grid.Row="1"
                            Height="1"
                            Background="#14FFFFFF"
                            Margin="0,0,0,14"
                            SnapsToDevicePixels="True" />

                    <!-- Content Row: View 1 - Full Properties (When Ethernet is Enabled) -->
                    <Grid Grid.Row="2"
                          Visibility="{Binding IsEthernetEnabled, Converter={StaticResource BoolToVis}}"
                          SnapsToDevicePixels="True">
                        <Grid.Style>
                            <Style TargetType="Grid">
                                <Style.Triggers>
                                    <Trigger Property="Visibility" Value="Visible">
                                        <Trigger.EnterActions>
                                            <BeginStoryboard>
                                                <Storyboard>
                                                    <DoubleAnimation Storyboard.TargetProperty="Opacity"
                                                                     From="0.0" To="1.0"
                                                                     Duration="0:0:0.2" />
                                                </Storyboard>
                                            </BeginStoryboard>
                                        </Trigger.EnterActions>
                                    </Trigger>
                                </Style.Triggers>
                            </Style>
                        </Grid.Style>
                        <Grid.RowDefinitions>
                            <!-- 0: 5 Core Specs Grid -->
                            <RowDefinition Height="*" />
                            <!-- 1: Subtle Hairline Separator -->
                            <RowDefinition Height="Auto" />
                            <!-- 2: Bottom Data Usage Row -->
                            <RowDefinition Height="Auto" />
                        </Grid.RowDefinitions>

                        <!-- 0: 2-Column Clean Spec Grid (5 Core Specs) -->
                        <Grid Grid.Row="0" Margin="0,4,0,4" VerticalAlignment="Center">
                            <Grid.ColumnDefinitions>
                                <!-- Left Column: Adapter, IPv4, MAC -->
                                <ColumnDefinition Width="*" />
                                <!-- Clean Separation Gap -->
                                <ColumnDefinition Width="28" />
                                <!-- Right Column: DNS, Session Uptime -->
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>

                            <!-- LEFT COLUMN -->
                            <StackPanel Grid.Column="0">
                                <!-- 1. ADAPTER -->
                                <StackPanel Margin="0,0,0,8">
                                    <TextBlock Text="ADAPTER"
                                               FontFamily="Segoe UI Variable Text, Segoe UI, sans-serif"
                                               FontSize="11"
                                               FontWeight="Bold"
                                               Foreground="#90FFFFFF" />
                                    <TextBlock Text="{Binding Ethernet.Description}"
                                               FontFamily="Segoe UI Variable Text, Segoe UI, sans-serif"
                                               FontSize="13"
                                               FontWeight="SemiBold"
                                               Foreground="#FFFFFF"
                                               TextTrimming="CharacterEllipsis"
                                               ToolTip="{Binding Ethernet.Description}"
                                               Margin="0,2,0,0" />
                                </StackPanel>

                                <!-- 2. IPV4 -->
                                <Grid Margin="0,0,0,8">
                                    <StackPanel>
                                        <TextBlock Text="IPV4"
                                                   FontFamily="Segoe UI Variable Text, Segoe UI, sans-serif"
                                                   FontSize="11"
                                                   FontWeight="Bold"
                                                   Foreground="#90FFFFFF" />
                                        <TextBlock Text="{Binding Ethernet.IpAddress}"
                                                   FontFamily="Consolas, Segoe UI Variable Text"
                                                   FontSize="13"
                                                   FontWeight="SemiBold"
                                                   Foreground="#FFFFFF"
                                                   Margin="0,2,0,0" />
                                    </StackPanel>
                                    <Button HorizontalAlignment="Right"
                                            VerticalAlignment="Bottom"
                                            Style="{StaticResource MicroCopyButtonStyle}"
                                            Command="{Binding CopyEthernetIpCommand}"
                                            ToolTip="{Binding CopyEthernetIpTooltip}" />
                                </Grid>

                                <!-- 3. MAC -->
                                <Grid Margin="0,0,0,0">
                                    <StackPanel>
                                        <TextBlock Text="MAC"
                                                   FontFamily="Segoe UI Variable Text, Segoe UI, sans-serif"
                                                   FontSize="11"
                                                   FontWeight="Bold"
                                                   Foreground="#90FFFFFF" />
                                        <TextBlock Text="{Binding Ethernet.MacAddress}"
                                                   FontFamily="Consolas, Segoe UI Variable Text"
                                                   FontSize="13"
                                                   FontWeight="SemiBold"
                                                   Foreground="#FFFFFF"
                                                   Margin="0,2,0,0" />
                                    </StackPanel>
                                    <Button HorizontalAlignment="Right"
                                            VerticalAlignment="Bottom"
                                            Style="{StaticResource MicroCopyButtonStyle}"
                                            Command="{Binding CopyEthernetMacCommand}"
                                            ToolTip="{Binding CopyEthernetMacTooltip}" />
                                </Grid>
                            </StackPanel>

                            <!-- RIGHT COLUMN -->
                            <StackPanel Grid.Column="2">
                                <!-- 4. DNS -->
                                <StackPanel Margin="0,0,0,8">
                                    <TextBlock Text="DNS"
                                               FontFamily="Segoe UI Variable Text, Segoe UI, sans-serif"
                                               FontSize="11"
                                               FontWeight="Bold"
                                               Foreground="#90FFFFFF" />
                                    <TextBlock Text="{Binding Ethernet.DnsServersString}"
                                               FontFamily="Consolas, Segoe UI Variable Text"
                                               FontSize="13"
                                               FontWeight="SemiBold"
                                               Foreground="#FFFFFF"
                                               TextTrimming="CharacterEllipsis"
                                               ToolTip="{Binding Ethernet.DnsServersString}"
                                               Margin="0,2,0,0" />
                                </StackPanel>

                                <!-- 5. SESSION UPTIME -->
                                <StackPanel Margin="0,0,0,0">
                                    <TextBlock Text="SESSION UPTIME"
                                               FontFamily="Segoe UI Variable Text, Segoe UI, sans-serif"
                                               FontSize="11"
                                               FontWeight="Bold"
                                               Foreground="#90FFFFFF" />
                                    <TextBlock Text="{Binding Ethernet.DurationString}"
                                               FontFamily="Consolas, Segoe UI Variable Text"
                                               FontSize="13"
                                               FontWeight="SemiBold"
                                               Foreground="#FFFFFF"
                                               Margin="0,2,0,0" />
                                </StackPanel>
                            </StackPanel>
                        </Grid>

                        <!-- 1: Hairline Divider -->
                        <Border Grid.Row="1"
                                Height="1"
                                Background="#14FFFFFF"
                                Margin="0,6,0,6"
                                SnapsToDevicePixels="True" />

                        <!-- 2: DATA USAGE DEDICATED BOTTOM ROW -->
                        <Grid Grid.Row="2" SnapsToDevicePixels="True">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>

                            <widgets:WidgetSegmentedControl Grid.Column="0"
                                                            Width="240"
                                                            VerticalAlignment="Center"
                                                            SelectedValue="{Binding SelectedDataUsageTimeframe, Mode=TwoWay}">
                                <widgets:WidgetSegmentedItem Content="Session" Value="{x:Static corenet:DataUsageTimeframe.Session}" />
                                <widgets:WidgetSegmentedItem Content="24h" Value="{x:Static corenet:DataUsageTimeframe.Last24Hours}" />
                                <widgets:WidgetSegmentedItem Content="7d" Value="{x:Static corenet:DataUsageTimeframe.Last7Days}" />
                                <widgets:WidgetSegmentedItem Content="30d" Value="{x:Static corenet:DataUsageTimeframe.Last30Days}" />
                            </widgets:WidgetSegmentedControl>

                            <StackPanel Grid.Column="2"
                                        HorizontalAlignment="Right"
                                        VerticalAlignment="Center">
                                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                                    <TextBlock Text="DATA USAGE"
                                               FontFamily="Segoe UI Variable Text, Segoe UI, sans-serif"
                                               FontSize="10"
                                               FontWeight="Bold"
                                               Foreground="#80FFFFFF"
                                               VerticalAlignment="Bottom"
                                               Margin="0,0,8,2" />
                                    <TextBlock Text="{Binding DataUsageTotalDisplay}"
                                               FontFamily="Segoe UI Variable Display, Segoe UI, sans-serif"
                                               FontSize="18"
                                               FontWeight="Bold"
                                               Foreground="#FFFFFF"
                                               VerticalAlignment="Bottom" />
                                </StackPanel>
                                <TextBlock Text="{Binding DataUsageDetailDisplay}"
                                           FontFamily="Segoe UI Variable Text, Segoe UI, sans-serif"
                                           FontSize="11"
                                           FontWeight="SemiBold"
                                           Foreground="#85FFFFFF"
                                           HorizontalAlignment="Right"
                                           Margin="0,2,0,0" />
                            </StackPanel>
                        </Grid>
                    </Grid>

                    <!-- Content Row: View 2 - Clean Professional Fluent Banner (When Ethernet is Turned OFF) -->
                    <Grid Grid.Row="2"
                          Visibility="{Binding IsEthernetDisabled, Converter={StaticResource BoolToVis}}"
                          VerticalAlignment="Center"
                          HorizontalAlignment="Center"
                          Margin="0,32,0,32"
                          SnapsToDevicePixels="True">
                        <Grid.Style>
                            <Style TargetType="Grid">
                                <Style.Triggers>
                                    <Trigger Property="Visibility" Value="Visible">
                                        <Trigger.EnterActions>
                                            <BeginStoryboard>
                                                <Storyboard>
                                                    <DoubleAnimation Storyboard.TargetProperty="Opacity"
                                                                     From="0.0" To="1.0"
                                                                     Duration="0:0:0.2" />
                                                </Storyboard>
                                            </BeginStoryboard>
                                        </Trigger.EnterActions>
                                    </Trigger>
                                </Style.Triggers>
                            </Style>
                        </Grid.Style>
                        <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center">
                            <TextBlock Text="&#xEB55;"
                                       FontFamily="Segoe Fluent Icons, Segoe MDL2 Assets, sans-serif"
                                       FontSize="38"
                                       Foreground="#45FFFFFF"
                                       HorizontalAlignment="Center"
                                       Margin="0,0,0,12" />
                            <TextBlock Text="{Binding EthernetTurnedOffBannerTitle}"
                                       FontFamily="Segoe UI Variable Display, Segoe UI, sans-serif"
                                       FontSize="16"
                                       FontWeight="Bold"
                                       Foreground="#D0FFFFFF"
                                       HorizontalAlignment="Center" />
                        </StackPanel>
                    </Grid>
                </Grid>

                <!-- ==================== 2. WI-FI PANEL ==================== -->
                <Grid Visibility="{Binding IsWifiPanel, Converter={StaticResource BoolToVis}}"
                      Margin="24,14,24,14"
                      SnapsToDevicePixels="True">
                    <Grid.RowDefinitions>
                        <!-- Row 0: Top Header: [ 📶 ] Wi-Fi + Scan/Refresh + ToggleSwitch -->
                        <RowDefinition Height="Auto" />
                        <!-- Row 1: Hairline Separator -->
                        <RowDefinition Height="Auto" />
                        <!-- Row 2: Content (Available Networks List OR Turned Off Banner) -->
                        <RowDefinition Height="*" />
                    </Grid.RowDefinitions>

                    <!-- Top Header: [ 📶 ] Wi-Fi  [ RefreshButton ] [ ToggleSwitch ] -->
                    <Grid Grid.Row="0" Height="26" Margin="0,0,0,10">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>

                        <!-- Left: Icon + Title ("Connected" / "Disconnected" / "Turned Off") -->
                        <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center">
                            <TextBlock Text="{Binding WifiPanelIcon}"
                                       FontFamily="Segoe Fluent Icons, Segoe MDL2 Assets, sans-serif"
                                       FontSize="18"
                                       Foreground="{Binding WifiPanelTitleColor}"
                                       VerticalAlignment="Center"
                                       Margin="0,0,10,0" />
                            <TextBlock Text="{Binding WifiPanelTitle}"
                                       FontFamily="Segoe UI Variable Display, Segoe UI, sans-serif"
                                       FontSize="16"
                                       FontWeight="SemiBold"
                                       Foreground="{Binding WifiPanelTitleColor}"
                                       VerticalAlignment="Center" />
                        </StackPanel>

                        <!-- Right: Scan/Refresh Button + Standard Windows 11 ToggleSwitch for Wi-Fi Radio -->
                        <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                            <Button Style="{StaticResource MicroIconButtonStyle}"
                                    Width="24"
                                    Height="24"
                                    Margin="0,0,8,0"
                                    VerticalAlignment="Center"
                                    Command="{Binding RefreshWifiCommand}"
                                    Visibility="{Binding IsWifiRadioOn, Converter={StaticResource BoolToVis}}"
                                    ToolTip="Scan for Wi-Fi networks">
                                <ui:SymbolIcon Symbol="ArrowClockwise24"
                                               FontSize="14"
                                               Foreground="#D0FFFFFF"
                                               RenderTransformOrigin="0.5,0.5">
                                    <ui:SymbolIcon.RenderTransform>
                                        <RotateTransform Angle="0" />
                                    </ui:SymbolIcon.RenderTransform>
                                    <ui:SymbolIcon.Style>
                                        <Style TargetType="{x:Type ui:SymbolIcon}">
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding IsScanningWifiVisual}" Value="True">
                                                    <DataTrigger.EnterActions>
                                                        <BeginStoryboard x:Name="SpinRefreshStoryboard">
                                                            <Storyboard RepeatBehavior="Forever">
                                                                <DoubleAnimation Storyboard.TargetProperty="(UIElement.RenderTransform).(RotateTransform.Angle)"
                                                                                 From="0" To="360"
                                                                                 Duration="0:0:0.75" />
                                                            </Storyboard>
                                                        </BeginStoryboard>
                                                    </DataTrigger.EnterActions>
                                                    <DataTrigger.ExitActions>
                                                        <StopStoryboard BeginStoryboardName="SpinRefreshStoryboard" />
                                                    </DataTrigger.ExitActions>
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </ui:SymbolIcon.Style>
                                </ui:SymbolIcon>
                            </Button>

                            <ui:ToggleSwitch x:Name="WifiRadioToggleSwitch"
                                             IsChecked="{Binding IsWifiRadioEnabled, Mode=TwoWay}"
                                             IsEnabled="{Binding CanToggleWifiRadio}"
                                             VerticalAlignment="Center"
                                             Focusable="True"
                                             Cursor="Hand" />
                        </StackPanel>
                    </Grid>

                    <!-- Hairline Divider -->
                    <Border Grid.Row="1"
                            Height="1"
                            Background="#14FFFFFF"
                            Margin="0,0,0,14"
                            SnapsToDevicePixels="True" />

                    <!-- Content Row: View 1 - Available Networks (When Wi-Fi Radio is ON and Ready) -->
                    <Grid Grid.Row="2"
                          Visibility="{Binding IsWifiContentVisible, Converter={StaticResource BoolToVis}}"
                          SnapsToDevicePixels="True">

                        <!-- Empty State (No Networks Detected Yet) -->
                        <StackPanel Visibility="{Binding HasNoAvailableNetworks, Converter={StaticResource BoolToVis}}"
                                    HorizontalAlignment="Center"
                                    VerticalAlignment="Center">
                            <ui:SymbolIcon Symbol="Wifi124"
                                           FontSize="28"
                                           Foreground="#40FFFFFF"
                                           HorizontalAlignment="Center"
                                           Margin="0,0,0,8" />
                            <TextBlock Text="Scanning for available networks..."
                                       FontFamily="Segoe UI Variable Text, Segoe UI, sans-serif"
                                       FontSize="13"
                                       Foreground="#75FFFFFF"
                                       HorizontalAlignment="Center" />
                        </StackPanel>

                        <!-- Available Networks ListView (using ui:ListView with AutoHide ScrollBar) -->
                        <ui:ListView x:Name="AvailableNetworksListView"
                                     controls:AutoHideScrollBehavior.IsEnabled="True"
                                     Visibility="{Binding HasAvailableNetworks, Converter={StaticResource BoolToVis}}"
                                     ItemsSource="{Binding AvailableNetworks}"
                                     Background="Transparent"
                                     BorderThickness="0"
                                     Padding="0,0,10,0"
                                     ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                                     ScrollViewer.VerticalScrollBarVisibility="Auto"
                                     ScrollViewer.CanContentScroll="True"
                                     VirtualizingPanel.IsVirtualizing="True"
                                     VirtualizingPanel.VirtualizationMode="Recycling"
                                     VirtualizingPanel.ScrollUnit="Pixel"
                                     VirtualizingPanel.CacheLength="1,1"
                                     VirtualizingPanel.CacheLengthUnit="Page"
                                     SelectionMode="Single"
                                     Focusable="False">
                            <ui:ListView.Resources>
                                <!-- Ultra-Slim 4px Fluent Floating ScrollBar: Invisible by default, reveals on scroll/hover -->
                                <Style TargetType="{x:Type ScrollBar}">
                                    <Setter Property="OverridesDefaultStyle" Value="True" />
                                    <Setter Property="Background" Value="Transparent" />
                                    <Setter Property="BorderThickness" Value="0" />
                                    <Setter Property="Width" Value="4" />
                                    <Setter Property="MinWidth" Value="4" />
                                    <Setter Property="Opacity" Value="0.0" />
                                    <Setter Property="SnapsToDevicePixels" Value="True" />
                                    <Setter Property="Template">
                                        <Setter.Value>
                                            <ControlTemplate TargetType="{x:Type ScrollBar}">
                                                <Grid Background="Transparent">
                                                    <Track x:Name="PART_Track" IsDirectionReversed="True" Focusable="False">
                                                        <Track.Thumb>
                                                            <Thumb x:Name="Thumb">
                                                                <Thumb.Template>
                                                                    <ControlTemplate TargetType="{x:Type Thumb}">
                                                                        <Border x:Name="ThumbBorder"
                                                                                Background="#40FFFFFF"
                                                                                CornerRadius="2"
                                                                                SnapsToDevicePixels="True" />
                                                                        <ControlTemplate.Triggers>
                                                                            <Trigger Property="IsMouseOver" Value="True">
                                                                                <Setter TargetName="ThumbBorder" Property="Background" Value="#90FFFFFF" />
                                                                            </Trigger>
                                                                            <Trigger Property="IsDragging" Value="True">
                                                                                <Setter TargetName="ThumbBorder" Property="Background" Value="#D0FFFFFF" />
                                                                            </Trigger>
                                                                        </ControlTemplate.Triggers>
                                                                    </ControlTemplate>
                                                                </Thumb.Template>
                                                            </Thumb>
                                                        </Track.Thumb>
                                                    </Track>
                                                </Grid>
                                            </ControlTemplate>
                                        </Setter.Value>
                                    </Setter>
                                </Style>
                            </ui:ListView.Resources>
                            <ui:ListView.ItemContainerStyle>
                                <Style TargetType="{x:Type ListViewItem}">
                                    <Setter Property="HorizontalContentAlignment" Value="Stretch" />
                                    <Setter Property="Padding" Value="0" />
                                    <Setter Property="Margin" Value="0,2" />
                                    <Setter Property="Background" Value="Transparent" />
                                    <Setter Property="BorderBrush" Value="Transparent" />
                                    <Setter Property="BorderThickness" Value="1" />
                                    <Setter Property="FocusVisualStyle" Value="{x:Null}" />
                                    <Setter Property="Template">
                                        <Setter.Value>
                                            <ControlTemplate TargetType="{x:Type ListViewItem}">
                                                <Border x:Name="ItemBorder"
                                                        Background="{TemplateBinding Background}"
                                                        BorderBrush="{TemplateBinding BorderBrush}"
                                                        BorderThickness="{TemplateBinding BorderThickness}"
                                                        CornerRadius="6"
                                                        SnapsToDevicePixels="True">
                                                    <ContentPresenter />
                                                </Border>
                                                <ControlTemplate.Triggers>
                                                    <Trigger Property="IsMouseOver" Value="True">
                                                        <Setter Property="Background" Value="#0AFFFFFF" />
                                                        <Setter Property="BorderBrush" Value="#14FFFFFF" />
                                                    </Trigger>
                                                    <DataTrigger Binding="{Binding IsExpanded}" Value="True">
                                                        <Setter Property="Background" Value="#0DFFFFFF" />
                                                        <Setter Property="BorderBrush" Value="#25FFFFFF" />
                                                    </DataTrigger>
                                                    <MultiDataTrigger>
                                                        <MultiDataTrigger.Conditions>
                                                            <Condition Binding="{Binding IsExpanded}" Value="True" />
                                                            <Condition Binding="{Binding RelativeSource={RelativeSource Self}, Path=IsMouseOver}" Value="True" />
                                                        </MultiDataTrigger.Conditions>
                                                        <Setter Property="Background" Value="#12FFFFFF" />
                                                        <Setter Property="BorderBrush" Value="#32FFFFFF" />
                                                    </MultiDataTrigger>
                                                    <Trigger Property="IsSelected" Value="True">
                                                        <Setter Property="Background" Value="#0DFFFFFF" />
                                                        <Setter Property="BorderBrush" Value="#25FFFFFF" />
                                                    </Trigger>
                                                </ControlTemplate.Triggers>
                                            </ControlTemplate>
                                        </Setter.Value>
                                    </Setter>
                                </Style>
                            </ui:ListView.ItemContainerStyle>
                            <ui:ListView.ItemTemplate>
                                <DataTemplate DataType="{x:Type network:WifiNetworkItemViewModel}">
                                    <Grid SnapsToDevicePixels="True">
                                        <Grid.RowDefinitions>
                                            <RowDefinition Height="Auto" />
                                            <RowDefinition Height="Auto" />
                                        </Grid.RowDefinitions>

                                        <!-- Row 0: Summary Row — full-width clickable button -->
                                        <Button Grid.Row="0"
                                                Command="{Binding DataContext.ToggleNetworkExpandCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                CommandParameter="{Binding}"
                                                Background="Transparent"
                                                BorderThickness="0"
                                                Padding="8,8"
                                                HorizontalAlignment="Stretch"
                                                HorizontalContentAlignment="Stretch"
                                                Focusable="False"
                                                Cursor="Hand">
                                            <Button.Template>
                                                <ControlTemplate TargetType="Button">
                                                    <Border Background="{TemplateBinding Background}"
                                                            Padding="{TemplateBinding Padding}"
                                                            HorizontalAlignment="Stretch">
                                                        <ContentPresenter HorizontalAlignment="Stretch"
                                                                          VerticalAlignment="Center" />
                                                    </Border>
                                                </ControlTemplate>
                                            </Button.Template>

                                            <Grid HorizontalAlignment="Stretch">
                                                <Grid.ColumnDefinitions>
                                                    <!-- Column 0: Left Pill Indicator (Green = Connected, White = Disconnected) -->
                                                    <ColumnDefinition Width="Auto" />
                                                    <!-- Column 1: Wi-Fi Signal Icon -->
                                                    <ColumnDefinition Width="Auto" />
                                                    <!-- Column 2: SSID + Subtitle -->
                                                    <ColumnDefinition Width="*" />
                                                </Grid.ColumnDefinitions>

                                                <!-- Far-Left Status Pill: Green when connected, White when disconnected -->
                                                <Border Grid.Column="0"
                                                        Width="3"
                                                        Height="16"
                                                        Background="{Binding IndicatorPillColor, Converter={StaticResource StringToBrush}}"
                                                        CornerRadius="1.5"
                                                        VerticalAlignment="Center"
                                                        Margin="0,0,8,0"
                                                        SnapsToDevicePixels="True" />

                                                <!-- Segoe Fluent Icons TextBlock: uniform signal glyph, clean neutral white -->
                                                <TextBlock Grid.Column="1"
                                                           Text="{Binding WifiSignalGlyph}"
                                                           FontFamily="Segoe Fluent Icons, Segoe MDL2 Assets"
                                                           FontSize="18"
                                                           Foreground="{Binding WifiIconColor, Converter={StaticResource StringToBrush}}"
                                                           VerticalAlignment="Center"
                                                           Margin="0,0,12,0"
                                                           SnapsToDevicePixels="True" />

                                                <!-- SSID + Subtitle (neutral typography) -->
                                                <StackPanel Grid.Column="2" VerticalAlignment="Center">
                                                    <TextBlock Text="{Binding Ssid}"
                                                               FontFamily="Segoe UI Variable Text, Segoe UI, sans-serif"
                                                               FontSize="13"
                                                               FontWeight="SemiBold"
                                                               Foreground="#F2FFFFFF"
                                                               TextTrimming="CharacterEllipsis"
                                                               ToolTip="{Binding Ssid}" />
                                                    <TextBlock Text="{Binding SubtitleText}"
                                                               FontFamily="Segoe UI Variable Text, Segoe UI, sans-serif"
                                                               FontSize="11"
                                                               Foreground="{Binding SubtitleColor, Converter={StaticResource StringToBrush}}"
                                                               Margin="0,2,0,0" />
                                                </StackPanel>
                                            </Grid>
                                        </Button>

                                        <!-- Row 1: Animated Accordion Drawer (Seamless unified card content, zero nested border conflict) -->
                                        <Border Grid.Row="1"
                                                x:Name="AccordionDrawer"
                                                ClipToBounds="True"
                                                Background="Transparent"
                                                BorderThickness="0"
                                                Margin="0"
                                                SnapsToDevicePixels="True"
                                                IsVisibleChanged="AccordionDrawer_IsVisibleChanged"
                                                SizeChanged="AccordionDrawer_SizeChanged">
                                            <Border.Style>
                                                <Style TargetType="Border">
                                                    <Setter Property="MaxHeight" Value="0" />
                                                    <Setter Property="Opacity" Value="0.0" />
                                                    <Setter Property="Visibility" Value="Collapsed" />
                                                    <Style.Triggers>
                                                        <DataTrigger Binding="{Binding IsExpanded}" Value="True">
                                                            <Setter Property="Visibility" Value="Visible" />
                                                            <Setter Property="MaxHeight" Value="260" />
                                                            <Setter Property="Opacity" Value="1.0" />
                                                            <DataTrigger.EnterActions>
                                                                <BeginStoryboard>
                                                                    <Storyboard>
                                                                        <DoubleAnimation Storyboard.TargetProperty="MaxHeight"
                                                                                         From="0" To="240"
                                                                                         Duration="0:0:0.24">
                                                                            <DoubleAnimation.EasingFunction>
                                                                                <CubicEase EasingMode="EaseOut" />
                                                                            </DoubleAnimation.EasingFunction>
                                                                        </DoubleAnimation>
                                                                        <DoubleAnimation Storyboard.TargetProperty="Opacity"
                                                                                         From="0.0" To="1.0"
                                                                                         Duration="0:0:0.20">
                                                                            <DoubleAnimation.EasingFunction>
                                                                                <CubicEase EasingMode="EaseOut" />
                                                                            </DoubleAnimation.EasingFunction>
                                                                        </DoubleAnimation>
                                                                    </Storyboard>
                                                                </BeginStoryboard>
                                                            </DataTrigger.EnterActions>
                                                            <DataTrigger.ExitActions>
                                                                <BeginStoryboard>
                                                                    <Storyboard>
                                                                        <DoubleAnimation Storyboard.TargetProperty="MaxHeight"
                                                                                         To="0"
                                                                                         Duration="0:0:0.16">
                                                                            <DoubleAnimation.EasingFunction>
                                                                                <CubicEase EasingMode="EaseIn" />
                                                                            </DoubleAnimation.EasingFunction>
                                                                        </DoubleAnimation>
                                                                        <DoubleAnimation Storyboard.TargetProperty="Opacity"
                                                                                         To="0.0"
                                                                                         Duration="0:0:0.12">
                                                                            <DoubleAnimation.EasingFunction>
                                                                                <CubicEase EasingMode="EaseIn" />
                                                                            </DoubleAnimation.EasingFunction>
                                                                        </DoubleAnimation>
                                                                    </Storyboard>
                                                                </BeginStoryboard>
                                                            </DataTrigger.ExitActions>
                                                        </DataTrigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </Border.Style>

                                            <StackPanel Margin="12,2,12,12">
                                                <!-- Wi-Fi Standard + Security -->
                                                <TextBlock Text="{Binding SecurityDetailsDisplay}"
                                                           FontFamily="Segoe UI Variable Text, Segoe UI, sans-serif"
                                                           FontSize="11.5"
                                                           FontWeight="SemiBold"
                                                           Foreground="#70FFFFFF"
                                                           Margin="0,0,0,8" />

                                                <!-- Password section (only for unsaved secured non-connected networks) -->
                                                <StackPanel Visibility="{Binding IsPasswordPromptOpen, Converter={StaticResource BoolToVis}}"
                                                            Margin="0,0,0,8">
                                                    <!-- Error indicator positioned where "Network password" was -->
                                                    <TextBlock Text="Incorrect password"
                                                               Visibility="{Binding HasConnectionError, Converter={StaticResource BoolToVis}}"
                                                               FontFamily="Segoe UI Variable Text, Segoe UI, sans-serif"
                                                               FontSize="11"
                                                               FontWeight="SemiBold"
                                                               Foreground="#FF4D4D"
                                                               Margin="0,0,0,4" />

                                                    <!-- WPF-UI ui:PasswordBox: transparent background, no orange indicator -->
                                                    <ui:PasswordBox x:Name="WifiPasswordBox"
                                                                    Height="32"
                                                                    FontSize="12.5"
                                                                    Foreground="#FFFFFF"
                                                                    Background="Transparent"
                                                                    BorderBrush="#25FFFFFF"
                                                                    BorderThickness="1"
                                                                    PlaceholderText="Password..."
                                                                    ClearButtonEnabled="False"
                                                                    RevealButtonEnabled="True"
                                                                    Icon="{ui:SymbolIcon Key20}"
                                                                    KeyDown="WifiPasswordBox_KeyDown">
                                                        <ui:PasswordBox.Resources>
                                                            <SolidColorBrush x:Key="TextControlFocusedBorderBrush" Color="Transparent" />
                                                            <SolidColorBrush x:Key="ControlStrokeColorDefaultBrush" Color="Transparent" />
                                                            <SolidColorBrush x:Key="TextControlBackground" Color="Transparent" />
                                                            <SolidColorBrush x:Key="TextControlBackgroundFocused" Color="Transparent" />
                                                            <SolidColorBrush x:Key="TextControlBackgroundPointerOver" Color="Transparent" />
                                                        </ui:PasswordBox.Resources>
                                                    </ui:PasswordBox>
                                                </StackPanel>

                                                <!-- Action Buttons -->
                                                <Grid>
                                                    <Grid.ColumnDefinitions>
                                                        <ColumnDefinition Width="Auto" />
                                                        <ColumnDefinition Width="*" />
                                                        <ColumnDefinition Width="Auto" />
                                                    </Grid.ColumnDefinitions>

                                                    <!-- Forget (left, only for saved profiles) -->
                                                    <Button Grid.Column="0"
                                                            Content="Forget"
                                                            Style="{StaticResource FluentWifiDisconnectButtonStyle}"
                                                            Command="{Binding DataContext.ForgetWifiNetworkCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                            CommandParameter="{Binding}"
                                                            Visibility="{Binding IsProfileKnown, Converter={StaticResource BoolToVis}}"
                                                            Width="66"
                                                            Height="26" />

                                                    <!-- Right-side actions -->
                                                    <StackPanel Grid.Column="2" Orientation="Horizontal">

                                                        <!-- Connecting spinner -->
                                                        <Border Visibility="{Binding IsConnecting, Converter={StaticResource BoolToVis}}"
                                                                Background="#10FFFFFF"
                                                                BorderBrush="#18FFFFFF"
                                                                BorderThickness="1"
                                                                CornerRadius="4"
                                                                Width="80"
                                                                Height="26">
                                                            <ui:ProgressRing IsIndeterminate="True"
                                                                             Width="14"
                                                                             Height="14"
                                                                             Foreground="#0091FF"
                                                                             HorizontalAlignment="Center"
                                                                             VerticalAlignment="Center" />
                                                        </Border>

                                                        <!-- Disconnect (connected, not connecting) -->
                                                        <Button Content="Disconnect"
                                                                Command="{Binding DataContext.DisconnectWifiNetworkCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                                CommandParameter="{Binding}"
                                                                Width="80"
                                                                Height="26">
                                                            <Button.Style>
                                                                <Style TargetType="Button" BasedOn="{StaticResource FluentWifiDisconnectButtonStyle}">
                                                                    <Setter Property="Visibility" Value="Collapsed" />
                                                                    <Style.Triggers>
                                                                        <MultiDataTrigger>
                                                                            <MultiDataTrigger.Conditions>
                                                                                <Condition Binding="{Binding IsConnected}" Value="True" />
                                                                                <Condition Binding="{Binding IsConnecting}" Value="False" />
                                                                            </MultiDataTrigger.Conditions>
                                                                            <Setter Property="Visibility" Value="Visible" />
                                                                        </MultiDataTrigger>
                                                                    </Style.Triggers>
                                                                </Style>
                                                            </Button.Style>
                                                        </Button>

                                                        <!-- Connect (not connected, not connecting, no password prompt) -->
                                                        <Button Content="Connect"
                                                                Command="{Binding DataContext.ConnectWifiNetworkCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                                CommandParameter="{Binding}"
                                                                Width="80"
                                                                Height="26">
                                                            <Button.Style>
                                                                <Style TargetType="Button" BasedOn="{StaticResource FluentWifiActionButtonStyle}">
                                                                    <Setter Property="Visibility" Value="Collapsed" />
                                                                    <Style.Triggers>
                                                                        <MultiDataTrigger>
                                                                            <MultiDataTrigger.Conditions>
                                                                                <Condition Binding="{Binding IsNotConnected}" Value="True" />
                                                                                <Condition Binding="{Binding IsConnecting}" Value="False" />
                                                                                <Condition Binding="{Binding IsPasswordPromptOpen}" Value="False" />
                                                                            </MultiDataTrigger.Conditions>
                                                                            <Setter Property="Visibility" Value="Visible" />
                                                                        </MultiDataTrigger>
                                                                    </Style.Triggers>
                                                                </Style>
                                                            </Button.Style>
                                                        </Button>

                                                        <!-- Cancel + Connect (password prompt open) -->
                                                        <StackPanel Orientation="Horizontal">
                                                            <StackPanel.Style>
                                                                <Style TargetType="StackPanel">
                                                                    <Setter Property="Visibility" Value="Collapsed" />
                                                                    <Style.Triggers>
                                                                        <MultiDataTrigger>
                                                                            <MultiDataTrigger.Conditions>
                                                                                <Condition Binding="{Binding IsPasswordPromptOpen}" Value="True" />
                                                                                <Condition Binding="{Binding IsConnecting}" Value="False" />
                                                                            </MultiDataTrigger.Conditions>
                                                                            <Setter Property="Visibility" Value="Visible" />
                                                                        </MultiDataTrigger>
                                                                    </Style.Triggers>
                                                                </Style>
                                                            </StackPanel.Style>

                                                            <Button Content="Cancel"
                                                                    Style="{StaticResource FluentWifiDisconnectButtonStyle}"
                                                                    Command="{Binding DataContext.CancelWifiPasswordCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                                    CommandParameter="{Binding ElementName=WifiPasswordBox}"
                                                                    Width="64"
                                                                    Height="26"
                                                                    Margin="0,0,6,0" />

                                                            <Button Content="Connect"
                                                                    Style="{StaticResource FluentWifiActionButtonStyle}"
                                                                    Command="{Binding DataContext.ConnectWithPasswordCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                                    CommandParameter="{Binding ElementName=WifiPasswordBox}"
                                                                    Width="80"
                                                                    Height="26" />
                        </StackPanel>
                                                    </StackPanel>
                                                </Grid>
                                            </StackPanel>
                                        </Border>
                                    </Grid>
                                </DataTemplate>
                            </ui:ListView.ItemTemplate>
                        </ui:ListView>
                    </Grid>

                    <!-- Content Row: View 2 - Clean Professional Fluent Banner (When Wi-Fi Radio is Turned OFF) -->
                    <Grid Grid.Row="2"
                          Visibility="{Binding IsWifiTurnedOffBannerVisible, Converter={StaticResource BoolToVis}}"
                          VerticalAlignment="Center"
                          HorizontalAlignment="Center"
                          Margin="0,32,0,32"
                          SnapsToDevicePixels="True">
                        <Grid.Style>
                            <Style TargetType="Grid">
                                <Style.Triggers>
                                    <Trigger Property="Visibility" Value="Visible">
                                        <Trigger.EnterActions>
                                            <BeginStoryboard>
                                                <Storyboard>
                                                    <DoubleAnimation Storyboard.TargetProperty="Opacity"
                                                                     From="0.0" To="1.0"
                                                                     Duration="0:0:0.2" />
                                                </Storyboard>
                                            </BeginStoryboard>
                                        </Trigger.EnterActions>
                                    </Trigger>
                                </Style.Triggers>
                            </Style>
                        </Grid.Style>
                        <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center">
                            <ui:SymbolIcon Symbol="WifiOff24"
                                           FontSize="38"
                                           Foreground="#45FFFFFF"
                                           HorizontalAlignment="Center"
                                           Margin="0,0,0,12" />
                            <TextBlock Text="{Binding WifiTurnedOffBannerTitle}"
                                       FontFamily="Segoe UI Variable Display, Segoe UI, sans-serif"
                                       FontSize="16"
                                       FontWeight="Bold"
                                       Foreground="#D0FFFFFF"
                                       HorizontalAlignment="Center" />
                        </StackPanel>
                    </Grid>

                    <!-- Content Row: View 3 - Centered Fluent Progress Ring (When Wi-Fi Radio is Transitioning / Turning On or Off) -->
                    <Grid Grid.Row="2"
                          Visibility="{Binding IsWifiRadioBusy, Converter={StaticResource BoolToVis}}"
                          VerticalAlignment="Center"
                          HorizontalAlignment="Center"
                          Margin="0,32,0,32"
                          SnapsToDevicePixels="True">
                        <Grid.Style>
                            <Style TargetType="Grid">
                                <Style.Triggers>
                                    <Trigger Property="Visibility" Value="Visible">
                                        <Trigger.EnterActions>
                                            <BeginStoryboard>
                                                <Storyboard>
                                                    <DoubleAnimation Storyboard.TargetProperty="Opacity"
                                                                     From="0.0" To="1.0"
                                                                     Duration="0:0:0.15" />
                                                </Storyboard>
                                            </BeginStoryboard>
                                        </Trigger.EnterActions>
                                    </Trigger>
                                </Style.Triggers>
                            </Style>
                        </Grid.Style>
                        <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center">
                            <ui:ProgressRing IsIndeterminate="True"
                                             Width="36"
                                             Height="36"
                                             Foreground="#0091FF"
                                             HorizontalAlignment="Center"
                                             Margin="0,0,0,12" />
                            <TextBlock Text="{Binding WifiTransitionStatusText}"
                                       FontFamily="Segoe UI Variable Text, Segoe UI, sans-serif"
                                       FontSize="13"
                                       FontWeight="SemiBold"
                                       Foreground="#B0FFFFFF"
                                       HorizontalAlignment="Center" />
                        </StackPanel>
                    </Grid>
                </Grid>

                <!-- ==================== 3. DISCONNECT PANEL (RESERVED) ==================== -->
                <Grid Visibility="{Binding IsKillNetPanel, Converter={StaticResource BoolToVis}}"
                      Margin="20,16,20,16" Background="Transparent">
                    <Border Background="#06FFFFFF" BorderBrush="#10FFFFFF" BorderThickness="1" CornerRadius="6" Padding="20">
                        <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center">
                            <TextBlock Text="&#xEB55;" FontFamily="Segoe Fluent Icons, Segoe MDL2 Assets" FontSize="26" Foreground="#80FFFFFF" HorizontalAlignment="Center" Margin="0,0,0,8" />
                            <TextBlock Text="Disconnect Panel" FontFamily="Segoe UI Variable Display, Segoe UI, sans-serif" FontSize="16" FontWeight="SemiBold" Foreground="#FFFFFF" HorizontalAlignment="Center" />
                            <TextBlock Text="Reserved for future network disconnect features." FontFamily="Segoe UI Variable Text, Segoe UI, sans-serif" FontSize="12" Foreground="#65FFFFFF" HorizontalAlignment="Center" Margin="0,6,0,0" />
                        </StackPanel>
                    </Border>
                </Grid>

                <!-- Speed Panel Placeholder -->
                <Grid Visibility="{Binding IsSpeedPanel, Converter={StaticResource BoolToVis}}"
                      Margin="20,16,20,16" Background="Transparent">
                    <Border Background="#06FFFFFF" BorderBrush="#10FFFFFF" BorderThickness="1" CornerRadius="6" Padding="20">
                        <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center">
                            <ui:SymbolIcon Symbol="TopSpeed24" FontSize="26" Foreground="#80FFFFFF" HorizontalAlignment="Center" Margin="0,0,0,8" />
                            <TextBlock Text="Speed &amp; Telemetry Panel" FontFamily="Segoe UI Variable Display, Segoe UI, sans-serif" FontSize="16" FontWeight="SemiBold" Foreground="#FFFFFF" HorizontalAlignment="Center" />
                            <TextBlock Text="Real-time bandwidth meters and GPU-accelerated waveform will be designed next." FontFamily="Segoe UI Variable Text, Segoe UI, sans-serif" FontSize="12" Foreground="#65FFFFFF" HorizontalAlignment="Center" Margin="0,6,0,0" />
                        </StackPanel>
                    </Border>
                </Grid>

                <!-- Hotspot Panel Placeholder -->
                <Grid Visibility="{Binding IsHotspotPanel, Converter={StaticResource BoolToVis}}"
                      Margin="20,16,20,16" Background="Transparent">
                    <Border Background="#06FFFFFF" BorderBrush="#10FFFFFF" BorderThickness="1" CornerRadius="6" Padding="20">
                        <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center">
                            <TextBlock Text="&#xE88E;" FontFamily="Segoe Fluent Icons, Segoe MDL2 Assets" FontSize="26" Foreground="#80FFFFFF" HorizontalAlignment="Center" Margin="0,0,0,8" />
                            <TextBlock Text="Mobile Hotspot Panel" FontFamily="Segoe UI Variable Display, Segoe UI, sans-serif" FontSize="16" FontWeight="SemiBold" Foreground="#FFFFFF" HorizontalAlignment="Center" />
                            <TextBlock Text="Windows Mobile Hotspot toggle, SSID/password &amp; clients will be designed next." FontFamily="Segoe UI Variable Text, Segoe UI, sans-serif" FontSize="12" Foreground="#65FFFFFF" HorizontalAlignment="Center" Margin="0,6,0,0" />
                        </StackPanel>
                    </Border>
                </Grid>
            </Grid>
        </Grid>
    </widgets:WidgetCard>
</UserControl>
