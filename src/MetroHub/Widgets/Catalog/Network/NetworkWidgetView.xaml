<UserControl x:Class="MetroHub.Widgets.Catalog.Network.NetworkWidgetView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:widgets="clr-namespace:MetroHub.Widgets"
             xmlns:network="clr-namespace:MetroHub.Widgets.Catalog.Network"
             xmlns:corenet="clr-namespace:MetroHub.Core.Network"
             xmlns:conv="clr-namespace:MetroHub.Presentation.Converters"
             xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
             mc:Ignorable="d" 
             d:DataContext="{d:DesignInstance Type=network:NetworkWidgetViewModel}"
             Focusable="False"
             FocusVisualStyle="{x:Null}"
             ClipToBounds="True"
             SnapsToDevicePixels="True"
             UseLayoutRounding="True"
             TextOptions.TextFormattingMode="Ideal"
             TextOptions.TextRenderingMode="Grayscale"
             TextOptions.TextHintingMode="Animated">

    <UserControl.Resources>
        <BooleanToVisibilityConverter x:Key="BoolToVis" />
        <conv:StringToBrushConverter x:Key="StringToBrush" />

        <!-- Strips default dotted focus border across all controls -->
        <Style TargetType="{x:Type Control}">
            <Setter Property="FocusVisualStyle" Value="{x:Null}" />
        </Style>

        <!-- Sleek Micro Copy Button Style -->
        <Style x:Key="MicroCopyButtonStyle" TargetType="Button">
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="BorderBrush" Value="Transparent" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="Width" Value="24" />
            <Setter Property="Height" Value="24" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Focusable" Value="False" />
            <Setter Property="FocusVisualStyle" Value="{x:Null}" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Border"
                                Background="{TemplateBinding Background}"
                                CornerRadius="4"
                                SnapsToDevicePixels="True">
                            <ui:SymbolIcon x:Name="CopyIcon"
                                           Symbol="Copy16"
                                           FontSize="13"
                                           Foreground="#80FFFFFF"
                                           HorizontalAlignment="Center"
                                           VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Border" Property="Background" Value="#1CFFFFFF" />
                                <Setter TargetName="CopyIcon" Property="Foreground" Value="#FFFFFF" />
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="Border" Property="Background" Value="#2EFFFFFF" />
                                <Setter TargetName="CopyIcon" Property="Foreground" Value="#FFFFFF" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <!-- Sleek Monochrome Fluent Action Button Style for Adapter Controls -->
        <Style x:Key="AdapterActionButtonStyle" TargetType="Button">
            <Setter Property="Background" Value="#14FFFFFF" />
            <Setter Property="BorderBrush" Value="#22FFFFFF" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="Foreground" Value="#FFFFFF" />
            <Setter Property="FontFamily" Value="Segoe UI Variable Text, Segoe UI, sans-serif" />
            <Setter Property="FontSize" Value="12" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="Height" Value="32" />
            <Setter Property="MinWidth" Value="92" />
            <Setter Property="Padding" Value="14,0,14,0" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Focusable" Value="False" />
            <Setter Property="FocusVisualStyle" Value="{x:Null}" />
            <Setter Property="HorizontalContentAlignment" Value="Center" />
            <Setter Property="VerticalContentAlignment" Value="Center" />
            <Setter Property="SnapsToDevicePixels" Value="True" />
            <Setter Property="UseLayoutRounding" Value="True" />
            <Setter Property="Tag" Value="InteractiveControl" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="ButtonBorder"
                                Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="4"
                                Padding="{TemplateBinding Padding}"
                                SnapsToDevicePixels="True">
                            <ContentPresenter HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}"
                                              VerticalAlignment="{TemplateBinding VerticalContentAlignment}"
                                              SnapsToDevicePixels="True" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="ButtonBorder" Property="Background" Value="#25FFFFFF" />
                                <Setter TargetName="ButtonBorder" Property="BorderBrush" Value="#40FFFFFF" />
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="ButtonBorder" Property="Background" Value="#35FFFFFF" />
                                <Setter TargetName="ButtonBorder" Property="BorderBrush" Value="#55FFFFFF" />
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter TargetName="ButtonBorder" Property="Opacity" Value="0.35" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </UserControl.Resources>

    <!-- Outer Widget Card with Padding="0" so dividing borders run border-to-border -->
    <widgets:WidgetCard Padding="0" Background="Transparent" CornerRadius="2">
        <Grid SnapsToDevicePixels="True" UseLayoutRounding="True" ClipToBounds="True" Background="Transparent">
            <Grid.RowDefinitions>
                <!-- Row 0: Top 5-Tile Segmented Region (Height 76px, with seamless bottom separator) -->
                <RowDefinition Height="76" />
                <!-- Row 1: Lower Panel Region -->
                <RowDefinition Height="*" />
            </Grid.RowDefinitions>

            <!-- ========================================================================= -->
            <!-- ROW 0: TOP 5-TILE REGION (Transparent Acrylic Backdrop)                   -->
            <!-- [ Ethernet ] | [ WIFI ] | [ Kill Net ] | [ Speed ] | [ Hotspot ]          -->
            <!-- ========================================================================= -->
            <widgets:WidgetTiles Grid.Row="0"
                                 SelectedValue="{Binding CurrentPanel, Mode=TwoWay}"
                                 Height="76">
                <widgets:WidgetTile Value="Ethernet"
                                    Icon="&#xE839;"
                                    Header="Ethernet"
                                    IndicatorBrush="{Binding EthernetStatusBrush}"
                                    IsEnabled="{Binding HasEthernetAdapter}"
                                    ToolTip="Ethernet Settings &amp; Telemetry" />
                <widgets:WidgetTile Value="Wifi"
                                    Icon="&#xE701;"
                                    Header="WIFI"
                                    IndicatorBrush="{Binding WifiStatusBrush}"
                                    IsEnabled="{Binding HasWifiAdapter}"
                                    ToolTip="Wi-Fi Networks &amp; Details" />
                <widgets:WidgetTile Value="KillNet"
                                    Icon="&#xEB55;"
                                    Header="Disconnect"
                                    IndicatorBrush="{Binding KillNetStatusBrush}"
                                    ToolTip="Disconnect / Disable Internet Connection" />
                <widgets:WidgetTile Value="Speed"
                                    Header="Speed"
                                    IndicatorBrush="{Binding SpeedStatusBrush}"
                                    ToolTip="Live Throughput &amp; Bandwidth Diagnostics">
                    <widgets:WidgetTile.Icon>
                        <ui:SymbolIcon Symbol="TopSpeed20" FontSize="20" Foreground="#FFFFFF" />
                    </widgets:WidgetTile.Icon>
                </widgets:WidgetTile>
                <widgets:WidgetTile Value="Hotspot"
                                    Icon="&#xE88A;"
                                    Header="Hotspot"
                                    IndicatorBrush="{Binding HotspotStatusBrush}"
                                    ToolTip="Windows Mobile Hotspot Settings" />
            </widgets:WidgetTiles>

            <!-- ========================================================================= -->
            <!-- ROW 1: LOWER PANEL REGION                                                 -->
            <!-- ========================================================================= -->
            <Grid Grid.Row="1" Background="Transparent" SnapsToDevicePixels="True">

                <!-- ==================== 1. ETHERNET PANEL ==================== -->
                <Grid Visibility="{Binding IsEthernetPanel, Converter={StaticResource BoolToVis}}"
                      Margin="24,14,24,14"
                      SnapsToDevicePixels="True">
                    <Grid.RowDefinitions>
                        <!-- Properties Header -->
                        <RowDefinition Height="Auto" />
                        <!-- 5 Core Specs Grid -->
                        <RowDefinition Height="*" />
                        <!-- Subtle Hairline Separator -->
                        <RowDefinition Height="Auto" />
                        <!-- Bottom Data Usage Row -->
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>

                    <!-- Header: [ ℹ ] Properties -->
                    <StackPanel Grid.Row="0"
                                Orientation="Horizontal"
                                VerticalAlignment="Center"
                                Margin="0,0,0,16">
                        <ui:SymbolIcon Symbol="Info20"
                                       FontSize="15"
                                       Foreground="#A0FFFFFF"
                                       Margin="0,0,8,0"
                                       VerticalAlignment="Center" />
                        <TextBlock Text="Properties"
                                   FontFamily="Segoe UI Variable Display, Segoe UI, sans-serif"
                                   FontSize="15"
                                   FontWeight="SemiBold"
                                   Foreground="#FFFFFF"
                                   VerticalAlignment="Center" />
                    </StackPanel>

                    <!-- 2-Column Clean Spec Grid (5 Core Specs) -->
                    <Grid Grid.Row="1">
                        <Grid.ColumnDefinitions>
                            <!-- Left Column: Adapter, IPv4, MAC -->
                            <ColumnDefinition Width="*" />
                            <!-- Clean Separation Gap -->
                            <ColumnDefinition Width="32" />
                            <!-- Right Column: DNS, Session Uptime -->
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>

                        <!-- LEFT COLUMN -->
                        <StackPanel Grid.Column="0">
                            <!-- 1. ADAPTER -->
                            <StackPanel Margin="0,0,0,14">
                                <TextBlock Text="ADAPTER"
                                           FontFamily="Segoe UI Variable Text, Segoe UI, sans-serif"
                                           FontSize="11"
                                           FontWeight="Bold"
                                           Foreground="#FFFFFF" />
                                <TextBlock Text="{Binding Ethernet.Description}"
                                           FontFamily="Segoe UI Variable Text, Segoe UI, sans-serif"
                                           FontSize="12.5"
                                           FontWeight="Normal"
                                           Foreground="#B0FFFFFF"
                                           TextTrimming="CharacterEllipsis"
                                           ToolTip="{Binding Ethernet.Description}"
                                           Margin="0,3,0,0" />
                            </StackPanel>

                            <!-- 2. IPV4 -->
                            <Grid Margin="0,0,0,14">
                                <StackPanel>
                                    <TextBlock Text="IPV4"
                                               FontFamily="Segoe UI Variable Text, Segoe UI, sans-serif"
                                               FontSize="11"
                                               FontWeight="Bold"
                                               Foreground="#FFFFFF" />
                                    <TextBlock Text="{Binding Ethernet.IpAddress}"
                                               FontFamily="Consolas, Segoe UI Variable Text"
                                               FontSize="12.5"
                                               FontWeight="Normal"
                                               Foreground="#B0FFFFFF"
                                               Margin="0,3,0,0" />
                                </StackPanel>
                                <Button HorizontalAlignment="Right"
                                        VerticalAlignment="Bottom"
                                        Style="{StaticResource MicroCopyButtonStyle}"
                                        Command="{Binding CopyEthernetIpCommand}"
                                        ToolTip="{Binding CopyEthernetIpTooltip}" />
                            </Grid>

                            <!-- 3. MAC -->
                            <Grid Margin="0,0,0,0">
                                <StackPanel>
                                    <TextBlock Text="MAC"
                                               FontFamily="Segoe UI Variable Text, Segoe UI, sans-serif"
                                               FontSize="11"
                                               FontWeight="Bold"
                                               Foreground="#FFFFFF" />
                                    <TextBlock Text="{Binding Ethernet.MacAddress}"
                                               FontFamily="Consolas, Segoe UI Variable Text"
                                               FontSize="12.5"
                                               FontWeight="Normal"
                                               Foreground="#B0FFFFFF"
                                               Margin="0,3,0,0" />
                                </StackPanel>
                                <Button HorizontalAlignment="Right"
                                        VerticalAlignment="Bottom"
                                        Style="{StaticResource MicroCopyButtonStyle}"
                                        Command="{Binding CopyEthernetMacCommand}"
                                        ToolTip="{Binding CopyEthernetMacTooltip}" />
                            </Grid>
                        </StackPanel>

                        <!-- RIGHT COLUMN -->
                        <StackPanel Grid.Column="2">
                            <!-- 4. DNS -->
                            <StackPanel Margin="0,0,0,14">
                                <TextBlock Text="DNS"
                                           FontFamily="Segoe UI Variable Text, Segoe UI, sans-serif"
                                           FontSize="11"
                                           FontWeight="Bold"
                                           Foreground="#FFFFFF" />
                                <TextBlock Text="{Binding Ethernet.DnsServersString}"
                                           FontFamily="Consolas, Segoe UI Variable Text"
                                           FontSize="12.5"
                                           FontWeight="Normal"
                                           Foreground="#B0FFFFFF"
                                           TextTrimming="CharacterEllipsis"
                                           ToolTip="{Binding Ethernet.DnsServersString}"
                                           Margin="0,3,0,0" />
                            </StackPanel>

                            <!-- 5. SESSION UPTIME -->
                            <StackPanel Margin="0,0,0,0">
                                <TextBlock Text="SESSION UPTIME"
                                           FontFamily="Segoe UI Variable Text, Segoe UI, sans-serif"
                                           FontSize="11"
                                           FontWeight="Bold"
                                           Foreground="#FFFFFF" />
                                <TextBlock Text="{Binding Ethernet.DurationString}"
                                           FontFamily="Consolas, Segoe UI Variable Text"
                                           FontSize="12.5"
                                           FontWeight="Normal"
                                           Foreground="#B0FFFFFF"
                                           Margin="0,3,0,0" />
                            </StackPanel>
                        </StackPanel>
                    </Grid>

                    <!-- Hairline Divider -->
                    <Border Grid.Row="2"
                            Height="1"
                            Background="#14FFFFFF"
                            Margin="0,14,0,12"
                            SnapsToDevicePixels="True" />

                    <!-- 6. DATA USAGE DEDICATED BOTTOM ROW -->
                    <Grid Grid.Row="3" SnapsToDevicePixels="True">
                        <Grid.ColumnDefinitions>
                            <!-- Left: Timeframe Segmented Toggle Buttons -->
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                            <!-- Right: Accurate Data Usage Readout -->
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>

                        <!-- Left: Modular Segmented Timeframe Switch (Zero Boilerplate, Encapsulated Motion) -->
                        <widgets:WidgetSegmentedControl Grid.Column="0"
                                                        Width="240"
                                                        VerticalAlignment="Center"
                                                        SelectedValue="{Binding SelectedDataUsageTimeframe, Mode=TwoWay}">
                            <widgets:WidgetSegmentedItem Content="Session" Value="{x:Static corenet:DataUsageTimeframe.Session}" />
                            <widgets:WidgetSegmentedItem Content="24h" Value="{x:Static corenet:DataUsageTimeframe.Last24Hours}" />
                            <widgets:WidgetSegmentedItem Content="7d" Value="{x:Static corenet:DataUsageTimeframe.Last7Days}" />
                            <widgets:WidgetSegmentedItem Content="30d" Value="{x:Static corenet:DataUsageTimeframe.Last30Days}" />
                        </widgets:WidgetSegmentedControl>

                        <!-- Right: Accurate Readout (Large bold total + prominent up/down telemetry) -->
                        <StackPanel Grid.Column="2"
                                    HorizontalAlignment="Right"
                                    VerticalAlignment="Center">
                            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                                <TextBlock Text="DATA USAGE"
                                           FontFamily="Segoe UI Variable Text, Segoe UI, sans-serif"
                                           FontSize="10"
                                           FontWeight="SemiBold"
                                           Foreground="#65FFFFFF"
                                           VerticalAlignment="Bottom"
                                           Margin="0,0,8,2" />
                                <TextBlock Text="{Binding DataUsageTotalDisplay}"
                                           FontFamily="Segoe UI Variable Display, Segoe UI, sans-serif"
                                           FontSize="18"
                                           FontWeight="Bold"
                                           Foreground="#FFFFFF"
                                           VerticalAlignment="Bottom" />
                            </StackPanel>
                            <TextBlock Text="{Binding DataUsageDetailDisplay}"
                                       FontFamily="Segoe UI Variable Text, Segoe UI, sans-serif"
                                       FontSize="13"
                                       FontWeight="SemiBold"
                                       Foreground="#E0FFFFFF"
                                       HorizontalAlignment="Right"
                                       Margin="0,3,0,0" />
                        </StackPanel>
                    </Grid>
                </Grid>

                <!-- ==================== OTHER PANELS (Placeholders) ==================== -->
                <!-- Wi-Fi Panel Placeholder -->
                <Grid Visibility="{Binding IsWifiPanel, Converter={StaticResource BoolToVis}}"
                      Margin="20,16,20,16" Background="Transparent">
                    <Border Background="#06FFFFFF" BorderBrush="#10FFFFFF" BorderThickness="1" CornerRadius="6" Padding="20">
                        <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center">
                            <TextBlock Text="&#xE701;" FontFamily="Segoe Fluent Icons, Segoe MDL2 Assets" FontSize="26" Foreground="#80FFFFFF" HorizontalAlignment="Center" Margin="0,0,0,8" />
                            <TextBlock Text="Wi-Fi Panel" FontFamily="Segoe UI Variable Display, Segoe UI, sans-serif" FontSize="16" FontWeight="SemiBold" Foreground="#FFFFFF" HorizontalAlignment="Center" />
                            <TextBlock Text="Wi-Fi networks list, signal bars &amp; connection details will be designed next." FontFamily="Segoe UI Variable Text, Segoe UI, sans-serif" FontSize="12" Foreground="#65FFFFFF" HorizontalAlignment="Center" Margin="0,6,0,0" />
                        </StackPanel>
                    </Border>
                </Grid>

                <!-- ==================== 3. DISCONNECT / ADAPTER CONTROLS PANEL ==================== -->
                <Grid Visibility="{Binding IsKillNetPanel, Converter={StaticResource BoolToVis}}"
                      Margin="24,14,24,14"
                      SnapsToDevicePixels="True">
                    <Grid.RowDefinitions>
                        <!-- Row 0: Section Header with Title & Subtitle -->
                        <RowDefinition Height="Auto" />
                        <!-- Row 1: Adapter Cards / Control Rows -->
                        <RowDefinition Height="*" />
                    </Grid.RowDefinitions>

                    <!-- Header: [ 🖧 ] Network Adapter Controls -->
                    <Grid Grid.Row="0" Margin="0,0,0,24">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>

                        <!-- Header Icon Matching 32x32 Row Icons Below -->
                        <Grid Grid.Column="0" Width="32" Height="32" VerticalAlignment="Center" Margin="0,0,14,0">
                            <TextBlock Text="&#xEB55;"
                                       FontFamily="Segoe Fluent Icons, Segoe MDL2 Assets, sans-serif"
                                       FontSize="22"
                                       Foreground="#FFFFFF"
                                       HorizontalAlignment="Center"
                                       VerticalAlignment="Center"
                                       SnapsToDevicePixels="True" />
                        </Grid>

                        <!-- Header Title & Subtext Centered Vertically as a Block -->
                        <StackPanel Grid.Column="1" VerticalAlignment="Center">
                            <TextBlock Text="Network Adapter Controls"
                                       FontFamily="Segoe UI Variable Display, Segoe UI, sans-serif"
                                       FontSize="15"
                                       FontWeight="SemiBold"
                                       Foreground="#FFFFFF" />
                            <TextBlock Text="Disconnect / Disable Internet"
                                       FontFamily="Segoe UI Variable Text, Segoe UI, sans-serif"
                                       FontSize="11.5"
                                       Foreground="#75FFFFFF"
                                       Margin="0,2,0,0" />
                        </StackPanel>
                    </Grid>

                    <!-- Row 1: Two Clean Adapter Control Sections with Hairline Divider -->
                    <StackPanel Grid.Row="1" VerticalAlignment="Top">

                        <!-- ========== SECTION 1: ETHERNET ========== -->
                        <Grid x:Name="EthernetControlRow" SnapsToDevicePixels="True" Margin="0,4,0,18">
                            <Grid.Style>
                                <Style TargetType="Grid">
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding HasEthernetAdapter}" Value="False">
                                            <Setter Property="Opacity" Value="0.38" />
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </Grid.Style>

                            <Grid.ColumnDefinitions>
                                <!-- Col 0: Icon Vertically Centered Across Title + Subtext -->
                                <ColumnDefinition Width="Auto" />
                                <!-- Col 1: Title + Subtext Block -->
                                <ColumnDefinition Width="*" />
                                <!-- Col 2: Action Button -->
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>

                            <!-- Col 0: Ethernet Icon Centered Vertically -->
                            <Grid Grid.Column="0" Width="32" Height="32" VerticalAlignment="Center" Margin="0,0,14,0">
                                <TextBlock Text="&#xE839;"
                                           FontFamily="Segoe Fluent Icons, Segoe MDL2 Assets, sans-serif"
                                           FontSize="22"
                                           Foreground="#FFFFFF"
                                           HorizontalAlignment="Center"
                                           VerticalAlignment="Center"
                                           SnapsToDevicePixels="True" />
                            </Grid>

                            <!-- Col 1: Title + Subtext Vertically Centered -->
                            <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                <TextBlock Text="Ethernet"
                                           FontFamily="Segoe UI Variable Text, Segoe UI, sans-serif"
                                           FontSize="13.5"
                                           FontWeight="Bold"
                                           Foreground="#FFFFFF" />
                                <TextBlock Text="{Binding EthernetActionSubtext}"
                                           FontFamily="Segoe UI Variable Text, Segoe UI, sans-serif"
                                           FontSize="11.5"
                                           Foreground="#85FFFFFF"
                                           Margin="0,3,0,0" />
                            </StackPanel>

                            <!-- Col 2: Disable / Enable Button Vertically Centered -->
                            <Button Grid.Column="2"
                                    Content="{Binding EthernetActionText}"
                                    Command="{Binding ToggleEthernetCommand}"
                                    IsEnabled="{Binding HasEthernetAdapter}"
                                    Style="{StaticResource AdapterActionButtonStyle}"
                                    VerticalAlignment="Center" />
                        </Grid>

                        <!-- Hairline Divider -->
                        <Border Height="1"
                                Background="#14FFFFFF"
                                Margin="0,0,0,18"
                                SnapsToDevicePixels="True" />

                        <!-- ========== SECTION 2: WI-FI ========== -->
                        <Grid x:Name="WifiControlRow" SnapsToDevicePixels="True" Margin="0,0,0,4">
                            <Grid.Style>
                                <Style TargetType="Grid">
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding HasWifiAdapter}" Value="False">
                                            <Setter Property="Opacity" Value="0.38" />
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </Grid.Style>

                            <Grid.ColumnDefinitions>
                                <!-- Col 0: Icon Vertically Centered Across Title + Subtext -->
                                <ColumnDefinition Width="Auto" />
                                <!-- Col 1: Title + Subtext Block -->
                                <ColumnDefinition Width="*" />
                                <!-- Col 2: Action Button -->
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>

                            <!-- Col 0: Wi-Fi Icon Centered Vertically -->
                            <Grid Grid.Column="0" Width="32" Height="32" VerticalAlignment="Center" Margin="0,0,14,0">
                                <TextBlock Text="&#xE701;"
                                           FontFamily="Segoe Fluent Icons, Segoe MDL2 Assets, sans-serif"
                                           FontSize="22"
                                           Foreground="#FFFFFF"
                                           HorizontalAlignment="Center"
                                           VerticalAlignment="Center"
                                           SnapsToDevicePixels="True" />
                            </Grid>

                            <!-- Col 1: Title + Subtext Vertically Centered -->
                            <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                <TextBlock Text="Wi-Fi"
                                           FontFamily="Segoe UI Variable Text, Segoe UI, sans-serif"
                                           FontSize="13.5"
                                           FontWeight="Bold"
                                           Foreground="#FFFFFF" />
                                <TextBlock Text="{Binding WifiActionSubtext}"
                                           FontFamily="Segoe UI Variable Text, Segoe UI, sans-serif"
                                           FontSize="11.5"
                                           Foreground="#85FFFFFF"
                                           Margin="0,3,0,0" />
                            </StackPanel>

                            <!-- Col 2: Disconnect / Connect Button Vertically Centered -->
                            <Button Grid.Column="2"
                                    Content="{Binding WifiActionText}"
                                    Command="{Binding ToggleWifiCommand}"
                                    IsEnabled="{Binding HasWifiAdapter}"
                                    Style="{StaticResource AdapterActionButtonStyle}"
                                    VerticalAlignment="Center" />
                        </Grid>
                    </StackPanel>
                </Grid>

                <!-- Speed Panel Placeholder -->
                <Grid Visibility="{Binding IsSpeedPanel, Converter={StaticResource BoolToVis}}"
                      Margin="20,16,20,16" Background="Transparent">
                    <Border Background="#06FFFFFF" BorderBrush="#10FFFFFF" BorderThickness="1" CornerRadius="6" Padding="20">
                        <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center">
                            <ui:SymbolIcon Symbol="TopSpeed24" FontSize="26" Foreground="#80FFFFFF" HorizontalAlignment="Center" Margin="0,0,0,8" />
                            <TextBlock Text="Speed &amp; Telemetry Panel" FontFamily="Segoe UI Variable Display, Segoe UI, sans-serif" FontSize="16" FontWeight="SemiBold" Foreground="#FFFFFF" HorizontalAlignment="Center" />
                            <TextBlock Text="Real-time bandwidth meters and GPU-accelerated waveform will be designed next." FontFamily="Segoe UI Variable Text, Segoe UI, sans-serif" FontSize="12" Foreground="#65FFFFFF" HorizontalAlignment="Center" Margin="0,6,0,0" />
                        </StackPanel>
                    </Border>
                </Grid>

                <!-- Hotspot Panel Placeholder -->
                <Grid Visibility="{Binding IsHotspotPanel, Converter={StaticResource BoolToVis}}"
                      Margin="20,16,20,16" Background="Transparent">
                    <Border Background="#06FFFFFF" BorderBrush="#10FFFFFF" BorderThickness="1" CornerRadius="6" Padding="20">
                        <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center">
                            <TextBlock Text="&#xE88E;" FontFamily="Segoe Fluent Icons, Segoe MDL2 Assets" FontSize="26" Foreground="#80FFFFFF" HorizontalAlignment="Center" Margin="0,0,0,8" />
                            <TextBlock Text="Mobile Hotspot Panel" FontFamily="Segoe UI Variable Display, Segoe UI, sans-serif" FontSize="16" FontWeight="SemiBold" Foreground="#FFFFFF" HorizontalAlignment="Center" />
                            <TextBlock Text="Windows Mobile Hotspot toggle, SSID/password &amp; clients will be designed next." FontFamily="Segoe UI Variable Text, Segoe UI, sans-serif" FontSize="12" Foreground="#65FFFFFF" HorizontalAlignment="Center" Margin="0,6,0,0" />
                        </StackPanel>
                    </Border>
                </Grid>
            </Grid>
        </Grid>
    </widgets:WidgetCard>
</UserControl>
