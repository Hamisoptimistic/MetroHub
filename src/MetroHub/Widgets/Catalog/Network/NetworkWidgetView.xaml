<UserControl x:Class="MetroHub.Widgets.Catalog.Network.NetworkWidgetView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:widgets="clr-namespace:MetroHub.Widgets"
             xmlns:network="clr-namespace:MetroHub.Widgets.Catalog.Network"
             xmlns:corenet="clr-namespace:MetroHub.Core.Network"
             xmlns:conv="clr-namespace:MetroHub.Presentation.Converters"
             xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
             mc:Ignorable="d" 
             d:DataContext="{d:DesignInstance Type=network:NetworkWidgetViewModel}"
             Focusable="False"
             FocusVisualStyle="{x:Null}"
             ClipToBounds="True"
             SnapsToDevicePixels="True"
             UseLayoutRounding="True"
             TextOptions.TextFormattingMode="Ideal"
             TextOptions.TextRenderingMode="Grayscale"
             TextOptions.TextHintingMode="Animated">

    <UserControl.Resources>
        <BooleanToVisibilityConverter x:Key="BoolToVis" />
        <conv:StringToBrushConverter x:Key="StringToBrush" />

        <!-- Strips default dotted focus border across all controls -->
        <Style TargetType="{x:Type Control}">
            <Setter Property="FocusVisualStyle" Value="{x:Null}" />
        </Style>

        <!-- Sleek Micro Copy Button Style -->
        <Style x:Key="MicroCopyButtonStyle" TargetType="Button">
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="BorderBrush" Value="Transparent" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="Width" Value="24" />
            <Setter Property="Height" Value="24" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Focusable" Value="False" />
            <Setter Property="FocusVisualStyle" Value="{x:Null}" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Border"
                                Background="{TemplateBinding Background}"
                                CornerRadius="4"
                                SnapsToDevicePixels="True">
                            <ui:SymbolIcon x:Name="CopyIcon"
                                           Symbol="Copy16"
                                           FontSize="13"
                                           Foreground="#80FFFFFF"
                                           HorizontalAlignment="Center"
                                           VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Border" Property="Background" Value="#1CFFFFFF" />
                                <Setter TargetName="CopyIcon" Property="Foreground" Value="#FFFFFF" />
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="Border" Property="Background" Value="#2EFFFFFF" />
                                <Setter TargetName="CopyIcon" Property="Foreground" Value="#FFFFFF" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Sleek Micro Icon Button Style (Generic ContentPresenter) -->
        <Style x:Key="MicroIconButtonStyle" TargetType="Button">
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="BorderBrush" Value="Transparent" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="Width" Value="26" />
            <Setter Property="Height" Value="26" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Focusable" Value="False" />
            <Setter Property="FocusVisualStyle" Value="{x:Null}" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Border"
                                Background="{TemplateBinding Background}"
                                CornerRadius="4"
                                SnapsToDevicePixels="True">
                            <ContentPresenter HorizontalAlignment="Center"
                                              VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Border" Property="Background" Value="#1CFFFFFF" />
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="Border" Property="Background" Value="#2EFFFFFF" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <!-- Sleek Monochrome Fluent Action Button Style for Adapter Controls -->
        <Style x:Key="AdapterActionButtonStyle" TargetType="Button">
            <Setter Property="Background" Value="#14FFFFFF" />
            <Setter Property="BorderBrush" Value="#22FFFFFF" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="Foreground" Value="#FFFFFF" />
            <Setter Property="FontFamily" Value="Segoe UI Variable Text, Segoe UI, sans-serif" />
            <Setter Property="FontSize" Value="12" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="Height" Value="32" />
            <Setter Property="MinWidth" Value="92" />
            <Setter Property="Padding" Value="14,0,14,0" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Focusable" Value="False" />
            <Setter Property="FocusVisualStyle" Value="{x:Null}" />
            <Setter Property="HorizontalContentAlignment" Value="Center" />
            <Setter Property="VerticalContentAlignment" Value="Center" />
            <Setter Property="SnapsToDevicePixels" Value="True" />
            <Setter Property="UseLayoutRounding" Value="True" />
            <Setter Property="Tag" Value="InteractiveControl" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="ButtonBorder"
                                Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="4"
                                Padding="{TemplateBinding Padding}"
                                SnapsToDevicePixels="True">
                            <ContentPresenter HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}"
                                              VerticalAlignment="{TemplateBinding VerticalContentAlignment}"
                                              SnapsToDevicePixels="True" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="ButtonBorder" Property="Background" Value="#25FFFFFF" />
                                <Setter TargetName="ButtonBorder" Property="BorderBrush" Value="#40FFFFFF" />
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="ButtonBorder" Property="Background" Value="#35FFFFFF" />
                                <Setter TargetName="ButtonBorder" Property="BorderBrush" Value="#55FFFFFF" />
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter TargetName="ButtonBorder" Property="Opacity" Value="0.35" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Ultra-Slim 3px Fluent ScrollBar (Transparent track, no arrows, subtle pill thumb) -->
        <Style x:Key="FluentSlimScrollBarStyle" TargetType="{x:Type ScrollBar}">
            <Setter Property="OverridesDefaultStyle" Value="True" />
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="Width" Value="3" />
            <Setter Property="SnapsToDevicePixels" Value="True" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="{x:Type ScrollBar}">
                        <Track x:Name="PART_Track" IsDirectionReversed="True" Focusable="False">
                            <Track.Thumb>
                                <Thumb x:Name="Thumb">
                                    <Thumb.Template>
                                        <ControlTemplate TargetType="{x:Type Thumb}">
                                            <Border x:Name="ThumbBorder"
                                                    Background="#55FFFFFF"
                                                    CornerRadius="1.5"
                                                    SnapsToDevicePixels="True" />
                                            <ControlTemplate.Triggers>
                                                <Trigger Property="IsMouseOver" Value="True">
                                                    <Setter TargetName="ThumbBorder" Property="Background" Value="#95FFFFFF" />
                                                </Trigger>
                                                <Trigger Property="IsDragging" Value="True">
                                                    <Setter TargetName="ThumbBorder" Property="Background" Value="#D0FFFFFF" />
                                                </Trigger>
                                            </ControlTemplate.Triggers>
                                        </ControlTemplate>
                                    </Thumb.Template>
                                </Thumb>
                            </Track.Thumb>
                        </Track>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Windows 11 Auto-Hiding ScrollViewer: Hidden by default (Opacity 0), appears on hover/scroll -->
        <Style x:Key="MinimalScrollViewerStyle" TargetType="ScrollViewer">
            <Setter Property="OverridesDefaultStyle" Value="True" />
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="BorderBrush" Value="Transparent" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="HorizontalScrollBarVisibility" Value="Disabled" />
            <Setter Property="VerticalScrollBarVisibility" Value="Auto" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ScrollViewer">
                        <Grid Background="Transparent" SnapsToDevicePixels="True">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <!-- 10px right margin ensures list content NEVER collides with the scrollbar -->
                            <ScrollContentPresenter Grid.Column="0"
                                                   Margin="0,0,10,0"
                                                   CanContentScroll="{TemplateBinding CanContentScroll}" />
                            <ScrollBar Grid.Column="1"
                                       x:Name="PART_VerticalScrollBar"
                                       Style="{StaticResource FluentSlimScrollBarStyle}"
                                       Value="{TemplateBinding VerticalOffset}"
                                       Maximum="{TemplateBinding ScrollableHeight}"
                                       ViewportSize="{TemplateBinding ViewportHeight}"
                                       Visibility="{TemplateBinding ComputedVerticalScrollBarVisibility}"
                                       Opacity="0"
                                       Margin="2,0,0,0" />
                        </Grid>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Trigger.EnterActions>
                                    <BeginStoryboard>
                                        <Storyboard>
                                            <DoubleAnimation Storyboard.TargetName="PART_VerticalScrollBar"
                                                             Storyboard.TargetProperty="Opacity"
                                                             To="0.85"
                                                             Duration="0:0:0.18" />
                                        </Storyboard>
                                    </BeginStoryboard>
                                </Trigger.EnterActions>
                                <Trigger.ExitActions>
                                    <BeginStoryboard>
                                        <Storyboard>
                                            <DoubleAnimation Storyboard.TargetName="PART_VerticalScrollBar"
                                                             Storyboard.TargetProperty="Opacity"
                                                             To="0.0"
                                                             Duration="0:0:0.35" />
                                        </Storyboard>
                                    </BeginStoryboard>
                                </Trigger.ExitActions>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Cohesive Fluent Button Style for Wi-Fi Network Actions (Connect / Disconnect) -->
        <Style x:Key="FluentWifiActionButtonStyle" TargetType="Button">
            <Setter Property="Background" Value="#1CFFFFFF" />
            <Setter Property="BorderBrush" Value="#2AFFFFFF" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="Foreground" Value="#F5FFFFFF" />
            <Setter Property="FontFamily" Value="Segoe UI Variable Text, Segoe UI, sans-serif" />
            <Setter Property="FontSize" Value="12" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="Width" Value="76" />
            <Setter Property="Height" Value="28" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Focusable" Value="False" />
            <Setter Property="FocusVisualStyle" Value="{x:Null}" />
            <Setter Property="HorizontalContentAlignment" Value="Center" />
            <Setter Property="VerticalContentAlignment" Value="Center" />
            <Setter Property="SnapsToDevicePixels" Value="True" />
            <Setter Property="UseLayoutRounding" Value="True" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="ButtonBorder"
                                Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="4"
                                SnapsToDevicePixels="True">
                            <ContentPresenter HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}"
                                              VerticalAlignment="{TemplateBinding VerticalContentAlignment}"
                                              SnapsToDevicePixels="True" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="ButtonBorder" Property="Background" Value="#30FFFFFF" />
                                <Setter TargetName="ButtonBorder" Property="BorderBrush" Value="#48FFFFFF" />
                                <Setter Property="Foreground" Value="#FFFFFF" />
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="ButtonBorder" Property="Background" Value="#14FFFFFF" />
                                <Setter TargetName="ButtonBorder" Property="BorderBrush" Value="#20FFFFFF" />
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter TargetName="ButtonBorder" Property="Opacity" Value="0.35" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="FluentWifiDisconnectButtonStyle" TargetType="Button" BasedOn="{StaticResource FluentWifiActionButtonStyle}">
            <Setter Property="Background" Value="#10FFFFFF" />
            <Setter Property="BorderBrush" Value="#1CFFFFFF" />
            <Setter Property="Foreground" Value="#B5FFFFFF" />
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Background" Value="#22FFFFFF" />
                    <Setter Property="BorderBrush" Value="#38FFFFFF" />
                    <Setter Property="Foreground" Value="#FFFFFF" />
                </Trigger>
            </Style.Triggers>
        </Style>
    </UserControl.Resources>

    <!-- Outer Widget Card with Padding="0" so dividing borders run border-to-border -->
    <widgets:WidgetCard Padding="0" Background="Transparent" CornerRadius="2">
        <Grid SnapsToDevicePixels="True" UseLayoutRounding="True" ClipToBounds="True" Background="Transparent">
            <Grid.RowDefinitions>
                <!-- Row 0: Top 5-Tile Segmented Region (Height 76px, with seamless bottom separator) -->
                <RowDefinition Height="76" />
                <!-- Row 1: Lower Panel Region -->
                <RowDefinition Height="*" />
            </Grid.RowDefinitions>

            <!-- ========================================================================= -->
            <!-- ROW 0: TOP 5-TILE REGION (Transparent Acrylic Backdrop)                   -->
            <!-- [ Ethernet ] | [ WIFI ] | [ Kill Net ] | [ Speed ] | [ Hotspot ]          -->
            <!-- ========================================================================= -->
            <widgets:WidgetTiles Grid.Row="0"
                                 SelectedValue="{Binding CurrentPanel, Mode=TwoWay}"
                                 Height="76">
                <widgets:WidgetTile Value="Ethernet"
                                    Icon="{Binding EthernetTileIcon}"
                                    Header="{Binding EthernetTileHeader}"
                                    IndicatorBrush="{Binding EthernetStatusBrush}"
                                    IsEnabled="{Binding HasEthernetAdapter}"
                                    ToolTip="{Binding EthernetTileTooltip}" />
                <widgets:WidgetTile Value="Wifi"
                                    Icon="&#xE701;"
                                    Header="WIFI"
                                    IndicatorBrush="{Binding WifiStatusBrush}"
                                    IsEnabled="{Binding HasWifiAdapter}"
                                    ToolTip="Wi-Fi Networks &amp; Details" />
                <widgets:WidgetTile Value="KillNet"
                                    Icon="&#xEB55;"
                                    Header="Disconnect"
                                    IndicatorBrush="{Binding KillNetStatusBrush}"
                                    ToolTip="Disconnect / Disable Internet Connection" />
                <widgets:WidgetTile Value="Speed"
                                    Header="Speed"
                                    IndicatorBrush="{Binding SpeedStatusBrush}"
                                    ToolTip="Live Throughput &amp; Bandwidth Diagnostics">
                    <widgets:WidgetTile.Icon>
                        <ui:SymbolIcon Symbol="TopSpeed20" FontSize="20" Foreground="#FFFFFF" />
                    </widgets:WidgetTile.Icon>
                </widgets:WidgetTile>
                <widgets:WidgetTile Value="Hotspot"
                                    Icon="&#xE88A;"
                                    Header="Hotspot"
                                    IndicatorBrush="{Binding HotspotStatusBrush}"
                                    ToolTip="Windows Mobile Hotspot Settings" />
            </widgets:WidgetTiles>

            <!-- ========================================================================= -->
            <!-- ROW 1: LOWER PANEL REGION                                                 -->
            <!-- ========================================================================= -->
            <Grid Grid.Row="1" Background="Transparent" SnapsToDevicePixels="True">

                <!-- ==================== 1. ETHERNET PANEL ==================== -->
                <Grid Visibility="{Binding IsEthernetPanel, Converter={StaticResource BoolToVis}}"
                      Margin="24,14,24,14"
                      SnapsToDevicePixels="True">
                    <Grid.RowDefinitions>
                        <!-- Row 0: Top Header: [ 🖧 ] Ethernet + Standard Windows 11 ToggleSwitch -->
                        <RowDefinition Height="Auto" />
                        <!-- Row 1: Hairline Separator -->
                        <RowDefinition Height="Auto" />
                        <!-- Row 2: Content (Properties Grid OR Turned Off Banner) -->
                        <RowDefinition Height="*" />
                    </Grid.RowDefinitions>

                    <!-- Top Header: [ 🖧 ] Ethernet  [ ToggleSwitch ] -->
                    <Grid Grid.Row="0" Margin="0,0,0,10">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>

                        <!-- Left: Icon + Title (Alters to Connected / No Internet / Disconnected dynamically) -->
                        <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center">
                            <TextBlock Text="{Binding EthernetPanelIcon}"
                                       FontFamily="Segoe Fluent Icons, Segoe MDL2 Assets, sans-serif"
                                       FontSize="18"
                                       Foreground="{Binding EthernetPanelTitleColor}"
                                       VerticalAlignment="Center"
                                       Margin="0,0,10,0" />
                            <TextBlock Text="{Binding EthernetPanelTitle}"
                                       FontFamily="Segoe UI Variable Display, Segoe UI, sans-serif"
                                       FontSize="16"
                                       FontWeight="SemiBold"
                                       Foreground="{Binding EthernetPanelTitleColor}"
                                       VerticalAlignment="Center" />
                        </StackPanel>

                        <!-- Right: Standard Windows 11 ToggleSwitch (Coordinated with API) -->
                        <ui:ToggleSwitch x:Name="EthernetToggleSwitch"
                                         Grid.Column="1"
                                         IsChecked="{Binding IsEthernetEnabled, Mode=OneWay}"
                                         IsEnabled="{Binding CanToggleEthernet}"
                                         PreviewMouseLeftButtonDown="EthernetToggleSwitch_PreviewMouseLeftButtonDown"
                                         KeyDown="EthernetToggleSwitch_KeyDown"
                                         VerticalAlignment="Center"
                                         Focusable="True"
                                         Cursor="Hand" />
                    </Grid>

                    <!-- Hairline Divider -->
                    <Border Grid.Row="1"
                            Height="1"
                            Background="#14FFFFFF"
                            Margin="0,0,0,14"
                            SnapsToDevicePixels="True" />

                    <!-- Content Row: View 1 - Full Properties (When Ethernet is Enabled) -->
                    <Grid Grid.Row="2"
                          Visibility="{Binding IsEthernetEnabled, Converter={StaticResource BoolToVis}}"
                          SnapsToDevicePixels="True">
                        <Grid.Style>
                            <Style TargetType="Grid">
                                <Style.Triggers>
                                    <Trigger Property="Visibility" Value="Visible">
                                        <Trigger.EnterActions>
                                            <BeginStoryboard>
                                                <Storyboard>
                                                    <DoubleAnimation Storyboard.TargetProperty="Opacity"
                                                                     From="0.0" To="1.0"
                                                                     Duration="0:0:0.2" />
                                                </Storyboard>
                                            </BeginStoryboard>
                                        </Trigger.EnterActions>
                                    </Trigger>
                                </Style.Triggers>
                            </Style>
                        </Grid.Style>
                        <Grid.RowDefinitions>
                            <!-- 0: [ ℹ ] Properties Header -->
                            <RowDefinition Height="Auto" />
                            <!-- 1: 5 Core Specs Grid -->
                            <RowDefinition Height="*" />
                            <!-- 2: Subtle Hairline Separator -->
                            <RowDefinition Height="Auto" />
                            <!-- 3: Bottom Data Usage Row -->
                            <RowDefinition Height="Auto" />
                        </Grid.RowDefinitions>

                        <!-- 0: Header: [ ℹ ] Properties -->
                        <StackPanel Grid.Row="0"
                                    Orientation="Horizontal"
                                    VerticalAlignment="Center"
                                    Margin="0,0,0,14">
                            <ui:SymbolIcon Symbol="Info20"
                                           FontSize="14"
                                           Foreground="#A0FFFFFF"
                                           Margin="0,0,8,0"
                                           VerticalAlignment="Center" />
                            <TextBlock Text="Properties"
                                       FontFamily="Segoe UI Variable Display, Segoe UI, sans-serif"
                                       FontSize="14"
                                       FontWeight="SemiBold"
                                       Foreground="#FFFFFF"
                                       VerticalAlignment="Center" />
                        </StackPanel>

                        <!-- 1: 2-Column Clean Spec Grid (5 Core Specs) -->
                        <Grid Grid.Row="1">
                            <Grid.ColumnDefinitions>
                                <!-- Left Column: Adapter, IPv4, MAC -->
                                <ColumnDefinition Width="*" />
                                <!-- Clean Separation Gap -->
                                <ColumnDefinition Width="32" />
                                <!-- Right Column: DNS, Session Uptime -->
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>

                            <!-- LEFT COLUMN -->
                            <StackPanel Grid.Column="0">
                                <!-- 1. ADAPTER -->
                                <StackPanel Margin="0,0,0,12">
                                    <TextBlock Text="ADAPTER"
                                               FontFamily="Segoe UI Variable Text, Segoe UI, sans-serif"
                                               FontSize="10.5"
                                               FontWeight="Bold"
                                               Foreground="#FFFFFF" />
                                    <TextBlock Text="{Binding Ethernet.Description}"
                                               FontFamily="Segoe UI Variable Text, Segoe UI, sans-serif"
                                               FontSize="12"
                                               FontWeight="Normal"
                                               Foreground="#B0FFFFFF"
                                               TextTrimming="CharacterEllipsis"
                                               ToolTip="{Binding Ethernet.Description}"
                                               Margin="0,3,0,0" />
                                </StackPanel>

                                <!-- 2. IPV4 -->
                                <Grid Margin="0,0,0,12">
                                    <StackPanel>
                                        <TextBlock Text="IPV4"
                                                   FontFamily="Segoe UI Variable Text, Segoe UI, sans-serif"
                                                   FontSize="10.5"
                                                   FontWeight="Bold"
                                                   Foreground="#FFFFFF" />
                                        <TextBlock Text="{Binding Ethernet.IpAddress}"
                                                   FontFamily="Consolas, Segoe UI Variable Text"
                                                   FontSize="12"
                                                   FontWeight="Normal"
                                                   Foreground="#B0FFFFFF"
                                                   Margin="0,3,0,0" />
                                    </StackPanel>
                                    <Button HorizontalAlignment="Right"
                                            VerticalAlignment="Bottom"
                                            Style="{StaticResource MicroCopyButtonStyle}"
                                            Command="{Binding CopyEthernetIpCommand}"
                                            ToolTip="{Binding CopyEthernetIpTooltip}" />
                                </Grid>

                                <!-- 3. MAC -->
                                <Grid Margin="0,0,0,0">
                                    <StackPanel>
                                        <TextBlock Text="MAC"
                                                   FontFamily="Segoe UI Variable Text, Segoe UI, sans-serif"
                                                   FontSize="10.5"
                                                   FontWeight="Bold"
                                                   Foreground="#FFFFFF" />
                                        <TextBlock Text="{Binding Ethernet.MacAddress}"
                                                   FontFamily="Consolas, Segoe UI Variable Text"
                                                   FontSize="12"
                                                   FontWeight="Normal"
                                                   Foreground="#B0FFFFFF"
                                                   Margin="0,3,0,0" />
                                    </StackPanel>
                                    <Button HorizontalAlignment="Right"
                                            VerticalAlignment="Bottom"
                                            Style="{StaticResource MicroCopyButtonStyle}"
                                            Command="{Binding CopyEthernetMacCommand}"
                                            ToolTip="{Binding CopyEthernetMacTooltip}" />
                                </Grid>
                            </StackPanel>

                            <!-- RIGHT COLUMN -->
                            <StackPanel Grid.Column="2">
                                <!-- 4. DNS -->
                                <StackPanel Margin="0,0,0,12">
                                    <TextBlock Text="DNS"
                                               FontFamily="Segoe UI Variable Text, Segoe UI, sans-serif"
                                               FontSize="10.5"
                                               FontWeight="Bold"
                                               Foreground="#FFFFFF" />
                                    <TextBlock Text="{Binding Ethernet.DnsServersString}"
                                               FontFamily="Consolas, Segoe UI Variable Text"
                                               FontSize="12"
                                               FontWeight="Normal"
                                               Foreground="#B0FFFFFF"
                                               TextTrimming="CharacterEllipsis"
                                               ToolTip="{Binding Ethernet.DnsServersString}"
                                               Margin="0,3,0,0" />
                                </StackPanel>

                                <!-- 5. SESSION UPTIME -->
                                <StackPanel Margin="0,0,0,0">
                                    <TextBlock Text="SESSION UPTIME"
                                               FontFamily="Segoe UI Variable Text, Segoe UI, sans-serif"
                                               FontSize="10.5"
                                               FontWeight="Bold"
                                               Foreground="#FFFFFF" />
                                    <TextBlock Text="{Binding Ethernet.DurationString}"
                                               FontFamily="Consolas, Segoe UI Variable Text"
                                               FontSize="12"
                                               FontWeight="Normal"
                                               Foreground="#B0FFFFFF"
                                               Margin="0,3,0,0" />
                                </StackPanel>
                            </StackPanel>
                        </Grid>

                        <!-- 2: Hairline Divider -->
                        <Border Grid.Row="2"
                                Height="1"
                                Background="#14FFFFFF"
                                Margin="0,12,0,10"
                                SnapsToDevicePixels="True" />

                        <!-- 3: DATA USAGE DEDICATED BOTTOM ROW -->
                        <Grid Grid.Row="3" SnapsToDevicePixels="True">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>

                            <widgets:WidgetSegmentedControl Grid.Column="0"
                                                            Width="240"
                                                            VerticalAlignment="Center"
                                                            SelectedValue="{Binding SelectedDataUsageTimeframe, Mode=TwoWay}">
                                <widgets:WidgetSegmentedItem Content="Session" Value="{x:Static corenet:DataUsageTimeframe.Session}" />
                                <widgets:WidgetSegmentedItem Content="24h" Value="{x:Static corenet:DataUsageTimeframe.Last24Hours}" />
                                <widgets:WidgetSegmentedItem Content="7d" Value="{x:Static corenet:DataUsageTimeframe.Last7Days}" />
                                <widgets:WidgetSegmentedItem Content="30d" Value="{x:Static corenet:DataUsageTimeframe.Last30Days}" />
                            </widgets:WidgetSegmentedControl>

                            <StackPanel Grid.Column="2"
                                        HorizontalAlignment="Right"
                                        VerticalAlignment="Center">
                                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                                    <TextBlock Text="DATA USAGE"
                                               FontFamily="Segoe UI Variable Text, Segoe UI, sans-serif"
                                               FontSize="10"
                                               FontWeight="Bold"
                                               Foreground="#80FFFFFF"
                                               VerticalAlignment="Bottom"
                                               Margin="0,0,8,2" />
                                    <TextBlock Text="{Binding DataUsageTotalDisplay}"
                                               FontFamily="Segoe UI Variable Display, Segoe UI, sans-serif"
                                               FontSize="18"
                                               FontWeight="Bold"
                                               Foreground="#FFFFFF"
                                               VerticalAlignment="Bottom" />
                                </StackPanel>
                                <TextBlock Text="{Binding DataUsageDetailDisplay}"
                                           FontFamily="Segoe UI Variable Text, Segoe UI, sans-serif"
                                           FontSize="11"
                                           FontWeight="SemiBold"
                                           Foreground="#85FFFFFF"
                                           HorizontalAlignment="Right"
                                           Margin="0,2,0,0" />
                            </StackPanel>
                        </Grid>
                    </Grid>

                    <!-- Content Row: View 2 - Clean Professional Fluent Banner (When Ethernet is Turned OFF) -->
                    <Grid Grid.Row="2"
                          Visibility="{Binding IsEthernetDisabled, Converter={StaticResource BoolToVis}}"
                          VerticalAlignment="Center"
                          HorizontalAlignment="Center"
                          Margin="0,32,0,32"
                          SnapsToDevicePixels="True">
                        <Grid.Style>
                            <Style TargetType="Grid">
                                <Style.Triggers>
                                    <Trigger Property="Visibility" Value="Visible">
                                        <Trigger.EnterActions>
                                            <BeginStoryboard>
                                                <Storyboard>
                                                    <DoubleAnimation Storyboard.TargetProperty="Opacity"
                                                                     From="0.0" To="1.0"
                                                                     Duration="0:0:0.2" />
                                                </Storyboard>
                                            </BeginStoryboard>
                                        </Trigger.EnterActions>
                                    </Trigger>
                                </Style.Triggers>
                            </Style>
                        </Grid.Style>
                        <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center">
                            <TextBlock Text="&#xEB55;"
                                       FontFamily="Segoe Fluent Icons, Segoe MDL2 Assets, sans-serif"
                                       FontSize="36"
                                       Foreground="#45FFFFFF"
                                       HorizontalAlignment="Center"
                                       Margin="0,0,0,12" />
                            <TextBlock Text="{Binding EthernetTurnedOffBannerTitle}"
                                       FontFamily="Segoe UI Variable Display, Segoe UI, sans-serif"
                                       FontSize="15"
                                       FontWeight="SemiBold"
                                       Foreground="#D0FFFFFF"
                                       HorizontalAlignment="Center" />
                            <TextBlock Text="Turn on the switch above to enable this network adapter."
                                       FontFamily="Segoe UI Variable Text, Segoe UI, sans-serif"
                                       FontSize="12"
                                       Foreground="#65FFFFFF"
                                       HorizontalAlignment="Center"
                                       Margin="0,4,0,0" />
                        </StackPanel>
                    </Grid>
                </Grid>

                <!-- ==================== OTHER PANELS (Placeholders) ==================== -->
                <!-- ==================== 2. WI-FI PANEL ==================== -->
                <Grid Visibility="{Binding IsWifiPanel, Converter={StaticResource BoolToVis}}"
                      Margin="24,14,24,14"
                      SnapsToDevicePixels="True">
                    <Grid.RowDefinitions>
                        <!-- Row 0: Top Header: [ 📶 ] Wi-Fi + Standard Windows 11 ToggleSwitch -->
                        <RowDefinition Height="Auto" />
                        <!-- Row 1: Hairline Separator -->
                        <RowDefinition Height="Auto" />
                        <!-- Row 2: Content (Available Networks List OR Turned Off Banner) -->
                        <RowDefinition Height="*" />
                    </Grid.RowDefinitions>

                    <!-- Top Header: [ 📶 ] Wi-Fi  [ ToggleSwitch ] -->
                    <Grid Grid.Row="0" Margin="0,0,0,10">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>

                        <!-- Left: Icon + Title ("Connected" / "Disconnected" / "Turned Off") -->
                        <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center">
                            <ui:SymbolIcon Symbol="{Binding WifiPanelSymbol}"
                                           FontSize="18"
                                           Foreground="{Binding WifiPanelTitleColor, Converter={StaticResource StringToBrush}}"
                                           VerticalAlignment="Center"
                                           Margin="0,0,10,0" />
                            <TextBlock Text="{Binding WifiPanelTitle}"
                                       FontFamily="Segoe UI Variable Display, Segoe UI, sans-serif"
                                       FontSize="16"
                                       FontWeight="SemiBold"
                                       Foreground="{Binding WifiPanelTitleColor}"
                                       VerticalAlignment="Center" />
                        </StackPanel>

                        <!-- Right: Standard Windows 11 ToggleSwitch for Wi-Fi Radio -->
                        <ui:ToggleSwitch x:Name="WifiRadioToggleSwitch"
                                         Grid.Column="1"
                                         IsChecked="{Binding IsWifiRadioEnabled, Mode=TwoWay}"
                                         IsEnabled="{Binding CanToggleWifiRadio}"
                                         VerticalAlignment="Center"
                                         Focusable="True"
                                         Cursor="Hand" />
                    </Grid>

                    <!-- Hairline Divider -->
                    <Border Grid.Row="1"
                            Height="1"
                            Background="#14FFFFFF"
                            Margin="0,0,0,10"
                            SnapsToDevicePixels="True" />

                    <!-- Content Row: View 1 - Available Networks (When Wi-Fi Radio is ON) -->
                    <Grid Grid.Row="2"
                          Visibility="{Binding IsWifiRadioOn, Converter={StaticResource BoolToVis}}"
                          SnapsToDevicePixels="True">
                        <Grid.RowDefinitions>
                            <!-- Subheader: "AVAILABLE NETWORKS" + Scan/Refresh Button -->
                            <RowDefinition Height="Auto" />
                            <!-- Scrollable Network List -->
                            <RowDefinition Height="*" />
                        </Grid.RowDefinitions>

                        <!-- Subheader Bar -->
                        <Grid Grid.Row="0" Margin="0,0,0,8">
                            <TextBlock Text="AVAILABLE NETWORKS"
                                       FontFamily="Segoe UI Variable Text, Segoe UI, sans-serif"
                                       FontSize="10.5"
                                       FontWeight="Bold"
                                       Foreground="#80FFFFFF"
                                       VerticalAlignment="Center" />

                            <Button HorizontalAlignment="Right"
                                    VerticalAlignment="Center"
                                    Style="{StaticResource MicroIconButtonStyle}"
                                    Command="{Binding RefreshWifiCommand}"
                                    ToolTip="Scan for Wi-Fi networks">
                                <ui:SymbolIcon Symbol="ArrowSync24"
                                               FontSize="14"
                                               Foreground="#85FFFFFF" />
                            </Button>
                        </Grid>

                        <!-- Empty State (No Networks Detected Yet) -->
                        <Border Grid.Row="1"
                                Visibility="{Binding HasNoAvailableNetworks, Converter={StaticResource BoolToVis}}"
                                Background="#06FFFFFF"
                                BorderBrush="#10FFFFFF"
                                BorderThickness="1"
                                CornerRadius="6"
                                Padding="20"
                                VerticalAlignment="Center">
                            <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center">
                                <ui:SymbolIcon Symbol="Wifi124"
                                               FontSize="28"
                                               Foreground="#40FFFFFF"
                                               HorizontalAlignment="Center"
                                               Margin="0,0,0,8" />
                                <TextBlock Text="Scanning for available networks..."
                                           FontFamily="Segoe UI Variable Text, Segoe UI, sans-serif"
                                           FontSize="13"
                                           Foreground="#75FFFFFF"
                                           HorizontalAlignment="Center" />
                            </StackPanel>
                        </Border>

                        <!-- Scrollable Networks List -->
                        <ScrollViewer Grid.Row="1"
                                      Visibility="{Binding HasAvailableNetworks, Converter={StaticResource BoolToVis}}"
                                      Style="{StaticResource MinimalScrollViewerStyle}"
                                      Focusable="False">
                            <ItemsControl ItemsSource="{Binding AvailableNetworks}" Focusable="False">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate DataType="{x:Type network:WifiNetworkItemViewModel}">
                                        <!-- Clean Fluent Row for each Network (No Heavy Box Border) -->
                                        <Border Margin="0,1"
                                                Background="Transparent"
                                                BorderThickness="0"
                                                CornerRadius="6"
                                                Padding="10,8"
                                                SnapsToDevicePixels="True">
                                            <Border.Style>
                                                <Style TargetType="Border">
                                                    <Style.Triggers>
                                                        <Trigger Property="IsMouseOver" Value="True">
                                                            <Setter Property="Background" Value="#12FFFFFF" />
                                                        </Trigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </Border.Style>

                                            <Grid>
                                                <Grid.RowDefinitions>
                                                    <!-- Row 0: Network Summary (Icon + SSID + Subtitle + Connect/Disconnect) -->
                                                    <RowDefinition Height="Auto" />
                                                    <!-- Row 1: Inline Fluent Password Container -->
                                                    <RowDefinition Height="Auto" />
                                                </Grid.RowDefinitions>

                                                <!-- Row 0: Summary Row -->
                                                <Grid Grid.Row="0">
                                                    <Grid.ColumnDefinitions>
                                                        <!-- Col 0: Signal Bars Icon (WPF-UI Symbol) -->
                                                        <ColumnDefinition Width="Auto" />
                                                        <!-- Col 1: SSID & Subtitle -->
                                                        <ColumnDefinition Width="*" />
                                                        <!-- Col 2: Action Button / Status -->
                                                        <ColumnDefinition Width="Auto" />
                                                    </Grid.ColumnDefinitions>

                                                    <!-- Left: Official WPF-UI SymbolIcon for Signal Bars -->
                                                    <ui:SymbolIcon Grid.Column="0"
                                                                   Symbol="{Binding WifiSymbol}"
                                                                   FontSize="20"
                                                                   Foreground="{Binding WifiIconColor, Converter={StaticResource StringToBrush}}"
                                                                   HorizontalAlignment="Center"
                                                                   VerticalAlignment="Center"
                                                                   Margin="0,0,14,0" />

                                                    <!-- Center: SSID & Clean Subtitle (No Ugly Blue Badges) -->
                                                    <StackPanel Grid.Column="1" VerticalAlignment="Center" Margin="0,0,12,0">
                                                        <TextBlock Text="{Binding Ssid}"
                                                                   FontFamily="Segoe UI Variable Text, Segoe UI, sans-serif"
                                                                   FontSize="13.5"
                                                                   FontWeight="SemiBold"
                                                                   Foreground="#FFFFFF"
                                                                   TextTrimming="CharacterEllipsis"
                                                                   ToolTip="{Binding Ssid}" />

                                                        <TextBlock Text="{Binding SubtitleText}"
                                                                   FontFamily="Segoe UI Variable Text, Segoe UI, sans-serif"
                                                                   FontSize="11"
                                                                   Foreground="{Binding SubtitleColor, Converter={StaticResource StringToBrush}}"
                                                                   Margin="0,2,0,0" />
                                                    </StackPanel>

                                                    <!-- Right: Action Button Area (Locked at Width="76", Height="28" to eliminate size jumping and scrollbar collisions) -->
                                                    <Grid Grid.Column="2"
                                                          Width="76"
                                                          Height="28"
                                                          VerticalAlignment="Center">
                                                        <!-- 1. Connecting State: Centered Smooth Fluent Spinning Ring -->
                                                        <Border Visibility="{Binding IsConnecting, Converter={StaticResource BoolToVis}}"
                                                                Background="#12FFFFFF"
                                                                BorderBrush="#20FFFFFF"
                                                                BorderThickness="1"
                                                                CornerRadius="4"
                                                                SnapsToDevicePixels="True">
                                                            <Grid HorizontalAlignment="Center"
                                                                  VerticalAlignment="Center"
                                                                  Width="14"
                                                                  Height="14"
                                                                  RenderTransformOrigin="0.5,0.5">
                                                                <Grid.RenderTransform>
                                                                    <RotateTransform x:Name="ConnectingSpinTransform" Angle="0" />
                                                                </Grid.RenderTransform>
                                                                <Grid.Style>
                                                                    <Style TargetType="Grid">
                                                                        <Style.Triggers>
                                                                            <DataTrigger Binding="{Binding IsConnecting}" Value="True">
                                                                                <DataTrigger.EnterActions>
                                                                                    <BeginStoryboard x:Name="StartConnectingSpin">
                                                                                        <Storyboard RepeatBehavior="Forever">
                                                                                            <DoubleAnimation Storyboard.TargetProperty="(UIElement.RenderTransform).(RotateTransform.Angle)"
                                                                                                             From="0" To="360"
                                                                                                             Duration="0:0:0.85" />
                                                                                        </Storyboard>
                                                                                    </BeginStoryboard>
                                                                                </DataTrigger.EnterActions>
                                                                                <DataTrigger.ExitActions>
                                                                                    <StopStoryboard BeginStoryboardName="StartConnectingSpin" />
                                                                                </DataTrigger.ExitActions>
                                                                            </DataTrigger>
                                                                        </Style.Triggers>
                                                                    </Style>
                                                                </Grid.Style>
                                                                <!-- Muted Track -->
                                                                <Ellipse Width="14"
                                                                         Height="14"
                                                                         Stroke="#30FFFFFF"
                                                                         StrokeThickness="1.8" />
                                                                <!-- Glowing Active Head -->
                                                                <Path Stroke="#00E676"
                                                                      StrokeThickness="1.8"
                                                                      StrokeStartLineCap="Round"
                                                                      StrokeEndLineCap="Round"
                                                                      Data="M 7,0 A 7,7 0 0 1 14,7" />
                                                            </Grid>
                                                        </Border>

                                                        <!-- 2. Disconnect Button (if Connected and not Connecting) -->
                                                        <Button Content="Disconnect"
                                                                Command="{Binding DataContext.DisconnectWifiNetworkCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                                CommandParameter="{Binding}">
                                                            <Button.Style>
                                                                <Style TargetType="Button" BasedOn="{StaticResource FluentWifiDisconnectButtonStyle}">
                                                                    <Setter Property="Visibility" Value="Collapsed" />
                                                                    <Style.Triggers>
                                                                        <MultiDataTrigger>
                                                                            <MultiDataTrigger.Conditions>
                                                                                <Condition Binding="{Binding IsConnected}" Value="True" />
                                                                                <Condition Binding="{Binding IsConnecting}" Value="False" />
                                                                            </MultiDataTrigger.Conditions>
                                                                            <Setter Property="Visibility" Value="Visible" />
                                                                        </MultiDataTrigger>
                                                                    </Style.Triggers>
                                                                </Style>
                                                            </Button.Style>
                                                        </Button>

                                                        <!-- 3. Connect Button (if Not Connected and not Connecting) -->
                                                        <Button Content="Connect"
                                                                Command="{Binding DataContext.ConnectWifiNetworkCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                                CommandParameter="{Binding}">
                                                            <Button.Style>
                                                                <Style TargetType="Button" BasedOn="{StaticResource FluentWifiActionButtonStyle}">
                                                                    <Setter Property="Visibility" Value="Collapsed" />
                                                                    <Style.Triggers>
                                                                        <MultiDataTrigger>
                                                                            <MultiDataTrigger.Conditions>
                                                                                <Condition Binding="{Binding IsNotConnected}" Value="True" />
                                                                                <Condition Binding="{Binding IsConnecting}" Value="False" />
                                                                            </MultiDataTrigger.Conditions>
                                                                            <Setter Property="Visibility" Value="Visible" />
                                                                        </MultiDataTrigger>
                                                                    </Style.Triggers>
                                                                </Style>
                                                            </Button.Style>
                                                        </Button>
                                                    </Grid>
                                                </Grid>

                                                <!-- Row 1: Inline Fluent Password Container (Expands when entering key) -->
                                                <Border Grid.Row="1"
                                                        Visibility="{Binding IsPasswordPromptOpen, Converter={StaticResource BoolToVis}}"
                                                        Background="#18000000"
                                                        BorderBrush="#18FFFFFF"
                                                        BorderThickness="1"
                                                        CornerRadius="6"
                                                        Margin="0,10,0,2"
                                                        Padding="12,10"
                                                        SnapsToDevicePixels="True">
                                                    <StackPanel>
                                                        <TextBlock Text="Enter the network security key"
                                                                   FontFamily="Segoe UI Variable Text, Segoe UI, sans-serif"
                                                                   FontSize="11"
                                                                   FontWeight="SemiBold"
                                                                   Foreground="#B0FFFFFF"
                                                                   Margin="0,0,0,6" />

                                                        <!-- PasswordBox with Fluent Styling -->
                                                        <Grid Margin="0,0,0,8">
                                                            <PasswordBox x:Name="WifiPasswordBox"
                                                                         Height="32"
                                                                         FontSize="13"
                                                                         Foreground="#FFFFFF"
                                                                         Background="#1AFFFFFF"
                                                                         BorderBrush="#25FFFFFF"
                                                                         BorderThickness="1"
                                                                         Padding="8,4"
                                                                         VerticalContentAlignment="Center"
                                                                         KeyDown="WifiPasswordBox_KeyDown">
                                                                <PasswordBox.Resources>
                                                                    <Style TargetType="Border">
                                                                        <Setter Property="CornerRadius" Value="4" />
                                                                    </Style>
                                                                </PasswordBox.Resources>
                                                            </PasswordBox>
                                                        </Grid>

                                                        <!-- Error Message (if incorrect key) -->
                                                        <TextBlock Text="{Binding ConnectionErrorMessage}"
                                                                   Visibility="{Binding HasConnectionError, Converter={StaticResource BoolToVis}}"
                                                                   FontFamily="Segoe UI Variable Text, Segoe UI, sans-serif"
                                                                   FontSize="11"
                                                                   Foreground="#FF6B6B"
                                                                   Margin="0,0,0,8"
                                                                   TextWrapping="Wrap" />

                                                        <!-- Action Buttons: Cancel and Next/Connect -->
                                                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                                                            <Button Content="Cancel"
                                                                    Style="{StaticResource FluentWifiDisconnectButtonStyle}"
                                                                    Command="{Binding DataContext.CancelWifiPasswordCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                                    CommandParameter="{Binding ElementName=WifiPasswordBox}"
                                                                    Width="72"
                                                                    Height="28"
                                                                    Margin="0,0,8,0" />

                                                            <Button Content="Next"
                                                                    Style="{StaticResource FluentWifiActionButtonStyle}"
                                                                    Command="{Binding DataContext.ConnectWithPasswordCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                                    CommandParameter="{Binding ElementName=WifiPasswordBox}"
                                                                    Width="72"
                                                                    Height="28" />
                                                        </StackPanel>
                                                    </StackPanel>
                                                </Border>
                                            </Grid>
                                        </Border>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </ScrollViewer>
                    </Grid>

                    <!-- Content Row: View 2 - Clean Professional Fluent Banner (When Wi-Fi Radio is Turned OFF) -->
                    <Grid Grid.Row="2"
                          Visibility="{Binding IsWifiRadioDisabled, Converter={StaticResource BoolToVis}}"
                          VerticalAlignment="Center"
                          HorizontalAlignment="Center"
                          Margin="0,32,0,32"
                          SnapsToDevicePixels="True">
                        <Grid.Style>
                            <Style TargetType="Grid">
                                <Style.Triggers>
                                    <Trigger Property="Visibility" Value="Visible">
                                        <Trigger.EnterActions>
                                            <BeginStoryboard>
                                                <Storyboard>
                                                    <DoubleAnimation Storyboard.TargetProperty="Opacity"
                                                                     From="0.0" To="1.0"
                                                                     Duration="0:0:0.2" />
                                                </Storyboard>
                                            </BeginStoryboard>
                                        </Trigger.EnterActions>
                                    </Trigger>
                                </Style.Triggers>
                            </Style>
                        </Grid.Style>
                        <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center">
                            <ui:SymbolIcon Symbol="WifiOff24"
                                           FontSize="36"
                                           Foreground="#45FFFFFF"
                                           HorizontalAlignment="Center"
                                           Margin="0,0,0,12" />
                            <TextBlock Text="{Binding WifiTurnedOffBannerTitle}"
                                       FontFamily="Segoe UI Variable Display, Segoe UI, sans-serif"
                                       FontSize="15"
                                       FontWeight="SemiBold"
                                       Foreground="#D0FFFFFF"
                                       HorizontalAlignment="Center" />
                            <TextBlock Text="Turn on the switch above to see and connect to available Wi-Fi networks."
                                       FontFamily="Segoe UI Variable Text, Segoe UI, sans-serif"
                                       FontSize="12"
                                       Foreground="#65FFFFFF"
                                       HorizontalAlignment="Center"
                                       Margin="0,4,0,14" />
                            <Button Content="Turn on Wi-Fi"
                                    Style="{StaticResource FluentWifiActionButtonStyle}"
                                    Command="{Binding ToggleWifiRadioCommand}"
                                    HorizontalAlignment="Center"
                                    Width="120"
                                    Height="32"
                                    FontSize="12.5" />
                        </StackPanel>
                    </Grid>
                </Grid>

                <!-- ==================== 3. DISCONNECT PANEL (RESERVED) ==================== -->
                <Grid Visibility="{Binding IsKillNetPanel, Converter={StaticResource BoolToVis}}"
                      Margin="20,16,20,16" Background="Transparent">
                    <Border Background="#06FFFFFF" BorderBrush="#10FFFFFF" BorderThickness="1" CornerRadius="6" Padding="20">
                        <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center">
                            <TextBlock Text="&#xEB55;" FontFamily="Segoe Fluent Icons, Segoe MDL2 Assets" FontSize="26" Foreground="#80FFFFFF" HorizontalAlignment="Center" Margin="0,0,0,8" />
                            <TextBlock Text="Disconnect Panel" FontFamily="Segoe UI Variable Display, Segoe UI, sans-serif" FontSize="16" FontWeight="SemiBold" Foreground="#FFFFFF" HorizontalAlignment="Center" />
                            <TextBlock Text="Reserved for future network disconnect features." FontFamily="Segoe UI Variable Text, Segoe UI, sans-serif" FontSize="12" Foreground="#65FFFFFF" HorizontalAlignment="Center" Margin="0,6,0,0" />
                        </StackPanel>
                    </Border>
                </Grid>

                <!-- Speed Panel Placeholder -->
                <Grid Visibility="{Binding IsSpeedPanel, Converter={StaticResource BoolToVis}}"
                      Margin="20,16,20,16" Background="Transparent">
                    <Border Background="#06FFFFFF" BorderBrush="#10FFFFFF" BorderThickness="1" CornerRadius="6" Padding="20">
                        <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center">
                            <ui:SymbolIcon Symbol="TopSpeed24" FontSize="26" Foreground="#80FFFFFF" HorizontalAlignment="Center" Margin="0,0,0,8" />
                            <TextBlock Text="Speed &amp; Telemetry Panel" FontFamily="Segoe UI Variable Display, Segoe UI, sans-serif" FontSize="16" FontWeight="SemiBold" Foreground="#FFFFFF" HorizontalAlignment="Center" />
                            <TextBlock Text="Real-time bandwidth meters and GPU-accelerated waveform will be designed next." FontFamily="Segoe UI Variable Text, Segoe UI, sans-serif" FontSize="12" Foreground="#65FFFFFF" HorizontalAlignment="Center" Margin="0,6,0,0" />
                        </StackPanel>
                    </Border>
                </Grid>

                <!-- Hotspot Panel Placeholder -->
                <Grid Visibility="{Binding IsHotspotPanel, Converter={StaticResource BoolToVis}}"
                      Margin="20,16,20,16" Background="Transparent">
                    <Border Background="#06FFFFFF" BorderBrush="#10FFFFFF" BorderThickness="1" CornerRadius="6" Padding="20">
                        <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center">
                            <TextBlock Text="&#xE88E;" FontFamily="Segoe Fluent Icons, Segoe MDL2 Assets" FontSize="26" Foreground="#80FFFFFF" HorizontalAlignment="Center" Margin="0,0,0,8" />
                            <TextBlock Text="Mobile Hotspot Panel" FontFamily="Segoe UI Variable Display, Segoe UI, sans-serif" FontSize="16" FontWeight="SemiBold" Foreground="#FFFFFF" HorizontalAlignment="Center" />
                            <TextBlock Text="Windows Mobile Hotspot toggle, SSID/password &amp; clients will be designed next." FontFamily="Segoe UI Variable Text, Segoe UI, sans-serif" FontSize="12" Foreground="#65FFFFFF" HorizontalAlignment="Center" Margin="0,6,0,0" />
                        </StackPanel>
                    </Border>
                </Grid>
            </Grid>
        </Grid>
    </widgets:WidgetCard>
</UserControl>
