<UserControl x:Class="MetroHub.Widgets.Catalog.Network.NetworkWidgetView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:widgets="clr-namespace:MetroHub.Widgets"
             xmlns:network="clr-namespace:MetroHub.Widgets.Catalog.Network"
             xmlns:conv="clr-namespace:MetroHub.Presentation.Converters"
             xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
             mc:Ignorable="d" 
             d:DataContext="{d:DesignInstance Type=network:NetworkWidgetViewModel}"
             Focusable="False"
             FocusVisualStyle="{x:Null}"
             ClipToBounds="True"
             SnapsToDevicePixels="True"
             UseLayoutRounding="True"
             TextOptions.TextFormattingMode="Ideal"
             TextOptions.TextRenderingMode="Grayscale"
             TextOptions.TextHintingMode="Animated">

    <UserControl.Resources>
        <BooleanToVisibilityConverter x:Key="BoolToVis" />
        <conv:StringToBrushConverter x:Key="StringToBrush" />

        <!-- Strips default dotted focus border across all controls -->
        <Style TargetType="{x:Type Control}">
            <Setter Property="FocusVisualStyle" Value="{x:Null}" />
        </Style>

        <!-- Base Top Tile Button Style -->
        <!-- Seamless: default no border visible, hover illuminates only vertical side dividers, NO top/bottom borders, NO background fill on hover -->
        <!-- Base Top Tile Button Style -->
        <!-- Seamless edge-to-edge: hover illuminates side dividing borders, no background fill, Panel.ZIndex=10 ensures top rendering -->
        <!-- Base Top Tile Button Style -->
        <!-- Apple VisionOS Smoked Glass: edge-to-edge dividing borders, luminosity scrim + smoked glass gradient + specular top lip -->
        <!-- Base Top Tile Button Style -->
        <!-- Mica Top Bar: clean edge-to-edge dividing borders, illuminates on hover with Panel.ZIndex=10 -->
        <!-- Base Top Tile Button Style -->
        <!-- Acrylic Top Bar: edge-to-edge dividing borders on hover, full-width bottom separator with active glow -->
        <Style x:Key="TopTileButtonBaseStyle" TargetType="Button">
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="BorderBrush" Value="Transparent" />
            <Setter Property="BorderThickness" Value="1,0,1,0" />
            <Setter Property="Height" Value="76" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Focusable" Value="False" />
            <Setter Property="FocusVisualStyle" Value="{x:Null}" />
            <Setter Property="HorizontalContentAlignment" Value="Stretch" />
            <Setter Property="VerticalContentAlignment" Value="Stretch" />
            <Setter Property="SnapsToDevicePixels" Value="True" />
            <Setter Property="UseLayoutRounding" Value="True" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="TileBorder"
                                Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                SnapsToDevicePixels="True"
                                UseLayoutRounding="True">
                            <ContentPresenter HorizontalAlignment="Center"
                                              VerticalAlignment="Center"
                                              Margin="0,0,0,2"
                                              SnapsToDevicePixels="True" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <!-- Hover state: illuminates full continuous tile border and subtle glass sheen -->
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="TileBorder" Property="BorderBrush" Value="#55FFFFFF" />
                                <Setter TargetName="TileBorder" Property="Background" Value="#0DFFFFFF" />
                                <Setter Property="Panel.ZIndex" Value="10" />
                            </Trigger>

                            <!-- Pressed state -->
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="TileBorder" Property="BorderBrush" Value="#75FFFFFF" />
                                <Setter TargetName="TileBorder" Property="Background" Value="#18FFFFFF" />
                                <Setter Property="Panel.ZIndex" Value="10" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Sleek Micro Copy Button Style -->
        <Style x:Key="MicroCopyButtonStyle" TargetType="Button">
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="BorderBrush" Value="Transparent" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="Width" Value="24" />
            <Setter Property="Height" Value="24" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Focusable" Value="False" />
            <Setter Property="FocusVisualStyle" Value="{x:Null}" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Border"
                                Background="{TemplateBinding Background}"
                                CornerRadius="4"
                                SnapsToDevicePixels="True">
                            <ui:SymbolIcon x:Name="CopyIcon"
                                           Symbol="Copy16"
                                           FontSize="13"
                                           Foreground="#80FFFFFF"
                                           HorizontalAlignment="Center"
                                           VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Border" Property="Background" Value="#1CFFFFFF" />
                                <Setter TargetName="CopyIcon" Property="Foreground" Value="#FFFFFF" />
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="Border" Property="Background" Value="#2EFFFFFF" />
                                <Setter TargetName="CopyIcon" Property="Foreground" Value="#FFFFFF" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Clean Timeframe Toggle Button Style (Zero borders, animated sliding indicator host) -->
        <Style x:Key="TimeframeToggleButtonStyle" TargetType="Button">
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="BorderBrush" Value="Transparent" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="Height" Value="28" />
            <Setter Property="Padding" Value="0" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Focusable" Value="False" />
            <Setter Property="FocusVisualStyle" Value="{x:Null}" />
            <Setter Property="Foreground" Value="#70FFFFFF" />
            <Setter Property="FontFamily" Value="Segoe UI Variable Text, Segoe UI, sans-serif" />
            <Setter Property="FontSize" Value="12" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="SnapsToDevicePixels" Value="True" />
            <Setter Property="UseLayoutRounding" Value="True" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="ButtonBackground"
                                Background="{TemplateBinding Background}"
                                CornerRadius="2"
                                SnapsToDevicePixels="True">
                            <ContentPresenter HorizontalAlignment="Center"
                                              VerticalAlignment="Center"
                                              Margin="{TemplateBinding Padding}"
                                              SnapsToDevicePixels="True" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <!-- Hover state: soft text brighten, subtle glass sheen, zero borders -->
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="ButtonBackground" Property="Background" Value="#0DFFFFFF" />
                                <Setter Property="Foreground" Value="#E0FFFFFF" />
                            </Trigger>

                            <!-- Pressed state -->
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="ButtonBackground" Property="Background" Value="#18FFFFFF" />
                                <Setter Property="Foreground" Value="#FFFFFF" />
                            </Trigger>

                            <!-- Active (Selected) state: bright pure white text (sliding indicator glides beneath) -->
                            <Trigger Property="Tag" Value="Active">
                                <Setter Property="Foreground" Value="#FFFFFF" />
                            </Trigger>

                            <!-- Active + Hover -->
                            <MultiTrigger>
                                <MultiTrigger.Conditions>
                                    <Condition Property="IsMouseOver" Value="True" />
                                    <Condition Property="Tag" Value="Active" />
                                </MultiTrigger.Conditions>
                                <Setter TargetName="ButtonBackground" Property="Background" Value="#0DFFFFFF" />
                                <Setter Property="Foreground" Value="#FFFFFF" />
                            </MultiTrigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="TimeframeSessionButtonStyle" TargetType="Button" BasedOn="{StaticResource TimeframeToggleButtonStyle}">
            <Style.Triggers>
                <DataTrigger Binding="{Binding IsSessionTimeframe}" Value="True">
                    <Setter Property="Tag" Value="Active" />
                </DataTrigger>
            </Style.Triggers>
        </Style>

        <Style x:Key="Timeframe24hButtonStyle" TargetType="Button" BasedOn="{StaticResource TimeframeToggleButtonStyle}">
            <Style.Triggers>
                <DataTrigger Binding="{Binding Is24HoursTimeframe}" Value="True">
                    <Setter Property="Tag" Value="Active" />
                </DataTrigger>
            </Style.Triggers>
        </Style>

        <Style x:Key="Timeframe7dButtonStyle" TargetType="Button" BasedOn="{StaticResource TimeframeToggleButtonStyle}">
            <Style.Triggers>
                <DataTrigger Binding="{Binding Is7DaysTimeframe}" Value="True">
                    <Setter Property="Tag" Value="Active" />
                </DataTrigger>
            </Style.Triggers>
        </Style>

        <Style x:Key="Timeframe30dButtonStyle" TargetType="Button" BasedOn="{StaticResource TimeframeToggleButtonStyle}">
            <Style.Triggers>
                <DataTrigger Binding="{Binding Is30DaysTimeframe}" Value="True">
                    <Setter Property="Tag" Value="Active" />
                </DataTrigger>
            </Style.Triggers>
        </Style>

        <!-- 1. Ethernet Tile Style -->
        <Style x:Key="EthernetTileStyle" TargetType="Button" BasedOn="{StaticResource TopTileButtonBaseStyle}">
            <Style.Triggers>
                <DataTrigger Binding="{Binding IsEthernetPanel}" Value="True">
                    <Setter Property="Tag" Value="GlowGreen" />
                </DataTrigger>
                <DataTrigger Binding="{Binding HasEthernetAdapter}" Value="False">
                    <Setter Property="Opacity" Value="0.3" />
                    <Setter Property="IsEnabled" Value="False" />
                </DataTrigger>
            </Style.Triggers>
        </Style>

        <!-- 2. WIFI Tile Style -->
        <Style x:Key="WifiTileStyle" TargetType="Button" BasedOn="{StaticResource TopTileButtonBaseStyle}">
            <Style.Triggers>
                <DataTrigger Binding="{Binding IsWifiPanel}" Value="True">
                    <Setter Property="Tag" Value="GlowGreen" />
                </DataTrigger>
                <DataTrigger Binding="{Binding HasWifiAdapter}" Value="False">
                    <Setter Property="Opacity" Value="0.3" />
                    <Setter Property="IsEnabled" Value="False" />
                </DataTrigger>
            </Style.Triggers>
        </Style>

        <!-- 3. Kill Net Tile Style -->
        <Style x:Key="KillNetTileStyle" TargetType="Button" BasedOn="{StaticResource TopTileButtonBaseStyle}">
            <Style.Triggers>
                <DataTrigger Binding="{Binding IsKillNetPanel}" Value="True">
                    <Setter Property="Tag" Value="GlowRed" />
                </DataTrigger>
                <DataTrigger Binding="{Binding IsInternetDisconnected}" Value="True">
                    <Setter Property="Tag" Value="GlowRed" />
                </DataTrigger>
            </Style.Triggers>
        </Style>

        <!-- 4. Speed Tile Style -->
        <Style x:Key="SpeedTileStyle" TargetType="Button" BasedOn="{StaticResource TopTileButtonBaseStyle}">
            <Style.Triggers>
                <DataTrigger Binding="{Binding IsSpeedPanel}" Value="True">
                    <Setter Property="Tag" Value="GlowGreen" />
                </DataTrigger>
            </Style.Triggers>
        </Style>

        <!-- 5. Hotspot Tile Style -->
        <Style x:Key="HotspotTileStyle" TargetType="Button" BasedOn="{StaticResource TopTileButtonBaseStyle}">
            <Style.Triggers>
                <DataTrigger Binding="{Binding IsHotspotPanel}" Value="True">
                    <Setter Property="Tag" Value="GlowGreen" />
                </DataTrigger>
            </Style.Triggers>
        </Style>
    </UserControl.Resources>

    <!-- Outer Widget Card with Padding="0" so dividing borders run border-to-border -->
    <widgets:WidgetCard Padding="0" Background="Transparent" CornerRadius="2">
        <Grid SnapsToDevicePixels="True" UseLayoutRounding="True" ClipToBounds="True" Background="Transparent">
            <Grid.RowDefinitions>
                <!-- Row 0: Top 5-Tile Segmented Region (Height 76px, with seamless bottom separator) -->
                <RowDefinition Height="76" />
                <!-- Row 1: Lower Panel Region -->
                <RowDefinition Height="*" />
            </Grid.RowDefinitions>

            <!-- ========================================================================= -->
            <!-- ROW 0: TOP 5-TILE REGION (Transparent Acrylic Backdrop)                   -->
            <!-- [ Ethernet ] | [ WIFI ] | [ Kill Net ] | [ Speed ] | [ Hotspot ]          -->
            <!-- ========================================================================= -->
            <Grid x:Name="TopTilesGrid" Grid.Row="0" SnapsToDevicePixels="True" Background="Transparent" MouseMove="OnMouseMove" MouseEnter="OnMouseEnter" MouseLeave="OnMouseLeave">
                <Grid.ColumnDefinitions>
                    <!-- Col 0: Ethernet -->
                    <ColumnDefinition Width="*" />
                    <!-- Col 1: WIFI -->
                    <ColumnDefinition Width="*" />
                    <!-- Col 2: Kill Net -->
                    <ColumnDefinition Width="*" />
                    <!-- Col 3: Speed -->
                    <ColumnDefinition Width="*" />
                    <!-- Col 4: Hotspot -->
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>

                <!-- Continuous 1px bottom border across all 5 tiles with Fluent Reveal mouse tracking -->
                <Grid Grid.Column="0" Grid.ColumnSpan="5" VerticalAlignment="Bottom" Height="1" SnapsToDevicePixels="True">
                    <Border Background="#22FFFFFF" SnapsToDevicePixels="True" />
                    <Border x:Name="BottomRevealBorder" SnapsToDevicePixels="True" Opacity="0">
                        <Border.Background>
                            <RadialGradientBrush x:Name="BottomRevealBrush" MappingMode="Absolute" RadiusX="160" RadiusY="160">
                                <GradientStop Color="#FFFFFFFF" Offset="0.0" />
                                <GradientStop Color="#60FFFFFF" Offset="0.5" />
                                <GradientStop Color="#00000000" Offset="1.0" />
                            </RadialGradientBrush>
                        </Border.Background>
                    </Border>
                </Grid>

                <!-- Sliding Active Indicator -->
                <Border x:Name="SlidingActiveIndicator"
                        Grid.Column="0"
                        Grid.ColumnSpan="5"
                        HorizontalAlignment="Left"
                        VerticalAlignment="Bottom"
                        Height="2"
                        Width="0"
                        Background="#00E676"
                        Opacity="0"
                        Panel.ZIndex="25"
                        SnapsToDevicePixels="True">
                    <Border.RenderTransform>
                        <TranslateTransform x:Name="SlidingIndicatorTransform" X="0" />
                    </Border.RenderTransform>
                    <Border.Effect>
                        <DropShadowEffect x:Name="SlidingIndicatorShadow" Color="#00E676" BlurRadius="8" ShadowDepth="0" Opacity="0.8" />
                    </Border.Effect>
                </Border>

                    <!-- ==================== 1. ETHERNET TILE ==================== -->
                    <Button Grid.Column="0"
                        Style="{StaticResource EthernetTileStyle}"
                        Command="{Binding SelectPanelCommand}"
                        CommandParameter="Ethernet"
                        ToolTip="Ethernet Settings &amp; Telemetry">
                    <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center">
                        <!-- Icon: Monitor with Cable (\uE839) - Always pure white -->
                        <TextBlock Text="&#xE839;"
                                   FontFamily="Segoe Fluent Icons, Segoe MDL2 Assets"
                                   FontSize="22"
                                   Foreground="#FFFFFF"
                                   HorizontalAlignment="Center"
                                   SnapsToDevicePixels="True" />
                        <!-- Label: Ethernet -->
                        <TextBlock Text="Ethernet"
                                   FontFamily="Segoe UI Variable Text, Segoe UI, sans-serif"
                                   FontSize="11.5"
                                   FontWeight="SemiBold"
                                   Foreground="#FFFFFF"
                                   HorizontalAlignment="Center"
                                   Margin="0,5,0,0"
                                   SnapsToDevicePixels="True" />
                    </StackPanel>
                </Button>

                <!-- ==================== 2. WIFI TILE ==================== -->
                <Button Grid.Column="1"
                        Margin="-1,0,0,0"
                        Style="{StaticResource WifiTileStyle}"
                        Command="{Binding SelectPanelCommand}"
                        CommandParameter="Wifi"
                        ToolTip="Wi-Fi Networks &amp; Details">
                    <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center">
                        <!-- Icon: Wi-Fi Waves (\uE701) - Always pure white -->
                        <TextBlock Text="&#xE701;"
                                   FontFamily="Segoe Fluent Icons, Segoe MDL2 Assets"
                                   FontSize="22"
                                   Foreground="#FFFFFF"
                                   HorizontalAlignment="Center"
                                   SnapsToDevicePixels="True" />
                        <!-- Label: WIFI -->
                        <TextBlock Text="WIFI"
                                   FontFamily="Segoe UI Variable Text, Segoe UI, sans-serif"
                                   FontSize="11.5"
                                   FontWeight="SemiBold"
                                   Foreground="#FFFFFF"
                                   HorizontalAlignment="Center"
                                   Margin="0,5,0,0"
                                   SnapsToDevicePixels="True" />
                    </StackPanel>
                </Button>

                <!-- ==================== 3. DISABLE INTERNET TILE ==================== -->
                <Button Grid.Column="2"
                        Margin="-1,0,0,0"
                        Style="{StaticResource KillNetTileStyle}"
                        Command="{Binding SelectPanelCommand}"
                        CommandParameter="KillNet"
                        ToolTip="Disconnect / Disable Internet Connection">
                    <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center">
                        <!-- Icon: Plug Disconnected / Cable Off (\uEB55) - Always pure white -->
                        <TextBlock Text="&#xEB55;"
                                   FontFamily="Segoe Fluent Icons, Segoe MDL2 Assets"
                                   FontSize="22"
                                   Foreground="#FFFFFF"
                                   HorizontalAlignment="Center"
                                   SnapsToDevicePixels="True" />
                        <!-- Label: Disable Internet -->
                        <TextBlock Text="Disable Internet"
                                   FontFamily="Segoe UI Variable Text, Segoe UI, sans-serif"
                                   FontSize="10.5"
                                   FontWeight="SemiBold"
                                   Foreground="#FFFFFF"
                                   HorizontalAlignment="Center"
                                   Margin="0,5,0,0"
                                   SnapsToDevicePixels="True" />
                    </StackPanel>
                </Button>

                <!-- ==================== 4. SPEED TILE ==================== -->
                <Button Grid.Column="3"
                        Margin="-1,0,0,0"
                        Style="{StaticResource SpeedTileStyle}"
                        Command="{Binding SelectPanelCommand}"
                        CommandParameter="Speed"
                        ToolTip="Live Throughput &amp; Bandwidth Diagnostics">
                    <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center">
                        <!-- Icon: TopSpeed24 Speedometer - Always pure white -->
                        <ui:SymbolIcon Symbol="TopSpeed24"
                                       FontSize="22"
                                       Foreground="#FFFFFF"
                                       HorizontalAlignment="Center"
                                       SnapsToDevicePixels="True" />
                        <!-- Label: Speed -->
                        <TextBlock Text="Speed"
                                   FontFamily="Segoe UI Variable Text, Segoe UI, sans-serif"
                                   FontSize="11.5"
                                   FontWeight="SemiBold"
                                   Foreground="#FFFFFF"
                                   HorizontalAlignment="Center"
                                   Margin="0,5,0,0"
                                   SnapsToDevicePixels="True" />
                    </StackPanel>
                </Button>

                <!-- ==================== 5. HOTSPOT TILE ==================== -->
                <Button Grid.Column="4"
                        Margin="-1,0,0,0"
                        Style="{StaticResource HotspotTileStyle}"
                        Command="{Binding SelectPanelCommand}"
                        CommandParameter="Hotspot"
                        ToolTip="Windows Mobile Hotspot Settings">
                    <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center">
                        <!-- Icon: Mobile Hotspot (\uE88E) - Always pure white -->
                        <TextBlock Text="&#xE88E;"
                                   FontFamily="Segoe Fluent Icons, Segoe MDL2 Assets"
                                   FontSize="22"
                                   Foreground="#FFFFFF"
                                   HorizontalAlignment="Center"
                                   SnapsToDevicePixels="True" />
                        <!-- Label: Hotspot -->
                        <TextBlock Text="Hotspot"
                                   FontFamily="Segoe UI Variable Text, Segoe UI, sans-serif"
                                   FontSize="11.5"
                                   FontWeight="SemiBold"
                                   Foreground="#FFFFFF"
                                   HorizontalAlignment="Center"
                                   Margin="0,5,0,0"
                                   SnapsToDevicePixels="True" />
                    </StackPanel>
                </Button>
            </Grid>

            <!-- ========================================================================= -->
            <!-- ROW 1: LOWER PANEL REGION                                                 -->
            <!-- ========================================================================= -->
            <Grid Grid.Row="1" Background="Transparent" SnapsToDevicePixels="True">

                <!-- ==================== 1. ETHERNET PANEL ==================== -->
                <Grid Visibility="{Binding IsEthernetPanel, Converter={StaticResource BoolToVis}}"
                      Margin="24,14,24,14"
                      SnapsToDevicePixels="True">
                    <Grid.RowDefinitions>
                        <!-- Properties Header -->
                        <RowDefinition Height="Auto" />
                        <!-- 5 Core Specs Grid -->
                        <RowDefinition Height="*" />
                        <!-- Subtle Hairline Separator -->
                        <RowDefinition Height="Auto" />
                        <!-- Bottom Data Usage Row -->
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>

                    <!-- Header: [ ℹ ] Properties -->
                    <StackPanel Grid.Row="0"
                                Orientation="Horizontal"
                                VerticalAlignment="Center"
                                Margin="0,0,0,16">
                        <ui:SymbolIcon Symbol="Info20"
                                       FontSize="15"
                                       Foreground="#A0FFFFFF"
                                       Margin="0,0,8,0"
                                       VerticalAlignment="Center" />
                        <TextBlock Text="Properties"
                                   FontFamily="Segoe UI Variable Display, Segoe UI, sans-serif"
                                   FontSize="15"
                                   FontWeight="SemiBold"
                                   Foreground="#FFFFFF"
                                   VerticalAlignment="Center" />
                    </StackPanel>

                    <!-- 2-Column Clean Spec Grid (5 Core Specs) -->
                    <Grid Grid.Row="1">
                        <Grid.ColumnDefinitions>
                            <!-- Left Column: Adapter, IPv4, MAC -->
                            <ColumnDefinition Width="*" />
                            <!-- Clean Separation Gap -->
                            <ColumnDefinition Width="32" />
                            <!-- Right Column: DNS, Session Uptime -->
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>

                        <!-- LEFT COLUMN -->
                        <StackPanel Grid.Column="0">
                            <!-- 1. ADAPTER -->
                            <StackPanel Margin="0,0,0,14">
                                <TextBlock Text="ADAPTER"
                                           FontFamily="Segoe UI Variable Text, Segoe UI, sans-serif"
                                           FontSize="10"
                                           FontWeight="SemiBold"
                                           Foreground="#60FFFFFF" />
                                <TextBlock Text="{Binding Ethernet.Description}"
                                           FontFamily="Segoe UI Variable Text, Segoe UI, sans-serif"
                                           FontSize="13"
                                           FontWeight="SemiBold"
                                           Foreground="#FFFFFF"
                                           TextTrimming="CharacterEllipsis"
                                           ToolTip="{Binding Ethernet.Description}"
                                           Margin="0,3,0,0" />
                            </StackPanel>

                            <!-- 2. IPV4 -->
                            <Grid Margin="0,0,0,14">
                                <StackPanel>
                                    <TextBlock Text="IPV4"
                                               FontFamily="Segoe UI Variable Text, Segoe UI, sans-serif"
                                               FontSize="10"
                                               FontWeight="SemiBold"
                                               Foreground="#60FFFFFF" />
                                    <TextBlock Text="{Binding Ethernet.IpAddress}"
                                               FontFamily="Consolas, Segoe UI Variable Text"
                                               FontSize="13"
                                               FontWeight="SemiBold"
                                               Foreground="#FFFFFF"
                                               Margin="0,3,0,0" />
                                </StackPanel>
                                <Button HorizontalAlignment="Right"
                                        VerticalAlignment="Bottom"
                                        Style="{StaticResource MicroCopyButtonStyle}"
                                        Command="{Binding CopyEthernetIpCommand}"
                                        ToolTip="{Binding CopyEthernetIpTooltip}" />
                            </Grid>

                            <!-- 3. MAC -->
                            <Grid Margin="0,0,0,0">
                                <StackPanel>
                                    <TextBlock Text="MAC"
                                               FontFamily="Segoe UI Variable Text, Segoe UI, sans-serif"
                                               FontSize="10"
                                               FontWeight="SemiBold"
                                               Foreground="#60FFFFFF" />
                                    <TextBlock Text="{Binding Ethernet.MacAddress}"
                                               FontFamily="Consolas, Segoe UI Variable Text"
                                               FontSize="13"
                                               FontWeight="SemiBold"
                                               Foreground="#D0FFFFFF"
                                               Margin="0,3,0,0" />
                                </StackPanel>
                                <Button HorizontalAlignment="Right"
                                        VerticalAlignment="Bottom"
                                        Style="{StaticResource MicroCopyButtonStyle}"
                                        Command="{Binding CopyEthernetMacCommand}"
                                        ToolTip="{Binding CopyEthernetMacTooltip}" />
                            </Grid>
                        </StackPanel>

                        <!-- RIGHT COLUMN -->
                        <StackPanel Grid.Column="2">
                            <!-- 4. DNS -->
                            <StackPanel Margin="0,0,0,14">
                                <TextBlock Text="DNS"
                                           FontFamily="Segoe UI Variable Text, Segoe UI, sans-serif"
                                           FontSize="10"
                                           FontWeight="SemiBold"
                                           Foreground="#60FFFFFF" />
                                <TextBlock Text="{Binding Ethernet.DnsServersString}"
                                           FontFamily="Consolas, Segoe UI Variable Text"
                                           FontSize="13"
                                           FontWeight="SemiBold"
                                           Foreground="#D0FFFFFF"
                                           TextTrimming="CharacterEllipsis"
                                           ToolTip="{Binding Ethernet.DnsServersString}"
                                           Margin="0,3,0,0" />
                            </StackPanel>

                            <!-- 5. SESSION UPTIME -->
                            <StackPanel Margin="0,0,0,0">
                                <TextBlock Text="SESSION UPTIME"
                                           FontFamily="Segoe UI Variable Text, Segoe UI, sans-serif"
                                           FontSize="10"
                                           FontWeight="SemiBold"
                                           Foreground="#60FFFFFF" />
                                <TextBlock Text="{Binding Ethernet.DurationString}"
                                           FontFamily="Consolas, Segoe UI Variable Text"
                                           FontSize="13"
                                           FontWeight="SemiBold"
                                           Foreground="#FFFFFF"
                                           Margin="0,3,0,0" />
                            </StackPanel>
                        </StackPanel>
                    </Grid>

                    <!-- Hairline Divider -->
                    <Border Grid.Row="2"
                            Height="1"
                            Background="#14FFFFFF"
                            Margin="0,14,0,12"
                            SnapsToDevicePixels="True" />

                    <!-- 6. DATA USAGE DEDICATED BOTTOM ROW -->
                    <Grid Grid.Row="3" SnapsToDevicePixels="True">
                        <Grid.ColumnDefinitions>
                            <!-- Left: Timeframe Segmented Toggle Buttons -->
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                            <!-- Right: Accurate Data Usage Readout -->
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>

                        <!-- Left: Timeframe Buttons with Smooth Sliding Active Indicator (Uniform 4-column layout) -->
                        <Grid x:Name="TimeframeHostGrid" Grid.Column="0" Width="240" VerticalAlignment="Center" SnapsToDevicePixels="True">
                            <UniformGrid Rows="1" Columns="4">
                                <Button x:Name="TimeframeSessionBtn"
                                        Content="Session"
                                        Style="{StaticResource TimeframeSessionButtonStyle}"
                                        Command="{Binding SelectDataUsageTimeframeCommand}"
                                        CommandParameter="session" />
                                <Button x:Name="Timeframe24hBtn"
                                        Content="24h"
                                        Style="{StaticResource Timeframe24hButtonStyle}"
                                        Command="{Binding SelectDataUsageTimeframeCommand}"
                                        CommandParameter="24h" />
                                <Button x:Name="Timeframe7dBtn"
                                        Content="7d"
                                        Style="{StaticResource Timeframe7dButtonStyle}"
                                        Command="{Binding SelectDataUsageTimeframeCommand}"
                                        CommandParameter="7d" />
                                <Button x:Name="Timeframe30dBtn"
                                        Content="30d"
                                        Style="{StaticResource Timeframe30dButtonStyle}"
                                        Command="{Binding SelectDataUsageTimeframeCommand}"
                                        CommandParameter="30d" />
                            </UniformGrid>

                            <!-- Sliding Active Timeframe Indicator (Pure white, identical motion to top tiles) -->
                            <Border x:Name="SlidingTimeframeIndicator"
                                    HorizontalAlignment="Left"
                                    VerticalAlignment="Bottom"
                                    Height="2"
                                    Width="0"
                                    Background="#FFFFFF"
                                    CornerRadius="1"
                                    Opacity="0"
                                    Panel.ZIndex="25"
                                    SnapsToDevicePixels="True">
                                <Border.RenderTransform>
                                    <TranslateTransform x:Name="SlidingTimeframeTransform" X="0" />
                                </Border.RenderTransform>
                                <Border.Effect>
                                    <DropShadowEffect x:Name="SlidingTimeframeShadow" Color="#FFFFFF" BlurRadius="6" ShadowDepth="0" Opacity="0.8" />
                                </Border.Effect>
                            </Border>
                        </Grid>

                        <!-- Right: Accurate Readout (Large bold total + prominent up/down telemetry) -->
                        <StackPanel Grid.Column="2"
                                    HorizontalAlignment="Right"
                                    VerticalAlignment="Center">
                            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                                <TextBlock Text="DATA USAGE"
                                           FontFamily="Segoe UI Variable Text, Segoe UI, sans-serif"
                                           FontSize="10"
                                           FontWeight="SemiBold"
                                           Foreground="#65FFFFFF"
                                           VerticalAlignment="Bottom"
                                           Margin="0,0,8,2" />
                                <TextBlock Text="{Binding DataUsageTotalDisplay}"
                                           FontFamily="Segoe UI Variable Display, Segoe UI, sans-serif"
                                           FontSize="18"
                                           FontWeight="Bold"
                                           Foreground="#FFFFFF"
                                           VerticalAlignment="Bottom" />
                            </StackPanel>
                            <TextBlock Text="{Binding DataUsageDetailDisplay}"
                                       FontFamily="Segoe UI Variable Text, Segoe UI, sans-serif"
                                       FontSize="13"
                                       FontWeight="SemiBold"
                                       Foreground="#E0FFFFFF"
                                       HorizontalAlignment="Right"
                                       Margin="0,3,0,0" />
                        </StackPanel>
                    </Grid>
                </Grid>

                <!-- ==================== OTHER PANELS (Placeholders) ==================== -->
                <!-- Wi-Fi Panel Placeholder -->
                <Grid Visibility="{Binding IsWifiPanel, Converter={StaticResource BoolToVis}}"
                      Margin="20,16,20,16" Background="Transparent">
                    <Border Background="#06FFFFFF" BorderBrush="#10FFFFFF" BorderThickness="1" CornerRadius="6" Padding="20">
                        <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center">
                            <TextBlock Text="&#xE701;" FontFamily="Segoe Fluent Icons, Segoe MDL2 Assets" FontSize="26" Foreground="#80FFFFFF" HorizontalAlignment="Center" Margin="0,0,0,8" />
                            <TextBlock Text="Wi-Fi Panel" FontFamily="Segoe UI Variable Display, Segoe UI, sans-serif" FontSize="16" FontWeight="SemiBold" Foreground="#FFFFFF" HorizontalAlignment="Center" />
                            <TextBlock Text="Wi-Fi networks list, signal bars &amp; connection details will be designed next." FontFamily="Segoe UI Variable Text, Segoe UI, sans-serif" FontSize="12" Foreground="#65FFFFFF" HorizontalAlignment="Center" Margin="0,6,0,0" />
                        </StackPanel>
                    </Border>
                </Grid>

                <!-- Disable Internet Panel Placeholder -->
                <Grid Visibility="{Binding IsKillNetPanel, Converter={StaticResource BoolToVis}}"
                      Margin="20,16,20,16" Background="Transparent">
                    <Border Background="#06FFFFFF" BorderBrush="#10FFFFFF" BorderThickness="1" CornerRadius="6" Padding="20">
                        <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center">
                            <TextBlock Text="&#xEB55;" FontFamily="Segoe Fluent Icons, Segoe MDL2 Assets" FontSize="26" Foreground="#80FFFFFF" HorizontalAlignment="Center" Margin="0,0,0,8" />
                            <TextBlock Text="Disable Internet Panel" FontFamily="Segoe UI Variable Display, Segoe UI, sans-serif" FontSize="16" FontWeight="SemiBold" Foreground="#FFFFFF" HorizontalAlignment="Center" />
                            <TextBlock Text="Kill switch, network adapter disable/enable actions will be designed next." FontFamily="Segoe UI Variable Text, Segoe UI, sans-serif" FontSize="12" Foreground="#65FFFFFF" HorizontalAlignment="Center" Margin="0,6,0,0" />
                        </StackPanel>
                    </Border>
                </Grid>

                <!-- Speed Panel Placeholder -->
                <Grid Visibility="{Binding IsSpeedPanel, Converter={StaticResource BoolToVis}}"
                      Margin="20,16,20,16" Background="Transparent">
                    <Border Background="#06FFFFFF" BorderBrush="#10FFFFFF" BorderThickness="1" CornerRadius="6" Padding="20">
                        <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center">
                            <ui:SymbolIcon Symbol="TopSpeed24" FontSize="26" Foreground="#80FFFFFF" HorizontalAlignment="Center" Margin="0,0,0,8" />
                            <TextBlock Text="Speed &amp; Telemetry Panel" FontFamily="Segoe UI Variable Display, Segoe UI, sans-serif" FontSize="16" FontWeight="SemiBold" Foreground="#FFFFFF" HorizontalAlignment="Center" />
                            <TextBlock Text="Real-time bandwidth meters and GPU-accelerated waveform will be designed next." FontFamily="Segoe UI Variable Text, Segoe UI, sans-serif" FontSize="12" Foreground="#65FFFFFF" HorizontalAlignment="Center" Margin="0,6,0,0" />
                        </StackPanel>
                    </Border>
                </Grid>

                <!-- Hotspot Panel Placeholder -->
                <Grid Visibility="{Binding IsHotspotPanel, Converter={StaticResource BoolToVis}}"
                      Margin="20,16,20,16" Background="Transparent">
                    <Border Background="#06FFFFFF" BorderBrush="#10FFFFFF" BorderThickness="1" CornerRadius="6" Padding="20">
                        <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center">
                            <TextBlock Text="&#xE88E;" FontFamily="Segoe Fluent Icons, Segoe MDL2 Assets" FontSize="26" Foreground="#80FFFFFF" HorizontalAlignment="Center" Margin="0,0,0,8" />
                            <TextBlock Text="Mobile Hotspot Panel" FontFamily="Segoe UI Variable Display, Segoe UI, sans-serif" FontSize="16" FontWeight="SemiBold" Foreground="#FFFFFF" HorizontalAlignment="Center" />
                            <TextBlock Text="Windows Mobile Hotspot toggle, SSID/password &amp; clients will be designed next." FontFamily="Segoe UI Variable Text, Segoe UI, sans-serif" FontSize="12" Foreground="#65FFFFFF" HorizontalAlignment="Center" Margin="0,6,0,0" />
                        </StackPanel>
                    </Border>
                </Grid>
            </Grid>
        </Grid>
    </widgets:WidgetCard>
</UserControl>
