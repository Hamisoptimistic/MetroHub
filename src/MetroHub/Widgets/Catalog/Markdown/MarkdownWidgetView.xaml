<UserControl x:Class="MetroHub.Widgets.Catalog.Markdown.MarkdownWidgetView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:widgets="clr-namespace:MetroHub.Widgets"
             xmlns:markdown="clr-namespace:MetroHub.Widgets.Catalog.Markdown"
             xmlns:sys="clr-namespace:System;assembly=mscorlib"
             xmlns:controls="clr-namespace:MetroHub.Presentation.Controls"
             xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
             mc:Ignorable="d" 
             d:DataContext="{d:DesignInstance Type=markdown:MarkdownWidgetViewModel}"
             Focusable="False"
             FocusVisualStyle="{x:Null}"
             ClipToBounds="True"
             TextOptions.TextFormattingMode="Display"
             FontFamily="{DynamicResource AppFontFamily}">

    <!-- Keyboard shortcuts (Ctrl+S / Ctrl+Shift+S / Ctrl+O / Ctrl+T / Ctrl+W / Ctrl+E) are
         installed as InputBindings by the code-behind once the view model is known: they are
         matched along the route from the focused descendant up, so they fire while the editor has
         focus, stay unreachable from other widgets, and need no Focusable="True". The editor keeps
         Ctrl+Z / Ctrl+Y for itself. -->

    <UserControl.Resources>
        <!-- Base control styles -->
        <Style TargetType="{x:Type Control}">
            <Setter Property="FocusVisualStyle" Value="{x:Null}" />
        </Style>

        <!-- Modern Monospace Editor (Notepad / Cascadia style) -->
        <Style x:Key="MarkdownEditorStyle" TargetType="{x:Type TextBox}">
            <Setter Property="OverridesDefaultStyle" Value="True" />
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="Foreground" Value="#E0E0E6" />
            <Setter Property="FontFamily" Value="{DynamicResource AppMonoFontFamily}" />
            <Setter Property="FontSize" Value="{DynamicResource TypeMonoCodeFontSize}" />
            <Setter Property="FontWeight" Value="{DynamicResource TypeMonoCodeFontWeight}" />
            <Setter Property="CaretBrush" Value="#4CC2FF" />
            <Setter Property="SelectionBrush" Value="#503A86FF" />
            <Setter Property="SelectionOpacity" Value="0.6" />
            <Setter Property="Padding" Value="8,4,12,12" />
            <Setter Property="Margin" Value="0" />
            <Setter Property="SnapsToDevicePixels" Value="True" />
            <Setter Property="FocusVisualStyle" Value="{x:Null}" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="{x:Type TextBox}">
                        <ScrollViewer x:Name="PART_ContentHost"
                                      Focusable="False"
                                      FocusVisualStyle="{x:Null}"
                                      HorizontalScrollBarVisibility="Disabled"
                                      VerticalScrollBarVisibility="Auto"
                                      controls:AutoHideScrollBehavior.IsEnabled="True" />
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>


        <!-- Reader Container -->
        <Style x:Key="MarkdownReaderStyle" TargetType="{x:Type FlowDocumentScrollViewer}">
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="Foreground" Value="#D8D8E0" />
            <Setter Property="FontFamily" Value="{DynamicResource AppFontFamily}" />
            <Setter Property="FontSize" Value="{DynamicResource TypeBodyFontSize}" />
            <Setter Property="FontWeight" Value="{DynamicResource TypeBodyFontWeight}" />
            <Setter Property="Padding" Value="0" />
        </Style>

        <!-- Modern FlowDocument Stylesheet -->
        <Style x:Key="MarkdownDocumentStyle" TargetType="{x:Type FlowDocument}">
            <Setter Property="FontFamily" Value="{DynamicResource AppFontFamily}" />
            <Setter Property="FontSize" Value="{DynamicResource TypeBodyFontSize}" />
            <Setter Property="FontWeight" Value="{DynamicResource TypeBodyFontWeight}" />
            <Setter Property="Foreground" Value="#D4D4DC" />
            <Setter Property="PagePadding" Value="8,4,12,12" />
            <Setter Property="ColumnWidth" Value="999999" />
            <Setter Property="IsColumnWidthFlexible" Value="False" />
            <Setter Property="LineHeight" Value="22" />
            <Style.Resources>
                <sys:String x:Key="MarkdownStyleName">DocumentStyleMetroHub</sys:String>

                <!-- Paragraphs & Headings -->
                <Style TargetType="{x:Type Paragraph}">
                    <Setter Property="Margin" Value="0,0,0,10" />
                    <Style.Triggers>
                        <Trigger Property="Tag" Value="Heading1">
                            <Setter Property="Margin" Value="0,16,0,10" />
                            <Setter Property="Foreground" Value="{DynamicResource TextPrimaryBrush}" />
                            <Setter Property="FontFamily" Value="{DynamicResource AppDisplayFontFamily}" />
                            <Setter Property="FontSize" Value="{DynamicResource TypeDisplayFontSize}" />
                            <Setter Property="FontWeight" Value="Bold" />
                        </Trigger>
                        <Trigger Property="Tag" Value="Heading2">
                            <Setter Property="Margin" Value="0,14,0,8" />
                            <Setter Property="Foreground" Value="#F0F0F5" />
                            <Setter Property="FontFamily" Value="{DynamicResource AppDisplayFontFamily}" />
                            <Setter Property="FontSize" Value="{DynamicResource TypeSubtitleFontSize}" />
                            <Setter Property="FontWeight" Value="Bold" />
                        </Trigger>
                        <Trigger Property="Tag" Value="Heading3">
                            <Setter Property="Margin" Value="0,12,0,6" />
                            <Setter Property="Foreground" Value="#E2E2EA" />
                            <Setter Property="FontFamily" Value="{DynamicResource AppDisplayFontFamily}" />
                            <Setter Property="FontSize" Value="{DynamicResource TypeHeaderFontSize}" />
                            <Setter Property="FontWeight" Value="{DynamicResource TypeHeaderFontWeight}" />
                        </Trigger>
                        <Trigger Property="Tag" Value="Heading4">
                            <Setter Property="Margin" Value="0,10,0,4" />
                            <Setter Property="Foreground" Value="#D4D4DC" />
                            <Setter Property="FontSize" Value="{DynamicResource TypeBodyStrongFontSize}" />
                            <Setter Property="FontWeight" Value="{DynamicResource TypeBodyStrongFontWeight}" />
                        </Trigger>
                        <Trigger Property="Tag" Value="Heading5">
                            <Setter Property="Margin" Value="0,8,0,4" />
                            <Setter Property="Foreground" Value="#BEBED0" />
                            <Setter Property="FontSize" Value="{DynamicResource TypeBodyStrongFontSize}" />
                            <Setter Property="FontWeight" Value="{DynamicResource TypeBodyStrongFontWeight}" />
                        </Trigger>
                        <Trigger Property="Tag" Value="Heading6">
                            <Setter Property="Margin" Value="0,8,0,4" />
                            <Setter Property="Foreground" Value="#A0A5B2" />
                            <Setter Property="FontSize" Value="{DynamicResource TypeCaptionFontSize}" />
                            <Setter Property="FontWeight" Value="{DynamicResource TypeBodyStrongFontWeight}" />
                        </Trigger>
                        <!-- Code Blocks -->
                        <Trigger Property="Tag" Value="CodeBlock">
                            <Setter Property="FontFamily" Value="{DynamicResource AppMonoFontFamily}" />
                            <Setter Property="FontSize" Value="{DynamicResource TypeMonoCodeFontSize}" />
                            <Setter Property="FontWeight" Value="{DynamicResource TypeMonoCodeFontWeight}" />
                            <Setter Property="LineHeight" Value="18" />
                            <Setter Property="Foreground" Value="#CE9178" />
                            <Setter Property="Background" Value="#16181D" />
                            <Setter Property="Padding" Value="12,10" />
                            <Setter Property="Margin" Value="0,8,0,12" />
                        </Trigger>
                        <!-- Quarantine placeholder (one bad construct costs one block, not the preview) -->
                        <Trigger Property="Tag" Value="RenderWarning">
                            <Setter Property="Foreground" Value="#FFC66D" />
                            <Setter Property="FontSize" Value="{DynamicResource TypeCaptionFontSize}" />
                            <Setter Property="FontStyle" Value="Italic" />
                            <Setter Property="Margin" Value="0,8,0,2" />
                        </Trigger>
                        <!-- Empty document hint -->
                        <Trigger Property="Tag" Value="EmptyHint">
                            <Setter Property="Foreground" Value="#8A8A96" />
                            <Setter Property="FontStyle" Value="Italic" />
                        </Trigger>
                    </Style.Triggers>
                </Style>

                <!-- Inline Code -->
                <Style TargetType="{x:Type Run}">
                    <Style.Triggers>
                        <Trigger Property="Tag" Value="CodeSpan">
                            <Setter Property="FontFamily" Value="{DynamicResource AppMonoFontFamily}" />
                            <Setter Property="FontSize" Value="{DynamicResource TypeMonoCodeFontSize}" />
                            <Setter Property="FontWeight" Value="{DynamicResource TypeMonoCodeFontWeight}" />
                            <Setter Property="Foreground" Value="#E5C07B" />
                            <Setter Property="Background" Value="#23272E" />
                        </Trigger>
                    </Style.Triggers>
                </Style>
                <Style TargetType="{x:Type Span}">
                    <Style.Triggers>
                        <Trigger Property="Tag" Value="CodeSpan">
                            <Setter Property="FontFamily" Value="{DynamicResource AppMonoFontFamily}" />
                            <Setter Property="FontSize" Value="{DynamicResource TypeMonoCodeFontSize}" />
                            <Setter Property="FontWeight" Value="{DynamicResource TypeMonoCodeFontWeight}" />
                            <Setter Property="Foreground" Value="#E5C07B" />
                            <Setter Property="Background" Value="#23272E" />
                        </Trigger>
                    </Style.Triggers>
                </Style>

                <!-- Blockquote -->
                <Style TargetType="{x:Type Section}">
                    <Style.Triggers>
                        <Trigger Property="Tag" Value="Blockquote">
                            <Setter Property="Padding" Value="12,6" />
                            <Setter Property="BorderBrush" Value="#454A54" />
                            <Setter Property="BorderThickness" Value="3,0,0,0" />
                            <Setter Property="Foreground" Value="#A0A5B2" />
                        </Trigger>
                    </Style.Triggers>
                </Style>

                <!-- Hyperlinks -->
                <Style TargetType="{x:Type Hyperlink}">
                    <Setter Property="Foreground" Value="#4CC2FF" />
                    <Setter Property="TextDecorations" Value="None" />
                    <Style.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter Property="TextDecorations" Value="Underline" />
                            <Setter Property="Foreground" Value="#70D1FF" />
                        </Trigger>
                    </Style.Triggers>
                </Style>

                <!-- Lists -->
                <Style TargetType="{x:Type List}">
                    <Setter Property="Margin" Value="0,6,0,8" />
                    <Setter Property="Padding" Value="24,0,0,0" />
                </Style>

                <!-- Clean GitHub-like Tables -->
                <Style TargetType="{x:Type Table}">
                    <Setter Property="CellSpacing" Value="0" />
                    <Setter Property="BorderThickness" Value="0,0,0,1" />
                    <Setter Property="BorderBrush" Value="#26FFFFFF" />
                    <Setter Property="Margin" Value="0,8,0,12" />
                </Style>
                <Style TargetType="{x:Type TableRowGroup}">
                    <Style.Triggers>
                        <Trigger Property="Tag" Value="TableHeader">
                            <Setter Property="FontWeight" Value="SemiBold" />
                            <Setter Property="Foreground" Value="{DynamicResource TextPrimaryBrush}" />
                        </Trigger>
                    </Style.Triggers>
                </Style>
                <Style TargetType="{x:Type TableCell}">
                    <Setter Property="BorderThickness" Value="0,0,0,1" />
                    <Setter Property="BorderBrush" Value="#1AFFFFFF" />
                    <Setter Property="Padding" Value="10,7" />
                    <Style.Triggers>
                        <DataTrigger Binding="{Binding RelativeSource={RelativeSource FindAncestor, AncestorType={x:Type TableRow}}, Path=Tag}" Value="EvenTableRow">
                            <Setter Property="Background" Value="#08FFFFFF" />
                        </DataTrigger>
                    </Style.Triggers>
                </Style>

                <Style TargetType="{x:Type Image}">
                    <Setter Property="RenderOptions.BitmapScalingMode" Value="HighQuality" />
                </Style>
            </Style.Resources>
        </Style>
    </UserControl.Resources>

    <!-- Root Grid (Zero outer padding so hairline separator runs border-to-border like Notepad) -->
    <Grid Tag="InteractiveControl">
        <Grid.RowDefinitions>
            <!-- Row 0: Top Action Bar (Tabs on left, Toggle + SplitButton on right) -->
            <RowDefinition Height="38" />
            <!-- Row 1: Border-to-Border Hairline Separator (Identical to Notepad) -->
            <RowDefinition Height="Auto" />
            <!-- Row 2: Content Area (Write or Preview) -->
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <!-- ========================================================================= -->
        <!-- ROW 0: TOP ACTION BAR (TABS ON LEFT, TOGGLE + SPLITBUTTON ON RIGHT)       -->
        <!-- ========================================================================= -->
        <Grid Grid.Row="0" Margin="0,0,10,0">
            <Grid.ColumnDefinitions>
                <!-- Left: Scrollable Tabs with + button -->
                <ColumnDefinition Width="*" />
                <!-- Right: Toggle Mode + Save SplitButton -->
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>

            <!-- 1. Horizontal Scrollable Tab Strip -->
            <controls:WidgetTabStrip Grid.Column="0"
                                     ItemsSource="{Binding Tabs}"
                                     SelectedItem="{Binding CurrentTab, Mode=TwoWay}"
                                     AddTabCommand="{Binding NewTabCommand}"
                                     CloseTabCommand="{Binding CloseTabCommand}"
                                     MaxTabs="10"
                                     VerticalAlignment="Stretch"
                                     Margin="0,0,8,0" />

            <!-- 2. Right Action Controls Group -->
            <StackPanel Grid.Column="1"
                        Orientation="Horizontal"
                        VerticalAlignment="Center">

                <!-- Dynamic Mode Toggle Button (Edit ⟷ Preview) -->
                <Button Style="{StaticResource FluentGhostButtonStyle}"
                        Width="28" Height="28"
                        Command="{Binding ToggleModeCommand}"
                        ToolTip="{Binding ModeToggleToolTip}"
                        Focusable="False"
                        Margin="0,0,4,0"
                        Tag="InteractiveControl">
                    <ui:SymbolIcon Symbol="{Binding ModeToggleSymbol}"
                                   FontSize="14"
                                   Foreground="{DynamicResource TextMutedBrush}" />
                </Button>

                <!-- More Actions Menu Button (···) -->
                <Button x:Name="MoreMenuButton"
                        Style="{StaticResource FluentGhostButtonStyle}"
                        Width="28" Height="28"
                        ToolTip="More actions"
                        Focusable="False"
                        Click="MoreMenuButton_Click"
                        Tag="InteractiveControl">
                    <ui:SymbolIcon Symbol="MoreHorizontal24"
                                   FontSize="15"
                                   Foreground="{DynamicResource TextMutedBrush}" />
                    <Button.ContextMenu>
                        <ContextMenu>
                            <MenuItem Header="Save"
                                      Command="{Binding SaveCommand}"
                                      InputGestureText="Ctrl+S">
                                <MenuItem.Icon>
                                    <ui:SymbolIcon Symbol="Save24" FontSize="14" />
                                </MenuItem.Icon>
                            </MenuItem>
                            <MenuItem Header="Save As..."
                                      Command="{Binding SaveAsCommand}"
                                      InputGestureText="Ctrl+Shift+S">
                                <MenuItem.Icon>
                                    <ui:SymbolIcon Symbol="SaveCopy24" FontSize="14" />
                                </MenuItem.Icon>
                            </MenuItem>
                            <MenuItem Header="Open File..."
                                      Command="{Binding OpenMarkdownFileCommand}"
                                      InputGestureText="Ctrl+O">
                                <MenuItem.Icon>
                                    <ui:SymbolIcon Symbol="FolderOpen24" FontSize="14" />
                                </MenuItem.Icon>
                            </MenuItem>
                            <Separator />
                            <MenuItem Header="New Tab"
                                      Command="{Binding NewTabCommand}"
                                      InputGestureText="Ctrl+T">
                                <MenuItem.Icon>
                                    <ui:SymbolIcon Symbol="Add24" FontSize="14" />
                                </MenuItem.Icon>
                            </MenuItem>
                            <MenuItem Header="Close Tab"
                                      Command="{Binding CloseTabCommand}"
                                      CommandParameter="{Binding CurrentTab}"
                                      InputGestureText="Ctrl+W">
                                <MenuItem.Icon>
                                    <ui:SymbolIcon Symbol="Dismiss24" FontSize="14" />
                                </MenuItem.Icon>
                            </MenuItem>
                            <MenuItem Header="Close Other Tabs"
                                      Command="{Binding CloseOtherTabsCommand}"
                                      CommandParameter="{Binding CurrentTab}">
                                <MenuItem.Icon>
                                    <ui:SymbolIcon Symbol="DismissCircle24" FontSize="14" />
                                </MenuItem.Icon>
                            </MenuItem>
                            <Separator />
                            <MenuItem Header="Copy Markdown"
                                      Command="{Binding CopyMarkdownCommand}">
                                <MenuItem.Icon>
                                    <ui:SymbolIcon Symbol="Copy24" FontSize="14" />
                                </MenuItem.Icon>
                            </MenuItem>
                            <MenuItem Header="Reveal in File Explorer"
                                      Command="{Binding RevealInExplorerCommand}">
                                <MenuItem.Icon>
                                    <ui:SymbolIcon Symbol="Folder24" FontSize="14" />
                                </MenuItem.Icon>
                            </MenuItem>
                        </ContextMenu>
                    </Button.ContextMenu>
                </Button>
            </StackPanel>
        </Grid>

        <!-- ========================================================================= -->
        <!-- ROW 1: HAIRLINE SEPARATOR (IDENTICAL TO NOTEPAD WIDGET)                   -->
        <!-- Runs border-to-border (100% full width, zero margin)                      -->
        <!-- ========================================================================= -->
        <Border Grid.Row="1"
                Style="{StaticResource WidgetHairlineDividerStyle}" />

        <!-- ========================================================================= -->
        <!-- ROW 2: CONTENT AREA (WRITE OR PREVIEW)                                    -->
        <!-- Padded 14px horizontally away from edges (Notepad alignment)              -->
        <!-- ========================================================================= -->
        <Grid Grid.Row="2" Margin="14,10,14,12" Tag="InteractiveControl">
            <!-- WRITE MODE -->
            <Grid Visibility="{Binding IsWriteTab, Converter={StaticResource BoolToVis}}" Tag="InteractiveControl">
                <TextBox x:Name="MarkdownEditor"
                         Style="{StaticResource MarkdownEditorStyle}"
                         Text="{Binding MarkdownText, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                         AcceptsReturn="True"
                         AcceptsTab="True"
                         TextWrapping="Wrap"
                         VerticalScrollBarVisibility="Auto"
                         HorizontalScrollBarVisibility="Disabled"
                         controls:AutoHideScrollBehavior.IsEnabled="True"
                         FocusVisualStyle="{x:Null}"
                         IsTabStop="False"
                         Tag="InteractiveControl" />

                <!-- Watermark Placeholder (Hidden immediately when typing) -->
                <TextBlock Text="Write markdown here..."
                           Foreground="{DynamicResource TextDisabledBrush}"
                           FontFamily="{DynamicResource AppMonoFontFamily}"
                           FontSize="{DynamicResource TypeMonoCodeFontSize}"
                           FontWeight="{DynamicResource TypeMonoCodeFontWeight}"
                           IsHitTestVisible="False"
                           Margin="10,6,0,0">
                    <TextBlock.Style>
                        <Style TargetType="TextBlock">
                            <Setter Property="Visibility" Value="Collapsed" />
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding Text, ElementName=MarkdownEditor}" Value="">
                                    <Setter Property="Visibility" Value="Visible" />
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </TextBlock.Style>
                </TextBlock>
            </Grid>

            <!-- PREVIEW MODE -->
            <Grid Visibility="{Binding IsReadTab, Converter={StaticResource BoolToVis}}">
                <!-- Loading state -->
                <TextBlock Text="Rendering…"
                           Foreground="{DynamicResource TextDisabledBrush}"
                           FontSize="{DynamicResource TypeBodyFontSize}"
                           FontWeight="{DynamicResource TypeBodyFontWeight}"
                           HorizontalAlignment="Center"
                           VerticalAlignment="Center">
                    <TextBlock.Style>
                        <Style TargetType="TextBlock">
                            <Setter Property="Visibility" Value="Collapsed" />
                            <Style.Triggers>
                                <MultiDataTrigger>
                                    <MultiDataTrigger.Conditions>
                                        <Condition Binding="{Binding HasRendered}" Value="False" />
                                        <Condition Binding="{Binding IsPreviewBlocked}" Value="False" />
                                    </MultiDataTrigger.Conditions>
                                    <Setter Property="Visibility" Value="Visible" />
                                </MultiDataTrigger>
                            </Style.Triggers>
                        </Style>
                    </TextBlock.Style>
                </TextBlock>

                <!-- Blocked / Error state -->
                <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center"
                            Visibility="{Binding IsPreviewBlocked, Converter={StaticResource BoolToVis}}">
                    <ui:SymbolIcon Symbol="DocumentError24" FontSize="26" Foreground="{DynamicResource TextSubtleBrush}" HorizontalAlignment="Center" />
                    <TextBlock Text="{Binding BlockedReason}"
                               Foreground="{DynamicResource TextMutedBrush}"
                               FontSize="{DynamicResource TypeCaptionFontSize}"
                               FontWeight="{DynamicResource TypeCaptionFontWeight}"
                               TextAlignment="Center"
                               TextWrapping="Wrap"
                               Margin="0,8,0,0"
                               MaxWidth="320" />
                </StackPanel>

                <!-- Rendered FlowDocument -->
                <FlowDocumentScrollViewer Style="{StaticResource MarkdownReaderStyle}"
                                          Document="{Binding RenderedDocument}"
                                          VerticalScrollBarVisibility="Auto"
                                          HorizontalScrollBarVisibility="Disabled"
                                          controls:AutoHideScrollBehavior.IsEnabled="True"
                                          FocusVisualStyle="{x:Null}"
                                          IsTabStop="False" />
            </Grid>

            <!-- Subtle Status Line (Notifications & warnings) -->
            <TextBlock Text="{Binding StatusMessage}"
                       Foreground="{DynamicResource StatusErrorBrush}"
                       FontSize="{DynamicResource TypeCaptionFontSize}"
                       FontWeight="{DynamicResource TypeCaptionFontWeight}"
                       HorizontalAlignment="Center"
                       VerticalAlignment="Bottom"
                       Margin="0,0,0,2"
                       IsHitTestVisible="False">
                <TextBlock.Style>
                    <Style TargetType="TextBlock">
                        <Setter Property="Visibility" Value="Visible" />
                        <Style.Triggers>
                            <DataTrigger Binding="{Binding StatusMessage}" Value="">
                                <Setter Property="Visibility" Value="Collapsed" />
                            </DataTrigger>
                            <DataTrigger Binding="{Binding StatusMessage}" Value="{x:Null}">
                                <Setter Property="Visibility" Value="Collapsed" />
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </TextBlock.Style>
            </TextBlock>
        </Grid>
    </Grid>
</UserControl>