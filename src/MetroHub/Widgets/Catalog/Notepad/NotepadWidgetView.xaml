<UserControl x:Class="MetroHub.Widgets.Catalog.Notepad.NotepadWidgetView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
             xmlns:widgets="clr-namespace:MetroHub.Widgets"
             xmlns:notepad="clr-namespace:MetroHub.Widgets.Catalog.Notepad"
             xmlns:controls="clr-namespace:MetroHub.Presentation.Controls"
             mc:Ignorable="d" 
             d:DataContext="{d:DesignInstance Type=notepad:NotepadWidgetViewModel}"
             Focusable="False"
             FontFamily="{DynamicResource AppFontFamily}">

    <UserControl.Resources>
        <!-- Circular Todo Checkbox with Solid Fill (Zero Banding, Zero Transparency) -->
        <Style x:Key="CircleTodoCheckBoxStyle" TargetType="{x:Type CheckBox}">
            <Setter Property="FocusVisualStyle" Value="{x:Null}" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="{x:Type CheckBox}">
                        <Border x:Name="CheckRing"
                                Width="20" Height="20"
                                CornerRadius="10"
                                BorderThickness="1.5"
                                BorderBrush="{DynamicResource TextSecondaryBrush}"
                                Background="{TemplateBinding Background}"
                                HorizontalAlignment="Center"
                                VerticalAlignment="Center"
                                SnapsToDevicePixels="True">
                            <ui:SymbolIcon x:Name="CheckMark"
                                           Symbol="Checkmark24"
                                           FontSize="11"
                                           Foreground="#FFFFFF"
                                           Visibility="Collapsed"
                                           HorizontalAlignment="Center"
                                           VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="CheckRing" Property="BorderBrush" Value="{DynamicResource SystemAccentColorSolidBrush}" />
                            </Trigger>
                            <Trigger Property="IsKeyboardFocused" Value="True">
                                <Setter TargetName="CheckRing" Property="BorderBrush" Value="{DynamicResource SystemAccentColorSolidBrush}" />
                            </Trigger>
                            <Trigger Property="IsChecked" Value="True">
                                <Setter TargetName="CheckRing" Property="Background" Value="{DynamicResource SystemAccentColorSolidBrush}" />
                                <Setter TargetName="CheckRing" Property="BorderThickness" Value="0" />
                                <Setter TargetName="CheckMark" Property="Visibility" Value="Visible" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- History Todo Checkbox Style using &#xE930; glyph (No blue color, clean theme glyph) -->
        <Style x:Key="HistoryTodoCheckBoxStyle" TargetType="{x:Type CheckBox}">
            <Setter Property="FocusVisualStyle" Value="{x:Null}" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="{x:Type CheckBox}">
                        <Border Width="20" Height="20"
                                Background="Transparent"
                                HorizontalAlignment="Center"
                                VerticalAlignment="Center">
                            <TextBlock x:Name="HistoryGlyph"
                                       Text="&#xE930;"
                                       FontFamily="{DynamicResource AppIconFontFamily}"
                                       FontSize="16"
                                       Foreground="{DynamicResource TextSecondaryBrush}"
                                       HorizontalAlignment="Center"
                                       VerticalAlignment="Center"
                                       SnapsToDevicePixels="True" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="HistoryGlyph" Property="Foreground" Value="{DynamicResource TextPrimaryBrush}" />
                            </Trigger>
                            <Trigger Property="IsKeyboardFocused" Value="True">
                                <Setter TargetName="HistoryGlyph" Property="Foreground" Value="{DynamicResource TextPrimaryBrush}" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Cohesive Todo Card Style for all rows -->
        <Style x:Key="TodoItemCardStyle" TargetType="{x:Type Border}">
            <Setter Property="Background" Value="{DynamicResource FluentHoverBrush}" />
            <Setter Property="BorderBrush" Value="{DynamicResource SurfaceBorderSubtleBrush}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="CornerRadius" Value="{DynamicResource ControlCornerRadius}" />
            <Setter Property="Padding" Value="12,9" />
            <Setter Property="Margin" Value="0,0,0,6" />
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Background" Value="{DynamicResource SurfaceGlassBrush}" />
                    <Setter Property="BorderBrush" Value="{DynamicResource SurfaceBorderBrush}" />
                </Trigger>
                <Trigger Property="IsKeyboardFocusWithin" Value="True">
                    <Setter Property="Background" Value="{DynamicResource SurfaceGlassBrush}" />
                    <Setter Property="BorderBrush" Value="{DynamicResource SurfaceBorderBrush}" />
                </Trigger>
            </Style.Triggers>
        </Style>
    </UserControl.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <!-- Row 0: Top Action Strip -->
            <RowDefinition Height="Auto" />
            <!-- Row 1: Hairline Separator -->
            <RowDefinition Height="Auto" />
            <!-- Row 2: Editor / Todo Content Area -->
            <RowDefinition Height="*" />
            <!-- Row 3: Docked Bottom Bar -->
            <RowDefinition Height="28" />
        </Grid.RowDefinitions>

        <!-- Row 0: Top Action Strip Centered with Symmetrical Divider -->
        <StackPanel Grid.Row="0"
                    Orientation="Horizontal"
                    HorizontalAlignment="Center"
                    Margin="20,10,20,6">
            <!-- Numbered List (Clean 1 2 3 glyph sized to match) -->
            <Button Style="{StaticResource WidgetMicroButtonStyle}"
                    Width="34" Height="32"
                    Focusable="False"
                    Click="OnToggleNumberingClick"
                    ToolTip="Numbered List"
                    Margin="0,0,4,0">
                <ui:SymbolIcon x:Name="NumberListIcon"
                               Symbol="TextNumberListLtr24"
                               FontSize="19"
                               Foreground="{DynamicResource TextPrimaryBrush}"
                               HorizontalAlignment="Center"
                               VerticalAlignment="Center" />
            </Button>

            <!-- Bullet List (&#xE8FD; glyph sized to match) -->
            <Button Style="{StaticResource WidgetMicroButtonStyle}"
                    Width="34" Height="32"
                    Focusable="False"
                    Click="OnToggleBulletsClick"
                    ToolTip="Bullet List"
                    Margin="0,0,4,0">
                <TextBlock x:Name="BulletListIcon"
                           Text="&#xF2C7;"
                           FontFamily="{DynamicResource AppIconFontFamily}"
                           FontSize="17"
                           Foreground="{DynamicResource TextPrimaryBrush}"
                           HorizontalAlignment="Center"
                           VerticalAlignment="Center" />
            </Button>

            <!-- Todo Mode (CheckmarkCircle32) -->
            <Button Style="{StaticResource WidgetMicroButtonStyle}"
                    Width="34" Height="32"
                    Focusable="False"
                    Command="{Binding ToggleTodoModeCommand}"
                    ToolTip="Toggle To-Do Mode"
                    Margin="0,0,6,0">
                <ui:SymbolIcon Symbol="CheckmarkCircle32"
                               FontSize="18"
                               HorizontalAlignment="Center"
                               VerticalAlignment="Center">
                    <ui:SymbolIcon.Style>
                        <Style TargetType="{x:Type ui:SymbolIcon}">
                            <Setter Property="Foreground" Value="{DynamicResource TextPrimaryBrush}" />
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding IsTodoMode}" Value="True">
                                     <Setter Property="Foreground" Value="{DynamicResource SystemAccentColorSolidBrush}" />
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </ui:SymbolIcon.Style>
                </ui:SymbolIcon>
            </Button>

            <!-- Vertical Toolbar Divider after Todo (Design System §9.1) -->
            <Border Width="1"
                    Height="16"
                    Background="{DynamicResource WidgetDividerBrush}"
                    VerticalAlignment="Center"
                    Margin="2,0,8,0"
                    SnapsToDevicePixels="True" />

            <!-- Bold (&#xE8DD;) -->
            <Button Style="{StaticResource WidgetMicroButtonStyle}"
                    Width="34" Height="32"
                    Focusable="False"
                    Click="OnToggleBoldClick"
                    ToolTip="Bold (Ctrl+B)"
                    Margin="0,0,4,0">
                <TextBlock x:Name="BoldIcon"
                           Text="&#xE8DD;"
                           FontFamily="{DynamicResource AppIconFontFamily}"
                           FontSize="16"
                           Foreground="{DynamicResource TextPrimaryBrush}"
                           HorizontalAlignment="Center"
                           VerticalAlignment="Center" />
            </Button>

            <!-- Italic (&#xE8DB;) -->
            <Button Style="{StaticResource WidgetMicroButtonStyle}"
                    Width="34" Height="32"
                    Focusable="False"
                    Click="OnToggleItalicClick"
                    ToolTip="Italic (Ctrl+I)"
                    Margin="0,0,4,0">
                <TextBlock x:Name="ItalicIcon"
                           Text="&#xE8DB;"
                           FontFamily="{DynamicResource AppIconFontFamily}"
                           FontSize="16"
                           Foreground="{DynamicResource TextPrimaryBrush}"
                           HorizontalAlignment="Center"
                           VerticalAlignment="Center" />
            </Button>

            <!-- Underline (&#xE8DC;) -->
            <Button Style="{StaticResource WidgetMicroButtonStyle}"
                    Width="34" Height="32"
                    Focusable="False"
                    Click="OnToggleUnderlineClick"
                    ToolTip="Underline (Ctrl+U)"
                    Margin="0,0,4,0">
                <TextBlock x:Name="UnderlineIcon"
                           Text="&#xE8DC;"
                           FontFamily="{DynamicResource AppIconFontFamily}"
                           FontSize="16"
                           Foreground="{DynamicResource TextPrimaryBrush}"
                           HorizontalAlignment="Center"
                           VerticalAlignment="Center" />
            </Button>

            <!-- Word Wrap (TextWrap24) -->
            <Button Style="{StaticResource WidgetMicroButtonStyle}"
                    Width="34" Height="32"
                    Focusable="False"
                    Command="{Binding ToggleWordWrapCommand}"
                    ToolTip="Toggle Word Wrap">
                <ui:SymbolIcon Symbol="TextWrap24" FontSize="19">
                    <ui:SymbolIcon.Style>
                        <Style TargetType="{x:Type ui:SymbolIcon}">
                            <Setter Property="Foreground" Value="{DynamicResource TextPrimaryBrush}" />
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding IsWordWrapEnabled}" Value="True">
                                    <Setter Property="Foreground" Value="{DynamicResource SystemAccentColorSolidBrush}" />
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </ui:SymbolIcon.Style>
                </ui:SymbolIcon>
            </Button>
        </StackPanel>

        <!-- Row 1: Universal 2px Edge-to-Edge Hairline Divider -->
        <Border Grid.Row="1"
                Height="2"
                CornerRadius="1"
                Background="{DynamicResource WidgetDividerBrush}"
                SnapsToDevicePixels="True"
                Margin="0" />

        <!-- Row 2: Content Area (Notes Mode or Todo Mode) -->
        <Grid Grid.Row="2" Margin="20,8,20,8">
            <!-- Mode 1: Notes Free-Form Rich Editor with "Write here" placeholder -->
            <Grid Visibility="{Binding IsNotesMode, Converter={StaticResource BoolToVis}}">
                <RichTextBox x:Name="EditorBox"
                             Background="Transparent"
                             BorderThickness="0"
                             Foreground="{DynamicResource TextPrimaryBrush}"
                             CaretBrush="{DynamicResource TextPrimaryBrush}"
                             FontFamily="{DynamicResource AppFontFamily}"
                             FontSize="{DynamicResource TypeBodyFontSize}"
                             Padding="0,2"
                             AcceptsTab="True"
                             VerticalScrollBarVisibility="Auto"
                             HorizontalScrollBarVisibility="Disabled"
                             controls:AutoHideScrollBehavior.IsEnabled="True"
                             PreviewMouseWheel="OnEditorPreviewMouseWheel">
                    <RichTextBox.Document>
                        <FlowDocument PagePadding="0"
                                      Background="Transparent"
                                      Foreground="{DynamicResource TextPrimaryBrush}"
                                      FontFamily="{DynamicResource AppFontFamily}"
                                      FontSize="{DynamicResource TypeBodyFontSize}">
                            <FlowDocument.Resources>
                                <Style TargetType="{x:Type List}">
                                    <Setter Property="Margin" Value="28,2,0,2" />
                                    <Setter Property="Padding" Value="0" />
                                    <Setter Property="MarkerOffset" Value="6" />
                                </Style>
                                <Style TargetType="{x:Type ListItem}">
                                    <Setter Property="Margin" Value="0,1,0,1" />
                                    <Setter Property="Padding" Value="0" />
                                </Style>
                                <Style TargetType="{x:Type Paragraph}">
                                    <Setter Property="Margin" Value="0,1,0,1" />
                                </Style>
                            </FlowDocument.Resources>
                            <Paragraph Margin="0" />
                        </FlowDocument>
                    </RichTextBox.Document>
                </RichTextBox>

                <!-- Watermark / Placeholder "Write here" with 2px caret offset -->
                <TextBlock x:Name="PlaceholderText"
                           Text="Write here"
                           FontSize="{DynamicResource TypeBodyFontSize}"
                           FontFamily="{DynamicResource AppFontFamily}"
                           Foreground="{DynamicResource TextDisabledBrush}"
                           Margin="2,2,0,0"
                           IsHitTestVisible="False"
                           Visibility="Collapsed" />
            </Grid>

            <!-- Mode 2A: Active Todo Tasks (Fully Cohesive Card Layout) -->
            <Grid Visibility="{Binding IsActiveTodoView, Converter={StaticResource BoolToVis}}">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                </Grid.RowDefinitions>

                <!-- Cohesive Add Task Row: Styled identically to a task card with matching empty ring and seamless borderless input -->
                <Border Grid.Row="0"
                        Style="{StaticResource TodoItemCardStyle}">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>

                        <!-- Subtle empty circular ring matching task checkboxes -->
                        <Border Grid.Column="0"
                                Width="20" Height="20"
                                CornerRadius="10"
                                BorderThickness="1.5"
                                BorderBrush="{DynamicResource TextSecondaryBrush}"
                                Opacity="0.4"
                                Background="Transparent"
                                VerticalAlignment="Center"
                                Margin="0,0,10,0" />

                        <!-- Seamless Inline Task Input with matching baseline and centered caret -->
                        <Grid Grid.Column="1" Height="20" VerticalAlignment="Center">
                            <TextBox x:Name="NewTaskInput"
                                     Text="{Binding NewTodoText, UpdateSourceTrigger=PropertyChanged}"
                                     FontSize="{DynamicResource TypeBodyFontSize}"
                                     FontFamily="{DynamicResource AppFontFamily}"
                                     Foreground="{DynamicResource TextPrimaryBrush}"
                                     CaretBrush="{DynamicResource TextPrimaryBrush}"
                                     Background="Transparent"
                                     BorderThickness="0"
                                     Padding="0"
                                     Height="20"
                                     VerticalAlignment="Center"
                                     VerticalContentAlignment="Center"
                                     FocusVisualStyle="{x:Null}"
                                     Tag="InteractiveControl">
                                <TextBox.Template>
                                    <ControlTemplate TargetType="{x:Type TextBox}">
                                        <ScrollViewer x:Name="PART_ContentHost"
                                                      Focusable="False"
                                                      VerticalAlignment="Center"
                                                      VerticalContentAlignment="Center"
                                                      HorizontalScrollBarVisibility="Hidden"
                                                      VerticalScrollBarVisibility="Hidden" />
                                    </ControlTemplate>
                                </TextBox.Template>
                                <TextBox.InputBindings>
                                    <KeyBinding Key="Return" Command="{Binding AddTodoCommand}" />
                                </TextBox.InputBindings>
                            </TextBox>
                            <TextBlock Text="Add a task (press Enter)..."
                                       FontSize="{DynamicResource TypeBodyFontSize}"
                                       FontFamily="{DynamicResource AppFontFamily}"
                                       Foreground="{DynamicResource TextDisabledBrush}"
                                       VerticalAlignment="Center"
                                       Height="20"
                                       IsHitTestVisible="False"
                                       Margin="2,0,0,0">
                                <TextBlock.Style>
                                    <Style TargetType="TextBlock">
                                        <Setter Property="Visibility" Value="Collapsed" />
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding Text, ElementName=NewTaskInput}" Value="">
                                                <Setter Property="Visibility" Value="Visible" />
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </TextBlock.Style>
                            </TextBlock>
                        </Grid>
                    </Grid>
                </Border>

                <!-- Active Tasks Scrollable List -->
                <ScrollViewer Grid.Row="1"
                              VerticalScrollBarVisibility="Auto"
                              HorizontalScrollBarVisibility="Disabled"
                              controls:AutoHideScrollBehavior.IsEnabled="True">
                    <ItemsControl ItemsSource="{Binding ActiveTodos}">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Border x:Name="ItemCard" Style="{StaticResource TodoItemCardStyle}">
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="Auto" />
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="Auto" />
                                        </Grid.ColumnDefinitions>

                                        <!-- Circular Radio-like CheckBox -->
                                        <CheckBox Grid.Column="0"
                                                  Style="{StaticResource CircleTodoCheckBoxStyle}"
                                                  IsChecked="{Binding IsCompleted, Mode=TwoWay}"
                                                  Command="{Binding DataContext.ToggleTodoCompletionCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                  CommandParameter="{Binding}"
                                                  VerticalAlignment="Center"
                                                  Margin="0,0,10,0"
                                                  Tag="InteractiveControl" />

                                        <!-- Task Text & In-Place Editing -->
                                        <Grid Grid.Column="1" Background="Transparent" VerticalAlignment="Center">
                                            <Grid.InputBindings>
                                                <MouseBinding Gesture="LeftDoubleClick"
                                                              Command="{Binding DataContext.BeginEditTodoCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                              CommandParameter="{Binding}" />
                                            </Grid.InputBindings>

                                            <!-- Display Mode -->
                                            <TextBlock x:Name="TaskText"
                                                       Text="{Binding Text}"
                                                       VerticalAlignment="Center"
                                                       FontSize="{DynamicResource TypeBodyFontSize}"
                                                       FontFamily="{DynamicResource AppFontFamily}"
                                                       Foreground="{DynamicResource TextPrimaryBrush}"
                                                       TextWrapping="Wrap"
                                                       Cursor="IBeam" />

                                            <!-- Inline Edit Mode -->
                                            <TextBox x:Name="TaskEditBox"
                                                     Text="{Binding Text, UpdateSourceTrigger=PropertyChanged}"
                                                     FontSize="{DynamicResource TypeBodyFontSize}"
                                                     FontFamily="{DynamicResource AppFontFamily}"
                                                     Foreground="{DynamicResource TextPrimaryBrush}"
                                                     CaretBrush="{DynamicResource TextPrimaryBrush}"
                                                     Background="Transparent"
                                                     BorderThickness="0"
                                                     Padding="0"
                                                     VerticalAlignment="Center"
                                                     FocusVisualStyle="{x:Null}"
                                                     Visibility="Collapsed"
                                                     IsVisibleChanged="OnTaskEditBoxIsVisibleChanged"
                                                     LostFocus="OnTaskEditBoxLostFocus"
                                                     Tag="InteractiveControl">
                                                <TextBox.Template>
                                                    <ControlTemplate TargetType="{x:Type TextBox}">
                                                        <ScrollViewer x:Name="PART_ContentHost"
                                                                      Focusable="False"
                                                                      VerticalAlignment="Center"
                                                                      HorizontalScrollBarVisibility="Hidden"
                                                                      VerticalScrollBarVisibility="Hidden" />
                                                    </ControlTemplate>
                                                </TextBox.Template>
                                                <TextBox.InputBindings>
                                                    <KeyBinding Key="Return"
                                                                Command="{Binding DataContext.CommitEditTodoCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                                CommandParameter="{Binding}" />
                                                    <KeyBinding Key="Escape"
                                                                Command="{Binding DataContext.CancelEditTodoCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                                CommandParameter="{Binding}" />
                                                </TextBox.InputBindings>
                                            </TextBox>
                                        </Grid>

                                        <!-- Actions: Edit and Delete Buttons (appear on hover) -->
                                        <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center">
                                            <Button x:Name="EditButton"
                                                    Style="{StaticResource WidgetMicroButtonStyle}"
                                                    Focusable="False"
                                                    Command="{Binding DataContext.BeginEditTodoCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                    CommandParameter="{Binding}"
                                                    Width="24" Height="24"
                                                    Opacity="0"
                                                    IsHitTestVisible="False"
                                                    ToolTip="Edit Task"
                                                    Margin="4,0,0,0">
                                                <ui:SymbolIcon Symbol="Edit16" FontSize="11" Foreground="{DynamicResource TextSecondaryBrush}" />
                                            </Button>

                                            <Button x:Name="DeleteButton"
                                                    Style="{StaticResource WidgetMicroButtonStyle}"
                                                    Focusable="False"
                                                    Command="{Binding DataContext.DeleteTodoCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                    CommandParameter="{Binding}"
                                                    Width="24" Height="24"
                                                    Opacity="0"
                                                    IsHitTestVisible="False"
                                                    ToolTip="Delete Task"
                                                    Margin="2,0,0,0">
                                                <ui:SymbolIcon Symbol="Dismiss16" FontSize="11" Foreground="{DynamicResource TextSecondaryBrush}" />
                                            </Button>
                                        </StackPanel>
                                    </Grid>
                                </Border>
                                <DataTemplate.Triggers>
                                    <Trigger SourceName="ItemCard" Property="IsMouseOver" Value="True">
                                        <Setter TargetName="EditButton" Property="Opacity" Value="0.7" />
                                        <Setter TargetName="EditButton" Property="IsHitTestVisible" Value="True" />
                                        <Setter TargetName="DeleteButton" Property="Opacity" Value="0.7" />
                                        <Setter TargetName="DeleteButton" Property="IsHitTestVisible" Value="True" />
                                    </Trigger>
                                    <Trigger SourceName="EditButton" Property="IsMouseOver" Value="True">
                                        <Setter TargetName="EditButton" Property="Opacity" Value="1.0" />
                                        <Setter TargetName="EditButton" Property="IsHitTestVisible" Value="True" />
                                    </Trigger>
                                    <Trigger SourceName="DeleteButton" Property="IsMouseOver" Value="True">
                                        <Setter TargetName="DeleteButton" Property="Opacity" Value="1.0" />
                                        <Setter TargetName="DeleteButton" Property="IsHitTestVisible" Value="True" />
                                    </Trigger>
                                    <DataTrigger Binding="{Binding IsEditing}" Value="True">
                                        <Setter TargetName="TaskText" Property="Visibility" Value="Collapsed" />
                                        <Setter TargetName="TaskEditBox" Property="Visibility" Value="Visible" />
                                        <Setter TargetName="EditButton" Property="Visibility" Value="Collapsed" />
                                    </DataTrigger>
                                </DataTemplate.Triggers>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </ScrollViewer>
            </Grid>

            <!-- Mode 2B: Completed Todo Tasks (History View) -->
            <ScrollViewer Visibility="{Binding IsHistoryTodoView, Converter={StaticResource BoolToVis}}"
                          VerticalScrollBarVisibility="Auto"
                          HorizontalScrollBarVisibility="Disabled"
                          controls:AutoHideScrollBehavior.IsEnabled="True">
                <ItemsControl ItemsSource="{Binding CompletedTodos}">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <Border x:Name="HistoryItemCard" Style="{StaticResource TodoItemCardStyle}">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto" />
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>

                                    <!-- History CheckBox with &#xE930; Glyph -->
                                    <CheckBox Grid.Column="0"
                                              Style="{StaticResource HistoryTodoCheckBoxStyle}"
                                              IsChecked="{Binding IsCompleted, Mode=TwoWay}"
                                              Command="{Binding DataContext.ToggleTodoCompletionCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                              CommandParameter="{Binding}"
                                              VerticalAlignment="Center"
                                              Margin="0,0,10,0"
                                              ToolTip="Mark active"
                                              Tag="InteractiveControl" />

                                    <!-- Strikethrough Task Text -->
                                    <TextBlock Grid.Column="1"
                                               Text="{Binding Text}"
                                               TextDecorations="Strikethrough"
                                               VerticalAlignment="Center"
                                               FontSize="{DynamicResource TypeBodyFontSize}"
                                               FontFamily="{DynamicResource AppFontFamily}"
                                               Foreground="{DynamicResource TextDisabledBrush}"
                                               TextWrapping="Wrap" />

                                    <!-- Delete Button: Hidden by default (Opacity 0), appears on hover -->
                                    <Button x:Name="HistoryDeleteButton"
                                            Grid.Column="2"
                                            Style="{StaticResource WidgetMicroButtonStyle}"
                                            Focusable="False"
                                            Command="{Binding DataContext.DeleteTodoCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                            CommandParameter="{Binding}"
                                            Width="24" Height="24"
                                            Opacity="0"
                                            IsHitTestVisible="False"
                                            ToolTip="Delete Task"
                                            Margin="4,0,0,0">
                                        <ui:SymbolIcon Symbol="Dismiss16" FontSize="11" Foreground="{DynamicResource TextSecondaryBrush}" />
                                    </Button>
                                </Grid>
                            </Border>
                            <DataTemplate.Triggers>
                                <Trigger SourceName="HistoryItemCard" Property="IsMouseOver" Value="True">
                                    <Setter TargetName="HistoryDeleteButton" Property="Opacity" Value="0.7" />
                                    <Setter TargetName="HistoryDeleteButton" Property="IsHitTestVisible" Value="True" />
                                </Trigger>
                                <Trigger SourceName="HistoryDeleteButton" Property="IsMouseOver" Value="True">
                                    <Setter TargetName="HistoryDeleteButton" Property="Opacity" Value="1.0" />
                                    <Setter TargetName="HistoryDeleteButton" Property="IsHitTestVisible" Value="True" />
                                </Trigger>
                            </DataTemplate.Triggers>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </ScrollViewer>
        </Grid>

        <!-- Row 3: Docked Bottom Bar -->
        <Border Grid.Row="3"
                Background="{DynamicResource SurfaceInsetWellBrush}"
                BorderThickness="0"
                CornerRadius="{DynamicResource ControlCornerRadiusBottom}"
                Padding="20,0,20,0">
            <Grid VerticalAlignment="Center">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <!-- Left Content: Metrics in Notes Mode vs History Navigation in Todo Mode -->
                <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center">
                    <!-- Word / Char count in Notes Mode -->
                    <StackPanel Orientation="Horizontal"
                                Visibility="{Binding IsNotesMode, Converter={StaticResource BoolToVis}}">
                        <TextBlock Text="{Binding WordCount}"
                                   FontSize="{DynamicResource TypeCaptionFontSize}"
                                   Foreground="{DynamicResource TextSecondaryBrush}" />
                        <TextBlock Text=" words | "
                                   FontSize="{DynamicResource TypeCaptionFontSize}"
                                   Foreground="{DynamicResource TextMutedBrush}" />
                        <TextBlock Text="{Binding CharCount}"
                                   FontSize="{DynamicResource TypeCaptionFontSize}"
                                   Foreground="{DynamicResource TextSecondaryBrush}" />
                        <TextBlock Text=" chars"
                                   FontSize="{DynamicResource TypeCaptionFontSize}"
                                   Foreground="{DynamicResource TextMutedBrush}" />
                    </StackPanel>

                    <!-- History Toggle Button in Active Todo View -->
                    <Button Style="{StaticResource WidgetMicroButtonStyle}"
                            Command="{Binding ToggleHistoryCommand}"
                            Visibility="{Binding IsActiveTodoView, Converter={StaticResource BoolToVis}}"
                            ToolTip="View Completed Tasks"
                            Width="Auto"
                            Padding="8,0"
                            VerticalAlignment="Center">
                        <StackPanel Orientation="Horizontal">
                            <ui:SymbolIcon Symbol="History24" FontSize="14" Margin="0,0,5,0" Foreground="{DynamicResource TextSecondaryBrush}" />
                            <TextBlock Text="{Binding CompletedCount, StringFormat='History ({0})'}"
                                       FontSize="{DynamicResource TypeCaptionFontSize}"
                                       Foreground="{DynamicResource TextSecondaryBrush}" />
                        </StackPanel>
                    </Button>

                    <!-- Back to Tasks Button in History View -->
                    <Button Style="{StaticResource WidgetMicroButtonStyle}"
                            Command="{Binding ToggleHistoryCommand}"
                            Visibility="{Binding IsHistoryTodoView, Converter={StaticResource BoolToVis}}"
                            ToolTip="Back to Active Tasks"
                            Width="Auto"
                            Padding="8,0"
                            VerticalAlignment="Center">
                        <StackPanel Orientation="Horizontal">
                            <ui:SymbolIcon Symbol="ArrowLeft24" FontSize="14" Margin="0,0,5,0" Foreground="{DynamicResource TextSecondaryBrush}" />
                            <TextBlock Text="Back to Tasks"
                                       FontSize="{DynamicResource TypeCaptionFontSize}"
                                       Foreground="{DynamicResource TextSecondaryBrush}" />
                        </StackPanel>
                    </Button>

                    <!-- Clear All Completed Tasks in History View -->
                    <Button Style="{StaticResource WidgetMicroButtonStyle}"
                            Command="{Binding ClearCompletedTodosCommand}"
                            Visibility="{Binding IsHistoryTodoView, Converter={StaticResource BoolToVis}}"
                            ToolTip="Clear all completed tasks"
                            Width="Auto"
                            Padding="8,0"
                            Margin="8,0,0,0"
                            VerticalAlignment="Center">
                        <StackPanel Orientation="Horizontal">
                            <ui:SymbolIcon Symbol="Delete24" FontSize="14" Margin="0,0,5,0" Foreground="{DynamicResource TextSecondaryBrush}" />
                            <TextBlock Text="Clear All"
                                       FontSize="{DynamicResource TypeCaptionFontSize}"
                                       Foreground="{DynamicResource TextSecondaryBrush}" />
                        </StackPanel>
                    </Button>
                </StackPanel>

                <!-- Right Content: Clean Saved Status Feedback with smooth 3-second fade out -->
                <TextBlock Grid.Column="1"
                           Text="{Binding SaveStatusText}"
                           FontSize="{DynamicResource TypeCaptionFontSize}"
                           Foreground="{DynamicResource TextSecondaryBrush}"
                           VerticalAlignment="Center"
                           HorizontalAlignment="Right">
                    <TextBlock.Style>
                        <Style TargetType="TextBlock">
                            <Setter Property="Opacity" Value="0" />
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding IsSaveStatusVisible}" Value="True">
                                    <DataTrigger.EnterActions>
                                        <BeginStoryboard>
                                            <Storyboard>
                                                <DoubleAnimation Storyboard.TargetProperty="Opacity"
                                                                 To="1.0" Duration="0:0:0.15" />
                                            </Storyboard>
                                        </BeginStoryboard>
                                    </DataTrigger.EnterActions>
                                    <DataTrigger.ExitActions>
                                        <BeginStoryboard>
                                            <Storyboard>
                                                <DoubleAnimation Storyboard.TargetProperty="Opacity"
                                                                 To="0.0" Duration="0:0:0.4" />
                                            </Storyboard>
                                        </BeginStoryboard>
                                    </DataTrigger.ExitActions>
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </TextBlock.Style>
                </TextBlock>
            </Grid>
        </Border>
    </Grid>
</UserControl>
