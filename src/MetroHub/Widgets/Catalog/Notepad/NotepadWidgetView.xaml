<UserControl x:Class="MetroHub.Widgets.Catalog.Notepad.NotepadWidgetView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:widgets="clr-namespace:MetroHub.Widgets"
             xmlns:notepad="clr-namespace:MetroHub.Widgets.Catalog.Notepad"
             xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
             mc:Ignorable="d" 
             d:DataContext="{d:DesignInstance Type=notepad:NotepadWidgetViewModel}"
             Focusable="False"
             FocusVisualStyle="{x:Null}"
             ClipToBounds="True"
             SnapsToDevicePixels="True"
             UseLayoutRounding="True"
             TextOptions.TextFormattingMode="Ideal"
             TextOptions.TextRenderingMode="Grayscale"
             TextOptions.TextHintingMode="Animated">

    <UserControl.Resources>
        <BooleanToVisibilityConverter x:Key="BoolToVis" />

        <!-- Strip default dotted focus rectangle across all controls in widget -->
        <Style TargetType="{x:Type Control}">
            <Setter Property="FocusVisualStyle" Value="{x:Null}" />
        </Style>

        <!-- Ultra-Slim 3px Fluent ScrollBar (Transparent track, no arrows, subtle pill thumb) -->
        <Style x:Key="FluentSlimScrollBarStyle" TargetType="{x:Type ScrollBar}">
            <Setter Property="OverridesDefaultStyle" Value="True" />
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="Width" Value="3" />
            <Setter Property="FocusVisualStyle" Value="{x:Null}" />
            <Setter Property="SnapsToDevicePixels" Value="True" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="{x:Type ScrollBar}">
                        <Track x:Name="PART_Track" IsDirectionReversed="True" Focusable="False">
                            <Track.Thumb>
                                <Thumb x:Name="Thumb" Focusable="False">
                                    <Thumb.Template>
                                        <ControlTemplate TargetType="{x:Type Thumb}">
                                            <Border x:Name="ThumbBorder"
                                                    Background="#55FFFFFF"
                                                    CornerRadius="1.5"
                                                    SnapsToDevicePixels="True" />
                                            <ControlTemplate.Triggers>
                                                <Trigger Property="IsMouseOver" Value="True">
                                                    <Setter TargetName="ThumbBorder" Property="Background" Value="#95FFFFFF" />
                                                </Trigger>
                                                <Trigger Property="IsDragging" Value="True">
                                                    <Setter TargetName="ThumbBorder" Property="Background" Value="#D0FFFFFF" />
                                                </Trigger>
                                            </ControlTemplate.Triggers>
                                        </ControlTemplate>
                                    </Thumb.Template>
                                </Thumb>
                            </Track.Thumb>
                        </Track>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Implicit ScrollBar Style to make all internal scrollbars slim -->
        <Style TargetType="{x:Type ScrollBar}" BasedOn="{StaticResource FluentSlimScrollBarStyle}" />

        <!-- Toolbar Icon Button Style (Borderless, subtle hover, no harsh opaque box) -->
        <Style x:Key="NotepadToolbarButtonStyle" TargetType="Button">
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="Foreground" Value="#B5FFFFFF" />
            <Setter Property="Width" Value="32" />
            <Setter Property="Height" Value="28" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Focusable" Value="False" />
            <Setter Property="FocusVisualStyle" Value="{x:Null}" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Border"
                                Background="{TemplateBinding Background}"
                                CornerRadius="4"
                                SnapsToDevicePixels="True">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Border" Property="Background" Value="#18FFFFFF" />
                                <Setter Property="Foreground" Value="#FFFFFF" />
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="Border" Property="Background" Value="#2AFFFFFF" />
                                <Setter Property="Foreground" Value="#FFFFFF" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Microsoft To-Do Circular Checkbox Button Style -->
        <Style x:Key="CircularTodoCheckboxStyle" TargetType="Button">
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="Width" Value="18" />
            <Setter Property="Height" Value="18" />
            <Setter Property="Padding" Value="0" />
            <Setter Property="Margin" Value="0" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Focusable" Value="False" />
            <Setter Property="FocusVisualStyle" Value="{x:Null}" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="RingBorder"
                                Width="18"
                                Height="18"
                                CornerRadius="9"
                                BorderThickness="1.5"
                                BorderBrush="#60FFFFFF"
                                Background="Transparent"
                                SnapsToDevicePixels="True">
                            <TextBlock x:Name="CheckIcon"
                                       Text="&#xE73E;"
                                       FontFamily="Segoe Fluent Icons, Segoe MDL2 Assets"
                                       FontSize="9"
                                       Foreground="#FFFFFF"
                                       HorizontalAlignment="Center"
                                       VerticalAlignment="Center"
                                       Visibility="Collapsed" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="RingBorder" Property="BorderBrush" Value="#A5FFFFFF" />
                                <Setter TargetName="RingBorder" Property="Background" Value="#10FFFFFF" />
                            </Trigger>
                            <DataTrigger Binding="{Binding IsCompleted}" Value="True">
                                <Setter TargetName="RingBorder" Property="Background" Value="#25FFFFFF" />
                                <Setter TargetName="RingBorder" Property="BorderBrush" Value="#35FFFFFF" />
                                <Setter TargetName="CheckIcon" Property="Visibility" Value="Visible" />
                            </DataTrigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Subtle Trash Can Delete Button on Hover -->
        <Style x:Key="TodoDeleteButtonStyle" TargetType="Button">
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="Foreground" Value="#50FFFFFF" />
            <Setter Property="Width" Value="24" />
            <Setter Property="Height" Value="24" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Focusable" Value="False" />
            <Setter Property="FocusVisualStyle" Value="{x:Null}" />
            <Setter Property="Opacity" Value="0.4" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="DeleteBorder"
                                Background="{TemplateBinding Background}"
                                CornerRadius="4"
                                SnapsToDevicePixels="True">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter Property="Opacity" Value="1.0" />
                                <Setter TargetName="DeleteBorder" Property="Background" Value="#25FF453A" />
                                <Setter Property="Foreground" Value="#FF6B6B" />
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="DeleteBorder" Property="Background" Value="#45FF453A" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Notes Textbox Style -->
        <Style x:Key="NotesTextBoxStyle" TargetType="TextBox">
            <Setter Property="OverridesDefaultStyle" Value="True" />
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="Foreground" Value="#FFFFFF" />
            <Setter Property="CaretBrush" Value="#FFFFFF" />
            <Setter Property="SelectionBrush" Value="#503A86FF" />
            <Setter Property="SelectionOpacity" Value="0.6" />
            <Setter Property="FontSize" Value="15" />
            <Setter Property="FontFamily" Value="Segoe UI Variable Text, Segoe UI, sans-serif" />
            <Setter Property="FocusVisualStyle" Value="{x:Null}" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="TextBox">
                        <ScrollViewer x:Name="PART_ContentHost"
                                      Focusable="False"
                                      FocusVisualStyle="{x:Null}"
                                      HorizontalScrollBarVisibility="Hidden"
                                      VerticalScrollBarVisibility="Auto" />
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Clean To-Do Task Input TextBox Style (Overrides default WPF-UI styling to remove dark box and blue underline) -->
        <Style x:Key="CleanTaskTextBoxStyle" TargetType="TextBox">
            <Setter Property="OverridesDefaultStyle" Value="True" />
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="BorderBrush" Value="Transparent" />
            <Setter Property="Foreground" Value="#FFFFFF" />
            <Setter Property="CaretBrush" Value="#FFFFFF" />
            <Setter Property="SelectionBrush" Value="#503A86FF" />
            <Setter Property="SelectionOpacity" Value="0.6" />
            <Setter Property="FontSize" Value="13.5" />
            <Setter Property="FontFamily" Value="Segoe UI Variable Text, Segoe UI, sans-serif" />
            <Setter Property="FocusVisualStyle" Value="{x:Null}" />
            <Setter Property="VerticalContentAlignment" Value="Center" />
            <Setter Property="Padding" Value="0" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="TextBox">
                        <Border Background="Transparent"
                                BorderBrush="Transparent"
                                BorderThickness="0"
                                SnapsToDevicePixels="True">
                            <ScrollViewer x:Name="PART_ContentHost"
                                          Focusable="False"
                                          FocusVisualStyle="{x:Null}"
                                          VerticalAlignment="Center"
                                          HorizontalScrollBarVisibility="Hidden"
                                          VerticalScrollBarVisibility="Disabled"
                                          Padding="0"
                                          Margin="0" />
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </UserControl.Resources>

    <!-- Root Grid (Zero padding so separator runs border-to-border like Focus Timer & Volume) -->
    <Grid SnapsToDevicePixels="True" UseLayoutRounding="True" Tag="InteractiveControl">
        <Grid.RowDefinitions>
            <!-- Row 0: Centered Top Menu Toolbar -->
            <RowDefinition Height="Auto" />
            <!-- Row 1: Focus Timer-Identical Border-to-Border Hairline Separator -->
            <RowDefinition Height="Auto" />
            <!-- Row 2: Active Content Area (Notes or To-Do) -->
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

            <!-- ========================================================================= -->
            <!-- ROW 0: TOP CENTERED TOOLBAR (WPF-UI ICONS ONLY, CENTERED, NO TEXT)        -->
            <!-- ========================================================================= -->
            <Grid Grid.Row="0" Margin="0,7,0,7">
                <!-- Centered 3 Icons: Bullet List, Numbered List, To-Do Checklist -->
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" VerticalAlignment="Center">
                    <!-- 1. Bullet List Icon Button (WPF-UI Symbol: TextBulletListTree24) -->
                    <Button x:Name="BulletListButton"
                            Click="BulletListButton_Click"
                            ToolTip="Bullet List"
                            Margin="3,0">
                        <ui:SymbolIcon Symbol="TextBulletListTree24"
                                       FontSize="16"
                                       VerticalAlignment="Center"
                                       HorizontalAlignment="Center" />
                        <Button.Style>
                            <Style TargetType="Button" BasedOn="{StaticResource NotepadToolbarButtonStyle}">
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding IsBulletActiveInNotes}" Value="True">
                                        <Setter Property="Background" Value="#22FFFFFF" />
                                        <Setter Property="Foreground" Value="#FFFFFF" />
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </Button.Style>
                    </Button>

                    <!-- 2. Numbered List Icon Button (WPF-UI Symbol: TextNumberListLtr16) -->
                    <Button x:Name="NumberedListButton"
                            Click="NumberedListButton_Click"
                            ToolTip="Numbered List"
                            Margin="3,0">
                        <ui:SymbolIcon Symbol="TextNumberListLtr16"
                                       FontSize="16"
                                       VerticalAlignment="Center"
                                       HorizontalAlignment="Center" />
                        <Button.Style>
                            <Style TargetType="Button" BasedOn="{StaticResource NotepadToolbarButtonStyle}">
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding IsNumberedActiveInNotes}" Value="True">
                                        <Setter Property="Background" Value="#22FFFFFF" />
                                        <Setter Property="Foreground" Value="#FFFFFF" />
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </Button.Style>
                    </Button>

                    <!-- 3. To-Do List Icon Button (WPF-UI Symbol: CheckmarkCircle32) -->
                    <Button x:Name="TodoListButton"
                            Click="TodoListButton_Click"
                            ToolTip="To-Do Checklist"
                            Margin="3,0">
                        <ui:SymbolIcon Symbol="CheckmarkCircle32"
                                       FontSize="16"
                                       VerticalAlignment="Center"
                                       HorizontalAlignment="Center" />
                        <Button.Style>
                            <Style TargetType="Button" BasedOn="{StaticResource NotepadToolbarButtonStyle}">
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding IsTodoView}" Value="True">
                                        <Setter Property="Background" Value="#22FFFFFF" />
                                        <Setter Property="Foreground" Value="#FFFFFF" />
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </Button.Style>
                    </Button>
                </StackPanel>
            </Grid>

            <!-- ========================================================================= -->
            <!-- ROW 1: HAIRLINE SEPARATOR (IDENTICAL TO FOCUS TIMER & OTHER WIDGETS)      -->
            <!-- Runs border-to-border (100% full width, zero margin)                      -->
            <!-- ========================================================================= -->
            <Border Grid.Row="1"
                    Height="2"
                    HorizontalAlignment="Stretch"
                    Background="#14FFFFFF"
                    CornerRadius="1"
                    Margin="0"
                    SnapsToDevicePixels="True" />

            <!-- ========================================================================= -->
            <!-- ROW 2: CONTENT AREA (NOTES OR TO-DO)                                      -->
            <!-- Padded 14px horizontally away from edges                                  -->
            <!-- ========================================================================= -->
            <Grid Grid.Row="2" Margin="14,10,14,12" Tag="InteractiveControl">
                <!-- MODE 1: SIMPLE TEXT WRITING (NOTEPAD) -->
                <Grid Visibility="{Binding IsNotesView, Converter={StaticResource BoolToVis}}" Tag="InteractiveControl">
                    <TextBox x:Name="NotesEditorTextBox"
                             Style="{StaticResource NotesTextBoxStyle}"
                             Text="{Binding NoteText, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                             AcceptsReturn="True"
                             AcceptsTab="True"
                             TextWrapping="Wrap"
                             VerticalScrollBarVisibility="Auto"
                             HorizontalScrollBarVisibility="Disabled"
                             FocusVisualStyle="{x:Null}"
                             Tag="InteractiveControl"
                             PreviewKeyDown="NotesEditorTextBox_PreviewKeyDown"
                             GotKeyboardFocus="NotesEditorTextBox_GotKeyboardFocus" />

                    <!-- Watermark Placeholder (Hidden immediately when typing) -->
                    <TextBlock Text="Note it down, you know you'll forget"
                               Foreground="#35FFFFFF"
                               FontSize="15"
                               FontFamily="Segoe UI Variable Text, Segoe UI, sans-serif"
                               IsHitTestVisible="False"
                               Margin="4,2,0,0">
                        <TextBlock.Style>
                            <Style TargetType="TextBlock">
                                <Setter Property="Visibility" Value="Collapsed" />
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding Text, ElementName=NotesEditorTextBox}" Value="">
                                        <Setter Property="Visibility" Value="Visible" />
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </TextBlock.Style>
                    </TextBlock>
                </Grid>

                <!-- MODE 2: TO-DO CHECKLIST (CLEAN DESIGN MATCHING USER REFERENCE) -->
                <Grid Visibility="{Binding IsTodoView, Converter={StaticResource BoolToVis}}" Tag="InteractiveControl">
                    <Grid.RowDefinitions>
                        <!-- Row 0: Quick Task Input (Acrylic Pill) -->
                        <RowDefinition Height="Auto" />
                        <!-- Row 1: Floating Infinite Scrolling Tasks List (Zero Outer Box) -->
                        <RowDefinition Height="*" />
                        <!-- Row 2: Bottom Status & Clear Bar -->
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>

                    <!-- Microsoft To-Do Style Acrylic Input Bar -->
                    <Border Grid.Row="0"
                            Background="#14FFFFFF"
                            BorderBrush="#18FFFFFF"
                            BorderThickness="1"
                            CornerRadius="4"
                            Height="38"
                            Margin="0,0,0,10"
                            Padding="10,0,10,0"
                            Tag="InteractiveControl"
                            SnapsToDevicePixels="True">
                        <Grid VerticalAlignment="Center">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>

                            <!-- Hollow Circular Ring Indicator (18x18, vertically centered, matches tasks below) -->
                            <Border Grid.Column="0"
                                    Width="18"
                                    Height="18"
                                    CornerRadius="9"
                                    BorderThickness="1.5"
                                    BorderBrush="#60FFFFFF"
                                    Background="Transparent"
                                    Margin="0,0,10,0"
                                    VerticalAlignment="Center"
                                    SnapsToDevicePixels="True" />

                            <!-- Input TextBox & Non-Overlapping Watermark perfectly centered on horizontal axis -->
                            <Grid Grid.Column="1" VerticalAlignment="Center">
                                <TextBox x:Name="NewTaskTextBox"
                                         Style="{StaticResource CleanTaskTextBoxStyle}"
                                         Text="{Binding NewTaskText, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                         Tag="InteractiveControl"
                                         KeyDown="NewTaskTextBox_KeyDown"
                                         GotKeyboardFocus="NewTaskTextBox_GotKeyboardFocus" />

                                <!-- Watermark Placeholder with clean breathing room from caret -->
                                <TextBlock Text="Touch Grass"
                                           Foreground="#50FFFFFF"
                                           FontSize="13.5"
                                           FontFamily="Segoe UI Variable Text, Segoe UI, sans-serif"
                                           VerticalAlignment="Center"
                                           IsHitTestVisible="False"
                                           Padding="0"
                                           Margin="4,0,0,0">
                                    <TextBlock.Style>
                                        <Style TargetType="TextBlock">
                                            <Setter Property="Visibility" Value="Collapsed" />
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding Text, ElementName=NewTaskTextBox}" Value="">
                                                    <Setter Property="Visibility" Value="Visible" />
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </TextBlock.Style>
                                </TextBlock>
                            </Grid>
                        </Grid>
                    </Border>

                    <!-- Floating Infinite Scrolling Task Items (Clean transparent rows, zero ugly gray boxes) -->
                    <ScrollViewer Grid.Row="1"
                                  Focusable="False"
                                  FocusVisualStyle="{x:Null}"
                                  Tag="InteractiveControl"
                                  VerticalScrollBarVisibility="Auto"
                                  HorizontalScrollBarVisibility="Disabled"
                                  CanContentScroll="True">
                        <ItemsControl ItemsSource="{Binding Tasks}"
                                      Tag="InteractiveControl"
                                      VirtualizingPanel.IsVirtualizing="True"
                                      VirtualizingPanel.VirtualizationMode="Recycling"
                                      VirtualizingPanel.ScrollUnit="Pixel">
                            <ItemsControl.ItemsPanel>
                                <ItemsPanelTemplate>
                                    <VirtualizingStackPanel />
                                </ItemsPanelTemplate>
                            </ItemsControl.ItemsPanel>
                            <ItemsControl.ItemTemplate>
                                <DataTemplate DataType="{x:Type notepad:TodoTaskItem}">
                                    <Border CornerRadius="4"
                                            Margin="0,1,0,1"
                                            Padding="10,6,10,6"
                                            Background="Transparent"
                                            SnapsToDevicePixels="True">
                                        <Grid VerticalAlignment="Center">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="Auto" />
                                                <ColumnDefinition Width="*" />
                                                <ColumnDefinition Width="Auto" />
                                            </Grid.ColumnDefinitions>

                                            <!-- Circular Checkbox Button: 18x18, Margin="0,0,10,0" (100% aligned with input bar circle) -->
                                            <Button Grid.Column="0"
                                                    Style="{StaticResource CircularTodoCheckboxStyle}"
                                                    VerticalAlignment="Center"
                                                    Margin="0,0,10,0"
                                                    Command="{Binding DataContext.ToggleTaskCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                    CommandParameter="{Binding}"
                                                    ToolTip="Toggle Complete" />

                                            <!-- Task Text with Strikethrough Trigger -->
                                            <TextBlock Grid.Column="1"
                                                       Text="{Binding Text}"
                                                       TextWrapping="Wrap"
                                                       VerticalAlignment="Center"
                                                       Margin="0,0,8,0"
                                                       FontSize="14"
                                                       FontFamily="Segoe UI Variable Text, Segoe UI, sans-serif">
                                                <TextBlock.Style>
                                                    <Style TargetType="TextBlock">
                                                        <Setter Property="Foreground" Value="#FFFFFF" />
                                                        <Style.Triggers>
                                                            <DataTrigger Binding="{Binding IsCompleted}" Value="True">
                                                                <Setter Property="TextDecorations" Value="Strikethrough" />
                                                                <Setter Property="Foreground" Value="#50FFFFFF" />
                                                            </DataTrigger>
                                                        </Style.Triggers>
                                                    </Style>
                                                </TextBlock.Style>
                                            </TextBlock>

                                            <!-- Subtle Trash Can Delete Button on Hover -->
                                            <Button Grid.Column="2"
                                                    Style="{StaticResource TodoDeleteButtonStyle}"
                                                    VerticalAlignment="Center"
                                                    Command="{Binding DataContext.DeleteTaskCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                    CommandParameter="{Binding}"
                                                    ToolTip="Delete task">
                                                <TextBlock Text="&#xE74D;"
                                                           FontFamily="Segoe Fluent Icons, Segoe MDL2 Assets"
                                                           FontSize="12"
                                                           VerticalAlignment="Center"
                                                           HorizontalAlignment="Center" />
                                            </Button>
                                        </Grid>
                                    </Border>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </ScrollViewer>

                    <!-- Bottom Status Bar & Clear Completed Action -->
                    <Grid Grid.Row="2" Margin="2,8,2,0" Visibility="{Binding HasTasks, Converter={StaticResource BoolToVis}}">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>

                        <TextBlock Grid.Column="0"
                                   Text="{Binding TasksSummary}"
                                   Foreground="#50FFFFFF"
                                   FontSize="12"
                                   FontFamily="Segoe UI Variable Text, Segoe UI, sans-serif"
                                   VerticalAlignment="Center" />

                        <Button Grid.Column="1"
                                Content="Clear completed"
                                Foreground="#70FFFFFF"
                                Background="Transparent"
                                BorderThickness="0"
                                FontSize="12"
                                FontFamily="Segoe UI Variable Text, Segoe UI, sans-serif"
                                Cursor="Hand"
                                Focusable="False"
                                FocusVisualStyle="{x:Null}"
                                Command="{Binding ClearCompletedCommand}"
                                Visibility="{Binding HasCompletedTasks, Converter={StaticResource BoolToVis}}">
                            <Button.Style>
                                <Style TargetType="Button">
                                    <Setter Property="Template">
                                        <Setter.Value>
                                            <ControlTemplate TargetType="Button">
                                                <Border Background="Transparent" Padding="4,2">
                                                    <ContentPresenter />
                                                </Border>
                                                <ControlTemplate.Triggers>
                                                    <Trigger Property="IsMouseOver" Value="True">
                                                        <Setter Property="Foreground" Value="#FF6B6B" />
                                                    </Trigger>
                                                </ControlTemplate.Triggers>
                                            </ControlTemplate>
                                        </Setter.Value>
                                    </Setter>
                                </Style>
                            </Button.Style>
                        </Button>
                    </Grid>
                </Grid>
            </Grid>
        </Grid>
</UserControl>
