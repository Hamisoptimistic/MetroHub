<UserControl x:Class="MetroHub.Widgets.Catalog.Radio.AtmosphericAuraControl"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             mc:Ignorable="d" 
             d:DesignHeight="78" d:DesignWidth="126"
             Focusable="False"
             IsHitTestVisible="False"
             Background="Transparent"
             ClipToBounds="True">

    <Grid x:Name="AuraRoot" Opacity="0" SnapsToDevicePixels="False">
        <!-- Layer 1: Bass / Sub-Bass Crimson & Magenta Bottom Aura -->
        <Rectangle x:Name="BassLayer" HorizontalAlignment="Stretch" VerticalAlignment="Stretch">
            <Rectangle.RenderTransform>
                <ScaleTransform x:Name="BassScale" CenterX="63" CenterY="78" />
            </Rectangle.RenderTransform>
            <Rectangle.Fill>
                <RadialGradientBrush Center="0.5, 1.0" GradientOrigin="0.5, 1.0" RadiusX="0.85" RadiusY="0.95">
                    <GradientStop x:Name="BassStop0" Offset="0.0" Color="#00EF233C" />
                    <GradientStop x:Name="BassStop1" Offset="0.55" Color="#00D90429" />
                    <GradientStop Offset="1.0" Color="#00000000" />
                </RadialGradientBrush>
            </Rectangle.Fill>
        </Rectangle>

        <!-- Layer 2: Mids Warm Amber & Sunset Orange Core -->
        <Rectangle x:Name="MidLayer" HorizontalAlignment="Stretch" VerticalAlignment="Stretch">
            <Rectangle.Fill>
                <RadialGradientBrush Center="0.5, 0.65" GradientOrigin="0.5, 0.65" RadiusX="0.75" RadiusY="0.75">
                    <GradientStop x:Name="MidStop0" Offset="0.0" Color="#00F77F00" />
                    <GradientStop x:Name="MidStop1" Offset="0.5" Color="#00FCBF49" />
                    <GradientStop Offset="1.0" Color="#00000000" />
                </RadialGradientBrush>
            </Rectangle.Fill>
        </Rectangle>

        <!-- Layer 3: Highs / Treble Golden Shimmer Radiance -->
        <Rectangle x:Name="TrebleLayer" HorizontalAlignment="Stretch" VerticalAlignment="Stretch">
            <Rectangle.Fill>
                <LinearGradientBrush StartPoint="0.5, 0.0" EndPoint="0.5, 1.0">
                    <GradientStop x:Name="TrebleStop0" Offset="0.0" Color="#00FFE6A7" />
                    <GradientStop x:Name="TrebleStop1" Offset="0.4" Color="#00FFF3B0" />
                    <GradientStop Offset="0.85" Color="#00000000" />
                </LinearGradientBrush>
            </Rectangle.Fill>
        </Rectangle>

        <!-- Layer 4: Diffused Atmospheric Vignette Film (AAA Contrast Depth) -->
        <Border HorizontalAlignment="Stretch" VerticalAlignment="Stretch" Background="#14000000" />
    </Grid>
</UserControl>
