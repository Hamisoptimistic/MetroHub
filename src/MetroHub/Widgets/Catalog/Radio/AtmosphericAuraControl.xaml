<UserControl x:Class="MetroHub.Widgets.Catalog.Radio.AtmosphericAuraControl"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             mc:Ignorable="d" 
             d:DesignHeight="78" d:DesignWidth="126"
             Focusable="False"
             IsHitTestVisible="False"
             Background="Transparent"
             ClipToBounds="True">

    <!-- Fluid mesh: 4 irregular blobs like the reference spheres. Brushes are STATIC
         (rasterized once, cached on GPU) — per-frame motion is transform+opacity only,
         so no re-raster banding and every color visibly pumps. -->
    <Grid x:Name="AuraRoot" Opacity="0" Visibility="Collapsed">
        <Grid.CacheMode>
            <BitmapCache EnableClearType="False" RenderAtScale="1" />
        </Grid.CacheMode>

        <!-- Cohesion wash: deep plum unifies the blobs so overlaps read purple, not brown -->
        <Border HorizontalAlignment="Stretch" VerticalAlignment="Stretch" Background="#3A1544" Opacity="0.85" />

        <!-- Blob PINK (kept red/pink): bottom-center mass, kick-driven -->
        <Rectangle x:Name="BlobPink" Width="190" Height="140"
                   HorizontalAlignment="Center" VerticalAlignment="Center" Margin="0,30,0,0"
                   RenderTransformOrigin="0.5,0.5" RenderOptions.BitmapScalingMode="HighQuality">
            <Rectangle.RenderTransform>
                <TransformGroup>
                    <ScaleTransform x:Name="PinkScale" />
                    <TranslateTransform x:Name="PinkShift" />
                </TransformGroup>
            </Rectangle.RenderTransform>
            <Rectangle.Fill>
                <RadialGradientBrush Center="0.5,0.5" GradientOrigin="0.5,0.5" RadiusX="0.5" RadiusY="0.5">
                    <GradientStop Offset="0.0" Color="#E8FF2D5E" />
                    <GradientStop Offset="0.55" Color="#B4C724B1" />
                    <GradientStop Offset="1.0" Color="#00000000" />
                </RadialGradientBrush>
            </Rectangle.Fill>
        </Rectangle>

        <!-- Blob CYAN: upper-left mass, snare-driven — overlaps pink at center -->
        <Rectangle x:Name="BlobCyan" Width="170" Height="130"
                   HorizontalAlignment="Center" VerticalAlignment="Center" Margin="-45,-35,0,0"
                   RenderTransformOrigin="0.5,0.5" RenderOptions.BitmapScalingMode="HighQuality">
            <Rectangle.RenderTransform>
                <TransformGroup>
                    <ScaleTransform x:Name="CyanScale" />
                    <TranslateTransform x:Name="CyanShift" />
                </TransformGroup>
            </Rectangle.RenderTransform>
            <Rectangle.Fill>
                <RadialGradientBrush Center="0.5,0.5" GradientOrigin="0.5,0.5" RadiusX="0.5" RadiusY="0.5">
                    <GradientStop Offset="0.0" Color="#D600E5FF" />
                    <GradientStop Offset="0.55" Color="#8C06B6D4" />
                    <GradientStop Offset="1.0" Color="#00000000" />
                </RadialGradientBrush>
            </Rectangle.Fill>
        </Rectangle>

        <!-- Blob VIOLET: upper-right mass, slow morph drift — overlaps both at center -->
        <Rectangle x:Name="BlobViolet" Width="175" Height="135"
                   HorizontalAlignment="Center" VerticalAlignment="Center" Margin="45,-35,0,0"
                   RenderTransformOrigin="0.5,0.5" RenderOptions.BitmapScalingMode="HighQuality">
            <Rectangle.RenderTransform>
                <TransformGroup>
                    <ScaleTransform x:Name="VioletScale" />
                    <TranslateTransform x:Name="VioletShift" />
                </TransformGroup>
            </Rectangle.RenderTransform>
            <Rectangle.Fill>
                <RadialGradientBrush Center="0.5,0.5" GradientOrigin="0.5,0.5" RadiusX="0.5" RadiusY="0.5">
                    <GradientStop Offset="0.0" Color="#D67C3AED" />
                    <GradientStop Offset="0.55" Color="#7E4A1DB5" />
                    <GradientStop Offset="1.0" Color="#00000000" />
                </RadialGradientBrush>
            </Rectangle.Fill>
        </Rectangle>

        <!-- Blob AMBER: center fleck, treble shimmer — small, sits in the melt zone -->
        <Rectangle x:Name="BlobAmber" Width="120" Height="90"
                   HorizontalAlignment="Center" VerticalAlignment="Center" Margin="15,0,0,0"
                   RenderTransformOrigin="0.5,0.5" RenderOptions.BitmapScalingMode="HighQuality">
            <Rectangle.RenderTransform>
                <TransformGroup>
                    <ScaleTransform x:Name="AmberScale" />
                    <TranslateTransform x:Name="AmberShift" />
                </TransformGroup>
            </Rectangle.RenderTransform>
            <Rectangle.Fill>
                <RadialGradientBrush Center="0.5,0.5" GradientOrigin="0.5,0.5" RadiusX="0.5" RadiusY="0.5">
                    <GradientStop Offset="0.0" Color="#C6FF9E00" />
                    <GradientStop Offset="0.55" Color="#6EFFD60A" />
                    <GradientStop Offset="1.0" Color="#00000000" />
                </RadialGradientBrush>
            </Rectangle.Fill>
        </Rectangle>

        <!-- Whisper vignette so text stays readable -->
        <Border HorizontalAlignment="Stretch" VerticalAlignment="Stretch" Background="#0A000000" />
    </Grid>
</UserControl>
