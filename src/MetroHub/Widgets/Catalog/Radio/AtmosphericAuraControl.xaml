<UserControl x:Class="MetroHub.Widgets.Catalog.Radio.AtmosphericAuraControl"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             mc:Ignorable="d" 
             d:DesignHeight="78" d:DesignWidth="126"
             Focusable="False"
             IsHitTestVisible="False"
             Background="Transparent"
             ClipToBounds="True">

    <!-- 2D Fluid Mesh Reactive Aura:
         Combines a continuous multi-color base spectrum (balanced Cyan, Violet, Pink, Orange)
         with soft floating radial accent blooms that flare on bass kick transients.
         Zero geometry transforms (zero border gaps), unified flow breathing. -->
    <Grid x:Name="AuraRoot" Opacity="0" Visibility="Collapsed" ClipToBounds="True">
        <!-- Layer 0: Continuous 2D Spectrum Base (Balanced proportions, wide Cyan top-left) -->
        <Rectangle HorizontalAlignment="Stretch" VerticalAlignment="Stretch">
            <Rectangle.Fill>
                <LinearGradientBrush x:Name="BaseGradient" StartPoint="-0.15,-0.15" EndPoint="1.10,1.10">
                    <GradientStop Offset="0.0" Color="#FF00A3FF" />
                    <GradientStop Offset="0.28" Color="#FF00B4D8" />
                    <GradientStop Offset="0.52" Color="#FF9D4EDD" />
                    <GradientStop Offset="0.76" Color="#FFFF1493" />
                    <GradientStop Offset="1.0" Color="#FFFF7A00" />
                </LinearGradientBrush>
            </Rectangle.Fill>
        </Rectangle>

        <!-- Layer 1: Floating CYAN / SKY BLUE Accent (Top-Left) -->
        <Rectangle x:Name="RectCyan" HorizontalAlignment="Stretch" VerticalAlignment="Stretch" Opacity="0.50">
            <Rectangle.Fill>
                <RadialGradientBrush x:Name="BrushCyan" Center="0.25,0.22" GradientOrigin="0.25,0.22" RadiusX="0.78" RadiusY="0.78">
                    <GradientStop Offset="0.0" Color="#FF00D4FF" />
                    <GradientStop Offset="0.35" Color="#8000A3FF" />
                    <GradientStop Offset="0.70" Color="#2000A3FF" />
                    <GradientStop Offset="1.0" Color="#0000A3FF" />
                </RadialGradientBrush>
            </Rectangle.Fill>
        </Rectangle>

        <!-- Layer 2: Floating LILAC / VIOLET Accent (Mid-Upper) -->
        <Rectangle x:Name="RectViolet" HorizontalAlignment="Stretch" VerticalAlignment="Stretch" Opacity="0.45">
            <Rectangle.Fill>
                <RadialGradientBrush x:Name="BrushViolet" Center="0.45,0.35" GradientOrigin="0.45,0.35" RadiusX="0.75" RadiusY="0.75">
                    <GradientStop Offset="0.0" Color="#FFD8B4FE" />
                    <GradientStop Offset="0.35" Color="#809D4EDD" />
                    <GradientStop Offset="0.70" Color="#209D4EDD" />
                    <GradientStop Offset="1.0" Color="#009D4EDD" />
                </RadialGradientBrush>
            </Rectangle.Fill>
        </Rectangle>

        <!-- Layer 3: Floating NEON MAGENTA / HOT PINK Accent (Bottom-Center) -->
        <Rectangle x:Name="RectPink" HorizontalAlignment="Stretch" VerticalAlignment="Stretch" Opacity="0.50">
            <Rectangle.Fill>
                <RadialGradientBrush x:Name="BrushPink" Center="0.52,0.72" GradientOrigin="0.52,0.72" RadiusX="0.80" RadiusY="0.80">
                    <GradientStop Offset="0.0" Color="#FFFF2A85" />
                    <GradientStop Offset="0.35" Color="#80FF1493" />
                    <GradientStop Offset="0.70" Color="#20FF1493" />
                    <GradientStop Offset="1.0" Color="#00FF1493" />
                </RadialGradientBrush>
            </Rectangle.Fill>
        </Rectangle>

        <!-- Layer 4: Floating RADIANT SUNSET ORANGE Accent (Bottom-Right, balanced opacity) -->
        <Rectangle x:Name="RectOrange" HorizontalAlignment="Stretch" VerticalAlignment="Stretch" Opacity="0.48">
            <Rectangle.Fill>
                <RadialGradientBrush x:Name="BrushOrange" Center="0.80,0.75" GradientOrigin="0.80,0.75" RadiusX="0.76" RadiusY="0.76">
                    <GradientStop Offset="0.0" Color="#FFFFA200" />
                    <GradientStop Offset="0.35" Color="#80FF7A00" />
                    <GradientStop Offset="0.70" Color="#20FF7A00" />
                    <GradientStop Offset="1.0" Color="#00FF7A00" />
                </RadialGradientBrush>
            </Rectangle.Fill>
        </Rectangle>
    </Grid>
</UserControl>
