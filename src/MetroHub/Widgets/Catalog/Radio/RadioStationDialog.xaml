<dialogs:MetroDialog x:Class="MetroHub.Presentation.Controls.RadioStationDialog"
                     xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                     xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                     xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
                     xmlns:controls="clr-namespace:MetroHub.Presentation.Controls"
                     xmlns:dialogs="clr-namespace:MetroHub.Presentation.Dialogs"
                     xmlns:po="http://schemas.microsoft.com/winfx/2006/xaml/presentation/options"
                     Title="Add Radio Station"
                     Width="680"
                     Height="480">

    <Window.Resources>
        <DrawingImage x:Key="RadioVectorImage" po:Freeze="True">
            <DrawingImage.Drawing>
                <DrawingGroup>
                    <!-- Antenna Body -->
                    <GeometryDrawing Geometry="M 2.697,12.389 a 0.999,0.999 0 1 0 1.414,1.414 l 9.192,-9.192 a 0.999,0.999 0 1 0 -1.414,-1.414 l -9.192,9.192 z">
                        <GeometryDrawing.Brush>
                            <LinearGradientBrush StartPoint="0,1" EndPoint="1,0">
                                <GradientStop Color="#00A4EF" Offset="0" />
                                <GradientStop Color="#50E6FF" Offset="1" />
                            </LinearGradientBrush>
                        </GeometryDrawing.Brush>
                    </GeometryDrawing>

                    <!-- Antenna Tip -->
                    <GeometryDrawing Brush="#50E6FF"
                                     Geometry="M 15.561,3.061 a 0.999,0.999 0 0 1 -1.414,0 l -0.707,-0.707 A 0.999,0.999 0 1 1 14.854,0.94 l 0.707,0.707 a 1,1 0 0 1 0,1.414 z" />

                    <!-- Chassis with ClipGeometry -->
                    <DrawingGroup ClipGeometry="M 36,32 c 0,4 -4,4 -4,4 H 4 s -4,0 -4,-4 V 14 s 0,-4 4,-4 h 28 c 4,0 4,4 4,4 v 18 z">
                        <GeometryDrawing>
                            <GeometryDrawing.Brush>
                                <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                                    <GradientStop Color="#258BFF" Offset="0" />
                                    <GradientStop Color="#0A4EA8" Offset="1" />
                                </LinearGradientBrush>
                            </GeometryDrawing.Brush>
                            <GeometryDrawing.Geometry>
                                <RectangleGeometry Rect="0,10,36,26" />
                            </GeometryDrawing.Geometry>
                        </GeometryDrawing>
                        <GeometryDrawing Brush="#1F000000">
                            <GeometryDrawing.Geometry>
                                <RectangleGeometry Rect="21,10,15,26" />
                            </GeometryDrawing.Geometry>
                        </GeometryDrawing>
                    </DrawingGroup>

                    <!-- Speaker Holes -->
                    <GeometryDrawing Brush="#00264D">
                        <GeometryDrawing.Geometry>
                            <GeometryGroup>
                                <EllipseGeometry Center="5.5,15.5" RadiusX="1.5" RadiusY="1.5" />
                                <EllipseGeometry Center="10.5,15.5" RadiusX="1.5" RadiusY="1.5" />
                                <EllipseGeometry Center="15.5,15.5" RadiusX="1.5" RadiusY="1.5" />
                                <EllipseGeometry Center="5.5,20.5" RadiusX="1.5" RadiusY="1.5" />
                                <EllipseGeometry Center="10.5,20.5" RadiusX="1.5" RadiusY="1.5" />
                                <EllipseGeometry Center="15.5,20.5" RadiusX="1.5" RadiusY="1.5" />
                                <EllipseGeometry Center="5.5,25.5" RadiusX="1.5" RadiusY="1.5" />
                                <EllipseGeometry Center="10.5,25.5" RadiusX="1.5" RadiusY="1.5" />
                                <EllipseGeometry Center="15.5,25.5" RadiusX="1.5" RadiusY="1.5" />
                                <EllipseGeometry Center="5.5,30.5" RadiusX="1.5" RadiusY="1.5" />
                                <EllipseGeometry Center="10.5,30.5" RadiusX="1.5" RadiusY="1.5" />
                                <EllipseGeometry Center="15.5,30.5" RadiusX="1.5" RadiusY="1.5" />
                            </GeometryGroup>
                        </GeometryDrawing.Geometry>
                    </GeometryDrawing>

                    <!-- Dials -->
                    <GeometryDrawing Brush="#FFFFFF">
                        <GeometryDrawing.Geometry>
                            <EllipseGeometry Center="27.5,18.5" RadiusX="5.5" RadiusY="5.5" />
                        </GeometryDrawing.Geometry>
                    </GeometryDrawing>
                    <GeometryDrawing Brush="#0A4EA8">
                        <GeometryDrawing.Geometry>
                            <EllipseGeometry Center="27.5,18.5" RadiusX="3.5" RadiusY="3.5" />
                        </GeometryDrawing.Geometry>
                    </GeometryDrawing>
                    <GeometryDrawing Brush="#38D9F9">
                        <GeometryDrawing.Geometry>
                            <EllipseGeometry Center="27.5,29.5" RadiusX="3.5" RadiusY="3.5" />
                        </GeometryDrawing.Geometry>
                    </GeometryDrawing>
                    <GeometryDrawing Brush="#00264D">
                        <GeometryDrawing.Geometry>
                            <EllipseGeometry Center="27.5,29.5" RadiusX="1.5" RadiusY="1.5" />
                        </GeometryDrawing.Geometry>
                    </GeometryDrawing>
                </DrawingGroup>
            </DrawingImage.Drawing>
        </DrawingImage>


        <Style x:Key="MetroTabStripItemStyle" TargetType="ListBoxItem">
            <Setter Property="OverridesDefaultStyle" Value="True" />
            <Setter Property="FocusVisualStyle" Value="{x:Null}" />
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="Padding" Value="14,6,14,10" />
            <Setter Property="FontSize" Value="{DynamicResource TypeBodyFontSize}" />
            <Setter Property="FontFamily" Value="{DynamicResource AppFontFamily}" />
            <Setter Property="Foreground" Value="{DynamicResource TextSecondaryBrush}" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="HorizontalContentAlignment" Value="Center" />
            <Setter Property="VerticalContentAlignment" Value="Center" />
            <Setter Property="SnapsToDevicePixels" Value="True" />
            <Setter Property="UseLayoutRounding" Value="True" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="{x:Type ListBoxItem}">
                        <Border Background="{TemplateBinding Background}"
                                Padding="{TemplateBinding Padding}"
                                SnapsToDevicePixels="True"
                                UseLayoutRounding="True">
                            <ContentPresenter x:Name="ContentPresenter"
                                              HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}"
                                              VerticalAlignment="{TemplateBinding VerticalContentAlignment}"
                                              RecognizesAccessKey="True" />
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Foreground" Value="{DynamicResource TextPrimaryBrush}" />
                </Trigger>
                <Trigger Property="IsSelected" Value="True">
                    <Setter Property="Foreground" Value="{DynamicResource TextPrimaryBrush}" />
                </Trigger>
                <Trigger Property="IsEnabled" Value="False">
                    <Setter Property="Opacity" Value="0.4" />
                    <Setter Property="Cursor" Value="Arrow" />
                </Trigger>
            </Style.Triggers>
        </Style>

        <Style x:Key="SuggestionListBoxItemStyle" TargetType="ListBoxItem">
            <Setter Property="OverridesDefaultStyle" Value="True" />
            <Setter Property="FocusVisualStyle" Value="{x:Null}" />
            <Setter Property="Padding" Value="10,6,10,6" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ListBoxItem">
                        <Border x:Name="ItemBorder"
                                Background="Transparent"
                                CornerRadius="{DynamicResource ControlCornerRadius}"
                                Margin="2,1,2,1"
                                Padding="{TemplateBinding Padding}">
                            <ContentPresenter />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="ItemBorder" Property="Background" Value="{DynamicResource FluentHoverBrush}" />
                            </Trigger>
                            <Trigger Property="IsSelected" Value="True">
                                <Setter TargetName="ItemBorder" Property="Background" Value="{DynamicResource FluentPressedBrush}" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <DataTemplate x:Key="RadioSearchResultItemTemplate">
            <Grid Margin="0,3">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <StackPanel Grid.Column="0" VerticalAlignment="Center">
                    <TextBlock Text="{Binding Name}"
                               FontSize="{DynamicResource TypeBodyFontSize}"
                               FontWeight="SemiBold"
                               Foreground="{DynamicResource TextPrimaryBrush}"
                               TextTrimming="CharacterEllipsis" />
                    <TextBlock Text="{Binding Subtitle}"
                               FontSize="{DynamicResource TypeCaptionFontSize}"
                               FontWeight="Normal"
                               Foreground="{DynamicResource TextSecondaryBrush}"
                               Margin="0,2,0,0"
                               TextTrimming="CharacterEllipsis" />
                </StackPanel>
                <Border Grid.Column="1"
                        Background="{DynamicResource SurfaceBorderSubtleBrush}"
                        CornerRadius="{DynamicResource ControlCornerRadius}"
                        Padding="6,2"
                        VerticalAlignment="Center"
                        Margin="8,0,0,0">
                    <TextBlock Text="{Binding BitrateDisplay}"
                               FontSize="{DynamicResource TypeCaptionFontSize}"
                               FontWeight="Normal"
                               Foreground="{DynamicResource TextSecondaryBrush}" />
                </Border>
            </Grid>
        </DataTemplate>
    </Window.Resources>

    <!-- Frosted Acrylic Left Sidebar Content Slot -->
    <dialogs:MetroDialog.SidebarContent>
        <Grid HorizontalAlignment="Center" VerticalAlignment="Center">
            <Image Source="{StaticResource RadioVectorImage}"
                   Width="72"
                   Height="72"
                   Stretch="Uniform"
                   HorizontalAlignment="Center"
                   VerticalAlignment="Center"
                   RenderOptions.BitmapScalingMode="HighQuality" />
        </Grid>
    </dialogs:MetroDialog.SidebarContent>

    <!-- Dark Obsidian Form Content Slot -->
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <!-- Body: Radio Station Form -->
        <Grid Grid.Row="0">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="*" />
                        </Grid.RowDefinitions>

                        <!-- Three-Tab MetroTabStrip Selector -->
                        <controls:MetroTabStrip x:Name="RadioModeTabSelector"
                                                Grid.Row="0"
                                                SelectedIndex="0"
                                                SelectionChanged="OnRadioTabSelectionChanged"
                                                Margin="0,0,0,16"
                                                HorizontalAlignment="Left">
                            <ListBoxItem Content="Search" Style="{StaticResource MetroTabStripItemStyle}" />
                            <ListBoxItem Content="Custom URL" Style="{StaticResource MetroTabStripItemStyle}" />
                            <ListBoxItem Content="Categories" Style="{StaticResource MetroTabStripItemStyle}" />
                        </controls:MetroTabStrip>

                        <!-- TAB 1: Search Stations Panel -->
                        <Grid Grid.Row="1" x:Name="RadioSearchPanel" Visibility="Visible">
                            <!-- VIEW 1: Search Input & Results List -->
                            <Grid x:Name="RadioSearchBrowseView" Visibility="Visible">
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="*" />
                                    <RowDefinition Height="Auto" />
                                </Grid.RowDefinitions>

                                <!-- Search Input Box with Overlay Watermark & Spinner -->
                                <Grid Grid.Row="0">
                                    <TextBox x:Name="RadioSearchInput"
                                             controls:InputHelper.Icon="Search24"
                                             Padding="0,0,28,0"
                                             TextChanged="OnRadioSearchInputTextChanged"
                                             PreviewKeyDown="OnRadioSearchInputKeyDown" />
                                    <TextBlock x:Name="RadioSearchWatermark"
                                               Text="Search station name, genre (e.g. lofi, jazz, ambient)..."
                                               FontSize="{DynamicResource TypeBodyFontSize}"
                                               FontWeight="Normal"
                                               Foreground="{DynamicResource TextSecondaryBrush}"
                                               IsHitTestVisible="False"
                                               VerticalAlignment="Center"
                                               Margin="34,0,28,0" />
                                    <ui:ProgressRing x:Name="RadioSearchSpinner"
                                                     Width="14" Height="14"
                                                     IsIndeterminate="True"
                                                     HorizontalAlignment="Right"
                                                     VerticalAlignment="Center"
                                                     Margin="0,0,10,0"
                                                     Visibility="Collapsed" />
                                </Grid>

                                <!-- Search Results List -->
                                <Border Grid.Row="1"
                                        Background="{DynamicResource WidgetDividerBrush}"
                                        BorderBrush="{DynamicResource SurfaceBorderBrush}"
                                        BorderThickness="1"
                                        CornerRadius="{DynamicResource ControlCornerRadius}"
                                        Margin="0,8,0,0">
                                    <Grid>
                                        <ListBox x:Name="RadioSearchResultsList"
                                                 Background="Transparent"
                                                 BorderThickness="0"
                                                 Padding="2"
                                                 ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                                                 ScrollViewer.VerticalScrollBarVisibility="Auto"
                                                 controls:AutoHideScrollBehavior.IsEnabled="True"
                                                 ItemContainerStyle="{StaticResource SuggestionListBoxItemStyle}"
                                                 ItemTemplate="{StaticResource RadioSearchResultItemTemplate}"
                                                 SelectionChanged="OnRadioSearchResultsSelectionChanged" />

                                        <!-- Search Initial Hint / Empty Text -->
                                        <TextBlock x:Name="RadioSearchPlaceholderText"
                                                   Text="Type 2 or more characters to search 40,000+ online stations"
                                                   FontSize="{DynamicResource TypeCaptionFontSize}"
                                                   FontWeight="Normal"
                                                   Foreground="{DynamicResource TextSecondaryBrush}"
                                                   TextWrapping="Wrap"
                                                   TextTrimming="CharacterEllipsis"
                                                   MaxWidth="420"
                                                   Margin="20"
                                                   TextAlignment="Center"
                                                   HorizontalAlignment="Center"
                                                   VerticalAlignment="Center"
                                                   IsHitTestVisible="False"
                                                   Visibility="Visible" />
                                    </Grid>
                                </Border>

                                <!-- Search Status Message -->
                                <TextBlock Grid.Row="2"
                                           x:Name="RadioSearchStatusMessage"
                                           FontSize="{DynamicResource TypeCaptionFontSize}"
                                           FontWeight="Normal"
                                           Foreground="{DynamicResource StatusErrorBrush}"
                                           Margin="0,6,0,0"
                                           TextWrapping="Wrap"
                                           Visibility="Collapsed" />
                            </Grid>

                            <!-- VIEW 2: Selected Station Confirmation & Display Name Editor -->
                            <StackPanel x:Name="RadioSearchSelectionPanel"
                                        VerticalAlignment="Top"
                                        Visibility="Collapsed">

                                <!-- Top Navigation Row -->
                                <Button Style="{DynamicResource SubtleButtonStyle}"
                                        Height="28"
                                        Padding="8,0,10,0"
                                        Click="OnChangeSelectedStationClick"
                                        ToolTip="Return to search results (Esc)"
                                        HorizontalAlignment="Left"
                                        VerticalAlignment="Center"
                                        Margin="0,0,0,10">
                                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                        <ui:SymbolIcon Symbol="ArrowLeft24"
                                                       FontSize="13"
                                                       Foreground="{DynamicResource TextSecondaryBrush}"
                                                       Margin="0,0,6,0"
                                                       VerticalAlignment="Center" />
                                        <TextBlock Text="Back to search results"
                                                   FontSize="{DynamicResource TypeCaptionFontSize}"
                                                   FontWeight="SemiBold"
                                                   Foreground="{DynamicResource TextSecondaryBrush}"
                                                   VerticalAlignment="Center" />
                                    </StackPanel>
                                </Button>

                                <!-- Selected Station Card -->
                                <Border Background="{DynamicResource SurfaceGlassBrush}"
                                        BorderBrush="{DynamicResource SurfaceBorderBrush}"
                                        BorderThickness="1"
                                        CornerRadius="{DynamicResource ControlCornerRadius}"
                                        Margin="0,0,0,14">
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="Auto" />
                                        </Grid.ColumnDefinitions>

                                        <!-- Left & Middle: Station Identity -->
                                        <Border Grid.Column="0" Padding="14,12">
                                            <Grid>
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="Auto" />
                                                    <ColumnDefinition Width="*" />
                                                </Grid.ColumnDefinitions>

                                                <!-- Circular Icon Container -->
                                                <Border Grid.Column="0"
                                                        Width="40"
                                                        Height="40"
                                                        CornerRadius="20"
                                                        Background="{DynamicResource SurfaceGlassSubtleBrush}"
                                                        BorderBrush="{DynamicResource SurfaceBorderSubtleBrush}"
                                                        BorderThickness="1"
                                                        VerticalAlignment="Center">
                                                    <ui:SymbolIcon Symbol="HeadphonesSoundWave24"
                                                                   FontSize="20"
                                                                   Foreground="{DynamicResource TextPrimaryBrush}"
                                                                   HorizontalAlignment="Center"
                                                                   VerticalAlignment="Center" />
                                                </Border>

                                                <!-- Station Name & URL -->
                                                <StackPanel Grid.Column="1"
                                                            Margin="12,0,0,0"
                                                            VerticalAlignment="Center">
                                                    <TextBlock x:Name="RadioSelectedStationOriginalName"
                                                               Text="Radio Name"
                                                               FontSize="{DynamicResource TypeBodyStrongFontSize}"
                                                               FontWeight="SemiBold"
                                                               Foreground="{DynamicResource TextPrimaryBrush}"
                                                               TextTrimming="CharacterEllipsis" />
                                                    <TextBlock x:Name="RadioSelectedStationStreamUrl"
                                                               Text="Radio Link"
                                                               FontSize="{DynamicResource TypeCaptionFontSize}"
                                                               FontWeight="Normal"
                                                               Foreground="{DynamicResource TextSecondaryBrush}"
                                                               TextTrimming="CharacterEllipsis"
                                                               Margin="0,3,0,0" />
                                                </StackPanel>
                                            </Grid>
                                        </Border>

                                        <!-- Right: Metadata Split Pane (Country / Format) -->
                                        <Border Grid.Column="1"
                                                BorderThickness="1,0,0,0"
                                                BorderBrush="{DynamicResource SurfaceBorderBrush}"
                                                MinWidth="110">
                                            <Grid>
                                                <Grid.RowDefinitions>
                                                    <RowDefinition Height="*" />
                                                    <RowDefinition Height="*" />
                                                </Grid.RowDefinitions>

                                                <!-- Country (Top Half) -->
                                                <Border Grid.Row="0" Padding="12,6">
                                                    <TextBlock x:Name="RadioSelectedStationCountryText"
                                                               Text="Country"
                                                               FontSize="{DynamicResource TypeCaptionFontSize}"
                                                               FontWeight="SemiBold"
                                                               Foreground="{DynamicResource TextPrimaryBrush}"
                                                               HorizontalAlignment="Center"
                                                               VerticalAlignment="Center"
                                                               TextTrimming="CharacterEllipsis" />
                                                </Border>

                                                <!-- Divider -->
                                                <Border Grid.Row="0"
                                                        Height="1"
                                                        Background="{DynamicResource SurfaceBorderBrush}"
                                                        VerticalAlignment="Bottom" />

                                                <!-- Format (Bottom Half) -->
                                                <Border Grid.Row="1" Padding="12,6">
                                                    <TextBlock x:Name="RadioSelectedStationFormatText"
                                                               Text="Format"
                                                               FontSize="{DynamicResource TypeCaptionFontSize}"
                                                               FontWeight="Normal"
                                                               Foreground="{DynamicResource TextSecondaryBrush}"
                                                               HorizontalAlignment="Center"
                                                               VerticalAlignment="Center"
                                                               TextTrimming="CharacterEllipsis" />
                                                </Border>
                                            </Grid>
                                        </Border>
                                    </Grid>
                                </Border>

                                <!-- Station Display Name Editor Section -->
                                <TextBlock Text="Edit Station Name"
                                           FontSize="{DynamicResource TypeCaptionFontSize}"
                                           FontWeight="Normal"
                                           Foreground="{DynamicResource TextSecondaryBrush}"
                                           Margin="0,0,0,6" />

                                <TextBox x:Name="RadioSearchNameInput"
                                         Height="36"
                                         Style="{DynamicResource MetroInputStyle}"
                                         TextChanged="OnRadioSearchNameInputTextChanged"
                                         PreviewKeyDown="OnRadioSearchNameInputKeyDown" />

                                <!-- Validation Error Message -->
                                <TextBlock x:Name="RadioSearchEditorStatusMessage"
                                           FontSize="{DynamicResource TypeCaptionFontSize}"
                                           FontWeight="Normal"
                                           Foreground="{DynamicResource StatusErrorBrush}"
                                           Margin="0,4,0,0"
                                           TextWrapping="Wrap"
                                           Visibility="Collapsed" />
                            </StackPanel>
                        </Grid>

                        <!-- TAB 2: Direct Stream URL Panel -->
                        <Grid Grid.Row="1" x:Name="RadioDirectPanel" Visibility="Collapsed">
                            <StackPanel>
                                <TextBlock Text="Audio Stream URL"
                                           FontSize="{DynamicResource TypeCaptionFontSize}"
                                           FontWeight="Normal"
                                           Foreground="{DynamicResource TextSecondaryBrush}"
                                           Margin="0,0,0,6" />

                                <TextBox x:Name="RadioDirectUrlInput"
                                         controls:InputHelper.Icon="Link24"
                                         TextChanged="OnRadioDirectUrlTextChanged"
                                         KeyDown="OnRadioDirectInputKeyDown" />

                                <Grid Margin="0,6,0,0" MinHeight="18">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto" />
                                        <ColumnDefinition Width="*" />
                                    </Grid.ColumnDefinitions>
                                    <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center">
                                        <ui:ProgressRing x:Name="RadioProbeSpinner"
                                                         Width="12" Height="12"
                                                         IsIndeterminate="True"
                                                         Visibility="Collapsed"
                                                         Margin="0,0,6,0" />
                                        <ui:SymbolIcon x:Name="RadioProbeIcon"
                                                       Symbol="Checkmark24"
                                                       FontSize="13"
                                                       Visibility="Collapsed"
                                                       Margin="0,0,6,0"
                                                       VerticalAlignment="Center" />
                                    </StackPanel>
                                    <TextBlock Grid.Column="1"
                                               x:Name="RadioProbeStatusText"
                                               Text="Supports MP3/AAC/OGG streams or single-station .pls/.m3u"
                                               FontSize="{DynamicResource TypeCaptionFontSize}"
                                               FontWeight="Normal"
                                               Foreground="{DynamicResource TextSecondaryBrush}"
                                               TextWrapping="Wrap"
                                               VerticalAlignment="Center" />
                                </Grid>

                                <TextBlock Text="Station Name"
                                           FontSize="{DynamicResource TypeCaptionFontSize}"
                                           FontWeight="Normal"
                                           Foreground="{DynamicResource TextSecondaryBrush}"
                                           Margin="0,8,0,6" />
                                <TextBox x:Name="RadioDirectNameInput"
                                         TextChanged="OnRadioDirectNameTextChanged"
                                         KeyDown="OnRadioDirectInputKeyDown" />

                                <TextBlock x:Name="RadioDirectStatusMessage"
                                           FontSize="{DynamicResource TypeCaptionFontSize}"
                                           FontWeight="Normal"
                                           Foreground="{DynamicResource StatusErrorBrush}"
                                           Margin="0,6,0,0"
                                           TextWrapping="Wrap"
                                           Visibility="Collapsed" />
                            </StackPanel>
                        </Grid>

                        <!-- TAB 3: Category Management Panel -->
                        <Grid Grid.Row="1" x:Name="RadioCategoriesPanel" Visibility="Collapsed">
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="*" />
                            </Grid.RowDefinitions>

                            <!-- Top Add Strip -->
                            <Grid Grid.Row="0" Margin="0,0,0,12">
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="Auto" />
                                </Grid.RowDefinitions>

                                <Grid Grid.Row="0">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto" />
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>

                                    <!-- 32x32 Icon Picker Button -->
                                    <Button x:Name="NewCategoryIconPickerButton"
                                            Grid.Column="0"
                                            Width="36"
                                            Height="36"
                                            Background="{DynamicResource WidgetDividerBrush}"
                                            BorderBrush="#28FFFFFF"
                                            BorderThickness="1"
                                            Padding="0"
                                            ToolTip="Choose category icon"
                                            Command="{Binding OpenNewCategoryIconPickerCommand}">
                                        <ui:SymbolIcon Symbol="{Binding SelectedNewIconSymbol}"
                                                       FontSize="16"
                                                       Foreground="{DynamicResource TextPrimaryBrush}" />
                                    </Button>

                                    <!-- Icon Picker Popup (StaysOpen="False", 4x4 Grid) -->
                                    <Popup x:Name="NewCategoryIconPickerPopup"
                                           IsOpen="{Binding IsIconPickerOpen, Mode=TwoWay}"
                                           StaysOpen="False"
                                           Placement="Bottom"
                                           PlacementTarget="{Binding ElementName=NewCategoryIconPickerButton}"
                                           AllowsTransparency="True">
                                        <Border Background="{DynamicResource DialogPanelBackground}"
                                                BorderBrush="{DynamicResource SurfaceBorderBrush}"
                                                BorderThickness="1"
                                                CornerRadius="{DynamicResource ControlCornerRadius}"
                                                Padding="6"
                                                Margin="0,4,0,0">
                                            <ItemsControl ItemsSource="{Binding CuratedIcons}">
                                                <ItemsControl.ItemsPanel>
                                                    <ItemsPanelTemplate>
                                                        <UniformGrid Columns="4" Rows="4" />
                                                    </ItemsPanelTemplate>
                                                </ItemsControl.ItemsPanel>
                                                <ItemsControl.ItemTemplate>
                                                    <DataTemplate>
                                                        <Button Width="32" Height="32"
                                                                Margin="2"
                                                                Style="{StaticResource SubtleButtonStyle}"
                                                                ToolTip="{Binding Key}"
                                                                Command="{Binding DataContext.PickIconCommand, RelativeSource={RelativeSource AncestorType=Popup}}"
                                                                CommandParameter="{Binding}">
                                                            <ui:SymbolIcon Symbol="{Binding Symbol}"
                                                                           FontSize="16"
                                                                           Foreground="{DynamicResource TextPrimaryBrush}" />
                                                        </Button>
                                                    </DataTemplate>
                                                </ItemsControl.ItemTemplate>
                                            </ItemsControl>
                                        </Border>
                                    </Popup>

                                    <!-- Flat TextBox with Watermark Placeholder -->
                                    <Grid Grid.Column="1" Margin="8,0,8,0">
                                        <TextBox x:Name="NewCategoryNameTextBox"
                                                 Text="{Binding NewCategoryName, UpdateSourceTrigger=PropertyChanged}"
                                                 MaxLength="24"
                                                 Height="36"
                                                 KeyDown="OnNewCategoryTextBoxKeyDown" />
                                        <TextBlock Text="Category name..."
                                                   FontSize="{DynamicResource TypeBodyFontSize}"
                                                   FontWeight="Normal"
                                                   Foreground="{DynamicResource TextSecondaryBrush}"
                                                   IsHitTestVisible="False"
                                                   VerticalAlignment="Center"
                                                   Margin="12,0,12,0">
                                            <TextBlock.Style>
                                                <Style TargetType="TextBlock">
                                                    <Setter Property="Visibility" Value="Collapsed" />
                                                    <Style.Triggers>
                                                        <DataTrigger Binding="{Binding Text, ElementName=NewCategoryNameTextBox}" Value="">
                                                            <Setter Property="Visibility" Value="Visible" />
                                                        </DataTrigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </TextBlock.Style>
                                        </TextBlock>
                                    </Grid>

                                    <!-- Flat hairline "+ Add" button -->
                                    <Button Grid.Column="2"
                                            Content="+ Add"
                                            Height="36"
                                            Padding="16,0"
                                            Style="{StaticResource DefaultButtonStyle}"
                                            Command="{Binding AddCategoryCommand}" />
                                </Grid>

                                <!-- Caption below: inline validation or helper message -->
                                <TextBlock Grid.Row="1"
                                           Text="{Binding StatusOrValidationMessage}"
                                           FontSize="{DynamicResource TypeCaptionFontSize}"
                                           FontWeight="Normal"
                                           Foreground="{DynamicResource StatusErrorBrush}"
                                           Margin="0,6,0,0"
                                           TextWrapping="Wrap">
                                    <TextBlock.Style>
                                        <Style TargetType="TextBlock">
                                            <Setter Property="Visibility" Value="Visible" />
                                            <Style.Triggers>
                                                <Trigger Property="Text" Value="">
                                                    <Setter Property="Visibility" Value="Collapsed" />
                                                </Trigger>
                                            </Style.Triggers>
                                        </Style>
                                    </TextBlock.Style>
                                </TextBlock>
                            </Grid>

                            <!-- Categories List Container (Flat 1px-bordered container with 36px-40px rows) -->
                            <Border Grid.Row="1"
                                    Background="{DynamicResource WidgetDividerBrush}"
                                    BorderBrush="{DynamicResource SurfaceBorderBrush}"
                                    BorderThickness="1"
                                    CornerRadius="{DynamicResource ControlCornerRadius}"
                                    ClipToBounds="True">
                                <ScrollViewer VerticalScrollBarVisibility="Auto"
                                              HorizontalScrollBarVisibility="Disabled"
                                              controls:AutoHideScrollBehavior.IsEnabled="True"
                                              Focusable="False">
                                    <ItemsControl x:Name="CategoriesItemsControl"
                                                  ItemsSource="{Binding Categories}">
                                        <ItemsControl.ItemTemplate>
                                            <DataTemplate>
                                                <Border x:Name="RowRootBorder"
                                                        Background="Transparent"
                                                        BorderThickness="0,0,0,1"
                                                        BorderBrush="{DynamicResource SurfaceBorderSubtleBrush}"
                                                        AllowDrop="True"
                                                        PreviewMouseLeftButtonDown="OnRowPreviewMouseLeftButtonDown"
                                                        PreviewMouseMove="OnRowPreviewMouseMove"
                                                        PreviewMouseLeftButtonUp="OnRowPreviewMouseLeftButtonUp"
                                                        DragOver="OnRowDragOver"
                                                        DragLeave="OnRowDragLeave"
                                                        Drop="OnRowDrop">
                                                    <Grid>
                                                        <!-- Top/Bottom Drag Indicators -->
                                                        <Border x:Name="PART_TopIndicator"
                                                                Height="2"
                                                                Background="#FFFFFF"
                                                                VerticalAlignment="Top"
                                                                Visibility="Collapsed"
                                                                Panel.ZIndex="10" />
                                                        <Border x:Name="PART_BottomIndicator"
                                                                Height="2"
                                                                Background="#FFFFFF"
                                                                VerticalAlignment="Bottom"
                                                                Visibility="Collapsed"
                                                                Panel.ZIndex="10" />

                                                        <!-- Normal Row -->
                                                        <Grid x:Name="NormalRowGrid" Height="38">
                                                            <Grid.ColumnDefinitions>
                                                                <ColumnDefinition Width="Auto" />
                                                                <ColumnDefinition Width="Auto" />
                                                                <ColumnDefinition Width="*" />
                                                                <ColumnDefinition Width="Auto" />
                                                                <ColumnDefinition Width="Auto" />
                                                            </Grid.ColumnDefinitions>

                                                            <!-- Drag Handle -->
                                                            <Border Grid.Column="0"
                                                                    Width="24"
                                                                    Cursor="SizeNS"
                                                                    Background="Transparent"
                                                                    VerticalAlignment="Stretch"
                                                                    ToolTip="Drag to reorder">
                                                                <ui:SymbolIcon Symbol="ReOrderDotsVertical24"
                                                                               FontSize="14"
                                                                               Foreground="{DynamicResource TextSecondaryBrush}"
                                                                               HorizontalAlignment="Center"
                                                                               VerticalAlignment="Center" />
                                                            </Border>

                                                            <!-- Clickable Category Icon Button -->
                                                            <Button Grid.Column="1"
                                                                    Width="28"
                                                                    Height="28"
                                                                    Padding="0"
                                                                    Margin="2,0,6,0"
                                                                    Style="{StaticResource SubtleButtonStyle}"
                                                                    ToolTip="Change category icon"
                                                                    Click="OnRowCategoryIconButtonClick">
                                                                <ui:SymbolIcon Symbol="{Binding IconSymbol}"
                                                                               FontSize="15"
                                                                               Foreground="{DynamicResource TextPrimaryBrush}" />
                                                            </Button>

                                                            <!-- Category Name / Inline Rename -->
                                                            <Grid Grid.Column="2" VerticalAlignment="Center">
                                                                <!-- Display TextBlock -->
                                                                <TextBlock x:Name="CategoryNameTextBlock"
                                                                           Text="{Binding Name}"
                                                                           FontSize="{DynamicResource TypeBodyFontSize}"
                                                                           FontWeight="SemiBold"
                                                                           Foreground="{DynamicResource TextPrimaryBrush}"
                                                                           VerticalAlignment="Center"
                                                                           TextTrimming="CharacterEllipsis"
                                                                           ToolTip="Double-click to rename"
                                                                           MouseLeftButtonDown="OnCategoryNameTextBlockMouseDown" />

                                                                <!-- Inline Rename TextBox -->
                                                                <TextBox x:Name="InlineRenameTextBox"
                                                                         Text="{Binding DraftName, UpdateSourceTrigger=PropertyChanged}"
                                                                         MaxLength="24"
                                                                         Height="28"
                                                                         Padding="6,0"
                                                                         Style="{StaticResource MetroInputStyle}"
                                                                         Visibility="Collapsed"
                                                                         Loaded="OnInlineRenameTextBoxLoaded"
                                                                         IsVisibleChanged="OnInlineRenameTextBoxIsVisibleChanged"
                                                                         KeyDown="OnInlineRenameTextBoxKeyDown"
                                                                         LostFocus="OnInlineRenameTextBoxLostFocus"
                                                                         VerticalAlignment="Center" />
                                                            </Grid>

                                                            <!-- Station Count Text (no pill background) -->
                                                            <TextBlock Grid.Column="3"
                                                                       Text="{Binding StationCount, StringFormat='{}{0} stations'}"
                                                                       FontSize="{DynamicResource TypeCaptionFontSize}"
                                                                       FontWeight="Normal"
                                                                       Foreground="{DynamicResource TextSecondaryBrush}"
                                                                       VerticalAlignment="Center"
                                                                       Margin="12,0,12,0" />

                                                            <!-- Micro Action Buttons -->
                                                            <StackPanel Grid.Column="4"
                                                                        Orientation="Horizontal"
                                                                        VerticalAlignment="Center"
                                                                        Margin="0,0,6,0">
                                                                <!-- Move Up -->
                                                                <Button Width="26"
                                                                        Height="26"
                                                                        Padding="0"
                                                                        Margin="1,0"
                                                                        Style="{StaticResource SubtleButtonStyle}"
                                                                        ToolTip="Move up"
                                                                        Command="{Binding DataContext.MoveUpCommand, RelativeSource={RelativeSource AncestorType=ItemsControl}}"
                                                                        CommandParameter="{Binding}"
                                                                        IsEnabled="{Binding CanMoveUp}">
                                                                    <ui:SymbolIcon Symbol="ArrowUp24"
                                                                                   FontSize="13"
                                                                                   Foreground="{DynamicResource TextSecondaryBrush}" />
                                                                </Button>

                                                                <!-- Move Down -->
                                                                <Button Width="26"
                                                                        Height="26"
                                                                        Padding="0"
                                                                        Margin="1,0"
                                                                        Style="{StaticResource SubtleButtonStyle}"
                                                                        ToolTip="Move down"
                                                                        Command="{Binding DataContext.MoveDownCommand, RelativeSource={RelativeSource AncestorType=ItemsControl}}"
                                                                        CommandParameter="{Binding}"
                                                                        IsEnabled="{Binding CanMoveDown}">
                                                                    <ui:SymbolIcon Symbol="ArrowDown24"
                                                                                   FontSize="13"
                                                                                   Foreground="{DynamicResource TextSecondaryBrush}" />
                                                                </Button>

                                                                <!-- Edit / Rename -->
                                                                <Button Width="26"
                                                                        Height="26"
                                                                        Padding="0"
                                                                        Margin="1,0"
                                                                        Style="{StaticResource SubtleButtonStyle}"
                                                                        ToolTip="Rename category"
                                                                        Command="{Binding DataContext.BeginRenameCommand, RelativeSource={RelativeSource AncestorType=ItemsControl}}"
                                                                        CommandParameter="{Binding}">
                                                                    <ui:SymbolIcon Symbol="Edit24"
                                                                                   FontSize="13"
                                                                                   Foreground="{DynamicResource TextSecondaryBrush}" />
                                                                </Button>

                                                                <!-- Delete -->
                                                                <Button Width="26"
                                                                        Height="26"
                                                                        Padding="0"
                                                                        Margin="1,0"
                                                                        Style="{StaticResource SubtleButtonStyle}"
                                                                        ToolTip="Delete category"
                                                                        Command="{Binding DataContext.RequestDeleteCommand, RelativeSource={RelativeSource AncestorType=ItemsControl}}"
                                                                        CommandParameter="{Binding}"
                                                                        IsEnabled="{Binding CanDelete}">
                                                                    <ui:SymbolIcon Symbol="Delete24"
                                                                                   FontSize="13"
                                                                                   Foreground="{DynamicResource TextSecondaryBrush}" />
                                                                </Button>
                                                            </StackPanel>
                                                        </Grid>

                                                        <!-- Delete Confirmation Row -->
                                                        <Grid x:Name="DeleteConfirmationGrid"
                                                              Height="38"
                                                              Background="#22E81123"
                                                              Visibility="Collapsed">
                                                            <Grid.ColumnDefinitions>
                                                                <ColumnDefinition Width="*" />
                                                                <ColumnDefinition Width="Auto" />
                                                            </Grid.ColumnDefinitions>

                                                            <StackPanel Grid.Column="0"
                                                                        Orientation="Horizontal"
                                                                        VerticalAlignment="Center"
                                                                        Margin="10,0,6,0">
                                                                <ui:SymbolIcon Symbol="Warning24"
                                                                               FontSize="14"
                                                                               Foreground="{DynamicResource StatusErrorBrush}"
                                                                               Margin="0,0,8,0"
                                                                               VerticalAlignment="Center" />
                                                                <TextBlock VerticalAlignment="Center"
                                                                           FontSize="{DynamicResource TypeCaptionFontSize}"
                                                                           Foreground="{DynamicResource TextPrimaryBrush}"
                                                                           TextTrimming="CharacterEllipsis">
                                                                    <TextBlock.Text>
                                                                        <MultiBinding StringFormat="Move {0} stations to {1}?">
                                                                            <Binding Path="StationCount" />
                                                                            <Binding Path="DeleteFallbackName" />
                                                                        </MultiBinding>
                                                                    </TextBlock.Text>
                                                                </TextBlock>
                                                            </StackPanel>

                                                            <StackPanel Grid.Column="1"
                                                                        Orientation="Horizontal"
                                                                        VerticalAlignment="Center"
                                                                        Margin="0,0,8,0">
                                                                <Button Content="Move &amp; Delete"
                                                                        Height="26"
                                                                        Padding="10,0"
                                                                        Margin="0,0,6,0"
                                                                        Style="{StaticResource AccentButtonStyle}"
                                                                        Background="{DynamicResource StatusErrorBrush}"
                                                                        Command="{Binding DataContext.ConfirmDeleteCommand, RelativeSource={RelativeSource AncestorType=ItemsControl}}"
                                                                        CommandParameter="{Binding}" />
                                                                <Button Content="Cancel"
                                                                        Height="26"
                                                                        Padding="10,0"
                                                                        Style="{StaticResource SubtleButtonStyle}"
                                                                        Command="{Binding DataContext.CancelDeleteCommand, RelativeSource={RelativeSource AncestorType=ItemsControl}}"
                                                                        CommandParameter="{Binding}" />
                                                            </StackPanel>
                                                        </Grid>
                                                    </Grid>
                                                </Border>

                                                <DataTemplate.Triggers>
                                                    <DataTrigger Binding="{Binding IsPendingDelete}" Value="True">
                                                        <Setter TargetName="NormalRowGrid" Property="Visibility" Value="Collapsed" />
                                                        <Setter TargetName="DeleteConfirmationGrid" Property="Visibility" Value="Visible" />
                                                    </DataTrigger>
                                                    <DataTrigger Binding="{Binding IsRenaming}" Value="True">
                                                        <Setter TargetName="CategoryNameTextBlock" Property="Visibility" Value="Collapsed" />
                                                        <Setter TargetName="InlineRenameTextBox" Property="Visibility" Value="Visible" />
                                                    </DataTrigger>
                                                </DataTemplate.Triggers>
                                            </DataTemplate>
                                        </ItemsControl.ItemTemplate>
                                    </ItemsControl>
                                </ScrollViewer>
                            </Border>

                            <!-- Row Icon Picker Popup (StaysOpen="False", 4x4 Grid) -->
                            <Popup x:Name="RowIconPickerPopup"
                                   StaysOpen="False"
                                   Placement="Bottom"
                                   AllowsTransparency="True">
                                <Border Background="{DynamicResource DialogPanelBackground}"
                                        BorderBrush="{DynamicResource SurfaceBorderBrush}"
                                        BorderThickness="1"
                                        CornerRadius="{DynamicResource ControlCornerRadius}"
                                        Padding="6"
                                        Margin="0,4,0,0">
                                    <ItemsControl ItemsSource="{Binding CuratedIcons}">
                                        <ItemsControl.ItemsPanel>
                                            <ItemsPanelTemplate>
                                                <UniformGrid Columns="4" Rows="4" />
                                            </ItemsPanelTemplate>
                                        </ItemsControl.ItemsPanel>
                                        <ItemsControl.ItemTemplate>
                                            <DataTemplate>
                                                <Button Width="32" Height="32"
                                                        Margin="2"
                                                        Style="{StaticResource SubtleButtonStyle}"
                                                        ToolTip="{Binding Key}"
                                                        Click="OnRowIconPickerItemClick">
                                                    <ui:SymbolIcon Symbol="{Binding Symbol}"
                                                                   FontSize="16"
                                                                   Foreground="{DynamicResource TextPrimaryBrush}" />
                                                </Button>
                                            </DataTemplate>
                                        </ItemsControl.ItemTemplate>
                                    </ItemsControl>
                                </Border>
                            </Popup>
                        </Grid>

                    </Grid>

                    <!-- Footer: Target Category Selector & Action Button -->
                    <Grid Grid.Row="1" x:Name="DialogFooterPanel" Margin="0,14,0,0">
                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center">
                            <TextBlock Text="Category:"
                                       FontSize="{DynamicResource TypeCaptionFontSize}"
                                       FontWeight="Normal"
                                       Foreground="{DynamicResource TextSecondaryBrush}"
                                       VerticalAlignment="Center"
                                       Margin="0,0,8,0" />
                            <ComboBox x:Name="RadioCategoryComboBox"
                                      Height="32"
                                      DisplayMemberPath="DisplayName"
                                      SelectedValuePath="Id"
                                      FocusVisualStyle="{x:Null}"
                                      VerticalAlignment="Center"
                                      Margin="0,0,12,0" />
                            <Button x:Name="PrimaryActionButton"
                                    Style="{DynamicResource AccentButtonStyle}"
                                    Content="Add Station"
                                    IsDefault="True"
                                    Click="OnPrimaryActionButtonClick" />
                        </StackPanel>
                    </Grid>
    </Grid>
</dialogs:MetroDialog>
