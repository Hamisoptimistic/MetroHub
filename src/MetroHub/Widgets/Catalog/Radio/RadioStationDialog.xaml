<dialogs:MetroDialog x:Class="MetroHub.Presentation.Controls.RadioStationDialog"
                     xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                     xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                     xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
                     xmlns:controls="clr-namespace:MetroHub.Presentation.Controls"
                     xmlns:dialogs="clr-namespace:MetroHub.Presentation.Dialogs"
                     Title="Add Radio Station"
                     Width="620"
                     Height="420">

    <dialogs:MetroDialog.SidebarContent>
        <Grid HorizontalAlignment="Center" VerticalAlignment="Center">
            <Ellipse Width="80" Height="80" Fill="#184A90E2">
                <Ellipse.Effect>
                    <BlurEffect Radius="20" />
                </Ellipse.Effect>
            </Ellipse>
            <ui:SymbolIcon Symbol="HeadphonesSoundWave24"
                           FontSize="56"
                           Foreground="{DynamicResource TextSecondaryBrush}"
                           HorizontalAlignment="Center"
                           VerticalAlignment="Center" />
        </Grid>
    </dialogs:MetroDialog.SidebarContent>

    <Window.Resources>

        <Style x:Key="FluentSegmentedTabRadioButtonStyle" TargetType="RadioButton">
            <Setter Property="OverridesDefaultStyle" Value="True" />
            <Setter Property="FocusVisualStyle" Value="{x:Null}" />
            <Setter Property="Height" Value="28" />
            <Setter Property="FontSize" Value="{DynamicResource TypeCaptionFontSize}" />
            <Setter Property="FontWeight" Value="{DynamicResource TypeCaptionFontWeight}" />
            <Setter Property="Foreground" Value="#80FFFFFF" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="HorizontalContentAlignment" Value="Center" />
            <Setter Property="VerticalContentAlignment" Value="Center" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="RadioButton">
                        <Border x:Name="TabBorder"
                                Background="Transparent"
                                CornerRadius="{DynamicResource ControlCornerRadius}"
                                Padding="14,0"
                                >
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="TabBorder" Property="Background" Value="#15FFFFFF" />
                                <Setter Property="Foreground" Value="#B0FFFFFF" />
                            </Trigger>
                            <Trigger Property="IsChecked" Value="True">
                                <Setter TargetName="TabBorder" Property="Background" Value="#25FFFFFF" />
                                <Setter Property="Foreground" Value="{DynamicResource TextPrimaryBrush}" />
                                <Setter Property="FontWeight" Value="{DynamicResource TypeBodyStrongFontWeight}" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="SuggestionListBoxItemStyle" TargetType="ListBoxItem">
            <Setter Property="OverridesDefaultStyle" Value="True" />
            <Setter Property="FocusVisualStyle" Value="{x:Null}" />
            <Setter Property="Padding" Value="10,6,10,6" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ListBoxItem">
                        <Border x:Name="ItemBorder"
                                Background="Transparent"
                                CornerRadius="{DynamicResource ControlCornerRadius}"
                                Margin="2,1,2,1"
                                Padding="{TemplateBinding Padding}"
                                >
                            <ContentPresenter />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="ItemBorder" Property="Background" Value="#1CFFFFFF" />
                            </Trigger>
                            <Trigger Property="IsSelected" Value="True">
                                <Setter TargetName="ItemBorder" Property="Background" Value="#2AFFFFFF" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <DataTemplate x:Key="RadioSearchResultItemTemplate">
            <Grid Margin="0,3">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <StackPanel Grid.Column="0" VerticalAlignment="Center">
                    <TextBlock Text="{Binding Name}"
                               FontSize="{DynamicResource TypeBodyFontSize}"
                               FontWeight="{DynamicResource TypeBodyStrongFontWeight}"
                               Foreground="{DynamicResource TextPrimaryBrush}"
                               TextTrimming="CharacterEllipsis" />
                    <TextBlock Text="{Binding Subtitle}"
                               FontSize="{DynamicResource TypeCaptionFontSize}"
                               FontWeight="{DynamicResource TypeCaptionFontWeight}"
                               Foreground="{DynamicResource TextSubtleBrush}"
                               Margin="0,2,0,0"
                               TextTrimming="CharacterEllipsis" />
                </StackPanel>
                <Border Grid.Column="1"
                        Background="#15FFFFFF"
                        CornerRadius="{DynamicResource ControlCornerRadius}"
                        Padding="6,2"
                        VerticalAlignment="Center"
                        Margin="8,0,0,0">
                    <TextBlock Text="{Binding BitrateDisplay}"
                               FontSize="{DynamicResource TypeCaptionFontSize}"
                               FontWeight="{DynamicResource TypeCaptionFontWeight}"
                               Foreground="{DynamicResource TextMutedBrush}" />
                </Border>
            </Grid>
        </DataTemplate>
    </Window.Resources>

    <!-- Dark Obsidian Form Content Slot -->
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <!-- Body: Radio Station Form -->
        <Grid Grid.Row="0">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="*" />
                            <RowDefinition Height="Auto" />
                        </Grid.RowDefinitions>

                        <!-- Two-Tab Segmented Selector -->
                        <Border Grid.Row="0"
                                Background="#12FFFFFF"
                                CornerRadius="{DynamicResource ControlCornerRadius}"
                                Padding="2"
                                HorizontalAlignment="Left"
                                Margin="0,0,0,10">
                            <StackPanel Orientation="Horizontal">
                                <RadioButton x:Name="RadioSearchTabRadio"
                                             Style="{StaticResource FluentSegmentedTabRadioButtonStyle}"
                                             GroupName="RadioAddTabs"
                                             Content="Search Stations"
                                             IsChecked="True"
                                             Checked="OnRadioTabChanged" />
                                <RadioButton x:Name="RadioDirectTabRadio"
                                             Style="{StaticResource FluentSegmentedTabRadioButtonStyle}"
                                             GroupName="RadioAddTabs"
                                             Content="Direct Stream URL"
                                             Checked="OnRadioTabChanged" />
                            </StackPanel>
                        </Border>

                        <!-- TAB 1: Search Stations Panel -->
                        <Grid Grid.Row="1" x:Name="RadioSearchPanel" Visibility="Visible">
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="*" />
                                <RowDefinition Height="Auto" />
                            </Grid.RowDefinitions>

                            <!-- Search Input Box with Overlay Watermark & Spinner -->
                            <Grid Grid.Row="0">
                                <TextBox x:Name="RadioSearchInput"
                                         Style="{DynamicResource FluentGlassSearchInputStyle}"
                                         TextChanged="OnRadioSearchInputTextChanged"
                                         PreviewKeyDown="OnRadioSearchInputKeyDown" />
                                <TextBlock x:Name="RadioSearchWatermark"
                                           Text="Search station name, genre (e.g. lofi, jazz, ambient)..."
                                           FontSize="{DynamicResource TypeBodyFontSize}"
                                           FontWeight="{DynamicResource TypeBodyFontWeight}"
                                           Foreground="{DynamicResource TextSubtleBrush}"
                                           IsHitTestVisible="False"
                                           VerticalAlignment="Center"
                                           Margin="34,0,10,0" />
                                <ui:ProgressRing x:Name="RadioSearchSpinner"
                                                 Width="14" Height="14"
                                                 IsIndeterminate="True"
                                                 HorizontalAlignment="Right"
                                                 VerticalAlignment="Center"
                                                 Margin="0,0,10,0"
                                                 Visibility="Collapsed" />
                            </Grid>

                            <!-- Search Results List -->
                            <Border Grid.Row="1"
                                    Background="{DynamicResource WidgetDividerBrush}"
                                    BorderBrush="#25FFFFFF"
                                    BorderThickness="1"
                                    CornerRadius="{DynamicResource ControlCornerRadius}"
                                    Margin="0,8,0,0"
                                    >
                                <Grid>
                                    <ListBox x:Name="RadioSearchResultsList"
                                             Background="Transparent"
                                             BorderThickness="0"
                                             Padding="2"
                                             ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                                             ScrollViewer.VerticalScrollBarVisibility="Auto"
                                             controls:AutoHideScrollBehavior.IsEnabled="True"
                                             ItemContainerStyle="{StaticResource SuggestionListBoxItemStyle}"
                                             ItemTemplate="{StaticResource RadioSearchResultItemTemplate}"
                                             SelectionChanged="OnRadioSearchResultsSelectionChanged">
                                        <ListBox.Resources>
                                            <Style TargetType="{x:Type ScrollBar}" BasedOn="{StaticResource WidgetFloatingScrollBarStyle}" />
                                        </ListBox.Resources>
                                    </ListBox>

                                    <!-- Search Initial Hint / Empty Text -->
                                    <TextBlock x:Name="RadioSearchPlaceholderText"
                                               Text="Type 2 or more characters to search 40,000+ online stations"
                                               FontSize="{DynamicResource TypeCaptionFontSize}"
                                               FontWeight="{DynamicResource TypeCaptionFontWeight}"
                                               Foreground="{DynamicResource TextSubtleBrush}"
                                               HorizontalAlignment="Center"
                                               VerticalAlignment="Center"
                                               IsHitTestVisible="False"
                                               Visibility="Visible" />
                                </Grid>
                            </Border>

                            <!-- Search Status Message -->
                            <TextBlock Grid.Row="2"
                                       x:Name="RadioSearchStatusMessage"
                                       FontSize="{DynamicResource TypeCaptionFontSize}"
                                       FontWeight="{DynamicResource TypeCaptionFontWeight}"
                                       Foreground="{DynamicResource StatusErrorBrush}"
                                       Margin="0,6,0,0"
                                       TextWrapping="Wrap"
                                       Visibility="Collapsed" />
                        </Grid>

                        <!-- TAB 2: Direct Stream URL Panel -->
                        <Grid Grid.Row="1" x:Name="RadioDirectPanel" Visibility="Collapsed">
                            <StackPanel>
                                <TextBlock Text="Audio Stream URL"
                                           FontSize="{DynamicResource TypeCaptionFontSize}"
                                           FontWeight="{DynamicResource TypeCaptionFontWeight}"
                                           Foreground="{DynamicResource TextMutedBrush}"
                                           Margin="0,0,0,6" />

                                <Grid>
                                    <TextBox x:Name="RadioDirectUrlInput"
                                             Style="{DynamicResource FluentGlassUrlWithPasteInputStyle}"
                                             TextChanged="OnRadioDirectUrlTextChanged"
                                             KeyDown="OnRadioDirectInputKeyDown" />
                                    <Button HorizontalAlignment="Right"
                                            VerticalAlignment="Center"
                                            Style="{DynamicResource FluentCohesiveSecondaryButtonStyle}"
                                            Height="26"
                                            Margin="0,0,5,0"
                                            Padding="8,2"
                                            Click="OnRadioDirectPasteClick">
                                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                            <ui:SymbolIcon Symbol="ClipboardPaste24" FontSize="12" Margin="0,0,5,0" VerticalAlignment="Center" />
                                            <TextBlock Text="Paste"
                                                       FontSize="{DynamicResource TypeCaptionFontSize}"
                                                       FontWeight="{DynamicResource TypeCaptionFontWeight}"
                                                       VerticalAlignment="Center" />
                                        </StackPanel>
                                    </Button>
                                </Grid>

                                <StackPanel Orientation="Horizontal" Margin="0,6,0,0" MinHeight="18">
                                    <ui:ProgressRing x:Name="RadioProbeSpinner"
                                                     Width="12" Height="12"
                                                     IsIndeterminate="True"
                                                     Visibility="Collapsed"
                                                     Margin="0,0,6,0" />
                                    <ui:SymbolIcon x:Name="RadioProbeIcon"
                                                   Symbol="Checkmark24"
                                                   FontSize="13"
                                                   Visibility="Collapsed"
                                                   Margin="0,0,6,0"
                                                   VerticalAlignment="Center" />
                                    <TextBlock x:Name="RadioProbeStatusText"
                                               Text="Supports MP3/AAC/OGG streams or single-station .pls/.m3u"
                                               FontSize="{DynamicResource TypeCaptionFontSize}"
                                               FontWeight="{DynamicResource TypeCaptionFontWeight}"
                                               Foreground="{DynamicResource TextSubtleBrush}"
                                               VerticalAlignment="Center" />
                                </StackPanel>

                                <TextBlock Text="Station Name"
                                           FontSize="{DynamicResource TypeCaptionFontSize}"
                                           FontWeight="{DynamicResource TypeCaptionFontWeight}"
                                           Foreground="{DynamicResource TextMutedBrush}"
                                           Margin="0,8,0,6" />
                                <TextBox x:Name="RadioDirectNameInput"
                                         Style="{DynamicResource FluentGlassInputStyle}"
                                         TextChanged="OnRadioDirectNameTextChanged"
                                         KeyDown="OnRadioDirectInputKeyDown" />

                                <TextBlock x:Name="RadioDirectStatusMessage"
                                           FontSize="{DynamicResource TypeCaptionFontSize}"
                                           FontWeight="{DynamicResource TypeCaptionFontWeight}"
                                           Foreground="{DynamicResource StatusErrorBrush}"
                                           Margin="0,6,0,0"
                                           TextWrapping="Wrap"
                                           Visibility="Collapsed" />
                            </StackPanel>
                        </Grid>

                        <!-- Target Category Selector -->
                        <StackPanel Grid.Row="2" Orientation="Horizontal" VerticalAlignment="Center" Margin="0,8,0,0">
                            <TextBlock Text="Category:"
                                       FontSize="{DynamicResource TypeCaptionFontSize}"
                                       FontWeight="{DynamicResource TypeCaptionFontWeight}"
                                       Foreground="{DynamicResource TextMutedBrush}"
                                       VerticalAlignment="Center"
                                       Margin="0,0,12,0" />
                            <RadioButton x:Name="RadioCatAmbient"
                                         Style="{DynamicResource FluentGlassRadioButtonStyle}"
                                         GroupName="RadioCategoryTarget"
                                         IsChecked="True"
                                         Margin="0,0,14,0">
                                <TextBlock Text="Ambient"
                                           FontSize="{DynamicResource TypeCaptionFontSize}"
                                           FontWeight="{DynamicResource TypeCaptionFontWeight}"
                                           Foreground="{DynamicResource TextMutedBrush}"
                                           VerticalAlignment="Center" />
                            </RadioButton>
                            <RadioButton x:Name="RadioCatNature"
                                         Style="{DynamicResource FluentGlassRadioButtonStyle}"
                                         GroupName="RadioCategoryTarget"
                                         Margin="0,0,14,0">
                                <TextBlock Text="Nature"
                                           FontSize="{DynamicResource TypeCaptionFontSize}"
                                           FontWeight="{DynamicResource TypeCaptionFontWeight}"
                                           Foreground="{DynamicResource TextMutedBrush}"
                                           VerticalAlignment="Center" />
                            </RadioButton>
                            <RadioButton x:Name="RadioCatLofi"
                                         Style="{DynamicResource FluentGlassRadioButtonStyle}"
                                         GroupName="RadioCategoryTarget"
                                         Margin="0,0,14,0">
                                <TextBlock Text="Lo-Fi"
                                           FontSize="{DynamicResource TypeCaptionFontSize}"
                                           FontWeight="{DynamicResource TypeCaptionFontWeight}"
                                           Foreground="{DynamicResource TextMutedBrush}"
                                           VerticalAlignment="Center" />
                            </RadioButton>
                            <RadioButton x:Name="RadioCatCoding"
                                         Style="{DynamicResource FluentGlassRadioButtonStyle}"
                                         GroupName="RadioCategoryTarget">
                                <TextBlock Text="Coding"
                                           FontSize="{DynamicResource TypeCaptionFontSize}"
                                           FontWeight="{DynamicResource TypeCaptionFontWeight}"
                                           Foreground="{DynamicResource TextMutedBrush}"
                                           VerticalAlignment="Center" />
                            </RadioButton>
                        </StackPanel>
                    </Grid>

                    <!-- Footer: Action Button -->
                    <Grid Grid.Row="1" Margin="0,14,0,0">
                        <Button x:Name="PrimaryActionButton"
                                Style="{DynamicResource FluentCohesivePrimaryButtonStyle}"
                                Content="Add Station"
                                IsDefault="True"
                                HorizontalAlignment="Right"
                                Click="OnPrimaryActionButtonClick" />
                    </Grid>
    </Grid>
</dialogs:MetroDialog>
