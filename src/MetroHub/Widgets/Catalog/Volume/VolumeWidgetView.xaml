<UserControl x:Class="MetroHub.Widgets.Catalog.Volume.VolumeWidgetView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:widgets="clr-namespace:MetroHub.Widgets"
             xmlns:volume="clr-namespace:MetroHub.Widgets.Catalog.Volume"
             xmlns:controls="clr-namespace:MetroHub.Presentation.Controls"
             mc:Ignorable="d" 
             d:DataContext="{d:DesignInstance Type=volume:VolumeWidgetViewModel}"
             Focusable="False"
             SnapsToDevicePixels="True"
             UseLayoutRounding="True"
             TextOptions.TextFormattingMode="Ideal"
             TextOptions.TextRenderingMode="Grayscale"
             TextOptions.TextHintingMode="Animated">

    <UserControl.Resources>
        <BooleanToVisibilityConverter x:Key="BoolToVis" />

        <!-- Media & Pomodoro-Consistent Transport Button Style: Borderless, Transparent, 2px Corner Radius -->
        <Style x:Key="VolumeTransportButtonStyle" TargetType="Button">
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="Foreground" Value="#FFFFFF" />
            <Setter Property="Width" Value="28" />
            <Setter Property="Height" Value="28" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Focusable" Value="False" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Border"
                                Background="{TemplateBinding Background}"
                                CornerRadius="2"
                                SnapsToDevicePixels="True">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Border" Property="Background" Value="#25FFFFFF" />
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="Border" Property="Background" Value="#45FFFFFF" />
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter Property="Opacity" Value="0.3" />
                                <Setter Property="Cursor" Value="Arrow" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Windows 11 Sound Output Device List Item Button Style -->
        <Style x:Key="DeviceListItemButtonStyle" TargetType="Button">
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="Foreground" Value="#FFFFFF" />
            <Setter Property="Height" Value="36" />
            <Setter Property="Margin" Value="0,2,0,2" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Focusable" Value="False" />
            <Setter Property="HorizontalContentAlignment" Value="Stretch" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="CardBorder"
                                Background="{TemplateBinding Background}"
                                CornerRadius="4"
                                SnapsToDevicePixels="True">
                            <ContentPresenter Margin="0" VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="CardBorder" Property="Background" Value="#18FFFFFF" />
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="CardBorder" Property="Background" Value="#28FFFFFF" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Minimalist 6px Transparent Scrollbar for Device List (Zero Borders) -->
        <Style x:Key="MinimalScrollViewerStyle" TargetType="ScrollViewer">
            <Setter Property="OverridesDefaultStyle" Value="True" />
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="BorderBrush" Value="Transparent" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="HorizontalScrollBarVisibility" Value="Disabled" />
            <Setter Property="VerticalScrollBarVisibility" Value="Auto" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ScrollViewer">
                        <Grid Background="Transparent" SnapsToDevicePixels="True">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <ScrollContentPresenter Grid.Column="0" CanContentScroll="{TemplateBinding CanContentScroll}" />
                            <ScrollBar Grid.Column="1"
                                       x:Name="PART_VerticalScrollBar"
                                       Width="6"
                                       Value="{TemplateBinding VerticalOffset}"
                                       Maximum="{TemplateBinding ScrollableHeight}"
                                       ViewportSize="{TemplateBinding ViewportHeight}"
                                       Visibility="{TemplateBinding ComputedVerticalScrollBarVisibility}" />
                        </Grid>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </UserControl.Resources>

    <!-- Transparent WidgetCard with Padding="0" so dividers run border-to-border (like Focus Timer & Media Player) -->
    <widgets:WidgetCard Padding="0" Background="Transparent" CornerRadius="2">
        <Grid SnapsToDevicePixels="True" UseLayoutRounding="True" ClipToBounds="True" Background="Transparent">
            <Grid.RowDefinitions>
                <!-- Row 0: Top Master Audio Strip (Output Logo + Master Seekbar + Mute Button) -->
                <RowDefinition Height="50" />
                <!-- Row 1: Output Device Section with Edge-to-Edge Divider matching Focus Timer -->
                <RowDefinition Height="*" />
            </Grid.RowDefinitions>

            <!-- ============================================================= -->
            <!-- ROW 0: TOP MASTER AUDIO STRIP                                 -->
            <!-- [ 🎧 Logo ] =========== Seekbar =========== [ 🔊 Mute ]       -->
            <!-- Flush aligned to 14px horizontal baseline standard            -->
            <!-- ============================================================= -->
            <Grid Grid.Row="0" Margin="14,0,14,0" Background="Transparent" VerticalAlignment="Center">
                <Grid.ColumnDefinitions>
                    <!-- Col 0: Output Logo Icon (Borderless, White, No Box) -->
                    <ColumnDefinition Width="Auto" />
                    <!-- Col 1: Master Volume Seekbar -->
                    <ColumnDefinition Width="*" />
                    <!-- Col 2: Mute Button (Borderless, White, No Box) -->
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <!-- 1. Output Logo (White, Borderless, No Box, Aligned to 14px) -->
                <Button Grid.Column="0"
                        Style="{StaticResource VolumeTransportButtonStyle}"
                        HorizontalAlignment="Left"
                        ToolTip="{Binding ActiveDeviceName}"
                        Cursor="Arrow">
                    <TextBlock Text="{Binding ActiveDeviceIcon}"
                               FontFamily="Segoe MDL2 Assets"
                               FontSize="16"
                               Foreground="#FFFFFF"
                               VerticalAlignment="Center"
                               HorizontalAlignment="Center" />
                </Button>

                <!-- 2. Master Volume Seekbar (With Dragging Percentage Floating Bubble) -->
                <controls:FluentVolumeSlider Grid.Column="1"
                                            Margin="12,0"
                                            VerticalAlignment="Center"
                                            Value="{Binding MasterVolume, Mode=TwoWay}"
                                            IsMuted="{Binding IsMasterMuted}"
                                            Minimum="0"
                                            Maximum="100"
                                            Tag="InteractiveControl"
                                            SnapsToDevicePixels="True" />

                <!-- 3. Mute Button (White, Borderless, No Box, Aligned to right 14px) -->
                <Button Grid.Column="2"
                        Style="{StaticResource VolumeTransportButtonStyle}"
                        HorizontalAlignment="Right"
                        Command="{Binding ToggleMasterMuteCommand}"
                        ToolTip="Mute / Unmute Master Volume">
                    <TextBlock Text="{Binding MasterGlyph}"
                               FontFamily="Segoe MDL2 Assets"
                               FontSize="16"
                               Foreground="#FFFFFF"
                               VerticalAlignment="Center"
                               HorizontalAlignment="Center" />
                </Button>
            </Grid>

            <!-- ============================================================= -->
            <!-- ROW 1: OUTPUT DEVICE SECTION                                  -->
            <!-- Edge-to-Edge Divider: BorderThickness="0,1,0,0" #18FFFFFF     -->
            <!-- Exactly matching Focus Timer (Pomodoro) and Media Player      -->
            <!-- ============================================================= -->
            <Border Grid.Row="1"
                    Background="#14000000"
                    BorderThickness="0,1,0,0"
                    BorderBrush="#18FFFFFF"
                    CornerRadius="0,0,2,2"
                    SnapsToDevicePixels="True"
                    Padding="14,10,14,10">
                <Border.Style>
                    <Style TargetType="Border">
                        <Setter Property="Visibility" Value="Visible" />
                        <Style.Triggers>
                            <DataTrigger Binding="{Binding IsCompactMode}" Value="True">
                                <Setter Property="Visibility" Value="Collapsed" />
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </Border.Style>

                <Grid Background="Transparent">
                    <Grid.RowDefinitions>
                        <!-- Row 1.0: OUTPUT DEVICE Header -->
                        <RowDefinition Height="Auto" />
                        <!-- Row 1.1: Device List -->
                        <RowDefinition Height="*" />
                    </Grid.RowDefinitions>

                    <!-- Section Header: OUTPUT DEVICE (Flush aligned with Output Logo above at 14px) -->
                    <TextBlock Grid.Row="0"
                               Text="OUTPUT DEVICE"
                               FontFamily="Segoe UI Variable Text, Segoe UI, sans-serif"
                               FontSize="10"
                               FontWeight="SemiBold"
                               Foreground="#80FFFFFF"
                               Margin="0,0,0,6"
                               SnapsToDevicePixels="True" />

                    <!-- Native Windows 11 Output Devices List -->
                    <ScrollViewer Grid.Row="1"
                                  Style="{StaticResource MinimalScrollViewerStyle}">
                        <ItemsControl ItemsSource="{Binding Devices}">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate DataType="{x:Type volume:AudioDeviceItemViewModel}">
                                    <Button Style="{StaticResource DeviceListItemButtonStyle}"
                                            Command="{Binding DataContext.SelectDeviceCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                            CommandParameter="{Binding}">
                                        <Button.Template>
                                            <ControlTemplate TargetType="Button">
                                                <Border x:Name="ItemBorder"
                                                        Background="Transparent"
                                                        CornerRadius="4"
                                                        SnapsToDevicePixels="True">
                                                    <Grid Margin="0,0,10,0">
                                                        <Grid.ColumnDefinitions>
                                                            <!-- Col 0: Active Accent Indicator Pill -->
                                                            <ColumnDefinition Width="6" />
                                                            <!-- Col 1: Hardware Device Glyph (WHITE) -->
                                                            <ColumnDefinition Width="28" />
                                                            <!-- Col 2: Device Friendly Name (WHITE) -->
                                                            <ColumnDefinition Width="*" />
                                                            <!-- Col 3: Active Checkmark (WHITE) -->
                                                            <ColumnDefinition Width="24" />
                                                        </Grid.ColumnDefinitions>

                                                        <!-- 1. Active Accent Pill (Left Vertical Indicator) -->
                                                        <Border Grid.Column="0"
                                                                Width="3"
                                                                Height="16"
                                                                HorizontalAlignment="Left"
                                                                Background="{DynamicResource SystemAccentColorPrimaryBrush}"
                                                                CornerRadius="1.5"
                                                                Visibility="{Binding IsDefault, Converter={StaticResource BoolToVis}}" />

                                                        <!-- 2. Hardware Device Glyph (🎧, 🖥, 🔊) ALL WHITE -->
                                                        <TextBlock Grid.Column="1"
                                                                   Text="{Binding IconGlyph}"
                                                                   FontFamily="Segoe MDL2 Assets"
                                                                   FontSize="15"
                                                                   Foreground="#FFFFFF"
                                                                   VerticalAlignment="Center"
                                                                   HorizontalAlignment="Left" />

                                                        <!-- 3. Device Friendly Name (WHITE) -->
                                                        <TextBlock Grid.Column="2"
                                                                   Text="{Binding Name}"
                                                                   FontFamily="Segoe UI Variable Text, Segoe UI, sans-serif"
                                                                   FontSize="12"
                                                                   FontWeight="Normal"
                                                                   Foreground="#FFFFFF"
                                                                   TextTrimming="CharacterEllipsis"
                                                                   VerticalAlignment="Center"
                                                                   Margin="2,0" />

                                                        <!-- 4. Active Selection Checkmark (WHITE) -->
                                                        <TextBlock Grid.Column="3"
                                                                   Text="&#xE73E;"
                                                                   FontFamily="Segoe MDL2 Assets"
                                                                   FontSize="13"
                                                                   Foreground="#FFFFFF"
                                                                   HorizontalAlignment="Right"
                                                                   VerticalAlignment="Center"
                                                                   Visibility="{Binding IsDefault, Converter={StaticResource BoolToVis}}" />
                                                    </Grid>
                                                </Border>
                                                <ControlTemplate.Triggers>
                                                    <!-- Selected / Default Device Highlight -->
                                                    <DataTrigger Binding="{Binding IsDefault}" Value="True">
                                                        <Setter TargetName="ItemBorder" Property="Background" Value="#1EFFFFFF" />
                                                    </DataTrigger>
                                                    <!-- Mouse Hover Highlight -->
                                                    <Trigger Property="IsMouseOver" Value="True">
                                                        <Setter TargetName="ItemBorder" Property="Background" Value="#25FFFFFF" />
                                                    </Trigger>
                                                    <!-- Mouse Pressed Highlight -->
                                                    <Trigger Property="IsPressed" Value="True">
                                                        <Setter TargetName="ItemBorder" Property="Background" Value="#35FFFFFF" />
                                                    </Trigger>
                                                </ControlTemplate.Triggers>
                                            </ControlTemplate>
                                        </Button.Template>
                                    </Button>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </ScrollViewer>
                </Grid>
            </Border>

            <!-- ========================================================================= -->
            <!-- PER-APP VOLUME MIXER (TEMPORARILY COMMENTED OUT - TO BE IMPLEMENTED LATER) -->
