<UserControl x:Class="MetroHub.Widgets.Catalog.AudioControls.AudioControlsWidgetView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:widgets="clr-namespace:MetroHub.Widgets"
             xmlns:audiocontrols="clr-namespace:MetroHub.Widgets.Catalog.AudioControls"
             xmlns:controls="clr-namespace:MetroHub.Presentation.Controls"
             mc:Ignorable="d" 
             d:DataContext="{d:DesignInstance Type=audiocontrols:AudioControlsWidgetViewModel}"
             Focusable="False"
             SnapsToDevicePixels="True"
             UseLayoutRounding="True"
             TextOptions.TextFormattingMode="Ideal"
             TextOptions.TextRenderingMode="ClearType"
             TextOptions.TextHintingMode="Fixed"
             RenderOptions.ClearTypeHint="Enabled">

    <UserControl.Resources>
        <BooleanToVisibilityConverter x:Key="BoolToVis" />

        <!-- Media & Pomodoro-Consistent Transport Button Style: Borderless, Transparent, 2px Corner Radius -->
        <Style x:Key="VolumeTransportButtonStyle" TargetType="Button">
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="Foreground" Value="#FFFFFF" />
            <Setter Property="Width" Value="28" />
            <Setter Property="Height" Value="28" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Focusable" Value="False" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Border"
                                Background="{TemplateBinding Background}"
                                CornerRadius="2"
                                SnapsToDevicePixels="True">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Border" Property="Background" Value="#25FFFFFF" />
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="Border" Property="Background" Value="#45FFFFFF" />
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter Property="Opacity" Value="0.3" />
                                <Setter Property="Cursor" Value="Arrow" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Windows 11 Sound Output Device List Item Button Style -->
        <Style x:Key="DeviceListItemButtonStyle" TargetType="Button">
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="Foreground" Value="#FFFFFF" />
            <Setter Property="Height" Value="38" />
            <Setter Property="Margin" Value="0,2,0,2" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Focusable" Value="False" />
            <Setter Property="HorizontalContentAlignment" Value="Stretch" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="CardBorder"
                                Background="{TemplateBinding Background}"
                                CornerRadius="2"
                                SnapsToDevicePixels="True">
                            <ContentPresenter Margin="0" VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="CardBorder" Property="Background" Value="#18FFFFFF" />
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="CardBorder" Property="Background" Value="#28FFFFFF" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Universal 4px Fluent Floating ScrollBar: Invisible by default, reveals on scroll/hover via AutoHideScrollBehavior -->
        <Style TargetType="{x:Type ScrollBar}" BasedOn="{StaticResource WidgetFloatingScrollBarStyle}" />

    </UserControl.Resources>

    <!-- Transparent WidgetCard with Padding="0" so dividers run border-to-border (like Focus Timer & Media Player) -->
    <widgets:WidgetCard Padding="0" Background="Transparent" CornerRadius="2">
        <Grid SnapsToDevicePixels="True" UseLayoutRounding="True" ClipToBounds="True" Background="Transparent">
            <Grid.RowDefinitions>
                <!-- Row 0: Top Master Audio Strip (Output Logo + Master Seekbar + Mute Button) -->
                <RowDefinition Height="50" />
                <!-- Row 1: Output Device Section with Edge-to-Edge Divider matching Focus Timer -->
                <RowDefinition Height="*" />
            </Grid.RowDefinitions>

            <!-- ============================================================= -->
            <!-- ROW 0: TOP MASTER AUDIO STRIP                                 -->
            <!-- [ 🎧 Logo ] =========== Seekbar =========== [ 🔊 Mute ]       -->
            <!-- Flush aligned to 14px horizontal baseline standard            -->
            <!-- ============================================================= -->
            <Grid Grid.Row="0" Margin="14,0,14,0" Background="Transparent" VerticalAlignment="Center">
                <Grid.Style>
                    <Style TargetType="Grid">
                        <Setter Property="Grid.RowSpan" Value="1" />
                        <Style.Triggers>
                            <DataTrigger Binding="{Binding IsCompactMode}" Value="True">
                                <Setter Property="Grid.RowSpan" Value="2" />
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </Grid.Style>
                <Grid.ColumnDefinitions>
                    <!-- Col 0: Output Logo Icon (Borderless, White, No Box) -->
                    <ColumnDefinition Width="Auto" />
                    <!-- Col 1: Master Volume Seekbar -->
                    <ColumnDefinition Width="*" />
                    <!-- Col 2: Mute Button (Borderless, White, No Box) -->
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <!-- 1. Output Logo (White, Borderless, No Box, Aligned to 14px) -->
                <Button Grid.Column="0"
                        Style="{StaticResource VolumeTransportButtonStyle}"
                        HorizontalAlignment="Left"
                        Command="{Binding ToggleNextDeviceCommand}"
                        ToolTip="{Binding ActiveDeviceName}">
                    <TextBlock Text="{Binding ActiveDeviceIcon}"
                               FontFamily="{DynamicResource AppIconFontFamily}"
                               FontSize="16"
                               Foreground="#FFFFFF"
                               VerticalAlignment="Center"
                               HorizontalAlignment="Center" />
                </Button>

                <!-- 2. Master Volume Seekbar -->
                <controls:FluentVolumeSlider x:Name="MasterVolumeSlider"
                                            Grid.Column="1"
                                            Margin="12,0"
                                            VerticalAlignment="Center"
                                            Value="{Binding MasterVolume, Mode=TwoWay}"
                                            IsMuted="{Binding IsMasterMuted}"
                                            Minimum="0"
                                            Maximum="100"
                                            ProgressBrush="#00B4D8"
                                            ProgressPointerOverBrush="#33C9E8"
                                            Tag="InteractiveControl"
                                            SnapsToDevicePixels="True" />

                <!-- 3. Mute Button: Displays Speaker Glyph normally, Cross-fades to % while dragging/scrolling -->
                <Button Grid.Column="2"
                        Style="{StaticResource VolumeTransportButtonStyle}"
                        HorizontalAlignment="Right"
                        Command="{Binding ToggleMasterMuteCommand}"
                        ToolTip="Mute / Unmute Master Volume"
                        MinWidth="34">
                    <Grid HorizontalAlignment="Center" VerticalAlignment="Center">
                        <!-- 1. Speaker / Mute Glyph Icon -->
                        <TextBlock x:Name="MuteIcon"
                                   Text="{Binding MasterGlyph}"
                                   FontFamily="{DynamicResource AppIconFontFamily}"
                                   FontSize="15"
                                   Foreground="#FFFFFF"
                                   VerticalAlignment="Center"
                                   HorizontalAlignment="Center">
                            <TextBlock.Style>
                                <Style TargetType="TextBlock">
                                    <Setter Property="Visibility" Value="Visible" />
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding IsDragging, ElementName=MasterVolumeSlider}" Value="True">
                                            <Setter Property="Visibility" Value="Collapsed" />
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </TextBlock.Style>
                        </TextBlock>

                        <!-- 2. Volume Percentage Number (e.g. 76%) Shown While Dragging -->
                        <TextBlock x:Name="VolumePercentageText"
                                   Text="{Binding MasterVolumePercentText}"
                                   FontSize="11.5"
                                   FontWeight="SemiBold"
                                   Foreground="#FFFFFF"
                                   VerticalAlignment="Center"
                                   HorizontalAlignment="Center">
                            <TextBlock.Style>
                                <Style TargetType="TextBlock">
                                    <Setter Property="Visibility" Value="Collapsed" />
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding IsDragging, ElementName=MasterVolumeSlider}" Value="True">
                                            <Setter Property="Visibility" Value="Visible" />
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </TextBlock.Style>
                        </TextBlock>
                    </Grid>
                </Button>
            </Grid>

            <!-- ============================================================= -->
            <!-- ROW 1: OUTPUT DEVICE SECTION + SEPARATOR                      -->
            <!-- Completely Collapsed in 1-Row Compact Mode (4x1 and 8x1)      -->
            <!-- ============================================================= -->
            <Grid Grid.Row="1">
                <Grid.Style>
                    <Style TargetType="Grid">
                        <Setter Property="Visibility" Value="Visible" />
                        <Style.Triggers>
                            <DataTrigger Binding="{Binding IsCompactMode}" Value="True">
                                <Setter Property="Visibility" Value="Collapsed" />
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </Grid.Style>

                <!-- 1. Docked Output Device List Container -->
                <Border Background="#14000000"
                        BorderThickness="0"
                        CornerRadius="0,0,2,2"
                        SnapsToDevicePixels="True"
                        Padding="14,14,14,12">

                <Grid Background="Transparent">
                    <Grid.RowDefinitions>
                        <!-- Row 1.0: OUTPUT DEVICE Header -->
                        <RowDefinition Height="Auto" />
                        <!-- Row 1.1: Device List -->
                        <RowDefinition Height="*" />
                    </Grid.RowDefinitions>

                    <!-- Section Header: Output Device -->
                    <TextBlock Grid.Row="0"
                               Text="Output Device"
                               FontSize="12"
                               FontWeight="SemiBold"
                               Foreground="#FFFFFF"
                               Margin="6,2,0,8"
                               SnapsToDevicePixels="True" />

                    <!-- Native Windows 11 Output Devices List with 4px AutoHide ScrollBar -->
                    <ScrollViewer Grid.Row="1"
                                  Style="{StaticResource WidgetFloatingScrollViewerStyle}"
                                  Padding="0,0,8,0">
                        <ItemsControl ItemsSource="{Binding Devices}">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate DataType="{x:Type audiocontrols:AudioDeviceItemViewModel}">
                                    <Button Style="{StaticResource DeviceListItemButtonStyle}"
                                            Command="{Binding DataContext.SelectDeviceCommand, RelativeSource={RelativeSource AncestorType={x:Type audiocontrols:AudioControlsWidgetView}}}"
                                            CommandParameter="{Binding}">
                                        <Button.Template>
                                            <ControlTemplate TargetType="Button">
                                                <Border x:Name="ItemBorder"
                                                        Background="Transparent"
                                                        CornerRadius="2"
                                                        SnapsToDevicePixels="True">
                                                    <Grid Margin="0,0,10,0">
                                                        <Grid.ColumnDefinitions>
                                                            <!-- Col 0: Active Accent Indicator Pill (Width 12 provides 9px breathing space from 3px pill to icon) -->
                                                            <ColumnDefinition Width="12" />
                                                            <!-- Col 1: Hardware Device Glyph (WHITE) -->
                                                            <ColumnDefinition Width="24" />
                                                            <!-- Col 2: Device Friendly Name (WHITE) -->
                                                            <ColumnDefinition Width="*" />
                                                            <!-- Col 3: Active Checkmark (WHITE) -->
                                                            <ColumnDefinition Width="24" />
                                                        </Grid.ColumnDefinitions>

                                                        <!-- 1. Active Accent Pill (Left Vertical Indicator) -->
                                                        <Border Grid.Column="0"
                                                                Width="3"
                                                                Height="16"
                                                                HorizontalAlignment="Left"
                                                                Background="{DynamicResource SystemAccentColorPrimaryBrush}"
                                                                CornerRadius="1.5"
                                                                Visibility="{Binding IsDefault, Converter={StaticResource BoolToVis}}" />

                                                        <!-- 2. Hardware Device Glyph (🎧, 🖥, 🔊) ALL WHITE -->
                                                        <TextBlock Grid.Column="1"
                                                                   Text="{Binding IconGlyph}"
                                                                   FontFamily="{DynamicResource AppIconFontFamily}"
                                                                   FontSize="16"
                                                                   Foreground="#FFFFFF"
                                                                   VerticalAlignment="Center"
                                                                   HorizontalAlignment="Left" />

                                                        <!-- 3. Device Friendly Name (WHITE) -->
                                                        <TextBlock Grid.Column="2"
                                                                   Text="{Binding Name}"
                                                                   FontSize="13"
                                                                   FontWeight="Normal"
                                                                   Foreground="#FFFFFF"
                                                                   TextTrimming="CharacterEllipsis"
                                                                   VerticalAlignment="Center"
                                                                   Margin="2,0" />

                                                        <!-- 4. Active Selection Checkmark (WHITE) -->
                                                        <TextBlock Grid.Column="3"
                                                                   Text="&#xE73E;"
                                                                   FontFamily="{DynamicResource AppIconFontFamily}"
                                                                   FontSize="13"
                                                                   Foreground="#FFFFFF"
                                                                   HorizontalAlignment="Right"
                                                                   VerticalAlignment="Center"
                                                                   Visibility="{Binding IsDefault, Converter={StaticResource BoolToVis}}" />
                                                    </Grid>
                                                </Border>
                                                <ControlTemplate.Triggers>
                                                    <!-- Selected / Default Device Highlight -->
                                                    <DataTrigger Binding="{Binding IsDefault}" Value="True">
                                                        <Setter TargetName="ItemBorder" Property="Background" Value="#1EFFFFFF" />
                                                    </DataTrigger>
                                                    <!-- Mouse Hover Highlight -->
                                                    <Trigger Property="IsMouseOver" Value="True">
                                                        <Setter TargetName="ItemBorder" Property="Background" Value="#25FFFFFF" />
                                                    </Trigger>
                                                    <!-- Mouse Pressed Highlight -->
                                                    <Trigger Property="IsPressed" Value="True">
                                                        <Setter TargetName="ItemBorder" Property="Background" Value="#35FFFFFF" />
                                                    </Trigger>
                                                </ControlTemplate.Triggers>
                                            </ControlTemplate>
                                        </Button.Template>
                                    </Button>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </ScrollViewer>
                </Grid>
            </Border>

            <!-- 2. Focus Timer-Identical Edge-to-Edge Hairline Divider Track -->
            <Grid VerticalAlignment="Top"
                  Height="14"
                  Margin="0,-7,0,0"
                  Background="Transparent"
                  SnapsToDevicePixels="True">
                <Border Height="2"
                        VerticalAlignment="Center"
                        Background="#14FFFFFF"
                        CornerRadius="1"
                        SnapsToDevicePixels="True" />
            </Grid>
        </Grid>
        </Grid>
    </widgets:WidgetCard>
</UserControl>
