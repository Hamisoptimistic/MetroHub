<UserControl x:Class="MetroHub.Widgets.Catalog.Photos.PhotosWidgetView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:widgets="clr-namespace:MetroHub.Widgets"
             xmlns:photos="clr-namespace:MetroHub.Widgets.Catalog.Photos"
             mc:Ignorable="d" 
             d:DataContext="{d:DesignInstance Type=photos:PhotosWidgetViewModel}"
             Focusable="False"
             FontFamily="{DynamicResource AppFontFamily}">

    <UserControl.Resources>

        <!-- Empty State Select Folder Button Style: Inherits DefaultButtonStyle -->
        <Style x:Key="SelectFolderButtonStyle" TargetType="Button" BasedOn="{StaticResource DefaultButtonStyle}">
            <Setter Property="Height" Value="34" />
            <Setter Property="Padding" Value="18,0" />
        </Style>

        <!-- Media Player Standard Borderless Transport Button Style: Inherits WidgetMediumButtonStyle -->
    </UserControl.Resources>

    <widgets:WidgetCard Padding="0" Background="Transparent">
        <Grid x:Name="RootContainer" ClipToBounds="True">

            <!-- ============================================================== -->
            <!-- 1. EMPTY STATE (First-time add / No folder selected)           -->
            <!-- ============================================================== -->
            <Border x:Name="EmptyStatePanel"
                    Background="{DynamicResource SurfaceGlassBrush}"
                    BorderBrush="{DynamicResource SurfaceBorderSubtleBrush}"
                    BorderThickness="1"
                    CornerRadius="{DynamicResource ControlCornerRadius}"
                    Visibility="{Binding IsEmpty, Converter={StaticResource BoolToVis}}">

                <!-- Centered Content Stack: Compact 130px height, comfortably fits 8x3 (184px), 4x4 (248px), and 8x4 (248px) -->
                <StackPanel HorizontalAlignment="Center"
                            VerticalAlignment="Center">
                    
                    <!-- Photos Camera / Gallery Glyph Badge -->
                    <Border Width="38"
                            Height="38"
                            CornerRadius="19"
                            Background="{DynamicResource SurfaceGlassBrush}"
                            BorderBrush="{DynamicResource SurfaceBorderBrush}"
                            BorderThickness="1"
                            HorizontalAlignment="Center"
                            Margin="0,0,0,8"
                            >
                        <TextBlock Text="&#xEB9F;"
                                   FontFamily="{DynamicResource AppIconFontFamily}"
                                   FontSize="18"
                                   Foreground="{DynamicResource TextSecondaryBrush}"
                                   HorizontalAlignment="Center"
                                   VerticalAlignment="Center" />
                    </Border>

                    <!-- Title -->
                    <TextBlock Text="Photo Stream"
                               FontSize="{DynamicResource TypeHeaderFontSize}"
                               FontWeight="{DynamicResource TypeHeaderFontWeight}"
                               Foreground="{DynamicResource TextPrimaryBrush}"
                               HorizontalAlignment="Center"
                               Margin="0,0,0,2" />

                    <!-- Subtitle -->
                    <TextBlock Text="Select a folder to start your live photo stream."
                               FontSize="{DynamicResource TypeCaptionFontSize}"
                               FontWeight="{DynamicResource TypeCaptionFontWeight}"
                               Foreground="{DynamicResource TextMutedBrush}"
                               HorizontalAlignment="Center"
                               TextAlignment="Center"
                               TextWrapping="Wrap"
                               MaxWidth="260"
                               Margin="0,0,0,12" />

                    <!-- Industry-Standard Centered Fluent Action Button -->
                    <Button Style="{StaticResource SelectFolderButtonStyle}"
                            Command="{Binding ChooseFolderCommand}"
                            HorizontalAlignment="Center"
                            Tag="InteractiveControl">
                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                            <TextBlock Text="&#xED25;"
                                       FontFamily="{DynamicResource AppIconFontFamily}"
                                       FontSize="14"
                                       Foreground="{DynamicResource TextPrimaryBrush}"
                                       VerticalAlignment="Center"
                                       Margin="0,0,8,0" />
                            <TextBlock Text="Choose Photos Folder"
                                       FontSize="{DynamicResource TypeBodyStrongFontSize}"
                                       FontWeight="{DynamicResource TypeBodyStrongFontWeight}"
                                       Foreground="{DynamicResource TextPrimaryBrush}"
                                       VerticalAlignment="Center" />
                        </StackPanel>
                    </Button>
                </StackPanel>
            </Border>

            <!-- ============================================================== -->
            <!-- 2. ACTIVE SLIDESHOW STATE                                      -->
            <!-- ============================================================== -->
            <Grid x:Name="ActiveStatePanel">
                <Grid.Style>
                    <Style TargetType="Grid">
                        <Setter Property="Visibility" Value="Visible" />
                        <Style.Triggers>
                            <DataTrigger Binding="{Binding IsEmpty}" Value="True">
                                <Setter Property="Visibility" Value="Collapsed" />
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </Grid.Style>

                <!-- Dual-Buffer Ping-Pong Photos with Hardware-Accelerated Ken Burns Motion and Zero-Gap Ambient Mirror Underlay -->
                <Grid x:Name="ForegroundContainer" ClipToBounds="True">
                    <!-- Photo Layer A -->
                    <Grid x:Name="LayerAGrid" Opacity="1.0">
                        <!-- Underlay Safety Mirror: Always fills 100% of the tile with identical photo pixels (1.25x zoom), completely preventing any background gaps -->
                        <Image Source="{Binding PhotoLayerA}"
                               Stretch="UniformToFill"
                               RenderOptions.BitmapScalingMode="Linear"
                               RenderTransformOrigin="0.5,0.5">
                            <Image.RenderTransform>
                                <ScaleTransform ScaleX="1.25" ScaleY="1.25" />
                            </Image.RenderTransform>
                        </Image>

                        <!-- Ambient Scrim: Darkens the underlay when a portrait photo is centered with blur -->
                        <Border Background="#55000000">
                            <Border.Style>
                                <Style TargetType="Border">
                                    <Setter Property="Visibility" Value="Collapsed" />
                                    <Style.Triggers>
                                        <MultiDataTrigger>
                                            <MultiDataTrigger.Conditions>
                                                <Condition Binding="{Binding IsPortraitA}" Value="True" />
                                                <Condition Binding="{Binding FitMode}" Value="FitWithBlur" />
                                            </MultiDataTrigger.Conditions>
                                            <Setter Property="Visibility" Value="Visible" />
                                        </MultiDataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </Border.Style>
                        </Border>

                        <!-- Foreground Photo A -->
                        <Image x:Name="PhotoImageA"
                               Source="{Binding PhotoLayerA}"
                               RenderTransformOrigin="0.5,0.5"
                               CacheMode="BitmapCache">
                            <Image.Style>
                                <Style TargetType="Image">
                                    <Setter Property="Stretch" Value="UniformToFill" />
                                    <Setter Property="Effect" Value="{x:Null}" />
                                    <Style.Triggers>
                                        <MultiDataTrigger>
                                            <MultiDataTrigger.Conditions>
                                                <Condition Binding="{Binding IsPortraitA}" Value="True" />
                                                <Condition Binding="{Binding FitMode}" Value="FitWithBlur" />
                                            </MultiDataTrigger.Conditions>
                                            <Setter Property="Stretch" Value="Uniform" />
                                        </MultiDataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </Image.Style>
                            <Image.RenderTransform>
                                <TransformGroup>
                                    <ScaleTransform x:Name="ScaleA" ScaleX="1.08" ScaleY="1.08" />
                                    <TranslateTransform x:Name="TranslateA" X="0" Y="0" />
                                </TransformGroup>
                            </Image.RenderTransform>
                        </Image>
                    </Grid>

                    <!-- Photo Layer B -->
                    <Grid x:Name="LayerBGrid" Opacity="0.0">
                        <!-- Underlay Safety Mirror: Always fills 100% of the tile with identical photo pixels (1.25x zoom), completely preventing any background gaps -->
                        <Image Source="{Binding PhotoLayerB}"
                               Stretch="UniformToFill"
                               RenderOptions.BitmapScalingMode="Linear"
                               RenderTransformOrigin="0.5,0.5">
                            <Image.RenderTransform>
                                <ScaleTransform ScaleX="1.25" ScaleY="1.25" />
                            </Image.RenderTransform>
                        </Image>

                        <!-- Ambient Scrim: Darkens the underlay when a portrait photo is centered with blur -->
                        <Border Background="#55000000">
                            <Border.Style>
                                <Style TargetType="Border">
                                    <Setter Property="Visibility" Value="Collapsed" />
                                    <Style.Triggers>
                                        <MultiDataTrigger>
                                            <MultiDataTrigger.Conditions>
                                                <Condition Binding="{Binding IsPortraitB}" Value="True" />
                                                <Condition Binding="{Binding FitMode}" Value="FitWithBlur" />
                                            </MultiDataTrigger.Conditions>
                                            <Setter Property="Visibility" Value="Visible" />
                                        </MultiDataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </Border.Style>
                        </Border>

                        <!-- Foreground Photo B -->
                        <Image x:Name="PhotoImageB"
                               Source="{Binding PhotoLayerB}"
                               RenderTransformOrigin="0.5,0.5"
                               CacheMode="BitmapCache">
                            <Image.Style>
                                <Style TargetType="Image">
                                    <Setter Property="Stretch" Value="UniformToFill" />
                                    <Setter Property="Effect" Value="{x:Null}" />
                                    <Style.Triggers>
                                        <MultiDataTrigger>
                                            <MultiDataTrigger.Conditions>
                                                <Condition Binding="{Binding IsPortraitB}" Value="True" />
                                                <Condition Binding="{Binding FitMode}" Value="FitWithBlur" />
                                            </MultiDataTrigger.Conditions>
                                            <Setter Property="Stretch" Value="Uniform" />
                                        </MultiDataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </Image.Style>
                            <Image.RenderTransform>
                                <TransformGroup>
                                    <ScaleTransform x:Name="ScaleB" ScaleX="1.08" ScaleY="1.08" />
                                    <TranslateTransform x:Name="TranslateB" X="0" Y="0" />
                                </TransformGroup>
                            </Image.RenderTransform>
                        </Image>
                    </Grid>
                </Grid>

                <!-- Cinematic Bottom Vignette Gradient Scrim for Controls Readability -->
                <Border IsHitTestVisible="False">
                    <Border.Background>
                        <LinearGradientBrush StartPoint="0,0" EndPoint="0,1">
                            <GradientStop Color="#00000000" Offset="0.55" />
                            <GradientStop Color="#25000000" Offset="0.75" />
                            <GradientStop Color="#75000000" Offset="1.0" />
                        </LinearGradientBrush>
                    </Border.Background>
                </Border>

                <!-- Floating Micro-Controls Overlay (Visible on Hover, Aligned to Left with Universal 14px Margin) -->
                <StackPanel x:Name="OverlayControls"
                            Orientation="Horizontal"
                            HorizontalAlignment="Left"
                            VerticalAlignment="Bottom"
                            Margin="14,0,0,10"
                            Opacity="0">
                    <StackPanel.Style>
                        <Style TargetType="StackPanel">
                            <Setter Property="Opacity" Value="0.0" />
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding RelativeSource={RelativeSource AncestorType=UserControl}, Path=IsMouseOver}" Value="True">
                                    <DataTrigger.EnterActions>
                                        <BeginStoryboard>
                                            <Storyboard>
                                                <DoubleAnimation Storyboard.TargetProperty="Opacity"
                                                                 To="1.0" Duration="{StaticResource FluentDurationFast}" />
                                            </Storyboard>
                                        </BeginStoryboard>
                                    </DataTrigger.EnterActions>
                                    <DataTrigger.ExitActions>
                                        <BeginStoryboard>
                                            <Storyboard>
                                                <DoubleAnimation Storyboard.TargetProperty="Opacity"
                                                                 To="0.0" Duration="{StaticResource FluentDurationNormal}" />
                                            </Storyboard>
                                        </BeginStoryboard>
                                    </DataTrigger.ExitActions>
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </StackPanel.Style>

                    <!-- Previous Photo Button -->
                    <Button Style="{StaticResource WidgetMediumButtonStyle}"
                            Command="{Binding PreviousPhotoCommand}"
                            ToolTip="Previous Photo"
                            Tag="InteractiveControl"
                            Margin="0,0,2,0">
                        <TextBlock Text="&#xE76B;"
                                   FontFamily="{DynamicResource AppIconFontFamily}"
                                   FontSize="12"
                                   VerticalAlignment="Center"
                                   HorizontalAlignment="Center" />
                    </Button>

                    <!-- Change Folder Button -->
                    <Button Style="{StaticResource WidgetMediumButtonStyle}"
                            Command="{Binding ChooseFolderCommand}"
                            ToolTip="Change Folder"
                            Tag="InteractiveControl"
                            Margin="0,0,2,0">
                        <TextBlock Text="&#xED25;"
                                   FontFamily="{DynamicResource AppIconFontFamily}"
                                   FontSize="12"
                                   VerticalAlignment="Center"
                                   HorizontalAlignment="Center" />
                    </Button>

                    <!-- Next Photo Button -->
                    <Button Style="{StaticResource WidgetMediumButtonStyle}"
                            Command="{Binding NextPhotoCommand}"
                            ToolTip="Next Photo"
                            Tag="InteractiveControl">
                        <TextBlock Text="&#xE76C;"
                                   FontFamily="{DynamicResource AppIconFontFamily}"
                                   FontSize="12"
                                   VerticalAlignment="Center"
                                   HorizontalAlignment="Center" />
                    </Button>
                </StackPanel>
            </Grid>
        </Grid>
    </widgets:WidgetCard>
</UserControl>
