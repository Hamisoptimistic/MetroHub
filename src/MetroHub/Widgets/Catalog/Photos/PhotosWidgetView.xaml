<UserControl x:Class="MetroHub.Widgets.Catalog.Photos.PhotosWidgetView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:widgets="clr-namespace:MetroHub.Widgets"
             xmlns:photos="clr-namespace:MetroHub.Widgets.Catalog.Photos"
             mc:Ignorable="d" 
             d:DataContext="{d:DesignInstance Type=photos:PhotosWidgetViewModel}"
             Focusable="False"
             SnapsToDevicePixels="True"
             UseLayoutRounding="True"
             TextOptions.TextFormattingMode="Ideal"
             TextOptions.TextRenderingMode="Grayscale"
             TextOptions.TextHintingMode="Animated">

    <UserControl.Resources>
        <BooleanToVisibilityConverter x:Key="BoolToVis" />

        <!-- Empty State Select Folder Button Style: Windows 11 Fluent Glass Action Button -->
        <Style x:Key="SelectFolderButtonStyle" TargetType="Button">
            <Setter Property="Background" Value="#22FFFFFF" />
            <Setter Property="BorderBrush" Value="#35FFFFFF" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="Foreground" Value="#FFFFFF" />
            <Setter Property="Height" Value="34" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Focusable" Value="False" />
            <Setter Property="RenderTransformOrigin" Value="0.5,0.5" />
            <Setter Property="RenderTransform">
                <Setter.Value>
                    <ScaleTransform ScaleX="1.0" ScaleY="1.0" />
                </Setter.Value>
            </Setter>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="BtnBorder"
                                Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="6"
                                Padding="18,0"
                                SnapsToDevicePixels="True">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="BtnBorder" Property="Background" Value="#3DFFFFFF" />
                                <Setter TargetName="BtnBorder" Property="BorderBrush" Value="#65FFFFFF" />
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="BtnBorder" Property="Background" Value="#55FFFFFF" />
                                <Setter Property="RenderTransform">
                                    <Setter.Value>
                                        <ScaleTransform ScaleX="0.97" ScaleY="0.97" />
                                    </Setter.Value>
                                </Setter>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Media Player Standard Borderless Transport Button Style -->
        <Style x:Key="PhotoTransportButtonStyle" TargetType="Button">
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="Foreground" Value="#E5E9F0" />
            <Setter Property="Width" Value="32" />
            <Setter Property="Height" Value="28" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Focusable" Value="False" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Border"
                                Background="{TemplateBinding Background}"
                                CornerRadius="2"
                                SnapsToDevicePixels="True">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Border" Property="Background" Value="#25FFFFFF" />
                                <Setter Property="Foreground" Value="#FFFFFF" />
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="Border" Property="Background" Value="#45FFFFFF" />
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter Property="Opacity" Value="0.3" />
                                <Setter Property="Cursor" Value="Arrow" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </UserControl.Resources>

    <widgets:WidgetCard Padding="0" Background="Transparent" CornerRadius="2">
        <Grid x:Name="RootContainer" ClipToBounds="True" SnapsToDevicePixels="True">

            <!-- ============================================================== -->
            <!-- 1. EMPTY STATE (First-time add / No folder selected)           -->
            <!-- ============================================================== -->
            <Grid x:Name="EmptyStatePanel"
                  SnapsToDevicePixels="True"
                  Visibility="{Binding IsEmpty, Converter={StaticResource BoolToVis}}">
                
                <!-- Frosted Acrylic Glass Background -->
                <Border Background="#18FFFFFF"
                        BorderBrush="#15FFFFFF"
                        BorderThickness="1"
                        CornerRadius="2"
                        SnapsToDevicePixels="True" />

                <!-- Centered Content Stack: Compact 130px height, comfortably fits 8x3 (184px), 4x4 (248px), and 8x4 (248px) -->
                <StackPanel HorizontalAlignment="Center"
                            VerticalAlignment="Center">
                    
                    <!-- Photos Camera / Gallery Glyph Badge -->
                    <Border Width="38"
                            Height="38"
                            CornerRadius="19"
                            Background="#18FFFFFF"
                            BorderBrush="#25FFFFFF"
                            BorderThickness="1"
                            HorizontalAlignment="Center"
                            Margin="0,0,0,8"
                            SnapsToDevicePixels="True">
                        <TextBlock Text="&#xEB9F;"
                                   FontFamily="Segoe MDL2 Assets"
                                   FontSize="18"
                                   Foreground="#D2DCED"
                                   HorizontalAlignment="Center"
                                   VerticalAlignment="Center" />
                    </Border>

                    <!-- Title -->
                    <TextBlock Text="Photo Stream"
                               FontSize="15"
                               FontWeight="SemiBold"
                               FontFamily="Segoe UI Variable Display, Segoe UI, sans-serif"
                               Foreground="#FFFFFF"
                               HorizontalAlignment="Center"
                               Margin="0,0,0,2" />

                    <!-- Subtitle -->
                    <TextBlock Text="Select a folder to start your live photo stream."
                               FontSize="11.5"
                               FontWeight="Normal"
                               FontFamily="Segoe UI Variable Text, Segoe UI, sans-serif"
                               Foreground="#9BA5B7"
                               HorizontalAlignment="Center"
                               TextAlignment="Center"
                               TextWrapping="Wrap"
                               MaxWidth="260"
                               Margin="0,0,0,12" />

                    <!-- Industry-Standard Centered Fluent Action Button -->
                    <Button Style="{StaticResource SelectFolderButtonStyle}"
                            Command="{Binding ChooseFolderCommand}"
                            HorizontalAlignment="Center"
                            Tag="InteractiveControl">
                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                            <TextBlock Text="&#xED25;"
                                       FontFamily="Segoe MDL2 Assets"
                                       FontSize="14"
                                       Foreground="#FFFFFF"
                                       VerticalAlignment="Center"
                                       Margin="0,0,8,0" />
                            <TextBlock Text="Choose Photos Folder"
                                       FontSize="12.5"
                                       FontWeight="SemiBold"
                                       FontFamily="Segoe UI Variable Text, Segoe UI, sans-serif"
                                       Foreground="#FFFFFF"
                                       VerticalAlignment="Center" />
                        </StackPanel>
                    </Button>
                </StackPanel>
            </Grid>

            <!-- ============================================================== -->
            <!-- 2. ACTIVE SLIDESHOW STATE                                      -->
            <!-- ============================================================== -->
            <Grid x:Name="ActiveStatePanel">
                <Grid.Style>
                    <Style TargetType="Grid">
                        <Setter Property="Visibility" Value="Visible" />
                        <Style.Triggers>
                            <DataTrigger Binding="{Binding IsEmpty}" Value="True">
                                <Setter Property="Visibility" Value="Collapsed" />
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </Grid.Style>

                <!-- Dual-Buffer Ping-Pong Photos with Hardware-Accelerated Ken Burns Motion and Zero-Gap Ambient Mirror Underlay -->
                <Grid x:Name="ForegroundContainer" ClipToBounds="True">
                    <!-- Photo Layer A -->
                    <Grid x:Name="LayerAGrid" Opacity="1.0" SnapsToDevicePixels="True">
                        <!-- Underlay Safety Mirror: Always fills 100% of the tile with identical photo pixels (1.25x zoom), completely preventing any background gaps -->
                        <Image Source="{Binding PhotoLayerA}"
                               Stretch="UniformToFill"
                               RenderOptions.BitmapScalingMode="Linear"
                               RenderTransformOrigin="0.5,0.5">
                            <Image.RenderTransform>
                                <ScaleTransform ScaleX="1.25" ScaleY="1.25" />
                            </Image.RenderTransform>
                        </Image>

                        <!-- Ambient Scrim: Darkens the underlay when a portrait photo is centered with blur -->
                        <Border Background="#55000000">
                            <Border.Style>
                                <Style TargetType="Border">
                                    <Setter Property="Visibility" Value="Collapsed" />
                                    <Style.Triggers>
                                        <MultiDataTrigger>
                                            <MultiDataTrigger.Conditions>
                                                <Condition Binding="{Binding IsPortraitA}" Value="True" />
                                                <Condition Binding="{Binding FitMode}" Value="FitWithBlur" />
                                            </MultiDataTrigger.Conditions>
                                            <Setter Property="Visibility" Value="Visible" />
                                        </MultiDataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </Border.Style>
                        </Border>

                        <!-- Foreground Photo A -->
                        <Image x:Name="PhotoImageA"
                               Source="{Binding PhotoLayerA}"
                               RenderTransformOrigin="0.5,0.5"
                               SnapsToDevicePixels="True">
                            <Image.Style>
                                <Style TargetType="Image">
                                    <Setter Property="Stretch" Value="UniformToFill" />
                                    <Setter Property="Effect" Value="{x:Null}" />
                                    <Style.Triggers>
                                        <MultiDataTrigger>
                                            <MultiDataTrigger.Conditions>
                                                <Condition Binding="{Binding IsPortraitA}" Value="True" />
                                                <Condition Binding="{Binding FitMode}" Value="FitWithBlur" />
                                            </MultiDataTrigger.Conditions>
                                            <Setter Property="Stretch" Value="Uniform" />
                                            <Setter Property="Effect">
                                                <Setter.Value>
                                                    <DropShadowEffect BlurRadius="20" ShadowDepth="0" Color="Black" Opacity="0.65" />
                                                </Setter.Value>
                                            </Setter>
                                        </MultiDataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </Image.Style>
                            <Image.RenderTransform>
                                <TransformGroup>
                                    <ScaleTransform x:Name="ScaleA" ScaleX="1.08" ScaleY="1.08" />
                                    <TranslateTransform x:Name="TranslateA" X="0" Y="0" />
                                </TransformGroup>
                            </Image.RenderTransform>
                        </Image>
                    </Grid>

                    <!-- Photo Layer B -->
                    <Grid x:Name="LayerBGrid" Opacity="0.0" SnapsToDevicePixels="True">
                        <!-- Underlay Safety Mirror: Always fills 100% of the tile with identical photo pixels (1.25x zoom), completely preventing any background gaps -->
                        <Image Source="{Binding PhotoLayerB}"
                               Stretch="UniformToFill"
                               RenderOptions.BitmapScalingMode="Linear"
                               RenderTransformOrigin="0.5,0.5">
                            <Image.RenderTransform>
                                <ScaleTransform ScaleX="1.25" ScaleY="1.25" />
                            </Image.RenderTransform>
                        </Image>

                        <!-- Ambient Scrim: Darkens the underlay when a portrait photo is centered with blur -->
                        <Border Background="#55000000">
                            <Border.Style>
                                <Style TargetType="Border">
                                    <Setter Property="Visibility" Value="Collapsed" />
                                    <Style.Triggers>
                                        <MultiDataTrigger>
                                            <MultiDataTrigger.Conditions>
                                                <Condition Binding="{Binding IsPortraitB}" Value="True" />
                                                <Condition Binding="{Binding FitMode}" Value="FitWithBlur" />
                                            </MultiDataTrigger.Conditions>
                                            <Setter Property="Visibility" Value="Visible" />
                                        </MultiDataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </Border.Style>
                        </Border>

                        <!-- Foreground Photo B -->
                        <Image x:Name="PhotoImageB"
                               Source="{Binding PhotoLayerB}"
                               RenderTransformOrigin="0.5,0.5"
                               SnapsToDevicePixels="True">
                            <Image.Style>
                                <Style TargetType="Image">
                                    <Setter Property="Stretch" Value="UniformToFill" />
                                    <Setter Property="Effect" Value="{x:Null}" />
                                    <Style.Triggers>
                                        <MultiDataTrigger>
                                            <MultiDataTrigger.Conditions>
                                                <Condition Binding="{Binding IsPortraitB}" Value="True" />
                                                <Condition Binding="{Binding FitMode}" Value="FitWithBlur" />
                                            </MultiDataTrigger.Conditions>
                                            <Setter Property="Stretch" Value="Uniform" />
                                            <Setter Property="Effect">
                                                <Setter.Value>
                                                    <DropShadowEffect BlurRadius="20" ShadowDepth="0" Color="Black" Opacity="0.65" />
                                                </Setter.Value>
                                            </Setter>
                                        </MultiDataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </Image.Style>
                            <Image.RenderTransform>
                                <TransformGroup>
                                    <ScaleTransform x:Name="ScaleB" ScaleX="1.08" ScaleY="1.08" />
                                    <TranslateTransform x:Name="TranslateB" X="0" Y="0" />
                                </TransformGroup>
                            </Image.RenderTransform>
                        </Image>
                    </Grid>
                </Grid>

                <!-- Cinematic Bottom Vignette Gradient Scrim for Controls Readability -->
                <Border IsHitTestVisible="False" SnapsToDevicePixels="True">
                    <Border.Background>
                        <LinearGradientBrush StartPoint="0,0" EndPoint="0,1">
                            <GradientStop Color="#00000000" Offset="0.55" />
                            <GradientStop Color="#25000000" Offset="0.75" />
                            <GradientStop Color="#75000000" Offset="1.0" />
                        </LinearGradientBrush>
                    </Border.Background>
                </Border>

                <!-- Floating Micro-Controls Overlay (Visible on Hover, Aligned to Left with Universal 14px Margin) -->
                <StackPanel x:Name="OverlayControls"
                            Orientation="Horizontal"
                            HorizontalAlignment="Left"
                            VerticalAlignment="Bottom"
                            Margin="14,0,0,10"
                            Opacity="0">
                    <StackPanel.Style>
                        <Style TargetType="StackPanel">
                            <Setter Property="Opacity" Value="0.0" />
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding RelativeSource={RelativeSource AncestorType=UserControl}, Path=IsMouseOver}" Value="True">
                                    <DataTrigger.EnterActions>
                                        <BeginStoryboard>
                                            <Storyboard>
                                                <DoubleAnimation Storyboard.TargetProperty="Opacity"
                                                                 To="1.0" Duration="0:0:0.18" />
                                            </Storyboard>
                                        </BeginStoryboard>
                                    </DataTrigger.EnterActions>
                                    <DataTrigger.ExitActions>
                                        <BeginStoryboard>
                                            <Storyboard>
                                                <DoubleAnimation Storyboard.TargetProperty="Opacity"
                                                                 To="0.0" Duration="0:0:0.25" />
                                            </Storyboard>
                                        </BeginStoryboard>
                                    </DataTrigger.ExitActions>
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </StackPanel.Style>

                    <!-- Previous Photo Button -->
                    <Button Style="{StaticResource PhotoTransportButtonStyle}"
                            Command="{Binding PreviousPhotoCommand}"
                            ToolTip="Previous Photo"
                            Tag="InteractiveControl"
                            Margin="0,0,2,0">
                        <TextBlock Text="&#xE76B;"
                                   FontFamily="Segoe MDL2 Assets"
                                   FontSize="12"
                                   VerticalAlignment="Center"
                                   HorizontalAlignment="Center" />
                    </Button>

                    <!-- Change Folder Button -->
                    <Button Style="{StaticResource PhotoTransportButtonStyle}"
                            Command="{Binding ChooseFolderCommand}"
                            ToolTip="Change Folder"
                            Tag="InteractiveControl"
                            Margin="0,0,2,0">
                        <TextBlock Text="&#xED25;"
                                   FontFamily="Segoe MDL2 Assets"
                                   FontSize="12"
                                   VerticalAlignment="Center"
                                   HorizontalAlignment="Center" />
                    </Button>

                    <!-- Next Photo Button -->
                    <Button Style="{StaticResource PhotoTransportButtonStyle}"
                            Command="{Binding NextPhotoCommand}"
                            ToolTip="Next Photo"
                            Tag="InteractiveControl">
                        <TextBlock Text="&#xE76C;"
                                   FontFamily="Segoe MDL2 Assets"
                                   FontSize="12"
                                   VerticalAlignment="Center"
                                   HorizontalAlignment="Center" />
                    </Button>
                </StackPanel>
            </Grid>
        </Grid>
    </widgets:WidgetCard>
</UserControl>
