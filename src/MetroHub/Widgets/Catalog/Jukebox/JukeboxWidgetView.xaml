<UserControl x:Class="MetroHub.Widgets.Catalog.Jukebox.JukeboxWidgetView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
             xmlns:controls="clr-namespace:MetroHub.Presentation.Controls"
             xmlns:widgets="clr-namespace:MetroHub.Widgets"
             xmlns:jukebox="clr-namespace:MetroHub.Widgets.Catalog.Jukebox"
             mc:Ignorable="d"
             d:DataContext="{d:DesignInstance Type=jukebox:JukeboxWidgetViewModel}"
             Focusable="False"
             SnapsToDevicePixels="True"
             UseLayoutRounding="True"
             TextOptions.TextFormattingMode="Ideal"
             TextOptions.TextRenderingMode="ClearType">

    <UserControl.Resources>
        <BooleanToVisibilityConverter x:Key="BoolToVis" />

        <!-- Transparent row button: hover/pressed tints only, no chrome -->
        <Style x:Key="RowButtonStyle" TargetType="{x:Type Button}">
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="Padding" Value="10,7" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Focusable" Value="False" />
            <Setter Property="FocusVisualStyle" Value="{x:Null}" />
            <Setter Property="HorizontalContentAlignment" Value="Stretch" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="{x:Type Button}">
                        <Border Background="{TemplateBinding Background}"
                                CornerRadius="4"
                                Padding="{TemplateBinding Padding}"
                                SnapsToDevicePixels="True">
                            <ContentPresenter HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}"
                                              VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter Property="Background" Value="#1AFFFFFF" />
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter Property="Background" Value="#26FFFFFF" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Selection-chrome-free list rows (interaction lives in row buttons) -->
        <Style x:Key="PlainRowContainerStyle" TargetType="{x:Type ListBoxItem}">
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="Padding" Value="0" />
            <Setter Property="Margin" Value="0,0,0,2" />
            <Setter Property="HorizontalContentAlignment" Value="Stretch" />
            <Setter Property="Focusable" Value="False" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="{x:Type ListBoxItem}">
                        <ContentPresenter SnapsToDevicePixels="True" />
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </UserControl.Resources>

    <widgets:WidgetCard Padding="0" Background="Transparent">
        <Grid Margin="20,14,20,0">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>

            <!-- Search row -->
            <Grid Grid.Row="0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <Border BorderBrush="#2AFFFFFF" BorderThickness="1" CornerRadius="4"
                        Background="Transparent" SnapsToDevicePixels="True">
                    <TextBox Text="{Binding SearchText, UpdateSourceTrigger=PropertyChanged}"
                             Background="Transparent" BorderThickness="0"
                             Foreground="#FFFFFF" CaretBrush="#FFFFFF"
                             FontSize="13" Padding="10,7"
                             VerticalContentAlignment="Center"
                             SnapsToDevicePixels="True">
                        <TextBox.InputBindings>
                            <KeyBinding Key="Enter" Command="{Binding SearchCommand}" />
                        </TextBox.InputBindings>
                    </TextBox>
                </Border>
                <Button Grid.Column="1" Command="{Binding SearchCommand}"
                        Width="32" Height="28" Margin="8,0,0,0"
                        Background="Transparent" BorderThickness="0"
                        Cursor="Hand" Focusable="False" FocusVisualStyle="{x:Null}"
                        ToolTip="Search">
                    <ui:SymbolIcon Symbol="Search24" FontSize="15" Foreground="#FFFFFF" />
                </Button>
            </Grid>

            <!-- Status line -->
            <TextBlock Grid.Row="1" Text="{Binding StatusMessage}"
                       FontSize="12" Foreground="#70FFFFFF"
                       TextWrapping="Wrap" Margin="0,6,0,0"
                       SnapsToDevicePixels="True" />

            <!-- Results -->
            <StackPanel Grid.Row="2" Visibility="{Binding HasResults, Converter={StaticResource BoolToVis}}">
                <TextBlock Text="RESULTS" FontSize="11" FontWeight="SemiBold"
                           Foreground="#70FFFFFF" Margin="0,10,0,4"
                           SnapsToDevicePixels="True" />
                <ListBox ItemsSource="{Binding SearchResults}"
                         ItemContainerStyle="{StaticResource PlainRowContainerStyle}"
                         Background="Transparent" BorderThickness="0"
                         MaxHeight="232"
                         ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                         ScrollViewer.VerticalScrollBarVisibility="Auto"
                         controls:AutoHideScrollBehavior.IsEnabled="True"
                         SnapsToDevicePixels="True">
                    <ListBox.ItemTemplate>
                        <DataTemplate>
                            <Button Style="{StaticResource RowButtonStyle}"
                                    Command="{Binding DataContext.PlayResultCommand, RelativeSource={RelativeSource AncestorType=ListBox}}"
                                    CommandParameter="{Binding}">
                                <StackPanel>
                                    <TextBlock Text="{Binding Title}" FontSize="13" FontWeight="SemiBold"
                                               Foreground="#FFFFFF" TextTrimming="CharacterEllipsis"
                                               ToolTip="{Binding Title}" SnapsToDevicePixels="True" />
                                    <TextBlock FontSize="11" Foreground="#70FFFFFF" SnapsToDevicePixels="True">
                                        <TextBlock.Text>
                                            <MultiBinding StringFormat="{}{0} • {1}">
                                                <Binding Path="Channel" />
                                                <Binding Path="DurationText" />
                                            </MultiBinding>
                                        </TextBlock.Text>
                                    </TextBlock>
                                </StackPanel>
                            </Button>
                        </DataTemplate>
                    </ListBox.ItemTemplate>
                </ListBox>
            </StackPanel>

            <!-- History header -->
            <Grid Grid.Row="3" Margin="0,10,0,4">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <TextBlock Text="HISTORY" FontSize="11" FontWeight="SemiBold"
                           Foreground="#70FFFFFF" VerticalAlignment="Center"
                           SnapsToDevicePixels="True" />
                <Button Grid.Column="1" Content="Clear"
                        Command="{Binding ClearHistoryCommand}"
                        Visibility="{Binding HasHistory, Converter={StaticResource BoolToVis}}"
                        Background="Transparent" BorderThickness="0"
                        Foreground="#70FFFFFF" FontSize="11"
                        Cursor="Hand" Focusable="False" FocusVisualStyle="{x:Null}"
                        Padding="6,2" SnapsToDevicePixels="True" />
            </Grid>

            <!-- History (uncapped, virtualized) -->
            <ListBox Grid.Row="4" x:Name="HistoryList"
                     ItemsSource="{Binding History}"
                     ItemContainerStyle="{StaticResource PlainRowContainerStyle}"
                     Background="Transparent" BorderThickness="0"
                     ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                     ScrollViewer.VerticalScrollBarVisibility="Auto"
                     controls:AutoHideScrollBehavior.IsEnabled="True"
                     SnapsToDevicePixels="True">
                <ListBox.ItemTemplate>
                    <DataTemplate>
                        <Grid Tag="{Binding DataContext, RelativeSource={RelativeSource AncestorType=ListBox}}">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <Button Grid.Column="0" Style="{StaticResource RowButtonStyle}"
                                    Command="{Binding DataContext.PlayHistoryCommand, RelativeSource={RelativeSource AncestorType=ListBox}}"
                                    CommandParameter="{Binding}">
                                <Button.ContextMenu>
                                    <ContextMenu>
                                        <MenuItem Header="Remove"
                                                  Command="{Binding PlacementTarget.Tag.RemoveTrackCommand, RelativeSource={RelativeSource AncestorType=ContextMenu}}"
                                                  CommandParameter="{Binding}" />
                                    </ContextMenu>
                                </Button.ContextMenu>
                                <StackPanel>
                                    <TextBlock Text="{Binding Title}" FontSize="13" FontWeight="SemiBold"
                                               Foreground="#FFFFFF" TextTrimming="CharacterEllipsis"
                                               ToolTip="{Binding Title}" SnapsToDevicePixels="True" />
                                    <TextBlock FontSize="11" Foreground="#70FFFFFF" SnapsToDevicePixels="True">
                                        <TextBlock.Text>
                                            <MultiBinding StringFormat="{}{0} • {1}">
                                                <Binding Path="Channel" />
                                                <Binding Path="DurationText" />
                                            </MultiBinding>
                                        </TextBlock.Text>
                                    </TextBlock>
                                </StackPanel>
                            </Button>
                            <Button Grid.Column="1" Style="{StaticResource RowButtonStyle}"
                                    Command="{Binding DataContext.RemoveTrackCommand, RelativeSource={RelativeSource AncestorType=ListBox}}"
                                    CommandParameter="{Binding}"
                                    Padding="8,7" ToolTip="Remove">
                                <ui:SymbolIcon Symbol="Dismiss24" FontSize="12" Foreground="#70FFFFFF" />
                            </Button>
                        </Grid>
                    </DataTemplate>
                </ListBox.ItemTemplate>
            </ListBox>

            <!-- Now playing (docked, edge-to-edge) -->
            <Grid Grid.Row="5" Margin="-20,8,-20,0">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>
                <Grid Grid.Row="0" Height="14" VerticalAlignment="Top" Margin="0,-7,0,0"
                      Background="Transparent" SnapsToDevicePixels="True">
                    <Border Height="2" VerticalAlignment="Center"
                            Background="#14FFFFFF" CornerRadius="1"
                            SnapsToDevicePixels="True" />
                </Grid>
                <Border Grid.Row="1" Background="#14000000" BorderThickness="0"
                        CornerRadius="0,0,2,2" Padding="20,0,20,0"
                        SnapsToDevicePixels="True">
                    <Grid Height="48">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <Button Grid.Column="0" Command="{Binding TogglePlayPauseCommand}"
                                Width="32" Height="28" Margin="-9.5,0,0,0"
                                Background="Transparent" BorderThickness="0"
                                Cursor="Hand" Focusable="False" FocusVisualStyle="{x:Null}"
                                VerticalAlignment="Center" ToolTip="Play / Pause">
                            <Grid>
                                <ui:SymbolIcon Symbol="Play24" FontSize="15" Foreground="#FFFFFF">
                                    <ui:SymbolIcon.Style>
                                        <Style TargetType="{x:Type ui:SymbolIcon}">
                                            <Setter Property="Visibility" Value="Visible" />
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding IsPlaying}" Value="True">
                                                    <Setter Property="Visibility" Value="Collapsed" />
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </ui:SymbolIcon.Style>
                                </ui:SymbolIcon>
                                <ui:SymbolIcon Symbol="Pause24" FontSize="16" Foreground="#FFFFFF">
                                    <ui:SymbolIcon.Style>
                                        <Style TargetType="{x:Type ui:SymbolIcon}">
                                            <Setter Property="Visibility" Value="Collapsed" />
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding IsPlaying}" Value="True">
                                                    <Setter Property="Visibility" Value="Visible" />
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </ui:SymbolIcon.Style>
                                </ui:SymbolIcon>
                            </Grid>
                        </Button>
                        <TextBlock Grid.Column="1" Text="{Binding CurrentTitle}"
                                   FontSize="13" Foreground="#E0FFFFFF"
                                   VerticalAlignment="Center" Margin="10,0,0,0"
                                   TextTrimming="CharacterEllipsis"
                                   ToolTip="{Binding CurrentTitle}"
                                   SnapsToDevicePixels="True" />
                    </Grid>
                </Border>
            </Grid>
        </Grid>
    </widgets:WidgetCard>
</UserControl>
