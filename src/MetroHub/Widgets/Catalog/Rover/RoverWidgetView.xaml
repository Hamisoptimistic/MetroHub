<UserControl x:Class="MetroHub.Widgets.Catalog.Rover.RoverWidgetView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:rover="clr-namespace:MetroHub.Widgets.Catalog.Rover"
             mc:Ignorable="d" 
             d:DataContext="{d:DesignInstance Type=rover:RoverWidgetViewModel}"
             Focusable="False"
             Cursor="Hand"
             SnapsToDevicePixels="True"
             UseLayoutRounding="True">

    <UserControl.Resources>
        <BooleanToVisibilityConverter x:Key="BoolToVis" />

        <!-- Nostalgic XP Bliss Grass Accent Gradient -->
        <LinearGradientBrush x:Key="XpBlissBackground" StartPoint="0,0" EndPoint="0,1">
            <GradientStop Color="#1E3A8A" Offset="0.0" />
            <GradientStop Color="#0284C7" Offset="0.45" />
            <GradientStop Color="#15803D" Offset="0.85" />
            <GradientStop Color="#14532D" Offset="1.0" />
        </LinearGradientBrush>
    </UserControl.Resources>

    <Grid ClipToBounds="True">
        <!-- Optional Windows XP Bliss Nostalgic Hill Background -->
        <Border Background="{StaticResource XpBlissBackground}"
                Opacity="0.85"
                Visibility="{Binding IsXPBliss, Converter={StaticResource BoolToVis}}" />

        <!-- Subtle Top Specular Edge -->
        <Border BorderBrush="#20FFFFFF" BorderThickness="0,1,0,0" IsHitTestVisible="False" />

        <!-- Centered Rover Sprite (Pure 4x2 Desktop Companion) -->
        <Viewbox Width="96" Height="96"
                 Stretch="Uniform"
                 HorizontalAlignment="Center"
                 VerticalAlignment="Center">
            <Grid Width="80" Height="80">
                <!-- Soft Radial Contact Ground Shadow -->
                <Ellipse Width="50" Height="12"
                         HorizontalAlignment="Center"
                         VerticalAlignment="Bottom"
                         Margin="0,0,2,4"
                         IsHitTestVisible="False">
                    <Ellipse.Fill>
                        <RadialGradientBrush Center="0.5,0.5" RadiusX="0.5" RadiusY="0.5">
                            <GradientStop Color="#50000000" Offset="0.0" />
                            <GradientStop Color="#30000000" Offset="0.5" />
                            <GradientStop Color="#00000000" Offset="1.0" />
                        </RadialGradientBrush>
                    </Ellipse.Fill>
                </Ellipse>

                <!-- Rover Sprite with HighQuality Filtering -->
                <Rectangle x:Name="RoverSpriteWide"
                           Width="80" Height="80"
                           RenderOptions.BitmapScalingMode="HighQuality">
                    <Rectangle.Fill>
                        <ImageBrush x:Name="SpriteBrushWide"
                                    ImageSource="{x:Static rover:RoverSpriteAtlas.SharedAtlas}"
                                    ViewboxUnits="Absolute"
                                    Viewbox="0,0,80,80"
                                    Stretch="Fill" />
                    </Rectangle.Fill>
                </Rectangle>
            </Grid>
        </Viewbox>
    </Grid>
</UserControl>
