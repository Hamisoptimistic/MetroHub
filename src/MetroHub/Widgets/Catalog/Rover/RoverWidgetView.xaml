<UserControl x:Class="MetroHub.Widgets.Catalog.Rover.RoverWidgetView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:rover="clr-namespace:MetroHub.Widgets.Catalog.Rover"
             mc:Ignorable="d" 
             d:DataContext="{d:DesignInstance Type=rover:RoverWidgetViewModel}"
             Focusable="False"
             Cursor="Hand"
             SnapsToDevicePixels="True"
             UseLayoutRounding="True"
             TextOptions.TextFormattingMode="Ideal"
             TextOptions.TextRenderingMode="ClearType">

    <UserControl.Resources>
        <BooleanToVisibilityConverter x:Key="BoolToVis" />

        <!-- Authentic Windows XP Cartoon Speech Bubble Gradient (#FFFFF0 to #FFF5A8) -->
        <LinearGradientBrush x:Key="XpSpeechBubbleBackground" StartPoint="0,0" EndPoint="0,1">
            <GradientStop Color="#FFFFF0" Offset="0.0" />
            <GradientStop Color="#FFFDE0" Offset="0.5" />
            <GradientStop Color="#FFF5A8" Offset="1.0" />
        </LinearGradientBrush>

        <!-- Nostalgic XP Bliss Grass Accent Gradient -->
        <LinearGradientBrush x:Key="XpBlissBackground" StartPoint="0,0" EndPoint="0,1">
            <GradientStop Color="#1E3A8A" Offset="0.0" />
            <GradientStop Color="#0284C7" Offset="0.45" />
            <GradientStop Color="#15803D" Offset="0.85" />
            <GradientStop Color="#14532D" Offset="1.0" />
        </LinearGradientBrush>
    </UserControl.Resources>

    <Grid ClipToBounds="True">
        <!-- Optional Windows XP Bliss Nostalgic Hill Background -->
        <Border Background="{StaticResource XpBlissBackground}"
                Opacity="0.85"
                Visibility="{Binding IsXPBliss, Converter={StaticResource BoolToVis}}" />

        <!-- Subtle Top Specular Edge -->
        <Border BorderBrush="#25FFFFFF" BorderThickness="0,1,0,0" IsHitTestVisible="False" />

        <!-- ======================================================= -->
        <!-- 1. MEDIUM 2x2 LAYOUT (Pocket Desk Pet)                  -->
        <!-- ======================================================= -->
        <Grid Visibility="{Binding IsMedium, Converter={StaticResource BoolToVis}}"
              HorizontalAlignment="Center" VerticalAlignment="Center">
            <!-- Centered Rover Sprite -->
            <Viewbox Width="84" Height="84" Stretch="Uniform">
                <Rectangle x:Name="RoverSpriteMedium"
                           Width="80" Height="80"
                           RenderOptions.BitmapScalingMode="NearestNeighbor">
                    <Rectangle.Fill>
                        <ImageBrush x:Name="SpriteBrushMedium"
                                    ImageSource="{x:Static rover:RoverSpriteAtlas.SharedAtlas}"
                                    ViewboxUnits="Absolute"
                                    Viewbox="0,0,80,80"
                                    Stretch="Fill" />
                    </Rectangle.Fill>
                </Rectangle>
            </Viewbox>

            <!-- Sleeping "Zzz" badge floating above Rover -->
            <Border Visibility="{Binding IsSleeping, Converter={StaticResource BoolToVis}}"
                    HorizontalAlignment="Right" VerticalAlignment="Top"
                    Margin="0,-4,-4,0"
                    Background="#D01E293B" CornerRadius="8" Padding="6,2">
                <TextBlock Text="💤 Zzz..." FontSize="10" FontWeight="Bold" Foreground="#94A3B8" />
            </Border>
        </Grid>

        <!-- ======================================================= -->
        <!-- 2. WIDE 4x2 LAYOUT (Rover + Speech Bubble)              -->
        <!-- ======================================================= -->
        <Grid Visibility="{Binding IsWide, Converter={StaticResource BoolToVis}}"
              Margin="14,10,14,10"
              VerticalAlignment="Center">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>

            <!-- Left: Rover Sprite -->
            <Viewbox Grid.Column="0" Width="84" Height="84" Stretch="Uniform"
                     VerticalAlignment="Center" HorizontalAlignment="Left">
                <Rectangle x:Name="RoverSpriteWide"
                           Width="80" Height="80"
                           RenderOptions.BitmapScalingMode="NearestNeighbor">
                    <Rectangle.Fill>
                        <ImageBrush x:Name="SpriteBrushWide"
                                    ImageSource="{x:Static rover:RoverSpriteAtlas.SharedAtlas}"
                                    ViewboxUnits="Absolute"
                                    Viewbox="0,0,80,80"
                                    Stretch="Fill" />
                    </Rectangle.Fill>
                </Rectangle>
            </Viewbox>

            <!-- Right: Authentic Yellow Windows XP Speech Balloon -->
            <Border Grid.Column="1"
                    Margin="10,0,0,0"
                    VerticalAlignment="Center"
                    Background="{StaticResource XpSpeechBubbleBackground}"
                    BorderBrush="#C4B478"
                    BorderThickness="1"
                    CornerRadius="10"
                    Padding="10,8">
                <Border.Effect>
                    <DropShadowEffect BlurRadius="8" Direction="270" ShadowDepth="2" Opacity="0.22" Color="#000000" />
                </Border.Effect>

                <StackPanel>
                    <TextBlock Text="{Binding SpeechText}"
                               FontSize="12"
                               FontWeight="Medium"
                               FontFamily="Segoe UI Variable Display, Segoe UI, Tahoma, sans-serif"
                               Foreground="#1C1917"
                               TextWrapping="Wrap"
                               LineHeight="16" />

                    <TextBlock Text="{Binding StatusLabel}"
                               FontSize="10"
                               FontWeight="SemiBold"
                               Foreground="#78716C"
                               Margin="0,4,0,0" />
                </StackPanel>
            </Border>
        </Grid>

        <!-- ======================================================= -->
        <!-- 3. LARGE 4x4 LAYOUT (Playpen Deck)                      -->
        <!-- ======================================================= -->
        <Grid Visibility="{Binding IsLarge, Converter={StaticResource BoolToVis}}"
              Margin="16,14,16,14">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
            </Grid.RowDefinitions>

            <!-- Top: Speech Balloon -->
            <Border Grid.Row="0"
                    Background="{StaticResource XpSpeechBubbleBackground}"
                    BorderBrush="#C4B478"
                    BorderThickness="1"
                    CornerRadius="10"
                    Padding="12,9"
                    Margin="0,0,0,12">
                <Border.Effect>
                    <DropShadowEffect BlurRadius="10" Direction="270" ShadowDepth="2" Opacity="0.22" Color="#000000" />
                </Border.Effect>
                <StackPanel>
                    <TextBlock Text="{Binding SpeechText}"
                               FontSize="13"
                               FontWeight="Medium"
                               FontFamily="Segoe UI Variable Display, Segoe UI, Tahoma, sans-serif"
                               Foreground="#1C1917"
                               TextWrapping="Wrap"
                               LineHeight="17" />

                    <TextBlock Text="{Binding StatusLabel}"
                               FontSize="10.5"
                               FontWeight="SemiBold"
                               Foreground="#78716C"
                               Margin="0,4,0,0" />
                </StackPanel>
            </Border>

            <!-- Center: Rover in play area -->
            <Viewbox Grid.Row="1" Width="124" Height="124" Stretch="Uniform"
                     HorizontalAlignment="Center" VerticalAlignment="Center">
                <Rectangle x:Name="RoverSpriteLarge"
                           Width="80" Height="80"
                           RenderOptions.BitmapScalingMode="NearestNeighbor">
                    <Rectangle.Fill>
                        <ImageBrush x:Name="SpriteBrushLarge"
                                    ImageSource="{x:Static rover:RoverSpriteAtlas.SharedAtlas}"
                                    ViewboxUnits="Absolute"
                                    Viewbox="0,0,80,80"
                                    Stretch="Fill" />
                    </Rectangle.Fill>
                </Rectangle>
            </Viewbox>
        </Grid>

        <!-- ======================================================= -->
        <!-- 4. BANNER 8x3 LAYOUT (Clean Wide Companion Deck)        -->
        <!-- ======================================================= -->
        <Grid Visibility="{Binding IsBanner, Converter={StaticResource BoolToVis}}"
              Margin="24,14,24,14"
              VerticalAlignment="Center">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>

            <!-- Left: Rover Sprite -->
            <Viewbox Grid.Column="0" Width="100" Height="100" Stretch="Uniform"
                     VerticalAlignment="Center" HorizontalAlignment="Left">
                <Rectangle x:Name="RoverSpriteBanner"
                           Width="80" Height="80"
                           RenderOptions.BitmapScalingMode="NearestNeighbor">
                    <Rectangle.Fill>
                        <ImageBrush x:Name="SpriteBrushBanner"
                                    ImageSource="{x:Static rover:RoverSpriteAtlas.SharedAtlas}"
                                    ViewboxUnits="Absolute"
                                    Viewbox="0,0,80,80"
                                    Stretch="Fill" />
                    </Rectangle.Fill>
                </Rectangle>
            </Viewbox>

            <!-- Right: Speech Balloon -->
            <Border Grid.Column="1"
                    Margin="18,0,0,0"
                    VerticalAlignment="Center"
                    Background="{StaticResource XpSpeechBubbleBackground}"
                    BorderBrush="#C4B478"
                    BorderThickness="1"
                    CornerRadius="12"
                    Padding="14,10">
                <Border.Effect>
                    <DropShadowEffect BlurRadius="10" Direction="270" ShadowDepth="2" Opacity="0.22" Color="#000000" />
                </Border.Effect>
                <StackPanel>
                    <TextBlock Text="Rover Desktop Companion"
                               FontSize="11"
                               FontWeight="Bold"
                               Foreground="#78716C"
                               Margin="0,0,0,4" />

                    <TextBlock Text="{Binding SpeechText}"
                               FontSize="13.5"
                               FontWeight="Medium"
                               FontFamily="Segoe UI Variable Display, Segoe UI, Tahoma, sans-serif"
                               Foreground="#1C1917"
                               TextWrapping="Wrap"
                               LineHeight="18" />

                    <TextBlock Text="{Binding StatusLabel}"
                               FontSize="11"
                               FontWeight="SemiBold"
                               Foreground="#78716C"
                               Margin="0,5,0,0" />
                </StackPanel>
            </Border>
        </Grid>
    </Grid>
</UserControl>
