<UserControl x:Class="MetroHub.Widgets.Catalog.Weather.LivingWeatherIcon"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             mc:Ignorable="d" 
             Focusable="False"
             SnapsToDevicePixels="True"
             UseLayoutRounding="True">

    <UserControl.Resources>
        <!-- ======================================================= -->
        <!-- 1. SUNNY / CLEAR DAY: MAJESTIC SLOW ROTATION OF SUN RAYS -->
        <!-- ======================================================= -->
        <Storyboard x:Key="SunnyRaysStoryboard" RepeatBehavior="Forever">
            <DoubleAnimation Storyboard.TargetName="SunRaysContainer"
                             Storyboard.TargetProperty="(UIElement.RenderTransform).(RotateTransform.Angle)"
                             From="0" To="360"
                             Duration="0:0:26" />
            <DoubleAnimationUsingKeyFrames Storyboard.TargetName="SunRaysContainer"
                                           Storyboard.TargetProperty="Opacity">
                <SplineDoubleKeyFrame KeyTime="0:0:0.0" Value="0.55" />
                <SplineDoubleKeyFrame KeyTime="0:0:3.5" Value="0.90" KeySpline="0.4,0.0,0.6,1.0" />
                <SplineDoubleKeyFrame KeyTime="0:0:7.0" Value="0.55" KeySpline="0.4,0.0,0.6,1.0" />
            </DoubleAnimationUsingKeyFrames>
            <!-- Organic floating breath on cloud / icon -->
            <DoubleAnimationUsingKeyFrames Storyboard.TargetName="BaseIconContainer"
                                           Storyboard.TargetProperty="(UIElement.RenderTransform).(TranslateTransform.Y)">
                <SplineDoubleKeyFrame KeyTime="0:0:0.0" Value="0" />
                <SplineDoubleKeyFrame KeyTime="0:0:2.6" Value="-2.5" KeySpline="0.4,0.0,0.6,1.0" />
                <SplineDoubleKeyFrame KeyTime="0:0:5.2" Value="0" KeySpline="0.4,0.0,0.6,1.0" />
            </DoubleAnimationUsingKeyFrames>
        </Storyboard>

        <!-- ======================================================= -->
        <!-- 2. CLEAR NIGHT: TWINKLING CELESTIAL STARS               -->
        <!-- ======================================================= -->
        <Storyboard x:Key="ClearNightStoryboard" RepeatBehavior="Forever">
            <!-- Star 1 Twinkle -->
            <DoubleAnimationUsingKeyFrames Storyboard.TargetName="Star1" Storyboard.TargetProperty="Opacity">
                <SplineDoubleKeyFrame KeyTime="0:0:0.0" Value="0.2" />
                <SplineDoubleKeyFrame KeyTime="0:0:1.2" Value="0.95" KeySpline="0.3,0.0,0.7,1.0" />
                <SplineDoubleKeyFrame KeyTime="0:0:2.4" Value="0.2" KeySpline="0.3,0.0,0.7,1.0" />
            </DoubleAnimationUsingKeyFrames>
            <DoubleAnimationUsingKeyFrames Storyboard.TargetName="Star1" Storyboard.TargetProperty="(UIElement.RenderTransform).(ScaleTransform.ScaleX)">
                <SplineDoubleKeyFrame KeyTime="0:0:0.0" Value="0.6" />
                <SplineDoubleKeyFrame KeyTime="0:0:1.2" Value="1.2" />
                <SplineDoubleKeyFrame KeyTime="0:0:2.4" Value="0.6" />
            </DoubleAnimationUsingKeyFrames>
            <DoubleAnimationUsingKeyFrames Storyboard.TargetName="Star1" Storyboard.TargetProperty="(UIElement.RenderTransform).(ScaleTransform.ScaleY)">
                <SplineDoubleKeyFrame KeyTime="0:0:0.0" Value="0.6" />
                <SplineDoubleKeyFrame KeyTime="0:0:1.2" Value="1.2" />
                <SplineDoubleKeyFrame KeyTime="0:0:2.4" Value="0.6" />
            </DoubleAnimationUsingKeyFrames>

            <!-- Star 2 Twinkle (Offset) -->
            <DoubleAnimationUsingKeyFrames Storyboard.TargetName="Star2" Storyboard.TargetProperty="Opacity">
                <SplineDoubleKeyFrame KeyTime="0:0:0.0" Value="0.7" />
                <SplineDoubleKeyFrame KeyTime="0:0:1.4" Value="0.15" />
                <SplineDoubleKeyFrame KeyTime="0:0:2.8" Value="0.7" />
            </DoubleAnimationUsingKeyFrames>
            <DoubleAnimationUsingKeyFrames Storyboard.TargetName="Star2" Storyboard.TargetProperty="(UIElement.RenderTransform).(ScaleTransform.ScaleX)">
                <SplineDoubleKeyFrame KeyTime="0:0:0.0" Value="1.1" />
                <SplineDoubleKeyFrame KeyTime="0:0:1.4" Value="0.5" />
                <SplineDoubleKeyFrame KeyTime="0:0:2.8" Value="1.1" />
            </DoubleAnimationUsingKeyFrames>
            <DoubleAnimationUsingKeyFrames Storyboard.TargetName="Star2" Storyboard.TargetProperty="(UIElement.RenderTransform).(ScaleTransform.ScaleY)">
                <SplineDoubleKeyFrame KeyTime="0:0:0.0" Value="1.1" />
                <SplineDoubleKeyFrame KeyTime="0:0:1.4" Value="0.5" />
                <SplineDoubleKeyFrame KeyTime="0:0:2.8" Value="1.1" />
            </DoubleAnimationUsingKeyFrames>

            <!-- Star 3 Twinkle (Offset) -->
            <DoubleAnimationUsingKeyFrames Storyboard.TargetName="Star3" Storyboard.TargetProperty="Opacity">
                <SplineDoubleKeyFrame KeyTime="0:0:0.0" Value="0.25" />
                <SplineDoubleKeyFrame KeyTime="0:0:1.6" Value="1.0" />
                <SplineDoubleKeyFrame KeyTime="0:0:3.2" Value="0.25" />
            </DoubleAnimationUsingKeyFrames>
            <DoubleAnimationUsingKeyFrames Storyboard.TargetName="Star3" Storyboard.TargetProperty="(UIElement.RenderTransform).(ScaleTransform.ScaleX)">
                <SplineDoubleKeyFrame KeyTime="0:0:0.0" Value="0.5" />
                <SplineDoubleKeyFrame KeyTime="0:0:1.6" Value="1.25" />
                <SplineDoubleKeyFrame KeyTime="0:0:3.2" Value="0.5" />
            </DoubleAnimationUsingKeyFrames>
            <DoubleAnimationUsingKeyFrames Storyboard.TargetName="Star3" Storyboard.TargetProperty="(UIElement.RenderTransform).(ScaleTransform.ScaleY)">
                <SplineDoubleKeyFrame KeyTime="0:0:0.0" Value="0.5" />
                <SplineDoubleKeyFrame KeyTime="0:0:1.6" Value="1.25" />
                <SplineDoubleKeyFrame KeyTime="0:0:3.2" Value="0.5" />
            </DoubleAnimationUsingKeyFrames>

            <!-- Organic floating breath on cloud / icon -->
            <DoubleAnimationUsingKeyFrames Storyboard.TargetName="BaseIconContainer"
                                           Storyboard.TargetProperty="(UIElement.RenderTransform).(TranslateTransform.Y)">
                <SplineDoubleKeyFrame KeyTime="0:0:0.0" Value="0" />
                <SplineDoubleKeyFrame KeyTime="0:0:2.6" Value="-2.5" KeySpline="0.4,0.0,0.6,1.0" />
                <SplineDoubleKeyFrame KeyTime="0:0:5.2" Value="0" KeySpline="0.4,0.0,0.6,1.0" />
            </DoubleAnimationUsingKeyFrames>
        </Storyboard>

        <!-- ======================================================= -->
        <!-- 3. RAIN: SLANTED RAINDROPS FADING DOWN BENEATH CLOUD   -->
        <!-- ======================================================= -->
        <Storyboard x:Key="RainStoryboard" RepeatBehavior="Forever">
            <!-- Drop 1 -->
            <DoubleAnimationUsingKeyFrames Storyboard.TargetName="RainDrop1" Storyboard.TargetProperty="(UIElement.RenderTransform).(TranslateTransform.Y)">
                <SplineDoubleKeyFrame KeyTime="0:0:0.0" Value="0" />
                <SplineDoubleKeyFrame KeyTime="0:0:0.8" Value="15" />
            </DoubleAnimationUsingKeyFrames>
            <DoubleAnimationUsingKeyFrames Storyboard.TargetName="RainDrop1" Storyboard.TargetProperty="Opacity">
                <SplineDoubleKeyFrame KeyTime="0:0:0.0" Value="0.0" />
                <SplineDoubleKeyFrame KeyTime="0:0:0.2" Value="0.85" />
                <SplineDoubleKeyFrame KeyTime="0:0:0.7" Value="0.85" />
                <SplineDoubleKeyFrame KeyTime="0:0:0.8" Value="0.0" />
            </DoubleAnimationUsingKeyFrames>

            <!-- Drop 2 (Offset by 0.26s) -->
            <DoubleAnimationUsingKeyFrames Storyboard.TargetName="RainDrop2" Storyboard.TargetProperty="(UIElement.RenderTransform).(TranslateTransform.Y)">
                <SplineDoubleKeyFrame KeyTime="0:0:0.0" Value="10" />
                <SplineDoubleKeyFrame KeyTime="0:0:0.26" Value="15" />
                <SplineDoubleKeyFrame KeyTime="0:0:0.27" Value="0" />
                <SplineDoubleKeyFrame KeyTime="0:0:0.8" Value="10" />
            </DoubleAnimationUsingKeyFrames>
            <DoubleAnimationUsingKeyFrames Storyboard.TargetName="RainDrop2" Storyboard.TargetProperty="Opacity">
                <SplineDoubleKeyFrame KeyTime="0:0:0.0" Value="0.7" />
                <SplineDoubleKeyFrame KeyTime="0:0:0.26" Value="0.0" />
                <SplineDoubleKeyFrame KeyTime="0:0:0.35" Value="0.85" />
                <SplineDoubleKeyFrame KeyTime="0:0:0.75" Value="0.85" />
                <SplineDoubleKeyFrame KeyTime="0:0:0.8" Value="0.7" />
            </DoubleAnimationUsingKeyFrames>

            <!-- Drop 3 (Offset by 0.52s) -->
            <DoubleAnimationUsingKeyFrames Storyboard.TargetName="RainDrop3" Storyboard.TargetProperty="(UIElement.RenderTransform).(TranslateTransform.Y)">
                <SplineDoubleKeyFrame KeyTime="0:0:0.0" Value="5" />
                <SplineDoubleKeyFrame KeyTime="0:0:0.52" Value="15" />
                <SplineDoubleKeyFrame KeyTime="0:0:0.53" Value="0" />
                <SplineDoubleKeyFrame KeyTime="0:0:0.8" Value="5" />
            </DoubleAnimationUsingKeyFrames>
            <DoubleAnimationUsingKeyFrames Storyboard.TargetName="RainDrop3" Storyboard.TargetProperty="Opacity">
                <SplineDoubleKeyFrame KeyTime="0:0:0.0" Value="0.5" />
                <SplineDoubleKeyFrame KeyTime="0:0:0.52" Value="0.0" />
                <SplineDoubleKeyFrame KeyTime="0:0:0.62" Value="0.85" />
                <SplineDoubleKeyFrame KeyTime="0:0:0.8" Value="0.5" />
            </DoubleAnimationUsingKeyFrames>

            <!-- Organic floating breath on cloud / icon -->
            <DoubleAnimationUsingKeyFrames Storyboard.TargetName="BaseIconContainer"
                                           Storyboard.TargetProperty="(UIElement.RenderTransform).(TranslateTransform.Y)">
                <SplineDoubleKeyFrame KeyTime="0:0:0.0" Value="0" />
                <SplineDoubleKeyFrame KeyTime="0:0:2.6" Value="-2.5" KeySpline="0.4,0.0,0.6,1.0" />
                <SplineDoubleKeyFrame KeyTime="0:0:5.2" Value="0" KeySpline="0.4,0.0,0.6,1.0" />
            </DoubleAnimationUsingKeyFrames>
        </Storyboard>

        <!-- ======================================================= -->
        <!-- 4. THUNDERSTORM: LIGHTNING STRIKE FLASH + RAIN          -->
        <!-- ======================================================= -->
        <Storyboard x:Key="StormStoryboard" RepeatBehavior="Forever">
            <!-- Lightning Flash Cycle (every 4.5 seconds) -->
            <DoubleAnimationUsingKeyFrames Storyboard.TargetName="StormFlash" Storyboard.TargetProperty="Opacity">
                <SplineDoubleKeyFrame KeyTime="0:0:0.0" Value="0.0" />
                <SplineDoubleKeyFrame KeyTime="0:0:3.2" Value="0.0" />
                <SplineDoubleKeyFrame KeyTime="0:0:3.28" Value="0.85" />
                <SplineDoubleKeyFrame KeyTime="0:0:3.36" Value="0.15" />
                <SplineDoubleKeyFrame KeyTime="0:0:3.45" Value="1.0" />
                <SplineDoubleKeyFrame KeyTime="0:0:3.65" Value="0.0" />
                <SplineDoubleKeyFrame KeyTime="0:0:4.5" Value="0.0" />
            </DoubleAnimationUsingKeyFrames>
            <DoubleAnimationUsingKeyFrames Storyboard.TargetName="StormBolt" Storyboard.TargetProperty="Opacity">
                <SplineDoubleKeyFrame KeyTime="0:0:0.0" Value="0.0" />
                <SplineDoubleKeyFrame KeyTime="0:0:3.2" Value="0.0" />
                <SplineDoubleKeyFrame KeyTime="0:0:3.28" Value="0.9" />
                <SplineDoubleKeyFrame KeyTime="0:0:3.36" Value="0.2" />
                <SplineDoubleKeyFrame KeyTime="0:0:3.45" Value="1.0" />
                <SplineDoubleKeyFrame KeyTime="0:0:3.65" Value="0.0" />
                <SplineDoubleKeyFrame KeyTime="0:0:4.5" Value="0.0" />
            </DoubleAnimationUsingKeyFrames>
            <!-- Organic floating breath on cloud / icon -->
            <DoubleAnimationUsingKeyFrames Storyboard.TargetName="BaseIconContainer"
                                           Storyboard.TargetProperty="(UIElement.RenderTransform).(TranslateTransform.Y)">
                <SplineDoubleKeyFrame KeyTime="0:0:0.0" Value="0" />
                <SplineDoubleKeyFrame KeyTime="0:0:2.6" Value="-2.5" KeySpline="0.4,0.0,0.6,1.0" />
                <SplineDoubleKeyFrame KeyTime="0:0:5.2" Value="0" KeySpline="0.4,0.0,0.6,1.0" />
            </DoubleAnimationUsingKeyFrames>
        </Storyboard>

        <!-- ======================================================= -->
        <!-- 5. SNOW: GENTLE DRIFTING SWAYING SNOWFLAKES             -->
        <!-- ======================================================= -->
        <Storyboard x:Key="SnowStoryboard" RepeatBehavior="Forever">
            <!-- Flake 1 -->
            <DoubleAnimationUsingKeyFrames Storyboard.TargetName="SnowFlake1" Storyboard.TargetProperty="(UIElement.RenderTransform).(TranslateTransform.Y)">
                <SplineDoubleKeyFrame KeyTime="0:0:0.0" Value="0" />
                <SplineDoubleKeyFrame KeyTime="0:0:2.5" Value="16" />
            </DoubleAnimationUsingKeyFrames>
            <DoubleAnimationUsingKeyFrames Storyboard.TargetName="SnowFlake1" Storyboard.TargetProperty="(UIElement.RenderTransform).(TranslateTransform.X)">
                <SplineDoubleKeyFrame KeyTime="0:0:0.0" Value="0" />
                <SplineDoubleKeyFrame KeyTime="0:0:0.8" Value="-3" />
                <SplineDoubleKeyFrame KeyTime="0:0:1.7" Value="2" />
                <SplineDoubleKeyFrame KeyTime="0:0:2.5" Value="0" />
            </DoubleAnimationUsingKeyFrames>
            <DoubleAnimationUsingKeyFrames Storyboard.TargetName="SnowFlake1" Storyboard.TargetProperty="Opacity">
                <SplineDoubleKeyFrame KeyTime="0:0:0.0" Value="0.0" />
                <SplineDoubleKeyFrame KeyTime="0:0:0.5" Value="0.9" />
                <SplineDoubleKeyFrame KeyTime="0:0:2.0" Value="0.9" />
                <SplineDoubleKeyFrame KeyTime="0:0:2.5" Value="0.0" />
            </DoubleAnimationUsingKeyFrames>

            <!-- Flake 2 (Offset) -->
            <DoubleAnimationUsingKeyFrames Storyboard.TargetName="SnowFlake2" Storyboard.TargetProperty="(UIElement.RenderTransform).(TranslateTransform.Y)">
                <SplineDoubleKeyFrame KeyTime="0:0:0.0" Value="10" />
                <SplineDoubleKeyFrame KeyTime="0:0:1.0" Value="16" />
                <SplineDoubleKeyFrame KeyTime="0:0:1.01" Value="0" />
                <SplineDoubleKeyFrame KeyTime="0:0:2.5" Value="10" />
            </DoubleAnimationUsingKeyFrames>
            <DoubleAnimationUsingKeyFrames Storyboard.TargetName="SnowFlake2" Storyboard.TargetProperty="(UIElement.RenderTransform).(TranslateTransform.X)">
                <SplineDoubleKeyFrame KeyTime="0:0:0.0" Value="0" />
                <SplineDoubleKeyFrame KeyTime="0:0:0.8" Value="3" />
                <SplineDoubleKeyFrame KeyTime="0:0:1.6" Value="-2" />
                <SplineDoubleKeyFrame KeyTime="0:0:2.5" Value="0" />
            </DoubleAnimationUsingKeyFrames>
            <DoubleAnimationUsingKeyFrames Storyboard.TargetName="SnowFlake2" Storyboard.TargetProperty="Opacity">
                <SplineDoubleKeyFrame KeyTime="0:0:0.0" Value="0.6" />
                <SplineDoubleKeyFrame KeyTime="0:0:1.0" Value="0.0" />
                <SplineDoubleKeyFrame KeyTime="0:0:1.3" Value="0.85" />
                <SplineDoubleKeyFrame KeyTime="0:0:2.3" Value="0.85" />
                <SplineDoubleKeyFrame KeyTime="0:0:2.5" Value="0.6" />
            </DoubleAnimationUsingKeyFrames>

            <!-- Organic floating breath on cloud / icon -->
            <DoubleAnimationUsingKeyFrames Storyboard.TargetName="BaseIconContainer"
                                           Storyboard.TargetProperty="(UIElement.RenderTransform).(TranslateTransform.Y)">
                <SplineDoubleKeyFrame KeyTime="0:0:0.0" Value="0" />
                <SplineDoubleKeyFrame KeyTime="0:0:2.6" Value="-2.5" KeySpline="0.4,0.0,0.6,1.0" />
                <SplineDoubleKeyFrame KeyTime="0:0:5.2" Value="0" KeySpline="0.4,0.0,0.6,1.0" />
            </DoubleAnimationUsingKeyFrames>
        </Storyboard>

        <!-- ======================================================= -->
        <!-- 6. WIND: SUBTLE BREEZE SWEEP CURVES                    -->
        <!-- ======================================================= -->
        <Storyboard x:Key="WindStoryboard" RepeatBehavior="Forever">
            <!-- Breeze Curve 1 -->
            <DoubleAnimationUsingKeyFrames Storyboard.TargetName="WindCurve1" Storyboard.TargetProperty="(UIElement.RenderTransform).(TranslateTransform.X)">
                <SplineDoubleKeyFrame KeyTime="0:0:0.0" Value="-22" />
                <SplineDoubleKeyFrame KeyTime="0:0:1.8" Value="24" KeySpline="0.2,0.6,0.4,1.0" />
                <SplineDoubleKeyFrame KeyTime="0:0:3.2" Value="24" />
            </DoubleAnimationUsingKeyFrames>
            <DoubleAnimationUsingKeyFrames Storyboard.TargetName="WindCurve1" Storyboard.TargetProperty="Opacity">
                <SplineDoubleKeyFrame KeyTime="0:0:0.0" Value="0.0" />
                <SplineDoubleKeyFrame KeyTime="0:0:0.4" Value="0.8" />
                <SplineDoubleKeyFrame KeyTime="0:0:1.4" Value="0.8" />
                <SplineDoubleKeyFrame KeyTime="0:0:1.8" Value="0.0" />
                <SplineDoubleKeyFrame KeyTime="0:0:3.2" Value="0.0" />
            </DoubleAnimationUsingKeyFrames>

            <!-- Breeze Curve 2 (Offset by 1.2s) -->
            <DoubleAnimationUsingKeyFrames Storyboard.TargetName="WindCurve2" Storyboard.TargetProperty="(UIElement.RenderTransform).(TranslateTransform.X)">
                <SplineDoubleKeyFrame KeyTime="0:0:0.0" Value="-20" />
                <SplineDoubleKeyFrame KeyTime="0:0:1.2" Value="-20" />
                <SplineDoubleKeyFrame KeyTime="0:0:2.8" Value="26" KeySpline="0.2,0.6,0.4,1.0" />
                <SplineDoubleKeyFrame KeyTime="0:0:3.2" Value="26" />
            </DoubleAnimationUsingKeyFrames>
            <DoubleAnimationUsingKeyFrames Storyboard.TargetName="WindCurve2" Storyboard.TargetProperty="Opacity">
                <SplineDoubleKeyFrame KeyTime="0:0:0.0" Value="0.0" />
                <SplineDoubleKeyFrame KeyTime="0:0:1.2" Value="0.0" />
                <SplineDoubleKeyFrame KeyTime="0:0:1.6" Value="0.7" />
                <SplineDoubleKeyFrame KeyTime="0:0:2.4" Value="0.7" />
                <SplineDoubleKeyFrame KeyTime="0:0:2.8" Value="0.0" />
                <SplineDoubleKeyFrame KeyTime="0:0:3.2" Value="0.0" />
            </DoubleAnimationUsingKeyFrames>

            <!-- Organic floating breath on cloud / icon -->
            <DoubleAnimationUsingKeyFrames Storyboard.TargetName="BaseIconContainer"
                                           Storyboard.TargetProperty="(UIElement.RenderTransform).(TranslateTransform.Y)">
                <SplineDoubleKeyFrame KeyTime="0:0:0.0" Value="0" />
                <SplineDoubleKeyFrame KeyTime="0:0:2.6" Value="-2.5" KeySpline="0.4,0.0,0.6,1.0" />
                <SplineDoubleKeyFrame KeyTime="0:0:5.2" Value="0" KeySpline="0.4,0.0,0.6,1.0" />
            </DoubleAnimationUsingKeyFrames>
        </Storyboard>

        <!-- ======================================================= -->
        <!-- 7. FOG: ETHEREAL MIST RIBBONS WAFTING                   -->
        <!-- ======================================================= -->
        <Storyboard x:Key="FogStoryboard" RepeatBehavior="Forever">
            <DoubleAnimationUsingKeyFrames Storyboard.TargetName="FogWisp1" Storyboard.TargetProperty="(UIElement.RenderTransform).(TranslateTransform.X)">
                <SplineDoubleKeyFrame KeyTime="0:0:0.0" Value="-7" />
                <SplineDoubleKeyFrame KeyTime="0:0:2.6" Value="7" KeySpline="0.4,0.0,0.6,1.0" />
                <SplineDoubleKeyFrame KeyTime="0:0:5.2" Value="-7" KeySpline="0.4,0.0,0.6,1.0" />
            </DoubleAnimationUsingKeyFrames>
            <DoubleAnimationUsingKeyFrames Storyboard.TargetName="FogWisp1" Storyboard.TargetProperty="Opacity">
                <SplineDoubleKeyFrame KeyTime="0:0:0.0" Value="0.35" />
                <SplineDoubleKeyFrame KeyTime="0:0:2.6" Value="0.75" />
                <SplineDoubleKeyFrame KeyTime="0:0:5.2" Value="0.35" />
            </DoubleAnimationUsingKeyFrames>

            <DoubleAnimationUsingKeyFrames Storyboard.TargetName="FogWisp2" Storyboard.TargetProperty="(UIElement.RenderTransform).(TranslateTransform.X)">
                <SplineDoubleKeyFrame KeyTime="0:0:0.0" Value="5" />
                <SplineDoubleKeyFrame KeyTime="0:0:2.2" Value="-6" KeySpline="0.4,0.0,0.6,1.0" />
                <SplineDoubleKeyFrame KeyTime="0:0:4.4" Value="5" KeySpline="0.4,0.0,0.6,1.0" />
            </DoubleAnimationUsingKeyFrames>
            <DoubleAnimationUsingKeyFrames Storyboard.TargetName="FogWisp2" Storyboard.TargetProperty="Opacity">
                <SplineDoubleKeyFrame KeyTime="0:0:0.0" Value="0.65" />
                <SplineDoubleKeyFrame KeyTime="0:0:2.2" Value="0.3" />
                <SplineDoubleKeyFrame KeyTime="0:0:4.4" Value="0.65" />
            </DoubleAnimationUsingKeyFrames>

            <!-- Organic floating breath on cloud / icon -->
            <DoubleAnimationUsingKeyFrames Storyboard.TargetName="BaseIconContainer"
                                           Storyboard.TargetProperty="(UIElement.RenderTransform).(TranslateTransform.Y)">
                <SplineDoubleKeyFrame KeyTime="0:0:0.0" Value="0" />
                <SplineDoubleKeyFrame KeyTime="0:0:2.6" Value="-2.5" KeySpline="0.4,0.0,0.6,1.0" />
                <SplineDoubleKeyFrame KeyTime="0:0:5.2" Value="0" KeySpline="0.4,0.0,0.6,1.0" />
            </DoubleAnimationUsingKeyFrames>
        </Storyboard>

        <!-- ======================================================= -->
        <!-- 8. CLOUDS: SUBTLE ORGANIC FLOATING BREATH               -->
        <!-- ======================================================= -->
        <Storyboard x:Key="CloudFloatingStoryboard" RepeatBehavior="Forever">
            <DoubleAnimationUsingKeyFrames Storyboard.TargetName="BaseIconContainer" Storyboard.TargetProperty="(UIElement.RenderTransform).(TranslateTransform.Y)">
                <SplineDoubleKeyFrame KeyTime="0:0:0.0" Value="0" />
                <SplineDoubleKeyFrame KeyTime="0:0:2.6" Value="-3.5" KeySpline="0.4,0.0,0.6,1.0" />
                <SplineDoubleKeyFrame KeyTime="0:0:5.2" Value="0" KeySpline="0.4,0.0,0.6,1.0" />
            </DoubleAnimationUsingKeyFrames>
        </Storyboard>
    </UserControl.Resources>

    <Viewbox Stretch="Uniform">
        <Grid Width="80" Height="80" ClipToBounds="False">
            <!-- ======================================================= -->
            <!-- LAYER 0: BACKGROUND ATMOSPHERIC AMBIENT AURA            -->
            <!-- ======================================================= -->

            <!-- 1. Sunny Golden Solar Ray Corona (Behind icon) -->
            <Grid x:Name="SunRaysContainer"
                  Width="74" Height="74"
                  HorizontalAlignment="Center" VerticalAlignment="Center"
                  Visibility="Collapsed"
                  Opacity="0.7"
                  RenderTransformOrigin="0.5,0.5">
                <Grid.RenderTransform>
                    <RotateTransform x:Name="SunRaysTransform" Angle="0" />
                </Grid.RenderTransform>

                <!-- 8 Delicate Vector Sun Rays Radiating Outward -->
                <Path Stroke="#F59E0B"
                      StrokeThickness="1.5"
                      StrokeStartLineCap="Round"
                      StrokeEndLineCap="Round"
                      Data="M 37,2 L 37,10  M 37,64 L 37,72  M 2,37 L 10,37  M 64,37 L 72,37
                            M 12,12 L 18,18  M 56,56 L 62,62  M 12,62 L 18,56  M 56,18 L 62,12" />
                
                <!-- Inner Sun Corona Glow -->
                <Ellipse Width="44" Height="44"
                         HorizontalAlignment="Center" VerticalAlignment="Center"
                         Fill="#20F59E0B" />
            </Grid>

            <!-- 2. Electric Storm Flash Aura -->
            <Ellipse x:Name="StormFlash"
                     Width="76" Height="66"
                     HorizontalAlignment="Center" VerticalAlignment="Center"
                     Fill="#45A78BFA"
                     Visibility="Collapsed"
                     Opacity="0.0" />

            <!-- ======================================================= -->
            <!-- LAYER 1: BASE 3D GLASS WEATHER ICON                     -->
            <!-- ======================================================= -->
            <Grid x:Name="BaseIconContainer"
                  HorizontalAlignment="Center" VerticalAlignment="Center">
                <Grid.RenderTransform>
                    <TranslateTransform x:Name="CloudFloatTrans" Y="0" />
                </Grid.RenderTransform>

                <Image x:Name="BaseWeatherImage"
                       Source="{Binding IconSource, RelativeSource={RelativeSource AncestorType=UserControl}}"
                       Width="68" Height="68"
                       RenderOptions.BitmapScalingMode="HighQuality"
                       SnapsToDevicePixels="True"
                       RenderTransformOrigin="0.5,0.5">
                    <Image.Effect>
                        <DropShadowEffect BlurRadius="14" Direction="270" ShadowDepth="3" Opacity="0.25" Color="#000000" />
                    </Image.Effect>
                </Image>
            </Grid>

            <!-- ======================================================= -->
            <!-- LAYER 2: FOREGROUND LIVING WEATHER ELEMENTS             -->
            <!-- ======================================================= -->

            <!-- 1. Clear Night: Twinkling Celestial Stars -->
            <Grid x:Name="ClearNightContainer"
                  Visibility="Collapsed"
                  IsHitTestVisible="False">
                <!-- Star 1 (Top Left) -->
                <Path x:Name="Star1"
                      Fill="#FFFFFF"
                      Data="M 0,-3.5 Q 0,0 3.5,0 Q 0,0 0,3.5 Q 0,0 -3.5,0 Q 0,0 0,-3.5 Z"
                      Margin="16,16,0,0"
                      HorizontalAlignment="Left" VerticalAlignment="Top"
                      RenderTransformOrigin="0.5,0.5">
                    <Path.RenderTransform>
                        <ScaleTransform x:Name="StarScale1" ScaleX="1.0" ScaleY="1.0" />
                    </Path.RenderTransform>
                </Path>

                <!-- Star 2 (Top Right) -->
                <Path x:Name="Star2"
                      Fill="#E0E7FF"
                      Data="M 0,-2.8 Q 0,0 2.8,0 Q 0,0 0,2.8 Q 0,0 -2.8,0 Q 0,0 0,-2.8 Z"
                      Margin="0,14,16,0"
                      HorizontalAlignment="Right" VerticalAlignment="Top"
                      RenderTransformOrigin="0.5,0.5">
                    <Path.RenderTransform>
                        <ScaleTransform x:Name="StarScale2" ScaleX="1.0" ScaleY="1.0" />
                    </Path.RenderTransform>
                </Path>

                <!-- Star 3 (Bottom Right) -->
                <Path x:Name="Star3"
                      Fill="#FDF2F8"
                      Data="M 0,-2.2 Q 0,0 2.2,0 Q 0,0 0,2.2 Q 0,0 -2.2,0 Q 0,0 0,-2.2 Z"
                      Margin="0,0,18,22"
                      HorizontalAlignment="Right" VerticalAlignment="Bottom"
                      RenderTransformOrigin="0.5,0.5">
                    <Path.RenderTransform>
                        <ScaleTransform x:Name="StarScale3" ScaleX="1.0" ScaleY="1.0" />
                    </Path.RenderTransform>
                </Path>
            </Grid>

            <!-- 2. Rain: Slanted Raindrops Beneath Cloud -->
            <Grid x:Name="RainContainer"
                  Visibility="Collapsed"
                  IsHitTestVisible="False">
                <!-- Raindrop 1 (Left) -->
                <Line x:Name="RainDrop1"
                      X1="0" Y1="0" X2="-2.5" Y2="8"
                      Stroke="#60A5FA"
                      StrokeThickness="1.75"
                      StrokeStartLineCap="Round"
                      StrokeEndLineCap="Round"
                      Margin="26,48,0,0"
                      HorizontalAlignment="Left" VerticalAlignment="Top">
                    <Line.RenderTransform>
                        <TranslateTransform x:Name="RainDropTrans1" Y="0" />
                    </Line.RenderTransform>
                </Line>

                <!-- Raindrop 2 (Center) -->
                <Line x:Name="RainDrop2"
                      X1="0" Y1="0" X2="-2.5" Y2="8"
                      Stroke="#60A5FA"
                      StrokeThickness="1.75"
                      StrokeStartLineCap="Round"
                      StrokeEndLineCap="Round"
                      Margin="40,52,0,0"
                      HorizontalAlignment="Left" VerticalAlignment="Top">
                    <Line.RenderTransform>
                        <TranslateTransform x:Name="RainDropTrans2" Y="0" />
                    </Line.RenderTransform>
                </Line>

                <!-- Raindrop 3 (Right) -->
                <Line x:Name="RainDrop3"
                      X1="0" Y1="0" X2="-2.5" Y2="8"
                      Stroke="#60A5FA"
                      StrokeThickness="1.75"
                      StrokeStartLineCap="Round"
                      StrokeEndLineCap="Round"
                      Margin="54,49,0,0"
                      HorizontalAlignment="Left" VerticalAlignment="Top">
                    <Line.RenderTransform>
                        <TranslateTransform x:Name="RainDropTrans3" Y="0" />
                    </Line.RenderTransform>
                </Line>
            </Grid>

            <!-- 3. Thunderstorm: Electric Lightning Bolt -->
            <Grid x:Name="StormContainer"
                  Visibility="Collapsed"
                  IsHitTestVisible="False">
                <Path x:Name="StormBolt"
                      Data="M 6,0 L 0,8 L 5,8 L -1,16"
                      Stroke="#FDE047"
                      StrokeThickness="2.0"
                      StrokeLineJoin="Round"
                      StrokeStartLineCap="Round"
                      StrokeEndLineCap="Round"
                      Fill="#FDE047"
                      Margin="38,44,0,0"
                      HorizontalAlignment="Left" VerticalAlignment="Top"
                      Opacity="0.0" />
            </Grid>

            <!-- 4. Snow: Drifting Swaying Snowflakes -->
            <Grid x:Name="SnowContainer"
                  Visibility="Collapsed"
                  IsHitTestVisible="False">
                <Ellipse x:Name="SnowFlake1"
                         Width="3.2" Height="3.2"
                         Fill="#FFFFFF"
                         Margin="24,48,0,0"
                         HorizontalAlignment="Left" VerticalAlignment="Top">
                    <Ellipse.RenderTransform>
                        <TranslateTransform x:Name="SnowTrans1" X="0" Y="0" />
                    </Ellipse.RenderTransform>
                </Ellipse>

                <Ellipse x:Name="SnowFlake2"
                         Width="2.6" Height="2.6"
                         Fill="#F0F9FF"
                         Margin="42,52,0,0"
                         HorizontalAlignment="Left" VerticalAlignment="Top">
                    <Ellipse.RenderTransform>
                        <TranslateTransform x:Name="SnowTrans2" X="0" Y="0" />
                    </Ellipse.RenderTransform>
                </Ellipse>

                <Ellipse x:Name="SnowFlake3"
                         Width="3.0" Height="3.0"
                         Fill="#FFFFFF"
                         Margin="56,49,0,0"
                         HorizontalAlignment="Left" VerticalAlignment="Top">
                    <Ellipse.RenderTransform>
                        <TranslateTransform x:Name="SnowTrans3" X="0" Y="0" />
                    </Ellipse.RenderTransform>
                </Ellipse>
            </Grid>

            <!-- 5. Wind: Subtle Breeze Sweep Curves -->
            <Grid x:Name="WindContainer"
                  Visibility="Collapsed"
                  IsHitTestVisible="False">
                <Path x:Name="WindCurve1"
                      Data="M 12,28 C 22,24 34,32 48,27 C 54,25 60,28 62,30"
                      Stroke="#BAE6FD"
                      StrokeThickness="1.4"
                      StrokeStartLineCap="Round"
                      StrokeEndLineCap="Round"
                      Opacity="0.0">
                    <Path.RenderTransform>
                        <TranslateTransform x:Name="WindTrans1" X="0" />
                    </Path.RenderTransform>
                </Path>

                <Path x:Name="WindCurve2"
                      Data="M 18,52 C 28,48 40,56 52,52 C 58,50 62,53 64,55"
                      Stroke="#93C5FD"
                      StrokeThickness="1.4"
                      StrokeStartLineCap="Round"
                      StrokeEndLineCap="Round"
                      Opacity="0.0">
                    <Path.RenderTransform>
                        <TranslateTransform x:Name="WindTrans2" X="0" />
                    </Path.RenderTransform>
                </Path>
            </Grid>

            <!-- 6. Fog: Ethereal Mist Ribbons -->
            <Grid x:Name="FogContainer"
                  Visibility="Collapsed"
                  IsHitTestVisible="False">
                <Border x:Name="FogWisp1"
                        Width="46" Height="2.5"
                        CornerRadius="1.25"
                        Margin="17,50,0,0"
                        HorizontalAlignment="Left" VerticalAlignment="Top">
                    <Border.Background>
                        <LinearGradientBrush StartPoint="0,0" EndPoint="1,0">
                            <GradientStop Color="#00FFFFFF" Offset="0" />
                            <GradientStop Color="#65E2E8F0" Offset="0.5" />
                            <GradientStop Color="#00FFFFFF" Offset="1" />
                        </LinearGradientBrush>
                    </Border.Background>
                    <Border.RenderTransform>
                        <TranslateTransform x:Name="FogTrans1" X="0" />
                    </Border.RenderTransform>
                </Border>

                <Border x:Name="FogWisp2"
                        Width="40" Height="2.5"
                        CornerRadius="1.25"
                        Margin="23,58,0,0"
                        HorizontalAlignment="Left" VerticalAlignment="Top">
                    <Border.Background>
                        <LinearGradientBrush StartPoint="0,0" EndPoint="1,0">
                            <GradientStop Color="#00FFFFFF" Offset="0" />
                            <GradientStop Color="#55E2E8F0" Offset="0.5" />
                            <GradientStop Color="#00FFFFFF" Offset="1" />
                        </LinearGradientBrush>
                    </Border.Background>
                    <Border.RenderTransform>
                        <TranslateTransform x:Name="FogTrans2" X="0" />
                    </Border.RenderTransform>
                </Border>
            </Grid>

        </Grid>
    </Viewbox>
</UserControl>
