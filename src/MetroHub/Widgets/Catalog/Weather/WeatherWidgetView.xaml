<UserControl x:Class="MetroHub.Widgets.Catalog.Weather.WeatherWidgetView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:widgets="clr-namespace:MetroHub.Widgets"
             xmlns:weather="clr-namespace:MetroHub.Widgets.Catalog.Weather"
             mc:Ignorable="d" 
             d:DataContext="{d:DesignInstance Type=weather:WeatherWidgetViewModel}"
             Focusable="False"
             SnapsToDevicePixels="True"
             UseLayoutRounding="True"
             TextOptions.TextFormattingMode="Ideal"
             TextOptions.TextRenderingMode="Grayscale"
             TextOptions.TextHintingMode="Animated">

    <UserControl.Resources>
        <BooleanToVisibilityConverter x:Key="BoolToVis" />

        <!-- Media-Consistent 32x28 Transparent Button Style -->
        <Style x:Key="WeatherTransportButtonStyle" TargetType="Button">
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="Foreground" Value="#E0FFFFFF" />
            <Setter Property="Width" Value="32" />
            <Setter Property="Height" Value="28" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Focusable" Value="False" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Border"
                                Background="{TemplateBinding Background}"
                                CornerRadius="2"
                                SnapsToDevicePixels="True">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Border" Property="Background" Value="#25FFFFFF" />
                                <Setter Property="Foreground" Value="#FFFFFF" />
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="Border" Property="Background" Value="#40FFFFFF" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </UserControl.Resources>

    <widgets:WidgetCard Padding="0">
        <Grid SnapsToDevicePixels="True" UseLayoutRounding="True">
            <!-- 1. Atmospheric Ambient Condition Aura (Dynamic, 100% GPU-drawn frozen brush, 0 CPU/RAM) -->
            <Border Background="{Binding AmbientGlowBrush}"
                    CornerRadius="2"
                    IsHitTestVisible="False" />

            <!-- 2. Glass Top Specular Sheen (Subtle light catch across upper half) -->
            <Border CornerRadius="2"
                    IsHitTestVisible="False">
                <Border.Background>
                    <LinearGradientBrush StartPoint="0,0" EndPoint="0,1">
                        <GradientStop Color="#15FFFFFF" Offset="0.0" />
                        <GradientStop Color="#04FFFFFF" Offset="0.30" />
                        <GradientStop Color="#00000000" Offset="0.65" />
                    </LinearGradientBrush>
                </Border.Background>
            </Border>

            <!-- 3. Glass Top Rim Light (1px specular edge along top border) -->
            <Border CornerRadius="2"
                    BorderThickness="0,1,0,0"
                    IsHitTestVisible="False">
                <Border.BorderBrush>
                    <LinearGradientBrush StartPoint="0,0" EndPoint="1,0">
                        <GradientStop Color="#00FFFFFF" Offset="0.0" />
                        <GradientStop Color="#30FFFFFF" Offset="0.5" />
                        <GradientStop Color="#00FFFFFF" Offset="1.0" />
                    </LinearGradientBrush>
                </Border.BorderBrush>
            </Border>

            <!-- ======================================================= -->
            <!-- 1. WIDE 4x2 LAYOUT (Ultra-Clean Icon + Temperature)      -->
            <!-- ======================================================= -->
            <Viewbox Visibility="{Binding IsWide, Converter={StaticResource BoolToVis}}"
                     Margin="16,12,16,12"
                     Stretch="Uniform"
                     HorizontalAlignment="Stretch"
                     VerticalAlignment="Center">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="12" /> <!-- Spacing -->
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>

                    <!-- Left: Standardized Optical Weather Icon -->
                    <Image Grid.Column="0"
                           Source="{Binding WeatherIconSource}"
                           Height="100" Width="100"
                           RenderOptions.BitmapScalingMode="HighQuality"
                           SnapsToDevicePixels="True"
                           VerticalAlignment="Center"
                           RenderTransformOrigin="0.5,0.5">
                        <Image.RenderTransform>
                            <ScaleTransform ScaleX="1.5" ScaleY="1.5" />
                        </Image.RenderTransform>
                        <Image.Effect>
                            <DropShadowEffect BlurRadius="12" Direction="270" ShadowDepth="2" Opacity="0.25" Color="#000000" />
                        </Image.Effect>
                    </Image>

                    <!-- Right: Standardized Temperature (Matched height) -->
                    <TextBlock Grid.Column="2"
                               Text="{Binding TemperatureText}"
                               FontSize="110"
                               FontWeight="Bold"
                               FontFamily="Segoe UI Variable Display, Segoe UI, sans-serif"
                               Foreground="#FFFFFF"
                               VerticalAlignment="Center"
                               Margin="0,-6,0,0">
                        <TextBlock.Effect>
                            <DropShadowEffect BlurRadius="28" Direction="270" ShadowDepth="4" Opacity="0.22" Color="#080E1A" />
                        </TextBlock.Effect>
                    </TextBlock>
                </Grid>
            </Viewbox>

            <!-- ======================================================= -->
            <!-- 2. LARGE 4x4 LAYOUT (Image 1 Modern Claymorphic Card)   -->
            <!-- ======================================================= -->
            <Grid Visibility="{Binding IsSquareLarge, Converter={StaticResource BoolToVis}}"
                  Margin="22,20,22,18">
                <Grid.RowDefinitions>
                    <RowDefinition Height="*" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>

                <!-- Top Row: Large Hero Icon (Left) + Large Temp & Condition (Right) -->
                <Grid Grid.Row="0" VerticalAlignment="Center">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>

                    <!-- Left: Large Weather Icon -->
                    <Image Grid.Column="0"
                           Source="{Binding WeatherIconSource}"
                           Width="76" Height="76"
                           RenderOptions.BitmapScalingMode="HighQuality"
                           SnapsToDevicePixels="True"
                           HorizontalAlignment="Left"
                           VerticalAlignment="Center"
                           RenderTransformOrigin="0.5,0.5">
                        <Image.RenderTransform>
                            <ScaleTransform ScaleX="1.4" ScaleY="1.4" />
                        </Image.RenderTransform>
                        <Image.Effect>
                            <DropShadowEffect BlurRadius="16" Direction="270" ShadowDepth="4" Opacity="0.30" Color="#000000" />
                        </Image.Effect>
                    </Image>

                    <!-- Right: Large Temperature & Condition -->
                    <StackPanel Grid.Column="1"
                                VerticalAlignment="Center"
                                HorizontalAlignment="Right">
                        <TextBlock Text="{Binding TemperatureText}"
                                   FontSize="54"
                                   FontWeight="Bold"
                                   FontFamily="Segoe UI Variable Display, Segoe UI, sans-serif"
                                   Foreground="#FFFFFF"
                                   HorizontalAlignment="Right">
                            <TextBlock.Effect>
                                <DropShadowEffect BlurRadius="22" Direction="270" ShadowDepth="3.5" Opacity="0.20" Color="#080E1A" />
                            </TextBlock.Effect>
                        </TextBlock>
                        <TextBlock Text="{Binding ConditionText}"
                                   FontSize="15"
                                   FontWeight="SemiBold"
                                   FontFamily="Segoe UI Variable Text, Segoe UI, sans-serif"
                                   Foreground="#D8E2EC"
                                   HorizontalAlignment="Right"
                                   Margin="0,2,0,0" />
                    </StackPanel>
                </Grid>

                <!-- Bottom Row: 3 Neat Metric Columns (AQI, Humidity, Precip) - Razor-sharp text, zero shadow blur -->
                <UniformGrid Grid.Row="1" Columns="3" VerticalAlignment="Center" Margin="0,16,0,6">
                    <!-- Column 1: AQI -->
                    <StackPanel HorizontalAlignment="Center">
                        <TextBlock Text="AQI"
                                   FontSize="12"
                                   FontFamily="Segoe UI Variable Text, Segoe UI, sans-serif"
                                   Foreground="#95A8BE"
                                   HorizontalAlignment="Center" />
                        <TextBlock Text="{Binding AqiText}"
                                   FontSize="16"
                                   FontWeight="Bold"
                                   FontFamily="Segoe UI Variable Display, Segoe UI, sans-serif"
                                   Foreground="#FFFFFF"
                                   HorizontalAlignment="Center"
                                   Margin="0,4,0,0" />
                    </StackPanel>

                    <!-- Column 2: Humidity -->
                    <StackPanel HorizontalAlignment="Center">
                        <TextBlock Text="Humidity"
                                   FontSize="12"
                                   FontFamily="Segoe UI Variable Text, Segoe UI, sans-serif"
                                   Foreground="#95A8BE"
                                   HorizontalAlignment="Center" />
                        <TextBlock Text="{Binding HumidityText}"
                                   FontSize="16"
                                   FontWeight="Bold"
                                   FontFamily="Segoe UI Variable Display, Segoe UI, sans-serif"
                                   Foreground="#FFFFFF"
                                   HorizontalAlignment="Center"
                                   Margin="0,4,0,0" />
                    </StackPanel>

                    <!-- Column 3: Precipitation -->
                    <StackPanel HorizontalAlignment="Center">
                        <TextBlock Text="Precip"
                                   FontSize="12"
                                   FontFamily="Segoe UI Variable Text, Segoe UI, sans-serif"
                                   Foreground="#95A8BE"
                                   HorizontalAlignment="Center" />
                        <TextBlock Text="{Binding PrecipitationProbabilityText}"
                                   FontSize="16"
                                   FontWeight="Bold"
                                   FontFamily="Segoe UI Variable Display, Segoe UI, sans-serif"
                                   Foreground="#FFFFFF"
                                   HorizontalAlignment="Center"
                                   Margin="0,4,0,0" />
                    </StackPanel>
                </UniformGrid>
            </Grid>

            <!-- ======================================================= -->
            <!-- 3. BANNER 8x2 LAYOUT                                   -->
            <!-- ======================================================= -->
            <Grid Visibility="{Binding IsBanner, Converter={StaticResource BoolToVis}}"
                  Margin="30,14,30,14"
                  VerticalAlignment="Center">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>

                <!-- Left: Details (Labels crisp & muted, Values 15px Bold pure white) -->
                <StackPanel Grid.Column="0" VerticalAlignment="Center" HorizontalAlignment="Left">
                    <TextBlock FontFamily="Segoe UI Variable Text, Segoe UI, sans-serif">
                        <Run Text="AQI&#x20;" FontSize="12.5" FontWeight="Normal" Foreground="#95A8BE" /><Run Text="{Binding AqiText}" FontSize="15" FontWeight="Bold" Foreground="#FFFFFF" />
                    </TextBlock>
                    <TextBlock FontFamily="Segoe UI Variable Text, Segoe UI, sans-serif"
                               Margin="0,6,0,0">
                        <Run Text="Feels like&#x20;" FontSize="12.5" FontWeight="Normal" Foreground="#95A8BE" /><Run Text="{Binding FeelsLikeShortText}" FontSize="15" FontWeight="Bold" Foreground="#FFFFFF" />
                    </TextBlock>
                    <TextBlock FontFamily="Segoe UI Variable Text, Segoe UI, sans-serif"
                               Margin="0,6,0,0">
                        <Run Text="Humidity&#x20;" FontSize="12.5" FontWeight="Normal" Foreground="#95A8BE" /><Run Text="{Binding HumidityText}" FontSize="15" FontWeight="Bold" Foreground="#FFFFFF" />
                    </TextBlock>
                </StackPanel>

                <!-- Center: Standardized Optical Weather Icon -->
                <Image Grid.Column="1"
                       Source="{Binding WeatherIconSource}"
                       Height="66" Width="66"
                       RenderOptions.BitmapScalingMode="HighQuality"
                       SnapsToDevicePixels="True"
                       HorizontalAlignment="Center"
                       VerticalAlignment="Center"
                       RenderTransformOrigin="0.5,0.5">
                    <Image.RenderTransform>
                        <ScaleTransform ScaleX="1.5" ScaleY="1.5" />
                    </Image.RenderTransform>
                    <Image.Effect>
                        <DropShadowEffect BlurRadius="16" Direction="270" ShadowDepth="2" Opacity="0.20" Color="#080E1A" />
                    </Image.Effect>
                </Image>

                <!-- Right: Standardized Temperature (Ultra-soft ambient floating elevation) -->
                <TextBlock Grid.Column="2"
                           Text="{Binding TemperatureText}"
                           FontSize="72"
                           FontWeight="Bold"
                           FontFamily="Segoe UI Variable Display, Segoe UI, sans-serif"
                           Foreground="#FFFFFF"
                           HorizontalAlignment="Right"
                           VerticalAlignment="Center"
                           Margin="0,-4,0,0">
                    <TextBlock.Effect>
                        <DropShadowEffect BlurRadius="26" Direction="270" ShadowDepth="4" Opacity="0.22" Color="#080E1A" />
                    </TextBlock.Effect>
                </TextBlock>
            </Grid>


            <!-- Loading Spinner Indicator -->
            <ProgressBar IsIndeterminate="{Binding IsLoading}"
                         Height="2"
                         VerticalAlignment="Top"
                         Visibility="{Binding IsLoading, Converter={StaticResource BoolToVis}}"
                         Foreground="#60CDFF"
                         Background="Transparent"
                         BorderThickness="0" />
        </Grid>
    </widgets:WidgetCard>
</UserControl>
