<UserControl x:Class="MetroHub.Widgets.Catalog.Weather.WeatherWidgetView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:widgets="clr-namespace:MetroHub.Widgets"
             xmlns:weather="clr-namespace:MetroHub.Widgets.Catalog.Weather"
             mc:Ignorable="d" 
             d:DataContext="{d:DesignInstance Type=weather:WeatherWidgetViewModel}"
             Focusable="False"
             SnapsToDevicePixels="True"
             UseLayoutRounding="True"
             TextOptions.TextFormattingMode="Ideal"
             TextOptions.TextRenderingMode="ClearType"
             TextOptions.TextHintingMode="Fixed"
             RenderOptions.ClearTypeHint="Enabled">

    <UserControl.Resources>
        <BooleanToVisibilityConverter x:Key="BoolToVis" />

        <!-- Media-Consistent 32x28 Transparent Button Style -->
        <Style x:Key="WeatherTransportButtonStyle" TargetType="Button">
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="Foreground" Value="#E0FFFFFF" />
            <Setter Property="Width" Value="32" />
            <Setter Property="Height" Value="28" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Focusable" Value="False" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Border"
                                Background="{TemplateBinding Background}"
                                CornerRadius="2"
                                SnapsToDevicePixels="True">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Border" Property="Background" Value="#25FFFFFF" />
                                <Setter Property="Foreground" Value="#FFFFFF" />
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="Border" Property="Background" Value="#40FFFFFF" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </UserControl.Resources>

    <widgets:WidgetCard Padding="0">
        <Grid SnapsToDevicePixels="True" UseLayoutRounding="True">
            <!-- Ambient Weather Condition Glow Layer -->
            <Rectangle Fill="{Binding AmbientGlowBrush}"
                       IsHitTestVisible="False"
                       Opacity="0.85" />

            <!-- ======================================================= -->
            <!-- 1. COMPACT 2x2 LAYOUT                                   -->
            <!-- ======================================================= -->
            <Grid Visibility="{Binding IsCompact, Converter={StaticResource BoolToVis}}"
                  Margin="20,16,20,16">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>

                <!-- Top: City & Unit Toggle -->
                <Grid Grid.Row="0">
                    <TextBlock Text="{Binding CityName}"
                               FontSize="13"
                               FontWeight="SemiBold"
                               FontFamily="Segoe UI Variable Text, Segoe UI, sans-serif"
                               Foreground="#E0FFFFFF"
                               TextTrimming="CharacterEllipsis"
                               VerticalAlignment="Center"
                               Margin="0,0,32,0" />

                    <Button HorizontalAlignment="Right"
                            Command="{Binding ToggleUnitsCommand}"
                            Style="{StaticResource WeatherTransportButtonStyle}"
                            Width="26" Height="22" Margin="0"
                            ToolTip="Toggle °C / °F">
                        <TextBlock Text="{Binding IsFahrenheit, Converter={x:Null}, FallbackValue='°C'}"
                                   FontSize="11"
                                   FontWeight="SemiBold"
                                   Foreground="#A0FFFFFF" />
                    </Button>
                </Grid>

                <!-- Center: Weather Glyph & Hero Temp -->
                <StackPanel Grid.Row="1" VerticalAlignment="Center" HorizontalAlignment="Center" Margin="0,4">
                    <TextBlock Text="{Binding WeatherGlyph}"
                               FontFamily="Segoe Fluent Icons, Segoe MDL2 Assets"
                               FontSize="34"
                               Foreground="#FFFFFF"
                               HorizontalAlignment="Center"
                               Margin="0,0,0,2" />
                    <TextBlock Text="{Binding TemperatureText}"
                               FontSize="32"
                               FontWeight="Light"
                               FontFamily="Segoe UI Variable Display, Segoe UI, sans-serif"
                               Foreground="#FFFFFF"
                               HorizontalAlignment="Center" />
                </StackPanel>

                <!-- Bottom: AQI Status Badge -->
                <Border Grid.Row="2"
                        Background="#20FFFFFF"
                        BorderBrush="{Binding AqiBrush}"
                        BorderThickness="1"
                        CornerRadius="10"
                        Padding="8,2"
                        HorizontalAlignment="Center"
                        VerticalAlignment="Center">
                    <TextBlock Text="{Binding AqiCategoryText}"
                               FontSize="10.5"
                               FontWeight="SemiBold"
                               FontFamily="Segoe UI Variable Text, Segoe UI, sans-serif"
                               Foreground="{Binding AqiBrush}" />
                </Border>
            </Grid>

            <!-- ======================================================= -->
            <!-- 2. WIDE 4x2 & BANNER 8x2 LAYOUT (Default & Standard)    -->
            <!-- ======================================================= -->
            <Grid Visibility="{Binding IsWide, Converter={StaticResource BoolToVis}}">
                <Grid.RowDefinitions>
                    <RowDefinition Height="*" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="46" />
                </Grid.RowDefinitions>

                <!-- Row 0: Hero Weather Bar (Universal 20px Clearance) -->
                <Grid Grid.Row="0" Margin="20,12,20,4">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>

                    <!-- Left Column: City, Condition, High/Low, Refresh -->
                    <StackPanel Grid.Column="0" VerticalAlignment="Center">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="{Binding CityName}"
                                       FontSize="14"
                                       FontWeight="SemiBold"
                                       FontFamily="Segoe UI Variable Text, Segoe UI, sans-serif"
                                       Foreground="#FFFFFF"
                                       TextTrimming="CharacterEllipsis"
                                       MaxWidth="150"
                                       VerticalAlignment="Center" />

                            <Button Command="{Binding RefreshCommand}"
                                    Style="{StaticResource WeatherTransportButtonStyle}"
                                    Width="24" Height="22" Margin="6,0,0,0"
                                    ToolTip="Refresh Weather &amp; AQI">
                                <TextBlock Text="&#xE72C;"
                                           FontFamily="Segoe Fluent Icons, Segoe MDL2 Assets"
                                           FontSize="11"
                                           Foreground="#A0FFFFFF" />
                            </Button>
                        </StackPanel>

                        <TextBlock Text="{Binding ConditionText}"
                                   FontSize="12"
                                   FontFamily="Segoe UI Variable Text, Segoe UI, sans-serif"
                                   Foreground="#C0FFFFFF"
                                   Margin="0,1,0,0" />

                        <TextBlock Text="{Binding HighLowText}"
                                   FontSize="11.5"
                                   FontFamily="Segoe UI Variable Text, Segoe UI, sans-serif"
                                   Foreground="#80FFFFFF"
                                   Margin="0,2,0,0" />
                    </StackPanel>

                    <!-- Right Column: Hero Temp & Glyph & AQI Badge -->
                    <StackPanel Grid.Column="1" VerticalAlignment="Center" HorizontalAlignment="Right">
                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                            <TextBlock Text="{Binding WeatherGlyph}"
                                       FontFamily="Segoe Fluent Icons, Segoe MDL2 Assets"
                                       FontSize="28"
                                       Foreground="#FFFFFF"
                                       VerticalAlignment="Center"
                                       Margin="0,0,10,0" />

                            <TextBlock Text="{Binding TemperatureText}"
                                       FontSize="36"
                                       FontWeight="Light"
                                       FontFamily="Segoe UI Variable Display, Segoe UI, sans-serif"
                                       Foreground="#FFFFFF"
                                       VerticalAlignment="Center" />
                        </StackPanel>

                        <Border Background="#20000000"
                                BorderBrush="{Binding AqiBrush}"
                                BorderThickness="1"
                                CornerRadius="8"
                                Padding="6,1.5"
                                HorizontalAlignment="Right"
                                Margin="0,3,0,0">
                            <TextBlock Text="{Binding AqiCategoryText}"
                                       FontSize="10"
                                       FontWeight="SemiBold"
                                       FontFamily="Segoe UI Variable Text, Segoe UI, sans-serif"
                                       Foreground="{Binding AqiBrush}" />
                        </Border>
                    </StackPanel>
                </Grid>

                <!-- Universal Fluent Edge-to-Edge Hairline Divider -->
                <Grid Grid.Row="1"
                      VerticalAlignment="Top"
                      Height="14"
                      Margin="0,-7,0,0"
                      Background="Transparent">
                    <Border Height="1"
                            VerticalAlignment="Center"
                            Background="#15FFFFFF"
                            SnapsToDevicePixels="True" />
                </Grid>

                <!-- Row 2: Docked 5-Hour Forecast Strip (20px Margin) -->
                <ItemsControl Grid.Row="2"
                              ItemsSource="{Binding HourlyForecast}"
                              Margin="16,0,16,6"
                              VerticalAlignment="Center">
                    <ItemsControl.ItemsPanel>
                        <ItemsPanelTemplate>
                            <UniformGrid Rows="1" />
                        </ItemsPanelTemplate>
                    </ItemsControl.ItemsPanel>
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center">
                                <TextBlock Text="{Binding TimeString}"
                                           FontSize="10"
                                           FontFamily="Segoe UI Variable Text, Segoe UI, sans-serif"
                                           Foreground="#80FFFFFF"
                                           HorizontalAlignment="Center" />
                                <TextBlock Text="{Binding Glyph}"
                                           FontFamily="Segoe Fluent Icons, Segoe MDL2 Assets"
                                           FontSize="13"
                                           Foreground="#FFFFFF"
                                           HorizontalAlignment="Center"
                                           Margin="0,2" />
                                <TextBlock Text="{Binding TemperatureText}"
                                           FontSize="11"
                                           FontWeight="SemiBold"
                                           FontFamily="Segoe UI Variable Text, Segoe UI, sans-serif"
                                           Foreground="#E0FFFFFF"
                                           HorizontalAlignment="Center" />
                            </StackPanel>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </Grid>

            <!-- ======================================================= -->
            <!-- 3. BANNER 8x2 / EXTRA WIDE 6x2 LAYOUT                   -->
            <!-- ======================================================= -->
            <Grid Visibility="{Binding IsBanner, Converter={StaticResource BoolToVis}}">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="220" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>

                <!-- Left Hero Segment -->
                <Grid Grid.Column="0" Margin="20,12,12,12">
                    <StackPanel VerticalAlignment="Center">
                        <TextBlock Text="{Binding CityName}"
                                   FontSize="15"
                                   FontWeight="SemiBold"
                                   FontFamily="Segoe UI Variable Text, Segoe UI, sans-serif"
                                   Foreground="#FFFFFF"
                                   TextTrimming="CharacterEllipsis" />
                        <TextBlock Text="{Binding ConditionText}"
                                   FontSize="12"
                                   Foreground="#B0FFFFFF"
                                   Margin="0,1,0,0" />
                        <TextBlock Text="{Binding HighLowText}"
                                   FontSize="11"
                                   Foreground="#70FFFFFF"
                                   Margin="0,2,0,0" />
                        <Border Background="#20000000"
                                BorderBrush="{Binding AqiBrush}"
                                BorderThickness="1"
                                CornerRadius="8"
                                Padding="6,1.5"
                                HorizontalAlignment="Left"
                                Margin="0,4,0,0">
                            <TextBlock Text="{Binding AqiCategoryText}"
                                       FontSize="10"
                                       FontWeight="SemiBold"
                                       Foreground="{Binding AqiBrush}" />
                        </Border>
                    </StackPanel>
                </Grid>

                <!-- Vertical Hairline Divider -->
                <Border Grid.Column="1" Width="1" Background="#15FFFFFF" Margin="0,12" />

                <!-- Extended Hourly Strip -->
                <Grid Grid.Column="2" Margin="12,12,20,12">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                    </Grid.RowDefinitions>

                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,0,0,4">
                        <TextBlock Text="{Binding WeatherGlyph}"
                                   FontFamily="Segoe Fluent Icons, Segoe MDL2 Assets"
                                   FontSize="22"
                                   Foreground="#FFFFFF"
                                   VerticalAlignment="Center"
                                   Margin="0,0,8,0" />
                        <TextBlock Text="{Binding TemperatureText}"
                                   FontSize="26"
                                   FontWeight="Light"
                                   Foreground="#FFFFFF"
                                   VerticalAlignment="Center" />
                        <Button Command="{Binding ToggleUnitsCommand}"
                                Style="{StaticResource WeatherTransportButtonStyle}"
                                Width="26" Height="22" Margin="8,0,0,0"
                                ToolTip="Toggle °C / °F">
                            <TextBlock Text="{Binding IsFahrenheit, Converter={x:Null}, FallbackValue='°C'}"
                                       FontSize="11"
                                       Foreground="#80FFFFFF" />
                        </Button>
                    </StackPanel>

                    <ItemsControl Grid.Row="1"
                                  ItemsSource="{Binding HourlyForecast}"
                                  VerticalAlignment="Center">
                        <ItemsControl.ItemsPanel>
                            <ItemsPanelTemplate>
                                <UniformGrid Rows="1" />
                            </ItemsPanelTemplate>
                        </ItemsControl.ItemsPanel>
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center">
                                    <TextBlock Text="{Binding TimeString}" FontSize="9.5" Foreground="#70FFFFFF" HorizontalAlignment="Center" />
                                    <TextBlock Text="{Binding Glyph}" FontFamily="Segoe Fluent Icons, Segoe MDL2 Assets" FontSize="13" Foreground="#FFFFFF" HorizontalAlignment="Center" Margin="0,2" />
                                    <TextBlock Text="{Binding TemperatureText}" FontSize="11" FontWeight="SemiBold" Foreground="#E0FFFFFF" HorizontalAlignment="Center" />
                                </StackPanel>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </Grid>
            </Grid>

            <!-- ======================================================= -->
            <!-- 4. HERO / LARGE 4x4 & 8x3 COMPREHENSIVE LAYOUT          -->
            <!-- ======================================================= -->
            <Grid Visibility="{Binding IsHero, Converter={StaticResource BoolToVis}}" Margin="20,16,20,16">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>

                <!-- Top Header: City & Large Current Temp -->
                <Grid Grid.Row="0">
                    <StackPanel>
                        <TextBlock Text="{Binding CityName}" FontSize="18" FontWeight="SemiBold" Foreground="#FFFFFF" />
                        <TextBlock Text="{Binding ConditionText}" FontSize="13" Foreground="#B0FFFFFF" Margin="0,2,0,0" />
                        <TextBlock Text="{Binding HighLowText}" FontSize="12" Foreground="#80FFFFFF" Margin="0,2,0,0" />
                    </StackPanel>

                    <StackPanel HorizontalAlignment="Right" VerticalAlignment="Top" Orientation="Horizontal">
                        <TextBlock Text="{Binding WeatherGlyph}" FontFamily="Segoe Fluent Icons, Segoe MDL2 Assets" FontSize="36" Foreground="#FFFFFF" VerticalAlignment="Center" Margin="0,0,12,0" />
                        <TextBlock Text="{Binding TemperatureText}" FontSize="44" FontWeight="Light" Foreground="#FFFFFF" VerticalAlignment="Center" />
                    </StackPanel>
                </Grid>

                <!-- AQI & Pollutant Breakdown Bar -->
                <Border Grid.Row="1" Background="#15FFFFFF" CornerRadius="8" Padding="12,8" Margin="0,12,0,10">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>

                        <Border Grid.Column="0" Background="#20000000" BorderBrush="{Binding AqiBrush}" BorderThickness="1" CornerRadius="6" Padding="6,2" VerticalAlignment="Center">
                            <TextBlock Text="{Binding AqiCategoryText}" FontSize="11" FontWeight="SemiBold" Foreground="{Binding AqiBrush}" />
                        </Border>

                        <StackPanel Grid.Column="2" Orientation="Horizontal" Margin="12,0" VerticalAlignment="Center">
                            <TextBlock Text="PM2.5: " FontSize="11" Foreground="#70FFFFFF" />
                            <TextBlock Text="{Binding Pm25Text}" FontSize="11" FontWeight="SemiBold" Foreground="#FFFFFF" />
                        </StackPanel>

                        <StackPanel Grid.Column="3" Orientation="Horizontal" Margin="12,0" VerticalAlignment="Center">
                            <TextBlock Text="PM10: " FontSize="11" Foreground="#70FFFFFF" />
                            <TextBlock Text="{Binding Pm10Text}" FontSize="11" FontWeight="SemiBold" Foreground="#FFFFFF" />
                        </StackPanel>

                        <StackPanel Grid.Column="4" Orientation="Horizontal" Margin="12,0" VerticalAlignment="Center">
                            <TextBlock Text="O₃: " FontSize="11" Foreground="#70FFFFFF" />
                            <TextBlock Text="{Binding OzoneText}" FontSize="11" FontWeight="SemiBold" Foreground="#FFFFFF" />
                        </StackPanel>
                    </Grid>
                </Border>

                <!-- Middle: 5-Day Daily Forecast -->
                <ItemsControl Grid.Row="2" ItemsSource="{Binding DailyForecast}" Margin="0,4,0,8">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <Grid Margin="0,3">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="50" />
                                    <ColumnDefinition Width="36" />
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <TextBlock Grid.Column="0" Text="{Binding DayString}" FontSize="12.5" FontWeight="SemiBold" Foreground="#D0FFFFFF" VerticalAlignment="Center" />
                                <TextBlock Grid.Column="1" Text="{Binding Glyph}" FontFamily="Segoe Fluent Icons, Segoe MDL2 Assets" FontSize="14" Foreground="#FFFFFF" VerticalAlignment="Center" HorizontalAlignment="Center" />
                                <TextBlock Grid.Column="3" Text="{Binding HighLowText}" FontSize="12" Foreground="#B0FFFFFF" VerticalAlignment="Center" />
                            </Grid>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>

                <!-- Bottom: Hourly Forecast Horizontal Strip -->
                <ItemsControl Grid.Row="3" ItemsSource="{Binding HourlyForecast}" Margin="0,4,0,0">
                    <ItemsControl.ItemsPanel>
                        <ItemsPanelTemplate>
                            <UniformGrid Rows="1" />
                        </ItemsPanelTemplate>
                    </ItemsControl.ItemsPanel>
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <StackPanel HorizontalAlignment="Center">
                                <TextBlock Text="{Binding TimeString}" FontSize="10" Foreground="#70FFFFFF" HorizontalAlignment="Center" />
                                <TextBlock Text="{Binding Glyph}" FontFamily="Segoe Fluent Icons, Segoe MDL2 Assets" FontSize="13" Foreground="#FFFFFF" HorizontalAlignment="Center" Margin="0,2" />
                                <TextBlock Text="{Binding TemperatureText}" FontSize="11" FontWeight="SemiBold" Foreground="#E0FFFFFF" HorizontalAlignment="Center" />
                            </StackPanel>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </Grid>

            <!-- Loading Spinner Indicator -->
            <ProgressBar IsIndeterminate="{Binding IsLoading}"
                         Height="2"
                         VerticalAlignment="Top"
                         Visibility="{Binding IsLoading, Converter={StaticResource BoolToVis}}"
                         Foreground="#60CDFF"
                         Background="Transparent"
                         BorderThickness="0" />
        </Grid>
    </widgets:WidgetCard>
</UserControl>
