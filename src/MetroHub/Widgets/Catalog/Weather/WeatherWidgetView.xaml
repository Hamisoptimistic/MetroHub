<UserControl x:Class="MetroHub.Widgets.Catalog.Weather.WeatherWidgetView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:po="http://schemas.microsoft.com/winfx/2006/xaml/presentation/options"
             xmlns:widgets="clr-namespace:MetroHub.Widgets"
             xmlns:weather="clr-namespace:MetroHub.Widgets.Catalog.Weather"
             mc:Ignorable="d po" 
             d:DataContext="{d:DesignInstance Type=weather:WeatherWidgetViewModel}"
             Focusable="False"
             FontFamily="{DynamicResource AppFontFamily}">

    <UserControl.Resources>
        <!-- 100% GPU-drawn frozen OpacityMask for Horizon Aura spread (0 CPU / 0 allocations).
             Bright opaque baseline hugging the edge, fast falloff: the neon heat-map bleed. -->
        <LinearGradientBrush x:Key="HorizonAuraMaskBrush" StartPoint="0,1" EndPoint="0,0" po:Freeze="True">
            <GradientStop Color="#FF000000" Offset="0.0" />
            <GradientStop Color="#90000000" Offset="0.15" />
            <GradientStop Color="#28000000" Offset="0.32" />
            <GradientStop Color="#00000000" Offset="0.48" />
        </LinearGradientBrush>

        <!-- 100% GPU-drawn frozen Glass Top Sheen -->
        <LinearGradientBrush x:Key="WeatherGlassSheenBrush" StartPoint="0,0" EndPoint="0,1" po:Freeze="True">
            <GradientStop Color="#15FFFFFF" Offset="0.0" />
            <GradientStop Color="#04FFFFFF" Offset="0.30" />
            <GradientStop Color="#00000000" Offset="0.65" />
        </LinearGradientBrush>

        <!-- 100% GPU-drawn frozen Glass Rim Light -->
        <LinearGradientBrush x:Key="WeatherGlassRimBrush" StartPoint="0,0" EndPoint="1,0" po:Freeze="True">
            <GradientStop Color="#00FFFFFF" Offset="0.0" />
            <GradientStop Color="#30FFFFFF" Offset="0.5" />
            <GradientStop Color="#00FFFFFF" Offset="1.0" />
        </LinearGradientBrush>
    </UserControl.Resources>

    <widgets:WidgetCard Padding="0">
        <Grid>
            <!-- 1. Atmospheric Ambient Condition Aura (Dynamic, 100% GPU-drawn frozen brush, 0 CPU/RAM) -->
            <Border Background="{Binding AmbientGlowBrush}"
                    CornerRadius="{DynamicResource TileCornerRadius}"
                    IsHitTestVisible="False" />

            <!-- 2. Atmospheric Horizon Aura (Expansive Horizon Aura, 100% Direct3D GPU-drawn, 0 CPU/RAM) -->
            <Border Background="{Binding HorizonAuraBrush}"
                    OpacityMask="{StaticResource HorizonAuraMaskBrush}"
                    CornerRadius="{DynamicResource TileCornerRadius}"
                    IsHitTestVisible="False" />

            <!-- 2b. Hot edge core: 3px neon baseline feeding the bloom (same frozen brush, unmasked) -->
            <Border Background="{Binding HorizonAuraBrush}"
                    Height="3"
                    VerticalAlignment="Bottom"
                    CornerRadius="0,0,2,2"
                    IsHitTestVisible="False" />

            <!-- 3. Glass Top Specular Sheen (Subtle light catch across upper half) -->
            <Border Background="{StaticResource WeatherGlassSheenBrush}"
                    CornerRadius="{DynamicResource TileCornerRadius}"
                    IsHitTestVisible="False" />

            <!-- 4. Glass Top Rim Light (1px specular edge along top border) -->
            <Border BorderBrush="{StaticResource WeatherGlassRimBrush}"
                    CornerRadius="{DynamicResource TileCornerRadius}"
                    BorderThickness="0,1,0,0"
                    IsHitTestVisible="False" />

            <!-- ======================================================= -->
            <!-- 1. WIDE 4x2 LAYOUT (Ultra-Clean Icon + Temperature)      -->
            <!-- ======================================================= -->
            <Viewbox Visibility="{Binding IsWide, Converter={StaticResource BoolToVis}}"
                     Margin="16,12,16,12"
                     Stretch="Uniform"
                     HorizontalAlignment="Center"
                     VerticalAlignment="Center">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="16" /> <!-- Spacing -->
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>

                    <!-- Left: Standardized Optical Weather Icon -->
                    <Image Grid.Column="0"
                           Source="{Binding WeatherIconSource, TargetNullValue={x:Null}, FallbackValue={x:Null}}"
                           Height="110" Width="110"
                           RenderOptions.BitmapScalingMode="HighQuality"
                           VerticalAlignment="Center">
                        <Image.Effect>
                            <StaticResource ResourceKey="ShadowCard" />
                        </Image.Effect>
                    </Image>

                    <!-- Right: Standardized Temperature (Matched height) -->
                    <TextBlock Grid.Column="2"
                               Text="{Binding TemperatureText}"
                               FontSize="{DynamicResource TypeHeroCoordinateFontSize}"
                               FontWeight="{DynamicResource TypeHeroFontWeight}"
                               FontFamily="{DynamicResource AppDisplayFontFamily}"
                               Foreground="{DynamicResource TextPrimaryBrush}"
                               VerticalAlignment="Center"
                               Margin="0,-4,0,0">
                        <TextBlock.Effect>
                            <StaticResource ResourceKey="StudioGlassTextShadow" />
                        </TextBlock.Effect>
                    </TextBlock>
                </Grid>
            </Viewbox>

            <!-- ======================================================= -->
            <!-- 2. LARGE 4x4 LAYOUT (Image 1 Modern Claymorphic Card)   -->
            <!-- ======================================================= -->
            <Grid Visibility="{Binding IsSquareLarge, Converter={StaticResource BoolToVis}}"
                  Margin="22,20,22,18">
                <Grid.RowDefinitions>
                    <RowDefinition Height="*" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>

                <!-- Top Row: Large Hero Icon (Left) + Large Temp & Condition (Right) -->
                <Grid Grid.Row="0" VerticalAlignment="Center">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>

                    <!-- Left: Large Weather Icon -->
                    <Image Grid.Column="0"
                           Source="{Binding WeatherIconSource, TargetNullValue={x:Null}, FallbackValue={x:Null}}"
                           Width="92" Height="92"
                           RenderOptions.BitmapScalingMode="HighQuality"
                           HorizontalAlignment="Left"
                           VerticalAlignment="Center">
                        <Image.Effect>
                            <StaticResource ResourceKey="ShadowCard" />
                        </Image.Effect>
                    </Image>

                    <!-- Right: Large Temperature & Condition -->
                    <StackPanel Grid.Column="1"
                                VerticalAlignment="Center"
                                HorizontalAlignment="Right">
                        <TextBlock Text="{Binding TemperatureText}"
                                   FontSize="{DynamicResource TypeHeroFontSize}"
                                   FontWeight="{DynamicResource TypeHeroFontWeight}"
                                   FontFamily="{DynamicResource AppDisplayFontFamily}"
                                   Foreground="{DynamicResource TextPrimaryBrush}"
                                   HorizontalAlignment="Right">
                            <TextBlock.Effect>
                                <StaticResource ResourceKey="StudioGlassTextShadow" />
                            </TextBlock.Effect>
                        </TextBlock>
                        <TextBlock Text="{Binding ConditionText}"
                                   FontSize="{DynamicResource TypeHeaderFontSize}"
                                   FontWeight="{DynamicResource TypeHeaderFontWeight}"
                                   FontFamily="{DynamicResource AppFontFamily}"
                                   Foreground="{DynamicResource TextSecondaryBrush}"
                                   HorizontalAlignment="Right"
                                   Margin="0,2,0,0" />
                    </StackPanel>
                </Grid>

                <!-- Bottom Row: 3 Neat Metric Columns (AQI, Humidity, Precip) - Razor-sharp text, zero shadow blur -->
                <UniformGrid Grid.Row="1" Columns="3" VerticalAlignment="Center" Margin="0,16,0,6">
                    <!-- Column 1: AQI -->
                    <StackPanel HorizontalAlignment="Center">
                        <TextBlock Text="AQI"
                                   FontSize="{DynamicResource TypeCaptionFontSize}"
                                   FontWeight="{DynamicResource TypeCaptionFontWeight}"
                                   FontFamily="{DynamicResource AppFontFamily}"
                                   Foreground="{DynamicResource TextMutedBrush}"
                                   HorizontalAlignment="Center" />
                        <TextBlock Text="{Binding AqiText}"
                                   FontSize="{DynamicResource TypeBodyStrongFontSize}"
                                   FontWeight="{DynamicResource TypeBodyStrongFontWeight}"
                                   FontFamily="{DynamicResource AppDisplayFontFamily}"
                                   Foreground="{DynamicResource TextPrimaryBrush}"
                                   HorizontalAlignment="Center"
                                   Margin="0,4,0,0" />
                    </StackPanel>

                    <!-- Column 2: Humidity -->
                    <StackPanel HorizontalAlignment="Center">
                        <TextBlock Text="Humidity"
                                   FontSize="{DynamicResource TypeCaptionFontSize}"
                                   FontWeight="{DynamicResource TypeCaptionFontWeight}"
                                   FontFamily="{DynamicResource AppFontFamily}"
                                   Foreground="{DynamicResource TextMutedBrush}"
                                   HorizontalAlignment="Center" />
                        <TextBlock Text="{Binding HumidityText}"
                                   FontSize="{DynamicResource TypeBodyStrongFontSize}"
                                   FontWeight="{DynamicResource TypeBodyStrongFontWeight}"
                                   FontFamily="{DynamicResource AppDisplayFontFamily}"
                                   Foreground="{DynamicResource TextPrimaryBrush}"
                                   HorizontalAlignment="Center"
                                   Margin="0,4,0,0" />
                    </StackPanel>

                    <!-- Column 3: Precipitation -->
                    <StackPanel HorizontalAlignment="Center">
                        <TextBlock Text="Precip"
                                   FontSize="{DynamicResource TypeCaptionFontSize}"
                                   FontWeight="{DynamicResource TypeCaptionFontWeight}"
                                   FontFamily="{DynamicResource AppFontFamily}"
                                   Foreground="{DynamicResource TextMutedBrush}"
                                   HorizontalAlignment="Center" />
                        <TextBlock Text="{Binding PrecipitationProbabilityText}"
                                   FontSize="{DynamicResource TypeBodyStrongFontSize}"
                                   FontWeight="{DynamicResource TypeBodyStrongFontWeight}"
                                   FontFamily="{DynamicResource AppDisplayFontFamily}"
                                   Foreground="{DynamicResource TextPrimaryBrush}"
                                   HorizontalAlignment="Center"
                                   Margin="0,4,0,0" />
                    </StackPanel>
                </UniformGrid>
            </Grid>

            <!-- ======================================================= -->
            <!-- 3. BANNER 8x2 LAYOUT                                   -->
            <!-- ======================================================= -->
            <Grid Visibility="{Binding IsBanner, Converter={StaticResource BoolToVis}}"
                  Margin="30,14,30,14"
                  VerticalAlignment="Center">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>

                <!-- Left: Details (Labels crisp & muted, Values Bold pure white) -->
                <StackPanel Grid.Column="0" VerticalAlignment="Center" HorizontalAlignment="Left">
                    <TextBlock FontFamily="{DynamicResource AppFontFamily}">
                        <Run Text="AQI&#x20;" FontSize="{DynamicResource TypeCaptionFontSize}" FontWeight="{DynamicResource TypeCaptionFontWeight}" Foreground="{DynamicResource TextMutedBrush}" /><Run Text="{Binding AqiText}" FontSize="{DynamicResource TypeBodyStrongFontSize}" FontWeight="{DynamicResource TypeBodyStrongFontWeight}" Foreground="{DynamicResource TextPrimaryBrush}" />
                    </TextBlock>
                    <TextBlock FontFamily="{DynamicResource AppFontFamily}"
                               Margin="0,6,0,0">
                        <Run Text="Feels like&#x20;" FontSize="{DynamicResource TypeCaptionFontSize}" FontWeight="{DynamicResource TypeCaptionFontWeight}" Foreground="{DynamicResource TextMutedBrush}" /><Run Text="{Binding FeelsLikeShortText}" FontSize="{DynamicResource TypeBodyStrongFontSize}" FontWeight="{DynamicResource TypeBodyStrongFontWeight}" Foreground="{DynamicResource TextPrimaryBrush}" />
                    </TextBlock>
                    <TextBlock FontFamily="{DynamicResource AppFontFamily}"
                               Margin="0,6,0,0">
                        <Run Text="Humidity&#x20;" FontSize="{DynamicResource TypeCaptionFontSize}" FontWeight="{DynamicResource TypeCaptionFontWeight}" Foreground="{DynamicResource TextMutedBrush}" /><Run Text="{Binding HumidityText}" FontSize="{DynamicResource TypeBodyStrongFontSize}" FontWeight="{DynamicResource TypeBodyStrongFontWeight}" Foreground="{DynamicResource TextPrimaryBrush}" />
                    </TextBlock>
                </StackPanel>

                <!-- Center: Standardized Optical Weather Icon -->
                <Image Grid.Column="1"
                       Source="{Binding WeatherIconSource, TargetNullValue={x:Null}, FallbackValue={x:Null}}"
                       Height="88" Width="88"
                       RenderOptions.BitmapScalingMode="HighQuality"
                       HorizontalAlignment="Center"
                       VerticalAlignment="Center">
                    <Image.Effect>
                        <StaticResource ResourceKey="ShadowCard" />
                    </Image.Effect>
                </Image>

                <!-- Right: Standardized Temperature (Ultra-soft ambient floating elevation) -->
                <TextBlock Grid.Column="2"
                           Text="{Binding TemperatureText}"
                           FontSize="{DynamicResource TypeHeroFontSize}"
                           FontWeight="{DynamicResource TypeHeroFontWeight}"
                           FontFamily="{DynamicResource AppDisplayFontFamily}"
                           Foreground="{DynamicResource TextPrimaryBrush}"
                           HorizontalAlignment="Right"
                           VerticalAlignment="Center"
                           Margin="0,-4,0,0">
                    <TextBlock.Effect>
                        <StaticResource ResourceKey="StudioGlassTextShadow" />
                    </TextBlock.Effect>
                </TextBlock>
            </Grid>


            <!-- Loading Spinner Indicator -->
            <ProgressBar IsIndeterminate="{Binding IsLoading}"
                         Height="2"
                         VerticalAlignment="Top"
                         Visibility="{Binding IsLoading, Converter={StaticResource BoolToVis}}"
                         Foreground="{DynamicResource StatusInfoBrush}"
                         Background="Transparent"
                         BorderThickness="0" />
        </Grid>
    </widgets:WidgetCard>
</UserControl>
