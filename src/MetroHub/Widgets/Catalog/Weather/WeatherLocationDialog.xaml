<dialogs:MetroDialog x:Class="MetroHub.Presentation.Controls.WeatherLocationDialog"
                     xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                     xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                     xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
                     xmlns:controls="clr-namespace:MetroHub.Presentation.Controls"
                     xmlns:dialogs="clr-namespace:MetroHub.Presentation.Dialogs"
                     Title="Change Location">

    <dialogs:MetroDialog.SidebarContent>
        <Image Source="/Assets/Weather/Glassmorphic/cloudy-and-rainny.png"
               Width="72"
               Height="72"
               Stretch="Uniform"
               HorizontalAlignment="Center"
               VerticalAlignment="Center"
               RenderOptions.BitmapScalingMode="HighQuality" />
    </dialogs:MetroDialog.SidebarContent>

    <Window.Resources>
        <Style x:Key="SubtleActionButtonStyle" TargetType="Button">
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="FocusVisualStyle" Value="{x:Null}" />
            <Setter Property="Padding" Value="0" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border Background="{TemplateBinding Background}">
                            <ContentPresenter HorizontalAlignment="Left" VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter Property="Opacity" Value="1.0" />
                            </Trigger>
                            <Trigger Property="IsMouseOver" Value="False">
                                <Setter Property="Opacity" Value="0.75" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="SuggestionListBoxItemStyle" TargetType="ListBoxItem">
            <Setter Property="OverridesDefaultStyle" Value="True" />
            <Setter Property="FocusVisualStyle" Value="{x:Null}" />
            <Setter Property="Padding" Value="10,6,10,6" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ListBoxItem">
                        <Border x:Name="ItemBorder"
                                Background="Transparent"
                                CornerRadius="{DynamicResource ControlCornerRadius}"
                                Margin="2,1,2,1"
                                Padding="{TemplateBinding Padding}">
                            <ContentPresenter />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="ItemBorder" Property="Background" Value="#1CFFFFFF" />
                            </Trigger>
                            <Trigger Property="IsSelected" Value="True">
                                <Setter TargetName="ItemBorder" Property="Background" Value="#2AFFFFFF" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <DataTemplate x:Key="SuggestionItemTemplate">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <TextBlock Text="{Binding Name}"
                           FontSize="{DynamicResource TypeBodyFontSize}"
                           FontWeight="{DynamicResource TypeBodyStrongFontWeight}"
                           Foreground="{DynamicResource TextPrimaryBrush}"
                           VerticalAlignment="Center"
                           TextTrimming="CharacterEllipsis" />
                <TextBlock Grid.Column="1"
                           Text="{Binding DisplaySubtitle}"
                           FontSize="{DynamicResource TypeCaptionFontSize}"
                           FontWeight="{DynamicResource TypeCaptionFontWeight}"
                           Foreground="{DynamicResource TextSubtleBrush}"
                           VerticalAlignment="Center"
                           Margin="8,0,0,0"
                           TextTrimming="CharacterEllipsis" />
            </Grid>
        </DataTemplate>
    </Window.Resources>

    <!-- Dark Obsidian Form Content Slot -->
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <!-- Body Inputs -->
        <StackPanel Grid.Row="0">
            <TextBlock Text="City Name"
                       FontSize="{DynamicResource TypeCaptionFontSize}"
                       FontWeight="{DynamicResource TypeCaptionFontWeight}"
                       Foreground="{DynamicResource TextMutedBrush}"
                       Margin="0,0,0,6" />

            <Grid>
                <TextBox x:Name="WeatherCityInput"
                         Style="{DynamicResource FluentGlassSearchInputStyle}"
                         PreviewKeyDown="OnWeatherInputPreviewKeyDown"
                         TextChanged="OnWeatherInputTextChanged" />

                <Popup x:Name="WeatherSuggestionsPopup"
                       PlacementTarget="{Binding ElementName=WeatherCityInput}"
                       Placement="Bottom"
                       VerticalOffset="-1"
                       HorizontalOffset="0"
                       StaysOpen="False"
                       IsOpen="False"
                       AllowsTransparency="True"
                       PopupAnimation="Fade">
                    <Border Width="{Binding ActualWidth, ElementName=WeatherCityInput}"
                            Background="#232323"
                            BorderBrush="#40FFFFFF"
                            BorderThickness="1"
                            CornerRadius="0,0,2,2">
                        <ListBox x:Name="WeatherSuggestionsList"
                                 Background="Transparent"
                                 BorderThickness="0"
                                 Padding="0,2,0,2"
                                 ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                                 ScrollViewer.VerticalScrollBarVisibility="Auto"
                                 controls:AutoHideScrollBehavior.IsEnabled="True"
                                 MaxHeight="172"
                                 ItemContainerStyle="{StaticResource SuggestionListBoxItemStyle}"
                                 ItemTemplate="{StaticResource SuggestionItemTemplate}"
                                 PreviewMouseLeftButtonUp="OnSuggestionListMouseUp"
                                 PreviewKeyDown="OnSuggestionsListPreviewKeyDown">
                            <ListBox.Resources>
                                <Style TargetType="{x:Type ScrollBar}" BasedOn="{StaticResource WidgetFloatingScrollBarStyle}" />
                            </ListBox.Resources>
                        </ListBox>
                    </Border>
                </Popup>
            </Grid>

            <Button Margin="0,12,0,0"
                    Style="{StaticResource SubtleActionButtonStyle}"
                    Click="OnWeatherAutoLocationClick">
                <StackPanel Orientation="Horizontal">
                    <ui:SymbolIcon Symbol="MyLocation24" FontSize="13" Foreground="{DynamicResource TextMutedBrush}" Margin="0,0,6,0" VerticalAlignment="Center" />
                    <TextBlock Text="Reset to automatic location (GPS / IP)"
                               FontSize="{DynamicResource TypeCaptionFontSize}"
                               FontWeight="{DynamicResource TypeCaptionFontWeight}"
                               Foreground="{DynamicResource TextMutedBrush}"
                               VerticalAlignment="Center" />
                </StackPanel>
            </Button>

            <StackPanel Orientation="Horizontal" Margin="0,12,0,0">
                <ui:ProgressRing x:Name="WeatherActionSpinner"
                                 Width="14" Height="14"
                                 IsIndeterminate="True"
                                 Visibility="Collapsed"
                                 Margin="0,0,6,0" />
                <TextBlock x:Name="WeatherStatusMessage"
                           FontSize="{DynamicResource TypeCaptionFontSize}"
                           FontWeight="{DynamicResource TypeCaptionFontWeight}"
                           Foreground="{DynamicResource StatusErrorBrush}"
                           TextWrapping="Wrap"
                           Visibility="Collapsed" />
            </StackPanel>
        </StackPanel>

        <!-- Footer Action Buttons -->
        <Grid Grid.Row="1" Margin="0,16,0,0">
            <Button Content="Save Location"
                    Style="{DynamicResource FluentCohesivePrimaryButtonStyle}"
                    HorizontalAlignment="Right"
                    Click="OnSaveLocationClick" />
        </Grid>
    </Grid>
</dialogs:MetroDialog>
