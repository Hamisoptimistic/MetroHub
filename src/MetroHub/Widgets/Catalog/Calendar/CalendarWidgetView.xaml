<UserControl x:Class="MetroHub.Widgets.Catalog.Calendar.CalendarWidgetView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
             xmlns:widgets="clr-namespace:MetroHub.Widgets"
             xmlns:calendar="clr-namespace:MetroHub.Widgets.Catalog.Calendar"
             mc:Ignorable="d" 
             d:DataContext="{d:DesignInstance Type=calendar:CalendarWidgetViewModel}"
             Focusable="False"
             SnapsToDevicePixels="True"
             UseLayoutRounding="True"
             TextOptions.TextFormattingMode="Ideal"
             TextOptions.TextRenderingMode="ClearType"
             TextOptions.TextHintingMode="Fixed"
             RenderOptions.ClearTypeHint="Enabled">

    <UserControl.Resources>
        <!-- Windows Calendar Palette Tokens (Aligned with Habit Widget) -->
        <SolidColorBrush x:Key="MonthBlockBrush" Color="#18FFFFFF" />
        <SolidColorBrush x:Key="OutOfMonthTextBrush" Color="#40FFFFFF" />
        <SolidColorBrush x:Key="CurrentMonthTextBrush" Color="#FFFFFF" />
        <SolidColorBrush x:Key="WeekdayHeaderBrush" Color="#80FFFFFF" />
        <SolidColorBrush x:Key="CellHoverBrush" Color="#18FFFFFF" />

        <!-- 28x28 Transparent Month Stepper Navigation Button Style -->
        <Style x:Key="CalendarNavButtonStyle" TargetType="Button">
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="Foreground" Value="#C0FFFFFF" />
            <Setter Property="Width" Value="28" />
            <Setter Property="Height" Value="28" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Focusable" Value="False" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Border"
                                Background="{TemplateBinding Background}"
                                CornerRadius="4"
                                SnapsToDevicePixels="True">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Border" Property="Background" Value="#25FFFFFF" />
                                <Setter Property="Foreground" Value="#FFFFFF" />
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="Border" Property="Background" Value="#35FFFFFF" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

    </UserControl.Resources>

    <widgets:WidgetCard Padding="18,16">
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" /> <!-- Header: Month/Year + Chevron Navigation -->
                <RowDefinition Height="Auto" /> <!-- Day-of-week headers: Su Mo Tu We Th Fr Sa -->
                <RowDefinition Height="*" />    <!-- 42-day Month Grid -->
            </Grid.RowDefinitions>

            <!-- 1. Header Bar: Habit-matched chevrons and centered title -->
            <Grid Grid.Row="0" Margin="2,0,2,8">
                <!-- Left Chevron Button -->
                <Button HorizontalAlignment="Left"
                        VerticalAlignment="Center"
                        Command="{Binding PreviousMonthCommand}"
                        ToolTip="Previous Month"
                        Style="{StaticResource CalendarNavButtonStyle}">
                    <ui:SymbolIcon Symbol="ChevronLeft24" FontSize="16" />
                </Button>

                <!-- Center Month / Year Title (Static Text) -->
                <TextBlock HorizontalAlignment="Center"
                           VerticalAlignment="Center"
                           Text="{Binding MonthYearTitle}"
                           FontFamily="Segoe UI Variable Display, Segoe UI, sans-serif"
                           FontSize="15"
                           FontWeight="Bold"
                           Foreground="#FFFFFF" />

                <!-- Right Chevron Button -->
                <Button HorizontalAlignment="Right"
                        VerticalAlignment="Center"
                        Command="{Binding NextMonthCommand}"
                        ToolTip="Next Month"
                        Style="{StaticResource CalendarNavButtonStyle}">
                    <ui:SymbolIcon Symbol="ChevronRight24" FontSize="16" />
                </Button>
            </Grid>

            <!-- 2. Weekday Header (Su, Mo, Tu, We, Th, Fr, Sa) -->
            <UniformGrid Grid.Row="1" Columns="7" Margin="0,0,0,6">
                <TextBlock Text="Su" HorizontalAlignment="Center" FontFamily="Segoe UI Variable Text, Segoe UI, sans-serif" FontWeight="SemiBold" FontSize="11.5" Foreground="{StaticResource WeekdayHeaderBrush}" />
                <TextBlock Text="Mo" HorizontalAlignment="Center" FontFamily="Segoe UI Variable Text, Segoe UI, sans-serif" FontWeight="SemiBold" FontSize="11.5" Foreground="{StaticResource WeekdayHeaderBrush}" />
                <TextBlock Text="Tu" HorizontalAlignment="Center" FontFamily="Segoe UI Variable Text, Segoe UI, sans-serif" FontWeight="SemiBold" FontSize="11.5" Foreground="{StaticResource WeekdayHeaderBrush}" />
                <TextBlock Text="We" HorizontalAlignment="Center" FontFamily="Segoe UI Variable Text, Segoe UI, sans-serif" FontWeight="SemiBold" FontSize="11.5" Foreground="{StaticResource WeekdayHeaderBrush}" />
                <TextBlock Text="Th" HorizontalAlignment="Center" FontFamily="Segoe UI Variable Text, Segoe UI, sans-serif" FontWeight="SemiBold" FontSize="11.5" Foreground="{StaticResource WeekdayHeaderBrush}" />
                <TextBlock Text="Fr" HorizontalAlignment="Center" FontFamily="Segoe UI Variable Text, Segoe UI, sans-serif" FontWeight="SemiBold" FontSize="11.5" Foreground="{StaticResource WeekdayHeaderBrush}" />
                <TextBlock Text="Sa" HorizontalAlignment="Center" FontFamily="Segoe UI Variable Text, Segoe UI, sans-serif" FontWeight="SemiBold" FontSize="11.5" Foreground="{StaticResource WeekdayHeaderBrush}" />
            </UniformGrid>

            <!-- 3. 42-Day Grid Area (Seamless Single-Polygon Month Backplate + Number Grid) -->
            <Grid Grid.Row="2">
                <!-- Seamless Single-Polygon Month Backplate: Renders month as 1 continuous shape in neutral grey -->
                <calendar:CalendarMonthBackplate
                    FirstDayOffset="{Binding FirstDayOffset}"
                    DaysInMonth="{Binding DaysInMonth}"
                    FillBrush="{StaticResource MonthBlockBrush}"
                    SnapsToDevicePixels="True" />

                <ItemsControl ItemsSource="{Binding Days}">
                    <ItemsControl.ItemsPanel>
                        <ItemsPanelTemplate>
                            <UniformGrid Rows="6" Columns="7" />
                        </ItemsPanelTemplate>
                    </ItemsControl.ItemsPanel>
                    <ItemsControl.ItemContainerStyle>
                        <Style TargetType="ContentPresenter">
                            <Setter Property="HorizontalAlignment" Value="Stretch" />
                            <Setter Property="VerticalAlignment" Value="Stretch" />
                        </Style>
                    </ItemsControl.ItemContainerStyle>
                    <ItemsControl.ItemTemplate>
                        <DataTemplate DataType="{x:Type calendar:CalendarDayViewModel}">
                            <!-- Outer Cell Border: Transparent hit-testable container -->
                            <Border x:Name="CellOuterBorder"
                                    Background="Transparent"
                                    BorderThickness="0"
                                    HorizontalAlignment="Stretch"
                                    VerticalAlignment="Stretch"
                                    Cursor="Hand"
                                    SnapsToDevicePixels="True">
                                <Border.InputBindings>
                                    <MouseBinding MouseAction="LeftClick"
                                                  Command="{Binding DataContext.SelectDayCommand, RelativeSource={RelativeSource AncestorType=ItemsControl}}"
                                                  CommandParameter="{Binding}" />
                                </Border.InputBindings>
                                <Grid HorizontalAlignment="Stretch" VerticalAlignment="Stretch">
                                    <!-- Hover Overlay -->
                                    <Border x:Name="HoverOverlay"
                                            Opacity="0"
                                            Background="{StaticResource CellHoverBrush}"
                                            SnapsToDevicePixels="True" />

                                    <!-- Day Number Text -->
                                    <TextBlock x:Name="DayLabel"
                                               Text="{Binding DayText}"
                                               HorizontalAlignment="Center"
                                               VerticalAlignment="Center"
                                               FontFamily="Segoe UI Variable Text, Segoe UI, sans-serif"
                                               FontSize="13.5"
                                               FontWeight="Normal"
                                               Foreground="{StaticResource OutOfMonthTextBrush}"
                                               SnapsToDevicePixels="True" />

                                    <!-- Active Date Pill Indicator (Below the date) -->
                                    <Border x:Name="TodayPill"
                                            Width="14"
                                            Height="3.5"
                                            CornerRadius="2"
                                            Background="#60CDFF"
                                            HorizontalAlignment="Center"
                                            VerticalAlignment="Bottom"
                                            Margin="0,0,0,3"
                                            Visibility="Collapsed"
                                            IsHitTestVisible="False"
                                            RenderOptions.EdgeMode="Unspecified"
                                            SnapsToDevicePixels="False">
                                        <Border.Effect>
                                            <DropShadowEffect Color="#60CDFF" BlurRadius="4" ShadowDepth="0" Opacity="0.8" />
                                        </Border.Effect>
                                    </Border>
                                </Grid>
                            </Border>

                            <DataTemplate.Triggers>
                                <!-- Current Month: SemiBold White Text (Background is rendered seamlessly by Backplate) -->
                                <DataTrigger Binding="{Binding IsCurrentMonth}" Value="True">
                                    <Setter TargetName="DayLabel" Property="Foreground" Value="{StaticResource CurrentMonthTextBrush}" />
                                    <Setter TargetName="DayLabel" Property="FontWeight" Value="SemiBold" />
                                </DataTrigger>

                                <!-- Today: Bright Blue Accent Pill Below Date -->
                                <DataTrigger Binding="{Binding IsToday}" Value="True">
                                    <Setter TargetName="TodayPill" Property="Visibility" Value="Visible" />
                                    <Setter TargetName="DayLabel" Property="FontWeight" Value="Bold" />
                                </DataTrigger>

                                <!-- Mouse Hover -->
                                <Trigger Property="IsMouseOver" Value="True">
                                    <Setter TargetName="HoverOverlay" Property="Opacity" Value="1" />
                                </Trigger>
                            </DataTemplate.Triggers>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </Grid>
        </Grid>
    </widgets:WidgetCard>
</UserControl>
