<UserControl x:Class="MetroHub.Widgets.Catalog.QuickControls.QuickControlsWidgetView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:widgets="clr-namespace:MetroHub.Widgets"
             xmlns:quickcontrols="clr-namespace:MetroHub.Widgets.Catalog.QuickControls"
             xmlns:controls="clr-namespace:MetroHub.Presentation.Controls"
             mc:Ignorable="d" 
             d:DataContext="{d:DesignInstance Type=quickcontrols:QuickControlsWidgetViewModel}"
             Focusable="False"
             SnapsToDevicePixels="True"
             UseLayoutRounding="True"
             TextOptions.TextFormattingMode="Ideal"
             TextOptions.TextRenderingMode="ClearType"
             TextOptions.TextHintingMode="Fixed"
             RenderOptions.ClearTypeHint="Enabled">

    <UserControl.Resources>
        <BooleanToVisibilityConverter x:Key="BoolToVis" />

        <!-- Media & Volume Transport Button Style: Inherits FluentGhostButtonStyle (2px Corner Radius, unified sidebar hover) -->
        <Style x:Key="TransportButtonStyle" TargetType="Button" BasedOn="{StaticResource FluentGhostButtonStyle}">
            <Setter Property="Width" Value="28" />
            <Setter Property="Height" Value="28" />
            <Setter Property="Padding" Value="0" />
            <Setter Property="Focusable" Value="False" />
        </Style>
    </UserControl.Resources>

    <!-- Transparent unified WidgetCard without dividing lines -->
    <widgets:WidgetCard Padding="0" Background="Transparent" CornerRadius="2">
        <Grid SnapsToDevicePixels="True" UseLayoutRounding="True" ClipToBounds="True" Background="Transparent">
            <Grid.RowDefinitions>
                <!-- Row 0: Media Player Strip (~56px) -->
                <RowDefinition Height="*" />
                <!-- Row 1: Master Volume Strip (~56px) -->
                <RowDefinition Height="*" />
                <!-- Row 2: Master Brightness Strip (~56px) -->
                <RowDefinition Height="*" />
            </Grid.RowDefinitions>

            <!-- ============================================================= -->
            <!-- ROW 0: MEDIA PLAYER SLIM CONTROLLER                           -->
            <!-- ============================================================= -->
            <!-- ROW 0: MEDIA PLAYER SLIM CONTROLLER                           -->
            <!-- [ ▷ Play ] ========== Track Title / Artist ========== [ < > ] -->
            <!-- ============================================================= -->
            <Grid Grid.Row="0" Margin="14,0,14,0" Background="Transparent" VerticalAlignment="Center">
                <Grid.ColumnDefinitions>
                    <!-- Col 0: Play/Pause Button -->
                    <ColumnDefinition Width="Auto" />
                    <!-- Col 1: Center Area (Track info or 'No media playing' label) -->
                    <ColumnDefinition Width="*" />
                    <!-- Col 2: Previous & Next Buttons -->
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <!-- Col 0: Play/Pause Button -->
                <Button Grid.Column="0"
                        Style="{StaticResource TransportButtonStyle}"
                        Command="{Binding Media.TogglePlayPauseCommand}"
                        IsEnabled="{Binding Media.CanPlayPause}"
                        VerticalAlignment="Center"
                        HorizontalAlignment="Left"
                        ToolTip="Play / Pause">
                    <TextBlock FontFamily="{DynamicResource AppIconFontFamily}"
                               VerticalAlignment="Center"
                               HorizontalAlignment="Center">
                        <TextBlock.Style>
                            <Style TargetType="TextBlock">
                                <Setter Property="Text" Value="&#xE768;" />
                                <Setter Property="FontSize" Value="15" />
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding Media.IsPlaying}" Value="True">
                                        <Setter Property="Text" Value="&#xE769;" />
                                        <Setter Property="FontSize" Value="16" />
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </TextBlock.Style>
                    </TextBlock>
                </Button>

                <!-- Col 1: Center Area -->
                <Grid Grid.Column="1" Margin="12,0,12,0" VerticalAlignment="Center">
                    <!-- Idle State: 'No media playing' subtle text -->
                    <TextBlock Text="No media playing"
                               FontSize="12"
                               FontWeight="Normal"
                               Foreground="#55FFFFFF"
                               FontFamily="{DynamicResource AppDisplayFontFamily}"
                               HorizontalAlignment="Center"
                               VerticalAlignment="Center"
                               TextTrimming="CharacterEllipsis"
                               Visibility="{Binding Media.HasNoMedia, Converter={StaticResource BoolToVis}}" />

                    <!-- Active State: Track Title & Artist -->
                    <StackPanel VerticalAlignment="Center"
                                Visibility="{Binding Media.HasMedia, Converter={StaticResource BoolToVis}}">
                        <TextBlock Text="{Binding Media.Title}"
                                   FontSize="12.5"
                                   FontWeight="SemiBold"
                                   Foreground="#FFFFFF"
                                   FontFamily="{DynamicResource AppDisplayFontFamily}"
                                   TextTrimming="CharacterEllipsis"
                                   TextWrapping="NoWrap" />
                        <TextBlock Text="{Binding Media.Artist}"
                                   FontSize="11"
                                   Foreground="#CAD7EA"
                                   TextTrimming="CharacterEllipsis"
                                   TextWrapping="NoWrap"
                                   Margin="0,1,0,0">
                            <TextBlock.Style>
                                <Style TargetType="TextBlock">
                                    <Setter Property="Visibility" Value="Visible" />
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding Media.Artist}" Value="">
                                            <Setter Property="Visibility" Value="Collapsed" />
                                        </DataTrigger>
                                        <DataTrigger Binding="{Binding Media.Artist}" Value="{x:Null}">
                                            <Setter Property="Visibility" Value="Collapsed" />
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </TextBlock.Style>
                        </TextBlock>
                    </StackPanel>
                </Grid>

                <!-- Col 2: Previous & Next Buttons -->
                <StackPanel Grid.Column="2"
                            Orientation="Horizontal"
                            VerticalAlignment="Center"
                            Visibility="{Binding Media.HasMedia, Converter={StaticResource BoolToVis}}">
                    <Button Style="{StaticResource TransportButtonStyle}"
                            Command="{Binding Media.SkipPreviousCommand}"
                            IsEnabled="{Binding Media.CanSkipPrevious}"
                            Width="26"
                            Height="26"
                            ToolTip="Previous">
                        <TextBlock Text="&#xE76B;"
                                   FontFamily="{DynamicResource AppIconFontFamily}"
                                   FontSize="13"
                                   VerticalAlignment="Center"
                                   HorizontalAlignment="Center" />
                    </Button>
                    <Button Style="{StaticResource TransportButtonStyle}"
                            Command="{Binding Media.SkipNextCommand}"
                            IsEnabled="{Binding Media.CanSkipNext}"
                            Width="26"
                            Height="26"
                            Margin="2,0,0,0"
                            ToolTip="Next">
                        <TextBlock Text="&#xE76C;"
                                   FontFamily="{DynamicResource AppIconFontFamily}"
                                   FontSize="13"
                                   VerticalAlignment="Center"
                                   HorizontalAlignment="Center" />
                    </Button>
                </StackPanel>
            </Grid>

            <!-- ============================================================= -->
            <!-- ROW 1: MASTER AUDIO STRIP                                     -->
            <!-- [ 🎧 Logo ] =========== Seekbar =========== [ 🔊 Mute ]       -->
            <!-- ============================================================= -->
            <Grid Grid.Row="1" Margin="14,0,14,0" Background="Transparent" VerticalAlignment="Center">
                <Grid.ColumnDefinitions>
                    <!-- Col 0: Output Logo Icon -->
                    <ColumnDefinition Width="Auto" />
                    <!-- Col 1: Master Volume Seekbar -->
                    <ColumnDefinition Width="*" />
                    <!-- Col 2: Mute Button -->
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <!-- 1. Output Logo -->
                <Button Grid.Column="0"
                        Style="{StaticResource TransportButtonStyle}"
                        HorizontalAlignment="Left"
                        Command="{Binding Volume.ToggleNextDeviceCommand}"
                        ToolTip="{Binding Volume.ActiveDeviceName}">
                    <TextBlock Text="{Binding Volume.ActiveDeviceIcon}"
                               FontFamily="{DynamicResource AppIconFontFamily}"
                               FontSize="16"
                               Foreground="#FFFFFF"
                               VerticalAlignment="Center"
                               HorizontalAlignment="Center" />
                </Button>

                <!-- 2. Master Volume Seekbar -->
                <controls:FluentVolumeSlider x:Name="MasterVolumeSlider"
                                            Grid.Column="1"
                                            Margin="12,0"
                                            VerticalAlignment="Center"
                                            Value="{Binding Volume.MasterVolume, Mode=TwoWay}"
                                            IsMuted="{Binding Volume.IsMasterMuted}"
                                            Minimum="0"
                                            Maximum="100"
                                            ProgressBrush="#00B4D8"
                                            ProgressPointerOverBrush="#33C9E8"
                                            Tag="InteractiveControl"
                                            SnapsToDevicePixels="True" />

                <!-- 3. Mute Button / % Display -->
                <Button Grid.Column="2"
                        Style="{StaticResource TransportButtonStyle}"
                        HorizontalAlignment="Right"
                        Command="{Binding Volume.ToggleMasterMuteCommand}"
                        ToolTip="Mute / Unmute Master Volume"
                        MinWidth="34">
                    <Grid HorizontalAlignment="Center" VerticalAlignment="Center">
                        <!-- Speaker / Mute Glyph Icon -->
                        <TextBlock Text="{Binding Volume.MasterGlyph}"
                                   FontFamily="{DynamicResource AppIconFontFamily}"
                                   FontSize="15"
                                   Foreground="#FFFFFF"
                                   VerticalAlignment="Center"
                                   HorizontalAlignment="Center">
                            <TextBlock.Style>
                                <Style TargetType="TextBlock">
                                    <Setter Property="Visibility" Value="Visible" />
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding IsDragging, ElementName=MasterVolumeSlider}" Value="True">
                                            <Setter Property="Visibility" Value="Collapsed" />
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </TextBlock.Style>
                        </TextBlock>

                        <!-- Volume % Number Shown While Dragging -->
                        <TextBlock Text="{Binding Volume.MasterVolumePercentText}"
                                   FontSize="11.5"
                                   FontWeight="SemiBold"
                                   Foreground="#FFFFFF"
                                   VerticalAlignment="Center"
                                   HorizontalAlignment="Center">
                            <TextBlock.Style>
                                <Style TargetType="TextBlock">
                                    <Setter Property="Visibility" Value="Collapsed" />
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding IsDragging, ElementName=MasterVolumeSlider}" Value="True">
                                            <Setter Property="Visibility" Value="Visible" />
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </TextBlock.Style>
                        </TextBlock>
                    </Grid>
                </Button>
            </Grid>

            <!-- ============================================================= -->
            <!-- ROW 2: MASTER BRIGHTNESS STRIP                                -->
            <!-- [ ☼ Mode ] =========== Seekbar =========== [ 🔗 Link ]        -->
            <!-- ============================================================= -->
            <Grid Grid.Row="2" Margin="14,0,14,0" Background="Transparent" VerticalAlignment="Center">
                <Grid.ColumnDefinitions>
                    <!-- Col 0: Day / Night Mode Icon -->
                    <ColumnDefinition Width="Auto" />
                    <!-- Col 1: Master Brightness Seekbar -->
                    <ColumnDefinition Width="*" />
                    <!-- Col 2: Link / Sync Button -->
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <!-- 1. Day / Night Toggle Button -->
                <Button Grid.Column="0"
                        Style="{StaticResource TransportButtonStyle}"
                        HorizontalAlignment="Left"
                        Command="{Binding Brightness.ToggleNightModeCommand}"
                        ToolTip="{Binding Brightness.NightModeTooltip}">
                    <TextBlock Text="{Binding Brightness.MasterGlyph}"
                               FontFamily="{DynamicResource AppIconFontFamily}"
                               FontSize="16"
                               Foreground="#FFFFFF"
                               VerticalAlignment="Center"
                               HorizontalAlignment="Center" />
                </Button>

                <!-- 2. Master Brightness Seekbar -->
                <controls:FluentVolumeSlider x:Name="MasterBrightnessSlider"
                                            Grid.Column="1"
                                            Margin="12,0"
                                            VerticalAlignment="Center"
                                            Value="{Binding Brightness.MasterBrightness, Mode=TwoWay}"
                                            Minimum="0"
                                            Maximum="100"
                                            ProgressBrush="#00B4D8"
                                            ProgressPointerOverBrush="#33C9E8"
                                            Tag="InteractiveControl"
                                            SnapsToDevicePixels="True" />

                <!-- 3. Link / Sync Button / % Display -->
                <Button Grid.Column="2"
                        Style="{StaticResource TransportButtonStyle}"
                        HorizontalAlignment="Right"
                        Command="{Binding Brightness.ToggleLinkCommand}"
                        ToolTip="{Binding Brightness.LinkTooltip}"
                        MinWidth="34">
                    <Grid HorizontalAlignment="Center" VerticalAlignment="Center">
                        <!-- Link Glyph Icon -->
                        <TextBlock Text="{Binding Brightness.LinkGlyph}"
                                   FontFamily="{DynamicResource AppIconFontFamily}"
                                   FontSize="15"
                                   Foreground="#FFFFFF"
                                   VerticalAlignment="Center"
                                   HorizontalAlignment="Center">
                            <TextBlock.Style>
                                <Style TargetType="TextBlock">
                                    <Setter Property="Visibility" Value="Visible" />
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding IsDragging, ElementName=MasterBrightnessSlider}" Value="True">
                                            <Setter Property="Visibility" Value="Collapsed" />
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </TextBlock.Style>
                        </TextBlock>

                        <!-- Brightness % Number Shown While Dragging -->
                        <TextBlock Text="{Binding Brightness.MasterBrightnessPercentText}"
                                   FontSize="11.5"
                                   FontWeight="SemiBold"
                                   Foreground="#FFFFFF"
                                   VerticalAlignment="Center"
                                   HorizontalAlignment="Center"
                                   Margin="0,-1,0,0"
                                   Typography.NumeralAlignment="Tabular">
                            <TextBlock.Style>
                                <Style TargetType="TextBlock">
                                    <Setter Property="Visibility" Value="Collapsed" />
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding IsDragging, ElementName=MasterBrightnessSlider}" Value="True">
                                            <Setter Property="Visibility" Value="Visible" />
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </TextBlock.Style>
                        </TextBlock>
                    </Grid>
                </Button>
            </Grid>

        </Grid>
    </widgets:WidgetCard>
</UserControl>
