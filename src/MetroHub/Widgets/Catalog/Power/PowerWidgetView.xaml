<UserControl x:Class="MetroHub.Widgets.Catalog.Power.PowerWidgetView"
             x:Name="Root"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:widgets="clr-namespace:MetroHub.Widgets"
             xmlns:power="clr-namespace:MetroHub.Widgets.Catalog.Power"
             xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
             mc:Ignorable="d" 
             d:DataContext="{d:DesignInstance Type=power:PowerWidgetViewModel}"
             Focusable="False"
             FocusVisualStyle="{x:Null}"
             ClipToBounds="True"
             SnapsToDevicePixels="True"
             UseLayoutRounding="True"
             TextOptions.TextFormattingMode="Ideal"
             TextOptions.TextRenderingMode="ClearType"
             TextOptions.TextHintingMode="Fixed">

    <UserControl.Resources>
        <!-- Exact replica of Network Widget WidgetTileStyle: Direct Border with no RenderTransforms for razor-sharp vector icons -->
        <Style x:Key="PowerActionButtonStyle" TargetType="Button">
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="BorderBrush" Value="Transparent" />
            <Setter Property="BorderThickness" Value="1,0,1,0" />
            <Setter Property="Margin" Value="-1,0,0,0" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Focusable" Value="False" />
            <Setter Property="FocusVisualStyle" Value="{x:Null}" />
            <Setter Property="HorizontalContentAlignment" Value="Center" />
            <Setter Property="VerticalContentAlignment" Value="Center" />
            <Setter Property="SnapsToDevicePixels" Value="True" />
            <Setter Property="UseLayoutRounding" Value="True" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="ButtonBorder"
                                Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                SnapsToDevicePixels="True"
                                UseLayoutRounding="True">
                            <ContentPresenter HorizontalAlignment="Center"
                                              VerticalAlignment="Center"
                                              SnapsToDevicePixels="True"
                                              UseLayoutRounding="True" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <!-- Hover state: illuminates vertical dividing borders only, exactly like Network widget -->
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="ButtonBorder" Property="BorderBrush" Value="#55FFFFFF" />
                                <Setter Property="Panel.ZIndex" Value="10" />
                            </Trigger>
                            <!-- Pressed state -->
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="ButtonBorder" Property="BorderBrush" Value="#75FFFFFF" />
                                <Setter Property="Panel.ZIndex" Value="10" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </UserControl.Resources>

    <widgets:WidgetCard Padding="0" Background="Transparent" VerticalAlignment="Stretch">
        <UniformGrid Rows="1" SnapsToDevicePixels="True" VerticalAlignment="Stretch">
            <!-- Lock -->
            <Button Style="{StaticResource PowerActionButtonStyle}"
                    Command="{Binding ExecuteActionCommand}"
                    CommandParameter="Lock"
                    ToolTip="{Binding LockTooltip}">
                <Grid HorizontalAlignment="Center"
                      VerticalAlignment="Center"
                      Margin="0,0,0,2"
                      SnapsToDevicePixels="True">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>
                    <ui:SymbolIcon Grid.Row="0"
                                   Symbol="{Binding LockSymbol}"
                                   Foreground="{Binding LockForeground}"
                                   FontSize="24"
                                   Margin="{Binding IconMargin}"
                                   HorizontalAlignment="Center"
                                   VerticalAlignment="Center"
                                   SnapsToDevicePixels="True" />
                    <TextBlock Grid.Row="1"
                               Text="{Binding LockHeader}"
                               Foreground="{Binding LockForeground}"
                               Visibility="{Binding TextVisibility}"
                               FontFamily="Segoe UI Variable Text, Segoe UI, sans-serif"
                               FontSize="11.5"
                               FontWeight="SemiBold"
                               HorizontalAlignment="Center"
                               VerticalAlignment="Center"
                               TextAlignment="Center"
                               SnapsToDevicePixels="True" />
                </Grid>
            </Button>

            <!-- Sleep -->
            <Button Style="{StaticResource PowerActionButtonStyle}"
                    Command="{Binding ExecuteActionCommand}"
                    CommandParameter="Sleep"
                    ToolTip="{Binding SleepTooltip}">
                <Grid HorizontalAlignment="Center"
                      VerticalAlignment="Center"
                      Margin="0,0,0,2"
                      SnapsToDevicePixels="True">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>
                    <ui:SymbolIcon Grid.Row="0"
                                   Symbol="{Binding SleepSymbol}"
                                   Foreground="{Binding SleepForeground}"
                                   FontSize="24"
                                   Margin="{Binding IconMargin}"
                                   HorizontalAlignment="Center"
                                   VerticalAlignment="Center"
                                   SnapsToDevicePixels="True" />
                    <TextBlock Grid.Row="1"
                               Text="{Binding SleepHeader}"
                               Foreground="{Binding SleepForeground}"
                               Visibility="{Binding TextVisibility}"
                               FontFamily="Segoe UI Variable Text, Segoe UI, sans-serif"
                               FontSize="11.5"
                               FontWeight="SemiBold"
                               HorizontalAlignment="Center"
                               VerticalAlignment="Center"
                               TextAlignment="Center"
                               SnapsToDevicePixels="True" />
                </Grid>
            </Button>

            <!-- Restart -->
            <Button Style="{StaticResource PowerActionButtonStyle}"
                    Command="{Binding ExecuteActionCommand}"
                    CommandParameter="Restart"
                    ToolTip="{Binding RestartTooltip}">
                <Grid HorizontalAlignment="Center"
                      VerticalAlignment="Center"
                      Margin="0,0,0,2"
                      SnapsToDevicePixels="True">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>
                    <ui:SymbolIcon Grid.Row="0"
                                   Symbol="{Binding RestartSymbol}"
                                   Foreground="{Binding RestartForeground}"
                                   FontSize="24"
                                   Margin="{Binding IconMargin}"
                                   HorizontalAlignment="Center"
                                   VerticalAlignment="Center"
                                   SnapsToDevicePixels="True" />
                    <TextBlock Grid.Row="1"
                               Text="{Binding RestartHeader}"
                               Foreground="{Binding RestartForeground}"
                               Visibility="{Binding TextVisibility}"
                               FontFamily="Segoe UI Variable Text, Segoe UI, sans-serif"
                               FontSize="11.5"
                               FontWeight="SemiBold"
                               HorizontalAlignment="Center"
                               VerticalAlignment="Center"
                               TextAlignment="Center"
                               SnapsToDevicePixels="True" />
                </Grid>
            </Button>

            <!-- Shutdown -->
            <Button Style="{StaticResource PowerActionButtonStyle}"
                    Command="{Binding ExecuteActionCommand}"
                    CommandParameter="Shutdown"
                    ToolTip="{Binding ShutdownTooltip}">
                <Grid HorizontalAlignment="Center"
                      VerticalAlignment="Center"
                      Margin="0,0,0,2"
                      SnapsToDevicePixels="True">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>
                    <ui:SymbolIcon Grid.Row="0"
                                   Symbol="{Binding ShutdownSymbol}"
                                   Foreground="{Binding ShutdownForeground}"
                                   FontSize="24"
                                   Margin="{Binding IconMargin}"
                                   HorizontalAlignment="Center"
                                   VerticalAlignment="Center"
                                   SnapsToDevicePixels="True" />
                    <TextBlock Grid.Row="1"
                               Text="{Binding ShutdownHeader}"
                               Foreground="{Binding ShutdownForeground}"
                               Visibility="{Binding TextVisibility}"
                               FontFamily="Segoe UI Variable Text, Segoe UI, sans-serif"
                               FontSize="11.5"
                               FontWeight="SemiBold"
                               HorizontalAlignment="Center"
                               VerticalAlignment="Center"
                               TextAlignment="Center"
                               SnapsToDevicePixels="True" />
                </Grid>
            </Button>
        </UniformGrid>
    </widgets:WidgetCard>
</UserControl>
