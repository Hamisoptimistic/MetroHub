<dialogs:MetroDialog x:Class="MetroHub.Widgets.Catalog.Template.TemplateDialog"
                     xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                     xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                     xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
                     xmlns:dialogs="clr-namespace:MetroHub.Presentation.Dialogs"
                     Title="Configure Template"
                     Width="480"
                     Height="320">

    <!-- Frosted Acrylic Left Sidebar Content Slot -->
    <dialogs:MetroDialog.SidebarContent>
        <Grid HorizontalAlignment="Center" VerticalAlignment="Center">
            <Ellipse Width="70" Height="70" Fill="#182563EB">
                <Ellipse.Effect>
                    <BlurEffect Radius="16" />
                </Ellipse.Effect>
            </Ellipse>
            <ui:SymbolIcon Symbol="Cube24"
                           FontSize="48"
                           Foreground="{DynamicResource TextSecondaryBrush}"
                           HorizontalAlignment="Center"
                           VerticalAlignment="Center" />
        </Grid>
    </dialogs:MetroDialog.SidebarContent>

    <!-- Dark Obsidian Form Content Slot -->
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <!-- Form Body -->
        <StackPanel Grid.Row="0">
            <TextBlock Text="Widget Label"
                       FontSize="{DynamicResource TypeCaptionFontSize}"
                       FontWeight="{DynamicResource TypeCaptionFontWeight}"
                       Foreground="{DynamicResource TextMutedBrush}"
                       Margin="0,0,0,6" />
            <TextBox x:Name="LabelInput"
                     Style="{DynamicResource FluentGlassInputStyle}"
                     Margin="0,0,0,16" />

            <TextBlock Text="Options"
                       FontSize="{DynamicResource TypeCaptionFontSize}"
                       FontWeight="{DynamicResource TypeCaptionFontWeight}"
                       Foreground="{DynamicResource TextMutedBrush}"
                       Margin="0,0,0,6" />
            <CheckBox x:Name="FeatureToggleCheckbox"
                      Content="Enable Active Mode"
                      Foreground="{DynamicResource TextPrimaryBrush}"
                      FontSize="{DynamicResource TypeBodyFontSize}" />
        </StackPanel>

        <!-- Footer Action Buttons -->
        <Grid Grid.Row="1" Margin="0,16,0,0">
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                <Button Content="Save"
                        Style="{DynamicResource FluentCohesivePrimaryButtonStyle}"
                        Margin="0,0,8,0"
                        Click="OnSaveClick" />
                <Button Content="Cancel"
                        Style="{DynamicResource FluentCohesiveSecondaryButtonStyle}"
                        Click="OnCancelClick" />
            </StackPanel>
        </Grid>
    </Grid>
</dialogs:MetroDialog>
