<UserControl x:Class="MetroHub.Widgets.Catalog.Clock.ClockWidgetView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:clock="clr-namespace:MetroHub.Widgets.Catalog.Clock"
             xmlns:widgets="clr-namespace:MetroHub.Widgets"
             mc:Ignorable="d" 
             d:DataContext="{d:DesignInstance Type=clock:ClockWidgetViewModel}"
             Focusable="False"
             SnapsToDevicePixels="True"
             UseLayoutRounding="True"
             Typography.NumeralAlignment="Tabular"
             Typography.NumeralStyle="Normal"
             TextOptions.TextFormattingMode="Ideal"
             TextOptions.TextRenderingMode="ClearType"
             TextOptions.TextHintingMode="Animated"
             RenderOptions.ClearTypeHint="Enabled">

    <UserControl.Resources>
        <BooleanToVisibilityConverter x:Key="BoolToVis" />
    </UserControl.Resources>

    <widgets:WidgetCard Padding="8,4">
        <Grid SnapsToDevicePixels="True" UseLayoutRounding="True">
            <!-- 1. Wide 4x2 Layout: Time Centered (No AM/PM, No Date) with Micro-Motion -->
            <Grid Visibility="{Binding IsWideOnly, Converter={StaticResource BoolToVis}}"
                  VerticalAlignment="Center" HorizontalAlignment="Center">
                <StackPanel Orientation="Horizontal" VerticalAlignment="Center" HorizontalAlignment="Center">
                    <clock:AnimatedTimeBlock Text="{Binding HoursString}"
                                             EnableTextDepth="True"
                                             FontSize="{Binding ClockTimeFontSize}"
                                             FontWeight="{Binding ClockFontWeight}"
                                             FontFamily="{Binding ClockFontFamily}"
                                             Foreground="#FFFFFF"
                                             VerticalAlignment="Center"
                                             TextAlignment="Center" />
                    <TextBlock Text=":"
                               FontSize="{Binding ClockTimeFontSize}"
                               FontWeight="{Binding ClockFontWeight}"
                               FontFamily="{Binding ClockFontFamily}"
                               Foreground="#FFFFFF"
                               VerticalAlignment="Center"
                               Typography.NumeralAlignment="Tabular"
                               Typography.NumeralStyle="Normal"
                               TextOptions.TextFormattingMode="Ideal"
                               TextOptions.TextRenderingMode="ClearType"
                               TextOptions.TextHintingMode="Animated">
                        <TextBlock.Effect>
                            <DropShadowEffect BlurRadius="26"
                                              Direction="270"
                                              ShadowDepth="4"
                                              Opacity="0.22"
                                              Color="#080E1A" />
                        </TextBlock.Effect>
                    </TextBlock>
                    <clock:AnimatedTimeBlock Text="{Binding MinutesString}"
                                             EnableTextDepth="True"
                                             FontSize="{Binding ClockTimeFontSize}"
                                             FontWeight="{Binding ClockFontWeight}"
                                             FontFamily="{Binding ClockFontFamily}"
                                             Foreground="#FFFFFF"
                                             VerticalAlignment="Center"
                                             TextAlignment="Center" />
                </StackPanel>
            </Grid>

            <!-- 2. Banner 8x2 Layout: Time on Left, Full Date on Right with Micro-Motion -->
            <Grid Visibility="{Binding IsBanner, Converter={StaticResource BoolToVis}}"
                  VerticalAlignment="Center" Margin="16,0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>

                <!-- Time -->
                <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center">
                    <clock:AnimatedTimeBlock Text="{Binding HoursString}"
                                             EnableTextDepth="True"
                                             FontSize="{Binding ClockTimeFontSize}"
                                             FontWeight="{Binding ClockFontWeight}"
                                             FontFamily="{Binding ClockFontFamily}"
                                             Foreground="#FFFFFF"
                                             VerticalAlignment="Center"
                                             TextAlignment="Center" />
                    <TextBlock Text=":"
                               FontSize="{Binding ClockTimeFontSize}"
                               FontWeight="{Binding ClockFontWeight}"
                               FontFamily="{Binding ClockFontFamily}"
                               Foreground="#FFFFFF"
                               VerticalAlignment="Center"
                               Typography.NumeralAlignment="Tabular"
                               Typography.NumeralStyle="Normal"
                               TextOptions.TextFormattingMode="Ideal"
                               TextOptions.TextRenderingMode="ClearType"
                               TextOptions.TextHintingMode="Animated">
                        <TextBlock.Effect>
                            <DropShadowEffect BlurRadius="26"
                                              Direction="270"
                                              ShadowDepth="4"
                                              Opacity="0.22"
                                              Color="#080E1A" />
                        </TextBlock.Effect>
                    </TextBlock>
                    <clock:AnimatedTimeBlock Text="{Binding MinutesString}"
                                             EnableTextDepth="True"
                                             FontSize="{Binding ClockTimeFontSize}"
                                             FontWeight="{Binding ClockFontWeight}"
                                             FontFamily="{Binding ClockFontFamily}"
                                             Foreground="#FFFFFF"
                                             VerticalAlignment="Center"
                                             TextAlignment="Center" />
                </StackPanel>

                <!-- Full Date (e.g. Friday, 11 September) - Razor-sharp, clean typography -->
                <clock:AnimatedTimeBlock Grid.Column="1"
                                         Text="{Binding FullDateString}"
                                         FontSize="22"
                                         FontWeight="SemiBold"
                                         Foreground="#E0FFFFFF"
                                         VerticalAlignment="Center"
                                         HorizontalAlignment="Right"
                                         TextAlignment="Right" />
            </Grid>

            <!-- 3. Hero 4x4 / 6x4 / 8x4 Layout: Massive Centered Typography with Micro-Motion -->
            <Grid Visibility="{Binding IsHero, Converter={StaticResource BoolToVis}}"
                  VerticalAlignment="Center" HorizontalAlignment="Center">
                <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center">
                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" VerticalAlignment="Center">
                        <clock:AnimatedTimeBlock Text="{Binding HoursString}"
                                                 EnableTextDepth="True"
                                                 FontSize="{Binding ClockTimeFontSize}"
                                                 FontWeight="{Binding ClockFontWeight}"
                                                 FontFamily="{Binding ClockFontFamily}"
                                                 Foreground="#FFFFFF"
                                                 VerticalAlignment="Center"
                                                 TextAlignment="Center" />
                        <TextBlock Text=":"
                                   FontSize="{Binding ClockTimeFontSize}"
                                   FontWeight="{Binding ClockFontWeight}"
                                   FontFamily="{Binding ClockFontFamily}"
                                   Foreground="#FFFFFF"
                                   VerticalAlignment="Center"
                                   Typography.NumeralAlignment="Tabular"
                                   Typography.NumeralStyle="Normal"
                                   TextOptions.TextFormattingMode="Ideal"
                                   TextOptions.TextRenderingMode="ClearType"
                                   TextOptions.TextHintingMode="Animated">
                            <TextBlock.Effect>
                                <DropShadowEffect BlurRadius="26"
                                                  Direction="270"
                                                  ShadowDepth="4"
                                                  Opacity="0.22"
                                                  Color="#080E1A" />
                            </TextBlock.Effect>
                        </TextBlock>
                        <clock:AnimatedTimeBlock Text="{Binding MinutesString}"
                                                 EnableTextDepth="True"
                                                 FontSize="{Binding ClockTimeFontSize}"
                                                 FontWeight="{Binding ClockFontWeight}"
                                                 FontFamily="{Binding ClockFontFamily}"
                                                 Foreground="#FFFFFF"
                                                 VerticalAlignment="Center"
                                                 TextAlignment="Center" />
                    </StackPanel>

                    <!-- Full Date - Crisp, zero shadow -->
                    <clock:AnimatedTimeBlock Text="{Binding FullDateString}"
                                             FontSize="20"
                                             FontWeight="SemiBold"
                                             Foreground="#E0FFFFFF"
                                             HorizontalAlignment="Center"
                                             TextAlignment="Center"
                                             Margin="0,10,0,0" />
                </StackPanel>
            </Grid>
        </Grid>
    </widgets:WidgetCard>
</UserControl>
