<UserControl x:Class="MetroHub.Widgets.Catalog.Clock.ClockWidgetView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:clock="clr-namespace:MetroHub.Widgets.Catalog.Clock"
             xmlns:widgets="clr-namespace:MetroHub.Widgets"
             mc:Ignorable="d" 
             d:DataContext="{d:DesignInstance Type=clock:ClockWidgetViewModel}"
             Focusable="False"
             Typography.NumeralAlignment="Tabular"
             Typography.NumeralStyle="Normal"
             TextOptions.TextHintingMode="Animated"
             FontFamily="{DynamicResource AppDisplayFontFamily}">
    <widgets:WidgetCard Padding="12,10,12,10">
        <Grid>
            <!-- 1. Wide 4x2 Layout: Time Centered in Viewbox with Micro-Motion -->
            <Grid Visibility="{Binding IsWideOnly, Converter={StaticResource BoolToVis}}">
                <Viewbox Stretch="Uniform"
                         HorizontalAlignment="Center"
                         VerticalAlignment="Center"
                         Margin="4,8,4,0">
                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" VerticalAlignment="Center">
                        <clock:AnimatedTimeBlock Text="{Binding HoursString}"
                                                 EnableTextDepth="True"
                                                 FontSize="{DynamicResource TypeHeroCoordinateFontSize}"
                                                 FontWeight="{Binding ClockFontWeight}"
                                                 FontFamily="{Binding ClockFontFamily}"
                                                 Foreground="{DynamicResource TextPrimaryBrush}"
                                                 VerticalAlignment="Center"
                                                 TextAlignment="Center" />
                        <TextBlock Text=":"
                                   FontSize="{DynamicResource TypeHeroCoordinateFontSize}"
                                   FontWeight="{Binding ClockFontWeight}"
                                   FontFamily="{Binding ClockFontFamily}"
                                   Foreground="{DynamicResource TextPrimaryBrush}"
                                   VerticalAlignment="Center"
                                   Typography.NumeralAlignment="Tabular"
                                   Typography.NumeralStyle="Normal"
                                   TextOptions.TextFormattingMode="Ideal"
                                   TextOptions.TextRenderingMode="ClearType"
                                   TextOptions.TextHintingMode="Animated">
                            <TextBlock.Effect>
                                <StaticResource ResourceKey="StudioGlassTextShadow" />
                            </TextBlock.Effect>
                        </TextBlock>
                        <clock:AnimatedTimeBlock Text="{Binding MinutesString}"
                                                 EnableTextDepth="True"
                                                 FontSize="{DynamicResource TypeHeroCoordinateFontSize}"
                                                 FontWeight="{Binding ClockFontWeight}"
                                                 FontFamily="{Binding ClockFontFamily}"
                                                 Foreground="{DynamicResource TextPrimaryBrush}"
                                                 VerticalAlignment="Center"
                                                 TextAlignment="Center" />
                    </StackPanel>
                </Viewbox>
            </Grid>

            <!-- 2. Banner 8x2 Layout: Time on Left in Viewbox, Full Date on Right with Micro-Motion -->
            <Grid Visibility="{Binding IsBanner, Converter={StaticResource BoolToVis}}"
                  Margin="4,0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <!-- Time -->
                <Viewbox Grid.Column="0"
                         Stretch="Uniform"
                         HorizontalAlignment="Left"
                         VerticalAlignment="Center"
                         Margin="0,2,12,2">
                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                        <clock:AnimatedTimeBlock Text="{Binding HoursString}"
                                                 EnableTextDepth="True"
                                                 FontSize="{DynamicResource TypeHeroCoordinateFontSize}"
                                                 FontWeight="{Binding ClockFontWeight}"
                                                 FontFamily="{Binding ClockFontFamily}"
                                                 Foreground="{DynamicResource TextPrimaryBrush}"
                                                 VerticalAlignment="Center"
                                                 TextAlignment="Center" />
                        <TextBlock Text=":"
                                   FontSize="{DynamicResource TypeHeroCoordinateFontSize}"
                                   FontWeight="{Binding ClockFontWeight}"
                                   FontFamily="{Binding ClockFontFamily}"
                                   Foreground="{DynamicResource TextPrimaryBrush}"
                                   VerticalAlignment="Center"
                                   Typography.NumeralAlignment="Tabular"
                                   Typography.NumeralStyle="Normal"
                                   TextOptions.TextFormattingMode="Ideal"
                                   TextOptions.TextRenderingMode="ClearType"
                                   TextOptions.TextHintingMode="Animated">
                            <TextBlock.Effect>
                                <StaticResource ResourceKey="StudioGlassTextShadow" />
                            </TextBlock.Effect>
                        </TextBlock>
                        <clock:AnimatedTimeBlock Text="{Binding MinutesString}"
                                                 EnableTextDepth="True"
                                                 FontSize="{DynamicResource TypeHeroCoordinateFontSize}"
                                                 FontWeight="{Binding ClockFontWeight}"
                                                 FontFamily="{Binding ClockFontFamily}"
                                                 Foreground="{DynamicResource TextPrimaryBrush}"
                                                 VerticalAlignment="Center"
                                                 TextAlignment="Center" />
                    </StackPanel>
                </Viewbox>

                <!-- Full Date (e.g. Friday, 11 September) - Razor-sharp, clean typography -->
                <clock:AnimatedTimeBlock Grid.Column="1"
                                         Text="{Binding FullDateString}"
                                         FontSize="{DynamicResource TypeHeaderFontSize}"
                                         FontWeight="{DynamicResource TypeHeaderFontWeight}"
                                         Foreground="{DynamicResource TextPrimaryBrush}"
                                         VerticalAlignment="Center"
                                         HorizontalAlignment="Right"
                                         TextAlignment="Right"
                                         Margin="8,0,0,0" />
            </Grid>

            <!-- 3. Hero 4x4 / 6x4 / 8x4 Layout: Viewbox Centered Typography with Micro-Motion -->
            <Grid Visibility="{Binding IsHero, Converter={StaticResource BoolToVis}}">
                <Grid.RowDefinitions>
                    <RowDefinition Height="*" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>

                <!-- Time Row: Uniform Viewbox scaling eliminates all clipping across any font -->
                <Viewbox Grid.Row="0"
                         Stretch="Uniform"
                         HorizontalAlignment="Center"
                         VerticalAlignment="Center"
                         Margin="0,2,0,2">
                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" VerticalAlignment="Center">
                        <clock:AnimatedTimeBlock Text="{Binding HoursString}"
                                                 EnableTextDepth="True"
                                                 FontSize="{DynamicResource TypeHeroCoordinateFontSize}"
                                                 FontWeight="{Binding ClockFontWeight}"
                                                 FontFamily="{Binding ClockFontFamily}"
                                                 Foreground="{DynamicResource TextPrimaryBrush}"
                                                 VerticalAlignment="Center"
                                                 TextAlignment="Center" />
                        <TextBlock Text=":"
                                   FontSize="{DynamicResource TypeHeroCoordinateFontSize}"
                                   FontWeight="{Binding ClockFontWeight}"
                                   FontFamily="{Binding ClockFontFamily}"
                                   Foreground="{DynamicResource TextPrimaryBrush}"
                                   VerticalAlignment="Center"
                                   Typography.NumeralAlignment="Tabular"
                                   Typography.NumeralStyle="Normal"
                                   TextOptions.TextFormattingMode="Ideal"
                                   TextOptions.TextRenderingMode="ClearType"
                                   TextOptions.TextHintingMode="Animated">
                            <TextBlock.Effect>
                                <StaticResource ResourceKey="StudioGlassTextShadow" />
                            </TextBlock.Effect>
                        </TextBlock>
                        <clock:AnimatedTimeBlock Text="{Binding MinutesString}"
                                                 EnableTextDepth="True"
                                                 FontSize="{DynamicResource TypeHeroCoordinateFontSize}"
                                                 FontWeight="{Binding ClockFontWeight}"
                                                 FontFamily="{Binding ClockFontFamily}"
                                                 Foreground="{DynamicResource TextPrimaryBrush}"
                                                 VerticalAlignment="Center"
                                                 TextAlignment="Center" />
                    </StackPanel>
                </Viewbox>

                <!-- Full Date - Crisp, zero shadow -->
                <clock:AnimatedTimeBlock Grid.Row="1"
                                         Text="{Binding FullDateString}"
                                         FontSize="{DynamicResource TypeHeaderFontSize}"
                                         FontWeight="{DynamicResource TypeHeaderFontWeight}"
                                         Foreground="{DynamicResource TextPrimaryBrush}"
                                         HorizontalAlignment="Center"
                                         TextAlignment="Center"
                                         Margin="0,4,0,8" />
            </Grid>
        </Grid>
    </widgets:WidgetCard>
</UserControl>
