<UserControl x:Class="MetroHub.Widgets.Catalog.Clock.ClockWidgetView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:clock="clr-namespace:MetroHub.Widgets.Catalog.Clock"
             xmlns:widgets="clr-namespace:MetroHub.Widgets"
             mc:Ignorable="d" 
             d:DataContext="{d:DesignInstance Type=clock:ClockWidgetViewModel}"
             Focusable="False"
             SnapsToDevicePixels="True"
             UseLayoutRounding="True"
             TextOptions.TextFormattingMode="Ideal"
             TextOptions.TextRenderingMode="Grayscale"
             TextOptions.TextHintingMode="Animated">

    <UserControl.Resources>
        <BooleanToVisibilityConverter x:Key="BoolToVis" />
    </UserControl.Resources>

    <widgets:WidgetCard Padding="8,4">
        <Grid SnapsToDevicePixels="True" UseLayoutRounding="True">
            <!-- 1. Wide 4x2 Layout: Time Centered (No AM/PM, No Date) with Micro-Motion -->
            <Grid Visibility="{Binding IsWideOnly, Converter={StaticResource BoolToVis}}"
                  VerticalAlignment="Center" HorizontalAlignment="Center">
                <clock:AnimatedTimeBlock Text="{Binding TimeString}"
                                         FontSize="68"
                                         FontWeight="{Binding ClockFontWeight}"
                                         FontFamily="{Binding ClockFontFamily}"
                                         Foreground="#FFFFFF"
                                         HorizontalAlignment="Center"
                                         VerticalAlignment="Center" />
            </Grid>

            <!-- 2. Banner 8x2 Layout: Time on Left, Full Date on Right with Micro-Motion -->
            <Grid Visibility="{Binding IsBanner, Converter={StaticResource BoolToVis}}"
                  VerticalAlignment="Center" Margin="16,0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>

                <!-- Time -->
                <clock:AnimatedTimeBlock Grid.Column="0"
                                         Text="{Binding TimeString}"
                                         FontSize="68"
                                         FontWeight="{Binding ClockFontWeight}"
                                         FontFamily="{Binding ClockFontFamily}"
                                         Foreground="#FFFFFF"
                                         VerticalAlignment="Center" />

                <!-- Full Date (e.g. Friday, 11 September) -->
                <clock:AnimatedTimeBlock Grid.Column="1"
                                         Text="{Binding FullDateString}"
                                         FontSize="22"
                                         FontWeight="SemiBold"
                                         FontFamily="Segoe UI Variable Text, Segoe UI Variable, Segoe UI, sans-serif"
                                         Foreground="#E0FFFFFF"
                                         VerticalAlignment="Center"
                                         HorizontalAlignment="Right"
                                         TextAlignment="Right" />
            </Grid>

            <!-- 3. Hero 4x4 / 6x4 / 8x4 Layout: Massive Centered Typography with Micro-Motion -->
            <Grid Visibility="{Binding IsHero, Converter={StaticResource BoolToVis}}"
                  VerticalAlignment="Center" HorizontalAlignment="Center">
                <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center">
                    <clock:AnimatedTimeBlock Text="{Binding TimeString}"
                                             FontSize="84"
                                             FontWeight="{Binding ClockFontWeight}"
                                             FontFamily="{Binding ClockFontFamily}"
                                             Foreground="#FFFFFF"
                                             HorizontalAlignment="Center"
                                             VerticalAlignment="Center" />

                    <!-- Full Date -->
                    <clock:AnimatedTimeBlock Text="{Binding FullDateString}"
                                             FontSize="20"
                                             FontWeight="SemiBold"
                                             FontFamily="Segoe UI Variable Text, Segoe UI Variable, Segoe UI, sans-serif"
                                             Foreground="#E0FFFFFF"
                                             HorizontalAlignment="Center"
                                             Margin="0,10,0,0" />
                </StackPanel>
            </Grid>
        </Grid>
    </widgets:WidgetCard>
</UserControl>
