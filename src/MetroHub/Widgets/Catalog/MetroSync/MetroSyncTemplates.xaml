<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
                    xmlns:models="clr-namespace:MetroHub.Widgets.Catalog.MetroSync.Models"
                    xmlns:controls="clr-namespace:MetroHub.Widgets.Catalog.MetroSync.Controls">

    <!-- ========================================================================= -->
    <!-- METROSYNC DATA TEMPLATES (§8.1 & §8.2)                                    -->
    <!-- Telegram Desktop Authentic Bubble Layout Pipeline                         -->
    <!-- ========================================================================= -->

    <!-- 1. Text & Link Payload Template -->
    <DataTemplate DataType="{x:Type models:TextPayloadItem}">
        <Grid HorizontalAlignment="Stretch" Margin="0,3,0,3" Tag="InteractiveControl">
            <Border BorderThickness="1"
                    Padding="10,6,10,6"
                    MaxWidth="340"
                    Tag="{Binding DataContext, RelativeSource={RelativeSource AncestorType=UserControl}}">
                <Border.Style>
                    <Style TargetType="Border">
                        <Setter Property="HorizontalAlignment" Value="Left" />
                        <Setter Property="Margin" Value="0,0,40,0" />
                        <Setter Property="Background" Value="{DynamicResource SurfaceGlassBrush}" />
                        <Setter Property="BorderBrush" Value="{DynamicResource SurfaceBorderSubtleBrush}" />
                        <Setter Property="CornerRadius" Value="{DynamicResource ControlCornerRadius}" />
                        <Style.Triggers>
                            <DataTrigger Binding="{Binding IsOutgoing}" Value="True">
                                <Setter Property="HorizontalAlignment" Value="Right" />
                                <Setter Property="Margin" Value="40,0,0,0" />
                                <Setter Property="Background" Value="{DynamicResource SurfaceGlassSubtleBrush}" />
                                <Setter Property="BorderBrush" Value="{DynamicResource SurfaceBorderBrush}" />
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </Border.Style>

                <Border.ContextMenu>
                    <ContextMenu>
                        <MenuItem Header="Open link"
                                  Command="{Binding PlacementTarget.Tag.OpenLinkCommand, RelativeSource={RelativeSource AncestorType=ContextMenu}}"
                                  CommandParameter="{Binding PlacementTarget.DataContext, RelativeSource={RelativeSource AncestorType=ContextMenu}}"
                                  Visibility="{Binding PlacementTarget.DataContext.HasUrl, RelativeSource={RelativeSource AncestorType=ContextMenu}, Converter={StaticResource BoolToVis}}">
                            <MenuItem.Icon>
                                <ui:SymbolIcon Symbol="Open24" FontSize="16" />
                            </MenuItem.Icon>
                        </MenuItem>
                        <MenuItem Header="Copy link"
                                  Command="{Binding PlacementTarget.Tag.CopyLinkCommand, RelativeSource={RelativeSource AncestorType=ContextMenu}}"
                                  CommandParameter="{Binding PlacementTarget.DataContext, RelativeSource={RelativeSource AncestorType=ContextMenu}}"
                                  Visibility="{Binding PlacementTarget.DataContext.HasUrl, RelativeSource={RelativeSource AncestorType=ContextMenu}, Converter={StaticResource BoolToVis}}">
                            <MenuItem.Icon>
                                <ui:SymbolIcon Symbol="Link24" FontSize="16" />
                            </MenuItem.Icon>
                        </MenuItem>
                        <MenuItem Header="Copy text"
                                  Command="{Binding PlacementTarget.Tag.CopyTextCommand, RelativeSource={RelativeSource AncestorType=ContextMenu}}"
                                  CommandParameter="{Binding PlacementTarget.DataContext, RelativeSource={RelativeSource AncestorType=ContextMenu}}">
                            <MenuItem.Icon>
                                <ui:SymbolIcon Symbol="Copy24" FontSize="16" />
                            </MenuItem.Icon>
                        </MenuItem>
                    </ContextMenu>
                </Border.ContextMenu>

                <!-- Telegram Desktop Inline / Trailing Bubble Panel -->
                <controls:MetroSyncBubblePanel Tag="InteractiveControl">
                    <!-- Content Container (Favicon + Selectable Text) -->
                    <Grid VerticalAlignment="Center" Tag="InteractiveControl">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>

                        <!-- Web Favicon Badge (Visible only on messages with links) -->
                        <Border Grid.Column="0"
                                Width="18" Height="18"
                                CornerRadius="3"
                                Margin="0,0,8,0"
                                VerticalAlignment="Center"
                                Visibility="{Binding HasUrl, Converter={StaticResource BoolToVis}}"
                                Background="Transparent"
                                IsHitTestVisible="False">
                            <Grid>
                                <!-- Fallback Symbol Icon while FaviconImage is null -->
                                <ui:SymbolIcon Symbol="Globe24"
                                               FontSize="14"
                                               Foreground="{DynamicResource TextSubtleBrush}"
                                               HorizontalAlignment="Center"
                                               VerticalAlignment="Center">
                                    <ui:SymbolIcon.Style>
                                        <Style TargetType="ui:SymbolIcon">
                                            <Setter Property="Visibility" Value="Collapsed" />
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding FaviconImage}" Value="{x:Null}">
                                                    <Setter Property="Visibility" Value="Visible" />
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </ui:SymbolIcon.Style>
                                </ui:SymbolIcon>

                                <!-- High-res Favicon Image -->
                                <Image Source="{Binding FaviconImage}"
                                       Width="18" Height="18"
                                       Stretch="Uniform"
                                       RenderOptions.BitmapScalingMode="HighQuality">
                                    <Image.Style>
                                        <Style TargetType="Image">
                                            <Setter Property="Visibility" Value="Visible" />
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding FaviconImage}" Value="{x:Null}">
                                                    <Setter Property="Visibility" Value="Collapsed" />
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </Image.Style>
                                </Image>
                            </Grid>
                        </Border>

                        <!-- Selectable Message Text with Clickable Hover-Underline Links -->
                        <controls:MetroSyncSelectableTextBlock Grid.Column="1"
                                                               Text="{Binding Text}"
                                                               LinkCommand="{Binding DataContext.OpenLinkCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                               LinkCommandParameter="{Binding}"
                                                               FontSize="{DynamicResource TypeBodyFontSize}"
                                                               FontFamily="{DynamicResource AppFontFamily}"
                                                               Foreground="{DynamicResource TextPrimaryBrush}"
                                                               VerticalAlignment="Center"
                                                               Tag="InteractiveControl" />
                    </Grid>

                    <!-- Inline / Bottom-Right Timestamp -->
                    <TextBlock Text="{Binding TimeDisplay}"
                               FontSize="10"
                               Foreground="{DynamicResource TextSubtleBrush}"
                               Opacity="0.75"
                               VerticalAlignment="Bottom"
                               IsHitTestVisible="False" />
                </controls:MetroSyncBubblePanel>
            </Border>
        </Grid>
    </DataTemplate>

    <!-- 2. Image Payload Template -->
    <DataTemplate DataType="{x:Type models:ImagePayloadItem}">
        <Grid HorizontalAlignment="Stretch" Margin="0,3,0,3" Tag="InteractiveControl">
            <Border BorderThickness="1"
                    Padding="4"
                    MaxWidth="340"
                    Tag="{Binding DataContext, RelativeSource={RelativeSource AncestorType=UserControl}}">
                <Border.Style>
                    <Style TargetType="Border">
                        <Setter Property="HorizontalAlignment" Value="Left" />
                        <Setter Property="Margin" Value="0,0,40,0" />
                        <Setter Property="Background" Value="{DynamicResource SurfaceGlassBrush}" />
                        <Setter Property="BorderBrush" Value="{DynamicResource SurfaceBorderSubtleBrush}" />
                        <Setter Property="CornerRadius" Value="{DynamicResource ControlCornerRadius}" />
                        <Style.Triggers>
                            <DataTrigger Binding="{Binding IsOutgoing}" Value="True">
                                <Setter Property="HorizontalAlignment" Value="Right" />
                                <Setter Property="Margin" Value="40,0,0,0" />
                                <Setter Property="Background" Value="{DynamicResource SurfaceGlassSubtleBrush}" />
                                <Setter Property="BorderBrush" Value="{DynamicResource SurfaceBorderBrush}" />
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </Border.Style>

                <Border.ContextMenu>
                    <ContextMenu>
                        <MenuItem Header="Open"
                                  Command="{Binding PlacementTarget.Tag.OpenFileCommand, RelativeSource={RelativeSource AncestorType=ContextMenu}}"
                                  CommandParameter="{Binding PlacementTarget.DataContext, RelativeSource={RelativeSource AncestorType=ContextMenu}}">
                            <MenuItem.Icon>
                                <ui:SymbolIcon Symbol="Open24" FontSize="16" />
                            </MenuItem.Icon>
                        </MenuItem>
                        <MenuItem Header="Save as..."
                                  Command="{Binding PlacementTarget.Tag.SaveFileAsCommand, RelativeSource={RelativeSource AncestorType=ContextMenu}}"
                                  CommandParameter="{Binding PlacementTarget.DataContext, RelativeSource={RelativeSource AncestorType=ContextMenu}}">
                            <MenuItem.Icon>
                                <ui:SymbolIcon Symbol="ArrowDownload24" FontSize="16" />
                            </MenuItem.Icon>
                        </MenuItem>
                        <MenuItem Header="Copy image"
                                  Command="{Binding PlacementTarget.Tag.CopyImageCommand, RelativeSource={RelativeSource AncestorType=ContextMenu}}"
                                  CommandParameter="{Binding PlacementTarget.DataContext, RelativeSource={RelativeSource AncestorType=ContextMenu}}">
                            <MenuItem.Icon>
                                <ui:SymbolIcon Symbol="Copy24" FontSize="16" />
                            </MenuItem.Icon>
                        </MenuItem>
                        <MenuItem Header="Copy caption"
                                  Command="{Binding PlacementTarget.Tag.CopyTextCommand, RelativeSource={RelativeSource AncestorType=ContextMenu}}"
                                  CommandParameter="{Binding PlacementTarget.DataContext.Caption, RelativeSource={RelativeSource AncestorType=ContextMenu}}"
                                  Visibility="{Binding PlacementTarget.DataContext.HasCaption, RelativeSource={RelativeSource AncestorType=ContextMenu}, Converter={StaticResource BoolToVis}}">
                            <MenuItem.Icon>
                                <ui:SymbolIcon Symbol="Document24" FontSize="16" />
                            </MenuItem.Icon>
                        </MenuItem>
                    </ContextMenu>
                </Border.ContextMenu>

                <StackPanel Tag="InteractiveControl">
                    <!-- Responsive Aspect Ratio Thumbnail Card -->
                    <Button Command="{Binding DataContext.OpenFileCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                            CommandParameter="{Binding}"
                            Cursor="Hand"
                            Background="Transparent"
                            BorderThickness="0"
                            Padding="0"
                            HorizontalContentAlignment="Stretch"
                            VerticalContentAlignment="Stretch">
                        <Button.Template>
                            <ControlTemplate TargetType="Button">
                                <Border x:Name="ThumbnailRoot"
                                        CornerRadius="{DynamicResource ControlCornerRadius}"
                                        ClipToBounds="True"
                                        Background="{DynamicResource SurfaceGlassSubtleBrush}">
                                    <Grid MinHeight="80" MaxHeight="260">
                                        <!-- Image content with true aspect ratio -->
                                        <Image Source="{Binding ThumbnailImage}"
                                               Stretch="Uniform"
                                               HorizontalAlignment="Center"
                                               VerticalAlignment="Center"
                                               RenderOptions.BitmapScalingMode="HighQuality" />

                                        <!-- Placeholder when no image loaded -->
                                        <Grid Height="120" Width="180">
                                            <Grid.Style>
                                                <Style TargetType="Grid">
                                                    <Setter Property="Visibility" Value="Collapsed" />
                                                    <Style.Triggers>
                                                        <DataTrigger Binding="{Binding ThumbnailImage}" Value="{x:Null}">
                                                            <Setter Property="Visibility" Value="Visible" />
                                                        </DataTrigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </Grid.Style>
                                            <ui:SymbolIcon Symbol="Image24"
                                                           FontSize="32"
                                                           Foreground="{DynamicResource TextSecondaryBrush}"
                                                           HorizontalAlignment="Center"
                                                           VerticalAlignment="Center" />
                                        </Grid>

                                        <!-- Centered Downloading Progress Overlay -->
                                        <Border Width="36" Height="36"
                                                CornerRadius="18"
                                                Background="#B0000000"
                                                HorizontalAlignment="Center"
                                                VerticalAlignment="Center"
                                                Visibility="{Binding IsDownloading, Converter={StaticResource BoolToVis}}"
                                                IsHitTestVisible="False">
                                            <ui:ProgressRing Width="20" Height="20"
                                                             Foreground="{DynamicResource TextPrimaryBrush}"
                                                             IsIndeterminate="{Binding IsDownloading}"
                                                             HorizontalAlignment="Center"
                                                             VerticalAlignment="Center" />
                                        </Border>

                                        <!-- Telegram-Style Floating Translucent Timestamp Badge (Visible when no caption) -->
                                        <Border HorizontalAlignment="Right"
                                                VerticalAlignment="Bottom"
                                                Margin="0,0,6,6"
                                                Background="#80000000"
                                                CornerRadius="{DynamicResource ControlCornerRadius}"
                                                Padding="6,2"
                                                IsHitTestVisible="False">
                                            <Border.Style>
                                                <Style TargetType="Border">
                                                    <Setter Property="Visibility" Value="Visible" />
                                                    <Style.Triggers>
                                                        <DataTrigger Binding="{Binding HasCaption}" Value="True">
                                                            <Setter Property="Visibility" Value="Collapsed" />
                                                        </DataTrigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </Border.Style>
                                            <TextBlock Text="{Binding TimeDisplay}"
                                                       FontSize="10"
                                                       FontWeight="Medium"
                                                       Foreground="#FFFFFF" />
                                        </Border>
                                    </Grid>
                                </Border>
                                <ControlTemplate.Triggers>
                                    <Trigger Property="IsMouseOver" Value="True">
                                        <Setter TargetName="ThumbnailRoot" Property="Opacity" Value="0.90" />
                                    </Trigger>
                                    <Trigger Property="IsPressed" Value="True">
                                        <Setter TargetName="ThumbnailRoot" Property="Opacity" Value="0.78" />
                                    </Trigger>
                                </ControlTemplate.Triggers>
                            </ControlTemplate>
                        </Button.Template>
                    </Button>

                    <!-- Caption Section (Visible only when caption is present) -->
                    <Border Padding="6,6,6,2"
                            Visibility="{Binding HasCaption, Converter={StaticResource BoolToVis}}"
                            Tag="InteractiveControl">
                        <controls:MetroSyncBubblePanel Tag="InteractiveControl">
                            <controls:MetroSyncSelectableTextBlock Text="{Binding Caption}"
                                                                   LinkCommand="{Binding DataContext.OpenLinkCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                                   LinkCommandParameter="{Binding}"
                                                                   FontSize="{DynamicResource TypeBodyFontSize}"
                                                                   FontFamily="{DynamicResource AppFontFamily}"
                                                                   Foreground="{DynamicResource TextPrimaryBrush}"
                                                                   Tag="InteractiveControl" />

                            <TextBlock Text="{Binding TimeDisplay}"
                                       FontSize="10"
                                       Foreground="{DynamicResource TextSubtleBrush}"
                                       Opacity="0.75"
                                       VerticalAlignment="Bottom"
                                       IsHitTestVisible="False" />
                        </controls:MetroSyncBubblePanel>
                    </Border>
                </StackPanel>
            </Border>
        </Grid>
    </DataTemplate>

    <!-- 3. File, Audio, & Video Payload Template -->
    <DataTemplate DataType="{x:Type models:FilePayloadItem}">
        <Grid HorizontalAlignment="Stretch" Margin="0,3,0,3" Tag="InteractiveControl">
            <Border BorderThickness="1"
                    Padding="10,6,10,6"
                    MaxWidth="340"
                    Tag="{Binding DataContext, RelativeSource={RelativeSource AncestorType=UserControl}}">
                <Border.Style>
                    <Style TargetType="Border">
                        <Setter Property="HorizontalAlignment" Value="Left" />
                        <Setter Property="Margin" Value="0,0,40,0" />
                        <Setter Property="Background" Value="{DynamicResource SurfaceGlassBrush}" />
                        <Setter Property="BorderBrush" Value="{DynamicResource SurfaceBorderSubtleBrush}" />
                        <Setter Property="CornerRadius" Value="{DynamicResource ControlCornerRadius}" />
                        <Style.Triggers>
                            <DataTrigger Binding="{Binding IsOutgoing}" Value="True">
                                <Setter Property="HorizontalAlignment" Value="Right" />
                                <Setter Property="Margin" Value="40,0,0,0" />
                                <Setter Property="Background" Value="{DynamicResource SurfaceGlassSubtleBrush}" />
                                <Setter Property="BorderBrush" Value="{DynamicResource SurfaceBorderBrush}" />
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </Border.Style>

                <Border.ContextMenu>
                    <ContextMenu>
                        <MenuItem Header="Open"
                                  Command="{Binding PlacementTarget.Tag.OpenFileCommand, RelativeSource={RelativeSource AncestorType=ContextMenu}}"
                                  CommandParameter="{Binding PlacementTarget.DataContext, RelativeSource={RelativeSource AncestorType=ContextMenu}}"
                                  IsEnabled="{Binding PlacementTarget.DataContext.IsDownloaded, RelativeSource={RelativeSource AncestorType=ContextMenu}}">
                            <MenuItem.Icon>
                                <ui:SymbolIcon Symbol="Open24" FontSize="16" />
                            </MenuItem.Icon>
                        </MenuItem>
                        <MenuItem Header="Show in folder"
                                  Command="{Binding PlacementTarget.Tag.ShowInFolderCommand, RelativeSource={RelativeSource AncestorType=ContextMenu}}"
                                  CommandParameter="{Binding PlacementTarget.DataContext, RelativeSource={RelativeSource AncestorType=ContextMenu}}"
                                  IsEnabled="{Binding PlacementTarget.DataContext.IsDownloaded, RelativeSource={RelativeSource AncestorType=ContextMenu}}">
                            <MenuItem.Icon>
                                <ui:SymbolIcon Symbol="FolderOpen24" FontSize="16" />
                            </MenuItem.Icon>
                        </MenuItem>
                        <MenuItem Header="Save as..."
                                  Command="{Binding PlacementTarget.Tag.SaveFileAsCommand, RelativeSource={RelativeSource AncestorType=ContextMenu}}"
                                  CommandParameter="{Binding PlacementTarget.DataContext, RelativeSource={RelativeSource AncestorType=ContextMenu}}">
                            <MenuItem.Icon>
                                <ui:SymbolIcon Symbol="ArrowDownload24" FontSize="16" />
                            </MenuItem.Icon>
                        </MenuItem>
                        <MenuItem Header="Copy file name"
                                  Command="{Binding PlacementTarget.Tag.CopyTextCommand, RelativeSource={RelativeSource AncestorType=ContextMenu}}"
                                  CommandParameter="{Binding PlacementTarget.DataContext.FileName, RelativeSource={RelativeSource AncestorType=ContextMenu}}">
                            <MenuItem.Icon>
                                <ui:SymbolIcon Symbol="Copy24" FontSize="16" />
                            </MenuItem.Icon>
                        </MenuItem>
                    </ContextMenu>
                </Border.ContextMenu>

                <!-- In-bubble action: Card click initiates download or opens file -->
                <Button Command="{Binding DataContext.OpenOrDownloadFileCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                        CommandParameter="{Binding}"
                        Cursor="Hand"
                        Background="Transparent"
                        BorderThickness="0"
                        Padding="0"
                        HorizontalContentAlignment="Stretch"
                        VerticalContentAlignment="Stretch"
                        Tag="InteractiveControl">
                    <Button.Template>
                        <ControlTemplate TargetType="Button">
                            <Grid x:Name="CardRoot" VerticalAlignment="Center">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>

                                <!-- Left 36x36 circular action button -->
                                <Border Grid.Column="0"
                                        Width="36" Height="36"
                                        CornerRadius="18"
                                        Background="{DynamicResource SurfaceGlassSubtleBrush}"
                                        BorderBrush="{DynamicResource SurfaceBorderBrush}"
                                        BorderThickness="1"
                                        Margin="0,0,10,0"
                                        VerticalAlignment="Center">
                                    <Grid HorizontalAlignment="Center" VerticalAlignment="Center">
                                        <!-- State 1: Download arrow icon (when not downloaded and not downloading) -->
                                        <ui:SymbolIcon Symbol="ArrowDownload24"
                                                       FontSize="16"
                                                       Foreground="{DynamicResource TextPrimaryBrush}"
                                                       HorizontalAlignment="Center"
                                                       VerticalAlignment="Center"
                                                       UseLayoutRounding="True">
                                            <ui:SymbolIcon.Style>
                                                <Style TargetType="ui:SymbolIcon">
                                                    <Setter Property="Visibility" Value="Visible" />
                                                    <Style.Triggers>
                                                        <DataTrigger Binding="{Binding IsDownloaded}" Value="True">
                                                            <Setter Property="Visibility" Value="Collapsed" />
                                                        </DataTrigger>
                                                        <DataTrigger Binding="{Binding IsDownloading}" Value="True">
                                                            <Setter Property="Visibility" Value="Collapsed" />
                                                        </DataTrigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </ui:SymbolIcon.Style>
                                        </ui:SymbolIcon>

                                        <!-- State 2: Downloading ProgressRing -->
                                        <ui:ProgressRing Width="18" Height="18"
                                                         Foreground="{DynamicResource TextPrimaryBrush}"
                                                         IsIndeterminate="{Binding IsDownloading}"
                                                         Visibility="{Binding IsDownloading, Converter={StaticResource BoolToVis}}"
                                                         HorizontalAlignment="Center"
                                                         VerticalAlignment="Center" />

                                        <!-- State 3: Downloaded document icon -->
                                        <ui:SymbolIcon Symbol="Document24"
                                                       FontSize="16"
                                                       Foreground="{DynamicResource TextPrimaryBrush}"
                                                       HorizontalAlignment="Center"
                                                       VerticalAlignment="Center"
                                                       UseLayoutRounding="True">
                                            <ui:SymbolIcon.Style>
                                                <Style TargetType="ui:SymbolIcon">
                                                    <Setter Property="Visibility" Value="Collapsed" />
                                                    <Style.Triggers>
                                                        <DataTrigger Binding="{Binding IsDownloaded}" Value="True">
                                                            <Setter Property="Visibility" Value="Visible" />
                                                        </DataTrigger>
                                                        <DataTrigger Binding="{Binding IsDownloading}" Value="True">
                                                            <Setter Property="Visibility" Value="Collapsed" />
                                                        </DataTrigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </ui:SymbolIcon.Style>
                                        </ui:SymbolIcon>
                                    </Grid>
                                </Border>

                                <!-- Middle column: File name and file size / timestamp on one line -->
                                <Grid Grid.Column="1" VerticalAlignment="Center">
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="Auto" />
                                        <RowDefinition Height="Auto" />
                                        <RowDefinition Height="Auto" />
                                    </Grid.RowDefinitions>

                                    <!-- Row 0: File Name -->
                                    <TextBlock Grid.Row="0"
                                               Text="{Binding FileName}"
                                               FontWeight="{DynamicResource TypeBodyStrongFontWeight}"
                                               FontSize="{DynamicResource TypeBodyFontSize}"
                                               Foreground="{DynamicResource TextPrimaryBrush}"
                                               TextTrimming="CharacterEllipsis" />

                                    <!-- Row 1: File Size (Column 0) and Timestamp (Column 1) -->
                                    <Grid Grid.Row="1" Margin="0,3,0,0">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="Auto" />
                                        </Grid.ColumnDefinitions>

                                        <TextBlock Grid.Column="0"
                                                   Text="{Binding FileSizeDisplay}"
                                                   FontSize="{DynamicResource TypeCaptionFontSize}"
                                                   Foreground="{DynamicResource TextSecondaryBrush}"
                                                   Margin="0,0,12,0"
                                                   TextTrimming="CharacterEllipsis"
                                                   VerticalAlignment="Center" />

                                        <TextBlock Grid.Column="1"
                                                   Text="{Binding TimeDisplay}"
                                                   FontSize="10"
                                                   Foreground="{DynamicResource TextSubtleBrush}"
                                                   Opacity="0.75"
                                                   VerticalAlignment="Center"
                                                   IsHitTestVisible="False" />
                                    </Grid>

                                    <!-- Row 2: Error message if download failed or too large -->
                                    <TextBlock Grid.Row="2"
                                               Text="{Binding ErrorMessage}"
                                               FontSize="{DynamicResource TypeCaptionFontSize}"
                                               Foreground="{DynamicResource StatusErrorBrush}"
                                               TextWrapping="Wrap"
                                               TextTrimming="CharacterEllipsis"
                                               Margin="0,2,0,0">
                                        <TextBlock.Style>
                                            <Style TargetType="TextBlock">
                                                <Setter Property="Visibility" Value="Collapsed" />
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding HasError}" Value="True">
                                                        <Setter Property="Visibility" Value="Visible" />
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </TextBlock.Style>
                                    </TextBlock>
                                </Grid>
                            </Grid>
                            <ControlTemplate.Triggers>
                                <Trigger Property="IsMouseOver" Value="True">
                                    <Setter TargetName="CardRoot" Property="Opacity" Value="0.90" />
                                </Trigger>
                                <Trigger Property="IsPressed" Value="True">
                                    <Setter TargetName="CardRoot" Property="Opacity" Value="0.78" />
                                </Trigger>
                            </ControlTemplate.Triggers>
                        </ControlTemplate>
                    </Button.Template>
                </Button>
            </Border>
        </Grid>
    </DataTemplate>

</ResourceDictionary>
