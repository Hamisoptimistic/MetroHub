<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
                    xmlns:models="clr-namespace:MetroHub.Widgets.Catalog.MetroSync.Models">

    <!-- ========================================================================= -->
    <!-- METROSYNC DATA TEMPLATES (§8.1 & §8.2)                                    -->
    <!-- Decoupled Action Pipeline & Context Menu Templates                        -->
    <!-- ========================================================================= -->

    <!-- 1. Text & Link Payload Template -->
    <DataTemplate DataType="{x:Type models:TextPayloadItem}">
        <Grid HorizontalAlignment="Stretch" Margin="0,3,0,3">
            <Border CornerRadius="{DynamicResource ControlCornerRadius}"
                    BorderThickness="1"
                    Padding="12,8"
                    MaxWidth="380"
                    Tag="{Binding DataContext, RelativeSource={RelativeSource AncestorType=UserControl}}">
                <Border.Style>
                    <Style TargetType="Border">
                        <Setter Property="HorizontalAlignment" Value="Left" />
                        <Setter Property="Background" Value="{DynamicResource SurfaceGlassBrush}" />
                        <Setter Property="BorderBrush" Value="{DynamicResource SurfaceBorderSubtleBrush}" />
                        <Style.Triggers>
                            <DataTrigger Binding="{Binding IsOutgoing}" Value="True">
                                <Setter Property="HorizontalAlignment" Value="Right" />
                                <Setter Property="Background" Value="{DynamicResource FluentPressedBrush}" />
                                <Setter Property="BorderBrush" Value="{DynamicResource SurfaceBorderBrush}" />
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </Border.Style>

                <Border.ContextMenu>
                    <ContextMenu>
                        <MenuItem Header="Open link"
                                  Command="{Binding PlacementTarget.Tag.OpenLinkCommand, RelativeSource={RelativeSource AncestorType=ContextMenu}}"
                                  CommandParameter="{Binding PlacementTarget.DataContext, RelativeSource={RelativeSource AncestorType=ContextMenu}}"
                                  Visibility="{Binding PlacementTarget.DataContext.HasUrl, RelativeSource={RelativeSource AncestorType=ContextMenu}, Converter={StaticResource BoolToVis}}">
                            <MenuItem.Icon>
                                <ui:SymbolIcon Symbol="Open24" FontSize="16" />
                            </MenuItem.Icon>
                        </MenuItem>
                        <MenuItem Header="Copy link"
                                  Command="{Binding PlacementTarget.Tag.CopyLinkCommand, RelativeSource={RelativeSource AncestorType=ContextMenu}}"
                                  CommandParameter="{Binding PlacementTarget.DataContext, RelativeSource={RelativeSource AncestorType=ContextMenu}}"
                                  Visibility="{Binding PlacementTarget.DataContext.HasUrl, RelativeSource={RelativeSource AncestorType=ContextMenu}, Converter={StaticResource BoolToVis}}">
                            <MenuItem.Icon>
                                <ui:SymbolIcon Symbol="Link24" FontSize="16" />
                            </MenuItem.Icon>
                        </MenuItem>
                        <MenuItem Header="Copy text"
                                  Command="{Binding PlacementTarget.Tag.CopyTextCommand, RelativeSource={RelativeSource AncestorType=ContextMenu}}"
                                  CommandParameter="{Binding PlacementTarget.DataContext, RelativeSource={RelativeSource AncestorType=ContextMenu}}">
                            <MenuItem.Icon>
                                <ui:SymbolIcon Symbol="Copy24" FontSize="16" />
                            </MenuItem.Icon>
                        </MenuItem>
                    </ContextMenu>
                </Border.ContextMenu>

                <Grid>
                    <!-- Link Text Button (Active when HasUrl == True) -->
                    <Button Command="{Binding DataContext.OpenLinkCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                            CommandParameter="{Binding}"
                            Visibility="{Binding HasUrl, Converter={StaticResource BoolToVis}}"
                            Cursor="Hand"
                            ToolTip="{Binding FirstUrl}"
                            Background="Transparent"
                            BorderThickness="0"
                            Padding="0"
                            HorizontalAlignment="Left"
                            HorizontalContentAlignment="Left">
                        <Button.Template>
                            <ControlTemplate TargetType="Button">
                                <TextBlock Text="{Binding Text}"
                                           TextWrapping="Wrap"
                                           FontSize="{DynamicResource TypeBodyFontSize}"
                                           FontWeight="{DynamicResource TypeBodyFontWeight}"
                                           Foreground="{DynamicResource SystemAccentColorPrimaryBrush}"
                                           VerticalAlignment="Center" />
                            </ControlTemplate>
                        </Button.Template>
                    </Button>

                    <!-- Plain Text (Active when HasUrl == False) -->
                    <TextBlock Text="{Binding Text}"
                               TextWrapping="Wrap"
                               FontSize="{DynamicResource TypeBodyFontSize}"
                               FontWeight="{DynamicResource TypeBodyFontWeight}"
                               Foreground="{DynamicResource TextPrimaryBrush}"
                               VerticalAlignment="Center">
                        <TextBlock.Style>
                            <Style TargetType="TextBlock">
                                <Setter Property="Visibility" Value="Visible" />
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding HasUrl}" Value="True">
                                        <Setter Property="Visibility" Value="Collapsed" />
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </TextBlock.Style>
                    </TextBlock>
                </Grid>
            </Border>
        </Grid>
    </DataTemplate>

    <!-- 2. Image Payload Template -->
    <DataTemplate DataType="{x:Type models:ImagePayloadItem}">
        <Grid HorizontalAlignment="Stretch" Margin="0,3,0,3">
            <Border CornerRadius="{DynamicResource ControlCornerRadius}"
                    BorderThickness="1"
                    Padding="8"
                    MaxWidth="380"
                    Tag="{Binding DataContext, RelativeSource={RelativeSource AncestorType=UserControl}}">
                <Border.Style>
                    <Style TargetType="Border">
                        <Setter Property="HorizontalAlignment" Value="Left" />
                        <Setter Property="Background" Value="{DynamicResource SurfaceGlassBrush}" />
                        <Setter Property="BorderBrush" Value="{DynamicResource SurfaceBorderSubtleBrush}" />
                        <Style.Triggers>
                            <DataTrigger Binding="{Binding IsOutgoing}" Value="True">
                                <Setter Property="HorizontalAlignment" Value="Right" />
                                <Setter Property="Background" Value="{DynamicResource FluentPressedBrush}" />
                                <Setter Property="BorderBrush" Value="{DynamicResource SurfaceBorderBrush}" />
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </Border.Style>

                <Border.ContextMenu>
                    <ContextMenu>
                        <MenuItem Header="Open"
                                  Command="{Binding PlacementTarget.Tag.OpenFileCommand, RelativeSource={RelativeSource AncestorType=ContextMenu}}"
                                  CommandParameter="{Binding PlacementTarget.DataContext, RelativeSource={RelativeSource AncestorType=ContextMenu}}">
                            <MenuItem.Icon>
                                <ui:SymbolIcon Symbol="Open24" FontSize="16" />
                            </MenuItem.Icon>
                        </MenuItem>
                        <MenuItem Header="Save as..."
                                  Command="{Binding PlacementTarget.Tag.SaveFileAsCommand, RelativeSource={RelativeSource AncestorType=ContextMenu}}"
                                  CommandParameter="{Binding PlacementTarget.DataContext, RelativeSource={RelativeSource AncestorType=ContextMenu}}">
                            <MenuItem.Icon>
                                <ui:SymbolIcon Symbol="ArrowDownload24" FontSize="16" />
                            </MenuItem.Icon>
                        </MenuItem>
                        <MenuItem Header="Copy image"
                                  Command="{Binding PlacementTarget.Tag.CopyImageCommand, RelativeSource={RelativeSource AncestorType=ContextMenu}}"
                                  CommandParameter="{Binding PlacementTarget.DataContext, RelativeSource={RelativeSource AncestorType=ContextMenu}}">
                            <MenuItem.Icon>
                                <ui:SymbolIcon Symbol="Copy24" FontSize="16" />
                            </MenuItem.Icon>
                        </MenuItem>
                        <MenuItem Header="Copy caption"
                                  Command="{Binding PlacementTarget.Tag.CopyTextCommand, RelativeSource={RelativeSource AncestorType=ContextMenu}}"
                                  CommandParameter="{Binding PlacementTarget.DataContext.Caption, RelativeSource={RelativeSource AncestorType=ContextMenu}}"
                                  Visibility="{Binding PlacementTarget.DataContext.HasCaption, RelativeSource={RelativeSource AncestorType=ContextMenu}, Converter={StaticResource BoolToVis}}">
                            <MenuItem.Icon>
                                <ui:SymbolIcon Symbol="Document24" FontSize="16" />
                            </MenuItem.Icon>
                        </MenuItem>
                    </ContextMenu>
                </Border.ContextMenu>

                <StackPanel>
                    <!-- Fixed-height thumbnail button (Left-click executes OpenFileCommand) -->
                    <Button Command="{Binding DataContext.OpenFileCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                            CommandParameter="{Binding}"
                            Cursor="Hand"
                            Background="Transparent"
                            BorderThickness="0"
                            Padding="0"
                            HorizontalContentAlignment="Stretch"
                            VerticalContentAlignment="Stretch">
                        <Button.Template>
                            <ControlTemplate TargetType="Button">
                                <Border Height="110"
                                        Background="{DynamicResource SurfaceGlassSubtleBrush}"
                                        CornerRadius="{DynamicResource ControlCornerRadius}"
                                        ClipToBounds="True">
                                    <Grid>
                                        <Image Source="{Binding ThumbnailImage}"
                                               Stretch="Uniform"
                                               HorizontalAlignment="Center"
                                               VerticalAlignment="Center"
                                               RenderOptions.BitmapScalingMode="HighQuality" />
                                        <ui:SymbolIcon Symbol="Image24"
                                                       FontSize="32"
                                                       Foreground="{DynamicResource TextSecondaryBrush}"
                                                       HorizontalAlignment="Center"
                                                       VerticalAlignment="Center">
                                            <ui:SymbolIcon.Style>
                                                <Style TargetType="ui:SymbolIcon">
                                                    <Setter Property="Visibility" Value="Collapsed" />
                                                    <Style.Triggers>
                                                        <DataTrigger Binding="{Binding ThumbnailImage}" Value="{x:Null}">
                                                            <Setter Property="Visibility" Value="Visible" />
                                                        </DataTrigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </ui:SymbolIcon.Style>
                                        </ui:SymbolIcon>
                                    </Grid>
                                </Border>
                            </ControlTemplate>
                        </Button.Template>
                    </Button>

                    <!-- Caption text beneath thumbnail (if present) -->
                    <TextBlock Text="{Binding Caption}"
                               TextWrapping="Wrap"
                               FontSize="{DynamicResource TypeCaptionFontSize}"
                               Foreground="{DynamicResource TextSecondaryBrush}"
                               Margin="0,6,0,0">
                        <TextBlock.Style>
                            <Style TargetType="TextBlock">
                                <Setter Property="Visibility" Value="Visible" />
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding Caption}" Value="{x:Null}">
                                        <Setter Property="Visibility" Value="Collapsed" />
                                    </DataTrigger>
                                    <DataTrigger Binding="{Binding Caption}" Value="">
                                        <Setter Property="Visibility" Value="Collapsed" />
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </TextBlock.Style>
                    </TextBlock>
                </StackPanel>
            </Border>
        </Grid>
    </DataTemplate>

    <!-- 3. File, Audio, & Video Payload Template -->
    <DataTemplate DataType="{x:Type models:FilePayloadItem}">
        <Grid HorizontalAlignment="Stretch" Margin="0,3,0,3">
            <Border CornerRadius="{DynamicResource ControlCornerRadius}"
                    BorderThickness="1"
                    Padding="10,8"
                    MaxWidth="380"
                    Tag="{Binding DataContext, RelativeSource={RelativeSource AncestorType=UserControl}}">
                <Border.Style>
                    <Style TargetType="Border">
                        <Setter Property="HorizontalAlignment" Value="Left" />
                        <Setter Property="Background" Value="{DynamicResource SurfaceGlassBrush}" />
                        <Setter Property="BorderBrush" Value="{DynamicResource SurfaceBorderSubtleBrush}" />
                        <Style.Triggers>
                            <DataTrigger Binding="{Binding IsOutgoing}" Value="True">
                                <Setter Property="HorizontalAlignment" Value="Right" />
                                <Setter Property="Background" Value="{DynamicResource FluentPressedBrush}" />
                                <Setter Property="BorderBrush" Value="{DynamicResource SurfaceBorderBrush}" />
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </Border.Style>

                <Border.ContextMenu>
                    <ContextMenu>
                        <MenuItem Header="Open"
                                  Command="{Binding PlacementTarget.Tag.OpenFileCommand, RelativeSource={RelativeSource AncestorType=ContextMenu}}"
                                  CommandParameter="{Binding PlacementTarget.DataContext, RelativeSource={RelativeSource AncestorType=ContextMenu}}"
                                  IsEnabled="{Binding PlacementTarget.DataContext.IsDownloaded, RelativeSource={RelativeSource AncestorType=ContextMenu}}">
                            <MenuItem.Icon>
                                <ui:SymbolIcon Symbol="Open24" FontSize="16" />
                            </MenuItem.Icon>
                        </MenuItem>
                        <MenuItem Header="Show in folder"
                                  Command="{Binding PlacementTarget.Tag.ShowInFolderCommand, RelativeSource={RelativeSource AncestorType=ContextMenu}}"
                                  CommandParameter="{Binding PlacementTarget.DataContext, RelativeSource={RelativeSource AncestorType=ContextMenu}}"
                                  IsEnabled="{Binding PlacementTarget.DataContext.IsDownloaded, RelativeSource={RelativeSource AncestorType=ContextMenu}}">
                            <MenuItem.Icon>
                                <ui:SymbolIcon Symbol="FolderOpen24" FontSize="16" />
                            </MenuItem.Icon>
                        </MenuItem>
                        <MenuItem Header="Save as..."
                                  Command="{Binding PlacementTarget.Tag.SaveFileAsCommand, RelativeSource={RelativeSource AncestorType=ContextMenu}}"
                                  CommandParameter="{Binding PlacementTarget.DataContext, RelativeSource={RelativeSource AncestorType=ContextMenu}}">
                            <MenuItem.Icon>
                                <ui:SymbolIcon Symbol="ArrowDownload24" FontSize="16" />
                            </MenuItem.Icon>
                        </MenuItem>
                        <MenuItem Header="Copy file name"
                                  Command="{Binding PlacementTarget.Tag.CopyTextCommand, RelativeSource={RelativeSource AncestorType=ContextMenu}}"
                                  CommandParameter="{Binding PlacementTarget.DataContext.FileName, RelativeSource={RelativeSource AncestorType=ContextMenu}}">
                            <MenuItem.Icon>
                                <ui:SymbolIcon Symbol="Copy24" FontSize="16" />
                            </MenuItem.Icon>
                        </MenuItem>
                    </ContextMenu>
                </Border.ContextMenu>

                <!-- In-bubble action: Card click initiates download or opens file -->
                <Button Command="{Binding DataContext.OpenOrDownloadFileCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                        CommandParameter="{Binding}"
                        Cursor="Hand"
                        Background="Transparent"
                        BorderThickness="0"
                        Padding="0"
                        HorizontalContentAlignment="Stretch"
                        VerticalContentAlignment="Stretch">
                    <Button.Template>
                        <ControlTemplate TargetType="Button">
                            <Grid VerticalAlignment="Center">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>

                                <!-- Left 32x32 circular action button -->
                                <Border Grid.Column="0"
                                        Width="32" Height="32"
                                        CornerRadius="16"
                                        Background="{DynamicResource SurfaceGlassSubtleBrush}"
                                        BorderBrush="{DynamicResource SurfaceBorderBrush}"
                                        BorderThickness="1"
                                        Margin="0,0,10,0"
                                        VerticalAlignment="Center">
                                    <Grid HorizontalAlignment="Center" VerticalAlignment="Center">
                                        <!-- State 1: Download arrow icon (when not downloaded and not downloading) -->
                                        <ui:SymbolIcon Symbol="ArrowDownload24"
                                                       FontSize="16"
                                                       Foreground="{DynamicResource SystemAccentColorPrimaryBrush}">
                                            <ui:SymbolIcon.Style>
                                                <Style TargetType="ui:SymbolIcon">
                                                    <Setter Property="Visibility" Value="Visible" />
                                                    <Style.Triggers>
                                                        <DataTrigger Binding="{Binding IsDownloaded}" Value="True">
                                                            <Setter Property="Visibility" Value="Collapsed" />
                                                        </DataTrigger>
                                                        <DataTrigger Binding="{Binding IsDownloading}" Value="True">
                                                            <Setter Property="Visibility" Value="Collapsed" />
                                                        </DataTrigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </ui:SymbolIcon.Style>
                                        </ui:SymbolIcon>

                                        <!-- State 2: Downloading ProgressRing -->
                                        <ui:ProgressRing Width="16" Height="16"
                                                         IsIndeterminate="{Binding IsDownloading}">
                                            <ui:ProgressRing.Style>
                                                <Style TargetType="ui:ProgressRing">
                                                    <Setter Property="Visibility" Value="Collapsed" />
                                                    <Style.Triggers>
                                                        <DataTrigger Binding="{Binding IsDownloading}" Value="True">
                                                            <Setter Property="Visibility" Value="Visible" />
                                                        </DataTrigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </ui:ProgressRing.Style>
                                        </ui:ProgressRing>

                                        <!-- State 3: Downloaded document icon -->
                                        <ui:SymbolIcon Symbol="Document24"
                                                       FontSize="16"
                                                       Foreground="{DynamicResource TextPrimaryBrush}">
                                            <ui:SymbolIcon.Style>
                                                <Style TargetType="ui:SymbolIcon">
                                                    <Setter Property="Visibility" Value="Collapsed" />
                                                    <Style.Triggers>
                                                        <DataTrigger Binding="{Binding IsDownloaded}" Value="True">
                                                            <Setter Property="Visibility" Value="Visible" />
                                                        </DataTrigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </ui:SymbolIcon.Style>
                                        </ui:SymbolIcon>
                                    </Grid>
                                </Border>

                                <!-- Middle column: File name and file size display -->
                                <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                    <TextBlock Text="{Binding FileName}"
                                               FontWeight="{DynamicResource TypeBodyStrongFontWeight}"
                                               FontSize="{DynamicResource TypeBodyFontSize}"
                                               Foreground="{DynamicResource TextPrimaryBrush}"
                                               TextTrimming="CharacterEllipsis" />
                                    <TextBlock Text="{Binding FileSizeDisplay}"
                                               FontSize="{DynamicResource TypeCaptionFontSize}"
                                               Foreground="{DynamicResource TextSecondaryBrush}"
                                               Margin="0,2,0,0" />
                                    <!-- Error message if download failed or too large -->
                                    <TextBlock Text="{Binding ErrorMessage}"
                                               FontSize="{DynamicResource TypeCaptionFontSize}"
                                               Foreground="{DynamicResource StatusErrorBrush}"
                                               Margin="0,2,0,0">
                                        <TextBlock.Style>
                                            <Style TargetType="TextBlock">
                                                <Setter Property="Visibility" Value="Collapsed" />
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding HasError}" Value="True">
                                                        <Setter Property="Visibility" Value="Visible" />
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </TextBlock.Style>
                                    </TextBlock>
                                </StackPanel>
                            </Grid>
                        </ControlTemplate>
                    </Button.Template>
                </Button>
            </Border>
        </Grid>
    </DataTemplate>

</ResourceDictionary>
