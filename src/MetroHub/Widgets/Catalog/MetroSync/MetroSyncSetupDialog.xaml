<dialogs:MetroDialog x:Class="MetroHub.Widgets.Catalog.MetroSync.MetroSyncSetupDialog"
                     xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                     xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                     xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
                     xmlns:controls="clr-namespace:MetroHub.Presentation.Controls"
                     xmlns:dialogs="clr-namespace:MetroHub.Presentation.Dialogs"
                     Title="Connect MetroSync"
                     Width="620"
                     Height="360">

    <dialogs:MetroDialog.SidebarContent>
        <ui:SymbolIcon Symbol="PhoneLaptop24"
                       FontSize="48"
                       Foreground="{DynamicResource TextSecondaryBrush}"
                       HorizontalAlignment="Center"
                       VerticalAlignment="Center" />
    </dialogs:MetroDialog.SidebarContent>

    <Grid Margin="0,4,0,0">
        <!-- ================================================================= -->
        <!-- STATE 0: INTRO / HOW TO CONNECT (Step 1)                          -->
        <!-- ================================================================= -->
        <Grid x:Name="IntroPanel">
            <Grid.RowDefinitions>
                <RowDefinition Height="*" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>

            <!-- Continuous Stepper Layout: 4 Steps (Equidistant 52px rows) -->
            <Grid Grid.Row="0" Margin="0,12,0,0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="24" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>
                <Grid.RowDefinitions>
                    <!-- Step 1 -->
                    <RowDefinition Height="44" />
                    <!-- Step 2 -->
                    <RowDefinition Height="44" />
                    <!-- Step 3 -->
                    <RowDefinition Height="44" />
                    <!-- Step 4 -->
                    <RowDefinition Height="44" />
                    <!-- Step 5 -->
                    <RowDefinition Height="44" />
                </Grid.RowDefinitions>

                <!-- ================= Step 1 ================= -->
                <Rectangle Grid.Column="0" Grid.Row="0"
                           Width="2"
                           Fill="{DynamicResource SystemAccentColorPrimaryBrush}"
                           Opacity="0.35"
                           HorizontalAlignment="Center"
                           VerticalAlignment="Stretch"
                           Margin="0,10,0,-1" />
                <Ellipse Grid.Column="0" Grid.Row="0"
                         Width="10" Height="10"
                         Fill="{DynamicResource SystemAccentColorPrimaryBrush}"
                         HorizontalAlignment="Center"
                         VerticalAlignment="Top"
                         Margin="0,5,0,0" />
                <TextBlock Grid.Column="1" Grid.Row="0"
                           FontSize="{DynamicResource TypeBodyFontSize}"
                           Foreground="{DynamicResource TextPrimaryBrush}"
                           Margin="12,0,0,0"
                           TextWrapping="Wrap">
                    <Run Text="Search " /><Run Text="@BotFather" FontWeight="SemiBold" /><Run Text=" in Telegram and type " /><Run Text="/newbot" FontWeight="SemiBold" /><Run Text="." />
                </TextBlock>

                <!-- ================= Step 2 ================= -->
                <Rectangle Grid.Column="0" Grid.Row="1"
                           Width="2"
                           Fill="{DynamicResource SystemAccentColorPrimaryBrush}"
                           Opacity="0.35"
                           HorizontalAlignment="Center"
                           VerticalAlignment="Stretch"
                           Margin="0,0,0,-1" />
                <Ellipse Grid.Column="0" Grid.Row="1"
                         Width="10" Height="10"
                         Fill="{DynamicResource SystemAccentColorPrimaryBrush}"
                         HorizontalAlignment="Center"
                         VerticalAlignment="Top"
                         Margin="0,5,0,0" />
                <TextBlock Grid.Column="1" Grid.Row="1"
                           FontSize="{DynamicResource TypeBodyFontSize}"
                           Foreground="{DynamicResource TextPrimaryBrush}"
                           Margin="12,0,0,0"
                           TextWrapping="Wrap">
                    <Run Text="Enter a unique " /><Run Text="username" FontWeight="SemiBold" /><Run Text=" (follow Telegram steps)." />
                </TextBlock>

                <!-- ================= Step 3 ================= -->
                <Rectangle Grid.Column="0" Grid.Row="2"
                           Width="2"
                           Fill="{DynamicResource SystemAccentColorPrimaryBrush}"
                           Opacity="0.35"
                           HorizontalAlignment="Center"
                           VerticalAlignment="Stretch"
                           Margin="0,0,0,-1" />
                <Ellipse Grid.Column="0" Grid.Row="2"
                         Width="10" Height="10"
                         Fill="{DynamicResource SystemAccentColorPrimaryBrush}"
                         HorizontalAlignment="Center"
                         VerticalAlignment="Top"
                         Margin="0,5,0,0" />
                <TextBlock Grid.Column="1" Grid.Row="2"
                           FontSize="{DynamicResource TypeBodyFontSize}"
                           Foreground="{DynamicResource TextPrimaryBrush}"
                           Margin="12,0,0,0"
                           TextWrapping="Wrap">
                    <Run Text="Copy the " /><Run Text="HTTP API token" FontWeight="SemiBold" /><Run Text=" BotFather gives you." />
                </TextBlock>

                <!-- ================= Step 4 ================= -->
                <Rectangle Grid.Column="0" Grid.Row="3"
                           Width="2"
                           Fill="{DynamicResource SystemAccentColorPrimaryBrush}"
                           Opacity="0.35"
                           HorizontalAlignment="Center"
                           VerticalAlignment="Stretch"
                           Margin="0,0,0,-1" />
                <Ellipse Grid.Column="0" Grid.Row="3"
                         Width="10" Height="10"
                         Fill="{DynamicResource SystemAccentColorPrimaryBrush}"
                         HorizontalAlignment="Center"
                         VerticalAlignment="Top"
                         Margin="0,5,0,0" />
                <TextBlock Grid.Column="1" Grid.Row="3"
                           FontSize="{DynamicResource TypeBodyFontSize}"
                           Foreground="{DynamicResource TextPrimaryBrush}"
                           Margin="12,0,0,0"
                           TextWrapping="Wrap">
                    <Run Text="Paste the token here and enter " /><Run Text="/start" FontWeight="SemiBold" /><Run Text=" on your bot." />
                </TextBlock>

                <!-- ================= Step 5 ================= -->
                <Rectangle Grid.Column="0" Grid.Row="4"
                           Width="2"
                           Fill="{DynamicResource SystemAccentColorPrimaryBrush}"
                           Opacity="0.35"
                           HorizontalAlignment="Center"
                           VerticalAlignment="Top"
                           Height="10" />
                <Ellipse Grid.Column="0" Grid.Row="4"
                         Width="10" Height="10"
                         Fill="{DynamicResource SystemAccentColorPrimaryBrush}"
                         HorizontalAlignment="Center"
                         VerticalAlignment="Top"
                         Margin="0,5,0,0" />
                <TextBlock Grid.Column="1" Grid.Row="4"
                           FontSize="{DynamicResource TypeBodyFontSize}"
                           Foreground="{DynamicResource TextPrimaryBrush}"
                           Margin="12,0,0,0"
                           TextWrapping="Wrap">
                    <Run Text="Your device is " /><Run Text="securely connected" FontWeight="SemiBold" /><Run Text=" and ready to sync." />
                </TextBlock>
            </Grid>

            <!-- Bottom Action Bar (Only Next) -->
            <Grid Grid.Row="1" Margin="0,16,0,0">
                <Button x:Name="IntroNextButton"
                        Style="{DynamicResource AccentButtonStyle}"
                        Content="Next"
                        Height="34"
                        Padding="24,0"
                        HorizontalAlignment="Right"
                        Click="OnIntroNextClick" />
            </Grid>
        </Grid>

        <!-- ================================================================= -->
        <!-- WIZARD PANEL: TOKEN ENTRY & PAIRING FLOW (Steps 2+)               -->
        <!-- ================================================================= -->
        <Grid x:Name="WizardPanel" Visibility="Collapsed">
            <Grid.RowDefinitions>
                <!-- Row 0: Bot Token Input Tier -->
                <RowDefinition Height="Auto" />
                <!-- Row 1: State Specific Content Slot -->
                <RowDefinition Height="*" />
                <!-- Row 2: Bottom Status & Manual Switch Link Slot -->
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>

            <!-- Row 0: Bot Token Input -->
            <StackPanel Grid.Row="0">
                <TextBlock Text="Bot token"
                           FontSize="{DynamicResource TypeCaptionFontSize}"
                           FontWeight="{DynamicResource TypeCaptionFontWeight}"
                           Foreground="{DynamicResource TextSecondaryBrush}"
                           Margin="0,0,0,6" />
                <TextBox x:Name="BotTokenInput"
                         Height="36"
                         TextChanged="OnBotTokenInputTextChanged"
                         KeyDown="OnBotTokenInputKeyDown" />
            </StackPanel>

            <!-- Row 1: The 4 Visual States -->
            <Grid Grid.Row="1" Margin="0,16,0,0">
                <!-- State 1: Token Entry -->
                <Grid x:Name="State1Panel" />

                <!-- State 2: Polling Wait (Card layout) -->
                <Border x:Name="State2Panel"
                        Visibility="Collapsed"
                        Background="{DynamicResource SurfaceGlassBrush}"
                        BorderBrush="{DynamicResource SurfaceBorderBrush}"
                        BorderThickness="1"
                        CornerRadius="{DynamicResource ControlCornerRadius}"
                        Padding="18,16"
                        VerticalAlignment="Center">
                    <Grid>
                        <Grid.RowDefinitions>
                            <!-- Row 0: Instruction -->
                            <RowDefinition Height="Auto" />
                            <!-- Row 1: Action (Open in Telegram) -->
                            <RowDefinition Height="Auto" />
                            <!-- Row 2: Live Status Telemetry -->
                            <RowDefinition Height="Auto" />
                        </Grid.RowDefinitions>

                        <!-- Instruction: Send /start in [botname] to connect. -->
                        <TextBlock x:Name="PollingInstructionText"
                                   Grid.Row="0"
                                   FontSize="{DynamicResource TypeBodyFontSize}"
                                   Foreground="{DynamicResource TextPrimaryBrush}"
                                   TextWrapping="Wrap">
                            <Run Text="Send " /><Run Text="/start" FontWeight="SemiBold" Foreground="{DynamicResource SystemAccentColorPrimaryBrush}" /><Run Text=" in " /><Run x:Name="PollingBotNameRun" Text="@bot" FontWeight="SemiBold" /><Run Text=" to connect." />
                        </TextBlock>

                        <!-- Row 1: Open in Telegram Button -->
                        <Button x:Name="OpenTelegramButton"
                                Grid.Row="1"
                                Style="{DynamicResource DefaultButtonStyle}"
                                Height="32"
                                Padding="14,0"
                                HorizontalAlignment="Left"
                                Margin="0,14,0,0"
                                Click="OnOpenTelegramClick">
                            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                <ui:SymbolIcon Symbol="Open24"
                                               FontSize="14"
                                               Margin="0,0,8,0"
                                               VerticalAlignment="Center" />
                                <TextBlock Text="Open in Telegram"
                                           FontSize="{DynamicResource TypeCaptionFontSize}"
                                           FontWeight="{DynamicResource TypeCaptionFontWeight}"
                                           VerticalAlignment="Center" />
                            </StackPanel>
                        </Button>

                        <!-- Row 2: Live Progress Telemetry -->
                        <StackPanel Grid.Row="2"
                                    Orientation="Horizontal"
                                    VerticalAlignment="Center"
                                    Margin="0,14,0,0">
                            <ui:ProgressRing x:Name="PollingProgressRing"
                                             Width="16" Height="16"
                                             IsIndeterminate="False"
                                             VerticalAlignment="Center"
                                             Margin="0,0,8,0" />
                            <TextBlock Text="Waiting for /start..."
                                       FontSize="{DynamicResource TypeCaptionFontSize}"
                                       Foreground="{DynamicResource TextSecondaryBrush}"
                                       VerticalAlignment="Center" />
                        </StackPanel>
                    </Grid>
                </Border>

                <!-- State 3: Confirmation (Verified Account Card) -->
                <Border x:Name="State3Panel"
                        Visibility="Collapsed"
                        Background="{DynamicResource SurfaceGlassBrush}"
                        BorderBrush="{DynamicResource SurfaceBorderBrush}"
                        BorderThickness="1"
                        CornerRadius="{DynamicResource ControlCornerRadius}"
                        Padding="18,16"
                        VerticalAlignment="Center">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>

                        <!-- 42x42 Avatar Badge -->
                        <Border Grid.Column="0"
                                Width="42" Height="42"
                                CornerRadius="21"
                                Background="{DynamicResource SurfaceGlassSubtleBrush}"
                                BorderBrush="{DynamicResource SurfaceBorderBrush}"
                                BorderThickness="1"
                                VerticalAlignment="Center"
                                Margin="0,0,16,0">
                            <Grid>
                                <!-- Fallback Symbol (shown when no avatar) -->
                                <ui:SymbolIcon x:Name="ConfirmationAvatarFallback"
                                               Symbol="Person24"
                                               FontSize="20"
                                               Foreground="{DynamicResource TextPrimaryBrush}"
                                               HorizontalAlignment="Center"
                                               VerticalAlignment="Center" />
                                <!-- Avatar Image (Exact 40x40 inner bounds) -->
                                <Image x:Name="ConfirmationAvatarImage"
                                       Width="40" Height="40"
                                       Stretch="UniformToFill"
                                       RenderOptions.BitmapScalingMode="HighQuality"
                                       Visibility="Collapsed">
                                    <Image.Clip>
                                        <EllipseGeometry Center="20,20" RadiusX="20" RadiusY="20" />
                                    </Image.Clip>
                                </Image>
                            </Grid>
                        </Border>

                        <!-- 2-Line Account Information -->
                        <StackPanel Grid.Column="1" VerticalAlignment="Center">
                            <!-- Account Name -->
                            <TextBlock x:Name="ConfirmationAccountNameText"
                                       Text="Anon"
                                       FontSize="{DynamicResource TypeBodyStrongFontSize}"
                                       FontWeight="{DynamicResource TypeBodyStrongFontWeight}"
                                       Foreground="{DynamicResource TextPrimaryBrush}"
                                       TextTrimming="CharacterEllipsis" />

                            <!-- Telegram Handle / ID -->
                            <TextBlock x:Name="ConfirmationAccountHandleText"
                                       Text="@username"
                                       FontSize="{DynamicResource TypeCaptionFontSize}"
                                       Foreground="{DynamicResource TextSecondaryBrush}"
                                       Margin="0,3,0,0"
                                       TextTrimming="CharacterEllipsis" />
                        </StackPanel>
                    </Grid>
                </Border>

                <!-- State 4: Manual User ID Entry -->
                <Grid x:Name="State4Panel" Visibility="Collapsed" VerticalAlignment="Top">
                    <StackPanel>
                        <TextBlock Text="User ID"
                                   FontSize="{DynamicResource TypeCaptionFontSize}"
                                   FontWeight="{DynamicResource TypeCaptionFontWeight}"
                                   Foreground="{DynamicResource TextSecondaryBrush}"
                                   Margin="0,0,0,6" />
                        <TextBox x:Name="ManualUserIdInput"
                                 Height="36"
                                 KeyDown="OnManualUserIdInputKeyDown" />
                        <TextBlock FontSize="{DynamicResource TypeCaptionFontSize}"
                                   Foreground="{DynamicResource TextSecondaryBrush}"
                                   Margin="0,6,0,0"
                                   TextWrapping="Wrap">
                            <Run Text="Find your numeric ID by messaging " /><Run Text="@userinfobot" FontWeight="SemiBold" /><Run Text=" in Telegram." />
                        </TextBlock>
                    </StackPanel>
                </Grid>
            </Grid>

            <!-- Row 2: Bottom Status, Manual Link & Footer Actions -->
            <Grid Grid.Row="2" Margin="0,12,0,0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <!-- Left: Inline Error & Manual User ID Link -->
                <StackPanel Grid.Column="0" VerticalAlignment="Center">
                    <!-- Inline Error -->
                    <TextBlock x:Name="InlineErrorText"
                               Foreground="{DynamicResource StatusErrorBrush}"
                               FontSize="{DynamicResource TypeCaptionFontSize}"
                               Margin="0,0,0,8"
                               TextWrapping="Wrap"
                               Visibility="Collapsed" />

                    <!-- Manual User ID Link -->
                    <Button x:Name="ManualIdToggleButton"
                            Style="{DynamicResource SubtleButtonStyle}"
                            Content="Enter user ID manually"
                            HorizontalAlignment="Left"
                            Padding="0"
                            Height="Auto"
                            Cursor="Hand"
                            Foreground="{DynamicResource TextSubtleBrush}"
                            FontSize="{DynamicResource TypeCaptionFontSize}"
                            Click="OnManualIdToggleClick" />
                </StackPanel>

                <!-- Right: Unified Footer Actions per State -->
                <Grid Grid.Column="1" VerticalAlignment="Center">
                    <!-- State 1 Actions: Instructions + Continue -->
                    <StackPanel x:Name="State1Actions"
                                Orientation="Horizontal"
                                HorizontalAlignment="Right"
                                Visibility="Collapsed">
                        <Button x:Name="InstructionsButton"
                                Content="Instructions"
                                Style="{DynamicResource DefaultButtonStyle}"
                                Height="34"
                                Padding="16,0"
                                Margin="0,0,10,0"
                                Click="OnInstructionsClick" />
                        <Button x:Name="ContinueButton"
                                Content="Continue"
                                Style="{DynamicResource AccentButtonStyle}"
                                Height="34"
                                Padding="20,0"
                                IsDefault="True"
                                Click="OnContinueClick" />
                    </StackPanel>

                    <!-- State 2 Actions: Cancel -->
                    <StackPanel x:Name="State2Actions"
                                Orientation="Horizontal"
                                HorizontalAlignment="Right"
                                Visibility="Collapsed">
                        <Button x:Name="PollingCancelButton"
                                Content="Cancel"
                                Style="{DynamicResource DefaultButtonStyle}"
                                Height="34"
                                Padding="20,0"
                                Click="OnPollingCancelClick" />
                    </StackPanel>

                    <!-- State 3 Actions: Not me + Connect -->
                    <StackPanel x:Name="State3Actions"
                                Orientation="Horizontal"
                                HorizontalAlignment="Right"
                                Visibility="Collapsed">
                        <Button x:Name="NotMeButton"
                                Style="{DynamicResource DefaultButtonStyle}"
                                Content="Not me"
                                Height="34"
                                Padding="16,0"
                                Margin="0,0,8,0"
                                Click="OnNotMeClick" />
                        <Button x:Name="ConfirmConnectButton"
                                Style="{DynamicResource AccentButtonStyle}"
                                Content="Connect"
                                Height="34"
                                Padding="20,0"
                                IsDefault="True"
                                Click="OnConfirmConnectClick" />
                    </StackPanel>

                    <!-- State 4 Actions: Cancel + Connect -->
                    <StackPanel x:Name="State4Actions"
                                Orientation="Horizontal"
                                HorizontalAlignment="Right"
                                Visibility="Collapsed">
                        <Button Style="{DynamicResource DefaultButtonStyle}"
                                Content="Cancel"
                                Height="34"
                                Padding="16,0"
                                Margin="0,0,8,0"
                                Click="OnManualCancelClick" />
                        <Button Style="{DynamicResource AccentButtonStyle}"
                                Content="Connect"
                                Height="34"
                                Padding="20,0"
                                IsDefault="True"
                                Click="OnManualConnectClick" />
                    </StackPanel>
                </Grid>
            </Grid>
        </Grid>
    </Grid>
</dialogs:MetroDialog>