<UserControl x:Class="MetroHub.Widgets.Catalog.MetroSync.MetroSyncWidgetView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
             xmlns:controls="clr-namespace:MetroHub.Presentation.Controls"
             xmlns:widgets="clr-namespace:MetroHub.Widgets"
             xmlns:metrosync="clr-namespace:MetroHub.Widgets.Catalog.MetroSync"
             mc:Ignorable="d" 
             d:DataContext="{d:DesignInstance Type=metrosync:MetroSyncWidgetViewModel}"
             Focusable="False"
             FontFamily="{DynamicResource AppFontFamily}">

    <UserControl.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="pack://application:,,,/MetroHub;component/Widgets/Catalog/MetroSync/MetroSyncTemplates.xaml" />
            </ResourceDictionary.MergedDictionaries>
        </ResourceDictionary>
    </UserControl.Resources>

    <widgets:WidgetCard Padding="0" Background="Transparent">
        <Grid ClipToBounds="True">
            <Grid.RowDefinitions>
                <!-- Row 0: Header (Standard 50px height matching Audio/Brightness/2048) -->
                <RowDefinition Height="50" />
                <!-- Row 1: Hairline Divider -->
                <RowDefinition Height="Auto" />
                <!-- Row 2: Chat Feed -->
                <RowDefinition Height="*" />
                <!-- Row 3: Bottom Docked Container -->
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>

            <!-- Row 0: Header with Symmetrical 20px Margin -->
            <Grid Grid.Row="0" Margin="20,0,20,0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <TextBlock Grid.Column="0"
                           Text="MetroSync"
                           FontSize="{DynamicResource TypeSubtitleFontSize}"
                           FontWeight="{DynamicResource TypeSubtitleFontWeight}"
                           Foreground="{DynamicResource TextPrimaryBrush}"
                           VerticalAlignment="Center" />

                <!-- Header Action Button (Bot Avatar Badge when paired, opens Disconnect menu) -->
                <Button Grid.Column="1"
                        x:Name="HeaderMenuButton"
                        HorizontalAlignment="Right"
                        VerticalAlignment="Center"
                        Cursor="Hand"
                        Click="OnHeaderMenuClick"
                        ToolTip="Options">
                    <Button.Style>
                        <Style TargetType="Button">
                            <Setter Property="Background" Value="Transparent" />
                            <Setter Property="BorderThickness" Value="0" />
                            <Setter Property="Padding" Value="0" />
                            <Setter Property="Template">
                                <Setter.Value>
                                    <ControlTemplate TargetType="Button">
                                        <ContentPresenter HorizontalAlignment="Center"
                                                          VerticalAlignment="Center" />
                                    </ControlTemplate>
                                </Setter.Value>
                            </Setter>
                            <Style.Triggers>
                                <Trigger Property="IsMouseOver" Value="True">
                                    <Setter Property="Opacity" Value="0.85" />
                                </Trigger>
                                <Trigger Property="IsPressed" Value="True">
                                    <Setter Property="Opacity" Value="0.65" />
                                </Trigger>
                            </Style.Triggers>
                        </Style>
                    </Button.Style>
                    <Border x:Name="HeaderAvatarBorder"
                            Width="26" Height="26"
                            CornerRadius="13"
                            Background="{DynamicResource SurfaceGlassSubtleBrush}"
                            BorderBrush="{DynamicResource SurfaceBorderBrush}"
                            BorderThickness="1"
                            HorizontalAlignment="Center"
                            VerticalAlignment="Center">
                        <Grid>
                            <!-- Fallback Symbol when unpaired or no photo -->
                            <ui:SymbolIcon x:Name="HeaderAvatarFallback"
                                           Symbol="MoreHorizontal24"
                                           FontSize="14"
                                           Foreground="{DynamicResource TextSecondaryBrush}"
                                           HorizontalAlignment="Center"
                                           VerticalAlignment="Center" />

                            <!-- 24x24 Circular Bot Avatar Image -->
                            <Image x:Name="HeaderAvatarImage"
                                   Width="24" Height="24"
                                   Stretch="UniformToFill"
                                   RenderOptions.BitmapScalingMode="HighQuality"
                                   Visibility="Collapsed">
                                <Image.Clip>
                                    <EllipseGeometry Center="12,12" RadiusX="12" RadiusY="12" />
                                </Image.Clip>
                            </Image>
                        </Grid>
                    </Border>
                    <Button.ContextMenu>
                        <ContextMenu>
                            <MenuItem Header="Connect..."
                                      Command="{Binding PlacementTarget.DataContext.OpenSetupCommand, RelativeSource={RelativeSource AncestorType=ContextMenu}}"
                                      Visibility="{Binding PlacementTarget.DataContext.CanConnect, RelativeSource={RelativeSource AncestorType=ContextMenu}, Converter={StaticResource BoolToVis}}">
                                <MenuItem.Icon>
                                    <ui:SymbolIcon Symbol="PlugConnected24" FontSize="16" />
                                </MenuItem.Icon>
                            </MenuItem>
                            <MenuItem Header="Disconnect"
                                      Command="{Binding PlacementTarget.DataContext.DisconnectCommand, RelativeSource={RelativeSource AncestorType=ContextMenu}}"
                                      Visibility="{Binding PlacementTarget.DataContext.IsPaired, RelativeSource={RelativeSource AncestorType=ContextMenu}, Converter={StaticResource BoolToVis}}">
                                <MenuItem.Icon>
                                    <ui:SymbolIcon Symbol="PlugDisconnected24" FontSize="16" />
                                </MenuItem.Icon>
                            </MenuItem>
                        </ContextMenu>
                    </Button.ContextMenu>
                </Button>
            </Grid>

            <!-- Row 1: Hairline Separator -->
            <Border Grid.Row="1"
                    Style="{StaticResource WidgetHairlineDividerStyle}" />

            <!-- Row 2: Chat Feed (Active When Paired) -->
            <ScrollViewer x:Name="FeedScrollViewer"
                          Grid.Row="2"
                          Style="{DynamicResource WidgetFloatingScrollViewerStyle}"
                          controls:AutoHideScrollBehavior.IsEnabled="True"
                          VerticalScrollBarVisibility="Auto"
                          HorizontalScrollBarVisibility="Disabled"
                          Padding="20,8,20,8"
                          Visibility="{Binding IsPaired, Converter={StaticResource BoolToVis}}">
                <ItemsControl x:Name="FeedItemsControl"
                              ItemsSource="{Binding Items}" />
            </ScrollViewer>

            <!-- Row 2: Unpaired Setup State -->
            <Grid x:Name="UnpairedPanel"
                  Grid.Row="2"
                  HorizontalAlignment="Center"
                  VerticalAlignment="Center"
                  Margin="24,0,24,0"
                  MaxWidth="380"
                  Visibility="{Binding CanConnect, Converter={StaticResource BoolToVis}}">
                <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center">
                    <TextBlock Text="MetroSync"
                               FontSize="{DynamicResource TypeDisplayFontSize}"
                               FontWeight="SemiBold"
                               Foreground="{DynamicResource TextPrimaryBrush}"
                               TextAlignment="Center"
                               HorizontalAlignment="Center"
                               Margin="0,0,0,4" />
                    <TextBlock Text="Two-way phone and PC transfer via Telegram"
                               FontSize="{DynamicResource TypeBodyFontSize}"
                               Foreground="{DynamicResource TextSecondaryBrush}"
                               TextAlignment="Center"
                               HorizontalAlignment="Center"
                               Margin="0,0,0,24" />

                    <!-- Card 1: Two-Way Sharing -->
                    <Border Background="{DynamicResource SurfaceGlassSubtleBrush}"
                            BorderBrush="{DynamicResource SurfaceBorderBrush}"
                            BorderThickness="1"
                            CornerRadius="{DynamicResource ControlCornerRadius}"
                            Padding="12"
                            MinHeight="72"
                            Margin="0,0,0,12">
                        <Grid VerticalAlignment="Center">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="32" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <ui:FontIcon Grid.Column="0"
                                         Glyph="&#xE895;"
                                         FontFamily="Segoe MDL2 Assets"
                                         FontSize="18"
                                         Foreground="{DynamicResource TextSecondaryBrush}"
                                         VerticalAlignment="Center" />
                            <StackPanel Grid.Column="1" Margin="8,0,0,0">
                                <TextBlock Text="Two-Way Sharing"
                                           FontSize="{DynamicResource TypeBodyStrongFontSize}"
                                           FontWeight="{DynamicResource TypeBodyStrongFontWeight}"
                                           Foreground="{DynamicResource TextPrimaryBrush}"
                                           Margin="0,0,0,4" />
                                <TextBlock Text="Share files and messages between your desktop and phone through your Telegram."
                                           FontSize="{DynamicResource TypeCaptionFontSize}"
                                           Foreground="{DynamicResource TextSecondaryBrush}"
                                           TextWrapping="Wrap" />
                            </StackPanel>
                        </Grid>
                    </Border>

                    <!-- Card 2: Your Personal Bot -->
                    <Border Background="{DynamicResource SurfaceGlassSubtleBrush}"
                            BorderBrush="{DynamicResource SurfaceBorderBrush}"
                            BorderThickness="1"
                            CornerRadius="{DynamicResource ControlCornerRadius}"
                            Padding="12"
                            MinHeight="72"
                            Margin="0,0,0,12">
                        <Grid VerticalAlignment="Center">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="32" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <ui:FontIcon Grid.Column="0"
                                         Glyph="&#xE99A;"
                                         FontFamily="Segoe MDL2 Assets"
                                         FontSize="18"
                                         Foreground="{DynamicResource TextSecondaryBrush}"
                                         VerticalAlignment="Center" />
                            <StackPanel Grid.Column="1" Margin="8,0,0,0">
                                <TextBlock Text="Your Personal Bot"
                                           FontSize="{DynamicResource TypeBodyStrongFontSize}"
                                           FontWeight="{DynamicResource TypeBodyStrongFontWeight}"
                                           Foreground="{DynamicResource TextPrimaryBrush}"
                                           Margin="0,0,0,4" />
                                <TextBlock Text="Powered by your own Telegram bot. Only you have access."
                                           FontSize="{DynamicResource TypeCaptionFontSize}"
                                           Foreground="{DynamicResource TextSecondaryBrush}"
                                           TextWrapping="Wrap" />
                            </StackPanel>
                        </Grid>
                    </Border>

                    <!-- Card 3: No Companion App Needed -->
                    <Border Background="{DynamicResource SurfaceGlassSubtleBrush}"
                            BorderBrush="{DynamicResource SurfaceBorderBrush}"
                            BorderThickness="1"
                            CornerRadius="{DynamicResource ControlCornerRadius}"
                            Padding="12"
                            MinHeight="72"
                            Margin="0,0,0,28">
                        <Grid VerticalAlignment="Center">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="32" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <ui:FontIcon Grid.Column="0"
                                         Glyph="&#xE724;"
                                         FontFamily="Segoe MDL2 Assets"
                                         FontSize="18"
                                         Foreground="{DynamicResource TextSecondaryBrush}"
                                         VerticalAlignment="Center" />
                            <StackPanel Grid.Column="1" Margin="8,0,0,0">
                                <TextBlock Text="No Companion App Needed"
                                           FontSize="{DynamicResource TypeBodyStrongFontSize}"
                                           FontWeight="{DynamicResource TypeBodyStrongFontWeight}"
                                           Foreground="{DynamicResource TextPrimaryBrush}"
                                           Margin="0,0,0,4" />
                                <TextBlock Text="Use the Telegram app you already have. Nothing extra to install on your phone."
                                           FontSize="{DynamicResource TypeCaptionFontSize}"
                                           Foreground="{DynamicResource TextSecondaryBrush}"
                                           TextWrapping="Wrap" />
                            </StackPanel>
                        </Grid>
                    </Border>

                    <!-- Primary Action Button -->
                    <Button Style="{DynamicResource AccentButtonStyle}"
                            Content="Connect"
                            Height="36"
                            Padding="36,0"
                            HorizontalAlignment="Center"
                            Command="{Binding OpenSetupCommand}" />
                </StackPanel>
            </Grid>


            <!-- Row 3: Docked Bottom Container (Active When Paired) -->
            <Border Grid.Row="3"
                    Background="{DynamicResource SurfaceInputWellBrush}"
                    BorderThickness="0"
                    CornerRadius="{DynamicResource ControlCornerRadiusBottom}"
                    SnapsToDevicePixels="True"
                    MinHeight="44"
                    Padding="14,6,14,6"
                    Visibility="{Binding IsPaired, Converter={StaticResource BoolToVis}}">
                <!-- Telegram-Style Input Row -->
                <Grid VerticalAlignment="Center">
                    <Grid.ColumnDefinitions>
                        <!-- Column 0: Attach / Pin Button -->
                        <ColumnDefinition Width="Auto" />
                        <!-- Column 1: Invisible Multiline TextBox -->
                        <ColumnDefinition Width="*" />
                        <!-- Column 2: Send Button -->
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>

                    <!-- Attach / Paste Button -->
                    <Button Grid.Column="0"
                            Width="32" Height="32"
                            Padding="0"
                            VerticalAlignment="Center"
                            Command="{Binding SendClipboardImageCommand}"
                            ToolTip="Paste image from clipboard">
                        <Button.Style>
                            <Style TargetType="Button">
                                <Setter Property="OverridesDefaultStyle" Value="True" />
                                <Setter Property="Width" Value="32" />
                                <Setter Property="Height" Value="32" />
                                <Setter Property="Padding" Value="0" />
                                <Setter Property="Background" Value="Transparent" />
                                <Setter Property="BorderBrush" Value="Transparent" />
                                <Setter Property="BorderThickness" Value="0" />
                                <Setter Property="Foreground" Value="{DynamicResource TextSecondaryBrush}" />
                                <Setter Property="FocusVisualStyle" Value="{x:Null}" />
                                <Setter Property="Cursor" Value="Hand" />
                                <Setter Property="SnapsToDevicePixels" Value="True" />
                                <Setter Property="UseLayoutRounding" Value="True" />
                                <Setter Property="Template">
                                    <Setter.Value>
                                        <ControlTemplate TargetType="Button">
                                            <Border Background="Transparent"
                                                    Padding="{TemplateBinding Padding}">
                                                <ContentPresenter HorizontalAlignment="Center"
                                                                  VerticalAlignment="Center" />
                                            </Border>
                                        </ControlTemplate>
                                    </Setter.Value>
                                </Setter>
                                <Style.Triggers>
                                    <Trigger Property="IsMouseOver" Value="True">
                                        <Setter Property="Foreground" Value="{DynamicResource TextPrimaryBrush}" />
                                    </Trigger>
                                    <Trigger Property="IsPressed" Value="True">
                                        <Setter Property="Foreground" Value="{DynamicResource TextPrimaryBrush}" />
                                    </Trigger>
                                    <Trigger Property="IsEnabled" Value="False">
                                        <Setter Property="Opacity" Value="0.35" />
                                        <Setter Property="Cursor" Value="Arrow" />
                                    </Trigger>
                                </Style.Triggers>
                            </Style>
                        </Button.Style>
                        <ui:SymbolIcon Symbol="Attach24"
                                       FontSize="18"
                                       Foreground="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}" />
                    </Button>

                    <!-- Middle Seamless Input Area -->
                    <Grid Grid.Column="1" Margin="8,0,8,0" VerticalAlignment="Center">
                        <!-- Placeholder: positioned 1-2px from the caret matching Telegram Desktop -->
                        <TextBlock x:Name="InputPlaceholder"
                                   Text="Write a message…"
                                   FontSize="{DynamicResource TypeBodyFontSize}"
                                   FontWeight="{DynamicResource TypeBodyFontWeight}"
                                   Foreground="{DynamicResource TextSubtleBrush}"
                                   Opacity="0.55"
                                   IsHitTestVisible="False"
                                   VerticalAlignment="Center"
                                   Margin="3,0,0,0" />

                        <!-- Invisible Multi-line TextBox -->
                        <TextBox x:Name="InputTextBox"
                                 Text="{Binding InputText, UpdateSourceTrigger=PropertyChanged}"
                                 AcceptsReturn="True"
                                 TextWrapping="Wrap"
                                 MaxHeight="120"
                                 VerticalAlignment="Center"
                                 VerticalScrollBarVisibility="Auto"
                                 Foreground="{DynamicResource TextPrimaryBrush}"
                                 CaretBrush="{DynamicResource TextPrimaryBrush}"
                                 FontSize="{DynamicResource TypeBodyFontSize}"
                                 FontFamily="{DynamicResource AppFontFamily}"
                                 Padding="0"
                                 PreviewKeyDown="OnInputTextBoxPreviewKeyDown"
                                 TextChanged="OnInputTextBoxTextChanged">
                            <TextBox.Style>
                                <Style TargetType="TextBox">
                                    <Setter Property="OverridesDefaultStyle" Value="True" />
                                    <Setter Property="FocusVisualStyle" Value="{x:Null}" />
                                    <Setter Property="Background" Value="Transparent" />
                                    <Setter Property="BorderThickness" Value="0" />
                                    <Setter Property="Padding" Value="0" />
                                    <Setter Property="SnapsToDevicePixels" Value="True" />
                                    <Setter Property="UseLayoutRounding" Value="True" />
                                    <Setter Property="Template">
                                        <Setter.Value>
                                            <ControlTemplate TargetType="TextBox">
                                                <Border Background="Transparent"
                                                        BorderThickness="0"
                                                        Padding="{TemplateBinding Padding}">
                                                    <ScrollViewer x:Name="PART_ContentHost"
                                                                  Focusable="False"
                                                                  controls:AutoHideScrollBehavior.IsEnabled="True" />
                                                </Border>
                                            </ControlTemplate>
                                        </Setter.Value>
                                    </Setter>
                                </Style>
                            </TextBox.Style>
                        </TextBox>
                    </Grid>

                    <!-- Send Button -->
                    <Button Grid.Column="2"
                            Width="32" Height="32"
                            Padding="0"
                            VerticalAlignment="Center"
                            Command="{Binding SendCommand}"
                            ToolTip="Send message (Enter)">
                        <Button.Style>
                            <Style TargetType="Button" BasedOn="{StaticResource SubtleButtonStyle}">
                                <Setter Property="OverridesDefaultStyle" Value="True" />
                                <Setter Property="Width" Value="32" />
                                <Setter Property="Height" Value="32" />
                                <Setter Property="Padding" Value="0" />
                                <Setter Property="Cursor" Value="Hand" />
                                <Style.Triggers>
                                    <Trigger Property="IsEnabled" Value="True">
                                        <Setter Property="Foreground" Value="{DynamicResource SystemAccentColorPrimaryBrush}" />
                                    </Trigger>
                                    <Trigger Property="IsEnabled" Value="False">
                                        <Setter Property="Foreground" Value="{DynamicResource TextSubtleBrush}" />
                                        <Setter Property="Cursor" Value="Arrow" />
                                    </Trigger>
                                </Style.Triggers>
                            </Style>
                        </Button.Style>
                        <ui:SymbolIcon Symbol="Send24"
                                       FontSize="18"
                                       Foreground="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}" />
                    </Button>
                </Grid>
            </Border>
        </Grid>
    </widgets:WidgetCard>
</UserControl>