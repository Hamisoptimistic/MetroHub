<UserControl x:Class="MetroHub.Widgets.Catalog.Habit.HabitWidgetView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
             xmlns:widgets="clr-namespace:MetroHub.Widgets"
             xmlns:local="clr-namespace:MetroHub.Widgets.Catalog.Habit"
             xmlns:controls="clr-namespace:MetroHub.Presentation.Controls"
             xmlns:converters="clr-namespace:MetroHub.Presentation.Converters"
             mc:Ignorable="d" 
             d:DataContext="{d:DesignInstance Type=local:HabitWidgetViewModel}"
             Focusable="False"
             FontFamily="{DynamicResource AppFontFamily}">

    <UserControl.Resources>
        <converters:EqualityConverter x:Key="EqualityConverter" />




        <!-- 34x34 Fluent Icon Choice Button Style (CornerRadius: 2px) -->
        <Style x:Key="HabitIconChoiceButtonStyle" TargetType="Button">
            <Setter Property="Background" Value="#15FFFFFF" />
            <Setter Property="BorderBrush" Value="#25FFFFFF" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="Width" Value="34" />
            <Setter Property="Height" Value="34" />
            <Setter Property="FocusVisualStyle" Value="{x:Null}" />
            <Setter Property="Margin" Value="0,0,6,6" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Border"
                                Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="{DynamicResource ControlCornerRadius}"
                                >
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Border" Property="Background" Value="#25FFFFFF" />
                                <Setter TargetName="Border" Property="BorderBrush" Value="#60FFFFFF" />
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="Border" Property="Background" Value="#35FFFFFF" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
            <Style.Triggers>
                <DataTrigger Value="True">
                    <DataTrigger.Binding>
                        <MultiBinding Converter="{StaticResource EqualityConverter}">
                            <Binding Path="SetupSelectedIcon" />
                            <Binding Path="CommandParameter" RelativeSource="{RelativeSource Self}" />
                        </MultiBinding>
                    </DataTrigger.Binding>
                    <Setter Property="Background" Value="#30FFFFFF" />
                    <Setter Property="BorderBrush" Value="{DynamicResource SystemAccentColorPrimaryBrush}" />
                    <Setter Property="BorderThickness" Value="1.5" />
                </DataTrigger>
            </Style.Triggers>
        </Style>

        <!-- Seamless Day Cell Button Style (Zero Outer Border / Margin) -->
        <Style x:Key="HabitDayButtonStyle" TargetType="Button">
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="Padding" Value="0" />
            <Setter Property="Margin" Value="0" />
            <Setter Property="HorizontalAlignment" Value="Stretch" />
            <Setter Property="VerticalAlignment" Value="Stretch" />
            <Setter Property="HorizontalContentAlignment" Value="Stretch" />
            <Setter Property="VerticalContentAlignment" Value="Stretch" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border Background="Transparent"
                                BorderThickness="0"
                                HorizontalAlignment="Stretch"
                                VerticalAlignment="Stretch"
                                >
                            <ContentPresenter HorizontalAlignment="Stretch" VerticalAlignment="Stretch" />
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
            <Style.Triggers>
                <DataTrigger Binding="{Binding IsClickable}" Value="False">
                    <Setter Property="Cursor" Value="Arrow" />
                </DataTrigger>
            </Style.Triggers>
        </Style>
    </UserControl.Resources>

    <widgets:WidgetCard Padding="16,14">
        <Grid>
            <!-- ============================================================ -->
            <!-- 1. MAIN HABIT MATRIX INTERFACE (CALENDAR + STREAK)          -->
            <!-- ============================================================ -->
            <Grid Visibility="{Binding IsCalendarVisible, Converter={StaticResource BoolToVis}}">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" /> <!-- 0: Month Stepper Header -->
                    <RowDefinition Height="Auto" /> <!-- 1: Weekday Names Header -->
                    <RowDefinition Height="*" />    <!-- 2: 42-Day Month Grid -->
                    <RowDefinition Height="Auto" /> <!-- 3: Footer Habit + Streak -->
                </Grid.RowDefinitions>

                <!-- Row 0: Month Navigation Header -->
                <Grid Grid.Row="0" Margin="2,0,2,8">
                    <!-- Left Chevron Button -->
                    <Button HorizontalAlignment="Left"
                            VerticalAlignment="Center"
                            Command="{Binding PrevMonthCommand}"
                            ToolTip="Previous Month"
                            Style="{StaticResource WidgetNavButtonStyle}">
                        <ui:SymbolIcon Symbol="ChevronLeft24" FontSize="16" />
                    </Button>

                    <!-- Center Month / Year Title -->
                    <Button HorizontalAlignment="Center"
                            VerticalAlignment="Center"
                            Command="{Binding JumpToCurrentMonthCommand}"
                            ToolTip="Click to return to Current Month"
                            Background="Transparent"
                            BorderThickness="0"
                            Padding="8,3"
                            Focusable="False">
                        <TextBlock Text="{Binding DisplayMonthYear}"
                                   FontFamily="{DynamicResource AppDisplayFontFamily}"
                                   FontSize="{DynamicResource TypeHeaderFontSize}"
                                   FontWeight="{DynamicResource TypeHeaderFontWeight}"
                                   Foreground="{DynamicResource TextPrimaryBrush}"
                                   HorizontalAlignment="Center"
                                   VerticalAlignment="Center" />
                    </Button>

                    <!-- Right Chevron Button -->
                    <Button HorizontalAlignment="Right"
                            VerticalAlignment="Center"
                            Command="{Binding NextMonthCommand}"
                            ToolTip="Next Month"
                            Style="{StaticResource WidgetNavButtonStyle}">
                        <ui:SymbolIcon Symbol="ChevronRight24" FontSize="16" />
                    </Button>
                </Grid>

                <!-- Row 1: Weekday Headers (Su, Mo, Tu, We, Th, Fr, Sa) -->
                <ItemsControl Grid.Row="1" ItemsSource="{Binding DayOfWeekHeaders}" Margin="0,0,0,6">
                    <ItemsControl.ItemsPanel>
                        <ItemsPanelTemplate>
                            <UniformGrid Columns="7" />
                        </ItemsPanelTemplate>
                    </ItemsControl.ItemsPanel>
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <TextBlock Text="{Binding}"
                                       FontFamily="{DynamicResource AppFontFamily}"
                                       FontSize="{DynamicResource TypeCaptionFontSize}"
                                       FontWeight="{DynamicResource TypeCaptionFontWeight}"
                                       Foreground="{DynamicResource TextMutedBrush}"
                                       HorizontalAlignment="Center"
                                       VerticalAlignment="Center" />
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>

                <!-- Row 2: 42-Day Grid Area (Seamless Single-Polygon Month Backplate + Number Grid) -->
                <Grid Grid.Row="2" ClipToBounds="True">
                    <!-- Seamless Single-Polygon Month Backplate: Contiguous polygon eliminating all internal lines/seams -->
                    <local:HabitMonthBackplate
                        FirstDayOffset="{Binding FirstDayOffset}"
                        DaysInMonth="{Binding DaysInMonth}"
                        FillBrush="{DynamicResource SurfaceGlassBrush}"
                        RenderOptions.EdgeMode="Aliased"
                        />

                    <ItemsControl ItemsSource="{Binding Days}">
                        <ItemsControl.ItemsPanel>
                            <ItemsPanelTemplate>
                                <local:SeamlessCalendarGrid Rows="6" Columns="7" />
                            </ItemsPanelTemplate>
                        </ItemsControl.ItemsPanel>
                        <ItemsControl.ItemContainerStyle>
                            <Style TargetType="ContentPresenter">
                                <Setter Property="HorizontalAlignment" Value="Stretch" />
                                <Setter Property="VerticalAlignment" Value="Stretch" />
                                <Setter Property="Margin" Value="0" />
                            </Style>
                        </ItemsControl.ItemContainerStyle>
                        <ItemsControl.ItemTemplate>
                            <DataTemplate DataType="{x:Type local:HabitDayViewModel}">
                                <Button Command="{Binding DataContext.ToggleDayCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                        CommandParameter="{Binding}"
                                        Tag="{Binding DataContext, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                        ToolTip="{Binding ToolTipText}"
                                        Style="{StaticResource HabitDayButtonStyle}"
                                        PreviewKeyDown="DayButton_PreviewKeyDown">
                                    <Button.ContextMenu>
                                        <ContextMenu>
                                            <MenuItem Header="Mark Done ✓"
                                                      Command="{Binding PlacementTarget.Tag.ToggleDayCommand, RelativeSource={RelativeSource AncestorType=ContextMenu}}"
                                                      CommandParameter="{Binding PlacementTarget.DataContext, RelativeSource={RelativeSource AncestorType=ContextMenu}}" />
                                            <MenuItem Header="Mark Failed ✕"
                                                      Command="{Binding PlacementTarget.Tag.MarkDayFailedCommand, RelativeSource={RelativeSource AncestorType=ContextMenu}}"
                                                      CommandParameter="{Binding PlacementTarget.DataContext, RelativeSource={RelativeSource AncestorType=ContextMenu}}" />
                                            <Separator />
                                            <MenuItem Header="Clear / Reset"
                                                      Command="{Binding PlacementTarget.Tag.ClearDayCommand, RelativeSource={RelativeSource AncestorType=ContextMenu}}"
                                                      CommandParameter="{Binding PlacementTarget.DataContext, RelativeSource={RelativeSource AncestorType=ContextMenu}}" />
                                        </ContextMenu>
                                    </Button.ContextMenu>

                                    <Grid HorizontalAlignment="Stretch" VerticalAlignment="Stretch">
                                        <!-- Done Badge (100% seamless flat fill, zero gaps) -->
                                        <Border x:Name="DoneBadge"
                                                Visibility="Collapsed"
                                                Background="#0B9E76"
                                                CornerRadius="0"
                                                Margin="0"
                                                BorderThickness="0"
                                                RenderOptions.EdgeMode="Aliased"
                                                />

                                        <!-- Failed Badge (100% seamless flat fill, zero gaps) -->
                                        <Border x:Name="FailedBadge"
                                                Visibility="Collapsed"
                                                Background="#E73666"
                                                CornerRadius="0"
                                                Margin="0"
                                                BorderThickness="0"
                                                RenderOptions.EdgeMode="Aliased"
                                                />

                                        <!-- Hover Overlay (Translucent fill, flush rectangular, zero gaps) -->
                                        <Border x:Name="HoverOverlay"
                                                Background="#25FFFFFF"
                                                BorderThickness="0"
                                                CornerRadius="0"
                                                Margin="0"
                                                Opacity="0"
                                                RenderOptions.EdgeMode="Aliased"
                                                />

                                        <!-- Today: Universal 2px Accent Border (Flush Margin 0, Adaptive Color) -->
                                        <Border x:Name="TodayFrame"
                                                BorderThickness="2"
                                                BorderBrush="{DynamicResource SystemAccentColorPrimaryBrush}"
                                                CornerRadius="0"
                                                Margin="0"
                                                Visibility="Collapsed"
                                                IsHitTestVisible="False"
                                                RenderOptions.EdgeMode="Aliased"
                                                />

                                        <!-- Day Number Label -->
                                        <TextBlock x:Name="DayLabel"
                                                   Text="{Binding DayNumber}"
                                                   FontFamily="{DynamicResource AppFontFamily}"
                                                   FontSize="{DynamicResource TypeBodyFontSize}"
                                                   FontWeight="{DynamicResource TypeBodyFontWeight}"
                                                   Foreground="{DynamicResource TextPrimaryBrush}"
                                                   HorizontalAlignment="Center"
                                                   VerticalAlignment="Center"
                                                   />
                                    </Grid>
                                </Button>

                                <DataTemplate.Triggers>
                                    <!-- Days Outside Current Month -->
                                    <DataTrigger Binding="{Binding IsCurrentMonth}" Value="False">
                                        <Setter TargetName="DayLabel" Property="Foreground" Value="#40FFFFFF" />
                                        <Setter TargetName="DayLabel" Property="FontWeight" Value="Normal" />
                                    </DataTrigger>

                                    <!-- Today (Universal 2px Accent Border) -->
                                    <DataTrigger Binding="{Binding IsToday}" Value="True">
                                        <Setter TargetName="TodayFrame" Property="Visibility" Value="Visible" />
                                        <Setter TargetName="DayLabel" Property="FontWeight" Value="Bold" />
                                    </DataTrigger>

                                    <!-- Done -->
                                    <DataTrigger Binding="{Binding IsDone}" Value="True">
                                        <Setter TargetName="DoneBadge" Property="Visibility" Value="Visible" />
                                        <Setter TargetName="DayLabel" Property="Foreground" Value="{DynamicResource TextPrimaryBrush}" />
                                        <Setter TargetName="DayLabel" Property="FontWeight" Value="Bold" />
                                    </DataTrigger>

                                    <!-- Failed -->
                                    <DataTrigger Binding="{Binding IsFailed}" Value="True">
                                        <Setter TargetName="FailedBadge" Property="Visibility" Value="Visible" />
                                        <Setter TargetName="DayLabel" Property="Foreground" Value="{DynamicResource TextPrimaryBrush}" />
                                        <Setter TargetName="DayLabel" Property="FontWeight" Value="Bold" />
                                    </DataTrigger>

                                    <!-- Today & Done: Adaptive Crisp White Frame over Emerald Green -->
                                    <MultiDataTrigger>
                                        <MultiDataTrigger.Conditions>
                                            <Condition Binding="{Binding IsToday}" Value="True" />
                                            <Condition Binding="{Binding IsDone}" Value="True" />
                                        </MultiDataTrigger.Conditions>
                                        <Setter TargetName="TodayFrame" Property="BorderBrush" Value="#FFFFFF" />
                                    </MultiDataTrigger>

                                    <!-- Today & Failed: Adaptive Crisp White Frame over Ruby Red -->
                                    <MultiDataTrigger>
                                        <MultiDataTrigger.Conditions>
                                            <Condition Binding="{Binding IsToday}" Value="True" />
                                            <Condition Binding="{Binding IsFailed}" Value="True" />
                                        </MultiDataTrigger.Conditions>
                                        <Setter TargetName="TodayFrame" Property="BorderBrush" Value="#FFFFFF" />
                                    </MultiDataTrigger>

                                    <!-- Mouse Hover -->
                                    <Trigger Property="IsMouseOver" Value="True">
                                        <Setter TargetName="HoverOverlay" Property="Opacity" Value="1" />
                                    </Trigger>
                                </DataTemplate.Triggers>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </Grid>

                <!-- Row 3: Footer (Habit Title + Streak Badge) -->
                <Grid Grid.Row="3" VerticalAlignment="Center" Margin="2,12,2,2">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>

                    <!-- Habit Name & Icon (Click to configure in-widget) -->
                    <Button Grid.Column="0"
                            Command="{Binding EditHabitCommand}"
                            ToolTip="Configure habit"
                            Background="Transparent"
                            BorderThickness="0"
                            Padding="4,2"
                            Margin="-4,-2,8,-2"
                            HorizontalAlignment="Left"
                            VerticalAlignment="Center"
                            Focusable="False"
                            Cursor="Hand">
                        <Button.Template>
                            <ControlTemplate TargetType="Button">
                                <Border x:Name="Pill"
                                        Background="Transparent"
                                        CornerRadius="{DynamicResource ControlCornerRadius}"
                                        Padding="{TemplateBinding Padding}">
                                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                        <ui:SymbolIcon Symbol="{Binding IconSymbol}"
                                                       FontSize="20"
                                                       Foreground="#0B9E76"
                                                       VerticalAlignment="Center"
                                                       Margin="0,0,7,0" />
                                        <TextBlock Text="{Binding HabitName}"
                                                   FontFamily="{DynamicResource AppDisplayFontFamily}"
                                                   FontSize="{DynamicResource TypeHeaderFontSize}"
                                                   FontWeight="{DynamicResource TypeHeaderFontWeight}"
                                                   Foreground="{DynamicResource TextPrimaryBrush}"
                                                   VerticalAlignment="Center"
                                                   TextTrimming="CharacterEllipsis"
                                                   MaxWidth="180" />
                                        <ui:SymbolIcon x:Name="EditPencil"
                                                       Symbol="Edit16"
                                                       FontSize="12"
                                                       Foreground="{DynamicResource TextSubtleBrush}"
                                                       VerticalAlignment="Center"
                                                       Margin="6,0,0,0"
                                                       Opacity="0" />
                                    </StackPanel>
                                </Border>
                                <ControlTemplate.Triggers>
                                    <Trigger Property="IsMouseOver" Value="True">
                                        <Setter TargetName="Pill" Property="Background" Value="#18FFFFFF" />
                                        <Setter TargetName="EditPencil" Property="Opacity" Value="1" />
                                        <Setter TargetName="EditPencil" Property="Foreground" Value="{DynamicResource TextPrimaryBrush}" />
                                    </Trigger>
                                </ControlTemplate.Triggers>
                            </ControlTemplate>
                        </Button.Template>
                    </Button>

                    <!-- Streak Indicator (Flame logo + warm streak color text) -->
                    <StackPanel Grid.Column="1"
                                Orientation="Horizontal"
                                VerticalAlignment="Center"
                                Margin="0,0,0,0">
                        <ui:SymbolIcon Symbol="Fire24"
                                       FontSize="20"
                                       Foreground="#FF7A00"
                                       VerticalAlignment="Center"
                                       Margin="0,0,7,0"
                                       Visibility="{Binding HasStreak, Converter={StaticResource BoolToVis}}">
                            <ui:SymbolIcon.Effect>
                                <DropShadowEffect BlurRadius="6" ShadowDepth="0" Color="#FF7A00" Opacity="0.85" />
                            </ui:SymbolIcon.Effect>
                        </ui:SymbolIcon>
                        <TextBlock Text="{Binding ActiveStreakText}"
                                   FontFamily="{DynamicResource AppDisplayFontFamily}"
                                   FontSize="{DynamicResource TypeHeaderFontSize}"
                                   FontWeight="{DynamicResource TypeHeaderFontWeight}"
                                   VerticalAlignment="Center"
                                   >
                            <TextBlock.Style>
                                <Style TargetType="TextBlock">
                                    <Setter Property="Foreground" Value="#80FFFFFF" />
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding HasStreak}" Value="True">
                                            <Setter Property="Foreground" Value="#FF7A00" />
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </TextBlock.Style>
                        </TextBlock>
                    </StackPanel>
                </Grid>
            </Grid>

            <!-- ============================================================ -->
            <!-- 2. IN-TILE SETUP CARD (First Drop or Right-Click 'Edit')    -->
            <!-- ============================================================ -->
            <!-- ============================================================ -->
            <!-- 2. IN-TILE SETUP VIEW (Click Habit or Right-Click 'Edit')    -->
            <!-- ============================================================ -->
            <Grid Visibility="{Binding IsSetupMode, Converter={StaticResource BoolToVis}}"
                  >
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" /> <!-- 0: Header (Title + Dismiss '✕') -->
                    <RowDefinition Height="Auto" /> <!-- 1: Habit Name Input -->
                    <RowDefinition Height="Auto" /> <!-- 2: Icon Picker -->
                    <RowDefinition Height="*" />    <!-- 3: Actions (Cancel + Apply) -->
                </Grid.RowDefinitions>

                <!-- Header -->
                <Grid Grid.Row="0" Margin="0,0,0,16">
                    <TextBlock Text="Habit"
                               FontFamily="{DynamicResource AppFontFamily}"
                               FontSize="{DynamicResource TypeHeaderFontSize}"
                               FontWeight="{DynamicResource TypeHeaderFontWeight}"
                               Foreground="{DynamicResource TextPrimaryBrush}"
                               VerticalAlignment="Center" />

                    <Button HorizontalAlignment="Right"
                            Style="{DynamicResource ModalDismissButtonStyle}"
                            Command="{Binding CancelEditHabitCommand}"
                            ToolTip="Close" />
                </Grid>

                <!-- Habit Name Input -->
                <StackPanel Grid.Row="1" Margin="0,0,0,16">
                    <TextBlock Text="Habit Name"
                               FontSize="{DynamicResource TypeCaptionFontSize}"
                               FontWeight="{DynamicResource TypeCaptionFontWeight}"
                               Foreground="{DynamicResource TextMutedBrush}"
                               Margin="0,0,0,6" />
                    <TextBox x:Name="HabitNameInput"
                             controls:InputHelper.Icon="Edit20"
                             Text="{Binding SetupInputName, UpdateSourceTrigger=PropertyChanged}"
                             KeyDown="HabitNameInput_KeyDown" />
                </StackPanel>

                <!-- Icon Preset Picker -->
                <StackPanel Grid.Row="2" Margin="0,0,0,16">
                    <TextBlock Text="Choose Icon"
                               FontSize="{DynamicResource TypeCaptionFontSize}"
                               FontWeight="{DynamicResource TypeCaptionFontWeight}"
                               Foreground="{DynamicResource TextMutedBrush}"
                               Margin="0,0,0,6" />
                    <WrapPanel Orientation="Horizontal">
                        <Button Style="{StaticResource HabitIconChoiceButtonStyle}"
                                Command="{Binding SelectIconCommand}" CommandParameter="TargetArrow24" ToolTip="Target Arrow">
                            <ui:SymbolIcon Symbol="TargetArrow24" FontSize="16" Foreground="{DynamicResource TextPrimaryBrush}" />
                        </Button>

                        <Button Style="{StaticResource HabitIconChoiceButtonStyle}"
                                Command="{Binding SelectIconCommand}" CommandParameter="PersonRunning20" ToolTip="Running">
                            <ui:SymbolIcon Symbol="PersonRunning20" FontSize="16" Foreground="{DynamicResource TextPrimaryBrush}" />
                        </Button>

                        <Button Style="{StaticResource HabitIconChoiceButtonStyle}"
                                Command="{Binding SelectIconCommand}" CommandParameter="Book24" ToolTip="Reading">
                            <ui:SymbolIcon Symbol="Book24" FontSize="16" Foreground="{DynamicResource TextPrimaryBrush}" />
                        </Button>

                        <Button Style="{StaticResource HabitIconChoiceButtonStyle}"
                                Command="{Binding SelectIconCommand}" CommandParameter="Code24" ToolTip="Coding">
                            <ui:SymbolIcon Symbol="Code24" FontSize="16" Foreground="{DynamicResource TextPrimaryBrush}" />
                        </Button>

                        <Button Style="{StaticResource HabitIconChoiceButtonStyle}"
                                Command="{Binding SelectIconCommand}" CommandParameter="BrainCircuit24" ToolTip="Brain / Mind">
                            <ui:SymbolIcon Symbol="BrainCircuit24" FontSize="16" Foreground="{DynamicResource TextPrimaryBrush}" />
                        </Button>

                        <Button Style="{StaticResource HabitIconChoiceButtonStyle}"
                                Command="{Binding SelectIconCommand}" CommandParameter="Prohibited24" ToolTip="Avoid / Prohibited">
                            <ui:SymbolIcon Symbol="Prohibited24" FontSize="16" Foreground="{DynamicResource TextPrimaryBrush}" />
                        </Button>

                        <Button Style="{StaticResource HabitIconChoiceButtonStyle}"
                                Command="{Binding SelectIconCommand}" CommandParameter="Dumbbell24" ToolTip="Workout">
                            <ui:SymbolIcon Symbol="Dumbbell24" FontSize="16" Foreground="{DynamicResource TextPrimaryBrush}" />
                        </Button>

                        <Button Style="{StaticResource HabitIconChoiceButtonStyle}"
                                Command="{Binding SelectIconCommand}" CommandParameter="Drop24" ToolTip="Hydration">
                            <ui:SymbolIcon Symbol="Drop24" FontSize="16" Foreground="{DynamicResource TextPrimaryBrush}" />
                        </Button>
                    </WrapPanel>
                </StackPanel>

                <!-- Actions: Add Button -->
                <Grid Grid.Row="3" VerticalAlignment="Bottom">
                    <Button Content="Add"
                            Command="{Binding StartHabitCommand}"
                            Style="{DynamicResource AccentButtonStyle}"
                            Height="30"
                            MinWidth="80"
                            HorizontalAlignment="Right" />
                </Grid>
            </Grid>
        </Grid>
    </widgets:WidgetCard>
</UserControl>
