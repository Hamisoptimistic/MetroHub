<UserControl x:Class="MetroHub.Widgets.Catalog.Media.MediaWidgetView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:po="http://schemas.microsoft.com/winfx/2006/xaml/presentation/options"
             xmlns:widgets="clr-namespace:MetroHub.Widgets"
             xmlns:media="clr-namespace:MetroHub.Widgets.Catalog.Media"
             mc:Ignorable="d po" 
             d:DataContext="{d:DesignInstance Type=media:MediaWidgetViewModel}"
             Focusable="False"
             SnapsToDevicePixels="True"
             UseLayoutRounding="True"
             TextOptions.TextFormattingMode="Ideal"
             TextOptions.TextRenderingMode="ClearType"
             TextOptions.TextHintingMode="Fixed"
             RenderOptions.ClearTypeHint="Enabled">

    <UserControl.Resources>
        <BooleanToVisibilityConverter x:Key="BoolToVis" />

        <!-- Media Transport Button Style: Inherits FluentGhostButtonStyle (2px Corner Radius, unified sidebar hover) -->
        <Style x:Key="MediaTransportButtonStyle" TargetType="Button" BasedOn="{StaticResource FluentGhostButtonStyle}">
            <Setter Property="Width" Value="32" />
            <Setter Property="Height" Value="28" />
            <Setter Property="Padding" Value="0" />
            <Setter Property="Focusable" Value="False" />
        </Style>


    </UserControl.Resources>

    <!-- Transparent WidgetCard to inherit the exact glass/acrylic tile background of other tiles -->
    <widgets:WidgetCard Padding="0" Background="Transparent" CornerRadius="2">
        <Grid SnapsToDevicePixels="True" UseLayoutRounding="True" ClipToBounds="True">
            <!-- ============================================================= -->
            <!-- 1. STANDARD LAYOUT (6x2, 8x3, 8x4)                            -->
            <!-- ============================================================= -->
            <Grid Visibility="{Binding IsStandardMode, Converter={StaticResource BoolToVis}}"
                  SnapsToDevicePixels="True" UseLayoutRounding="True">
                <Grid.RowDefinitions>
                    <RowDefinition Height="*" />    <!-- Row 0: Track Info + Album Art -->
                    <RowDefinition Height="38" />   <!-- Row 1: Fluent Acrylic Strip: Sound Source (Left) + Controls (Far Right) -->
                </Grid.RowDefinitions>

                <!-- Row 0: Top Section (Track Info + Elevated Album Art) -->
                <Grid Grid.Row="0">
                    <!-- Album Art Container on Right Side -->
                    <Grid HorizontalAlignment="Right"
                          VerticalAlignment="Center"
                          Margin="{Binding AlbumArtMargin}">

                        <!-- 1. Album Cover with Guaranteed 2px Rounded Corners matching Tiles -->
                        <Border Width="{Binding AlbumArtSize}"
                                Height="{Binding AlbumArtSize}"
                                CornerRadius="2"
                                BorderBrush="#38FFFFFF"
                                BorderThickness="1"
                                SnapsToDevicePixels="True"
                                UseLayoutRounding="True"
                                RenderOptions.BitmapScalingMode="Fant"
                                Visibility="{Binding HasThumbnail, Converter={StaticResource BoolToVis}}">
                            <Border.Background>
                                <ImageBrush ImageSource="{Binding Thumbnail, TargetNullValue={x:Null}, FallbackValue={x:Null}}"
                                            Stretch="UniformToFill"
                                            RenderOptions.BitmapScalingMode="Fant" />
                            </Border.Background>
                        </Border>

                        <!-- 2. Fallback Watermark Box when no album art is available -->
                        <Border Width="{Binding AlbumArtSize}"
                                Height="{Binding AlbumArtSize}"
                                CornerRadius="2"
                                Background="#14FFFFFF"
                                BorderBrush="#20FFFFFF"
                                BorderThickness="1"
                                SnapsToDevicePixels="True"
                                UseLayoutRounding="True">
                            <Border.Style>
                                <Style TargetType="Border">
                                    <Setter Property="Visibility" Value="Collapsed" />
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding HasThumbnail}" Value="False">
                                            <Setter Property="Visibility" Value="Visible" />
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </Border.Style>
                            <TextBlock Text="&#xE8D6;"
                                       FontFamily="{DynamicResource AppIconFontFamily}"
                                       FontSize="{Binding FallbackWatermarkFontSize}"
                                       Foreground="#25FFFFFF"
                                       HorizontalAlignment="Center"
                                       VerticalAlignment="Center" />
                        </Border>
                    </Grid>

                    <!-- Left Content: Track Title, Artist, Album/Feature -->
                    <Grid HorizontalAlignment="Left"
                          VerticalAlignment="Center"
                          Margin="{Binding TrackInfoMargin}">
                        <StackPanel>
                            <!-- Track Title -->
                            <TextBlock Text="{Binding Title}"
                                       FontSize="{Binding TrackTitleFontSize}"
                                       FontWeight="SemiBold"
                                       FontFamily="{DynamicResource AppDisplayFontFamily}"
                                       Foreground="#FFFFFF"
                                       TextTrimming="CharacterEllipsis"
                                       TextWrapping="NoWrap"
                                       Margin="0,0,0,3" />

                            <!-- Artist Name -->
                            <TextBlock Text="{Binding Artist}"
                                       FontSize="{Binding ArtistFontSize}"
                                       FontWeight="Normal"
                                       Foreground="#D2D7E2"
                                       TextTrimming="CharacterEllipsis"
                                       TextWrapping="NoWrap"
                                       Margin="0,0,0,4">
                                <TextBlock.Style>
                                    <Style TargetType="TextBlock">
                                        <Setter Property="Visibility" Value="Visible" />
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding Artist}" Value="">
                                                <Setter Property="Visibility" Value="Collapsed" />
                                            </DataTrigger>
                                            <DataTrigger Binding="{Binding Artist}" Value="{x:Null}">
                                                <Setter Property="Visibility" Value="Collapsed" />
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </TextBlock.Style>
                            </TextBlock>

                            <!-- Album / Feature Detail with Note Glyph (♫) -->
                            <StackPanel Orientation="Horizontal"
                                        Visibility="{Binding ShowAlbumRow, Converter={StaticResource BoolToVis}}"
                                        Margin="0,1,0,0">
                                <TextBlock Text="&#xE8D6;"
                                           FontFamily="{DynamicResource AppIconFontFamily}"
                                           FontSize="11"
                                           Foreground="#9DA5B4"
                                           VerticalAlignment="Center"
                                           Margin="0,1,6,0" />
                                <TextBlock Text="{Binding Album}"
                                           FontSize="13"
                                           FontWeight="Normal"
                                           Foreground="#9DA5B4"
                                           TextTrimming="CharacterEllipsis"
                                           TextWrapping="NoWrap"
                                           VerticalAlignment="Center" />
                            </StackPanel>
                        </StackPanel>
                    </Grid>
                </Grid>

                <!-- Row 1: Bottom Docked Bar: Transport Controls + Source Readout -->
                <Border Grid.Row="1"
                        Background="#14000000"
                        BorderThickness="0"
                        CornerRadius="0,0,2,2"
                        SnapsToDevicePixels="True"
                        Padding="{Binding PlaybackBarPadding}">
                    <Grid>
                        <!-- Transport Controls (< ▷ >) Aligned with Title Name on Left -->
                        <StackPanel Orientation="Horizontal"
                                    HorizontalAlignment="Left"
                                    VerticalAlignment="Center"
                                    Margin="{Binding TransportControlsMargin}">
                            <!-- Previous Track (<) -->
                            <Button Style="{StaticResource MediaTransportButtonStyle}"
                                    Command="{Binding SkipPreviousCommand}"
                                    IsEnabled="{Binding CanSkipPrevious}"
                                    ToolTip="Previous">
                                <TextBlock Text="&#xE76B;"
                                           FontFamily="{DynamicResource AppIconFontFamily}"
                                           FontSize="15"
                                           VerticalAlignment="Center"
                                           HorizontalAlignment="Center" />
                            </Button>

                            <!-- Play / Pause (▷ or ||) -->
                            <Button Style="{StaticResource MediaTransportButtonStyle}"
                                    Command="{Binding TogglePlayPauseCommand}"
                                    IsEnabled="{Binding CanPlayPause}"
                                    Margin="4,0"
                                    ToolTip="Play / Pause">
                                <TextBlock x:Name="PlayPauseIcon"
                                           FontFamily="{DynamicResource AppIconFontFamily}"
                                           VerticalAlignment="Center"
                                           HorizontalAlignment="Center">
                                    <TextBlock.Style>
                                        <Style TargetType="TextBlock">
                                            <Setter Property="Text" Value="&#xE768;" />
                                            <Setter Property="FontSize" Value="15" />
                                            <Setter Property="Margin" Value="0" />
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding IsPlaying}" Value="True">
                                                    <Setter Property="Text" Value="&#xE769;" />
                                                    <Setter Property="FontSize" Value="16" />
                                                    <Setter Property="Margin" Value="0" />
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </TextBlock.Style>
                                </TextBlock>
                            </Button>

                            <!-- Next Track (>) -->
                            <Button Style="{StaticResource MediaTransportButtonStyle}"
                                    Command="{Binding SkipNextCommand}"
                                    IsEnabled="{Binding CanSkipNext}"
                                    ToolTip="Next">
                                <TextBlock Text="&#xE76C;"
                                           FontFamily="{DynamicResource AppIconFontFamily}"
                                           FontSize="15"
                                           VerticalAlignment="Center"
                                           HorizontalAlignment="Center" />
                            </Button>
                        </StackPanel>

                        <!-- Source Badge on Right (e.g. Spotify / YouTube / Brave) -->
                        <TextBlock Text="{Binding SourceName}"
                                   VerticalAlignment="Center"
                                   HorizontalAlignment="Right"
                                   FontSize="12"
                                   Foreground="#FFFFFF"
                                   SnapsToDevicePixels="True"
                                   Visibility="{Binding HasMedia, Converter={StaticResource BoolToVis}}" />
                    </Grid>
                </Border>
            </Grid>

            <!-- ============================================================= -->
            <!-- 2. SLIM CONTROLLER LAYOUT (4x1: 248x56px)                     -->
            <!-- [ ▷ Play ] ========== Track Title / Artist ========== [ < > ] -->
            <!-- ============================================================= -->
            <Grid Visibility="{Binding IsSlimMode, Converter={StaticResource BoolToVis}}"
                  Margin="14,0,14,0"
                  VerticalAlignment="Center"
                  SnapsToDevicePixels="True"
                  UseLayoutRounding="True">
                <Grid.ColumnDefinitions>
                    <!-- Col 0: Single Play/Pause Button -->
                    <ColumnDefinition Width="Auto" />
                    <!-- Col 1: Center Area (Track info or 'No media playing' label) -->
                    <ColumnDefinition Width="*" />
                    <!-- Col 2: Previous & Next Buttons -->
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <!-- Col 0: Play/Pause Button -->
                <Button Grid.Column="0"
                        Style="{StaticResource MediaTransportButtonStyle}"
                        Command="{Binding TogglePlayPauseCommand}"
                        IsEnabled="{Binding CanPlayPause}"
                        VerticalAlignment="Center"
                        HorizontalAlignment="Left"
                        ToolTip="Play / Pause">
                    <TextBlock FontFamily="{DynamicResource AppIconFontFamily}"
                               VerticalAlignment="Center"
                               HorizontalAlignment="Center">
                        <TextBlock.Style>
                            <Style TargetType="TextBlock">
                                <Setter Property="Text" Value="&#xE768;" />
                                <Setter Property="FontSize" Value="15" />
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding IsPlaying}" Value="True">
                                        <Setter Property="Text" Value="&#xE769;" />
                                        <Setter Property="FontSize" Value="16" />
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </TextBlock.Style>
                    </TextBlock>
                </Button>

                <!-- Col 1: Center Area -->
                <Grid Grid.Column="1" Margin="10,0,10,0" VerticalAlignment="Center">
                    <!-- Idle State: 'No media playing' subtle text -->
                    <TextBlock Text="No media playing"
                               FontSize="12"
                               FontWeight="Normal"
                               Foreground="#55FFFFFF"
                               FontFamily="{DynamicResource AppDisplayFontFamily}"
                               HorizontalAlignment="Center"
                               VerticalAlignment="Center"
                               TextTrimming="CharacterEllipsis"
                               Visibility="{Binding HasNoMedia, Converter={StaticResource BoolToVis}}" />

                    <!-- Active State: Track Title & Artist -->
                    <StackPanel VerticalAlignment="Center"
                                Visibility="{Binding HasMedia, Converter={StaticResource BoolToVis}}">
                        <TextBlock Text="{Binding Title}"
                                   FontSize="12.5"
                                   FontWeight="SemiBold"
                                   Foreground="#FFFFFF"
                                   FontFamily="{DynamicResource AppDisplayFontFamily}"
                                   TextTrimming="CharacterEllipsis"
                                   TextWrapping="NoWrap" />
                        <TextBlock Text="{Binding Artist}"
                                   FontSize="11"
                                   Foreground="#CAD7EA"
                                   TextTrimming="CharacterEllipsis"
                                   TextWrapping="NoWrap"
                                   Margin="0,1,0,0">
                            <TextBlock.Style>
                                <Style TargetType="TextBlock">
                                    <Setter Property="Visibility" Value="Visible" />
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding Artist}" Value="">
                                            <Setter Property="Visibility" Value="Collapsed" />
                                        </DataTrigger>
                                        <DataTrigger Binding="{Binding Artist}" Value="{x:Null}">
                                            <Setter Property="Visibility" Value="Collapsed" />
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </TextBlock.Style>
                        </TextBlock>
                    </StackPanel>
                </Grid>

                <!-- Col 2: Previous & Next Buttons -->
                <StackPanel Grid.Column="2"
                            Orientation="Horizontal"
                            VerticalAlignment="Center"
                            Visibility="{Binding HasMedia, Converter={StaticResource BoolToVis}}">
                    <Button Style="{StaticResource MediaTransportButtonStyle}"
                            Command="{Binding SkipPreviousCommand}"
                            IsEnabled="{Binding CanSkipPrevious}"
                            Width="26"
                            Height="26"
                            ToolTip="Previous">
                        <TextBlock Text="&#xE76B;"
                                   FontFamily="{DynamicResource AppIconFontFamily}"
                                   FontSize="13"
                                   VerticalAlignment="Center"
                                   HorizontalAlignment="Center" />
                    </Button>
                    <Button Style="{StaticResource MediaTransportButtonStyle}"
                            Command="{Binding SkipNextCommand}"
                            IsEnabled="{Binding CanSkipNext}"
                            Width="26"
                            Height="26"
                            Margin="2,0,0,0"
                            ToolTip="Next">
                        <TextBlock Text="&#xE76C;"
                                   FontFamily="{DynamicResource AppIconFontFamily}"
                                   FontSize="13"
                                   VerticalAlignment="Center"
                                   HorizontalAlignment="Center" />
                    </Button>
                </StackPanel>
            </Grid>

            <!-- ============================================================= -->
            <!-- 3. AUTHENTIC ZUNE HANDHELD HARDWARE LAYOUT (4x6: 248x376px)   -->
            <!-- ============================================================= -->
            <Grid Visibility="{Binding IsZuneMode, Converter={StaticResource BoolToVis}}"
                  SnapsToDevicePixels="True"
                  UseLayoutRounding="True">
                <Grid.RowDefinitions>
                    <!-- Row 0: Upper Screen / Artwork (Edge-to-Edge Full 1:1 Square 248x248) -->
                    <RowDefinition Height="248" />
                    <!-- Row 1: Bottom Translucent Acrylic Chin with Controls & Track Details (128px) -->
                    <RowDefinition Height="*" />
                </Grid.RowDefinitions>

                <!-- ========================================================= -->
                <!-- ROW 0: UPPER GLOSSY GLASS DISPLAY SCREEN (EDGE-TO-EDGE)   -->
                <!-- ========================================================= -->
                <Grid Grid.Row="0" SnapsToDevicePixels="True" ClipToBounds="True">
                    <!-- A. Idle / Standby Sleep Screen: Deep OLED black + authentic vector Zune logo & wordmark -->
                    <Grid Visibility="{Binding HasNoMedia, Converter={StaticResource BoolToVis}}"
                          Background="#05070A">
                        <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center">
                            <!-- Official Zune Geometric Vector Logo -->
                            <Path Width="60" Height="68"
                                  Stretch="Uniform"
                                  HorizontalAlignment="Center"
                                  Margin="0,0,0,10"
                                  SnapsToDevicePixels="True"
                                  Data="m 158.423,60.824 c 2.102,-3.708 4.078,-8.157 -2.594,-11.987 -6.674,-3.833 -53.26,-31.142 -59.687,-35.094 l -0.247,0.123 c -2.967,-1.484 -9.022,-4.328 -14.704,-0.62 -5.686,3.709 -49.06,29.164 -56.845,33.737 -7.784,4.574 -5.438,10.626 -1.484,12.975 3.957,2.347 14.954,9.022 18.414,11.367 3.458,2.35 6.548,5.191 3.583,10.259 -2.967,5.068 -22.243,38.676 -26.197,45.104 -3.956,6.426 -1.976,11.615 2.843,14.581 4.817,2.966 51.531,29.904 57.091,33.119 5.561,3.213 10.996,4.446 16.311,1.603 5.314,-2.842 53.014,-31.014 58.945,-34.6 5.931,-3.583 3.089,-9.514 0.493,-11.122 -2.595,-1.605 -15.818,-10.255 -20.884,-13.467 -5.065,-3.214 -4.571,-5.316 -1.854,-10.134 2.615,-4.636 24.715,-42.137 26.816,-45.844 z M 45.861,66.106 C 43.409,64.796 34.372,59.512 32.068,58.078 27.744,55.39 29.114,51.237 32.091,49.723 35.068,48.21 65.55,30.792 69.14,29.133 c 3.036,-1.402 5.966,1.067 3.863,4.923 -1.328,2.438 -14.879,25.373 -17.353,29.576 -2.468,4.201 -5.769,4.62 -9.789,2.474 z m -12.173,49.24 c 1.299,-2.455 14.563,-25.557 16.983,-29.79 2.418,-4.23 5.713,-4.691 9.761,-2.596 2.467,1.282 11.569,6.455 13.889,7.86 4.357,2.634 3.039,6.801 0.083,8.354 -2.957,1.547 -33.224,19.342 -36.791,21.045 -3.02,1.442 -5.978,-0.994 -3.925,-4.873 z m 50.942,46.642 c -0.263,4.448 -3.782,6.505 -10.181,2.664 -6.4,-3.847 -38.498,-22.01 -42.52,-24.237 -4.023,-2.228 -6.146,-5.854 -0.643,-8.93 5.502,-3.074 40.188,-23.075 45.14,-26.113 4.951,-3.041 8.5,-1.54 8.445,4.65 -0.068,8.203 0.02,47.519 -0.241,51.966 z m 0.223,-81.259 c 0.127,3.336 -2.834,6.552 -7.285,4.086 -2.375,-1.316 -11.392,-6.638 -13.725,-8.14 -3.835,-2.467 -5.076,-5.556 -2.608,-9.759 2.467,-4.205 15.904,-27.207 17.387,-29.555 2.344,-3.71 5.93,-2.357 6.182,0.979 0.296,3.943 -0.078,39.052 0.049,42.389 z m 6.965,-52.53 c -0.124,-5.806 2.963,-8.114 8.278,-4.943 7.044,4.204 41.024,23.974 44.732,26.445 3.707,2.473 3.707,6.55 -2.842,10.133 -6.55,3.585 -38.432,22.12 -42.384,24.468 -3.955,2.349 -8.157,2.349 -8.033,-3.955 0.124,-6.304 0.372,-46.341 0.249,-52.148 z m 0,123.079 c -0.293,-3.944 0.123,-39.05 0,-42.386 -0.124,-3.338 2.842,-6.549 7.291,-4.079 2.369,1.318 11.382,6.651 13.716,8.157 3.829,2.472 5.065,5.562 2.596,9.763 -2.473,4.202 -15.938,27.188 -17.425,29.533 -2.348,3.708 -5.931,2.348 -6.178,-0.988 z m 38.975,-27.716 c 2.449,1.311 11.481,6.608 13.781,8.045 4.322,2.694 2.948,6.845 -0.031,8.355 -2.981,1.509 -33.484,18.887 -37.074,20.543 -3.038,1.399 -5.966,-1.076 -3.86,-4.928 1.331,-2.438 14.909,-25.354 17.387,-29.555 2.477,-4.197 5.778,-4.612 9.797,-2.46 z m -4.785,-19.458 c -2.425,4.229 -5.721,4.686 -9.767,2.584 -2.463,-1.285 -11.56,-6.467 -13.881,-7.875 -4.351,-2.638 -3.03,-6.806 -0.071,-8.352 2.961,-1.546 33.249,-19.304 36.817,-21.005 3.02,-1.436 5.979,1.002 3.922,4.879 -1.304,2.454 -14.595,25.54 -17.02,29.769 z">
                                <Path.Fill>
                                    <LinearGradientBrush StartPoint="0.5,0" EndPoint="0.5,1">
                                        <GradientStop Color="#E64E8D" Offset="0.0" />
                                        <GradientStop Color="#EA6C76" Offset="0.35" />
                                        <GradientStop Color="#EC7D63" Offset="0.65" />
                                        <GradientStop Color="#EE9037" Offset="1.0" />
                                    </LinearGradientBrush>
                                </Path.Fill>
                            </Path>

                            <!-- Authentic Zune Wordmark -->
                            <TextBlock Text="zune"
                                       FontFamily="{DynamicResource AppDisplayFontFamily}"
                                       FontSize="38"
                                       FontWeight="Light"
                                       Foreground="#80FFFFFF"
                                       HorizontalAlignment="Center"
                                       TextAlignment="Center"
                                       SnapsToDevicePixels="True" />
                        </StackPanel>
                    </Grid>

                    <!-- B. Active Media Screen: Full-Bleed High-Res Artwork (Clean, No Overlay) -->
                    <Grid Visibility="{Binding HasMedia, Converter={StaticResource BoolToVis}}">
                        <!-- High-Res Album Art filling the screen window edge-to-edge -->
                        <Border Background="#0A0D12" SnapsToDevicePixels="True">
                            <Image Source="{Binding Thumbnail}"
                                   Stretch="UniformToFill"
                                   HorizontalAlignment="Center"
                                   VerticalAlignment="Center"
                                   RenderOptions.BitmapScalingMode="Fant"
                                   SnapsToDevicePixels="True"
                                   Visibility="{Binding HasThumbnail, Converter={StaticResource BoolToVis}}" />
                        </Border>

                        <!-- Fallback Artwork Placeholder when HasThumbnail is false -->
                        <Border Background="#10141C" SnapsToDevicePixels="True">
                            <Border.Style>
                                <Style TargetType="Border">
                                    <Setter Property="Visibility" Value="Collapsed" />
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding HasThumbnail}" Value="False">
                                            <Setter Property="Visibility" Value="Visible" />
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </Border.Style>
                            <TextBlock Text="&#xE8D6;"
                                       FontFamily="{DynamicResource AppIconFontFamily}"
                                       FontSize="48"
                                       Foreground="#18FFFFFF"
                                       HorizontalAlignment="Center"
                                       VerticalAlignment="Center" />
                        </Border>
                    </Grid>

                    <!-- C. Authentic Diagonal Glass Glare Reflection -->
                    <Rectangle IsHitTestVisible="False" SnapsToDevicePixels="True">
                        <Rectangle.Fill>
                            <LinearGradientBrush StartPoint="0.1,0" EndPoint="0.85,1">
                                <GradientStop Color="#25FFFFFF" Offset="0.0" />
                                <GradientStop Color="#10FFFFFF" Offset="0.22" />
                                <GradientStop Color="#00FFFFFF" Offset="0.50" />
                            </LinearGradientBrush>
                        </Rectangle.Fill>
                    </Rectangle>
                </Grid>

                <!-- ========================================================= -->
                <!-- ROW 1: TRANSLUCENT ACRYLIC CHIN (PHYSICAL CONTROLS)       -->
                <!-- ========================================================= -->
                <Border Grid.Row="1"
                        CornerRadius="0,0,2,2"
                        SnapsToDevicePixels="True">
                    <Border.Background>
                        <LinearGradientBrush StartPoint="0,0" EndPoint="0,1">
                            <GradientStop Color="#1CFFFFFF" Offset="0.0" />
                            <GradientStop Color="#08FFFFFF" Offset="0.4" />
                            <GradientStop Color="#14000000" Offset="1.0" />
                        </LinearGradientBrush>
                    </Border.Background>

                    <Grid VerticalAlignment="Center" HorizontalAlignment="Stretch" Margin="16,4,16,6">
                        <Grid.RowDefinitions>
                            <!-- Row 0: Track Information (Title, Artist) -->
                            <RowDefinition Height="Auto" />
                            <!-- Row 1: Transport Controls (Prev, Play/Pause, Next) -->
                            <RowDefinition Height="Auto" />
                        </Grid.RowDefinitions>

                        <!-- Track Details placed cleanly below the artwork -->
                        <StackPanel Grid.Row="0" HorizontalAlignment="Center" Margin="0,4,0,8">
                            <!-- Song Title -->
                            <TextBlock Text="{Binding Title}"
                                       FontFamily="{DynamicResource AppDisplayFontFamily}"
                                       FontSize="15"
                                       FontWeight="SemiBold"
                                       Foreground="#FFFFFF"
                                       TextTrimming="CharacterEllipsis"
                                       TextWrapping="NoWrap"
                                       HorizontalAlignment="Center"
                                       TextAlignment="Center"
                                       MaxWidth="216"
                                       ToolTip="{Binding Title}"
                                       SnapsToDevicePixels="True" />

                            <!-- Artist Name -->
                            <TextBlock Text="{Binding Artist}"
                                       FontFamily="{DynamicResource AppDisplayFontFamily}"
                                       FontSize="13.5"
                                       FontWeight="Normal"
                                       Foreground="#CAD7EA"
                                       TextTrimming="CharacterEllipsis"
                                       TextWrapping="NoWrap"
                                       HorizontalAlignment="Center"
                                       TextAlignment="Center"
                                       MaxWidth="216"
                                       Margin="0,2,0,0"
                                       ToolTip="{Binding Artist}"
                                       SnapsToDevicePixels="True">
                                <TextBlock.Style>
                                    <Style TargetType="TextBlock">
                                        <Setter Property="Visibility" Value="Visible" />
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding Artist}" Value="">
                                                <Setter Property="Visibility" Value="Collapsed" />
                                            </DataTrigger>
                                            <DataTrigger Binding="{Binding Artist}" Value="{x:Null}">
                                                <Setter Property="Visibility" Value="Collapsed" />
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </TextBlock.Style>
                            </TextBlock>
                        </StackPanel>

                        <!-- Clean Transport Controls (Prev, Play/Pause, Next) -->
                        <StackPanel Grid.Row="1"
                                    Orientation="Horizontal"
                                    HorizontalAlignment="Center"
                                    VerticalAlignment="Center">
                            <!-- Left Button: Backward / Previous Track -->
                            <Button Style="{StaticResource MediaTransportButtonStyle}"
                                    Command="{Binding SkipPreviousCommand}"
                                    IsEnabled="{Binding CanSkipPrevious}"
                                    ToolTip="Previous Track"
                                    Width="36"
                                    Height="32"
                                    VerticalAlignment="Center"
                                    Margin="0,0,12,0">
                                <TextBlock Text="&#xE76B;"
                                           FontFamily="{DynamicResource AppIconFontFamily}"
                                           FontSize="15"
                                           Foreground="#CAD7EA"
                                           VerticalAlignment="Center"
                                           HorizontalAlignment="Center" />
                            </Button>

                            <!-- Center: Play / Pause Button -->
                            <Button Style="{StaticResource MediaTransportButtonStyle}"
                                    Command="{Binding TogglePlayPauseCommand}"
                                    IsEnabled="{Binding CanPlayPause}"
                                    ToolTip="Play / Pause"
                                    Width="40"
                                    Height="34"
                                    VerticalAlignment="Center">
                                <TextBlock FontFamily="{DynamicResource AppIconFontFamily}"
                                           FontSize="18"
                                           Foreground="#FFFFFF"
                                           VerticalAlignment="Center"
                                           HorizontalAlignment="Center">
                                    <TextBlock.Style>
                                        <Style TargetType="TextBlock">
                                            <Setter Property="Text" Value="&#xE768;" />
                                            <Setter Property="Margin" Value="1,0,0,0" />
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding IsPlaying}" Value="True">
                                                    <Setter Property="Text" Value="&#xE769;" />
                                                    <Setter Property="Margin" Value="0" />
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </TextBlock.Style>
                                </TextBlock>
                            </Button>

                            <!-- Right Button: Forward / Next Track -->
                            <Button Style="{StaticResource MediaTransportButtonStyle}"
                                    Command="{Binding SkipNextCommand}"
                                    IsEnabled="{Binding CanSkipNext}"
                                    ToolTip="Next Track"
                                    Width="36"
                                    Height="32"
                                    VerticalAlignment="Center"
                                    Margin="12,0,0,0">
                                <TextBlock Text="&#xE76C;"
                                           FontFamily="{DynamicResource AppIconFontFamily}"
                                           FontSize="15"
                                           Foreground="#CAD7EA"
                                           VerticalAlignment="Center"
                                           HorizontalAlignment="Center" />
                            </Button>
                        </StackPanel>
                    </Grid>
                </Border>
            </Grid>
        </Grid>
    </widgets:WidgetCard>
</UserControl>
