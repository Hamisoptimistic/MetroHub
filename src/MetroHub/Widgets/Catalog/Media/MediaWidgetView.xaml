<UserControl x:Class="MetroHub.Widgets.Catalog.Media.MediaWidgetView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:widgets="clr-namespace:MetroHub.Widgets"
             xmlns:media="clr-namespace:MetroHub.Widgets.Catalog.Media"
             mc:Ignorable="d" 
             d:DataContext="{d:DesignInstance Type=media:MediaWidgetViewModel}"
             Focusable="False"
             SnapsToDevicePixels="True"
             UseLayoutRounding="True"
             TextOptions.TextFormattingMode="Ideal"
             TextOptions.TextRenderingMode="ClearType"
             TextOptions.TextHintingMode="Fixed">

    <UserControl.Resources>
        <BooleanToVisibilityConverter x:Key="BoolToVis" />

        <!-- Media Transport Button Style: Fluent Acrylic Button with 2px Corner Radius -->
        <Style x:Key="MediaTransportButtonStyle" TargetType="Button">
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="Foreground" Value="#E5E9F0" />
            <Setter Property="Width" Value="32" />
            <Setter Property="Height" Value="28" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Focusable" Value="False" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Border"
                                Background="{TemplateBinding Background}"
                                CornerRadius="2"
                                SnapsToDevicePixels="True">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Border" Property="Background" Value="#25FFFFFF" />
                                <Setter Property="Foreground" Value="#FFFFFF" />
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="Border" Property="Background" Value="#45FFFFFF" />
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter Property="Opacity" Value="0.3" />
                                <Setter Property="Cursor" Value="Arrow" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </UserControl.Resources>

    <!-- Transparent WidgetCard to inherit the exact glass/acrylic tile background of other tiles -->
    <widgets:WidgetCard Padding="0" Background="Transparent" CornerRadius="2">
        <Grid SnapsToDevicePixels="True" UseLayoutRounding="True" ClipToBounds="True">
            <Grid.RowDefinitions>
                <RowDefinition Height="*" />    <!-- Row 0: Track Info + Album Art -->
                <RowDefinition Height="38" />   <!-- Row 1: Fluent Acrylic Strip: Sound Source (Left) + Controls (Far Right) -->
            </Grid.RowDefinitions>

            <!-- Row 0: Top Section (Track Info + Elevated Album Art) -->
            <Grid Grid.Row="0">
                <!-- Album Art Container on Right Side -->
                <Grid HorizontalAlignment="Right"
                      VerticalAlignment="Center"
                      Margin="0,0,20,0">

                    <!-- 1. Album Cover with Guaranteed 2px Rounded Corners matching Tiles -->
                    <Border Width="{Binding AlbumArtSize}"
                            Height="{Binding AlbumArtSize}"
                            CornerRadius="2"
                            BorderBrush="#38FFFFFF"
                            BorderThickness="1"
                            SnapsToDevicePixels="True"
                            UseLayoutRounding="True"
                            Visibility="{Binding HasThumbnail, Converter={StaticResource BoolToVis}}">
                        <Border.Background>
                            <ImageBrush ImageSource="{Binding Thumbnail}" Stretch="UniformToFill" />
                        </Border.Background>
                    </Border>

                    <!-- 2. Fallback Watermark Box when no album art is available -->
                    <Border Width="{Binding AlbumArtSize}"
                            Height="{Binding AlbumArtSize}"
                            CornerRadius="2"
                            Background="#14FFFFFF"
                            BorderBrush="#20FFFFFF"
                            BorderThickness="1"
                            SnapsToDevicePixels="True"
                            UseLayoutRounding="True">
                        <Border.Style>
                            <Style TargetType="Border">
                                <Setter Property="Visibility" Value="Collapsed" />
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding HasThumbnail}" Value="False">
                                        <Setter Property="Visibility" Value="Visible" />
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </Border.Style>
                        <TextBlock Text="&#xE8D6;"
                                   FontFamily="Segoe MDL2 Assets"
                                   FontSize="36"
                                   Foreground="#25FFFFFF"
                                   HorizontalAlignment="Center"
                                   VerticalAlignment="Center" />
                    </Border>
                </Grid>

                <!-- Left Content: Track Title, Artist, Album/Feature -->
                <Grid HorizontalAlignment="Left"
                      VerticalAlignment="Center"
                      Margin="20,0,175,0">
                    <StackPanel>
                        <!-- Track Title -->
                        <TextBlock Text="{Binding Title}"
                                   FontSize="17"
                                   FontWeight="SemiBold"
                                   FontFamily="Segoe UI Variable Display, Segoe UI, sans-serif"
                                   Foreground="#FFFFFF"
                                   TextTrimming="CharacterEllipsis"
                                   TextWrapping="NoWrap"
                                   Margin="0,0,0,3" />

                        <!-- Artist Name -->
                        <TextBlock Text="{Binding Artist}"
                                   FontSize="14"
                                   FontWeight="Normal"
                                   FontFamily="Segoe UI Variable Text, Segoe UI, sans-serif"
                                   Foreground="#D2D7E2"
                                   TextTrimming="CharacterEllipsis"
                                   TextWrapping="NoWrap"
                                   Margin="0,0,0,4">
                            <TextBlock.Style>
                                <Style TargetType="TextBlock">
                                    <Setter Property="Visibility" Value="Visible" />
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding Artist}" Value="">
                                            <Setter Property="Visibility" Value="Collapsed" />
                                        </DataTrigger>
                                        <DataTrigger Binding="{Binding Artist}" Value="{x:Null}">
                                            <Setter Property="Visibility" Value="Collapsed" />
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </TextBlock.Style>
                        </TextBlock>

                        <!-- Album / Feature Detail with Note Glyph (♫) -->
                        <StackPanel Orientation="Horizontal"
                                    Visibility="{Binding HasAlbum, Converter={StaticResource BoolToVis}}"
                                    Margin="0,1,0,0">
                            <TextBlock Text="&#xE8D6;"
                                       FontFamily="Segoe MDL2 Assets"
                                       FontSize="11"
                                       Foreground="#9DA5B4"
                                       VerticalAlignment="Center"
                                       Margin="0,1,6,0" />
                            <TextBlock Text="{Binding Album}"
                                       FontSize="13"
                                       FontWeight="Normal"
                                       FontFamily="Segoe UI Variable Text, Segoe UI, sans-serif"
                                       Foreground="#9DA5B4"
                                       TextTrimming="CharacterEllipsis"
                                       TextWrapping="NoWrap"
                                       VerticalAlignment="Center" />
                        </StackPanel>
                    </StackPanel>
                </Grid>
            </Grid>

            <!-- Row 1: Bottom Docked Bar: Transport Controls + Live Playback Time (Matches Focus Timer) -->
            <Border Grid.Row="1"
                    Background="#14000000"
                    BorderThickness="0"
                    CornerRadius="0,0,2,2"
                    SnapsToDevicePixels="True"
                    Padding="20,0,20,0">
                <Grid>
                    <!-- Transport Controls (< ▷ >) Aligned with Title Name on Left -->
                    <StackPanel Orientation="Horizontal"
                                HorizontalAlignment="Left"
                                VerticalAlignment="Center"
                                Margin="-9.5,0,0,0">
                        <!-- Previous Track (<) -->
                        <Button Style="{StaticResource MediaTransportButtonStyle}"
                                Command="{Binding SkipPreviousCommand}"
                                IsEnabled="{Binding CanSkipPrevious}"
                                ToolTip="Previous">
                            <TextBlock Text="&#xE76B;"
                                       FontFamily="Segoe MDL2 Assets"
                                       FontSize="13"
                                       VerticalAlignment="Center"
                                       HorizontalAlignment="Center" />
                        </Button>

                        <!-- Play / Pause (▷ or ||) -->
                        <Button Style="{StaticResource MediaTransportButtonStyle}"
                                Command="{Binding TogglePlayPauseCommand}"
                                IsEnabled="{Binding CanPlayPause}"
                                Margin="4,0"
                                ToolTip="Play / Pause">
                            <TextBlock x:Name="PlayPauseIcon"
                                       FontFamily="Segoe MDL2 Assets"
                                       VerticalAlignment="Center"
                                       HorizontalAlignment="Center">
                                <TextBlock.Style>
                                    <Style TargetType="TextBlock">
                                        <Setter Property="Text" Value="&#xE768;" />
                                        <Setter Property="FontSize" Value="13" />
                                        <Setter Property="Margin" Value="1.5,0,0,0" />
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding IsPlaying}" Value="True">
                                                <Setter Property="Text" Value="&#xE769;" />
                                                <Setter Property="FontSize" Value="15.5" />
                                                <Setter Property="Margin" Value="0" />
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </TextBlock.Style>
                            </TextBlock>
                        </Button>

                        <!-- Next Track (>) -->
                        <Button Style="{StaticResource MediaTransportButtonStyle}"
                                Command="{Binding SkipNextCommand}"
                                IsEnabled="{Binding CanSkipNext}"
                                ToolTip="Next">
                            <TextBlock Text="&#xE76C;"
                                       FontFamily="Segoe MDL2 Assets"
                                       FontSize="13"
                                       VerticalAlignment="Center"
                                       HorizontalAlignment="Center" />
                        </Button>
                    </StackPanel>

                    <!-- Live Track Playback Time Readout / Live Stream Badge on Right -->
                    <Border HorizontalAlignment="Right"
                            VerticalAlignment="Center"
                            Height="28"
                            SnapsToDevicePixels="True">
                        <Grid VerticalAlignment="Center">
                            <!-- Standard Track Playback Time Readout (e.g. 1:24 / 3:45) -->
                            <TextBlock Text="{Binding TimeDisplayString}"
                                       VerticalAlignment="Center"
                                       HorizontalAlignment="Right"
                                       FontSize="13"
                                       FontWeight="Normal"
                                       FontFamily="Segoe UI Variable Text, Segoe UI, sans-serif"
                                       Foreground="#D0FFFFFF"
                                       SnapsToDevicePixels="True">
                                <TextBlock.Style>
                                    <Style TargetType="TextBlock">
                                        <Setter Property="Visibility" Value="Visible" />
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding HasMedia}" Value="False">
                                                <Setter Property="Visibility" Value="Collapsed" />
                                            </DataTrigger>
                                            <DataTrigger Binding="{Binding TimeDisplayString}" Value="">
                                                <Setter Property="Visibility" Value="Collapsed" />
                                            </DataTrigger>
                                            <DataTrigger Binding="{Binding IsLive}" Value="True">
                                                <Setter Property="Visibility" Value="Collapsed" />
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </TextBlock.Style>
                            </TextBlock>

                            <!-- Modern Fluent Live Badge (Vibrant Glowing Red Dot + Clean Aligned 'LIVE') -->
                            <StackPanel Orientation="Horizontal"
                                        VerticalAlignment="Center"
                                        HorizontalAlignment="Right">
                                <StackPanel.Style>
                                    <Style TargetType="StackPanel">
                                        <Setter Property="Visibility" Value="Collapsed" />
                                        <Style.Triggers>
                                            <MultiDataTrigger>
                                                <MultiDataTrigger.Conditions>
                                                    <Condition Binding="{Binding HasMedia}" Value="True" />
                                                    <Condition Binding="{Binding IsLive}" Value="True" />
                                                </MultiDataTrigger.Conditions>
                                                <Setter Property="Visibility" Value="Visible" />
                                            </MultiDataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </StackPanel.Style>

                                <!-- Precision Glowing Red Live Dot -->
                                <Border Width="6"
                                        Height="6"
                                        CornerRadius="3"
                                        Background="#FF3333"
                                        VerticalAlignment="Center"
                                        Margin="0,0.5,5.5,0"
                                        SnapsToDevicePixels="True"
                                        UseLayoutRounding="True">
                                    <Border.Effect>
                                        <DropShadowEffect Color="#FF3333" BlurRadius="5" ShadowDepth="0" Opacity="0.8" />
                                    </Border.Effect>
                                </Border>

                                <!-- Crisp 'LIVE' Label -->
                                <TextBlock Text="LIVE"
                                           FontSize="11"
                                           FontWeight="Bold"
                                           FontFamily="Segoe UI Variable Display, Segoe UI, sans-serif"
                                           Foreground="#FFFFFF"
                                           VerticalAlignment="Center"
                                           SnapsToDevicePixels="True" />
                            </StackPanel>
                        </Grid>
                    </Border>
                </Grid>
            </Border>

            <!-- Edge-to-Edge Hairline Fluent Seekbar running along the top boundary of Row 1 (Matches Focus Timer) -->
            <Grid x:Name="SeekbarContainer"
                  Grid.Row="1"
                  VerticalAlignment="Top"
                  Height="14"
                  Margin="0,-7,0,0"
                  Background="Transparent"
                  Cursor="Hand"
                  Focusable="False"
                  Tag="InteractiveControl"
                  PreviewMouseLeftButtonDown="Seekbar_PreviewMouseLeftButtonDown"
                  MouseEnter="Seekbar_MouseEnter"
                  MouseLeave="Seekbar_MouseLeave"
                  MouseLeftButtonDown="Seekbar_MouseLeftButtonDown"
                  MouseMove="Seekbar_MouseMove"
                  MouseLeftButtonUp="Seekbar_MouseLeftButtonUp"
                  LostMouseCapture="Seekbar_LostMouseCapture"
                  SizeChanged="Seekbar_SizeChanged"
                  SnapsToDevicePixels="True">
                <Grid.Style>
                    <Style TargetType="Grid">
                        <Setter Property="Visibility" Value="Visible" />
                        <Style.Triggers>
                            <DataTrigger Binding="{Binding HasMedia}" Value="False">
                                <Setter Property="Cursor" Value="Arrow" />
                            </DataTrigger>
                            <DataTrigger Binding="{Binding IsLive}" Value="True">
                                <Setter Property="Visibility" Value="Collapsed" />
                            </DataTrigger>
                            <DataTrigger Binding="{Binding CanSeek}" Value="False">
                                <Setter Property="Visibility" Value="Collapsed" />
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </Grid.Style>

                <!-- 1. Background Track (2px tall hairline, identical to Focus Timer #14FFFFFF) -->
                <Border x:Name="SeekTrackBg"
                        Height="2"
                        VerticalAlignment="Center"
                        Background="#14FFFFFF"
                        CornerRadius="1"
                        SnapsToDevicePixels="True" />

                <!-- 2. Elapsed Progress Fill Track: Accent Color Bar -->
                <Border x:Name="SeekProgressFill"
                        Height="2"
                        HorizontalAlignment="Stretch"
                        VerticalAlignment="Center"
                        Background="{Binding SeekbarBrush}"
                        CornerRadius="1"
                        SnapsToDevicePixels="True">
                    <Border.Clip>
                        <RectangleGeometry x:Name="SeekProgressClip" Rect="0,-5,0,14" />
                    </Border.Clip>
                </Border>

                <!-- 3. Sleek Fluent Vertical Pill Thumb (Appears on Hover/Scrubbing) -->
                <Border x:Name="SeekThumb"
                        Width="4"
                        Height="12"
                        CornerRadius="2"
                        Background="#FFFFFF"
                        BorderBrush="{Binding SeekbarBrush}"
                        BorderThickness="1"
                        HorizontalAlignment="Left"
                        VerticalAlignment="Center"
                        Opacity="0"
                        SnapsToDevicePixels="True"
                        IsHitTestVisible="False"
                        RenderTransformOrigin="0.5,0.5">
                    <Border.RenderTransform>
                        <TransformGroup>
                            <ScaleTransform x:Name="SeekThumbScale" ScaleX="0.6" ScaleY="0.7" />
                            <TranslateTransform x:Name="SeekThumbTranslate" X="0" />
                        </TransformGroup>
                    </Border.RenderTransform>
                </Border>
            </Grid>
        </Grid>
    </widgets:WidgetCard>
</UserControl>
