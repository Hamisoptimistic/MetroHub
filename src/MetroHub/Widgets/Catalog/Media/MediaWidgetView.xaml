<UserControl x:Class="MetroHub.Widgets.Catalog.Media.MediaWidgetView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:widgets="clr-namespace:MetroHub.Widgets"
             xmlns:media="clr-namespace:MetroHub.Widgets.Catalog.Media"
             mc:Ignorable="d" 
             d:DataContext="{d:DesignInstance Type=media:MediaWidgetViewModel}"
             Focusable="False"
             SnapsToDevicePixels="True"
             UseLayoutRounding="True"
             TextOptions.TextFormattingMode="Ideal"
             TextOptions.TextRenderingMode="Grayscale"
             TextOptions.TextHintingMode="Animated">

    <UserControl.Resources>
        <BooleanToVisibilityConverter x:Key="BoolToVis" />

        <!-- Media Transport Button Style: Fluent Acrylic Button -->
        <Style x:Key="MediaTransportButtonStyle" TargetType="Button">
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="Foreground" Value="#E5E9F0" />
            <Setter Property="Width" Value="36" />
            <Setter Property="Height" Value="30" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Focusable" Value="False" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Border"
                                Background="{TemplateBinding Background}"
                                CornerRadius="5"
                                SnapsToDevicePixels="True">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Border" Property="Background" Value="#25FFFFFF" />
                                <Setter Property="Foreground" Value="#FFFFFF" />
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="Border" Property="Background" Value="#45FFFFFF" />
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter Property="Opacity" Value="0.3" />
                                <Setter Property="Cursor" Value="Arrow" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </UserControl.Resources>

    <!-- Transparent WidgetCard to inherit the exact glass/acrylic tile background of other tiles -->
    <widgets:WidgetCard Padding="0" Background="Transparent" CornerRadius="2">
        <Grid SnapsToDevicePixels="True" UseLayoutRounding="True">
            <Grid.RowDefinitions>
                <RowDefinition Height="*" />    <!-- Top Section: Text Info + Album Art with Dynamic Glow -->
                <RowDefinition Height="38" />   <!-- Bottom Bar: Fluent Acrylic Sound Source + Controls -->
            </Grid.RowDefinitions>

            <!-- Top Section (Track Info + Album Art with Ambient Glow) -->
            <Grid Grid.Row="0" ClipToBounds="True">
                
                <!-- Right Album Art Container with Dynamic Gradient Glow -->
                <Grid HorizontalAlignment="Right"
                      VerticalAlignment="Center"
                      Margin="0,0,26,0"
                      Width="136"
                      Height="136">

                    <!-- 1. Dynamic Ambient Colored Glow Layer (Sampled from album art with blur) -->
                    <Image Source="{Binding Thumbnail}"
                           Stretch="UniformToFill"
                           HorizontalAlignment="Center"
                           VerticalAlignment="Center"
                           Width="105"
                           Height="105"
                           Opacity="0.55"
                           IsHitTestVisible="False"
                           Visibility="{Binding HasThumbnail, Converter={StaticResource BoolToVis}}">
                        <Image.Effect>
                            <BlurEffect Radius="36" RenderingBias="Performance" />
                        </Image.Effect>
                        <Image.RenderTransform>
                            <ScaleTransform ScaleX="1.32" ScaleY="1.32" CenterX="52.5" CenterY="52.5" />
                        </Image.RenderTransform>
                    </Image>

                    <!-- 2. Crisp Album Art Card with Drop Shadow and 8px Rounded Corners -->
                    <Border Width="105"
                            Height="105"
                            CornerRadius="8"
                            ClipToBounds="True"
                            Background="#14FFFFFF"
                            HorizontalAlignment="Center"
                            VerticalAlignment="Center">
                        <Border.Effect>
                            <DropShadowEffect BlurRadius="16"
                                              ShadowDepth="2"
                                              Direction="270"
                                              Opacity="0.4"
                                              Color="#000000" />
                        </Border.Effect>
                        <Grid>
                            <!-- Real Album Artwork Image -->
                            <Image Source="{Binding Thumbnail}"
                                   Stretch="UniformToFill"
                                   HorizontalAlignment="Center"
                                   VerticalAlignment="Center"
                                   Visibility="{Binding HasThumbnail, Converter={StaticResource BoolToVis}}" />

                            <!-- Watermark Note when no album art is present -->
                            <TextBlock Text="&#xE8D6;"
                                       FontFamily="Segoe MDL2 Assets"
                                       FontSize="38"
                                       Foreground="#25FFFFFF"
                                       HorizontalAlignment="Center"
                                       VerticalAlignment="Center">
                                <TextBlock.Style>
                                    <Style TargetType="TextBlock">
                                        <Setter Property="Visibility" Value="Collapsed" />
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding HasThumbnail}" Value="False">
                                                <Setter Property="Visibility" Value="Visible" />
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </TextBlock.Style>
                            </TextBlock>
                        </Grid>
                    </Border>
                </Grid>

                <!-- Left Content: Track Title, Artist, Album/Feature -->
                <Grid HorizontalAlignment="Left"
                      VerticalAlignment="Center"
                      Margin="24,12,175,12">
                    <StackPanel>
                        <!-- Track Title -->
                        <TextBlock Text="{Binding Title}"
                                   FontSize="18"
                                   FontWeight="SemiBold"
                                   FontFamily="Segoe UI Variable Display, Segoe UI, sans-serif"
                                   Foreground="#FFFFFF"
                                   TextTrimming="CharacterEllipsis"
                                   TextWrapping="NoWrap"
                                   Margin="0,0,0,3" />

                        <!-- Artist Name -->
                        <TextBlock Text="{Binding Artist}"
                                   FontSize="14"
                                   FontWeight="Normal"
                                   FontFamily="Segoe UI Variable Text, Segoe UI, sans-serif"
                                   Foreground="#D2D7E2"
                                   TextTrimming="CharacterEllipsis"
                                   TextWrapping="NoWrap"
                                   Margin="0,0,0,4">
                            <TextBlock.Style>
                                <Style TargetType="TextBlock">
                                    <Setter Property="Visibility" Value="Visible" />
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding Artist}" Value="">
                                            <Setter Property="Visibility" Value="Collapsed" />
                                        </DataTrigger>
                                        <DataTrigger Binding="{Binding Artist}" Value="{x:Null}">
                                            <Setter Property="Visibility" Value="Collapsed" />
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </TextBlock.Style>
                        </TextBlock>

                        <!-- Album / Feature Detail with Note Glyph (♫) -->
                        <StackPanel Orientation="Horizontal"
                                    Visibility="{Binding HasAlbum, Converter={StaticResource BoolToVis}}"
                                    Margin="0,1,0,0">
                            <TextBlock Text="&#xE8D6;"
                                       FontFamily="Segoe MDL2 Assets"
                                       FontSize="11"
                                       Foreground="#9DA5B4"
                                       VerticalAlignment="Center"
                                       Margin="0,1,6,0" />
                            <TextBlock Text="{Binding Album}"
                                       FontSize="13"
                                       FontWeight="Normal"
                                       FontFamily="Segoe UI Variable Text, Segoe UI, sans-serif"
                                       Foreground="#9DA5B4"
                                       TextTrimming="CharacterEllipsis"
                                       TextWrapping="NoWrap"
                                       VerticalAlignment="Center" />
                        </StackPanel>
                    </StackPanel>
                </Grid>
            </Grid>

            <!-- Bottom Docked Bar: Fluent Acrylic Translucent Strip (No Horizontal Divider Line) -->
            <Border Grid.Row="1"
                    Background="#18000000"
                    BorderThickness="0"
                    Padding="22,0,16,0">
                <Grid VerticalAlignment="Center">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>

                    <!-- Left: Detected Sound Source (e.g. "YouTube Music", "Spotify", "Zen Browser") -->
                    <TextBlock Grid.Column="0"
                               Text="{Binding SourceName}"
                               FontSize="13"
                               FontWeight="Normal"
                               FontFamily="Segoe UI Variable Text, Segoe UI, sans-serif"
                               Foreground="#B8BDC8"
                               TextTrimming="CharacterEllipsis"
                               VerticalAlignment="Center" />

                    <!-- Right: Transport Controls (< ▷ >) -->
                    <StackPanel Grid.Column="1"
                                Orientation="Horizontal"
                                VerticalAlignment="Center">
                        <!-- Previous Track (<) -->
                        <Button Style="{StaticResource MediaTransportButtonStyle}"
                                Command="{Binding SkipPreviousCommand}"
                                IsEnabled="{Binding CanSkipPrevious}"
                                ToolTip="Previous">
                            <TextBlock Text="&#xE76B;"
                                       FontFamily="Segoe MDL2 Assets"
                                       FontSize="12"
                                       VerticalAlignment="Center"
                                       HorizontalAlignment="Center" />
                        </Button>

                        <!-- Play / Pause (▷ or ||) -->
                        <Button Style="{StaticResource MediaTransportButtonStyle}"
                                Command="{Binding TogglePlayPauseCommand}"
                                IsEnabled="{Binding CanPlayPause}"
                                Margin="4,0"
                                ToolTip="Play / Pause">
                            <TextBlock x:Name="PlayPauseIcon"
                                       FontFamily="Segoe MDL2 Assets"
                                       FontSize="12"
                                       VerticalAlignment="Center"
                                       HorizontalAlignment="Center">
                                <TextBlock.Style>
                                    <Style TargetType="TextBlock">
                                        <Setter Property="Text" Value="&#xE768;" />
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding IsPlaying}" Value="True">
                                                <Setter Property="Text" Value="&#xE769;" />
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </TextBlock.Style>
                            </TextBlock>
                        </Button>

                        <!-- Next Track (>) -->
                        <Button Style="{StaticResource MediaTransportButtonStyle}"
                                Command="{Binding SkipNextCommand}"
                                IsEnabled="{Binding CanSkipNext}"
                                ToolTip="Next">
                            <TextBlock Text="&#xE76C;"
                                       FontFamily="Segoe MDL2 Assets"
                                       FontSize="12"
                                       VerticalAlignment="Center"
                                       HorizontalAlignment="Center" />
                        </Button>
                    </StackPanel>
                </Grid>
            </Border>
        </Grid>
    </widgets:WidgetCard>
</UserControl>
