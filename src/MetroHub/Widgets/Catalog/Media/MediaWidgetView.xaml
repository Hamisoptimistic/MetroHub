<UserControl x:Class="MetroHub.Widgets.Catalog.Media.MediaWidgetView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:widgets="clr-namespace:MetroHub.Widgets"
             xmlns:media="clr-namespace:MetroHub.Widgets.Catalog.Media"
             mc:Ignorable="d" 
             d:DataContext="{d:DesignInstance Type=media:MediaWidgetViewModel}"
             Focusable="False"
             SnapsToDevicePixels="True"
             UseLayoutRounding="True"
             TextOptions.TextFormattingMode="Ideal"
             TextOptions.TextRenderingMode="ClearType"
             TextOptions.TextHintingMode="Fixed"
             RenderOptions.ClearTypeHint="Enabled">

    <UserControl.Resources>
        <BooleanToVisibilityConverter x:Key="BoolToVis" />

        <!-- Media Transport Button Style: Inherits FluentGhostButtonStyle (2px Corner Radius, unified sidebar hover) -->
        <Style x:Key="MediaTransportButtonStyle" TargetType="Button" BasedOn="{StaticResource FluentGhostButtonStyle}">
            <Setter Property="Width" Value="32" />
            <Setter Property="Height" Value="28" />
            <Setter Property="Padding" Value="0" />
            <Setter Property="Focusable" Value="False" />
        </Style>

        <!-- Zune Pad Flanking Buttons (Previous / Next) -->
        <Style x:Key="ZuneSideButtonStyle" TargetType="Button">
            <Setter Property="Background" Value="#14FFFFFF" />
            <Setter Property="Foreground" Value="#B0FFFFFF" />
            <Setter Property="BorderBrush" Value="#25FFFFFF" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="Width" Value="32" />
            <Setter Property="Height" Value="32" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Focusable" Value="False" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="SideBorder"
                                Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="16"
                                SnapsToDevicePixels="True">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="SideBorder" Property="Background" Value="#2AFFFFFF" />
                                <Setter TargetName="SideBorder" Property="BorderBrush" Value="#40FFFFFF" />
                                <Setter Property="Foreground" Value="#FFFFFF" />
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="SideBorder" Property="Background" Value="#45FFFFFF" />
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter Property="Opacity" Value="0.25" />
                                <Setter Property="Cursor" Value="Arrow" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Zune Play/Pause Sleek Button: Circular glass button matching chevron style -->
        <Style x:Key="ZunePadButtonStyle" TargetType="Button">
            <Setter Property="Background" Value="#1CFFFFFF" />
            <Setter Property="Foreground" Value="#FFFFFF" />
            <Setter Property="BorderBrush" Value="#30FFFFFF" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="Width" Value="38" />
            <Setter Property="Height" Value="38" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Focusable" Value="False" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="PlayBorder"
                                Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="19"
                                SnapsToDevicePixels="True">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="PlayBorder" Property="Background" Value="#32FFFFFF" />
                                <Setter TargetName="PlayBorder" Property="BorderBrush" Value="#48FFFFFF" />
                                <Setter Property="Foreground" Value="#FFFFFF" />
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="PlayBorder" Property="Background" Value="#45FFFFFF" />
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter Property="Opacity" Value="0.25" />
                                <Setter Property="Cursor" Value="Arrow" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

    </UserControl.Resources>

    <!-- Transparent WidgetCard to inherit the exact glass/acrylic tile background of other tiles -->
    <widgets:WidgetCard Padding="0" Background="Transparent" CornerRadius="2">
        <Grid SnapsToDevicePixels="True" UseLayoutRounding="True" ClipToBounds="True">
            <!-- 0. Dynamic Ambient Album Aura (100% GPU-drawn frozen brush, 0 CPU/RAM) -->
            <Border Background="{Binding AmbientGlowBrush}"
                    CornerRadius="2"
                    IsHitTestVisible="False" />

            <!-- ============================================================= -->
            <!-- 1. STANDARD LAYOUT (6x2, 8x3, 8x4)                            -->
            <!-- ============================================================= -->
            <Grid Visibility="{Binding IsStandardMode, Converter={StaticResource BoolToVis}}"
                  SnapsToDevicePixels="True" UseLayoutRounding="True">
                <Grid.RowDefinitions>
                    <RowDefinition Height="*" />    <!-- Row 0: Track Info + Album Art -->
                    <RowDefinition Height="38" />   <!-- Row 1: Fluent Acrylic Strip: Sound Source (Left) + Controls (Far Right) -->
                </Grid.RowDefinitions>

            <!-- Row 0: Top Section (Track Info + Elevated Album Art) -->
            <Grid Grid.Row="0">
                <!-- Album Art Container on Right Side -->
                <Grid HorizontalAlignment="Right"
                      VerticalAlignment="Center"
                      Margin="{Binding AlbumArtMargin}">

                    <!-- 1. Album Cover with Guaranteed 2px Rounded Corners matching Tiles -->
                    <Border Width="{Binding AlbumArtSize}"
                            Height="{Binding AlbumArtSize}"
                            CornerRadius="2"
                            BorderBrush="#38FFFFFF"
                            BorderThickness="1"
                            SnapsToDevicePixels="True"
                            UseLayoutRounding="True"
                            RenderOptions.BitmapScalingMode="HighQuality"
                            Visibility="{Binding HasThumbnail, Converter={StaticResource BoolToVis}}">
                        <Border.Background>
                            <ImageBrush ImageSource="{Binding Thumbnail, TargetNullValue={x:Null}, FallbackValue={x:Null}}"
                                        Stretch="UniformToFill"
                                        RenderOptions.BitmapScalingMode="HighQuality" />
                        </Border.Background>
                    </Border>

                    <!-- 2. Fallback Watermark Box when no album art is available -->
                    <Border Width="{Binding AlbumArtSize}"
                            Height="{Binding AlbumArtSize}"
                            CornerRadius="2"
                            Background="#14FFFFFF"
                            BorderBrush="#20FFFFFF"
                            BorderThickness="1"
                            SnapsToDevicePixels="True"
                            UseLayoutRounding="True">
                        <Border.Style>
                            <Style TargetType="Border">
                                <Setter Property="Visibility" Value="Collapsed" />
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding HasThumbnail}" Value="False">
                                        <Setter Property="Visibility" Value="Visible" />
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </Border.Style>
                        <TextBlock Text="&#xE8D6;"
                                   FontFamily="{DynamicResource AppIconFontFamily}"
                                   FontSize="{Binding FallbackWatermarkFontSize}"
                                   Foreground="#25FFFFFF"
                                   HorizontalAlignment="Center"
                                   VerticalAlignment="Center" />
                    </Border>
                </Grid>

                <!-- Left Content: Track Title, Artist, Album/Feature -->
                <Grid HorizontalAlignment="Left"
                      VerticalAlignment="Center"
                      Margin="{Binding TrackInfoMargin}">
                    <StackPanel>
                        <!-- Track Title -->
                        <TextBlock Text="{Binding Title}"
                                   FontSize="{Binding TrackTitleFontSize}"
                                   FontWeight="SemiBold"
                                   FontFamily="{DynamicResource AppDisplayFontFamily}"
                                   Foreground="#FFFFFF"
                                   TextTrimming="CharacterEllipsis"
                                   TextWrapping="NoWrap"
                                   Margin="0,0,0,3" />

                        <!-- Artist Name -->
                        <TextBlock Text="{Binding Artist}"
                                   FontSize="{Binding ArtistFontSize}"
                                   FontWeight="Normal"
                                   Foreground="#D2D7E2"
                                   TextTrimming="CharacterEllipsis"
                                   TextWrapping="NoWrap"
                                   Margin="0,0,0,4">
                            <TextBlock.Style>
                                <Style TargetType="TextBlock">
                                    <Setter Property="Visibility" Value="Visible" />
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding Artist}" Value="">
                                            <Setter Property="Visibility" Value="Collapsed" />
                                        </DataTrigger>
                                        <DataTrigger Binding="{Binding Artist}" Value="{x:Null}">
                                            <Setter Property="Visibility" Value="Collapsed" />
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </TextBlock.Style>
                        </TextBlock>

                        <!-- Album / Feature Detail with Note Glyph (♫) -->
                        <StackPanel Orientation="Horizontal"
                                    Visibility="{Binding ShowAlbumRow, Converter={StaticResource BoolToVis}}"
                                    Margin="0,1,0,0">
                            <TextBlock Text="&#xE8D6;"
                                       FontFamily="{DynamicResource AppIconFontFamily}"
                                       FontSize="11"
                                       Foreground="#9DA5B4"
                                       VerticalAlignment="Center"
                                       Margin="0,1,6,0" />
                            <TextBlock Text="{Binding Album}"
                                       FontSize="13"
                                       FontWeight="Normal"
                                       Foreground="#9DA5B4"
                                       TextTrimming="CharacterEllipsis"
                                       TextWrapping="NoWrap"
                                       VerticalAlignment="Center" />
                        </StackPanel>
                    </StackPanel>
                </Grid>
            </Grid>

            <!-- Row 1: Bottom Docked Bar: Transport Controls + Live Playback Time (Matches Focus Timer) -->
            <Border Grid.Row="1"
                    Background="#14000000"
                    BorderThickness="0"
                    CornerRadius="0,0,2,2"
                    SnapsToDevicePixels="True"
                    Padding="{Binding PlaybackBarPadding}">
                <Grid>
                    <!-- Transport Controls (< ▷ >) Aligned with Title Name on Left -->
                    <StackPanel Orientation="Horizontal"
                                HorizontalAlignment="Left"
                                VerticalAlignment="Center"
                                Margin="{Binding TransportControlsMargin}">
                        <!-- Previous Track (<) -->
                        <Button Style="{StaticResource MediaTransportButtonStyle}"
                                Command="{Binding SkipPreviousCommand}"
                                IsEnabled="{Binding CanSkipPrevious}"
                                ToolTip="Previous">
                            <TextBlock Text="&#xE76B;"
                                       FontFamily="{DynamicResource AppIconFontFamily}"
                                       FontSize="15"
                                       VerticalAlignment="Center"
                                       HorizontalAlignment="Center" />
                        </Button>

                        <!-- Play / Pause (▷ or ||) -->
                        <Button Style="{StaticResource MediaTransportButtonStyle}"
                                Command="{Binding TogglePlayPauseCommand}"
                                IsEnabled="{Binding CanPlayPause}"
                                Margin="4,0"
                                ToolTip="Play / Pause">
                            <TextBlock x:Name="PlayPauseIcon"
                                       FontFamily="{DynamicResource AppIconFontFamily}"
                                       VerticalAlignment="Center"
                                       HorizontalAlignment="Center">
                                <TextBlock.Style>
                                    <Style TargetType="TextBlock">
                                        <Setter Property="Text" Value="&#xE768;" />
                                        <Setter Property="FontSize" Value="15" />
                                        <Setter Property="Margin" Value="0" />
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding IsPlaying}" Value="True">
                                                <Setter Property="Text" Value="&#xE769;" />
                                                <Setter Property="FontSize" Value="16" />
                                                <Setter Property="Margin" Value="0" />
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </TextBlock.Style>
                            </TextBlock>
                        </Button>

                        <!-- Next Track (>) -->
                        <Button Style="{StaticResource MediaTransportButtonStyle}"
                                Command="{Binding SkipNextCommand}"
                                IsEnabled="{Binding CanSkipNext}"
                                ToolTip="Next">
                            <TextBlock Text="&#xE76C;"
                                       FontFamily="{DynamicResource AppIconFontFamily}"
                                       FontSize="15"
                                       VerticalAlignment="Center"
                                       HorizontalAlignment="Center" />
                        </Button>
                    </StackPanel>

                    <!-- Live Track Playback Time Readout / Live Stream Badge on Right -->
                    <Border HorizontalAlignment="Right"
                            VerticalAlignment="Center"
                            Height="28"
                            SnapsToDevicePixels="True">
                        <Grid VerticalAlignment="Center">
                            <!-- Standard Track Playback Time Readout (e.g. 1:24 / 3:45) -->
                            <TextBlock Text="{Binding TimeDisplayString}"
                                       VerticalAlignment="Center"
                                       HorizontalAlignment="Right"
                                       FontSize="13"
                                       FontWeight="Normal"
                                       Foreground="#D0FFFFFF"
                                       SnapsToDevicePixels="True">
                                <TextBlock.Style>
                                    <Style TargetType="TextBlock">
                                        <Setter Property="Visibility" Value="Visible" />
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding HasMedia}" Value="False">
                                                <Setter Property="Visibility" Value="Collapsed" />
                                            </DataTrigger>
                                            <DataTrigger Binding="{Binding TimeDisplayString}" Value="">
                                                <Setter Property="Visibility" Value="Collapsed" />
                                            </DataTrigger>
                                            <DataTrigger Binding="{Binding IsLive}" Value="True">
                                                <Setter Property="Visibility" Value="Collapsed" />
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </TextBlock.Style>
                            </TextBlock>
                        </Grid>
                    </Border>
                </Grid>
            </Border>

            <!-- Edge-to-Edge Hairline Fluent Seekbar running along the top boundary of Row 1 (Matches Focus Timer) -->
            <Grid x:Name="SeekbarContainer"
                  Grid.Row="1"
                  VerticalAlignment="Top"
                  Height="14"
                  Margin="0,-7,0,0"
                  Background="Transparent"
                  Cursor="Hand"
                  Focusable="False"
                  Tag="InteractiveControl"
                  PreviewMouseLeftButtonDown="Seekbar_PreviewMouseLeftButtonDown"
                  MouseEnter="Seekbar_MouseEnter"
                  MouseLeave="Seekbar_MouseLeave"
                  MouseLeftButtonDown="Seekbar_MouseLeftButtonDown"
                  MouseMove="Seekbar_MouseMove"
                  MouseLeftButtonUp="Seekbar_MouseLeftButtonUp"
                  LostMouseCapture="Seekbar_LostMouseCapture"
                  SizeChanged="Seekbar_SizeChanged"
                  SnapsToDevicePixels="True">
                <Grid.Style>
                    <Style TargetType="Grid">
                        <Setter Property="Visibility" Value="Visible" />
                        <Style.Triggers>
                            <DataTrigger Binding="{Binding HasMedia}" Value="False">
                                <Setter Property="Cursor" Value="Arrow" />
                            </DataTrigger>
                            <DataTrigger Binding="{Binding IsLive}" Value="True">
                                <Setter Property="Visibility" Value="Collapsed" />
                            </DataTrigger>
                            <DataTrigger Binding="{Binding CanSeek}" Value="False">
                                <Setter Property="Visibility" Value="Collapsed" />
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </Grid.Style>

                <!-- 1. Hairline Fluent Seekbar Track Group (Smooth GPU ScaleY transform on hover/drag - zero layout invalidation) -->
                <Grid x:Name="SeekTrackGroup"
                      VerticalAlignment="Center"
                      RenderTransformOrigin="0.5,0.5">
                    <Grid.RenderTransform>
                        <ScaleTransform x:Name="SeekTrackScale" ScaleY="1.0" />
                    </Grid.RenderTransform>

                    <!-- Background Hairline Track (2px tall #14FFFFFF) -->
                    <Border x:Name="SeekTrackBg"
                            Height="2"
                            Background="#14FFFFFF"
                            CornerRadius="1"
                            SnapsToDevicePixels="True" />

                    <!-- Elapsed Progress Fill Track: Accent Color Bar + Luminous Specular Shimmer -->
                    <Grid x:Name="SeekProgressContainer"
                          Height="2"
                          HorizontalAlignment="Stretch"
                          SnapsToDevicePixels="True">
                        <Grid.Clip>
                            <RectangleGeometry x:Name="SeekProgressClip" Rect="0,-5,0,24" />
                        </Grid.Clip>

                        <!-- Base Played Accent Color Bar -->
                        <Border x:Name="SeekProgressFill"
                                Height="2"
                                Background="{Binding SeekbarBrush}"
                                CornerRadius="1"
                                SnapsToDevicePixels="True" />

                        <!-- Luminous Light Reflection Sweeping Across Played Track -->
                        <Rectangle x:Name="SeekShimmer"
                                   Width="70"
                                   Height="6"
                                   VerticalAlignment="Center"
                                   HorizontalAlignment="Left"
                                   IsHitTestVisible="False"
                                   Opacity="0.0"
                                   SnapsToDevicePixels="True">
                            <Rectangle.Fill>
                                <LinearGradientBrush StartPoint="0,0" EndPoint="1,0">
                                    <GradientStop Color="#00FFFFFF" Offset="0.0" />
                                    <GradientStop Color="#60FFFFFF" Offset="0.25" />
                                    <GradientStop Color="#E8FFFFFF" Offset="0.5" />
                                    <GradientStop Color="#60FFFFFF" Offset="0.75" />
                                    <GradientStop Color="#00FFFFFF" Offset="1.0" />
                                </LinearGradientBrush>
                            </Rectangle.Fill>
                            <Rectangle.RenderTransform>
                                <TranslateTransform x:Name="SeekShimmerTranslate" X="-80" />
                            </Rectangle.RenderTransform>
                        </Rectangle>
                    </Grid>
                </Grid>

                <!-- 3. Fluent Circular Thumb Container (Identical to Volume/Brightness slider) -->
                <Grid x:Name="SeekThumb"
                      HorizontalAlignment="Left"
                      VerticalAlignment="Center"
                      IsHitTestVisible="False"
                      Opacity="0"
                      RenderTransformOrigin="0.5,0.5">
                    <Grid.RenderTransform>
                        <TransformGroup>
                            <ScaleTransform x:Name="SeekThumbScale" ScaleX="0.85" ScaleY="0.85" />
                            <TranslateTransform x:Name="SeekThumbTranslate" X="0" />
                        </TransformGroup>
                    </Grid.RenderTransform>

                    <!-- Clean minimal circular dot thumb using dynamic album art brush -->
                    <Ellipse x:Name="SeekThumbDot"
                             Width="12"
                             Height="12"
                             Fill="{Binding SeekbarBrush}"
                             HorizontalAlignment="Center"
                             VerticalAlignment="Center" />
                </Grid>
            </Grid>
            </Grid>

            <!-- ============================================================= -->
            <!-- 2. SLIM CONTROLLER LAYOUT (4x1: 248x56px)                     -->
            <!-- [ ▷ Play ] ========== Seekbar / No media ========== [ 1:24 ]  -->
            <!-- ============================================================= -->
            <Grid Visibility="{Binding IsSlimMode, Converter={StaticResource BoolToVis}}"
                  Margin="14,0,14,0"
                  VerticalAlignment="Center"
                  SnapsToDevicePixels="True"
                  UseLayoutRounding="True">
                <Grid.ColumnDefinitions>
                    <!-- Col 0: Single Play/Pause Button -->
                    <ColumnDefinition Width="Auto" />
                    <!-- Col 1: Center Area (Seekbar or 'No media playing' label) -->
                    <ColumnDefinition Width="*" />
                    <!-- Col 2: Track Timing Readout -->
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <!-- Col 0: Play/Pause Button -->
                <Button Grid.Column="0"
                        Style="{StaticResource MediaTransportButtonStyle}"
                        Command="{Binding TogglePlayPauseCommand}"
                        IsEnabled="{Binding CanPlayPause}"
                        VerticalAlignment="Center"
                        HorizontalAlignment="Left"
                        ToolTip="Play / Pause">
                    <TextBlock FontFamily="{DynamicResource AppIconFontFamily}"
                               VerticalAlignment="Center"
                               HorizontalAlignment="Center">
                        <TextBlock.Style>
                            <Style TargetType="TextBlock">
                                <Setter Property="Text" Value="&#xE768;" />
                                <Setter Property="FontSize" Value="15" />
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding IsPlaying}" Value="True">
                                        <Setter Property="Text" Value="&#xE769;" />
                                        <Setter Property="FontSize" Value="16" />
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </TextBlock.Style>
                    </TextBlock>
                </Button>

                <!-- Col 1: Center Area -->
                <Grid Grid.Column="1" Margin="10,0,10,0" VerticalAlignment="Center">
                    <!-- Idle State: 'No media playing' subtle text -->
                    <TextBlock Text="No media playing"
                               FontSize="12"
                               FontWeight="Normal"
                               Foreground="#55FFFFFF"
                               FontFamily="{DynamicResource AppDisplayFontFamily}"
                               HorizontalAlignment="Center"
                               VerticalAlignment="Center"
                               TextTrimming="CharacterEllipsis"
                               Visibility="{Binding HasNoMedia, Converter={StaticResource BoolToVis}}" />

                    <!-- Active State: Interactive Hairline Seekbar -->
                    <Grid x:Name="SlimSeekbarContainer"
                          Height="18"
                          VerticalAlignment="Center"
                          Background="Transparent"
                          Cursor="Hand"
                          Focusable="False"
                          Tag="InteractiveControl"
                          Visibility="{Binding HasMedia, Converter={StaticResource BoolToVis}}"
                          PreviewMouseLeftButtonDown="Seekbar_PreviewMouseLeftButtonDown"
                          MouseEnter="Seekbar_MouseEnter"
                          MouseLeave="Seekbar_MouseLeave"
                          MouseLeftButtonDown="Seekbar_MouseLeftButtonDown"
                          MouseMove="Seekbar_MouseMove"
                          MouseLeftButtonUp="Seekbar_MouseLeftButtonUp"
                          LostMouseCapture="Seekbar_LostMouseCapture"
                          SizeChanged="Seekbar_SizeChanged"
                          SnapsToDevicePixels="True">
                        <Grid.Style>
                            <Style TargetType="Grid">
                                <Setter Property="Visibility" Value="Visible" />
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding HasMedia}" Value="False">
                                        <Setter Property="Visibility" Value="Collapsed" />
                                    </DataTrigger>
                                    <DataTrigger Binding="{Binding IsLive}" Value="True">
                                        <Setter Property="Visibility" Value="Collapsed" />
                                    </DataTrigger>
                                    <DataTrigger Binding="{Binding CanSeek}" Value="False">
                                        <Setter Property="Visibility" Value="Collapsed" />
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </Grid.Style>

                        <!-- Track Group -->
                        <Grid x:Name="SlimSeekTrackGroup"
                              VerticalAlignment="Center"
                              RenderTransformOrigin="0.5,0.5">
                            <Grid.RenderTransform>
                                <ScaleTransform x:Name="SlimSeekTrackScale" ScaleY="1.0" />
                            </Grid.RenderTransform>

                            <!-- Background Hairline Track -->
                            <Border x:Name="SlimSeekTrackBg"
                                    Height="2"
                                    Background="#14FFFFFF"
                                    CornerRadius="1"
                                    SnapsToDevicePixels="True" />

                            <!-- Elapsed Progress Track -->
                            <Grid x:Name="SlimSeekProgressContainer"
                                  Height="2"
                                  HorizontalAlignment="Stretch"
                                  SnapsToDevicePixels="True">
                                <Grid.Clip>
                                    <RectangleGeometry x:Name="SlimSeekProgressClip" Rect="0,-5,0,24" />
                                </Grid.Clip>
                                <Border x:Name="SlimSeekProgressFill"
                                        Height="2"
                                        Background="{Binding SeekbarBrush}"
                                        CornerRadius="1"
                                        SnapsToDevicePixels="True" />

                                <!-- Shimmer Light Reflection -->
                                <Rectangle x:Name="SlimSeekShimmer"
                                           Width="50"
                                           Height="6"
                                           VerticalAlignment="Center"
                                           HorizontalAlignment="Left"
                                           IsHitTestVisible="False"
                                           Opacity="0.0"
                                           SnapsToDevicePixels="True">
                                    <Rectangle.Fill>
                                        <LinearGradientBrush StartPoint="0,0" EndPoint="1,0">
                                            <GradientStop Color="#00FFFFFF" Offset="0.0" />
                                            <GradientStop Color="#60FFFFFF" Offset="0.25" />
                                            <GradientStop Color="#E8FFFFFF" Offset="0.5" />
                                            <GradientStop Color="#60FFFFFF" Offset="0.75" />
                                            <GradientStop Color="#00FFFFFF" Offset="1.0" />
                                        </LinearGradientBrush>
                                    </Rectangle.Fill>
                                    <Rectangle.RenderTransform>
                                        <TranslateTransform x:Name="SlimSeekShimmerTranslate" X="-60" />
                                    </Rectangle.RenderTransform>
                                </Rectangle>
                            </Grid>
                        </Grid>

                        <!-- Circular Thumb -->
                        <Grid x:Name="SlimSeekThumb"
                              HorizontalAlignment="Left"
                              VerticalAlignment="Center"
                              IsHitTestVisible="False"
                              Opacity="0"
                              RenderTransformOrigin="0.5,0.5">
                            <Grid.RenderTransform>
                                <TransformGroup>
                                    <ScaleTransform x:Name="SlimSeekThumbScale" ScaleX="0.85" ScaleY="0.85" />
                                    <TranslateTransform x:Name="SlimSeekThumbTranslate" X="0" />
                                </TransformGroup>
                            </Grid.RenderTransform>
                            <Ellipse x:Name="SlimSeekThumbDot"
                                     Width="12"
                                     Height="12"
                                     Fill="{Binding SeekbarBrush}"
                                     HorizontalAlignment="Center"
                                     VerticalAlignment="Center" />
                        </Grid>
                    </Grid>
                </Grid>

                <!-- Col 2: Track Timing Readout -->
                <TextBlock Grid.Column="2"
                           Text="{Binding TimeDisplayString}"
                           FontSize="11.5"
                           FontWeight="Normal"
                           Foreground="#C8FFFFFF"
                           Typography.NumeralAlignment="Tabular"
                           VerticalAlignment="Center"
                           HorizontalAlignment="Right"
                           SnapsToDevicePixels="True"
                           Visibility="{Binding HasMedia, Converter={StaticResource BoolToVis}}" />
            </Grid>

            <!-- ============================================================= -->
            <!-- 3. AUTHENTIC ZUNE HANDHELD HARDWARE LAYOUT (4x6: 248x376px)   -->
            <!-- ============================================================= -->
            <Grid Visibility="{Binding IsZuneMode, Converter={StaticResource BoolToVis}}"
                  SnapsToDevicePixels="True"
                  UseLayoutRounding="True">
                <Grid.RowDefinitions>
                    <!-- Row 0: Upper Screen / Artwork (Edge-to-Edge Full 1:1 Square 248x248) -->
                    <RowDefinition Height="248" />
                    <!-- Row 1: Bottom Translucent Acrylic Chin with Controls & Track Details (128px) -->
                    <RowDefinition Height="*" />
                </Grid.RowDefinitions>

                <!-- ========================================================= -->
                <!-- ROW 0: UPPER GLOSSY GLASS DISPLAY SCREEN (EDGE-TO-EDGE)   -->
                <!-- ========================================================= -->
                <Grid Grid.Row="0" SnapsToDevicePixels="True" ClipToBounds="True">
                    <!-- A. Idle / Standby Sleep Screen: Deep OLED black + authentic vector Zune logo & wordmark -->
                    <Grid Visibility="{Binding HasNoMedia, Converter={StaticResource BoolToVis}}"
                          Background="#05070A">
                        <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center">
                            <!-- Official Zune Geometric Vector Logo (100% Vector, Pure Transparency, Perfect Optical Alignment) -->
                            <Path Width="60" Height="68"
                                  Stretch="Uniform"
                                  HorizontalAlignment="Center"
                                  Margin="0,0,0,10"
                                  SnapsToDevicePixels="True"
