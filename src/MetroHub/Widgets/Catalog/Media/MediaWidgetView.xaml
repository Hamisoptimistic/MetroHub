<UserControl x:Class="MetroHub.Widgets.Catalog.Media.MediaWidgetView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:widgets="clr-namespace:MetroHub.Widgets"
             xmlns:media="clr-namespace:MetroHub.Widgets.Catalog.Media"
             mc:Ignorable="d" 
             d:DataContext="{d:DesignInstance Type=media:MediaWidgetViewModel}"
             Focusable="False"
             SnapsToDevicePixels="True"
             UseLayoutRounding="True"
             TextOptions.TextFormattingMode="Ideal"
             TextOptions.TextRenderingMode="Grayscale"
             TextOptions.TextHintingMode="Animated">

    <UserControl.Resources>
        <BooleanToVisibilityConverter x:Key="BoolToVis" />

        <!-- Media Transport Button Style -->
        <Style x:Key="MediaTransportButtonStyle" TargetType="Button">
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="Foreground" Value="#E0E3E8" />
            <Setter Property="Width" Value="36" />
            <Setter Property="Height" Value="30" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Focusable" Value="False" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Border"
                                Background="{TemplateBinding Background}"
                                CornerRadius="4"
                                SnapsToDevicePixels="True">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Border" Property="Background" Value="#25FFFFFF" />
                                <Setter Property="Foreground" Value="#FFFFFF" />
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="Border" Property="Background" Value="#40FFFFFF" />
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter Property="Opacity" Value="0.3" />
                                <Setter Property="Cursor" Value="Arrow" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </UserControl.Resources>

    <widgets:WidgetCard Padding="0" Background="#23252B" CornerRadius="2">
        <Grid SnapsToDevicePixels="True" UseLayoutRounding="True">
            <Grid.RowDefinitions>
                <RowDefinition Height="*" />    <!-- Top Section: Text Info + Artwork Bleed -->
                <RowDefinition Height="38" />   <!-- Bottom Bar: Sound Source + Transport Controls -->
            </Grid.RowDefinitions>

            <!-- Top Section (Text & Artwork) -->
            <Grid Grid.Row="0" ClipToBounds="True">
                <!-- Right-aligned Album Art / Media Artwork with Linear Gradient Opacity Bleed -->
                <Grid HorizontalAlignment="Right"
                      Width="260"
                      ClipToBounds="True">
                    
                    <!-- Artwork Image -->
                    <Image Source="{Binding Thumbnail}"
                           Stretch="UniformToFill"
                           HorizontalAlignment="Right"
                           VerticalAlignment="Center">
                        <Image.OpacityMask>
                            <LinearGradientBrush StartPoint="0,0.5" EndPoint="0.38,0.5">
                                <GradientStop Color="#00000000" Offset="0.0" />
                                <GradientStop Color="#FFFFFFFF" Offset="1.0" />
                            </LinearGradientBrush>
                        </Image.OpacityMask>
                        <Image.Style>
                            <Style TargetType="Image">
                                <Setter Property="Visibility" Value="Visible" />
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding HasThumbnail}" Value="False">
                                        <Setter Property="Visibility" Value="Collapsed" />
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </Image.Style>
                    </Image>

                    <!-- Watermark Music Glyph when no thumbnail is present -->
                    <TextBlock Text="&#xE8D6;"
                               FontFamily="Segoe MDL2 Assets"
                               FontSize="56"
                               Foreground="#10FFFFFF"
                               HorizontalAlignment="Right"
                               VerticalAlignment="Center"
                               Margin="0,0,32,0">
                        <TextBlock.Style>
                            <Style TargetType="TextBlock">
                                <Setter Property="Visibility" Value="Collapsed" />
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding HasThumbnail}" Value="False">
                                        <Setter Property="Visibility" Value="Visible" />
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </TextBlock.Style>
                    </TextBlock>
                </Grid>

                <!-- Left Content: Track Title, Artist, Album/Feature -->
                <Grid HorizontalAlignment="Left"
                      VerticalAlignment="Center"
                      Margin="22,14,0,14"
                      MaxWidth="320">
                    <StackPanel>
                        <!-- Track Title -->
                        <TextBlock Text="{Binding Title}"
                                   FontSize="18"
                                   FontWeight="SemiBold"
                                   FontFamily="Segoe UI Variable Display, Segoe UI, sans-serif"
                                   Foreground="#FFFFFF"
                                   TextTrimming="CharacterEllipsis"
                                   TextWrapping="NoWrap"
                                   Margin="0,0,0,3" />

                        <!-- Artist Name -->
                        <TextBlock Text="{Binding Artist}"
                                   FontSize="14"
                                   FontWeight="Normal"
                                   FontFamily="Segoe UI Variable Text, Segoe UI, sans-serif"
                                   Foreground="#D2D6DF"
                                   TextTrimming="CharacterEllipsis"
                                   TextWrapping="NoWrap"
                                   Margin="0,0,0,4">
                            <TextBlock.Style>
                                <Style TargetType="TextBlock">
                                    <Setter Property="Visibility" Value="Visible" />
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding Artist}" Value="">
                                            <Setter Property="Visibility" Value="Collapsed" />
                                        </DataTrigger>
                                        <DataTrigger Binding="{Binding Artist}" Value="{x:Null}">
                                            <Setter Property="Visibility" Value="Collapsed" />
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </TextBlock.Style>
                        </TextBlock>

                        <!-- Album or Feature Detail with Note Glyph (♫) -->
                        <StackPanel Orientation="Horizontal"
                                    Visibility="{Binding HasAlbum, Converter={StaticResource BoolToVis}}"
                                    Margin="0,1,0,0">
                            <TextBlock Text="&#xE8D6;"
                                       FontFamily="Segoe MDL2 Assets"
                                       FontSize="11"
                                       Foreground="#9DA4B2"
                                       VerticalAlignment="Center"
                                       Margin="0,1,6,0" />
                            <TextBlock Text="{Binding Album}"
                                       FontSize="13"
                                       FontWeight="Normal"
                                       FontFamily="Segoe UI Variable Text, Segoe UI, sans-serif"
                                       Foreground="#9DA4B2"
                                       TextTrimming="CharacterEllipsis"
                                       TextWrapping="NoWrap"
                                       VerticalAlignment="Center" />
                        </StackPanel>
                    </StackPanel>
                </Grid>
            </Grid>

            <!-- Bottom Docked Bar: Sound Source + Media Transport Controls -->
            <Border Grid.Row="1"
                    Background="#E017191E"
                    BorderThickness="0,1,0,0"
                    BorderBrush="#18FFFFFF"
                    Padding="20,0,14,0">
                <Grid VerticalAlignment="Center">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>

                    <!-- Left: Detected Sound Source (e.g. "YouTube", "Spotify", "VLC Media Player") -->
                    <TextBlock Grid.Column="0"
                               Text="{Binding SourceName}"
                               FontSize="13"
                               FontWeight="Normal"
                               FontFamily="Segoe UI Variable Text, Segoe UI, sans-serif"
                               Foreground="#B5BAC5"
                               TextTrimming="CharacterEllipsis"
                               VerticalAlignment="Center" />

                    <!-- Right: Transport Controls (< ▷ >) -->
                    <StackPanel Grid.Column="1"
                                Orientation="Horizontal"
                                VerticalAlignment="Center">
                        <!-- Previous Track (<) -->
                        <Button Style="{StaticResource MediaTransportButtonStyle}"
                                Command="{Binding SkipPreviousCommand}"
                                IsEnabled="{Binding CanSkipPrevious}"
                                ToolTip="Previous">
                            <TextBlock Text="&#xE76B;"
                                       FontFamily="Segoe MDL2 Assets"
                                       FontSize="12"
                                       VerticalAlignment="Center"
                                       HorizontalAlignment="Center" />
                        </Button>

                        <!-- Play / Pause (▷ or ||) -->
                        <Button Style="{StaticResource MediaTransportButtonStyle}"
                                Command="{Binding TogglePlayPauseCommand}"
                                IsEnabled="{Binding CanPlayPause}"
                                Margin="4,0"
                                ToolTip="Play / Pause">
                            <TextBlock x:Name="PlayPauseIcon"
                                       FontFamily="Segoe MDL2 Assets"
                                       FontSize="12"
                                       VerticalAlignment="Center"
                                       HorizontalAlignment="Center"
                                       Text="&#xE768;">
                                <TextBlock.Style>
                                    <Style TargetType="TextBlock">
                                        <Setter Property="Text" Value="&#xE768;" />
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding IsPlaying}" Value="True">
                                                <Setter Property="Text" Value="&#xE769;" />
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </TextBlock.Style>
                            </TextBlock>
                        </Button>

                        <!-- Next Track (>) -->
                        <Button Style="{StaticResource MediaTransportButtonStyle}"
                                Command="{Binding SkipNextCommand}"
                                IsEnabled="{Binding CanSkipNext}"
                                ToolTip="Next">
                            <TextBlock Text="&#xE76C;"
                                       FontFamily="Segoe MDL2 Assets"
                                       FontSize="12"
                                       VerticalAlignment="Center"
                                       HorizontalAlignment="Center" />
                        </Button>
                    </StackPanel>
                </Grid>
            </Border>
        </Grid>
    </widgets:WidgetCard>
</UserControl>
