                                <Path.Fill>
                                    <LinearGradientBrush StartPoint="0.5,0" EndPoint="0.5,1">
                                        <GradientStop Color="#E64E8D" Offset="0.0" />
                                        <GradientStop Color="#EA6C76" Offset="0.35" />
                                        <GradientStop Color="#EC7D63" Offset="0.65" />
                                        <GradientStop Color="#EE9037" Offset="1.0" />
                                    </LinearGradientBrush>
                                </Path.Fill>
                            </Path>

                            <!-- Authentic Zune Wordmark -->
                            <TextBlock Text="zune"
                                       FontFamily="{DynamicResource AppDisplayFontFamily}"
                                       FontSize="38"
                                       FontWeight="Light"
                                       Foreground="#80FFFFFF"
                                       HorizontalAlignment="Center"
                                       TextAlignment="Center"
                                       SnapsToDevicePixels="True" />
                        </StackPanel>
                    </Grid>

                    <!-- B. Active Media Screen: Full-Bleed High-Res Artwork (Clean, No Overlay) -->
                    <Grid Visibility="{Binding HasMedia, Converter={StaticResource BoolToVis}}">
                        <!-- High-Res Album Art filling the screen window edge-to-edge -->
                        <Border Background="#0A0D12" SnapsToDevicePixels="True">
                            <Image Source="{Binding Thumbnail}"
                                   Stretch="UniformToFill"
                                   HorizontalAlignment="Center"
                                   VerticalAlignment="Center"
                                   RenderOptions.BitmapScalingMode="HighQuality"
                                   SnapsToDevicePixels="True"
                                   Visibility="{Binding HasThumbnail, Converter={StaticResource BoolToVis}}" />
                        </Border>

                        <!-- Fallback Artwork Placeholder when HasThumbnail is false -->
                        <Border Background="#10141C" SnapsToDevicePixels="True">
                            <Border.Style>
                                <Style TargetType="Border">
                                    <Setter Property="Visibility" Value="Collapsed" />
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding HasThumbnail}" Value="False">
                                            <Setter Property="Visibility" Value="Visible" />
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </Border.Style>
                            <TextBlock Text="&#xE8D6;"
                                       FontFamily="{DynamicResource AppIconFontFamily}"
                                       FontSize="48"
                                       Foreground="#18FFFFFF"
                                       HorizontalAlignment="Center"
                                       VerticalAlignment="Center" />
                        </Border>
                    </Grid>

                    <!-- C. Authentic Diagonal Glass Glare Reflection -->
                    <Rectangle IsHitTestVisible="False" SnapsToDevicePixels="True">
                        <Rectangle.Fill>
                            <LinearGradientBrush StartPoint="0.1,0" EndPoint="0.85,1">
                                <GradientStop Color="#25FFFFFF" Offset="0.0" />
                                <GradientStop Color="#10FFFFFF" Offset="0.22" />
                                <GradientStop Color="#00FFFFFF" Offset="0.50" />
                            </LinearGradientBrush>
                        </Rectangle.Fill>
                    </Rectangle>
                </Grid>

                <!-- ========================================================= -->
                <!-- ROW 1: TRANSLUCENT ACRYLIC CHIN (PHYSICAL CONTROLS)       -->
                <!-- ========================================================= -->
                <Border Grid.Row="1"
                        CornerRadius="0,0,2,2"
                        SnapsToDevicePixels="True">
                    <Border.Background>
                        <LinearGradientBrush StartPoint="0,0" EndPoint="0,1">
                            <GradientStop Color="#1CFFFFFF" Offset="0.0" />
                            <GradientStop Color="#08FFFFFF" Offset="0.4" />
                            <GradientStop Color="#14000000" Offset="1.0" />
                        </LinearGradientBrush>
                    </Border.Background>

                    <Grid VerticalAlignment="Center" HorizontalAlignment="Stretch" Margin="16,4,16,6">
                        <Grid.RowDefinitions>
                            <!-- Row 0: Track Information (Title, Artist, Time) -->
                            <RowDefinition Height="Auto" />
                            <!-- Row 1: Transport Controls (Prev, Play/Pause, Next) -->
                            <RowDefinition Height="Auto" />
                        </Grid.RowDefinitions>

                        <!-- Track Details placed cleanly below the divider -->
                        <StackPanel Grid.Row="0" HorizontalAlignment="Center" Margin="0,0,0,8">
                            <!-- Song Title -->
                            <TextBlock Text="{Binding Title}"
                                       FontFamily="{DynamicResource AppDisplayFontFamily}"
                                       FontSize="15"
                                       FontWeight="SemiBold"
                                       Foreground="#FFFFFF"
                                       TextTrimming="CharacterEllipsis"
                                       TextWrapping="NoWrap"
                                       HorizontalAlignment="Center"
                                       TextAlignment="Center"
                                       MaxWidth="216"
                                       ToolTip="{Binding Title}"
                                       SnapsToDevicePixels="True" />

                            <!-- Artist Name -->
                            <TextBlock Text="{Binding Artist}"
                                       FontFamily="{DynamicResource AppDisplayFontFamily}"
                                       FontSize="13.5"
                                       FontWeight="Normal"
                                       Foreground="#CAD7EA"
                                       TextTrimming="CharacterEllipsis"
                                       TextWrapping="NoWrap"
                                       HorizontalAlignment="Center"
                                       TextAlignment="Center"
                                       MaxWidth="216"
                                       Margin="0,2,0,0"
                                       ToolTip="{Binding Artist}"
                                       SnapsToDevicePixels="True">
                                <TextBlock.Style>
                                    <Style TargetType="TextBlock">
                                        <Setter Property="Visibility" Value="Visible" />
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding Artist}" Value="">
                                                <Setter Property="Visibility" Value="Collapsed" />
                                            </DataTrigger>
                                            <DataTrigger Binding="{Binding Artist}" Value="{x:Null}">
                                                <Setter Property="Visibility" Value="Collapsed" />
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </TextBlock.Style>
                            </TextBlock>

                            <!-- Live Playback Time Readout -->
                            <TextBlock Text="{Binding TimeDisplayString}"
                                       FontFamily="{DynamicResource AppDisplayFontFamily}"
                                       FontSize="12"
                                       FontWeight="Normal"
                                       Foreground="#90FFFFFF"
                                       HorizontalAlignment="Center"
                                       TextAlignment="Center"
                                       Margin="0,2,0,0"
                                       SnapsToDevicePixels="True">
                                <TextBlock.Style>
                                    <Style TargetType="TextBlock">
                                        <Setter Property="Visibility" Value="Visible" />
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding HasMedia}" Value="False">
                                                <Setter Property="Visibility" Value="Collapsed" />
                                            </DataTrigger>
                                            <DataTrigger Binding="{Binding TimeDisplayString}" Value="">
                                                <Setter Property="Visibility" Value="Collapsed" />
                                            </DataTrigger>
                                            <DataTrigger Binding="{Binding IsLive}" Value="True">
                                                <Setter Property="Visibility" Value="Collapsed" />
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </TextBlock.Style>
                            </TextBlock>
                        </StackPanel>

                        <!-- Sleek Transport Controls (Prev, Sleek Circular Play/Pause, Next) -->
                        <StackPanel Grid.Row="1"
                                    Orientation="Horizontal"
                                    HorizontalAlignment="Center"
                                    VerticalAlignment="Center">
                            <!-- Left Button: Backward / Previous Track -->
                            <Button Style="{StaticResource ZuneSideButtonStyle}"
                                    Command="{Binding SkipPreviousCommand}"
                                    IsEnabled="{Binding CanSkipPrevious}"
                                    ToolTip="Previous Track"
                                    VerticalAlignment="Center"
                                    Margin="0,0,16,0">
                                <TextBlock Text="&#xE76B;"
                                           FontFamily="{DynamicResource AppIconFontFamily}"
                                           FontSize="13"
                                           Foreground="#B5FFFFFF"
                                           VerticalAlignment="Center"
                                           HorizontalAlignment="Center" />
                            </Button>

                            <!-- Center: Sleek Circular Play / Pause Button matching chevrons -->
                            <Button Style="{StaticResource ZunePadButtonStyle}"
                                    Command="{Binding TogglePlayPauseCommand}"
                                    IsEnabled="{Binding CanPlayPause}"
                                    ToolTip="Play / Pause"
                                    VerticalAlignment="Center">
                                <TextBlock FontFamily="{DynamicResource AppIconFontFamily}"
                                           FontSize="16"
                                           Foreground="#FFFFFF"
                                           VerticalAlignment="Center"
                                           HorizontalAlignment="Center">
                                    <TextBlock.Style>
                                        <Style TargetType="TextBlock">
                                            <Setter Property="Text" Value="&#xE768;" />
                                            <Setter Property="Margin" Value="1,0,0,0" />
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding IsPlaying}" Value="True">
                                                    <Setter Property="Text" Value="&#xE769;" />
                                                    <Setter Property="Margin" Value="0" />
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </TextBlock.Style>
                                </TextBlock>
                            </Button>

                            <!-- Right Button: Forward / Next Track -->
                            <Button Style="{StaticResource ZuneSideButtonStyle}"
                                    Command="{Binding SkipNextCommand}"
                                    IsEnabled="{Binding CanSkipNext}"
                                    ToolTip="Next Track"
                                    VerticalAlignment="Center"
                                    Margin="16,0,0,0">
                                <TextBlock Text="&#xE76C;"
                                           FontFamily="{DynamicResource AppIconFontFamily}"
                                           FontSize="13"
                                           Foreground="#B5FFFFFF"
                                           VerticalAlignment="Center"
                                           HorizontalAlignment="Center" />
                            </Button>
                        </StackPanel>
                    </Grid>
                </Border>

                <!-- Edge-to-Edge Hairline Seekbar on Top Edge of Acrylic Chin (Zero Overlap with Artwork) -->
                <Grid x:Name="ZuneSeekbarContainer"
                      Grid.Row="1"
                      VerticalAlignment="Top"
                      Height="12"
                      Margin="0,0,0,0"
                      Panel.ZIndex="10"
                      Background="Transparent"
                      Cursor="Hand"
                      Focusable="False"
                      Tag="InteractiveControl"
                      PreviewMouseLeftButtonDown="Seekbar_PreviewMouseLeftButtonDown"
                      MouseEnter="Seekbar_MouseEnter"
                      MouseLeave="Seekbar_MouseLeave"
                      MouseLeftButtonDown="Seekbar_MouseLeftButtonDown"
                      MouseMove="Seekbar_MouseMove"
                      MouseLeftButtonUp="Seekbar_MouseLeftButtonUp"
                      LostMouseCapture="Seekbar_LostMouseCapture"
                      SizeChanged="Seekbar_SizeChanged"
                      SnapsToDevicePixels="True">
                    <Grid.Style>
                        <Style TargetType="Grid">
                            <Setter Property="Visibility" Value="Visible" />
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding HasMedia}" Value="False">
                                    <Setter Property="Cursor" Value="Arrow" />
                                </DataTrigger>
                                <DataTrigger Binding="{Binding CanSeek}" Value="False">
                                    <Setter Property="Cursor" Value="Arrow" />
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </Grid.Style>

                    <!-- Seekbar Hairline Track (Seamlessly Flush against Album Art) -->
                    <Grid x:Name="ZuneSeekTrackGroup"
                          VerticalAlignment="Top"
                          RenderTransformOrigin="0.5,0">
                        <Grid.RenderTransform>
                            <ScaleTransform x:Name="ZuneSeekTrackScale" ScaleY="1.0" />
                        </Grid.RenderTransform>

                        <!-- Base Hairline Background Track (Divider line) -->
                        <Border x:Name="ZuneSeekTrackBg"
                                Height="2"
                                Background="#50FFFFFF"
                                CornerRadius="0"
                                SnapsToDevicePixels="True" />

                        <!-- Progress Fill -->
                        <Grid x:Name="ZuneSeekProgressContainer"
                              Height="2"
                              HorizontalAlignment="Stretch"
                              SnapsToDevicePixels="True">
                            <Grid.Clip>
                                <RectangleGeometry x:Name="ZuneSeekProgressClip" Rect="0,-5,0,24" />
                            </Grid.Clip>
                            <Border x:Name="ZuneSeekProgressFill"
                                    Height="2"
                                    CornerRadius="0"
                                    Background="{Binding SeekbarBrush}"
                                    SnapsToDevicePixels="True" />

                            <Rectangle x:Name="ZuneSeekShimmer"
                                       Width="50"
                                       Height="6"
                                       VerticalAlignment="Center"
                                       HorizontalAlignment="Left"
                                       IsHitTestVisible="False"
                                       Opacity="0.0"
                                       SnapsToDevicePixels="True">
                                <Rectangle.Fill>
                                    <LinearGradientBrush StartPoint="0,0" EndPoint="1,0">
                                        <GradientStop Color="#00FFFFFF" Offset="0.0" />
                                        <GradientStop Color="#70FFFFFF" Offset="0.5" />
                                        <GradientStop Color="#00FFFFFF" Offset="1.0" />
                                    </LinearGradientBrush>
                                </Rectangle.Fill>
                                <Rectangle.RenderTransform>
                                    <TranslateTransform x:Name="ZuneSeekShimmerTranslate" X="-60" />
                                </Rectangle.RenderTransform>
                            </Rectangle>
                        </Grid>
                    </Grid>

                    <!-- Circular Thumb Dot -->
                    <Grid x:Name="ZuneSeekThumb"
                          HorizontalAlignment="Left"
                          VerticalAlignment="Top"
                          Margin="0,-4,0,0"
                          IsHitTestVisible="False"
                          Opacity="0"
                          RenderTransformOrigin="0.5,0.5">
                        <Grid.RenderTransform>
                            <TransformGroup>
                                <ScaleTransform x:Name="ZuneSeekThumbScale" ScaleX="0.85" ScaleY="0.85" />
                                <TranslateTransform x:Name="ZuneSeekThumbTranslate" X="0" />
                            </TransformGroup>
                        </Grid.RenderTransform>
                        <Ellipse x:Name="ZuneSeekThumbDot"
                                 Width="10"
                                 Height="10"
                                 Fill="{Binding SeekbarBrush}"
                                 HorizontalAlignment="Center"
                                 VerticalAlignment="Center" />
                    </Grid>
                </Grid>
            </Grid>
        </Grid>
    </widgets:WidgetCard>
</UserControl>
