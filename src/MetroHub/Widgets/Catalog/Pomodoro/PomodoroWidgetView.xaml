<UserControl x:Class="MetroHub.Widgets.Catalog.Pomodoro.PomodoroWidgetView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:widgets="clr-namespace:MetroHub.Widgets"
             xmlns:pomodoro="clr-namespace:MetroHub.Widgets.Catalog.Pomodoro"
             mc:Ignorable="d" 
             d:DataContext="{d:DesignInstance Type=pomodoro:PomodoroWidgetViewModel}"
             Focusable="False"
             SnapsToDevicePixels="True"
             UseLayoutRounding="True"
             TextOptions.TextFormattingMode="Ideal"
             TextOptions.TextRenderingMode="Grayscale"
             TextOptions.TextHintingMode="Animated">

    <UserControl.Resources>
        <BooleanToVisibilityConverter x:Key="BoolToVis" />

        <!-- Media-Consistent Transport Button Style: Fluent Acrylic Button with 2px Corner Radius -->
        <Style x:Key="PomodoroTransportButtonStyle" TargetType="Button">
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="Foreground" Value="#E5E9F0" />
            <Setter Property="Width" Value="32" />
            <Setter Property="Height" Value="28" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Focusable" Value="False" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Border"
                                Background="{TemplateBinding Background}"
                                CornerRadius="2"
                                SnapsToDevicePixels="True">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Border" Property="Background" Value="#25FFFFFF" />
                                <Setter Property="Foreground" Value="#FFFFFF" />
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="Border" Property="Background" Value="#45FFFFFF" />
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter Property="Opacity" Value="0.3" />
                                <Setter Property="Cursor" Value="Arrow" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Round Indicator Dot Style -->
        <Style x:Key="CycleDotStyle" TargetType="Border">
            <Setter Property="Width" Value="7" />
            <Setter Property="Height" Value="7" />
            <Setter Property="CornerRadius" Value="3.5" />
            <Setter Property="Margin" Value="2.5,0" />
            <Setter Property="Background" Value="#25FFFFFF" />
            <Setter Property="SnapsToDevicePixels" Value="True" />
        </Style>
    </UserControl.Resources>

    <!-- Transparent WidgetCard to inherit the exact glass/acrylic tile background of other tiles -->
    <widgets:WidgetCard Padding="0" Background="Transparent" CornerRadius="2">
        <Grid SnapsToDevicePixels="True" UseLayoutRounding="True" ClipToBounds="True">

            <!-- ============================================================ -->
            <!-- MODE A: 4x2 RING-ONLY MINIMALIST LAYOUT                      -->
            <!-- ============================================================ -->
            <Grid SnapsToDevicePixels="True" UseLayoutRounding="True">
                <Grid.Style>
                    <Style TargetType="Grid">
                        <Setter Property="Visibility" Value="Collapsed" />
                        <Style.Triggers>
                            <DataTrigger Binding="{Binding IsRingOnly}" Value="True">
                                <Setter Property="Visibility" Value="Visible" />
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </Grid.Style>

                <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center" Orientation="Horizontal">
                    <!-- Centered Radial Progress Ring -->
                    <Grid Width="96" Height="96" Margin="0,0,16,0">
                        <!-- Ring Background Track -->
                        <Path Stroke="#18FFFFFF"
                              StrokeThickness="6"
                              SnapsToDevicePixels="True">
                            <Path.Data>
                                <EllipseGeometry Center="48,48" RadiusX="44" RadiusY="44" />
                            </Path.Data>
                        </Path>

                        <!-- Glowing Active Ring Arc (Generated in code-behind) -->
                        <Path x:Name="RingPath4x2"
                              Stroke="{Binding GlowSolidBrush}"
                              StrokeThickness="6"
                              StrokeStartLineCap="Round"
                              StrokeEndLineCap="Round"
                              SnapsToDevicePixels="True">
                            <Path.Effect>
                                <DropShadowEffect BlurRadius="8"
                                                  ShadowDepth="0"
                                                  Color="{Binding GlowColor}"
                                                  Opacity="0.8" />
                            </Path.Effect>
                        </Path>

                        <!-- Phase Icon in Center of Ring -->
                        <TextBlock Text="&#xE916;"
                                   FontFamily="Segoe MDL2 Assets"
                                   FontSize="24"
                                   Foreground="{Binding GlowSolidBrush}"
                                   HorizontalAlignment="Center"
                                   VerticalAlignment="Center">
                            <TextBlock.Effect>
                                <DropShadowEffect BlurRadius="6" ShadowDepth="0" Color="{Binding GlowColor}" Opacity="0.5" />
                            </TextBlock.Effect>
                        </TextBlock>
                    </Grid>

                    <!-- Right of Ring: Time, Phase & Transport Controls -->
                    <StackPanel VerticalAlignment="Center">
                        <!-- Phase Tag -->
                        <TextBlock Text="{Binding PhaseTitle}"
                                   FontSize="12"
                                   FontWeight="SemiBold"
                                   FontFamily="Segoe UI Variable Display, Segoe UI, sans-serif"
                                   Foreground="{Binding GlowSolidBrush}"
                                   Margin="0,0,0,2" />

                        <!-- Large Time Readout -->
                        <TextBlock Text="{Binding TimeString}"
                                   FontSize="28"
                                   FontWeight="SemiBold"
                                   FontFamily="Segoe UI Variable Display, Segoe UI, sans-serif"
                                   Foreground="#FFFFFF"
                                   Margin="0,0,0,6" />

                        <!-- Transport Controls Aligned with Text Above: Reset, Play/Pause, Skip -->
                        <StackPanel Orientation="Horizontal" Margin="0">
                            <!-- Reset (↺) -->
                            <Button Style="{StaticResource PomodoroTransportButtonStyle}"
                                    Command="{Binding ResetCommand}"
                                    ToolTip="Reset Timer">
                                <TextBlock Text="&#xE777;"
                                           FontFamily="Segoe MDL2 Assets"
                                           FontSize="13"
                                           VerticalAlignment="Center"
                                           HorizontalAlignment="Center" />
                            </Button>

                            <!-- Play / Pause (▷ or ||) -->
                            <Button Style="{StaticResource PomodoroTransportButtonStyle}"
                                    Command="{Binding TogglePlayPauseCommand}"
                                    Margin="4,0"
                                    ToolTip="{Binding PlayPauseTooltip}">
                                <TextBlock FontFamily="Segoe MDL2 Assets"
                                           FontSize="13"
                                           VerticalAlignment="Center"
                                           HorizontalAlignment="Center">
                                    <TextBlock.Style>
                                        <Style TargetType="TextBlock">
                                            <Setter Property="Text" Value="&#xE768;" />
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding IsRunning}" Value="True">
                                                    <Setter Property="Text" Value="&#xE769;" />
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </TextBlock.Style>
                                </TextBlock>
                            </Button>

                            <!-- Skip (⏭) -->
                            <Button Style="{StaticResource PomodoroTransportButtonStyle}"
                                    Command="{Binding SkipPhaseCommand}"
                                    ToolTip="Skip to next phase">
                                <TextBlock Text="&#xE76C;"
                                           FontFamily="Segoe MDL2 Assets"
                                           FontSize="13"
                                           VerticalAlignment="Center"
                                           HorizontalAlignment="Center" />
                            </Button>
                        </StackPanel>
                    </StackPanel>
                </StackPanel>
            </Grid>

            <!-- ============================================================ -->
            <!-- MODE B: 8x3 & 8x4 MEDIA PLAYER-CONSISTENT LAYOUT             -->
            <!-- ============================================================ -->
            <Grid SnapsToDevicePixels="True" UseLayoutRounding="True">
                <Grid.Style>
                    <Style TargetType="Grid">
                        <Setter Property="Visibility" Value="Visible" />
                        <Style.Triggers>
                            <DataTrigger Binding="{Binding IsRingOnly}" Value="True">
                                <Setter Property="Visibility" Value="Collapsed" />
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </Grid.Style>

                <Grid.RowDefinitions>
                    <RowDefinition Height="*" />    <!-- Row 0: Info (Left) + Elevated Ring (Right) -->
                    <RowDefinition Height="38" />   <!-- Row 1: Bottom Docked Bar + Hairline Seekbar -->
                </Grid.RowDefinitions>

                <!-- Row 0: Info on Left, Hero Ring Gauge on Right -->
                <Grid Grid.Row="0">
                    <!-- Left Content: Phase Title, Big Countdown Time, Streak/Status -->
                    <Grid HorizontalAlignment="Left"
                          VerticalAlignment="Center"
                          Margin="20,0,175,0">
                        <StackPanel>
                            <!-- Phase Title (Matches Track Title) -->
                            <TextBlock Text="{Binding PhaseTitle}"
                                       FontSize="17"
                                       FontWeight="SemiBold"
                                       FontFamily="Segoe UI Variable Display, Segoe UI, sans-serif"
                                       Foreground="#FFFFFF"
                                       Margin="0,0,0,3" />

                            <!-- Big Time Readout (Matches Artist Name) -->
                            <TextBlock Text="{Binding TimeString}"
                                       FontSize="28"
                                       FontWeight="SemiBold"
                                       FontFamily="Segoe UI Variable Display, Segoe UI, sans-serif"
                                       Foreground="{Binding GlowSolidBrush}"
                                       Margin="0,0,0,4" />

                            <!-- Detail line with status & streak (Matches Album detail) -->
                            <TextBlock Text="{Binding StatusString}"
                                       FontSize="13"
                                       FontWeight="Normal"
                                       FontFamily="Segoe UI Variable Text, Segoe UI, sans-serif"
                                       Foreground="#9DA5B4"
                                       VerticalAlignment="Center" />
                        </StackPanel>
                    </Grid>

                    <!-- Right Content: Elevated Circular Progress Ring (Matches Album Art position) -->
                    <Grid HorizontalAlignment="Right"
                          VerticalAlignment="Center"
                          Margin="0,0,28,0">

                        <Border Width="{Binding RingSize}"
                                Height="{Binding RingSize}"
                                CornerRadius="2"
                                SnapsToDevicePixels="True"
                                UseLayoutRounding="True">

                            <!-- Inner Circular Ring Gauge -->
                            <Grid Width="{Binding RingSize}" Height="{Binding RingSize}">
                                <!-- Background Track Ring -->
                                <Path Stroke="#18FFFFFF"
                                      StrokeThickness="6"
                                      SnapsToDevicePixels="True">
                                    <Path.Data>
                                        <EllipseGeometry x:Name="BgRingGeometry" Center="54,54" RadiusX="48" RadiusY="48" />
                                    </Path.Data>
                                </Path>

                                <!-- Active Progress Arc (Dynamic PathGeometry) -->
                                <Path x:Name="RingPathHero"
                                      Stroke="{Binding GlowSolidBrush}"
                                      StrokeThickness="6"
                                      StrokeStartLineCap="Round"
                                      StrokeEndLineCap="Round"
                                      SnapsToDevicePixels="True">
                                    <Path.Effect>
                                        <DropShadowEffect BlurRadius="10"
                                                          ShadowDepth="0"
                                                          Color="{Binding GlowColor}"
                                                          Opacity="0.85" />
                                    </Path.Effect>
                                </Path>

                                <!-- Center Icon / Status inside Hero Ring -->
                                <TextBlock Text="&#xE916;"
                                           FontFamily="Segoe MDL2 Assets"
                                           FontSize="28"
                                           Foreground="{Binding GlowSolidBrush}"
                                           HorizontalAlignment="Center"
                                           VerticalAlignment="Center">
                                    <TextBlock.Effect>
                                        <DropShadowEffect BlurRadius="8" ShadowDepth="0" Color="{Binding GlowColor}" Opacity="0.6" />
                                    </TextBlock.Effect>
                                </TextBlock>
                            </Grid>
                        </Border>
                    </Grid>
                </Grid>

                <!-- Row 1: Bottom Docked Bar (Transport Controls on Left, Cycle Dots on Right) -->
                <Border Grid.Row="1"
                        Background="#14000000"
                        BorderThickness="0"
                        CornerRadius="0,0,2,2"
                        SnapsToDevicePixels="True"
                        Padding="14,0,14,0">
                    <Grid VerticalAlignment="Center">
                        <!-- Left: Transport Controls (Reset, Play/Pause, Skip) -->
                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Left">
                            <!-- Reset (↺) -->
                            <Button Style="{StaticResource PomodoroTransportButtonStyle}"
                                    Command="{Binding ResetCommand}"
                                    ToolTip="Reset Session">
                                <TextBlock Text="&#xE777;"
                                           FontFamily="Segoe MDL2 Assets"
                                           FontSize="13"
                                           VerticalAlignment="Center"
                                           HorizontalAlignment="Center" />
                            </Button>

                            <!-- Play / Pause (▷ or ||) -->
                            <Button Style="{StaticResource PomodoroTransportButtonStyle}"
                                    Command="{Binding TogglePlayPauseCommand}"
                                    Margin="4,0"
                                    ToolTip="{Binding PlayPauseTooltip}">
                                <TextBlock FontFamily="Segoe MDL2 Assets"
                                           FontSize="13"
                                           VerticalAlignment="Center"
                                           HorizontalAlignment="Center">
                                    <TextBlock.Style>
                                        <Style TargetType="TextBlock">
                                            <Setter Property="Text" Value="&#xE768;" />
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding IsRunning}" Value="True">
                                                    <Setter Property="Text" Value="&#xE769;" />
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </TextBlock.Style>
                                </TextBlock>
                            </Button>

                            <!-- Skip to next phase (⏭) -->
                            <Button Style="{StaticResource PomodoroTransportButtonStyle}"
                                    Command="{Binding SkipPhaseCommand}"
                                    ToolTip="Skip to next phase">
                                <TextBlock Text="&#xE76C;"
                                           FontFamily="Segoe MDL2 Assets"
                                           FontSize="13"
                                           VerticalAlignment="Center"
                                           HorizontalAlignment="Center" />
                            </Button>
                        </StackPanel>

                        <!-- Right: Cycle Tracker Dots (● ● ○ ○) -->
                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center">
                            <!-- Dot 1 -->
                            <Border>
                                <Border.Style>
                                    <Style TargetType="Border" BasedOn="{StaticResource CycleDotStyle}">
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding CycleDot1Filled}" Value="True">
                                                <Setter Property="Background" Value="{Binding GlowSolidBrush}" />
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </Border.Style>
                            </Border>

                            <!-- Dot 2 -->
                            <Border>
                                <Border.Style>
                                    <Style TargetType="Border" BasedOn="{StaticResource CycleDotStyle}">
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding CycleDot2Filled}" Value="True">
                                                <Setter Property="Background" Value="{Binding GlowSolidBrush}" />
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </Border.Style>
                            </Border>

                            <!-- Dot 3 -->
                            <Border>
                                <Border.Style>
                                    <Style TargetType="Border" BasedOn="{StaticResource CycleDotStyle}">
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding CycleDot3Filled}" Value="True">
                                                <Setter Property="Background" Value="{Binding GlowSolidBrush}" />
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </Border.Style>
                            </Border>

                            <!-- Dot 4 (Long Break) -->
                            <Border>
                                <Border.Style>
                                    <Style TargetType="Border" BasedOn="{StaticResource CycleDotStyle}">
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding CycleDot4Filled}" Value="True">
                                                <Setter Property="Background" Value="{Binding GlowSolidBrush}" />
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </Border.Style>
                            </Border>
                        </StackPanel>
                    </Grid>
                </Border>

                <!-- Edge-to-Edge Hairline Glowing Progress Bar running along the top boundary of Row 1 -->
                <Grid x:Name="ProgressBarContainer"
                      Grid.Row="1"
                      VerticalAlignment="Top"
                      Height="14"
                      Margin="0,-7,0,0"
                      Background="Transparent"
                      SizeChanged="ProgressBarContainer_SizeChanged"
                      SnapsToDevicePixels="True">

                    <!-- 1. Background Track (2px tall hairline) -->
                    <Border Height="2"
                            VerticalAlignment="Center"
                            Background="#14FFFFFF"
                            CornerRadius="1"
                            SnapsToDevicePixels="True" />

                    <!-- 2. Elapsed Progress Fill Track: Luminous Glowing Fill in Phase Color -->
                    <Border x:Name="ProgressFill"
                            Height="2"
                            HorizontalAlignment="Left"
                            VerticalAlignment="Center"
                            Width="0"
                            Background="{Binding GlowSolidBrush}"
                            CornerRadius="1"
                            SnapsToDevicePixels="True">
                        <Border.Effect>
                            <DropShadowEffect BlurRadius="6"
                                              ShadowDepth="0"
                                              Color="{Binding GlowColor}"
                                              Opacity="0.75" />
                        </Border.Effect>
                    </Border>
                </Grid>
            </Grid>
        </Grid>
    </widgets:WidgetCard>
</UserControl>
