<UserControl x:Class="MetroHub.Widgets.Catalog.Game2048.Game2048WidgetView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
             xmlns:widgets="clr-namespace:MetroHub.Widgets"
             xmlns:local="clr-namespace:MetroHub.Widgets.Catalog.Game2048"
             mc:Ignorable="d" 
             d:DataContext="{d:DesignInstance Type=local:Game2048WidgetViewModel}"
             Focusable="True"
             ClipToBounds="True"
             FontFamily="{DynamicResource AppFontFamily}">

    <UserControl.Resources>
        <BooleanToVisibilityConverter x:Key="BoolToVis" />
    </UserControl.Resources>

    <widgets:WidgetCard Padding="0" Background="Transparent">
        <Grid x:Name="RootLayout" Background="Transparent" ClipToBounds="True">
            <Grid.RowDefinitions>
                <!-- Row 0: Top Header (Title + Scores + Micro Reset) -->
                <RowDefinition Height="Auto" />
                <!-- Row 1: Universal 1px Hairline Divider -->
                <RowDefinition Height="Auto" />
                <!-- Row 2: Scalable 2048 Game Board Viewbox -->
                <RowDefinition Height="*" />
            </Grid.RowDefinitions>

            <!-- Row 0: Top Header (20px symmetrical clearance per docs/WIDGET_LIFECYCLE_STANDARDS.md §6) -->
            <Grid Grid.Row="0" Margin="20,12,20,12">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <!-- Left: Title -->
                <TextBlock Grid.Column="0"
                           Text="2048"
                           FontFamily="{DynamicResource AppFontFamily}"
                           FontSize="{DynamicResource TypeSubtitleFontSize}"
                           FontWeight="{DynamicResource TypeSubtitleFontWeight}"
                           Foreground="{DynamicResource TextPrimaryBrush}"
                           VerticalAlignment="Center" />

                <!-- Right: Unified Stats & Micro Action Button -->
                <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center">
                    <!-- Score -->
                    <TextBlock VerticalAlignment="Center" FontFamily="{DynamicResource AppFontFamily}">
                        <Run Text="SCORE "
                             FontSize="{DynamicResource TypeCaptionFontSize}"
                             FontWeight="{DynamicResource TypeBodyStrongFontWeight}"
                             Foreground="{DynamicResource TextMutedBrush}" /><Run Text="{Binding Score}"
                             FontSize="{DynamicResource TypeBodyStrongFontSize}"
                             FontWeight="{DynamicResource TypeSubtitleFontWeight}"
                             Foreground="{DynamicResource TextPrimaryBrush}"
                             Typography.NumeralAlignment="Tabular" />
                    </TextBlock>

                    <!-- Vertical Toolbar Divider (Design System §9.1) -->
                    <Border Width="1"
                            Height="14"
                            Background="{DynamicResource WidgetDividerBrush}"
                            VerticalAlignment="Center"
                            Margin="10,0"
                            SnapsToDevicePixels="True" />

                    <!-- Best Score -->
                    <TextBlock VerticalAlignment="Center" FontFamily="{DynamicResource AppFontFamily}">
                        <Run Text="BEST "
                             FontSize="{DynamicResource TypeCaptionFontSize}"
                             FontWeight="{DynamicResource TypeBodyStrongFontWeight}"
                             Foreground="{DynamicResource TextMutedBrush}" /><Run Text="{Binding BestScore}"
                             FontSize="{DynamicResource TypeBodyStrongFontSize}"
                             FontWeight="{DynamicResource TypeSubtitleFontWeight}"
                             Foreground="{DynamicResource TextPrimaryBrush}"
                             Typography.NumeralAlignment="Tabular" />
                    </TextBlock>

                    <!-- Vertical Toolbar Divider before Action Button -->
                    <Border Width="1"
                            Height="14"
                            Background="{DynamicResource WidgetDividerBrush}"
                            VerticalAlignment="Center"
                            Margin="10,0,6,0"
                            SnapsToDevicePixels="True" />

                    <!-- Universal 28x28 Micro Ghost Button: Reset -->
                    <Button Style="{StaticResource WidgetMicroButtonStyle}"
                            Command="{Binding RestartGameCommand}"
                            ToolTip="New Game (R)"
                            VerticalAlignment="Center">
                        <ui:SymbolIcon Symbol="ArrowReset24"
                                       FontSize="14"
                                       Foreground="{DynamicResource TextSecondaryBrush}" />
                    </Button>
                </StackPanel>
            </Grid>

            <!-- Row 1: Universal 1px Horizontal Hairline Divider (WidgetHairlineDividerStyle) -->
            <Border Grid.Row="1"
                    Style="{StaticResource WidgetHairlineDividerStyle}" />

            <!-- Row 2: Scalable Game Board Area -->
            <Viewbox Grid.Row="2"
                     Stretch="Uniform"
                     Margin="20,12,20,16"
                     SnapsToDevicePixels="False"
                     UseLayoutRounding="False"
                     HorizontalAlignment="Center"
                     VerticalAlignment="Center">
                <Grid Width="400" Height="400" ClipToBounds="True">
                    <!-- Board Surface Layer (Dimmed on Game Over / Win) -->
                    <Grid>
                        <Grid.Style>
                            <Style TargetType="Grid">
                                <Setter Property="Opacity" Value="1.0" />
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding IsGameOver}" Value="True">
                                        <Setter Property="Opacity" Value="0.25" />
                                    </DataTrigger>
                                    <DataTrigger Binding="{Binding HasWon}" Value="True">
                                        <Setter Property="Opacity" Value="0.25" />
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </Grid.Style>

                        <!-- Board Frame -->
                        <Border Width="400" Height="400"
                                CornerRadius="{DynamicResource TileCornerRadius}"
                                Background="Transparent"
                                BorderThickness="0">
                            <!-- Static 4x4 Grid of Empty Cells (384px inner area: 98px step, 90px cell + 8px gap) -->
                            <UniformGrid Rows="4" Columns="4" Margin="4">
                                <Border Margin="4" CornerRadius="{DynamicResource TileCornerRadius}" Background="{DynamicResource SurfaceGlassSubtleBrush}" BorderThickness="0" />
                                <Border Margin="4" CornerRadius="{DynamicResource TileCornerRadius}" Background="{DynamicResource SurfaceGlassSubtleBrush}" BorderThickness="0" />
                                <Border Margin="4" CornerRadius="{DynamicResource TileCornerRadius}" Background="{DynamicResource SurfaceGlassSubtleBrush}" BorderThickness="0" />
                                <Border Margin="4" CornerRadius="{DynamicResource TileCornerRadius}" Background="{DynamicResource SurfaceGlassSubtleBrush}" BorderThickness="0" />

                                <Border Margin="4" CornerRadius="{DynamicResource TileCornerRadius}" Background="{DynamicResource SurfaceGlassSubtleBrush}" BorderThickness="0" />
                                <Border Margin="4" CornerRadius="{DynamicResource TileCornerRadius}" Background="{DynamicResource SurfaceGlassSubtleBrush}" BorderThickness="0" />
                                <Border Margin="4" CornerRadius="{DynamicResource TileCornerRadius}" Background="{DynamicResource SurfaceGlassSubtleBrush}" BorderThickness="0" />
                                <Border Margin="4" CornerRadius="{DynamicResource TileCornerRadius}" Background="{DynamicResource SurfaceGlassSubtleBrush}" BorderThickness="0" />

                                <Border Margin="4" CornerRadius="{DynamicResource TileCornerRadius}" Background="{DynamicResource SurfaceGlassSubtleBrush}" BorderThickness="0" />
                                <Border Margin="4" CornerRadius="{DynamicResource TileCornerRadius}" Background="{DynamicResource SurfaceGlassSubtleBrush}" BorderThickness="0" />
                                <Border Margin="4" CornerRadius="{DynamicResource TileCornerRadius}" Background="{DynamicResource SurfaceGlassSubtleBrush}" BorderThickness="0" />
                                <Border Margin="4" CornerRadius="{DynamicResource TileCornerRadius}" Background="{DynamicResource SurfaceGlassSubtleBrush}" BorderThickness="0" />

                                <Border Margin="4" CornerRadius="{DynamicResource TileCornerRadius}" Background="{DynamicResource SurfaceGlassSubtleBrush}" BorderThickness="0" />
                                <Border Margin="4" CornerRadius="{DynamicResource TileCornerRadius}" Background="{DynamicResource SurfaceGlassSubtleBrush}" BorderThickness="0" />
                                <Border Margin="4" CornerRadius="{DynamicResource TileCornerRadius}" Background="{DynamicResource SurfaceGlassSubtleBrush}" BorderThickness="0" />
                                <Border Margin="4" CornerRadius="{DynamicResource TileCornerRadius}" Background="{DynamicResource SurfaceGlassSubtleBrush}" BorderThickness="0" />
                            </UniformGrid>
                        </Border>

                        <!-- Active Animated Tiles Canvas Layer -->
                        <Canvas x:Name="TilesCanvas" Width="400" Height="400" ClipToBounds="True"
                                SnapsToDevicePixels="False" UseLayoutRounding="False" />
                    </Grid>

                    <!-- Game Over Overlay -->
                    <Border x:Name="GameOverOverlay"
                            Width="400" Height="400"
                            CornerRadius="{DynamicResource TileCornerRadius}"
                            Background="Transparent"
                            Visibility="{Binding IsGameOver, Converter={StaticResource BoolToVis}}"
                            SnapsToDevicePixels="True">
                        <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center">
                            <TextBlock Text="Game Over"
                                       FontFamily="{DynamicResource AppFontFamily}"
                                       FontSize="{DynamicResource TypeDisplayFontSize}"
                                       FontWeight="Bold"
                                       Foreground="{DynamicResource TextPrimaryBrush}"
                                       Effect="{DynamicResource ShadowCard}"
                                       HorizontalAlignment="Center"
                                       Margin="0,0,0,16" />
                            <Button Style="{DynamicResource AccentButtonStyle}"
                                    Command="{Binding RestartGameCommand}"
                                    Content="Try Again"
                                    Height="32"
                                    Padding="16,0"
                                    Effect="{DynamicResource ShadowCard}"
                                    HorizontalAlignment="Center" />
                        </StackPanel>
                    </Border>

                    <!-- Win Overlay -->
                    <Border x:Name="WinOverlay"
                            Width="400" Height="400"
                            CornerRadius="{DynamicResource TileCornerRadius}"
                            Background="Transparent"
                            Visibility="{Binding HasWon, Converter={StaticResource BoolToVis}}"
                            SnapsToDevicePixels="True">
                        <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center">
                            <TextBlock Text="You Win!"
                                       FontFamily="{DynamicResource AppFontFamily}"
                                       FontSize="{DynamicResource TypeDisplayFontSize}"
                                       FontWeight="Bold"
                                       Foreground="{DynamicResource SystemAccentColorPrimaryBrush}"
                                       Effect="{DynamicResource ShadowCard}"
                                       HorizontalAlignment="Center"
                                       Margin="0,0,0,4" />
                            <TextBlock Text="Reached 2048 Tile"
                                       FontFamily="{DynamicResource AppFontFamily}"
                                       FontSize="{DynamicResource TypeBodyFontSize}"
                                       Foreground="{DynamicResource TextSecondaryBrush}"
                                       Effect="{DynamicResource ShadowCard}"
                                       HorizontalAlignment="Center"
                                       Margin="0,0,0,18" />
                            <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                                <Button Style="{DynamicResource AccentButtonStyle}"
                                        Command="{Binding ContinueAfterWinCommand}"
                                        Content="Keep Playing"
                                        Height="32"
                                        Padding="16,0"
                                        Effect="{DynamicResource ShadowCard}"
                                        Margin="0,0,10,0" />
                                <Button Style="{StaticResource DefaultButtonStyle}"
                                        Command="{Binding RestartGameCommand}"
                                        Content="New Game"
                                        Height="32"
                                        Padding="16,0"
                                        Effect="{DynamicResource ShadowCard}" />
                            </StackPanel>
                        </StackPanel>
                    </Border>
                </Grid>
            </Viewbox>
        </Grid>
    </widgets:WidgetCard>
</UserControl>
