<controls:BorderlessFluentWindow x:Class="MetroHub.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:controls="clr-namespace:MetroHub.Presentation.Controls"
        xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
        mc:Ignorable="d"
        Title="MetroHub"
        ResizeMode="NoResize"
        ExtendsContentIntoTitleBar="True"
        WindowBackdropType="None"
        Background="Transparent"
        WindowCornerPreference="DoNotRound"
        WindowStyle="None"
        BorderThickness="0"
        BorderBrush="Transparent"
        AllowsTransparency="False"
        ShowInTaskbar="False"
        Topmost="True"
        FontFamily="Segoe UI Variable Text, Segoe UI Variable, Segoe UI, sans-serif"
        FontSize="14"
        TextOptions.TextFormattingMode="Display"
        TextOptions.TextRenderingMode="ClearType"
        RenderOptions.ClearTypeHint="Enabled"
        SnapsToDevicePixels="True"
        UseLayoutRounding="True"
        PreviewKeyDown="OnWindowPreviewKeyDown"
        SourceInitialized="OnSourceInitialized"
        Deactivated="OnWindowDeactivated"
        AllowDrop="True"
        DragOver="OnWindowDragOver"
        DragLeave="OnWindowDragLeave"
        Drop="OnWindowDrop">

    <controls:BorderlessFluentWindow.Resources>
        <!-- Clean Decelerating Entrance: Smooth Rise & Fade (No Bounce/Overshoot) -->
        <Storyboard x:Key="OpenStoryboard">
            <DoubleAnimation Storyboard.TargetName="RootGrid"
                             Storyboard.TargetProperty="Opacity"
                             From="0.0" To="1.0"
                             Duration="0:0:0.18">
                <DoubleAnimation.EasingFunction>
                    <CubicEase EasingMode="EaseOut" />
                </DoubleAnimation.EasingFunction>
            </DoubleAnimation>

            <DoubleAnimation Storyboard.TargetName="RootTranslate"
                             Storyboard.TargetProperty="Y"
                             From="20.0" To="0.0"
                             Duration="0:0:0.20">
                <DoubleAnimation.EasingFunction>
                    <CubicEase EasingMode="EaseOut" />
                </DoubleAnimation.EasingFunction>
            </DoubleAnimation>

            <DoubleAnimation Storyboard.TargetName="RootScale"
                             Storyboard.TargetProperty="ScaleX"
                             From="0.985" To="1.0"
                             Duration="0:0:0.20">
                <DoubleAnimation.EasingFunction>
                    <CubicEase EasingMode="EaseOut" />
                </DoubleAnimation.EasingFunction>
            </DoubleAnimation>

            <DoubleAnimation Storyboard.TargetName="RootScale"
                             Storyboard.TargetProperty="ScaleY"
                             From="0.985" To="1.0"
                             Duration="0:0:0.20">
                <DoubleAnimation.EasingFunction>
                    <CubicEase EasingMode="EaseOut" />
                </DoubleAnimation.EasingFunction>
            </DoubleAnimation>
        </Storyboard>

        <!-- Clean Snappy Exit: Smooth Downward Fade -->
        <Storyboard x:Key="ExitStoryboard">
            <DoubleAnimation Storyboard.TargetName="RootGrid"
                             Storyboard.TargetProperty="Opacity"
                             To="0.0"
                             Duration="0:0:0.11">
                <DoubleAnimation.EasingFunction>
                    <QuadraticEase EasingMode="EaseIn" />
                </DoubleAnimation.EasingFunction>
            </DoubleAnimation>

            <DoubleAnimation Storyboard.TargetName="RootTranslate"
                             Storyboard.TargetProperty="Y"
                             To="12.0"
                             Duration="0:0:0.11">
                <DoubleAnimation.EasingFunction>
                    <QuadraticEase EasingMode="EaseIn" />
                </DoubleAnimation.EasingFunction>
            </DoubleAnimation>

            <DoubleAnimation Storyboard.TargetName="RootScale"
                             Storyboard.TargetProperty="ScaleX"
                             To="0.985"
                             Duration="0:0:0.11">
                <DoubleAnimation.EasingFunction>
                    <QuadraticEase EasingMode="EaseIn" />
                </DoubleAnimation.EasingFunction>
            </DoubleAnimation>

            <DoubleAnimation Storyboard.TargetName="RootScale"
                             Storyboard.TargetProperty="ScaleY"
                             To="0.985"
                             Duration="0:0:0.11">
                <DoubleAnimation.EasingFunction>
                    <QuadraticEase EasingMode="EaseIn" />
                </DoubleAnimation.EasingFunction>
            </DoubleAnimation>
        </Storyboard>
    </controls:BorderlessFluentWindow.Resources>

    <!-- WPF Transparent brush passes mouse hit-tests while remaining invisible so DWM Mica renders directly -->
   <Grid x:Name="RootGrid" 
          Background="Transparent"
          Opacity="0"
          RenderTransformOrigin="0.5, 0.5"
          UseLayoutRounding="True"
          SnapsToDevicePixels="True"
          TextOptions.TextFormattingMode="Display"
          TextOptions.TextRenderingMode="ClearType"
          PreviewMouseLeftButtonDown="OnCanvasPreviewMouseDown"
          PreviewMouseMove="OnCanvasPreviewMouseMove"
          PreviewMouseLeftButtonUp="OnCanvasPreviewMouseUp"
          MouseLeave="OnCanvasMouseLeave">
       <Grid.RenderTransform>
            <TransformGroup>
                <ScaleTransform x:Name="RootScale" ScaleX="0.985" ScaleY="0.985" />
                <TranslateTransform x:Name="RootTranslate" Y="20.0" />
            </TransformGroup>
        </Grid.RenderTransform>
        <Grid.RowDefinitions>
            <!-- Minimalist Top Bar -->
            <RowDefinition Height="64" />
            <!-- Main Unified Draggable Tile Canvas -->
            <RowDefinition Height="*" />
            <!-- Bottom Status Bar -->
            <RowDefinition Height="40" />
        </Grid.RowDefinitions>

        <!-- Top Header Bar -->
        <Grid x:Name="HeaderGrid" Grid.Row="0" Margin="48,0,48,0">
            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                <TextBlock Text="METRO" FontSize="20" FontWeight="Bold" Foreground="#60CDFF" />
                <TextBlock Text="HUB" FontSize="20" FontWeight="Light" Foreground="#FFFFFF" Margin="3,0,16,0" />
                <TextBlock Text="•  Start Canvas" FontSize="13" Foreground="#90FFFFFF" VerticalAlignment="Center" />
            </StackPanel>

            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center">
                <!-- Backdrop Material Switch -->
                <ui:ToggleSwitch x:Name="BackdropToggleSwitch"
                                 OnContent="Acrylic Obsidian"
                                 OffContent="Mica"
                                 FontSize="11"
                                 Foreground="#C0FFFFFF"
                                 VerticalAlignment="Center"
                                 Margin="0,0,16,0"
                                 Click="OnBackdropToggleClick" />

                <!-- Add Tile Button -->
                <Button Content="+ Add Tile"
                        Height="34" Padding="14,0"
                        FontSize="12" FontWeight="SemiBold"
                        Foreground="#FFFFFF" Background="#33FFFFFF"
                        BorderThickness="1" BorderBrush="#44FFFFFF"
                        Cursor="Hand" Margin="0,0,12,0"
                        Click="OnAddTileClick">
                    <Button.Resources>
                        <Style TargetType="Border"><Setter Property="CornerRadius" Value="7"/></Style>
                    </Button.Resources>
                </Button>

                <!-- Export Layout Button -->
                <Button Content="Export"
                        Height="34" Padding="12,0"
                        FontSize="11" Foreground="#C0FFFFFF" Background="#1FFFFFFF"
                        BorderThickness="1" BorderBrush="#2AFFFFFF"
                        Cursor="Hand" Margin="0,0,10,0"
                        Click="OnExportLayoutClick">
                    <Button.Resources>
                        <Style TargetType="Border"><Setter Property="CornerRadius" Value="7"/></Style>
                    </Button.Resources>
                </Button>

                <!-- Close to Tray Button -->
                <Button Content="✕"
                        Width="34" Height="34"
                        FontSize="13" Foreground="#C0FFFFFF" Background="#1FFFFFFF"
                        BorderThickness="1" BorderBrush="#2AFFFFFF"
                        Cursor="Hand" ToolTip="Hide to Tray (Esc)"
                        Click="OnCloseToTrayClick">
                    <Button.Resources>
                        <Style TargetType="Border"><Setter Property="CornerRadius" Value="7"/></Style>
                    </Button.Resources>
                </Button>
            </StackPanel>
        </Grid>

        <!-- Main Open Tile Canvas: Free placement drag and drop anywhere -->
        <ScrollViewer Grid.Row="1"
                      x:Name="ContentScrollViewer"
                      VerticalScrollBarVisibility="Auto"
                      HorizontalScrollBarVisibility="Disabled"
                      Background="Transparent"
                      Focusable="False">

            <Grid x:Name="MainCanvasGrid"
                  Background="Transparent"
                  PreviewMouseRightButtonDown="OnCanvasPreviewMouseRightButtonDown">
                <Grid.ContextMenu>
                    <ContextMenu x:Name="CanvasContextMenu"
                                 Opened="OnCanvasContextMenuOpened"
                                 Closed="OnCanvasContextMenuClosed">
                        <!-- Modular Catalogs: Apps -->
                        <MenuItem x:Name="AppsMenuItem"
                                  Header="Apps"
                                  SubmenuOpened="OnAppsSubmenuOpened">
                            <MenuItem.Icon>
                                <ui:SymbolIcon Symbol="Apps24" FontSize="20" />
                            </MenuItem.Icon>
                            <MenuItem.Resources>
                                <Style TargetType="{x:Type ui:PassiveScrollViewer}">
                                    <Setter Property="MaxHeight" Value="500" />
                                    <Setter Property="VerticalScrollBarVisibility" Value="Auto" />
                                    <Setter Property="HorizontalScrollBarVisibility" Value="Disabled" />
                                    <Setter Property="CanContentScroll" Value="True" />
                                </Style>
                                <Style TargetType="{x:Type ScrollViewer}">
                                    <Setter Property="MaxHeight" Value="500" />
                                    <Setter Property="VerticalScrollBarVisibility" Value="Auto" />
                                    <Setter Property="HorizontalScrollBarVisibility" Value="Disabled" />
                                    <Setter Property="CanContentScroll" Value="True" />
                                </Style>
                            </MenuItem.Resources>
                            <MenuItem Header="Loading applications..." IsEnabled="False" />
                        </MenuItem>

                        <!-- Dynamic Group Options (Visible when right-clicking empty space inside a group) -->
                        <Separator x:Name="GroupMenuSeparator" Visibility="Collapsed" />

                        <MenuItem x:Name="RenameGroupCanvasMenuItem"
                                  Header="Rename Group"
                                  Visibility="Collapsed"
                                  Click="OnCanvasRenameGroupClick">
                            <MenuItem.Icon>
                                <ui:SymbolIcon Symbol="Edit24" FontSize="20" />
                            </MenuItem.Icon>
                        </MenuItem>

                        <MenuItem x:Name="GroupHeaderColorCanvasMenuItem"
                                  Header="Header Color"
                                  Visibility="Collapsed">
                            <MenuItem.Icon>
                                <ui:SymbolIcon Symbol="Color24" FontSize="20" />
                            </MenuItem.Icon>
                            <MenuItem Header="Default White" Tag="#F0FFFFFF" Click="OnCanvasGroupColorSelectClick">
                                <MenuItem.Icon><Ellipse Width="12" Height="12" Fill="#F0FFFFFF"/></MenuItem.Icon>
                            </MenuItem>
                            <MenuItem Header="Fluent Sky Blue" Tag="#60CDFF" Click="OnCanvasGroupColorSelectClick">
                                <MenuItem.Icon><Ellipse Width="12" Height="12" Fill="#60CDFF"/></MenuItem.Icon>
                            </MenuItem>
                            <MenuItem Header="Electric Azure" Tag="#0078D7" Click="OnCanvasGroupColorSelectClick">
                                <MenuItem.Icon><Ellipse Width="12" Height="12" Fill="#0078D7"/></MenuItem.Icon>
                            </MenuItem>
                            <MenuItem Header="Emerald Green" Tag="#107C10" Click="OnCanvasGroupColorSelectClick">
                                <MenuItem.Icon><Ellipse Width="12" Height="12" Fill="#107C10"/></MenuItem.Icon>
                            </MenuItem>
                            <MenuItem Header="Mint Cyan" Tag="#00B7C3" Click="OnCanvasGroupColorSelectClick">
                                <MenuItem.Icon><Ellipse Width="12" Height="12" Fill="#00B7C3"/></MenuItem.Icon>
                            </MenuItem>
                            <MenuItem Header="Neon Orange" Tag="#FF8C00" Click="OnCanvasGroupColorSelectClick">
                                <MenuItem.Icon><Ellipse Width="12" Height="12" Fill="#FF8C00"/></MenuItem.Icon>
                            </MenuItem>
                            <MenuItem Header="Electric Amber" Tag="#FFD700" Click="OnCanvasGroupColorSelectClick">
                                <MenuItem.Icon><Ellipse Width="12" Height="12" Fill="#FFD700"/></MenuItem.Icon>
                            </MenuItem>
                            <MenuItem Header="Crimson Red" Tag="#FF4343" Click="OnCanvasGroupColorSelectClick">
                                <MenuItem.Icon><Ellipse Width="12" Height="12" Fill="#FF4343"/></MenuItem.Icon>
                            </MenuItem>
                            <MenuItem Header="Royal Purple" Tag="#881798" Click="OnCanvasGroupColorSelectClick">
                                <MenuItem.Icon><Ellipse Width="12" Height="12" Fill="#881798"/></MenuItem.Icon>
                            </MenuItem>
                            <MenuItem Header="Hot Pink" Tag="#E3008C" Click="OnCanvasGroupColorSelectClick">
                                <MenuItem.Icon><Ellipse Width="12" Height="12" Fill="#E3008C"/></MenuItem.Icon>
                            </MenuItem>
                        </MenuItem>

                        <MenuItem x:Name="GroupTintColorCanvasMenuItem"
                                  Header="Group Tint Color"
                                  Visibility="Collapsed">
                            <MenuItem.Icon>
                                <ui:SymbolIcon Symbol="DarkTheme24" FontSize="20" />
                            </MenuItem.Icon>
                            <MenuItem Header="None (Transparent)" Tag="None" Click="OnCanvasGroupTintColorSelectClick">
                                <MenuItem.Icon><Border Width="12" Height="12" BorderThickness="1" BorderBrush="#80FFFFFF" Background="Transparent" CornerRadius="2"/></MenuItem.Icon>
                            </MenuItem>
                            <MenuItem Header="Fluent Sky Blue" Tag="#60CDFF" Click="OnCanvasGroupTintColorSelectClick">
                                <MenuItem.Icon><Ellipse Width="12" Height="12" Fill="#60CDFF"/></MenuItem.Icon>
                            </MenuItem>
                            <MenuItem Header="Electric Azure" Tag="#0078D7" Click="OnCanvasGroupTintColorSelectClick">
                                <MenuItem.Icon><Ellipse Width="12" Height="12" Fill="#0078D7"/></MenuItem.Icon>
                            </MenuItem>
                            <MenuItem Header="Emerald Green" Tag="#107C10" Click="OnCanvasGroupTintColorSelectClick">
                                <MenuItem.Icon><Ellipse Width="12" Height="12" Fill="#107C10"/></MenuItem.Icon>
                            </MenuItem>
                            <MenuItem Header="Mint Cyan" Tag="#00B7C3" Click="OnCanvasGroupTintColorSelectClick">
                                <MenuItem.Icon><Ellipse Width="12" Height="12" Fill="#00B7C3"/></MenuItem.Icon>
                            </MenuItem>
                            <MenuItem Header="Neon Orange" Tag="#FF8C00" Click="OnCanvasGroupTintColorSelectClick">
                                <MenuItem.Icon><Ellipse Width="12" Height="12" Fill="#FF8C00"/></MenuItem.Icon>
                            </MenuItem>
                            <MenuItem Header="Electric Amber" Tag="#FFD700" Click="OnCanvasGroupTintColorSelectClick">
                                <MenuItem.Icon><Ellipse Width="12" Height="12" Fill="#FFD700"/></MenuItem.Icon>
                            </MenuItem>
                            <MenuItem Header="Crimson Red" Tag="#FF4343" Click="OnCanvasGroupTintColorSelectClick">
                                <MenuItem.Icon><Ellipse Width="12" Height="12" Fill="#FF4343"/></MenuItem.Icon>
                            </MenuItem>
                            <MenuItem Header="Royal Purple" Tag="#881798" Click="OnCanvasGroupTintColorSelectClick">
                                <MenuItem.Icon><Ellipse Width="12" Height="12" Fill="#881798"/></MenuItem.Icon>
                            </MenuItem>
                            <MenuItem Header="Hot Pink" Tag="#E3008C" Click="OnCanvasGroupTintColorSelectClick">
                                <MenuItem.Icon><Ellipse Width="12" Height="12" Fill="#E3008C"/></MenuItem.Icon>
                            </MenuItem>
                        </MenuItem>

                        <MenuItem x:Name="LockGroupCanvasMenuItem"
                                  Header="Lock Group"
                                  Visibility="Collapsed"
                                  Click="OnCanvasLockGroupClick">
                            <MenuItem.Icon>
                                <ui:SymbolIcon x:Name="LockGroupCanvasIcon" Symbol="LockClosed24" FontSize="20" />
                            </MenuItem.Icon>
                        </MenuItem>

                        <MenuItem x:Name="UngroupCanvasMenuItem"
                                  Header="Ungroup Tiles"
                                  Visibility="Collapsed"
                                  Click="OnCanvasUngroupClick">
                            <MenuItem.Icon>
                                <ui:SymbolIcon Symbol="SelectAllOn24" FontSize="20" />
                            </MenuItem.Icon>
                        </MenuItem>

                        <MenuItem x:Name="DeleteGroupCanvasMenuItem"
                                  Header="Delete Group and Tiles"
                                  Foreground="#FF6B6B"
                                  Visibility="Collapsed"
                                  Click="OnCanvasDeleteGroupClick">
                            <MenuItem.Icon>
                                <ui:SymbolIcon Symbol="Delete24" FontSize="20" Foreground="#FF6B6B" />
                            </MenuItem.Icon>
                        </MenuItem>

                        <Separator x:Name="GeneralMenuSeparator" />

                        <MenuItem x:Name="CreateGroupCanvasMenuItem"
                                  Header="Create Group"
                                  Click="OnCreateGroupCanvasClick">
                            <MenuItem.Icon>
                                <ui:SymbolIcon Symbol="FolderAdd24" FontSize="20" />
                            </MenuItem.Icon>
                        </MenuItem>

                        <MenuItem Header="Add Custom Tile..." Click="OnAddTileClick">
                            <MenuItem.Icon>
                                <ui:SymbolIcon Symbol="Add24" FontSize="20" />
                            </MenuItem.Icon>
                        </MenuItem>
                    </ContextMenu>
                </Grid.ContextMenu>
                <!-- Drop Target Slot Indicator (snaps to grid in real-time) -->
                <Canvas x:Name="DropIndicatorCanvas" IsHitTestVisible="False" Panel.ZIndex="2000">
                    <Border x:Name="DropSlotIndicator"
                            Visibility="Collapsed"
                            CornerRadius="2"
                            BorderThickness="1.5"
                            BorderBrush="{DynamicResource SystemAccentColorPrimaryBrush}"
                            Background="#3060CDFF">
                        <Border.Effect>
                            <DropShadowEffect BlurRadius="16" ShadowDepth="4" Opacity="0.6" Color="#60CDFF" />
                        </Border.Effect>
                    </Border>
                </Canvas>

                <!-- Rubber-band (Marquee) Multi-Tile Selection Box -->
                <Canvas x:Name="RubberBandCanvas" IsHitTestVisible="False" Panel.ZIndex="3000">
                    <Rectangle x:Name="RubberBandBox"
                               Visibility="Collapsed"
                               Fill="#2560CDFF"
                               Stroke="{DynamicResource SystemAccentColorPrimaryBrush}"
                               StrokeThickness="1"
                               RadiusX="3"
                               RadiusY="3" />
                </Canvas>

                <!-- Group Drag-to-Add Perimeter Glow & Floating Badge -->
                <Canvas x:Name="GroupDropHighlightCanvas" IsHitTestVisible="False" Panel.ZIndex="2500">
                    <Border x:Name="GroupDropPerimeterBorder"
                            Visibility="Collapsed"
                            CornerRadius="6"
                            BorderThickness="1"
                            BorderBrush="#60CDFF"
                            Background="#1060CDFF"
                            RenderTransformOrigin="0.5,0.5">
                        <Border.RenderTransform>
                            <TranslateTransform x:Name="GroupDropPerimeterTranslate" X="0" Y="0" />
                        </Border.RenderTransform>
                        <Border.Effect>
                            <DropShadowEffect x:Name="GroupDropGlowEffect"
                                              BlurRadius="20"
                                              ShadowDepth="0"
                                              Opacity="0.65"
                                              Color="#60CDFF" />
                        </Border.Effect>
                    </Border>

                    <!-- Thin 1x1 Red Glowing Border for 1x1 Gap Drop Warning Feedback -->
                    <Border x:Name="GapDropWarningBorder"
                            Visibility="Collapsed"
                            Width="56" Height="56"
                            CornerRadius="2"
                            BorderThickness="1.5"
                            BorderBrush="#FF4343"
                            Background="#22FF4343"
                            IsHitTestVisible="False">
                        <Border.Effect>
                            <DropShadowEffect x:Name="GapDropWarningGlow"
                                              BlurRadius="16"
                                              ShadowDepth="0"
                                              Opacity="0.85"
                                              Color="#FF4343" />
                        </Border.Effect>
                    </Border>

                    <!-- WPF-UI Fluent Card Style Floating Badge -->
                    <Border x:Name="GroupDropFloatingBadge"
                            Visibility="Collapsed"
                            CornerRadius="6"
                            Background="#F0202022"
                            BorderThickness="1"
                            BorderBrush="#25FFFFFF"
                            Padding="10,6,12,6">
                        <Border.Effect>
                            <DropShadowEffect BlurRadius="14" ShadowDepth="3" Opacity="0.45" Direction="270" Color="#000000" />
                        </Border.Effect>
                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                            <ui:SymbolIcon x:Name="GroupDropBadgeIcon"
                                           Symbol="Add24"
                                           FontSize="13"
                                           Foreground="{DynamicResource SystemAccentColorPrimaryBrush}"
                                           Margin="0,0,8,0"
                                           VerticalAlignment="Center" />
                            <TextBlock x:Name="GroupDropBadgeText"
                                       Text="Add to Section"
                                       FontSize="12"
                                       FontWeight="SemiBold"
                                       Foreground="#F5FFFFFF"
                                       FontFamily="Segoe UI Variable Text, Segoe UI Variable, Segoe UI, sans-serif"
                                       VerticalAlignment="Center" />
                        </StackPanel>
                    </Border>

                    <!-- Horizontal Group Insertion Drop Line -->
                    <Border x:Name="GroupInsertionLine"
                            Visibility="Collapsed"
                            Height="3"
                            CornerRadius="1.5"
                            Background="{DynamicResource SystemAccentColorPrimaryBrush}">
                        <Border.Effect>
                            <DropShadowEffect BlurRadius="12" ShadowDepth="0" Opacity="0.8" Color="#60CDFF" />
                        </Border.Effect>
                    </Border>
                </Canvas>

                <!-- Groups Header Layer (Pass-through transparent: only header controls intercept hits) -->
                <ItemsControl x:Name="GroupsListBox"
                              ItemsSource="{Binding Groups}"
                              Background="{x:Null}"
                              Focusable="False"
                              Panel.ZIndex="100">
                    <ItemsControl.ItemsPanel>
                        <ItemsPanelTemplate>
                            <Canvas Background="{x:Null}" />
                        </ItemsPanelTemplate>
                    </ItemsControl.ItemsPanel>
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <controls:GroupHeaderControl />
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                    <ItemsControl.ItemContainerStyle>
                        <Style TargetType="ContentPresenter">
                            <Setter Property="Canvas.Left" Value="{Binding X, Mode=TwoWay}" />
                            <Setter Property="Canvas.Top" Value="{Binding Y, Mode=TwoWay}" />
                        </Style>
                    </ItemsControl.ItemContainerStyle>
                </ItemsControl>

                <!-- Group Tint Backplates Layer (Below tiles, non-hit-testable decorative acrylic plates) -->
                <ItemsControl x:Name="GroupTintBackplates"
                              ItemsSource="{Binding Groups}"
                              Background="{x:Null}"
                              Focusable="False"
                              IsHitTestVisible="False"
                              Panel.ZIndex="0">
                    <ItemsControl.ItemsPanel>
                        <ItemsPanelTemplate>
                            <Canvas Background="{x:Null}" />
                        </ItemsPanelTemplate>
                    </ItemsControl.ItemsPanel>
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <Border Width="{Binding PlateWidth}"
                                    Height="{Binding PlateHeight}"
                                    CornerRadius="2"
                                    Background="{Binding TintBackgroundBrush}"
                                    BorderBrush="{Binding TintBorderBrush}"
                                    BorderThickness="1"
                                    IsHitTestVisible="False">
                                <Border.Style>
                                    <Style TargetType="Border">
                                        <Setter Property="Visibility" Value="Visible" />
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding HasTint}" Value="False">
                                                <Setter Property="Visibility" Value="Collapsed" />
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </Border.Style>
                            </Border>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                    <ItemsControl.ItemContainerStyle>
                        <Style TargetType="ContentPresenter">
                            <Setter Property="Canvas.Left" Value="{Binding PlateX}" />
                            <Setter Property="Canvas.Top" Value="{Binding PlateY}" />
                            <Setter Property="IsHitTestVisible" Value="False" />
                        </Style>
                    </ItemsControl.ItemContainerStyle>
                </ItemsControl>

                <!-- ItemsControl with Canvas panel: free-placement grid -->
                <ItemsControl x:Name="TilesListBox"
                              ItemsSource="{Binding Tiles}"
                              Background="Transparent"
                              Focusable="False">

                    <ItemsControl.ItemsPanel>
                        <ItemsPanelTemplate>
                            <Canvas Background="Transparent" />
                        </ItemsPanelTemplate>
                    </ItemsControl.ItemsPanel>

                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <controls:TileControl TileActivated="OnTileActivated"
                                                  TileUnpinned="OnTileUnpinned"
                                                  TileModified="OnTileModified" />
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>

                    <!-- ContentPresenter is the container for ItemsControl items -->
                    <ItemsControl.ItemContainerStyle>
                        <Style TargetType="ContentPresenter">
                            <Setter Property="Canvas.Left" Value="{Binding X, Mode=TwoWay}" />
                            <Setter Property="Canvas.Top" Value="{Binding Y, Mode=TwoWay}" />
                        </Style>
                    </ItemsControl.ItemContainerStyle>
                </ItemsControl>

            </Grid>
        </ScrollViewer>

        <!-- Bottom Status Bar -->
        <Grid x:Name="FooterGrid" Grid.Row="2" Margin="48,0,48,0">
            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                <TextBlock Text="Press " FontSize="11" Foreground="#80FFFFFF" />
                <Border Background="#30FFFFFF" CornerRadius="4" Padding="5,1" Margin="2,0">
                    <TextBlock Text="Esc" FontSize="10" FontWeight="SemiBold" Foreground="#FFFFFF" />
                </Border>
                <TextBlock Text=" or ✕ to close   •   Press " FontSize="11" Foreground="#80FFFFFF" />
                <Border Background="#30FFFFFF" CornerRadius="4" Padding="5,1" Margin="2,0">
                    <TextBlock Text="{Binding HotkeyDisplayString, FallbackValue='Ctrl + `'}" FontSize="10" FontWeight="SemiBold" Foreground="#60CDFF" />
                </Border>
                <TextBlock Text=" to toggle   •   Drag any app from desktop to pin" FontSize="11" Foreground="#80FFFFFF" />
            </StackPanel>

            <TextBlock x:Name="RamHudTextBlock"
                       HorizontalAlignment="Right"
                       VerticalAlignment="Center"
                       Text="App RAM: ~15 MB"
                       FontSize="11"
                       Foreground="#90FFFFFF" />
        </Grid>
    </Grid>
</controls:BorderlessFluentWindow>