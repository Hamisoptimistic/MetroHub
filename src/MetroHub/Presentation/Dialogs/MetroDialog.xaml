<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:controls="clr-namespace:MetroHub.Presentation.Controls"
                    xmlns:dialogs="clr-namespace:MetroHub.Presentation.Dialogs">

    <!-- ========================================================================= -->
    <!-- METRO DIALOG WINDOW BASE STYLE & TEMPLATE                                -->
    <!-- Encapsulates the 155px frosted acrylic sidebar and dark form panel        -->
    <!-- ========================================================================= -->
    <Style TargetType="{x:Type dialogs:MetroDialog}" x:Key="{x:Type dialogs:MetroDialog}">
        <Setter Property="WindowBackdropType" Value="Acrylic" />
        <Setter Property="WindowCornerPreference" Value="DoNotRound" />
        <Setter Property="ExtendsContentIntoTitleBar" Value="True" />
        <Setter Property="WindowStyle" Value="None" />
        <Setter Property="ResizeMode" Value="NoResize" />
        <Setter Property="ShowInTaskbar" Value="False" />
        <Setter Property="Width" Value="620" />
        <Setter Property="Height" Value="360" />
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="Foreground" Value="{DynamicResource TextPrimaryBrush}" />
        <Setter Property="FontFamily" Value="{DynamicResource AppFontFamily}" />
        <Setter Property="RenderOptions.ClearTypeHint" Value="Enabled" />
        <Setter Property="TextOptions.TextFormattingMode" Value="Ideal" />
        <Setter Property="TextOptions.TextRenderingMode" Value="ClearType" />
        <Setter Property="TextOptions.TextHintingMode" Value="Auto" />
        <Setter Property="SnapsToDevicePixels" Value="True" />
        <Setter Property="UseLayoutRounding" Value="True" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="{x:Type dialogs:MetroDialog}">
                    <Border Background="Transparent"
                            BorderBrush="{DynamicResource SurfaceBorderBrush}"
                            BorderThickness="1"
                            CornerRadius="{DynamicResource DialogCornerRadius}"
                            SnapsToDevicePixels="True">
                        <Grid RenderOptions.ClearTypeHint="Enabled"
                              controls:ClipHelper.IsCornerClipped="True"
                              controls:ClipHelper.CornerRadius="{DynamicResource DialogCornerRadius}"
                              controls:ClipHelper.BorderThickness="1">
                            <Grid.ColumnDefinitions>
                                <!-- COLUMN 0: FROSTED ACRYLIC SIDEBAR -->
                                <ColumnDefinition Width="155" />
                                <!-- COLUMN 1: OBSIDIAN DARK CONTENT PANEL -->
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>

                            <!-- COLUMN 0: ACRYLIC SIDEBAR -->
                            <Grid Grid.Column="0" Background="Transparent">
                                <Image Source="{TemplateBinding SidebarIcon}"
                                       Width="72" Height="72"
                                       Stretch="Uniform"
                                       HorizontalAlignment="Center"
                                       VerticalAlignment="Center"
                                       RenderOptions.BitmapScalingMode="HighQuality"
                                       Visibility="{TemplateBinding SidebarIconVisibility}" />
                                <ContentPresenter Content="{TemplateBinding SidebarContent}"
                                                  HorizontalAlignment="Center"
                                                  VerticalAlignment="Center" />
                            </Grid>

                            <!-- COLUMN 1: OBSIDIAN DARK CONTENT PANEL -->
                            <Border Grid.Column="1"
                                    Background="{DynamicResource DialogPanelBackground}"
                                    CornerRadius="{DynamicResource DialogCornerRadius}"
                                    RenderOptions.ClearTypeHint="Enabled">
                                <Grid Margin="24,20,24,20">
                                    <Grid.RowDefinitions>
                                        <!-- Row 0: Header (Title) -->
                                        <RowDefinition Height="Auto" />
                                        <!-- Row 1: Dialog Content Body -->
                                        <RowDefinition Height="*" />
                                    </Grid.RowDefinitions>

                                    <!-- Header (36px right clearance for Close [X] button) -->
                                    <Grid Grid.Row="0" Margin="0,0,36,16">
                                        <StackPanel VerticalAlignment="Center">
                                            <TextBlock Text="{TemplateBinding Title}"
                                                       FontSize="{DynamicResource TypeHeaderFontSize}"
                                                       FontWeight="{DynamicResource TypeHeaderFontWeight}"
                                                       Foreground="{DynamicResource TextPrimaryBrush}"
                                                       TextTrimming="CharacterEllipsis" />
                                            <TextBlock Text="{TemplateBinding Subtitle}"
                                                       FontSize="{DynamicResource TypeCaptionFontSize}"
                                                       FontWeight="{DynamicResource TypeCaptionFontWeight}"
                                                       Foreground="{DynamicResource TextSecondaryBrush}"
                                                       Margin="0,3,0,0"
                                                       TextTrimming="CharacterEllipsis"
                                                       Visibility="{TemplateBinding SubtitleVisibility}" />
                                        </StackPanel>
                                    </Grid>

                                    <!-- Body Content Slot -->
                                    <ContentPresenter Grid.Row="1" />
                                </Grid>
                            </Border>

                            <!-- Universal Modal Close [X] Button (Top-Right Chrome Overlay) -->
                            <Button x:Name="PART_CloseButton"
                                    Grid.Column="1"
                                    Style="{DynamicResource ModalDismissButtonStyle}"
                                    HorizontalAlignment="Right"
                                    VerticalAlignment="Top"
                                    Margin="{DynamicResource ModalDismissButtonMargin}"
                                    Panel.ZIndex="100"
                                    ToolTip="Close (Esc)" />
                        </Grid>
                    </Border>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

</ResourceDictionary>
