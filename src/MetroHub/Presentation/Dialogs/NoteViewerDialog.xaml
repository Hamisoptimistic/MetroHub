<dialogs:MetroDialog x:Class="MetroHub.Presentation.Dialogs.NoteViewerDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:po="http://schemas.microsoft.com/winfx/2006/xaml/presentation/options"
        xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
        xmlns:dialogs="clr-namespace:MetroHub.Presentation.Dialogs"
        Title="Note Viewer"
        Width="540"
        MinWidth="540"
        MaxWidth="540"
        MinHeight="380"
        MaxHeight="640"
        SizeToContent="Height"
        WindowStartupLocation="CenterOwner"
        WindowBackdropType="Acrylic"
        WindowCornerPreference="DoNotRound"
        WindowStyle="None"
        ResizeMode="NoResize"
        ShowInTaskbar="False"
        Background="Transparent"
        ExtendsContentIntoTitleBar="True"
        Foreground="{DynamicResource TextPrimaryBrush}"
        FontFamily="{DynamicResource AppFontFamily}"
        FontSize="{DynamicResource TypeBodyFontSize}"
        TextOptions.TextFormattingMode="Ideal"
        TextOptions.TextRenderingMode="ClearType"
        TextOptions.TextHintingMode="Auto"
        SnapsToDevicePixels="True"
        UseLayoutRounding="True"
        KeyboardNavigation.TabNavigation="Cycle">

    <dialogs:MetroDialog.Template>
        <ControlTemplate TargetType="{x:Type dialogs:MetroDialog}">
            <ContentPresenter />
        </ControlTemplate>
    </dialogs:MetroDialog.Template>

    <Window.Resources>
        <!-- Tier 2: Calibrated Obsidian Deck Tint matching Settings Window -->
        <SolidColorBrush x:Key="SettingsTier2ObsidianBrush" Color="#280D0D11" po:Freeze="True" />

        <!-- Clean dialog action button without aggressive orange accent focus border -->
        <Style x:Key="NoteViewerActionButtonStyle" TargetType="Button">
            <Setter Property="Height" Value="32" />
            <Setter Property="MinWidth" Value="85" />
            <Setter Property="Padding" Value="14,0" />
            <Setter Property="Background" Value="#1CFFFFFF" />
            <Setter Property="BorderBrush" Value="#20FFFFFF" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="Foreground" Value="#F5FFFFFF" />
            <Setter Property="FontFamily" Value="{DynamicResource AppFontFamily}" />
            <Setter Property="FontSize" Value="{DynamicResource TypeBodyStrongFontSize}" />
            <Setter Property="FontWeight" Value="{DynamicResource TypeBodyStrongFontWeight}" />
            <Setter Property="FocusVisualStyle" Value="{x:Null}" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="HorizontalContentAlignment" Value="Center" />
            <Setter Property="VerticalContentAlignment" Value="Center" />
            <Setter Property="SnapsToDevicePixels" Value="True" />
            <Setter Property="UseLayoutRounding" Value="True" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="ButtonBorder"
                                Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="{DynamicResource ControlCornerRadius}">
                            <ContentPresenter HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}"
                                              VerticalAlignment="{TemplateBinding VerticalContentAlignment}"
                                              Margin="{TemplateBinding Padding}" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="ButtonBorder" Property="Background" Value="#28FFFFFF" />
                                <Setter TargetName="ButtonBorder" Property="BorderBrush" Value="#38FFFFFF" />
                                <Setter Property="Foreground" Value="{DynamicResource TextPrimaryBrush}" />
                            </Trigger>
                            <Trigger Property="IsKeyboardFocused" Value="True">
                                <Setter TargetName="ButtonBorder" Property="Background" Value="#25FFFFFF" />
                                <Setter TargetName="ButtonBorder" Property="BorderBrush" Value="#38FFFFFF" />
                                <Setter Property="Foreground" Value="{DynamicResource TextPrimaryBrush}" />
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="ButtonBorder" Property="Background" Value="{DynamicResource FluentPressedBrush}" />
                                <Setter TargetName="ButtonBorder" Property="BorderBrush" Value="#25FFFFFF" />
                                <Setter Property="Foreground" Value="{DynamicResource TextPrimaryBrush}" />
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter TargetName="ButtonBorder" Property="Opacity" Value="0.35" />
                                <Setter Property="Cursor" Value="Arrow" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Clean HyperlinkButton style with white tokens, matching 32px height, and elegant fluent hover -->
        <Style x:Key="NoteViewerHyperlinkButtonStyle" TargetType="{x:Type ui:HyperlinkButton}">
            <Setter Property="Height" Value="32" />
            <Setter Property="Padding" Value="10,0" />
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="BorderBrush" Value="Transparent" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="Foreground" Value="{DynamicResource TextPrimaryBrush}" />
            <Setter Property="FontFamily" Value="{DynamicResource AppFontFamily}" />
            <Setter Property="FontSize" Value="{DynamicResource TypeBodyStrongFontSize}" />
            <Setter Property="FontWeight" Value="{DynamicResource TypeBodyStrongFontWeight}" />
            <Setter Property="FocusVisualStyle" Value="{x:Null}" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="HorizontalContentAlignment" Value="Center" />
            <Setter Property="VerticalContentAlignment" Value="Center" />
            <Setter Property="SnapsToDevicePixels" Value="True" />
            <Setter Property="UseLayoutRounding" Value="True" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="{x:Type ui:HyperlinkButton}">
                        <Border x:Name="ButtonBorder"
                                Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="{DynamicResource ControlCornerRadius}">
                            <ContentPresenter HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}"
                                              VerticalAlignment="{TemplateBinding VerticalContentAlignment}"
                                              Margin="{TemplateBinding Padding}" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="ButtonBorder" Property="Background" Value="#18FFFFFF" />
                                <Setter TargetName="ButtonBorder" Property="BorderBrush" Value="#25FFFFFF" />
                                <Setter Property="Foreground" Value="{DynamicResource TextPrimaryBrush}" />
                            </Trigger>
                            <Trigger Property="IsKeyboardFocused" Value="True">
                                <Setter TargetName="ButtonBorder" Property="Background" Value="#15FFFFFF" />
                                <Setter TargetName="ButtonBorder" Property="BorderBrush" Value="#38FFFFFF" />
                                <Setter Property="Foreground" Value="{DynamicResource TextPrimaryBrush}" />
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="ButtonBorder" Property="Background" Value="{DynamicResource FluentPressedBrush}" />
                                <Setter TargetName="ButtonBorder" Property="BorderBrush" Value="#20FFFFFF" />
                                <Setter Property="Foreground" Value="{DynamicResource TextPrimaryBrush}" />
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter TargetName="ButtonBorder" Property="Opacity" Value="0.35" />
                                <Setter Property="Cursor" Value="Arrow" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>

    <!-- Master Fluent Acrylic Card Shell with sharp Metro 2px border -->
    <Border Background="{StaticResource SettingsTier2ObsidianBrush}"
            BorderBrush="{DynamicResource SurfaceBorderBrush}"
            BorderThickness="1"
            CornerRadius="2"
            SnapsToDevicePixels="True">
        <Grid Background="Transparent">
            <Grid.RowDefinitions>
                <!-- Row 0: Header & Drag Strip -->
                <RowDefinition Height="Auto" />
                <!-- Row 1: Note Body (Universal Scrollable Text) -->
                <RowDefinition Height="*" />
                <!-- Row 2: Hairline Divider (1px) -->
                <RowDefinition Height="Auto" />
                <!-- Row 3: Bottom Action Toolbar -->
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>

            <!-- ========================================================================= -->
            <!-- ROW 0: CLEAN HEADER & DRAG STRIP                                          -->
            <!-- ========================================================================= -->
            <Grid Grid.Row="0"
                  Background="Transparent"
                  MouseLeftButtonDown="OnTitleBarMouseDown"
                  Margin="20,14,14,4">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <!-- Note Title -->
                <TextBlock x:Name="TitleTextBlock"
                           Grid.Column="0"
                           Text="Note"
                           FontSize="{DynamicResource TypeHeaderFontSize}"
                           FontWeight="{DynamicResource TypeHeaderFontWeight}"
                           Foreground="{DynamicResource TextPrimaryBrush}"
                           VerticalAlignment="Center"
                           TextTrimming="CharacterEllipsis"
                           Margin="0,0,8,0" />

                <!-- Top-Right Close Button -->
                <Button x:Name="PART_CloseButton"
                        Grid.Column="1"
                        Style="{DynamicResource ModalDismissButtonStyle}"
                        VerticalAlignment="Center"
                        Click="OnCloseClick"
                        TabIndex="4"
                        ToolTip="Close (Esc)" />
            </Grid>

            <!-- ========================================================================= -->
            <!-- ROW 1: TEXT CONTENT WITH UNIVERSAL FLOATING SCROLLBAR                     -->
            <!-- ========================================================================= -->
            <ScrollViewer x:Name="ContentScrollViewer"
                          Grid.Row="1"
                          Style="{DynamicResource FloatingScrollViewerStyle}"
                          HorizontalScrollBarVisibility="Disabled"
                          VerticalScrollBarVisibility="Auto"
                          MinHeight="250"
                          MaxHeight="480"
                          Margin="20,8,20,16"
                          Focusable="True"
                          IsTabStop="True"
                          TabIndex="0"
                          FocusVisualStyle="{x:Null}">
                <!-- Direct TextBlock with calibrated line-height and scrollbar clearance -->
                <TextBlock x:Name="NoteContentBox"
                           TextWrapping="Wrap"
                           Foreground="{DynamicResource TextPrimaryBrush}"
                           FontFamily="{DynamicResource AppFontFamily}"
                           FontSize="{DynamicResource TypeBodyFontSize}"
                           LineHeight="22"
                           LineStackingStrategy="BlockLineHeight"
                           Padding="0,0,14,0"
                           VerticalAlignment="Top"
                           HorizontalAlignment="Stretch"
                           TextOptions.TextFormattingMode="Ideal"
                           TextOptions.TextRenderingMode="ClearType" />
            </ScrollViewer>

            <!-- ========================================================================= -->
            <!-- ROW 2: HAIRLINE HORIZONTAL DIVIDER                                        -->
            <!-- ========================================================================= -->
            <Border Grid.Row="2"
                    Height="1"
                    Background="{DynamicResource WidgetDividerBrush}"
                    HorizontalAlignment="Stretch" />

            <!-- ========================================================================= -->
            <!-- ROW 3: BOTTOM TOOLBAR                                                     -->
            <!-- ========================================================================= -->
            <Grid Grid.Row="3"
                  Height="48"
                  Margin="18,0,18,0">
                <Grid.ColumnDefinitions>
                    <!-- Column 0: Reading Metadata (Words · Chars) -->
                    <ColumnDefinition Width="Auto" />
                    <!-- Column 1: Spacer (*) -->
                    <ColumnDefinition Width="*" />
                    <!-- Column 2: Action Buttons (Right) -->
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <!-- Left Slot: Subtle Reading Metadata (Token-based, >= 12px) -->
                <TextBlock x:Name="ReadingMetadataText"
                           Grid.Column="0"
                           Text="0 words · 0 char"
                           FontSize="{DynamicResource TypeCaptionFontSize}"
                           Foreground="{DynamicResource TextMutedBrush}"
                           FontFamily="{DynamicResource AppFontFamily}"
                           VerticalAlignment="Center"
                           HorizontalAlignment="Left" />

                <!-- Right Slot: Action Buttons (Order: Website -> Open With -> Copy) -->
                <StackPanel Grid.Column="2"
                            Orientation="Horizontal"
                            VerticalAlignment="Center">
                    <!-- Website HyperlinkButton (visible when Web URL is present, placed to the left of Open With) -->
                    <ui:HyperlinkButton x:Name="SourceWebButton"
                                        Height="32"
                                        Padding="10,0"
                                        Margin="0,0,8,0"
                                        VerticalAlignment="Center"
                                        Style="{StaticResource NoteViewerHyperlinkButtonStyle}"
                                        Visibility="Collapsed"
                                        TabIndex="1"
                                        Click="OnSourceWebButtonClick">
                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                            <!-- Default Fluent Link Icon -->
                            <ui:SymbolIcon Symbol="Link24"
                                           FontSize="15"
                                           Margin="0,0,6,0"
                                           VerticalAlignment="Center"
                                           Foreground="{DynamicResource TextPrimaryBrush}" />

                            <!-- Website Name (14px SemiBold matching Open With and Copy) -->
                            <TextBlock x:Name="SourceWebButtonText"
                                       Text="Website"
                                       FontSize="{DynamicResource TypeBodyStrongFontSize}"
                                       FontWeight="{DynamicResource TypeBodyStrongFontWeight}"
                                       Foreground="{DynamicResource TextPrimaryBrush}"
                                       VerticalAlignment="Center"
                                       MaxWidth="180"
                                       TextTrimming="CharacterEllipsis" />
                        </StackPanel>
                    </ui:HyperlinkButton>

                    <!-- Open With Button (no glyph, clean text only, placed in the middle) -->
                    <Button x:Name="OpenWithButton"
                            Height="32"
                            Padding="14,0"
                            Margin="0,0,8,0"
                            Style="{StaticResource NoteViewerActionButtonStyle}"
                            Click="OnOpenWithClick"
                            TabIndex="2"
                            ToolTip="Open in external editor">
                        <TextBlock Text="Open With" VerticalAlignment="Center" />
                    </Button>

                    <!-- Copy Button (first from right, neutral border without orange system accent) -->
                    <Button x:Name="CopyButton"
                            Height="32"
                            Padding="14,0"
                            Style="{StaticResource NoteViewerActionButtonStyle}"
                            TabIndex="3"
                            Click="OnCopyClick">
                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                            <ui:SymbolIcon x:Name="CopyButtonIcon"
                                           Symbol="Copy24"
                                           FontSize="14"
                                           Margin="0,0,6,0"
                                           VerticalAlignment="Center" />
                            <TextBlock x:Name="CopyButtonText" Text="Copy" VerticalAlignment="Center" />
                        </StackPanel>
                    </Button>
                </StackPanel>
            </Grid>
        </Grid>
    </Border>
</dialogs:MetroDialog>
