<dialogs:MetroDialog x:Class="MetroHub.Presentation.Dialogs.NoteViewerDialog"
                     xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                     xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                     xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
                     xmlns:dialogs="clr-namespace:MetroHub.Presentation.Dialogs"
                     Title="Note Viewer"
                     Width="540"
                     Height="420">

    <!-- Frosted Acrylic Left Sidebar Content Slot -->
    <dialogs:MetroDialog.SidebarContent>
        <Grid HorizontalAlignment="Center" VerticalAlignment="Center">
            <Ellipse Width="70" Height="70" Fill="#182563EB">
                <Ellipse.Effect>
                    <BlurEffect Radius="16" />
                </Ellipse.Effect>
            </Ellipse>
            <ui:SymbolIcon Symbol="Note24"
                           FontSize="44"
                           Foreground="{DynamicResource TextSecondaryBrush}"
                           HorizontalAlignment="Center"
                           VerticalAlignment="Center" />
        </Grid>
    </dialogs:MetroDialog.SidebarContent>

    <!-- Dark Obsidian Form Content Slot -->
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <!-- Source link metadata if available -->
        <Border x:Name="SourceLinkPanel"
                Grid.Row="0"
                Margin="0,0,0,10"
                Padding="8,6"
                Background="#10FFFFFF"
                CornerRadius="4"
                Visibility="Collapsed">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <TextBlock x:Name="SourceUrlText"
                           Grid.Column="0"
                           VerticalAlignment="Center"
                           FontSize="{DynamicResource TypeCaptionFontSize}"
                           Foreground="{DynamicResource TextMutedBrush}"
                           TextTrimming="CharacterEllipsis"
                           Text="Source: https://example.com" />
                <Button Grid.Column="1"
                        Content="Open Webpage"
                        Padding="8,3"
                        FontSize="{DynamicResource TypeCaptionFontSize}"
                        Style="{DynamicResource DefaultButtonStyle}"
                        Margin="8,0,0,0"
                        Click="OnOpenWebpageClick" />
            </Grid>
        </Border>

        <!-- Note Text Body -->
        <TextBox x:Name="NoteContentBox"
                 Grid.Row="1"
                 TextWrapping="Wrap"
                 AcceptsReturn="True"
                 VerticalScrollBarVisibility="Auto"
                 FontFamily="{DynamicResource AppFontFamily}"
                 FontSize="13"
                 Padding="10"
                 Background="#12FFFFFF"
                 Foreground="{DynamicResource TextPrimaryBrush}"
                 BorderBrush="#25FFFFFF" />

        <!-- Footer Action Buttons -->
        <Grid Grid.Row="2" Margin="0,14,0,0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>

            <!-- Copy to Clipboard Button -->
            <Button x:Name="CopyButton"
                    Grid.Column="0"
                    Padding="12,6"
                    Style="{DynamicResource DefaultButtonStyle}"
                    Click="OnCopyClick">
                <StackPanel Orientation="Horizontal">
                    <ui:SymbolIcon Symbol="Copy24" FontSize="14" Margin="0,0,6,0" VerticalAlignment="Center" />
                    <TextBlock x:Name="CopyButtonText" Text="Copy Text" VerticalAlignment="Center" />
                </StackPanel>
            </Button>

            <!-- Save & Close Buttons -->
            <StackPanel Grid.Column="2" Orientation="Horizontal">
                <Button Content="Save"
                        Padding="16,6"
                        Margin="0,0,8,0"
                        Style="{DynamicResource AccentButtonStyle}"
                        Click="OnSaveClick" />
                <Button Content="Close"
                        Padding="16,6"
                        Style="{DynamicResource DefaultButtonStyle}"
                        Click="OnCloseClick" />
            </StackPanel>
        </Grid>
    </Grid>
</dialogs:MetroDialog>
