<dialogs:MetroDialog x:Class="MetroHub.Presentation.Dialogs.WorkspaceDeleteDialog"
                     xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                     xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                     xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
                     xmlns:controls="clr-namespace:MetroHub.Presentation.Controls"
                     xmlns:dialogs="clr-namespace:MetroHub.Presentation.Dialogs"
                     Title="Delete Workspace"
                     Subtitle="Confirm workspace removal"
                     Width="520" Height="270">

    <!-- Frosted Acrylic Left Sidebar Content Slot -->
    <dialogs:MetroDialog.SidebarContent>
        <Grid HorizontalAlignment="Center" VerticalAlignment="Center">
            <ui:SymbolIcon Symbol="Delete24"
                           FontSize="48"
                           Foreground="{DynamicResource StatusErrorBrush}" />
        </Grid>
    </dialogs:MetroDialog.SidebarContent>

    <!-- Dark Obsidian Form Content Slot -->
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <StackPanel Grid.Row="0" VerticalAlignment="Center">
            <TextBlock Text="Are you sure you want to delete this workspace?"
                       FontSize="{DynamicResource TypeBodyFontSize}"
                       FontWeight="{DynamicResource TypeHeaderFontWeight}"
                       Foreground="{DynamicResource TextPrimaryBrush}"
                       Margin="0,0,0,8" />

            <TextBlock x:Name="WorkspaceWarningText"
                       Text="All tiles in this workspace will be archived to the workspace trash folder. The active canvas will switch to an available workspace."
                       FontSize="{DynamicResource TypeCaptionFontSize}"
                       Foreground="{DynamicResource TextSecondaryBrush}"
                       TextWrapping="Wrap"
                       LineHeight="18" />
        </StackPanel>

        <!-- Footer Action Buttons -->
        <Grid Grid.Row="1" Margin="0,16,0,0">
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                <Button Content="Cancel"
                        Style="{DynamicResource DefaultButtonStyle}"
                        Margin="0,0,10,0"
                        Click="OnCancelClick" />
                <Button x:Name="DeleteButton"
                        Content="Delete Workspace"
                        Background="{DynamicResource StatusErrorBrush}"
                        Foreground="#FFFFFF"
                        BorderThickness="0"
                        Padding="16,6"
                        Click="OnDeleteClick" />
            </StackPanel>
        </Grid>
    </Grid>
</dialogs:MetroDialog>
