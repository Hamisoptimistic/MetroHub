<dialogs:MetroDialog x:Class="MetroHub.Presentation.Dialogs.WorkspaceEditDialog"
                     xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                     xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                     xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
                     xmlns:controls="clr-namespace:MetroHub.Presentation.Controls"
                     xmlns:dialogs="clr-namespace:MetroHub.Presentation.Dialogs"
                     Title="Edit Workspace"
                     Subtitle="Customize workspace name and icon">

    <!-- Frosted Acrylic Left Sidebar: Live Dynamic Preview -->
    <dialogs:MetroDialog.SidebarContent>
        <Grid HorizontalAlignment="Center" VerticalAlignment="Center">
            <Border Width="88" Height="88"
                    CornerRadius="44"
                    Background="{DynamicResource SurfaceGlassBrush}"
                    BorderBrush="{DynamicResource SurfaceBorderBrush}"
                    BorderThickness="1">
                <ui:SymbolIcon x:Name="SidebarPreviewIcon"
                               Symbol="Desktop24"
                               FontSize="42"
                               Foreground="{DynamicResource TextPrimaryBrush}"
                               HorizontalAlignment="Center"
                               VerticalAlignment="Center" />
            </Border>
        </Grid>
    </dialogs:MetroDialog.SidebarContent>

    <!-- Obsidian Dark Content Panel Body -->
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <!-- Form Fields -->
        <StackPanel Grid.Row="0" VerticalAlignment="Center">
            <!-- Workspace Name Label -->
            <TextBlock Text="Workspace Name"
                       FontSize="{DynamicResource TypeCaptionFontSize}"
                       FontWeight="{DynamicResource TypeCaptionFontWeight}"
                       Foreground="{DynamicResource TextMutedBrush}"
                       Margin="0,0,0,6" />

            <TextBox x:Name="WorkspaceNameInput"
                     controls:InputHelper.Icon="Edit24"
                     TextChanged="OnWorkspaceNameInputTextChanged"
                     KeyDown="OnWorkspaceNameInputKeyDown" />

            <TextBlock x:Name="WorkspaceNameErrorMessage"
                       Text="Workspace name cannot be empty."
                       FontSize="{DynamicResource TypeCaptionFontSize}"
                       Foreground="{DynamicResource StatusErrorBrush}"
                       Margin="0,4,0,8"
                       Visibility="Collapsed" />

            <!-- Icon Palette Section -->
            <TextBlock Text="Choose Icon"
                       FontSize="{DynamicResource TypeCaptionFontSize}"
                       FontWeight="{DynamicResource TypeCaptionFontWeight}"
                       Foreground="{DynamicResource TextMutedBrush}"
                       Margin="0,6,0,6" />

            <!-- Universal Dual-Support Glyph Picker -->
            <controls:GlyphPickerControl x:Name="WorkspaceGlyphPicker"
                                         SelectedGlyphChanged="OnGlyphPickerSelectedGlyphChanged" />
        </StackPanel>

        <!-- Footer Buttons -->
        <Grid Grid.Row="1" Margin="0,16,0,0">
            <Button x:Name="SaveButton"
                    Content="Save"
                    Style="{DynamicResource AccentButtonStyle}"
                    HorizontalAlignment="Right"
                    IsDefault="True"
                    Click="OnSaveClick" />
        </Grid>
    </Grid>
</dialogs:MetroDialog>
