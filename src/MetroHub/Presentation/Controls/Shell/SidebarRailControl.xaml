<UserControl x:Class="MetroHub.Presentation.Controls.SidebarRailControl"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
             xmlns:controls="clr-namespace:MetroHub.Presentation.Controls"
             xmlns:models="clr-namespace:MetroHub.Core.Models"
             xmlns:controllers="clr-namespace:MetroHub.Presentation.Controllers"
             mc:Ignorable="d" 
             Width="48"
             Focusable="False"
             FontFamily="{DynamicResource AppFontFamily}">

    <UserControl.Resources>
        <!-- Modern Windows 11 Fluent Rail Button Style with Widget-Style Borderless Sheen -->
        <Style x:Key="RailButtonStyle" TargetType="Button">
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="Width" Value="48" />
            <Setter Property="Height" Value="42" />
            <Setter Property="Margin" Value="0,1" />
            <Setter Property="Padding" Value="0" />
            <Setter Property="FocusVisualStyle" Value="{x:Null}" />
            <Setter Property="Foreground" Value="{DynamicResource TextMutedBrush}" />
            <Setter Property="ToolTipService.Placement" Value="Right" />
            <Setter Property="ToolTipService.HorizontalOffset" Value="8" />
            <Setter Property="ToolTipService.InitialShowDelay" Value="350" />
            <Setter Property="ToolTipService.BetweenShowDelay" Value="100" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Grid Background="Transparent">
                            <!-- Hover / Active Background Pill with Soft Rounded Sheen, Zero Box Borders -->
                            <Border x:Name="PillBorder"
                                    Margin="4,2"
                                    CornerRadius="{DynamicResource ControlCornerRadius}"
                                    Background="Transparent"
                                    BorderThickness="0"
                                    >
                                <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                            </Border>

                            <!-- Active Left Indicator Pip (Bound to System Accent Color) -->
                            <Border x:Name="ActiveIndicator"
                                    Width="3"
                                    Height="16"
                                    CornerRadius="1.5"
                                    HorizontalAlignment="Left"
                                    VerticalAlignment="Center"
                                    Margin="1,0,0,0"
                                    Background="{DynamicResource SystemAccentColorPrimaryBrush}"
                                    Visibility="Collapsed" />
                        </Grid>
                        <ControlTemplate.Triggers>
                            <!-- Hover state: soft brighten, subtle glass sheen, zero borders (matching widgets) -->
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="PillBorder" Property="Background" Value="{DynamicResource FluentHoverBrush}" />
                                <Setter Property="Foreground" Value="{DynamicResource TextPrimaryBrush}" />
                            </Trigger>
                            <!-- Pressed state -->
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="PillBorder" Property="Background" Value="{DynamicResource FluentPressedBrush}" />
                                <Setter Property="Foreground" Value="{DynamicResource TextPrimaryBrush}" />
                            </Trigger>
                            <!-- Active state (Pinned / Drawer Open) -->
                            <Trigger Property="Tag" Value="Active">
                                <Setter TargetName="ActiveIndicator" Property="Visibility" Value="Visible" />
                                <Setter TargetName="PillBorder" Property="Background" Value="{DynamicResource SurfaceGlassSubtleBrush}" />
                                <Setter Property="Foreground" Value="{DynamicResource TextPrimaryBrush}" />
                            </Trigger>
                            <!-- Active + Hover -->
                            <MultiTrigger>
                                <MultiTrigger.Conditions>
                                    <Condition Property="Tag" Value="Active" />
                                    <Condition Property="IsMouseOver" Value="True" />
                                </MultiTrigger.Conditions>
                                <Setter TargetName="PillBorder" Property="Background" Value="{DynamicResource SurfaceGlassBrush}" />
                                <Setter Property="Foreground" Value="{DynamicResource TextPrimaryBrush}" />
                            </MultiTrigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Modern Fluent Workspace Rail Item Style with Smooth Hover Pill -->
        <Style x:Key="WorkspaceRailItemStyle" TargetType="Button">
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="Width" Value="40" />
            <Setter Property="Height" Value="34" />
            <Setter Property="Margin" Value="0,1" />
            <Setter Property="Padding" Value="0" />
            <Setter Property="FocusVisualStyle" Value="{x:Null}" />
            <Setter Property="ToolTipService.Placement" Value="Right" />
            <Setter Property="ToolTipService.HorizontalOffset" Value="8" />
            <Setter Property="ToolTipService.InitialShowDelay" Value="350" />
            <Setter Property="ToolTipService.BetweenShowDelay" Value="100" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Grid Background="Transparent">
                            <Border x:Name="HoverPill"
                                    Margin="2,1"
                                    CornerRadius="6"
                                    Background="Transparent"
                                    BorderThickness="0">
                                <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                            </Border>
                        </Grid>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="HoverPill" Property="Background" Value="{DynamicResource FluentHoverBrush}" />
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="HoverPill" Property="Background" Value="{DynamicResource FluentPressedBrush}" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Modern Fluent Add Shortcut Context Menu -->
        <ContextMenu x:Key="AddShortcutContextMenu">
            <!-- System Folders Submenu -->
            <MenuItem Header="System Folders">
                <MenuItem.Icon>
                    <ui:SymbolIcon Symbol="Folder24" FontSize="16" />
                </MenuItem.Icon>
                <MenuItem Header="Documents" Tag="Documents|Documents|Document24" Click="OnAddSystemFolderClick">
                    <MenuItem.Icon>
                        <ui:SymbolIcon Symbol="Document24" FontSize="16" />
                    </MenuItem.Icon>
                </MenuItem>
                <MenuItem Header="Downloads" Tag="Downloads|Downloads|ArrowDownload24" Click="OnAddSystemFolderClick">
                    <MenuItem.Icon>
                        <ui:SymbolIcon Symbol="ArrowDownload24" FontSize="16" />
                    </MenuItem.Icon>
                </MenuItem>
                <MenuItem Header="Pictures" Tag="Pictures|Pictures|Image24" Click="OnAddSystemFolderClick">
                    <MenuItem.Icon>
                        <ui:SymbolIcon Symbol="Image24" FontSize="16" />
                    </MenuItem.Icon>
                </MenuItem>
                <MenuItem Header="Music" Tag="Music|Music|MusicNote224" Click="OnAddSystemFolderClick">
                    <MenuItem.Icon>
                        <ui:SymbolIcon Symbol="MusicNote224" FontSize="16" />
                    </MenuItem.Icon>
                </MenuItem>
                <MenuItem Header="Videos" Tag="Videos|Videos|Video24" Click="OnAddSystemFolderClick">
                    <MenuItem.Icon>
                        <ui:SymbolIcon Symbol="Video24" FontSize="16" />
                    </MenuItem.Icon>
                </MenuItem>
                <Separator />
                <MenuItem Header="Windows Settings" Tag="Settings|Settings|Settings24" Click="OnAddSystemFolderClick">
                    <MenuItem.Icon>
                        <ui:SymbolIcon Symbol="Settings24" FontSize="16" />
                    </MenuItem.Icon>
                </MenuItem>
                <MenuItem Header="Windows Security" Tag="Security|Windows Security|Shield24" Click="OnAddSystemFolderClick">
                    <MenuItem.Icon>
                        <ui:SymbolIcon Symbol="Shield24" FontSize="16" />
                    </MenuItem.Icon>
                </MenuItem>
                <MenuItem Header="Control Panel" Tag="ControlPanel|Control Panel|Options24" Click="OnAddSystemFolderClick">
                    <MenuItem.Icon>
                        <ui:SymbolIcon Symbol="Options24" FontSize="16" />
                    </MenuItem.Icon>
                </MenuItem>
            </MenuItem>

            <Separator />

            <!-- Browse Local Folder -->
            <MenuItem Header="Browse Local Folder..." Click="OnBrowseLocalFolderClick">
                <MenuItem.Icon>
                    <ui:SymbolIcon Symbol="FolderOpen24" FontSize="16" />
                </MenuItem.Icon>
            </MenuItem>

            <!-- Browse Application -->
            <MenuItem Header="Browse Application (.exe)..." Click="OnBrowseAppClick">
                <MenuItem.Icon>
                    <ui:SymbolIcon Symbol="AppGeneric24" FontSize="16" />
                </MenuItem.Icon>
            </MenuItem>

            <!-- Add Web Link -->
            <MenuItem Header="Add Web Link..." Click="OnAddWebLinkClick">
                <MenuItem.Icon>
                    <ui:SymbolIcon Symbol="Globe24" FontSize="16" />
                </MenuItem.Icon>
            </MenuItem>

            <Separator />

            <!-- Add Divider Line -->
            <MenuItem Header="Add Divider Line" Click="OnAddSeparatorClick">
                <MenuItem.Icon>
                    <ui:SymbolIcon Symbol="ReOrder24" FontSize="16" />
                </MenuItem.Icon>
            </MenuItem>
        </ContextMenu>
    </UserControl.Resources>

    <Grid Background="Transparent">
        <Grid.RowDefinitions>
            <!-- Top Section: Pin + All Apps Toggle -->
            <RowDefinition Height="Auto" />
            <!-- Center Section: User Custom Shortcuts List -->
            <RowDefinition Height="*" />
            <!-- Bottom Section: Add + Power -->
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <!-- 1. Top Section: Pin & All Apps -->
        <StackPanel Grid.Row="0" Margin="0,10,0,0">
            <!-- Pin / Unpin Toggle -->
            <Button x:Name="PinButton"
                    Style="{StaticResource RailButtonStyle}"
                    ToolTip="Pin sidebar open"
                    Click="OnPinToggleClick">
                <ui:SymbolIcon x:Name="PinIcon" Symbol="Pin24" FontSize="18"
                               Foreground="{Binding RelativeSource={RelativeSource AncestorType=Button}, Path=Foreground}" />
            </Button>

            <!-- All Apps Drawer Toggle Button -->
            <Button x:Name="AppsToggleButton"
                    Style="{StaticResource RailButtonStyle}"
                    ToolTip="All apps"
                    Click="OnAppsToggleClick">
                <ui:SymbolIcon Symbol="AppsListDetail24" FontSize="22"
                               Foreground="{Binding RelativeSource={RelativeSource AncestorType=Button}, Path=Foreground}" />
            </Button>

            <!-- Workspaces Expandable Folder Container -->
            <StackPanel x:Name="WorkspacesFolderHost" Margin="0,2,0,2">
                <!-- Folder Header Toggle Button (48x42) -->
                <Button x:Name="WorkspacesFolderButton"
                        Style="{StaticResource RailButtonStyle}"
                        ToolTip="Workspaces"
                        Click="OnWorkspacesFolderToggleClick">
                    <Grid Width="24" Height="24">
                        <ui:SymbolIcon Symbol="Grid24" FontSize="20"
                                       Foreground="{Binding RelativeSource={RelativeSource AncestorType=Button}, Path=Foreground}"
                                       HorizontalAlignment="Center" VerticalAlignment="Center" />
                        <!-- Pill Badge with Workspace Count -->
                        <Border HorizontalAlignment="Right" VerticalAlignment="Bottom"
                                Margin="0,0,-6,-3" CornerRadius="5" Padding="3,0"
                                Height="12" MinWidth="12"
                                Background="{DynamicResource SystemAccentColorPrimaryBrush}">
                            <TextBlock Text="{Binding Path=Workspaces.Count, Source={x:Static controllers:WorkspaceManager.Instance}}"
                                       FontSize="9" FontWeight="SemiBold" Foreground="#FFFFFF"
                                       HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                    </Grid>
                </Button>

                <!-- Collapsible Accordion Drawer with CubicEase -->
                <Border x:Name="WorkspacesAccordionDrawer"
                        ClipToBounds="True"
                        MaxHeight="0"
                        Opacity="0"
                        Background="{DynamicResource SurfaceGlassSubtleBrush}"
                        CornerRadius="8"
                        Margin="4,2">
                    <StackPanel Margin="0,4">
                        <!-- Bounded ScrollViewer (MaxHeight 240 prevents window overflow) -->
                        <ScrollViewer MaxHeight="240"
                                      VerticalScrollBarVisibility="Auto"
                                      HorizontalScrollBarVisibility="Disabled"
                                      controls:AutoHideScrollBehavior.IsEnabled="True"
                                      Focusable="False">
                            <ItemsControl ItemsSource="{Binding Path=Workspaces, Source={x:Static controllers:WorkspaceManager.Instance}}">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate DataType="{x:Type models:WorkspaceModel}">
                                        <Button Style="{StaticResource WorkspaceRailItemStyle}"
                                                Tag="{Binding}"
                                                Command="{Binding Path=SwitchWorkspaceCommand, Source={x:Static controllers:WorkspaceManager.Instance}}"
                                                CommandParameter="{Binding Id}"
                                                ToolTip="{Binding TooltipText}">
                                            <Button.ContextMenu>
                                                <ContextMenu DataContext="{Binding Path=PlacementTarget.DataContext, RelativeSource={RelativeSource Self}}">
                                                    <MenuItem Header="{Binding Name}" IsEnabled="False" FontWeight="SemiBold" />
                                                    <Separator />
                                                    <MenuItem Header="Rename..." 
                                                              Command="{Binding Path=RequestRenameWorkspaceCommand, Source={x:Static controllers:WorkspaceManager.Instance}}"
                                                              CommandParameter="{Binding Id}">
                                                        <MenuItem.Icon>
                                                            <ui:SymbolIcon Symbol="Edit24" FontSize="16" />
                                                        </MenuItem.Icon>
                                                    </MenuItem>
                                                    <Separator />
                                                    <MenuItem Header="Delete Workspace" 
                                                              Command="{Binding Path=RequestDeleteWorkspaceCommand, Source={x:Static controllers:WorkspaceManager.Instance}}"
                                                              CommandParameter="{Binding Id}"
                                                              Foreground="{DynamicResource StatusErrorBrush}">
                                                        <MenuItem.Icon>
                                                            <ui:SymbolIcon Symbol="Delete24" FontSize="16" Foreground="{DynamicResource StatusErrorBrush}" />
                                                        </MenuItem.Icon>
                                                    </MenuItem>
                                                </ContextMenu>
                                            </Button.ContextMenu>
                                            <Grid Width="38" Height="30">
                                                <!-- Active Left Accent Indicator Pip -->
                                                <Border Width="3" Height="14" CornerRadius="1.5"
                                                        HorizontalAlignment="Left" VerticalAlignment="Center"
                                                        Margin="1,0,0,0"
                                                        Background="{DynamicResource SystemAccentColorPrimaryBrush}"
                                                        Visibility="{Binding IsActive, Converter={StaticResource BoolToVis}}" />

                                                <!-- Workspace Avatar Pill / Glyph -->
                                                <Border Width="26" Height="26"
                                                        CornerRadius="6"
                                                        HorizontalAlignment="Center"
                                                        VerticalAlignment="Center">
                                                    <Border.Style>
                                                        <Style TargetType="Border">
                                                            <Setter Property="Background" Value="{DynamicResource SurfaceGlassBrush}" />
                                                            <Style.Triggers>
                                                                <DataTrigger Binding="{Binding IsActive}" Value="True">
                                                                    <Setter Property="Background" Value="{DynamicResource SystemAccentColorPrimaryBrush}" />
                                                                </DataTrigger>
                                                            </Style.Triggers>
                                                        </Style>
                                                    </Border.Style>
                                                    <TextBlock Text="{Binding DisplayGlyph}"
                                                               FontSize="12"
                                                               FontWeight="SemiBold"
                                                               HorizontalAlignment="Center"
                                                               VerticalAlignment="Center">
                                                        <TextBlock.Style>
                                                            <Style TargetType="TextBlock">
                                                                <Setter Property="Foreground" Value="{DynamicResource TextPrimaryBrush}" />
                                                                <Style.Triggers>
                                                                    <DataTrigger Binding="{Binding IsActive}" Value="True">
                                                                        <Setter Property="Foreground" Value="#FFFFFF" />
                                                                        <Setter Property="FontWeight" Value="Bold" />
                                                                    </DataTrigger>
                                                                </Style.Triggers>
                                                            </Style>
                                                        </TextBlock.Style>
                                                    </TextBlock>
                                                </Border>
                                            </Grid>
                                        </Button>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </ScrollViewer>

                        <!-- Add Workspace Button (+) [Disabled if count >= 10] -->
                        <Button x:Name="AddWorkspaceButton"
                                Style="{StaticResource WorkspaceRailItemStyle}"
                                Width="40" Height="28" Margin="0,2,0,0"
                                ToolTip="New Workspace (Max 10)"
                                Command="{Binding Path=CreateWorkspaceCommand, Source={x:Static controllers:WorkspaceManager.Instance}}"
                                IsEnabled="{Binding Path=CanCreateWorkspace, Source={x:Static controllers:WorkspaceManager.Instance}}">
                            <ui:SymbolIcon Symbol="Add16" FontSize="14"
                                           Foreground="{DynamicResource TextSecondaryBrush}" />
                        </Button>
                    </StackPanel>
                </Border>
            </StackPanel>
        </StackPanel>

        <!-- 2. Center Dynamic Shortcuts Area -->
        <ScrollViewer x:Name="ShortcutsScrollViewer"
                      Grid.Row="1"
                      VerticalScrollBarVisibility="Hidden"
                      HorizontalScrollBarVisibility="Disabled"
                      Focusable="False"
                      CanContentScroll="False"
                      VerticalAlignment="Stretch"
                      AllowDrop="True"
                      ContextMenu="{StaticResource AddShortcutContextMenu}"
                      DragOver="OnShortcutsDragOver"
                      DragLeave="OnShortcutsDragLeave"
                      Drop="OnShortcutsDrop">
            <Grid x:Name="ShortcutsContainer">
                <ItemsControl x:Name="ShortcutsItemsControl"
                              Margin="0">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate DataType="{x:Type models:SidebarShortcutItem}">
                            <Grid x:Name="ItemRowContainer"
                                  Background="Transparent"
                                  Tag="{Binding}"
                                  PreviewMouseLeftButtonDown="OnItemPreviewMouseLeftButtonDown"
                                  PreviewMouseLeftButtonUp="OnItemPreviewMouseLeftButtonUp"
                                  PreviewMouseMove="OnItemPreviewMouseMove"
                                  MouseDown="OnItemMouseDown">

                                <!-- 1. Normal Shortcut Button (Visible when NOT Separator) -->
                            <Button x:Name="ShortcutButton"
                                    Style="{StaticResource RailButtonStyle}"
                                    ToolTip="{Binding Title}"
                                    Tag="{Binding}"
                                    Click="OnShortcutClick">
                                <Button.ContextMenu>
                                    <ContextMenu DataContext="{Binding Path=PlacementTarget.Tag, RelativeSource={RelativeSource Self}}">
                                        <MenuItem Header="{Binding Title}" IsEnabled="False" FontWeight="{DynamicResource TypeBodyStrongFontWeight}" />
                                        <Separator />

                                        <!-- Folder Actions (Visible when IsFolder is True) -->
                                        <MenuItem Header="Open in Terminal" Click="OnOpenInTerminalClick"
                                                  Visibility="{Binding IsFolder, Converter={StaticResource BoolToVis}}">
                                            <MenuItem.Icon>
                                                <ui:SymbolIcon Symbol="Code24" FontSize="16" />
                                            </MenuItem.Icon>
                                        </MenuItem>
                                        <MenuItem Header="Open in New Window" Click="OnOpenInNewWindowClick"
                                                  Visibility="{Binding IsFolder, Converter={StaticResource BoolToVis}}">
                                            <MenuItem.Icon>
                                                <ui:SymbolIcon Symbol="Open24" FontSize="16" />
                                            </MenuItem.Icon>
                                        </MenuItem>

                                        <!-- Copy Path Action -->
                                        <MenuItem Header="Copy Path" Click="OnCopyPathClick">
                                            <MenuItem.Icon>
                                                <ui:SymbolIcon Symbol="Copy24" FontSize="16" />
                                            </MenuItem.Icon>
                                        </MenuItem>

                                        <Separator />
                                        <MenuItem Header="Move Up" Click="OnMoveUpClick">
                                            <MenuItem.Icon>
                                                <ui:SymbolIcon Symbol="ArrowUp24" FontSize="16" />
                                            </MenuItem.Icon>
                                        </MenuItem>
                                        <MenuItem Header="Move Down" Click="OnMoveDownClick">
                                            <MenuItem.Icon>
                                                <ui:SymbolIcon Symbol="ArrowDown24" FontSize="16" />
                                            </MenuItem.Icon>
                                        </MenuItem>
                                        <Separator />

                                        <!-- Change Icon Submenu -->
                                        <MenuItem Header="Change Icon">
                                            <MenuItem.Icon>
                                                <ui:SymbolIcon Symbol="PaintBrush24" FontSize="16" />
                                            </MenuItem.Icon>
                                            <MenuItem Header="Standard Folder" Tag="Folder24" Click="OnChangeIconClick">
                                                <MenuItem.Icon>
                                                    <ui:SymbolIcon Symbol="Folder24" FontSize="16" />
                                                </MenuItem.Icon>
                                            </MenuItem>
                                            <MenuItem Header="Open Folder" Tag="FolderOpen24" Click="OnChangeIconClick">
                                                <MenuItem.Icon>
                                                    <ui:SymbolIcon Symbol="FolderOpen24" FontSize="16" />
                                                </MenuItem.Icon>
                                            </MenuItem>
                                            <MenuItem Header="Archive / Zip" Tag="FolderZip24" Click="OnChangeIconClick">
                                                <MenuItem.Icon>
                                                    <ui:SymbolIcon Symbol="FolderZip24" FontSize="16" />
                                                </MenuItem.Icon>
                                            </MenuItem>
                                            <Separator />
                                            <MenuItem Header="Games" Tag="Games24" Click="OnChangeIconClick">
                                                <MenuItem.Icon>
                                                    <ui:SymbolIcon Symbol="Games24" FontSize="16" />
                                                </MenuItem.Icon>
                                            </MenuItem>
                                            <MenuItem Header="Code / Projects" Tag="Code24" Click="OnChangeIconClick">
                                                <MenuItem.Icon>
                                                    <ui:SymbolIcon Symbol="Code24" FontSize="16" />
                                                </MenuItem.Icon>
                                            </MenuItem>
                                            <MenuItem Header="Music / Audio" Tag="MusicNote224" Click="OnChangeIconClick">
                                                <MenuItem.Icon>
                                                    <ui:SymbolIcon Symbol="MusicNote224" FontSize="16" />
                                                </MenuItem.Icon>
                                            </MenuItem>
                                            <MenuItem Header="Photos / Media" Tag="Image24" Click="OnChangeIconClick">
                                                <MenuItem.Icon>
                                                    <ui:SymbolIcon Symbol="Image24" FontSize="16" />
                                                </MenuItem.Icon>
                                            </MenuItem>
                                            <MenuItem Header="Videos / Movies" Tag="Video24" Click="OnChangeIconClick">
                                                <MenuItem.Icon>
                                                    <ui:SymbolIcon Symbol="Video24" FontSize="16" />
                                                </MenuItem.Icon>
                                            </MenuItem>
                                            <MenuItem Header="Documents" Tag="Document24" Click="OnChangeIconClick">
                                                <MenuItem.Icon>
                                                    <ui:SymbolIcon Symbol="Document24" FontSize="16" />
                                                </MenuItem.Icon>
                                            </MenuItem>
                                            <MenuItem Header="Downloads" Tag="ArrowDownload24" Click="OnChangeIconClick">
                                                <MenuItem.Icon>
                                                    <ui:SymbolIcon Symbol="ArrowDownload24" FontSize="16" />
                                                </MenuItem.Icon>
                                            </MenuItem>
                                            <Separator />
                                            <MenuItem Header="Work / Office" Tag="Briefcase24" Click="OnChangeIconClick">
                                                <MenuItem.Icon>
                                                    <ui:SymbolIcon Symbol="Briefcase24" FontSize="16" />
                                                </MenuItem.Icon>
                                            </MenuItem>
                                            <MenuItem Header="Cloud Drive" Tag="Cloud24" Click="OnChangeIconClick">
                                                <MenuItem.Icon>
                                                    <ui:SymbolIcon Symbol="Cloud24" FontSize="16" />
                                                </MenuItem.Icon>
                                            </MenuItem>
                                            <MenuItem Header="Desktop" Tag="Desktop24" Click="OnChangeIconClick">
                                                <MenuItem.Icon>
                                                    <ui:SymbolIcon Symbol="Desktop24" FontSize="16" />
                                                </MenuItem.Icon>
                                            </MenuItem>
                                            <MenuItem Header="Hard Drive" Tag="HardDrive24" Click="OnChangeIconClick">
                                                <MenuItem.Icon>
                                                    <ui:SymbolIcon Symbol="HardDrive24" FontSize="16" />
                                                </MenuItem.Icon>
                                            </MenuItem>
                                            <MenuItem Header="Tools / Utilities" Tag="Wrench24" Click="OnChangeIconClick">
                                                <MenuItem.Icon>
                                                    <ui:SymbolIcon Symbol="Wrench24" FontSize="16" />
                                                </MenuItem.Icon>
                                            </MenuItem>
                                            <Separator />
                                            <MenuItem Header="Star" Tag="Star24" Click="OnChangeIconClick">
                                                <MenuItem.Icon>
                                                    <ui:SymbolIcon Symbol="Star24" FontSize="16" />
                                                </MenuItem.Icon>
                                            </MenuItem>
                                            <MenuItem Header="Rocket" Tag="Rocket24" Click="OnChangeIconClick">
                                                <MenuItem.Icon>
                                                    <ui:SymbolIcon Symbol="Rocket24" FontSize="16" />
                                                </MenuItem.Icon>
                                            </MenuItem>
                                            <MenuItem Header="Heart" Tag="Heart24" Click="OnChangeIconClick">
                                                <MenuItem.Icon>
                                                    <ui:SymbolIcon Symbol="Heart24" FontSize="16" />
                                                </MenuItem.Icon>
                                            </MenuItem>
                                        </MenuItem>
                                        <Separator />
                                        <MenuItem Header="Unpin from Sidebar" Click="OnRemoveShortcutClick">
                                            <MenuItem.Icon>
                                                <ui:SymbolIcon Symbol="Delete24" FontSize="16" />
                                            </MenuItem.Icon>
                                        </MenuItem>
                                    </ContextMenu>
                                </Button.ContextMenu>

                                <Grid Width="22" Height="22">
                                    <!-- Real Application / Shell Icon (when CustomIconPath exists) -->
                                    <Image Source="{Binding CustomIconPath, TargetNullValue={x:Null}, FallbackValue={x:Null}}"
                                           Width="20"
                                           Height="20"
                                           HorizontalAlignment="Center"
                                           VerticalAlignment="Center"
                                           RenderOptions.BitmapScalingMode="HighQuality">
                                        <Image.Style>
                                            <Style TargetType="Image">
                                                <Setter Property="Visibility" Value="Collapsed" />
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding HasCustomIcon}" Value="True">
                                                        <Setter Property="Visibility" Value="Visible" />
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </Image.Style>
                                    </Image>

                                    <!-- Built-in Fluent Vector Symbol Icon (when no CustomIconPath) -->
                                    <ui:SymbolIcon Symbol="{Binding IconSymbol, FallbackValue=Folder24, TargetNullValue=Folder24}"
                                                   FontSize="19"
                                                   Foreground="{Binding RelativeSource={RelativeSource AncestorType=Button}, Path=Foreground}"
                                                   HorizontalAlignment="Center"
                                                   VerticalAlignment="Center">
                                        <ui:SymbolIcon.Style>
                                            <Style TargetType="ui:SymbolIcon">
                                                <Setter Property="Visibility" Value="Visible" />
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding HasCustomIcon}" Value="True">
                                                        <Setter Property="Visibility" Value="Collapsed" />
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </ui:SymbolIcon.Style>
                                    </ui:SymbolIcon>
                                </Grid>
                            </Button>

                            <!-- 2. Visual Separator / Divider (Visible when IsSeparator is True) -->
                            <Border x:Name="SeparatorHost"
                                    Height="14"
                                    Background="Transparent"
                                    Tag="{Binding}"
                                    Cursor="SizeNS"
                                    Visibility="Collapsed">
                                <Border.ContextMenu>
                                    <ContextMenu DataContext="{Binding Path=PlacementTarget.Tag, RelativeSource={RelativeSource Self}}">
                                        <MenuItem Header="Divider" IsEnabled="False" FontWeight="{DynamicResource TypeBodyStrongFontWeight}" />
                                        <Separator />
                                        <MenuItem Header="Move Up" Click="OnMoveUpClick">
                                            <MenuItem.Icon>
                                                <ui:SymbolIcon Symbol="ArrowUp24" FontSize="16" />
                                            </MenuItem.Icon>
                                        </MenuItem>
                                        <MenuItem Header="Move Down" Click="OnMoveDownClick">
                                            <MenuItem.Icon>
                                                <ui:SymbolIcon Symbol="ArrowDown24" FontSize="16" />
                                            </MenuItem.Icon>
                                        </MenuItem>
                                        <Separator />
                                        <MenuItem Header="Remove Divider" Click="OnRemoveShortcutClick">
                                            <MenuItem.Icon>
                                                <ui:SymbolIcon Symbol="Delete24" FontSize="16" />
                                            </MenuItem.Icon>
                                        </MenuItem>
                                    </ContextMenu>
                                </Border.ContextMenu>
                                <Rectangle Height="1"
                                           Margin="10,0"
                                           Fill="{DynamicResource TextDisabledBrush}"
                                           VerticalAlignment="Center" />
                            </Border>
                        </Grid>

                        <DataTemplate.Triggers>
                            <DataTrigger Binding="{Binding IsSeparator}" Value="True">
                                <Setter TargetName="ShortcutButton" Property="Visibility" Value="Collapsed" />
                                <Setter TargetName="SeparatorHost" Property="Visibility" Value="Visible" />
                            </DataTrigger>
                        </DataTemplate.Triggers>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>

            <!-- Single Live Spotify Insertion Indicator -->
            <Border x:Name="DragInsertionLine"
                    Height="2"
                    Margin="6,0,6,0"
                    CornerRadius="1"
                    Background="{DynamicResource SystemAccentColorPrimaryBrush}"
                    VerticalAlignment="Top"
                    HorizontalAlignment="Stretch"
                    Visibility="Collapsed"
                    IsHitTestVisible="False"
                    Panel.ZIndex="1000">
                <Border.RenderTransform>
                    <TranslateTransform x:Name="DragInsertionTransform" Y="0" />
                </Border.RenderTransform>
            </Border>
        </Grid>
    </ScrollViewer>

        <!-- 3. Bottom Section: Add Shortcut & Power -->
        <StackPanel Grid.Row="2" Margin="0,0,0,10">
            <!-- Add Shortcut Button (+) -->
            <Button x:Name="AddShortcutButton"
                    Style="{StaticResource RailButtonStyle}"
                    ToolTip="Add shortcut..."
                    ContextMenu="{StaticResource AddShortcutContextMenu}"
                    PreviewMouseRightButtonUp="OnAddShortcutRightClick"
                    Click="OnAddShortcutClick">
                <ui:SymbolIcon Symbol="Add24" FontSize="19"
                               Foreground="{Binding RelativeSource={RelativeSource AncestorType=Button}, Path=Foreground}" />
            </Button>

            <!-- Power Button with Context Menu -->
            <Button x:Name="PowerButton"
                    Style="{StaticResource RailButtonStyle}"
                    ToolTip="Power"
                    Click="OnPowerClick">
                <ui:SymbolIcon Symbol="Power24" FontSize="19"
                               Foreground="{Binding RelativeSource={RelativeSource AncestorType=Button}, Path=Foreground}" />
                <Button.ContextMenu>
                    <ContextMenu x:Name="PowerContextMenu">
                        <MenuItem Header="Sleep" Click="OnSleepClick">
                            <MenuItem.Icon>
                                <ui:SymbolIcon Symbol="WeatherMoon24" FontSize="18" />
                            </MenuItem.Icon>
                        </MenuItem>
                        <MenuItem Header="Shut down" Click="OnShutdownClick">
                            <MenuItem.Icon>
                                <ui:SymbolIcon Symbol="Power24" FontSize="18" />
                            </MenuItem.Icon>
                        </MenuItem>
                        <MenuItem Header="Restart" Click="OnRestartClick">
                            <MenuItem.Icon>
                                <ui:SymbolIcon Symbol="ArrowCounterclockwise24" FontSize="18" />
                            </MenuItem.Icon>
                        </MenuItem>
                        <Separator />
                        <MenuItem Header="Lock" Click="OnLockClick">
                            <MenuItem.Icon>
                                <ui:SymbolIcon Symbol="LockClosed24" FontSize="18" />
                            </MenuItem.Icon>
                        </MenuItem>
                    </ContextMenu>
                </Button.ContextMenu>
            </Button>
        </StackPanel>
    </Grid>
</UserControl>
