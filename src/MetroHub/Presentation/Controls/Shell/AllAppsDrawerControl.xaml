<UserControl x:Class="MetroHub.Presentation.Controls.AllAppsDrawerControl"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
             xmlns:controls="clr-namespace:MetroHub.Presentation.Controls"
             mc:Ignorable="d" 
             Width="340"
             HorizontalAlignment="Left"
             VerticalAlignment="Stretch"
             Focusable="False"
             ClipToBounds="False"
             Visibility="Collapsed"
             Background="Transparent"
             TextOptions.TextFormattingMode="Ideal"
             TextOptions.TextRenderingMode="Auto"
             UseLayoutRounding="True"
>

    <UserControl.RenderTransform>
        <TranslateTransform x:Name="DrawerTranslate" X="0" />
    </UserControl.RenderTransform>

    <UserControl.Resources>
        <!-- Fluent Design System: Unified 12px Visual Gutter & Layout Tokens -->
        <Thickness x:Key="DrawerGutterHeaderMargin">12,2,12,0</Thickness>
        <Thickness x:Key="DrawerGutterSearchMargin">12,4,12,12</Thickness>
        <Thickness x:Key="DrawerGutterSectionHeaderMargin">12,12,12,6</Thickness>
        <Thickness x:Key="DrawerGutterGroupHeaderMargin">12,12,12,4</Thickness>
        <Thickness x:Key="DrawerGutterRecentGridMargin">12,0,12,0</Thickness>
        <Thickness x:Key="DrawerGutterRecentTileMargin">0</Thickness>
        <Thickness x:Key="DrawerGutterHoverRowMargin">4,1,12,1</Thickness>
        <Thickness x:Key="DrawerGutterHoverRowPadding">8,5</Thickness>

        <!-- Custom Clean TextBox Style: Zero WPF-UI chrome, no borders, no bottom accent line -->
        <Style x:Key="CleanSearchTextBoxStyle" TargetType="{x:Type TextBox}">
            <Setter Property="OverridesDefaultStyle" Value="True" />
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="Foreground" Value="{DynamicResource TextPrimaryBrush}" />
            <Setter Property="CaretBrush" Value="{DynamicResource TextPrimaryBrush}" />
            <Setter Property="FontFamily" Value="{DynamicResource AppFontFamily}" />
            <Setter Property="FontSize" Value="{DynamicResource TypeBodyFontSize}" />
            <Setter Property="FontWeight" Value="{DynamicResource TypeBodyFontWeight}" />
            <Setter Property="VerticalContentAlignment" Value="Center" />
            <Setter Property="Padding" Value="0" />
            <Setter Property="Margin" Value="0" />
            <Setter Property="FocusVisualStyle" Value="{x:Null}" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="{x:Type TextBox}">
                        <ScrollViewer x:Name="PART_ContentHost"
                                      Focusable="False"
                                      HorizontalScrollBarVisibility="Hidden"
                                      VerticalScrollBarVisibility="Hidden"
                                      VerticalAlignment="Center"
                                      Padding="0"
                                      Margin="0" />
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Modern Fluent App Item Style: Matches Sidebar Hover Pill -->
        <Style x:Key="AppRowContainerStyle" TargetType="Border">
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="BorderBrush" Value="Transparent" />
            <Setter Property="CornerRadius" Value="{DynamicResource ControlCornerRadius}" />
            <Setter Property="Margin" Value="{StaticResource DrawerGutterHoverRowMargin}" />
            <Setter Property="Padding" Value="{StaticResource DrawerGutterHoverRowPadding}" />
            <Setter Property="SnapsToDevicePixels" Value="True" />
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Background" Value="{DynamicResource FluentHoverBrush}" />
                </Trigger>
            </Style.Triggers>
        </Style>

        <!-- Modern Fluent Search Result Item Style: Zero Padding, Completely Transparent Container -->
        <Style x:Key="FluentSearchListBoxItemStyle" TargetType="{x:Type ListBoxItem}">
            <Setter Property="FocusVisualStyle" Value="{x:Null}" />
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="BorderBrush" Value="Transparent" />
            <Setter Property="Margin" Value="0" />
            <Setter Property="Padding" Value="0" />
            <Setter Property="HorizontalContentAlignment" Value="Stretch" />
            <Setter Property="VerticalContentAlignment" Value="Stretch" />
            <Setter Property="SnapsToDevicePixels" Value="True" />
            <Setter Property="ClipToBounds" Value="False" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="{x:Type ListBoxItem}">
                        <ContentPresenter SnapsToDevicePixels="True" />
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Drawer Virtualized ListBox Item Style: Non-focusable/non-hit-testable headers, transparent container -->
        <Style x:Key="DrawerListBoxItemStyle" TargetType="{x:Type ListBoxItem}" BasedOn="{StaticResource FluentSearchListBoxItemStyle}">
            <Style.Triggers>
                <DataTrigger Binding="{Binding IsHeader}" Value="True">
                    <Setter Property="Focusable" Value="False" />
                    <Setter Property="IsHitTestVisible" Value="False" />
                </DataTrigger>
            </Style.Triggers>
        </Style>

        <!-- Modern Mini Pin Button Style: Inherits Universal WidgetMicroButtonStyle -->
        <Style x:Key="MiniPinButtonStyle" TargetType="Button" BasedOn="{StaticResource WidgetMicroButtonStyle}" />

        <!-- Comprehensive Fluent App Context Menu: Open -> Run as Admin -> Pin/Unpin -> Separator -> Uninstall -->
        <ContextMenu x:Key="AppItemContextMenu"
                     Opened="OnAppContextMenuOpened"
                     PreviewKeyDown="OnAppContextMenuPreviewKeyDown">
            <MenuItem Header="Open" Click="OnContextMenuOpenClick">
                <MenuItem.Icon>
                    <ui:SymbolIcon Symbol="ArrowRight24" FontSize="18" />
                </MenuItem.Icon>
            </MenuItem>
            <MenuItem Header="Run as administrator" Click="OnContextMenuRunAsAdminClick">
                <MenuItem.Icon>
                    <ui:SymbolIcon Symbol="Shield24" FontSize="18" Foreground="{DynamicResource TextSecondaryBrush}" />
                </MenuItem.Icon>
            </MenuItem>
            <Separator />
            <MenuItem x:Name="PinMenuItem" Header="Pin to MetroHub" Click="OnContextMenuPinToggleClick">
                <MenuItem.Icon>
                    <ui:SymbolIcon Symbol="Pin24" FontSize="18" />
                </MenuItem.Icon>
            </MenuItem>
            <MenuItem x:Name="PinSidebarMenuItem" Header="Pin to Sidebar" Click="OnContextMenuPinToSidebarClick">
                <MenuItem.Icon>
                    <ui:SymbolIcon Symbol="Pin24" FontSize="18" />
                </MenuItem.Icon>
            </MenuItem>
            <Separator />
            <MenuItem Header="Uninstall" Click="OnContextMenuUninstallClick" Foreground="{DynamicResource StatusErrorBrush}">
                <MenuItem.Icon>
                    <ui:SymbolIcon Symbol="Delete24" FontSize="18" Foreground="{DynamicResource StatusErrorBrush}" />
                </MenuItem.Icon>
            </MenuItem>
        </ContextMenu>


        <!-- Shared Search and Recent Suggestion Item Row Template -->
        <DataTemplate x:Key="SearchItemRowTemplate">
            <StackPanel Margin="0">
                <!-- Category Section Header: completely outside the row card with generous typography -->
                <Border Visibility="{Binding CategoryHeaderVisibility}"
                        Margin="{StaticResource DrawerGutterSectionHeaderMargin}"
                        Padding="0"
                        Focusable="False"
                        Background="Transparent"
                        PreviewMouseLeftButtonDown="OnCategoryHeaderPreviewMouseDown">
                    <TextBlock Text="{Binding CategoryHeader}"
                               FontSize="14"
                               FontWeight="SemiBold"
                               FontFamily="{DynamicResource AppDisplayFontFamily}"
                               Foreground="{DynamicResource TextSubtleBrush}" />
                </Border>

                <!-- Search Result Item Row Card: isolated selection highlight, hover effect, and accent pill -->
                <Border x:Name="RowCard"
                        Margin="{StaticResource DrawerGutterHoverRowMargin}"
                        Padding="0"
                        CornerRadius="{DynamicResource ControlCornerRadius}"
                        Background="Transparent"
                        SnapsToDevicePixels="True"
                        ToolTip="{Binding FullPath}"
                        Tag="{Binding}"
                        PreviewMouseLeftButtonDown="OnSearchRowPreviewMouseLeftButtonDown"
                        PreviewMouseMove="OnSearchRowPreviewMouseMove"
                        MouseLeftButtonUp="OnSearchRowMouseLeftButtonUp"
                        ContextMenuOpening="OnSearchRowContextMenuOpening">
                    <Grid>
                        <!-- Selection Accent Pill: docked cleanly to the card's outer left edge with zero overlap -->
                        <Rectangle x:Name="AccentPill"
                                   Width="3"
                                   Height="16"
                                   HorizontalAlignment="Left"
                                   VerticalAlignment="Center"
                                   RadiusX="1.5"
                                   RadiusY="1.5"
                                   Fill="{DynamicResource SystemAccentColorPrimaryBrush}"
                                   Visibility="Collapsed"
                                   Margin="0,0,0,0" />

                        <!-- Search Result Item Content: cleanly padded from the card boundaries -->
                        <Grid Margin="{StaticResource DrawerGutterHoverRowPadding}">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="22" SharedSizeGroup="AppIconColumn" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>

                            <!-- Left Icon or Category Symbol (Centered optical axis) -->
                            <Grid Grid.Column="0" Width="22" Height="22" HorizontalAlignment="Center" VerticalAlignment="Center">
                                <Image Source="{Binding Icon, TargetNullValue={x:Null}, FallbackValue={x:Null}}"
                                       Width="20"
                                       Height="20"
                                       HorizontalAlignment="Center"
                                       VerticalAlignment="Center"
                                       Visibility="{Binding CustomIconVisibility}"
                                       RenderOptions.BitmapScalingMode="HighQuality" />

                                <ui:SymbolIcon Symbol="{Binding Symbol}"
                                               FontSize="18"
                                               Foreground="{DynamicResource TextSecondaryBrush}"
                                               HorizontalAlignment="Center"
                                               VerticalAlignment="Center"
                                               Visibility="{Binding SymbolVisibility}" />
                            </Grid>

                            <!-- Display Name and Subtitle (Path/Details) -->
                            <StackPanel Grid.Column="1" VerticalAlignment="Center" Margin="8,0,8,0">
                                <TextBlock Text="{Binding DisplayName}"
                                           FontSize="{DynamicResource TypeBodyFontSize}"
                                           FontWeight="{DynamicResource TypeBodyFontWeight}"
                                           Foreground="{DynamicResource TextPrimaryBrush}"
                                           TextTrimming="CharacterEllipsis" />

                                <TextBlock Text="{Binding Subtitle}"
                                           FontSize="12"
                                           Foreground="{DynamicResource TextMutedBrush}"
                                           Opacity="0.6"
                                           TextWrapping="WrapWithOverflow"
                                           TextTrimming="CharacterEllipsis"
                                           MaxHeight="36"
                                           Margin="0,2,0,0"
                                           Visibility="{Binding SubtitleVisibility}" />
                            </StackPanel>

                            <!-- Kind Badge: small right-aligned muted label -->
                            <TextBlock Grid.Column="2"
                                       Text="{Binding KindBadge}"
                                       FontSize="11"
                                       Foreground="{DynamicResource TextMutedBrush}"
                                       Opacity="0.55"
                                       VerticalAlignment="Center"
                                       HorizontalAlignment="Right"
                                       Margin="8,0,4,0"
                                       Visibility="{Binding KindBadgeVisibility}" />
                        </Grid>
                    </Grid>
                </Border>
            </StackPanel>
            <DataTemplate.Triggers>
                <DataTrigger Binding="{Binding ElementName=RowCard, Path=IsMouseOver}" Value="True">
                    <Setter TargetName="RowCard" Property="Background" Value="{DynamicResource FluentHoverBrush}" />
                </DataTrigger>
                <DataTrigger Binding="{Binding RelativeSource={RelativeSource AncestorType=ListBoxItem}, Path=IsSelected}" Value="True">
                    <Setter TargetName="RowCard" Property="Background" Value="{DynamicResource FluentPressedBrush}" />
                    <Setter TargetName="AccentPill" Property="Visibility" Value="Visible" />
                </DataTrigger>
                <DataTrigger Binding="{Binding RelativeSource={RelativeSource AncestorType=ListBoxItem}, Path=IsKeyboardFocused}" Value="True">
                    <Setter TargetName="RowCard" Property="Background" Value="{DynamicResource FluentPressedBrush}" />
                    <Setter TargetName="AccentPill" Property="Visibility" Value="Visible" />
                </DataTrigger>
                <MultiDataTrigger>
                    <MultiDataTrigger.Conditions>
                        <Condition Binding="{Binding RelativeSource={RelativeSource AncestorType=ListBoxItem}, Path=IsSelected}" Value="True" />
                        <Condition Binding="{Binding ElementName=RowCard, Path=IsMouseOver}" Value="True" />
                    </MultiDataTrigger.Conditions>
                    <Setter TargetName="RowCard" Property="Background" Value="#25FFFFFF" />
                </MultiDataTrigger>
            </DataTemplate.Triggers>
        </DataTemplate>

        <!-- Acrylic Squircle Grid Tile Template for Recent Items (Option A: Icon-Only, 5 Columns, Spaced Grid) -->
        <DataTemplate x:Key="RecentGridTileTemplate">
            <Border x:Name="GridTileCard"
                    Height="48"
                    Margin="0"
                    HorizontalAlignment="Stretch"
                    VerticalAlignment="Stretch"
                    CornerRadius="{DynamicResource TileCornerRadius}"
                    BorderThickness="0"
                    ClipToBounds="False"
                    SnapsToDevicePixels="True"
                    UseLayoutRounding="True"
                    ToolTip="{Binding DisplayName}"
                    Tag="{Binding}"
                    Cursor="Hand"
                    RenderTransformOrigin="0.5,0.5"
                    MouseEnter="OnRecentGridTileMouseEnter"
                    MouseLeave="OnRecentGridTileMouseLeave"
                    PreviewMouseMove="OnRecentGridTilePreviewMouseMove"
                    PreviewMouseLeftButtonDown="OnSearchRowPreviewMouseLeftButtonDown"
                    MouseLeftButtonUp="OnSearchRowMouseLeftButtonUp"
                    ContextMenuOpening="OnSearchRowContextMenuOpening">
                <Border.RenderTransform>
                    <ScaleTransform x:Name="TileScale" ScaleX="1.0" ScaleY="1.0" />
                </Border.RenderTransform>
                <Border.Style>
                    <Style TargetType="Border">
                        <Setter Property="Background" Value="#14FFFFFF" />
                        <Style.Triggers>
                            <DataTrigger Binding="{Binding RelativeSource={RelativeSource AncestorType=ListBoxItem}, Path=IsSelected}" Value="True">
                                <Setter Property="Background" Value="#28FFFFFF" />
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </Border.Style>

                <Grid SnapsToDevicePixels="True" UseLayoutRounding="True">
                    <!-- Fluent Reveal Highlight: Surface Spotlight -->
                    <Border x:Name="RevealFillBorder"
                            CornerRadius="{DynamicResource TileCornerRadius}"
                            IsHitTestVisible="False"
                            Opacity="0">
                        <Border.Background>
                            <RadialGradientBrush x:Name="RevealFillBrush" MappingMode="Absolute" Center="26,24" GradientOrigin="26,24" RadiusX="65" RadiusY="65">
                                <GradientStop Color="#40FFFFFF" Offset="0.0" />
                                <GradientStop Color="#16FFFFFF" Offset="0.5" />
                                <GradientStop Color="#00000000" Offset="1.0" />
                            </RadialGradientBrush>
                        </Border.Background>
                    </Border>

                    <!-- Icon Area -->
                    <Grid HorizontalAlignment="Center" VerticalAlignment="Center">
                        <!-- High-DPI App Icon -->
                        <Image Source="{Binding Icon, TargetNullValue={x:Null}, FallbackValue={x:Null}}"
                               Width="24"
                               Height="24"
                               HorizontalAlignment="Center"
                               VerticalAlignment="Center"
                               Visibility="{Binding CustomIconVisibility}"
                               RenderOptions.BitmapScalingMode="HighQuality" />

                        <!-- Fallback Fluent Symbol Icon -->
                        <ui:SymbolIcon Symbol="{Binding Symbol}"
                                       FontSize="18"
                                       Foreground="{DynamicResource TextPrimaryBrush}"
                                       HorizontalAlignment="Center"
                                       VerticalAlignment="Center"
                                       Visibility="{Binding SymbolVisibility}" />
                    </Grid>

                    <!-- Rest / Selection Perimeter Stroke (Above Content, Never Occluded; Transparent at rest) -->
                    <Border x:Name="RestBorder"
                            Background="Transparent"
                            CornerRadius="{DynamicResource TileCornerRadius}"
                            BorderThickness="1"
                            IsHitTestVisible="False">
                        <Border.Style>
                            <Style TargetType="Border">
                                <Setter Property="BorderBrush" Value="Transparent" />
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding RelativeSource={RelativeSource AncestorType=Border}, Path=IsMouseOver}" Value="True">
                                        <Setter Property="BorderBrush" Value="#25FFFFFF" />
                                    </DataTrigger>
                                    <DataTrigger Binding="{Binding RelativeSource={RelativeSource AncestorType=ListBoxItem}, Path=IsSelected}" Value="True">
                                        <Setter Property="BorderBrush" Value="{DynamicResource SystemAccentColorPrimaryBrush}" />
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </Border.Style>
                    </Border>

                    <!-- Fluent Reveal Highlight: Edge Illumination (Coincident @ 0,0, Thickness=1) -->
                    <Border x:Name="RevealEdgeBorder"
                            Background="Transparent"
                            CornerRadius="{DynamicResource TileCornerRadius}"
                            BorderThickness="1"
                            IsHitTestVisible="False"
                            Opacity="0">
                        <Border.BorderBrush>
                            <RadialGradientBrush x:Name="RevealEdgeBrush" MappingMode="Absolute" Center="26,24" GradientOrigin="26,24" RadiusX="55" RadiusY="55">
                                <GradientStop Color="#FFFFFFFF" Offset="0.0" />
                                <GradientStop Color="#60FFFFFF" Offset="0.5" />
                                <GradientStop Color="#00000000" Offset="1.0" />
                            </RadialGradientBrush>
                        </Border.BorderBrush>
                    </Border>
                </Grid>
            </Border>
        </DataTemplate>

        <!-- ItemsPanel Template for Grid Mode: 5 Columns Spaced Uniform Grid (Calculated 52px Tiles, 9px Gap) -->
        <ItemsPanelTemplate x:Key="RecentGridItemsPanelTemplate">
            <controls:SpacedUniformGrid Columns="5" ColumnGap="9" RowGap="8" Margin="0,2,0,2" />
        </ItemsPanelTemplate>

        <!-- ItemsPanel Template for List Mode: Standard StackPanel -->
        <ItemsPanelTemplate x:Key="RecentListItemsPanelTemplate">
            <StackPanel />
        </ItemsPanelTemplate>
    </UserControl.Resources>

    <Grid>
        <!-- Right Edge Soft Drop Shadow: Casts strictly to the right onto canvas tiles, zero shader effect, zero black backbuffer, zero left shadow -->
        <Border Width="24"
                HorizontalAlignment="Right"
                Margin="0,0,-24,0"
                IsHitTestVisible="False">
            <Border.Background>
                <LinearGradientBrush StartPoint="0,0" EndPoint="1,0">
                    <GradientStop Color="#45000000" Offset="0" />
                    <GradientStop Color="#20000000" Offset="0.35" />
                    <GradientStop Color="#0A000000" Offset="0.75" />
                    <GradientStop Color="#00000000" Offset="1" />
                </LinearGradientBrush>
            </Border.Background>
        </Border>

        <!-- Main Drawer Container: NO BORDER, Transparent Background allowing Main Window's Acrylic Obsidian to shine through -->
        <Border x:Name="DrawerContainer"
                Background="Transparent"
                BorderThickness="0"
                >

        <Grid>
            <Grid.RowDefinitions>
                <!-- Header / Title -->
                <RowDefinition Height="Auto" />
                <!-- Search Bar -->
                <RowDefinition Height="Auto" />
                <!-- Apps Content (Alphabetical Groups or Search Results) -->
                <RowDefinition Height="*" />
            </Grid.RowDefinitions>

            <Grid x:Name="DrawerHeaderGrid" Grid.Row="0" Height="42" Margin="{StaticResource DrawerGutterHeaderMargin}">
                <!-- Left-aligned Title flush to 12px baseline -->
                <TextBlock Text="All apps"
                           FontSize="{DynamicResource TypeHeaderFontSize}"
                           FontWeight="{DynamicResource TypeHeaderFontWeight}"
                           FontFamily="{DynamicResource AppFontFamily}"
                           Foreground="{DynamicResource TextPrimaryBrush}"
                           VerticalAlignment="Center"
                           HorizontalAlignment="Left" />
                
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center">
                    <Button x:Name="RefreshButton"
                            Style="{StaticResource SubtleButtonStyle}"
                            Width="32"
                            Height="32"
                            Padding="0"
                            Focusable="False"
                            ToolTip="Refresh installed apps"
                            Margin="0,0,2,0"
                            Click="OnRefreshClick">
                        <ui:SymbolIcon x:Name="RefreshIcon"
                                       Symbol="ArrowClockwise24"
                                       FontSize="16"
                                       Foreground="{Binding RelativeSource={RelativeSource AncestorType=Button}, Path=Foreground}"
                                       RenderTransformOrigin="0.5,0.5">
                            <ui:SymbolIcon.RenderTransform>
                                <RotateTransform x:Name="RefreshIconRotation" Angle="0" />
                            </ui:SymbolIcon.RenderTransform>
                        </ui:SymbolIcon>
                    </Button>
                    <Button x:Name="CloseButton"
                            Style="{StaticResource SubtleButtonStyle}"
                            Width="32"
                            Height="32"
                            Padding="0"
                            Focusable="False"
                            ToolTip="Close"
                            Click="OnCloseClick">
                        <ui:SymbolIcon Symbol="Dismiss24"
                                       FontSize="16"
                                       Foreground="{Binding RelativeSource={RelativeSource AncestorType=Button}, Path=Foreground}" />
                    </Button>
                </StackPanel>
            </Grid>

            <Border Grid.Row="1"
                    x:Name="SearchBorder"
                    Margin="{StaticResource DrawerGutterSearchMargin}"
                    Height="34"
                    CornerRadius="{DynamicResource ControlCornerRadius}"
                    Background="{DynamicResource WidgetDividerBrush}"
                    BorderThickness="0"
                    >
                <Grid>
                    <ui:SymbolIcon Symbol="Search24"
                                   FontSize="15"
                                   Foreground="{DynamicResource TextSubtleBrush}"
                                   HorizontalAlignment="Left"
                                   VerticalAlignment="Center"
                                   Margin="10,0,0,0"
                                   IsHitTestVisible="False" />

                    <TextBlock x:Name="SearchPlaceholder"
                               Text="Type to search, or '?' for shortcuts..."
                               FontSize="{DynamicResource TypeBodyFontSize}"
                               FontWeight="{DynamicResource TypeBodyFontWeight}"
                               Foreground="{DynamicResource TextSubtleBrush}"
                               VerticalAlignment="Center"
                               Margin="32,0,28,0"
                               IsHitTestVisible="False" />

                    <TextBox x:Name="SearchBox"
                             Style="{StaticResource CleanSearchTextBoxStyle}"
                             VerticalAlignment="Center"
                             Margin="32,0,28,0"
                             TextChanged="OnSearchBoxTextChanged"
                             GotFocus="OnSearchBoxGotFocus"
                             LostFocus="OnSearchBoxLostFocus"
                             PreviewKeyDown="OnSearchBoxPreviewKeyDown" />

                    <Button x:Name="ClearSearchButton"
                            HorizontalAlignment="Right"
                            VerticalAlignment="Center"
                            Margin="0,0,5,0"
                            Style="{StaticResource MiniPinButtonStyle}"
                            Width="24"
                            Height="24"
                            Visibility="Collapsed"
                            Click="OnClearSearchClick">
                        <ui:SymbolIcon Symbol="Dismiss20" FontSize="12" Foreground="{DynamicResource TextMutedBrush}" />
                    </Button>
                </Grid>
            </Border>

            <!-- Mode 1 & 2: Staggered Content Host -->
            <Grid Grid.Row="2" x:Name="AppsContentHostGrid">

                <!-- Mode 1: Alphabetical Grouped Apps List with Unified Scrolling -->
                <ScrollViewer x:Name="GroupedViewContainer"
                              Grid.IsSharedSizeScope="True"
                              Style="{StaticResource FloatingScrollViewerStyle}"
                              controls:AutoHideScrollBehavior.IsEnabled="True"
                              Visibility="Visible"
                              VerticalScrollBarVisibility="Auto"
                              HorizontalScrollBarVisibility="Disabled"
                              Focusable="False"
                              Background="Transparent"
                              Padding="0,2,0,16">
                    <StackPanel>
                        <!-- Mode 1A: Zero-State Suggestions (Recent Apps & Files on Empty Search, Up to 15 Items) -->
                        <StackPanel x:Name="RecentSuggestionsPanel"
                                    Margin="0,0,0,10"
                                    Visibility="Collapsed">
                            <Border Margin="{StaticResource DrawerGutterSectionHeaderMargin}">
                                <TextBlock Text="Recent"
                                           FontSize="18"
                                           FontWeight="{DynamicResource TypeBodyStrongFontWeight}"
                                           FontFamily="{DynamicResource AppFontFamily}"
                                           Foreground="{DynamicResource TextSubtleBrush}" />
                            </Border>

                            <ListBox x:Name="RecentSuggestionsListBox"
                                     Background="Transparent"
                                     BorderThickness="0"
                                     Margin="{StaticResource DrawerGutterRecentGridMargin}"
                                     Padding="0"
                                     ClipToBounds="False"
                                     FocusVisualStyle="{x:Null}"
                                     ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                                     ScrollViewer.VerticalScrollBarVisibility="Disabled"
                                     ItemContainerStyle="{StaticResource FluentSearchListBoxItemStyle}"
                                     ItemTemplate="{StaticResource RecentGridTileTemplate}"
                                     ItemsPanel="{StaticResource RecentGridItemsPanelTemplate}"
                                     KeyDown="OnRecentSuggestionsKeyDown"
                                     PreviewKeyDown="OnRecentSuggestionsPreviewKeyDown"
                                     PreviewTextInput="OnRecentSuggestionsPreviewTextInput">
                                <ListBox.Template>
                                    <ControlTemplate TargetType="{x:Type ListBox}">
                                        <ItemsPresenter SnapsToDevicePixels="{TemplateBinding SnapsToDevicePixels}" />
                                    </ControlTemplate>
                                </ListBox.Template>
                            </ListBox>
                        </StackPanel>

                        <!-- Mode 1B: Alphabetical Grouped Apps -->
                        <ListBox x:Name="GroupedItemsControl"
                                 Grid.IsSharedSizeScope="True"
                                 Background="Transparent"
                                 BorderThickness="0"
                                 Padding="0"
                                 FocusVisualStyle="{x:Null}"
                                 ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                                 ScrollViewer.VerticalScrollBarVisibility="Disabled"
                                 ItemContainerStyle="{StaticResource DrawerListBoxItemStyle}">
                            <ListBox.Resources>
                                <DataTemplate DataType="{x:Type controls:DrawerGroupHeader}">
                                    <TextBlock Text="{Binding Header}"
                                               FontSize="18"
                                               FontWeight="{DynamicResource TypeBodyStrongFontWeight}"
                                               FontFamily="{DynamicResource AppFontFamily}"
                                               Foreground="{DynamicResource TextSubtleBrush}"
                                               Margin="{StaticResource DrawerGutterGroupHeaderMargin}" />
                                </DataTemplate>

                                <DataTemplate DataType="{x:Type controls:DrawerAppRow}">
                                    <Border Style="{StaticResource AppRowContainerStyle}"
                                            Tag="{Binding App}"
                                            PreviewMouseLeftButtonDown="OnAppRowPreviewMouseLeftButtonDown"
                                            PreviewMouseMove="OnAppRowPreviewMouseMove"
                                            MouseLeftButtonUp="OnAppRowMouseLeftButtonUp"
                                            ContextMenu="{StaticResource AppItemContextMenu}"
                                            ContextMenuOpening="OnAppContextMenuOpening">
                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="22" SharedSizeGroup="AppIconColumn" />
                                                <ColumnDefinition Width="*" />
                                            </Grid.ColumnDefinitions>

                                            <Image Grid.Column="0"
                                                   Source="{Binding App.Icon, TargetNullValue={x:Null}, FallbackValue={x:Null}}"
                                                   Width="20"
                                                   Height="20"
                                                   HorizontalAlignment="Center"
                                                   VerticalAlignment="Center"
                                                   RenderOptions.BitmapScalingMode="HighQuality" />

                                            <TextBlock Grid.Column="1"
                                                       Text="{Binding App.Name}"
                                                       FontSize="{DynamicResource TypeBodyFontSize}"
                                                       FontWeight="{DynamicResource TypeBodyFontWeight}"
                                                       Foreground="{DynamicResource TextPrimaryBrush}"
                                                       VerticalAlignment="Center"
                                                       Margin="8,0,8,0"
                                                       TextTrimming="CharacterEllipsis" />
                                        </Grid>
                                    </Border>
                                </DataTemplate>
                            </ListBox.Resources>
                        </ListBox>
                    </StackPanel>
                </ScrollViewer>

                <!-- Mode 2: Search Results Flat List with High-Performance Virtualization -->
                <ListBox x:Name="SearchResultsListBox"
                         Grid.IsSharedSizeScope="True"
                         VirtualizingPanel.IsVirtualizing="True"
                         VirtualizingPanel.VirtualizationMode="Recycling"
                         VirtualizingPanel.ScrollUnit="Pixel"
                         ScrollViewer.CanContentScroll="True"
                         ScrollViewer.VerticalScrollBarVisibility="Auto"
                         ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                         controls:AutoHideScrollBehavior.IsEnabled="True"
                         Visibility="Collapsed"
                         Background="Transparent"
                         BorderThickness="0"
                         Padding="0,2,0,16"
                         FocusVisualStyle="{x:Null}"
                         ItemContainerStyle="{StaticResource FluentSearchListBoxItemStyle}"
                         ItemTemplate="{StaticResource SearchItemRowTemplate}"
                         KeyDown="OnSearchResultsKeyDown"
                         PreviewKeyDown="OnSearchResultsPreviewKeyDown"
                         PreviewTextInput="OnSearchResultsPreviewTextInput">
                    <ListBox.ItemsPanel>
                        <ItemsPanelTemplate>
                            <VirtualizingStackPanel />
                        </ItemsPanelTemplate>
                    </ListBox.ItemsPanel>
                    <ListBox.Resources>
                        <Style TargetType="{x:Type ScrollViewer}" BasedOn="{StaticResource FloatingScrollViewerStyle}" />
                    </ListBox.Resources>
                    <ListBox.RenderTransform>
                        <TranslateTransform x:Name="SearchResultsTranslate" Y="0" />
                    </ListBox.RenderTransform>
                    <ListBox.Style>
                        <Style TargetType="ListBox" BasedOn="{StaticResource {x:Type ListBox}}">
                            <Style.Triggers>
                                <Trigger Property="Visibility" Value="Visible">
                                    <Trigger.EnterActions>
                                        <BeginStoryboard>
                                            <Storyboard>
                                                <DoubleAnimation Storyboard.TargetProperty="Opacity"
                                                                 From="0.0" To="1.0"
                                                                 Duration="0:0:0.12">
                                                    <DoubleAnimation.EasingFunction>
                                                        <CubicEase EasingMode="EaseOut" />
                                                    </DoubleAnimation.EasingFunction>
                                                </DoubleAnimation>
                                                <DoubleAnimation Storyboard.TargetProperty="(UIElement.RenderTransform).(TranslateTransform.Y)"
                                                                 From="8.0" To="0.0"
                                                                 Duration="0:0:0.12">
                                                    <DoubleAnimation.EasingFunction>
                                                        <CubicEase EasingMode="EaseOut" />
                                                    </DoubleAnimation.EasingFunction>
                                                </DoubleAnimation>
                                            </Storyboard>
                                        </BeginStoryboard>
                                    </Trigger.EnterActions>
                                </Trigger>
                            </Style.Triggers>
                        </Style>
                    </ListBox.Style>
                </ListBox>

                <!-- Dedicated Fluent Empty Search Placeholder Overlay -->
                <Grid x:Name="NoResultsPanel"
                      Visibility="Collapsed"
                      HorizontalAlignment="Center"
                      VerticalAlignment="Center"
                      Margin="16,0,16,0">
                    <Grid.RenderTransform>
                        <TranslateTransform Y="0" />
                    </Grid.RenderTransform>
                    <Grid.Style>
                        <Style TargetType="Grid">
                            <Style.Triggers>
                                <Trigger Property="Visibility" Value="Visible">
                                    <Trigger.EnterActions>
                                        <BeginStoryboard>
                                            <Storyboard>
                                                <DoubleAnimation Storyboard.TargetProperty="Opacity"
                                                                 From="0.0" To="1.0"
                                                                 Duration="0:0:0.15">
                                                    <DoubleAnimation.EasingFunction>
                                                        <CubicEase EasingMode="EaseOut" />
                                                    </DoubleAnimation.EasingFunction>
                                                </DoubleAnimation>
                                                <DoubleAnimation Storyboard.TargetProperty="(UIElement.RenderTransform).(TranslateTransform.Y)"
                                                                 From="6.0" To="0.0"
                                                                 Duration="0:0:0.15">
                                                    <DoubleAnimation.EasingFunction>
                                                        <CubicEase EasingMode="EaseOut" />
                                                    </DoubleAnimation.EasingFunction>
                                                </DoubleAnimation>
                                            </Storyboard>
                                        </BeginStoryboard>
                                    </Trigger.EnterActions>
                                </Trigger>
                            </Style.Triggers>
                        </Style>
                    </Grid.Style>
                    <StackPanel HorizontalAlignment="Center">
                        <!-- Ambient Icon Badge with SearchInfo24 -->
                        <Border Width="52"
                                Height="52"
                                CornerRadius="26"
                                HorizontalAlignment="Center"
                                Background="{DynamicResource WidgetDividerBrush}"
                                BorderBrush="{DynamicResource WidgetBorderBrush}"
                                BorderThickness="1">
                            <ui:SymbolIcon Symbol="SearchInfo24"
                                           FontSize="22"
                                           Foreground="{DynamicResource TextSubtleBrush}"
                                           HorizontalAlignment="Center"
                                           VerticalAlignment="Center" />
                        </Border>

                        <!-- Title: 16px SemiBold -->
                        <TextBlock Text="No results found"
                                   FontSize="{DynamicResource TypeHeaderFontSize}"
                                   FontWeight="{DynamicResource TypeHeaderFontWeight}"
                                   FontFamily="{DynamicResource AppFontFamily}"
                                   Foreground="{DynamicResource TextPrimaryBrush}"
                                   HorizontalAlignment="Center"
                                   Margin="0,14,0,6" />

                        <!-- Query-aware Detail / Hint: 14px Regular -->
                        <TextBlock x:Name="NoResultsDetailTextBlock"
                                   Text="Check your spelling or try another search term."
                                   FontSize="{DynamicResource TypeBodyFontSize}"
                                   FontWeight="{DynamicResource TypeBodyFontWeight}"
                                   FontFamily="{DynamicResource AppFontFamily}"
                                   Foreground="{DynamicResource TextSubtleBrush}"
                                   TextWrapping="Wrap"
                                   TextAlignment="Center"
                                   HorizontalAlignment="Center"
                                   MaxWidth="250"
                                   LineHeight="18" />
                    </StackPanel>
                </Grid>
            </Grid>
        </Grid>
    </Border>
    </Grid>
</UserControl>
