<UserControl x:Class="MetroHub.Presentation.Controls.AllAppsDrawerControl"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
             xmlns:controls="clr-namespace:MetroHub.Presentation.Controls"
             mc:Ignorable="d" 
             Width="320"
             HorizontalAlignment="Left"
             VerticalAlignment="Stretch"
             Focusable="False"
             ClipToBounds="False"
             Visibility="Collapsed"
             Background="Transparent"
             TextOptions.TextFormattingMode="Display"
             TextOptions.TextRenderingMode="ClearType"
             UseLayoutRounding="True"
>

    <UserControl.RenderTransform>
        <TranslateTransform x:Name="DrawerTranslate" X="0" />
    </UserControl.RenderTransform>

    <UserControl.Resources>
        <!-- Custom Clean TextBox Style: Zero WPF-UI chrome, no borders, no bottom accent line -->
        <Style x:Key="CleanSearchTextBoxStyle" TargetType="{x:Type TextBox}">
            <Setter Property="OverridesDefaultStyle" Value="True" />
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="Foreground" Value="{DynamicResource TextPrimaryBrush}" />
            <Setter Property="CaretBrush" Value="{DynamicResource TextPrimaryBrush}" />
            <Setter Property="FontFamily" Value="{DynamicResource AppFontFamily}" />
            <Setter Property="FontSize" Value="{DynamicResource TypeBodyFontSize}" />
            <Setter Property="FontWeight" Value="{DynamicResource TypeBodyFontWeight}" />
            <Setter Property="VerticalContentAlignment" Value="Center" />
            <Setter Property="Padding" Value="0" />
            <Setter Property="Margin" Value="0" />
            <Setter Property="FocusVisualStyle" Value="{x:Null}" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="{x:Type TextBox}">
                        <ScrollViewer x:Name="PART_ContentHost"
                                      Focusable="False"
                                      HorizontalScrollBarVisibility="Hidden"
                                      VerticalScrollBarVisibility="Hidden"
                                      VerticalAlignment="Center"
                                      Padding="0"
                                      Margin="0" />
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Modern Fluent App Item Style: Matches Sidebar Hover Pill -->
        <Style x:Key="AppRowContainerStyle" TargetType="Border">
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="BorderBrush" Value="Transparent" />
            <Setter Property="CornerRadius" Value="{DynamicResource ControlCornerRadius}" />
            <Setter Property="Margin" Value="12,1,12,1" />
            <Setter Property="Padding" Value="8,5" />
            <Setter Property="SnapsToDevicePixels" Value="True" />
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Background" Value="{DynamicResource FluentHoverBrush}" />
                </Trigger>
            </Style.Triggers>
        </Style>

        <!-- Modern Fluent Search Result Item Style: Zero Padding, Completely Transparent Container -->
        <Style x:Key="FluentSearchListBoxItemStyle" TargetType="{x:Type ListBoxItem}">
            <Setter Property="FocusVisualStyle" Value="{x:Null}" />
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="BorderBrush" Value="Transparent" />
            <Setter Property="Margin" Value="0" />
            <Setter Property="Padding" Value="0" />
            <Setter Property="HorizontalContentAlignment" Value="Stretch" />
            <Setter Property="VerticalContentAlignment" Value="Stretch" />
            <Setter Property="SnapsToDevicePixels" Value="True" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="{x:Type ListBoxItem}">
                        <ContentPresenter SnapsToDevicePixels="True" />
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Modern Mini Pin Button Style: Inherits Universal WidgetMicroButtonStyle -->
        <Style x:Key="MiniPinButtonStyle" TargetType="Button" BasedOn="{StaticResource WidgetMicroButtonStyle}" />

        <!-- Comprehensive Fluent App Context Menu: Open -> Run as Admin -> Pin/Unpin -> Separator -> Uninstall -->
        <ContextMenu x:Key="AppItemContextMenu"
                     Opened="OnAppContextMenuOpened"
                     PreviewKeyDown="OnAppContextMenuPreviewKeyDown">
            <MenuItem Header="Open" Click="OnContextMenuOpenClick">
                <MenuItem.Icon>
                    <ui:SymbolIcon Symbol="ArrowRight24" FontSize="18" />
                </MenuItem.Icon>
            </MenuItem>
            <MenuItem Header="Run as administrator" Click="OnContextMenuRunAsAdminClick">
                <MenuItem.Icon>
                    <ui:SymbolIcon Symbol="Shield32" FontSize="18" Foreground="{DynamicResource TextSecondaryBrush}" />
                </MenuItem.Icon>
            </MenuItem>
            <MenuItem x:Name="PinMenuItem" Header="Pin to Start" Click="OnContextMenuPinToggleClick">
                <MenuItem.Icon>
                    <ui:SymbolIcon Symbol="Pin24" FontSize="18" />
                </MenuItem.Icon>
            </MenuItem>
            <Separator />
            <MenuItem Header="Uninstall" Click="OnContextMenuUninstallClick" Foreground="{DynamicResource StatusErrorBrush}">
                <MenuItem.Icon>
                    <ui:SymbolIcon Symbol="Delete24" FontSize="18" Foreground="{DynamicResource StatusErrorBrush}" />
                </MenuItem.Icon>
            </MenuItem>
        </ContextMenu>

        <!-- Modern File/Folder Context Menu for Universal Search Results -->
        <ContextMenu x:Key="FileItemContextMenu" PreviewKeyDown="OnAppContextMenuPreviewKeyDown">
            <MenuItem Header="Open" Click="OnFileContextMenuOpenClick">
                <MenuItem.Icon>
                    <ui:SymbolIcon Symbol="ArrowRight24" FontSize="18" />
                </MenuItem.Icon>
            </MenuItem>
            <MenuItem Header="Open file location" Click="OnFileContextMenuOpenLocationClick">
                <MenuItem.Icon>
                    <ui:SymbolIcon Symbol="FolderOpen24" FontSize="18" />
                </MenuItem.Icon>
            </MenuItem>
            <Separator />
            <MenuItem Header="Copy path" Click="OnFileContextMenuCopyPathClick">
                <MenuItem.Icon>
                    <ui:SymbolIcon Symbol="Copy24" FontSize="18" />
                </MenuItem.Icon>
            </MenuItem>
        </ContextMenu>

        <!-- Shared Search and Recent Suggestion Item Row Template -->
        <DataTemplate x:Key="SearchItemRowTemplate">
            <StackPanel Margin="0">
                <!-- Category Section Header: completely outside the row card with generous typography -->
                <Border Visibility="{Binding CategoryHeaderVisibility}"
                        Margin="12,14,12,6"
                        Padding="0"
                        Focusable="False"
                        Background="Transparent"
                        PreviewMouseLeftButtonDown="OnCategoryHeaderPreviewMouseDown">
                    <TextBlock Text="{Binding CategoryHeader}"
                               FontSize="14"
                               FontWeight="SemiBold"
                               FontFamily="{DynamicResource AppDisplayFontFamily}"
                               Foreground="{DynamicResource TextSubtleBrush}" />
                </Border>

                <!-- Search Result Item Row Card: isolated selection highlight, hover effect, and accent pill -->
                <Border x:Name="RowCard"
                        Margin="12,1,12,1"
                        Padding="8,5"
                        CornerRadius="{DynamicResource ControlCornerRadius}"
                        Background="Transparent"
                        SnapsToDevicePixels="True"
                        ToolTip="{Binding FullPath}"
                        Tag="{Binding}"
                        PreviewMouseLeftButtonDown="OnSearchRowPreviewMouseLeftButtonDown"
                        PreviewMouseMove="OnSearchRowPreviewMouseMove"
                        MouseLeftButtonUp="OnSearchRowMouseLeftButtonUp"
                        ContextMenuOpening="OnSearchRowContextMenuOpening">
                    <Grid>
                        <!-- Selection Accent Pill: strictly aligned to the row card -->
                        <Rectangle x:Name="AccentPill"
                                   Width="3"
                                   Height="16"
                                   HorizontalAlignment="Left"
                                   VerticalAlignment="Center"
                                   RadiusX="1.5"
                                   RadiusY="1.5"
                                   Fill="{DynamicResource SystemAccentColorPrimaryBrush}"
                                   Visibility="Collapsed"
                                   Margin="-6,0,0,0" />

                        <!-- Search Result Item Content -->
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="28" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>

                            <!-- Left Icon or Category Symbol -->
                            <Grid Grid.Column="0" Width="24" Height="24" HorizontalAlignment="Center" VerticalAlignment="Center">
                                <Image Source="{Binding Icon, TargetNullValue={x:Null}, FallbackValue={x:Null}}"
                                       Width="22"
                                       Height="22"
                                       HorizontalAlignment="Center"
                                       VerticalAlignment="Center"
                                       Visibility="{Binding CustomIconVisibility}"
                                       RenderOptions.BitmapScalingMode="HighQuality" />

                                <ui:SymbolIcon Symbol="{Binding Symbol}"
                                               FontSize="16"
                                               Foreground="{DynamicResource TextSecondaryBrush}"
                                               HorizontalAlignment="Center"
                                               VerticalAlignment="Center"
                                               Visibility="{Binding SymbolVisibility}" />
                            </Grid>

                            <!-- Display Name and Subtitle (Path/Details) -->
                            <StackPanel Grid.Column="1" VerticalAlignment="Center" Margin="8,0,8,0">
                                <TextBlock Text="{Binding DisplayName}"
                                           FontSize="{DynamicResource TypeBodyFontSize}"
                                           FontWeight="{DynamicResource TypeBodyFontWeight}"
                                           Foreground="{DynamicResource TextPrimaryBrush}"
                                           TextTrimming="CharacterEllipsis" />

                                <TextBlock Text="{Binding Subtitle}"
                                           FontSize="12"
                                           Foreground="{DynamicResource TextMutedBrush}"
                                           Opacity="0.6"
                                           TextWrapping="WrapWithOverflow"
                                           TextTrimming="CharacterEllipsis"
                                           MaxHeight="36"
                                           Margin="0,2,0,0"
                                           Visibility="{Binding SubtitleVisibility}" />
                            </StackPanel>
                        </Grid>
                    </Grid>
                </Border>
            </StackPanel>
            <DataTemplate.Triggers>
                <DataTrigger Binding="{Binding ElementName=RowCard, Path=IsMouseOver}" Value="True">
                    <Setter TargetName="RowCard" Property="Background" Value="{DynamicResource FluentHoverBrush}" />
                </DataTrigger>
                <DataTrigger Binding="{Binding RelativeSource={RelativeSource AncestorType=ListBoxItem}, Path=IsSelected}" Value="True">
                    <Setter TargetName="RowCard" Property="Background" Value="{DynamicResource FluentPressedBrush}" />
                    <Setter TargetName="AccentPill" Property="Visibility" Value="Visible" />
                </DataTrigger>
                <DataTrigger Binding="{Binding RelativeSource={RelativeSource AncestorType=ListBoxItem}, Path=IsKeyboardFocused}" Value="True">
                    <Setter TargetName="RowCard" Property="Background" Value="{DynamicResource FluentPressedBrush}" />
                    <Setter TargetName="AccentPill" Property="Visibility" Value="Visible" />
                </DataTrigger>
                <MultiDataTrigger>
                    <MultiDataTrigger.Conditions>
                        <Condition Binding="{Binding RelativeSource={RelativeSource AncestorType=ListBoxItem}, Path=IsSelected}" Value="True" />
                        <Condition Binding="{Binding ElementName=RowCard, Path=IsMouseOver}" Value="True" />
                    </MultiDataTrigger.Conditions>
                    <Setter TargetName="RowCard" Property="Background" Value="#25FFFFFF" />
                </MultiDataTrigger>
            </DataTemplate.Triggers>
        </DataTemplate>
    </UserControl.Resources>

    <Grid>
        <!-- Right Edge Soft Drop Shadow: Casts strictly to the right onto canvas tiles, zero shader effect, zero black backbuffer, zero left shadow -->
        <Border Width="24"
                HorizontalAlignment="Right"
                Margin="0,0,-24,0"
                IsHitTestVisible="False">
            <Border.Background>
                <LinearGradientBrush StartPoint="0,0" EndPoint="1,0">
                    <GradientStop Color="#45000000" Offset="0" />
                    <GradientStop Color="#20000000" Offset="0.35" />
                    <GradientStop Color="#0A000000" Offset="0.75" />
                    <GradientStop Color="#00000000" Offset="1" />
                </LinearGradientBrush>
            </Border.Background>
        </Border>

        <!-- Main Drawer Container: NO BORDER, Transparent Background allowing Main Window's Acrylic Obsidian to shine through -->
        <Border x:Name="DrawerContainer"
                Background="Transparent"
                BorderThickness="0"
                >

        <Grid>
            <Grid.RowDefinitions>
                <!-- Header / Title -->
                <RowDefinition Height="Auto" />
                <!-- Search Bar -->
                <RowDefinition Height="Auto" />
                <!-- Apps Content (Alphabetical Groups or Search Results) -->
                <RowDefinition Height="*" />
            </Grid.RowDefinitions>

            <Grid x:Name="DrawerHeaderGrid" Grid.Row="0" Margin="12,14,12,6">
                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                    <ui:SymbolIcon Symbol="AppsListDetail24" FontSize="18" Foreground="{DynamicResource TextPrimaryBrush}" Margin="0,0,8,0" VerticalAlignment="Center" />
                    <TextBlock Text="All apps"
                               FontSize="{DynamicResource TypeHeaderFontSize}"
                               FontWeight="{DynamicResource TypeHeaderFontWeight}"
                               FontFamily="{DynamicResource AppFontFamily}"
                               Foreground="{DynamicResource TextPrimaryBrush}"
                               VerticalAlignment="Center" />
                </StackPanel>
                
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                    <Button x:Name="RefreshButton"
                            Style="{StaticResource MiniPinButtonStyle}"
                            ToolTip="Refresh installed apps"
                            Margin="0,0,4,0"
                            Click="OnRefreshClick">
                        <ui:SymbolIcon x:Name="RefreshIcon"
                                       Symbol="ArrowClockwise24"
                                       FontSize="14"
                                       Foreground="{DynamicResource TextMutedBrush}"
                                       RenderTransformOrigin="0.5,0.5">
                            <ui:SymbolIcon.RenderTransform>
                                <RotateTransform x:Name="RefreshIconRotation" Angle="0" />
                            </ui:SymbolIcon.RenderTransform>
                        </ui:SymbolIcon>
                    </Button>
                    <Button x:Name="CloseButton"
                            Style="{StaticResource MiniPinButtonStyle}"
                            ToolTip="Close"
                            Click="OnCloseClick">
                        <ui:SymbolIcon Symbol="Dismiss20" FontSize="14" Foreground="{DynamicResource TextMutedBrush}" />
                    </Button>
                </StackPanel>
            </Grid>

            <Border Grid.Row="1"
                    x:Name="SearchBorder"
                    Margin="12,4,12,12"
                    Height="34"
                    CornerRadius="{DynamicResource ControlCornerRadius}"
                    Background="{DynamicResource WidgetDividerBrush}"
                    BorderThickness="0"
                    >
                <Grid>
                    <ui:SymbolIcon Symbol="Search24"
                                   FontSize="15"
                                   Foreground="{DynamicResource TextSubtleBrush}"
                                   HorizontalAlignment="Left"
                                   VerticalAlignment="Center"
                                   Margin="10,0,0,0"
                                   IsHitTestVisible="False" />

                    <TextBlock x:Name="SearchPlaceholder"
                               Text="Type here to search..."
                               FontSize="{DynamicResource TypeBodyFontSize}"
                               FontWeight="{DynamicResource TypeBodyFontWeight}"
                               Foreground="{DynamicResource TextSubtleBrush}"
                               VerticalAlignment="Center"
                               Margin="32,0,28,0"
                               IsHitTestVisible="False" />

                    <TextBox x:Name="SearchBox"
                             Style="{StaticResource CleanSearchTextBoxStyle}"
                             VerticalAlignment="Center"
                             Margin="32,0,28,0"
                             TextChanged="OnSearchBoxTextChanged"
                             GotFocus="OnSearchBoxGotFocus"
                             LostFocus="OnSearchBoxLostFocus"
                             PreviewKeyDown="OnSearchBoxPreviewKeyDown" />

                    <Button x:Name="ClearSearchButton"
                            HorizontalAlignment="Right"
                            VerticalAlignment="Center"
                            Margin="0,0,5,0"
                            Style="{StaticResource MiniPinButtonStyle}"
                            Width="24"
                            Height="24"
                            Visibility="Collapsed"
                            Click="OnClearSearchClick">
                        <ui:SymbolIcon Symbol="Dismiss20" FontSize="12" Foreground="{DynamicResource TextMutedBrush}" />
                    </Button>
                </Grid>
            </Border>

            <!-- Mode 1 & 2: Staggered Content Host -->
            <Grid Grid.Row="2" x:Name="AppsContentHostGrid">

                <!-- Mode 1: Alphabetical Grouped Apps List with Breathing Room -->
                <ScrollViewer x:Name="GroupedScrollViewer"
                              controls:AutoHideScrollBehavior.IsEnabled="True"
                              VerticalScrollBarVisibility="Auto"
                              HorizontalScrollBarVisibility="Disabled"
                              Focusable="False"
                              Background="Transparent"
                              Padding="0,2,14,16">
                    <StackPanel>
                        <!-- Mode 1A: Zero-State Suggestions (Recent Apps & Files on Empty Search, Up to 15 Items) -->
                        <StackPanel x:Name="RecentSuggestionsPanel"
                                    Margin="0,0,0,10"
                                    Visibility="Collapsed">
                            <Border Margin="23,8,0,4">
                                <TextBlock Text="Recent"
                                           FontSize="18"
                                           FontWeight="{DynamicResource TypeBodyStrongFontWeight}"
                                           FontFamily="{DynamicResource AppFontFamily}"
                                           Foreground="{DynamicResource TextSubtleBrush}" />
                            </Border>

                            <ListBox x:Name="RecentSuggestionsListBox"
                                     Background="Transparent"
                                     BorderThickness="0"
                                     Padding="0"
                                     FocusVisualStyle="{x:Null}"
                                     ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                                     ScrollViewer.VerticalScrollBarVisibility="Disabled"
                                     ItemContainerStyle="{StaticResource FluentSearchListBoxItemStyle}"
                                     ItemTemplate="{StaticResource SearchItemRowTemplate}"
                                     KeyDown="OnRecentSuggestionsKeyDown"
                                     PreviewKeyDown="OnRecentSuggestionsPreviewKeyDown"
                                     PreviewTextInput="OnRecentSuggestionsPreviewTextInput" />
                        </StackPanel>

                        <!-- Mode 1B: Alphabetical Grouped Apps -->
                        <ItemsControl x:Name="GroupedItemsControl">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <StackPanel Margin="0,0,0,6">
                                        <!-- Group Letter Header: Left-Aligned Directly to App Icon Edge (X = 23px) -->
                                        <TextBlock Text="{Binding Header}"
                                                   FontSize="18"
                                                   FontWeight="{DynamicResource TypeBodyStrongFontWeight}"
                                                   FontFamily="{DynamicResource AppFontFamily}"
                                                   Foreground="{DynamicResource TextSubtleBrush}"
                                                   Margin="23,12,0,4" />

                                        <!-- Apps in this letter group -->
                                        <ItemsControl ItemsSource="{Binding Items}">
                                            <ItemsControl.ItemTemplate>
                                                <DataTemplate>
                                                    <Border Style="{StaticResource AppRowContainerStyle}"
                                                            Tag="{Binding}"
                                                            PreviewMouseLeftButtonDown="OnAppRowPreviewMouseLeftButtonDown"
                                                            PreviewMouseMove="OnAppRowPreviewMouseMove"
                                                            MouseLeftButtonUp="OnAppRowMouseLeftButtonUp"
                                                            ContextMenu="{StaticResource AppItemContextMenu}"
                                                            ContextMenuOpening="OnAppContextMenuOpening">
                                                        <Grid>
                                                            <Grid.ColumnDefinitions>
                                                                <ColumnDefinition Width="28" />
                                                                <ColumnDefinition Width="*" />
                                                            </Grid.ColumnDefinitions>

                                                            <Image Grid.Column="0"
                                                                   Source="{Binding Icon, TargetNullValue={x:Null}, FallbackValue={x:Null}}"
                                                                   Width="22"
                                                                   Height="22"
                                                                   HorizontalAlignment="Center"
                                                                   VerticalAlignment="Center"
                                                                   RenderOptions.BitmapScalingMode="HighQuality" />

                                                            <TextBlock Grid.Column="1"
                                                                       Text="{Binding Name}"
                                                                       FontSize="{DynamicResource TypeBodyFontSize}"
                                                                       FontWeight="{DynamicResource TypeBodyFontWeight}"
                                                                       Foreground="{DynamicResource TextPrimaryBrush}"
                                                                       VerticalAlignment="Center"
                                                                       Margin="8,0,8,0"
                                                                       TextTrimming="CharacterEllipsis" />
                                                        </Grid>
                                                    </Border>
                                                </DataTemplate>
                                            </ItemsControl.ItemTemplate>
                                        </ItemsControl>
                                    </StackPanel>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </StackPanel>
                </ScrollViewer>

                <!-- Mode 2: Search Results Flat List with Breathing Room -->
                <ScrollViewer x:Name="SearchResultsScrollViewer"
                              controls:AutoHideScrollBehavior.IsEnabled="True"
                              Visibility="Collapsed"
                              VerticalScrollBarVisibility="Auto"
                              HorizontalScrollBarVisibility="Disabled"
                              Focusable="False"
                              Background="Transparent"
                              Padding="0,2,14,16">
                    <StackPanel>
                        <TextBlock x:Name="NoResultsTextBlock"
                                   Text="No apps found"
                                   FontSize="{DynamicResource TypeBodyFontSize}"
                                   FontWeight="{DynamicResource TypeBodyFontWeight}"
                                   Foreground="{DynamicResource TextSubtleBrush}"
                                   HorizontalAlignment="Center"
                                   Margin="0,32,0,0"
                                   Visibility="Collapsed" />

                        <ListBox x:Name="SearchResultsListBox"
                                 Background="Transparent"
                                 BorderThickness="0"
                                 Padding="0"
                                 FocusVisualStyle="{x:Null}"
                                 ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                                 ScrollViewer.VerticalScrollBarVisibility="Disabled"
                                 ItemContainerStyle="{StaticResource FluentSearchListBoxItemStyle}"
                                 ItemTemplate="{StaticResource SearchItemRowTemplate}"
                                 KeyDown="OnSearchResultsKeyDown"
                                 PreviewKeyDown="OnSearchResultsPreviewKeyDown"
                                 PreviewTextInput="OnSearchResultsPreviewTextInput" />
                    </StackPanel>
                </ScrollViewer>
            </Grid>
        </Grid>
    </Border>
    </Grid>
</UserControl>
