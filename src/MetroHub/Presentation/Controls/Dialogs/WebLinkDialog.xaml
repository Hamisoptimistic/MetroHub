<ui:FluentWindow x:Class="MetroHub.Presentation.Controls.WebLinkDialog"
                   xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                   xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                   xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
                   WindowBackdropType="Acrylic"
                   WindowCornerPreference="DoNotRound"
                   ExtendsContentIntoTitleBar="True"
                   WindowStyle="None"
                   ResizeMode="NoResize"
                   ShowInTaskbar="False"
                   WindowStartupLocation="CenterOwner"
                   Width="620"
                   Height="360"
                   Background="Transparent"
                   Foreground="{DynamicResource TextPrimaryBrush}"
                   FontFamily="{DynamicResource AppFontFamily}"
                   RenderOptions.ClearTypeHint="Enabled"
                   TextOptions.TextFormattingMode="Ideal"
                   TextOptions.TextRenderingMode="ClearType"
                   TextOptions.TextHintingMode="Auto"
                   SnapsToDevicePixels="True"
                   UseLayoutRounding="True">



    <!-- Borderless Window Wrapper -->
    <Border Background="Transparent"
            BorderThickness="0"
            CornerRadius="{DynamicResource ControlCornerRadius}"
            >
        <Grid RenderOptions.ClearTypeHint="Enabled">
            <Grid.ColumnDefinitions>
                <!-- COLUMN 0: FROSTED ACRYLIC SIDEBAR -->
                <ColumnDefinition Width="155" />
                <!-- COLUMN 1: OBSIDIAN DARK CONTENT PANEL -->
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>

            <!-- ========================================================= -->
            <!-- COLUMN 0: FROSTED ACRYLIC SIDEBAR                        -->
            <!-- ========================================================= -->
            <Grid Grid.Column="0"
                  Background="Transparent">

                <!-- Vertically and Horizontally Centered Glyph Container -->
                <Grid HorizontalAlignment="Center" VerticalAlignment="Center">
                    <Grid>
                        <Image x:Name="WebLinkFaviconImage"
                               Width="42" Height="42"
                               HorizontalAlignment="Center"
                               VerticalAlignment="Center"
                               Visibility="Collapsed"
                               RenderOptions.BitmapScalingMode="HighQuality" />

                        <Image x:Name="WebLinkFallbackIcon"
                               Source="/Assets/link.png"
                               Width="72"
                               Height="72"
                               Stretch="Uniform"
                               HorizontalAlignment="Center"
                               VerticalAlignment="Center"
                               RenderOptions.BitmapScalingMode="HighQuality" />

                        <ui:ProgressRing x:Name="WebLinkSidebarSpinner"
                                         Width="24" Height="24"
                                         IsIndeterminate="True"
                                         HorizontalAlignment="Center"
                                         VerticalAlignment="Center"
                                         Visibility="Collapsed" />
                    </Grid>
                </Grid>
            </Grid>

            <!-- Content Panel -->
            <Border Grid.Column="1"
                    Background="{DynamicResource DialogPanelBackground}"
                    CornerRadius="0,2,2,0"
                    RenderOptions.ClearTypeHint="Enabled">
                <Grid Margin="24,20,24,20">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>

                    <!-- Header -->
                    <Grid Grid.Row="0" Margin="0,0,0,18">
                        <TextBlock Text="Add Web Shortcut"
                                   FontSize="{DynamicResource TypeHeaderFontSize}"
                                   FontWeight="{DynamicResource TypeHeaderFontWeight}"
                                   Foreground="{DynamicResource TextPrimaryBrush}"
                                   VerticalAlignment="Center" />

                        <Button HorizontalAlignment="Right"
                                Style="{DynamicResource ModalDismissButtonStyle}"
                                Click="OnCloseButtonClick" />
                    </Grid>

                    <!-- Body -->
                    <Grid Grid.Row="1">
                        <StackPanel>
                            <TextBlock Text="Website URL"
                                       FontSize="{DynamicResource TypeCaptionFontSize}"
                                       FontWeight="{DynamicResource TypeCaptionFontWeight}"
                                       Foreground="{DynamicResource TextMutedBrush}"
                                       Margin="0,0,0,6" />

                            <Grid>
                                <TextBox x:Name="WebLinkUrlInput"
                                         Style="{DynamicResource FluentGlassUrlWithPasteInputStyle}"
                                         KeyDown="OnWebLinkInputKeyDown"
                                         TextChanged="OnWebLinkUrlTextChanged" />

                                <Button HorizontalAlignment="Right"
                                        VerticalAlignment="Center"
                                        Style="{DynamicResource FluentCohesiveSecondaryButtonStyle}"
                                        Height="26"
                                        Margin="0,0,5,0"
                                        Padding="8,2"
                                        Click="OnWebLinkPasteClick">
                                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                        <ui:SymbolIcon Symbol="ClipboardPaste24" FontSize="12" Margin="0,0,5,0" VerticalAlignment="Center" />
                                        <TextBlock Text="Paste"
                                                   FontSize="{DynamicResource TypeCaptionFontSize}"
                                                   FontWeight="{DynamicResource TypeCaptionFontWeight}"
                                                   VerticalAlignment="Center" />
                                    </StackPanel>
                                </Button>
                            </Grid>

                            <TextBlock Text="Shortcut Label (Optional)"
                                       FontSize="{DynamicResource TypeCaptionFontSize}"
                                       FontWeight="{DynamicResource TypeCaptionFontWeight}"
                                       Foreground="{DynamicResource TextMutedBrush}"
                                       Margin="0,14,0,6" />
                            <TextBox x:Name="WebLinkTitleInput"
                                     Style="{DynamicResource FluentGlassInputStyle}"
                                     KeyDown="OnWebLinkInputKeyDown"
                                     TextChanged="OnWebLinkTitleTextChanged" />

                            <StackPanel Orientation="Horizontal" Margin="0,18,0,0">
                                <RadioButton x:Name="WebLinkDestBothRadio"
                                             Style="{DynamicResource FluentGlassRadioButtonStyle}"
                                             GroupName="ShortcutDest"
                                             IsChecked="True"
                                             Margin="0,0,18,0">
                                    <TextBlock Text="Both canvas &amp; sidebar"
                                               FontSize="{DynamicResource TypeCaptionFontSize}"
                                               FontWeight="{DynamicResource TypeCaptionFontWeight}"
                                               Foreground="{DynamicResource TextMutedBrush}"
                                               VerticalAlignment="Center" />
                                </RadioButton>
                                <RadioButton x:Name="WebLinkDestCanvasRadio"
                                             Style="{DynamicResource FluentGlassRadioButtonStyle}"
                                             GroupName="ShortcutDest"
                                             Margin="0,0,18,0">
                                    <TextBlock Text="Canvas only"
                                               FontSize="{DynamicResource TypeCaptionFontSize}"
                                               FontWeight="{DynamicResource TypeCaptionFontWeight}"
                                               Foreground="{DynamicResource TextMutedBrush}"
                                               VerticalAlignment="Center" />
                                </RadioButton>
                                <RadioButton x:Name="WebLinkDestSidebarRadio"
                                             Style="{DynamicResource FluentGlassRadioButtonStyle}"
                                             GroupName="ShortcutDest">
                                    <TextBlock Text="Sidebar only"
                                               FontSize="{DynamicResource TypeCaptionFontSize}"
                                               FontWeight="{DynamicResource TypeCaptionFontWeight}"
                                               Foreground="{DynamicResource TextMutedBrush}"
                                               VerticalAlignment="Center" />
                                </RadioButton>
                            </StackPanel>

                            <TextBlock x:Name="WebLinkStatusMessage"
                                       FontSize="{DynamicResource TypeCaptionFontSize}"
                                       FontWeight="{DynamicResource TypeCaptionFontWeight}"
                                       Foreground="{DynamicResource StatusErrorBrush}"
                                       Margin="0,8,0,0"
                                       TextWrapping="Wrap"
                                       Visibility="Collapsed" />
                        </StackPanel>
                    </Grid>

                    <!-- Footer -->
                    <Grid Grid.Row="2" Margin="0,16,0,0">
                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                            <Button Content="Add Shortcut"
                                     Style="{DynamicResource FluentCohesivePrimaryButtonStyle}"
                                     Margin="0,0,8,0"
                                     Click="OnAddWebLinkClick" />
                            <Button Content="Cancel"
                                     Style="{DynamicResource FluentCohesiveSecondaryButtonStyle}"
                                     Click="OnCloseButtonClick" />
                        </StackPanel>
                    </Grid>
                </Grid>
            </Border>
        </Grid>
    </Border>
</ui:FluentWindow>
