<UserControl x:Class="MetroHub.Presentation.Controls.AllAppsDrawerControl"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
             mc:Ignorable="d" 
             Width="320"
             HorizontalAlignment="Left"
             VerticalAlignment="Stretch"
             Focusable="False"
             ClipToBounds="False"
             Background="Transparent">

    <UserControl.RenderTransform>
        <TranslateTransform x:Name="DrawerTranslate" X="-320" />
    </UserControl.RenderTransform>

    <UserControl.Resources>
        <!-- Custom Clean TextBox Style: Zero WPF-UI chrome, no borders, no bottom accent line -->
        <Style x:Key="CleanSearchTextBoxStyle" TargetType="{x:Type TextBox}">
            <Setter Property="OverridesDefaultStyle" Value="True" />
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="Foreground" Value="#FFFFFF" />
            <Setter Property="CaretBrush" Value="#60CDFF" />
            <Setter Property="FontSize" Value="13" />
            <Setter Property="FontFamily" Value="Segoe UI Variable Text, Segoe UI Variable, Segoe UI, sans-serif" />
            <Setter Property="VerticalContentAlignment" Value="Center" />
            <Setter Property="Padding" Value="0" />
            <Setter Property="Margin" Value="0" />
            <Setter Property="FocusVisualStyle" Value="{x:Null}" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="{x:Type TextBox}">
                        <ScrollViewer x:Name="PART_ContentHost"
                                      Focusable="False"
                                      HorizontalScrollBarVisibility="Hidden"
                                      VerticalScrollBarVisibility="Hidden"
                                      VerticalAlignment="Center"
                                      Padding="0"
                                      Margin="0" />
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Modern Fluent App Item Style: CornerRadius="2" matching Tiles -->
        <Style x:Key="AppRowContainerStyle" TargetType="Border">
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="CornerRadius" Value="2" />
            <Setter Property="Margin" Value="8,1,8,1" />
            <Setter Property="Padding" Value="8,5" />
            <Setter Property="Cursor" Value="Hand" />
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Background" Value="#18FFFFFF" />
                </Trigger>
            </Style.Triggers>
        </Style>

        <!-- Modern Mini Pin Button Style: CornerRadius="2" matching Tiles -->
        <Style x:Key="MiniPinButtonStyle" TargetType="Button">
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="Width" Value="28" />
            <Setter Property="Height" Value="28" />
            <Setter Property="Padding" Value="0" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="FocusVisualStyle" Value="{x:Null}" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Bdr"
                                Background="Transparent"
                                CornerRadius="2">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bdr" Property="Background" Value="#25FFFFFF" />
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="Bdr" Property="Background" Value="#35FFFFFF" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Minimalist Fluent ScrollBar & ScrollViewer: No ugly grey box, transparent track -->
        <Style x:Key="FluentScrollThumbStyle" TargetType="{x:Type Thumb}">
            <Setter Property="OverridesDefaultStyle" Value="True" />
            <Setter Property="IsTabStop" Value="False" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="{x:Type Thumb}">
                        <Border x:Name="ThumbBorder"
                                Background="#35FFFFFF"
                                CornerRadius="2"
                                Margin="0,2,2,2"
                                SnapsToDevicePixels="True" />
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="ThumbBorder" Property="Background" Value="#75FFFFFF" />
                            </Trigger>
                            <Trigger Property="IsDragging" Value="True">
                                <Setter TargetName="ThumbBorder" Property="Background" Value="#A0FFFFFF" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="MinimalScrollBarStyle" TargetType="{x:Type ScrollBar}">
            <Setter Property="OverridesDefaultStyle" Value="True" />
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="Width" Value="6" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="{x:Type ScrollBar}">
                        <Track x:Name="PART_Track" IsDirectionReversed="True">
                            <Track.Thumb>
                                <Thumb Style="{StaticResource FluentScrollThumbStyle}" />
                            </Track.Thumb>
                        </Track>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="MinimalScrollViewerStyle" TargetType="{x:Type ScrollViewer}">
            <Setter Property="OverridesDefaultStyle" Value="True" />
            <Setter Property="HorizontalScrollBarVisibility" Value="Disabled" />
            <Setter Property="VerticalScrollBarVisibility" Value="Auto" />
            <Setter Property="CanContentScroll" Value="True" />
            <Setter Property="Padding" Value="0" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="{x:Type ScrollViewer}">
                        <Grid Background="Transparent">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <ScrollContentPresenter Grid.ColumnSpan="2" />
                            <ScrollBar x:Name="PART_VerticalScrollBar"
                                       Grid.Column="1"
                                       Orientation="Vertical"
                                       Style="{StaticResource MinimalScrollBarStyle}"
                                       Value="{TemplateBinding VerticalOffset}"
                                       Maximum="{TemplateBinding ScrollableHeight}"
                                       ViewportSize="{TemplateBinding ViewportHeight}"
                                       Visibility="{TemplateBinding ComputedVerticalScrollBarVisibility}"
                                       HorizontalAlignment="Right" />
                        </Grid>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </UserControl.Resources>

    <!-- Main Drawer Container: NO BORDER, Acrylic Obsidian Background (#B80D0D11), Right-directed shadow -->
    <Border x:Name="DrawerContainer"
            Background="#B80D0D11"
            BorderThickness="0"
            SnapsToDevicePixels="True"
            UseLayoutRounding="True">
        <Border.Effect>
            <DropShadowEffect BlurRadius="32" ShadowDepth="6" Direction="0" Color="#000000" Opacity="0.55" />
        </Border.Effect>

        <Grid>
            <Grid.RowDefinitions>
                <!-- Header / Title -->
                <RowDefinition Height="Auto" />
                <!-- Search Bar -->
                <RowDefinition Height="Auto" />
                <!-- Apps Content (Alphabetical Groups or Search Results) -->
                <RowDefinition Height="*" />
            </Grid.RowDefinitions>

            <!-- Header Title -->
            <Grid Grid.Row="0" Margin="16,14,16,6">
                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                    <ui:SymbolIcon Symbol="AppsList24" FontSize="18" Foreground="{DynamicResource SystemAccentColorPrimaryBrush}" Margin="0,0,8,0" />
                    <TextBlock Text="All apps"
                               FontSize="14"
                               FontWeight="SemiBold"
                               Foreground="#EAEAEA"
                               VerticalAlignment="Center" />
                </StackPanel>
                
                <Button x:Name="CloseButton"
                        HorizontalAlignment="Right"
                        Style="{StaticResource MiniPinButtonStyle}"
                        ToolTip="Close"
                        Click="OnCloseClick">
                    <ui:SymbolIcon Symbol="Dismiss20" FontSize="14" Foreground="#A0FFFFFF" />
                </Button>
            </Grid>

            <!-- Search Bar: NO BORDER, CornerRadius="2" matching tiles, perfectly aligned caret/placeholder -->
            <Border Grid.Row="1"
                    x:Name="SearchBorder"
                    Margin="14,4,14,12"
                    Height="34"
                    CornerRadius="2"
                    Background="#14FFFFFF"
                    BorderThickness="0"
                    SnapsToDevicePixels="True">
                <Grid>
                    <ui:SymbolIcon Symbol="Search24"
                                   FontSize="15"
                                   Foreground="#75FFFFFF"
                                   HorizontalAlignment="Left"
                                   VerticalAlignment="Center"
                                   Margin="10,0,0,0"
                                   IsHitTestVisible="False" />

                    <TextBlock x:Name="SearchPlaceholder"
                               Text="Type here to search..."
                               FontSize="13"
                               FontFamily="Segoe UI Variable Text, Segoe UI Variable, Segoe UI, sans-serif"
                               Foreground="#60FFFFFF"
                               VerticalAlignment="Center"
                               Margin="34,0,28,0"
                               IsHitTestVisible="False" />

                    <TextBox x:Name="SearchBox"
                             Style="{StaticResource CleanSearchTextBoxStyle}"
                             VerticalAlignment="Center"
                             Margin="34,0,28,0"
                             TextChanged="OnSearchBoxTextChanged"
                             GotFocus="OnSearchBoxGotFocus"
                             LostFocus="OnSearchBoxLostFocus" />

                    <Button x:Name="ClearSearchButton"
                            HorizontalAlignment="Right"
                            VerticalAlignment="Center"
                            Margin="0,0,5,0"
                            Style="{StaticResource MiniPinButtonStyle}"
                            Width="24"
                            Height="24"
                            Visibility="Collapsed"
                            Click="OnClearSearchClick">
                        <ui:SymbolIcon Symbol="Dismiss20" FontSize="12" Foreground="#90FFFFFF" />
                    </Button>
                </Grid>
            </Border>

            <!-- Mode 1: Alphabetical Grouped Apps List with Breathing Room -->
            <ScrollViewer Grid.Row="2"
                          x:Name="GroupedScrollViewer"
                          Style="{StaticResource MinimalScrollViewerStyle}"
                          Padding="0,2,0,16">
                <ItemsControl x:Name="GroupedItemsControl">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <StackPanel Margin="0,0,0,6">
                                <!-- Group Header Badge: CornerRadius="2" matching Tiles -->
                                <Border Width="26"
                                        Height="26"
                                        Background="#14FFFFFF"
                                        CornerRadius="2"
                                        HorizontalAlignment="Left"
                                        Margin="14,8,0,3">
                                    <TextBlock Text="{Binding Header}"
                                               FontSize="12"
                                               FontWeight="Bold"
                                               Foreground="{DynamicResource SystemAccentColorPrimaryBrush}"
                                               HorizontalAlignment="Center"
                                               VerticalAlignment="Center" />
                                </Border>

                                <!-- Apps in this letter group -->
                                <ItemsControl ItemsSource="{Binding Items}">
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate>
                                            <Border Style="{StaticResource AppRowContainerStyle}"
                                                    Tag="{Binding}"
                                                    PreviewMouseLeftButtonDown="OnAppRowPreviewMouseLeftButtonDown"
                                                    PreviewMouseMove="OnAppRowPreviewMouseMove"
                                                    MouseLeftButtonUp="OnAppRowMouseLeftButtonUp"
                                                    ToolTip="{Binding Name}">
                                                <Border.ContextMenu>
                                                    <ContextMenu>
                                                        <MenuItem Header="Pin to Start" Click="OnContextMenuPinClick">
                                                            <MenuItem.Icon>
                                                                <ui:SymbolIcon Symbol="Pin24" FontSize="18" />
                                                            </MenuItem.Icon>
                                                        </MenuItem>
                                                        <MenuItem Header="Open" Click="OnContextMenuOpenClick">
                                                            <MenuItem.Icon>
                                                                <ui:SymbolIcon Symbol="ArrowRight24" FontSize="18" />
                                                            </MenuItem.Icon>
                                                        </MenuItem>
                                                    </ContextMenu>
                                                </Border.ContextMenu>

                                                <Grid>
                                                    <Grid.ColumnDefinitions>
                                                        <ColumnDefinition Width="28" />
                                                        <ColumnDefinition Width="*" />
                                                        <ColumnDefinition Width="Auto" />
                                                    </Grid.ColumnDefinitions>

                                                    <Image Grid.Column="0"
                                                           Source="{Binding Icon}"
                                                           Width="22"
                                                           Height="22"
                                                           HorizontalAlignment="Center"
                                                           VerticalAlignment="Center"
                                                           RenderOptions.BitmapScalingMode="HighQuality" />

                                                    <TextBlock Grid.Column="1"
                                                               Text="{Binding Name}"
                                                               FontSize="13"
                                                               Foreground="#E6FFFFFF"
                                                               VerticalAlignment="Center"
                                                               Margin="8,0,4,0"
                                                               TextTrimming="CharacterEllipsis" />

                                                    <!-- Hover Pin Action Button -->
                                                    <Button Grid.Column="2"
                                                            Style="{StaticResource MiniPinButtonStyle}"
                                                            ToolTip="Pin to Start"
                                                            Tag="{Binding}"
                                                            Click="OnQuickPinClick">
                                                        <ui:SymbolIcon Symbol="Pin20" FontSize="14" Foreground="#80FFFFFF" />
                                                    </Button>
                                                </Grid>
                                            </Border>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                            </StackPanel>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </ScrollViewer>

            <!-- Mode 2: Search Results Flat List with Breathing Room -->
            <ScrollViewer Grid.Row="2"
                          x:Name="SearchResultsScrollViewer"
                          Visibility="Collapsed"
                          Style="{StaticResource MinimalScrollViewerStyle}"
                          Padding="0,2,0,16">
                <StackPanel>
                    <TextBlock x:Name="NoResultsTextBlock"
                               Text="No apps found"
                               FontSize="13"
                               Foreground="#70FFFFFF"
                               HorizontalAlignment="Center"
                               Margin="0,32,0,0"
                               Visibility="Collapsed" />

                    <ItemsControl x:Name="SearchResultsItemsControl">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Border Style="{StaticResource AppRowContainerStyle}"
                                        Tag="{Binding}"
                                        PreviewMouseLeftButtonDown="OnAppRowPreviewMouseLeftButtonDown"
                                        PreviewMouseMove="OnAppRowPreviewMouseMove"
                                        MouseLeftButtonUp="OnAppRowMouseLeftButtonUp"
                                        ToolTip="{Binding Name}">
                                    <Border.ContextMenu>
                                        <ContextMenu>
                                            <MenuItem Header="Pin to Start" Click="OnContextMenuPinClick">
                                                <MenuItem.Icon>
                                                    <ui:SymbolIcon Symbol="Pin24" FontSize="18" />
                                                </MenuItem.Icon>
                                            </MenuItem>
                                            <MenuItem Header="Open" Click="OnContextMenuOpenClick">
                                                <MenuItem.Icon>
                                                    <ui:SymbolIcon Symbol="ArrowRight24" FontSize="18" />
                                                </MenuItem.Icon>
                                            </MenuItem>
                                        </ContextMenu>
                                    </Border.ContextMenu>

                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="28" />
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="Auto" />
                                        </Grid.ColumnDefinitions>

                                        <Image Grid.Column="0"
                                               Source="{Binding Icon}"
                                               Width="22"
                                               Height="22"
                                               HorizontalAlignment="Center"
                                               VerticalAlignment="Center"
                                               RenderOptions.BitmapScalingMode="HighQuality" />

                                        <TextBlock Grid.Column="1"
                                                   Text="{Binding Name}"
                                                   FontSize="13"
                                                   Foreground="#E6FFFFFF"
                                                   VerticalAlignment="Center"
                                                   Margin="8,0,4,0"
                                                   TextTrimming="CharacterEllipsis" />

                                        <Button Grid.Column="2"
                                                Style="{StaticResource MiniPinButtonStyle}"
                                                ToolTip="Pin to Start"
                                                Tag="{Binding}"
                                                Click="OnQuickPinClick">
                                            <ui:SymbolIcon Symbol="Pin20" FontSize="14" Foreground="#80FFFFFF" />
                                        </Button>
                                    </Grid>
                                </Border>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </StackPanel>
            </ScrollViewer>
        </Grid>
    </Border>
</UserControl>
