<UserControl x:Class="MetroHub.Presentation.Controls.AllAppsDrawerControl"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
             xmlns:controls="clr-namespace:MetroHub.Presentation.Controls"
             mc:Ignorable="d" 
             Width="320"
             HorizontalAlignment="Left"
             VerticalAlignment="Stretch"
             Focusable="False"
             ClipToBounds="False"
             Background="Transparent">

    <UserControl.RenderTransform>
        <TranslateTransform x:Name="DrawerTranslate" X="-320" />
    </UserControl.RenderTransform>

    <UserControl.Resources>
        <!-- Custom Clean TextBox Style: Zero WPF-UI chrome, no borders, no bottom accent line -->
        <Style x:Key="CleanSearchTextBoxStyle" TargetType="{x:Type TextBox}">
            <Setter Property="OverridesDefaultStyle" Value="True" />
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="Foreground" Value="#FFFFFF" />
            <Setter Property="CaretBrush" Value="#60CDFF" />
            <Setter Property="FontSize" Value="13" />
            <Setter Property="FontFamily" Value="Segoe UI Variable Text, Segoe UI Variable, Segoe UI, sans-serif" />
            <Setter Property="VerticalContentAlignment" Value="Center" />
            <Setter Property="Padding" Value="0" />
            <Setter Property="Margin" Value="0" />
            <Setter Property="FocusVisualStyle" Value="{x:Null}" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="{x:Type TextBox}">
                        <ScrollViewer x:Name="PART_ContentHost"
                                      Focusable="False"
                                      HorizontalScrollBarVisibility="Hidden"
                                      VerticalScrollBarVisibility="Hidden"
                                      VerticalAlignment="Center"
                                      Padding="0"
                                      Margin="0" />
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Modern Fluent App Item Style: CornerRadius="2" matching Tiles -->
        <Style x:Key="AppRowContainerStyle" TargetType="Border">
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="BorderBrush" Value="Transparent" />
            <Setter Property="CornerRadius" Value="2" />
            <Setter Property="Margin" Value="8,1,8,1" />
            <Setter Property="Padding" Value="7,4" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="SnapsToDevicePixels" Value="True" />
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Background" Value="#18FFFFFF" />
                    <Setter Property="BorderBrush" Value="#2AFFFFFF" />
                </Trigger>
            </Style.Triggers>
        </Style>

        <!-- Modern Fluent Search Result Item Style with Selection & Hover Focus -->
        <Style x:Key="FluentSearchListBoxItemStyle" TargetType="{x:Type ListBoxItem}">
            <Setter Property="FocusVisualStyle" Value="{x:Null}" />
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="BorderBrush" Value="Transparent" />
            <Setter Property="Margin" Value="8,1,8,1" />
            <Setter Property="Padding" Value="7,4" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="SnapsToDevicePixels" Value="True" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="{x:Type ListBoxItem}">
                        <Border x:Name="Bd"
                                Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="2"
                                Padding="{TemplateBinding Padding}"
                                SnapsToDevicePixels="True">
                            <Grid>
                                <Rectangle x:Name="AccentPill"
                                           Width="3"
                                           Height="16"
                                           HorizontalAlignment="Left"
                                           VerticalAlignment="Center"
                                           RadiusX="1.5"
                                           RadiusY="1.5"
                                           Fill="#60CDFF"
                                           Visibility="Collapsed"
                                           Margin="-5,0,0,0" />
                                <ContentPresenter />
                            </Grid>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="#18FFFFFF" />
                                <Setter TargetName="Bd" Property="BorderBrush" Value="#2AFFFFFF" />
                            </Trigger>
                            <Trigger Property="IsSelected" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="#25FFFFFF" />
                                <Setter TargetName="Bd" Property="BorderBrush" Value="#45FFFFFF" />
                                <Setter TargetName="AccentPill" Property="Visibility" Value="Visible" />
                            </Trigger>
                            <Trigger Property="IsKeyboardFocused" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="#25FFFFFF" />
                                <Setter TargetName="Bd" Property="BorderBrush" Value="#45FFFFFF" />
                                <Setter TargetName="AccentPill" Property="Visibility" Value="Visible" />
                            </Trigger>
                            <MultiTrigger>
                                <MultiTrigger.Conditions>
                                    <Condition Property="IsSelected" Value="True" />
                                    <Condition Property="IsMouseOver" Value="True" />
                                </MultiTrigger.Conditions>
                                <Setter TargetName="Bd" Property="Background" Value="#30FFFFFF" />
                                <Setter TargetName="Bd" Property="BorderBrush" Value="#55FFFFFF" />
                            </MultiTrigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Modern Mini Pin Button Style: CornerRadius="2" matching Tiles -->
        <Style x:Key="MiniPinButtonStyle" TargetType="Button">
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="Width" Value="28" />
            <Setter Property="Height" Value="28" />
            <Setter Property="Padding" Value="0" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="FocusVisualStyle" Value="{x:Null}" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Bdr"
                                Background="Transparent"
                                CornerRadius="2">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bdr" Property="Background" Value="#25FFFFFF" />
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="Bdr" Property="Background" Value="#35FFFFFF" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Comprehensive Fluent App Context Menu: Open -> Run as Admin -> Pin/Unpin -> Separator -> Uninstall -->
        <ContextMenu x:Key="AppItemContextMenu"
                     Opened="OnAppContextMenuOpened"
                     PreviewKeyDown="OnAppContextMenuPreviewKeyDown">
            <MenuItem Header="Open" Click="OnContextMenuOpenClick">
                <MenuItem.Icon>
                    <ui:SymbolIcon Symbol="ArrowRight24" FontSize="18" />
                </MenuItem.Icon>
            </MenuItem>
            <MenuItem Header="Run as administrator" Click="OnContextMenuRunAsAdminClick">
                <MenuItem.Icon>
                    <ui:SymbolIcon Symbol="Shield32" FontSize="18" Foreground="#D0FFFFFF" />
                </MenuItem.Icon>
            </MenuItem>
            <MenuItem x:Name="PinMenuItem" Header="Pin to Start" Click="OnContextMenuPinToggleClick">
                <MenuItem.Icon>
                    <ui:SymbolIcon Symbol="Pin24" FontSize="18" />
                </MenuItem.Icon>
            </MenuItem>
            <Separator />
            <MenuItem Header="Uninstall" Click="OnContextMenuUninstallClick" Foreground="#FF6B6B">
                <MenuItem.Icon>
                    <ui:SymbolIcon Symbol="Delete24" FontSize="18" Foreground="#FF6B6B" />
                </MenuItem.Icon>
            </MenuItem>
        </ContextMenu>
    </UserControl.Resources>

    <Grid>
        <!-- Right Edge Soft Drop Shadow: Casts strictly to the right onto canvas tiles, zero shader effect, zero black backbuffer, zero left shadow -->
        <Border Width="24"
                HorizontalAlignment="Right"
                Margin="0,0,-24,0"
                IsHitTestVisible="False">
            <Border.Background>
                <LinearGradientBrush StartPoint="0,0" EndPoint="1,0">
                    <GradientStop Color="#45000000" Offset="0" />
                    <GradientStop Color="#20000000" Offset="0.35" />
                    <GradientStop Color="#0A000000" Offset="0.75" />
                    <GradientStop Color="#00000000" Offset="1" />
                </LinearGradientBrush>
            </Border.Background>
        </Border>

        <!-- Main Drawer Container: NO BORDER, Transparent Background allowing Main Window's Acrylic Obsidian to shine through -->
        <Border x:Name="DrawerContainer"
                Background="Transparent"
                BorderThickness="0"
                SnapsToDevicePixels="True"
                UseLayoutRounding="True">

        <Grid>
            <Grid.RowDefinitions>
                <!-- Header / Title -->
                <RowDefinition Height="Auto" />
                <!-- Search Bar -->
                <RowDefinition Height="Auto" />
                <!-- Apps Content (Alphabetical Groups or Search Results) -->
                <RowDefinition Height="*" />
            </Grid.RowDefinitions>

            <!-- Header Title -->
            <Grid Grid.Row="0" Margin="16,14,16,6">
                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                    <ui:SymbolIcon Symbol="AppsList24" FontSize="18" Foreground="{DynamicResource SystemAccentColorPrimaryBrush}" Margin="0,0,8,0" />
                    <TextBlock Text="All apps"
                               FontSize="14"
                               FontWeight="SemiBold"
                               Foreground="#EAEAEA"
                               VerticalAlignment="Center" />
                </StackPanel>
                
                <Button x:Name="CloseButton"
                        HorizontalAlignment="Right"
                        Style="{StaticResource MiniPinButtonStyle}"
                        ToolTip="Close"
                        Click="OnCloseClick">
                    <ui:SymbolIcon Symbol="Dismiss20" FontSize="14" Foreground="#A0FFFFFF" />
                </Button>
            </Grid>

            <!-- Search Bar: NO BORDER, CornerRadius="2" matching tiles, perfectly aligned caret/placeholder -->
            <Border Grid.Row="1"
                    x:Name="SearchBorder"
                    Margin="14,4,14,12"
                    Height="34"
                    CornerRadius="2"
                    Background="#14FFFFFF"
                    BorderThickness="0"
                    SnapsToDevicePixels="True">
                <Grid>
                    <ui:SymbolIcon Symbol="Search24"
                                   FontSize="15"
                                   Foreground="#75FFFFFF"
                                   HorizontalAlignment="Left"
                                   VerticalAlignment="Center"
                                   Margin="10,0,0,0"
                                   IsHitTestVisible="False" />

                    <TextBlock x:Name="SearchPlaceholder"
                               Text="Type here to search..."
                               FontSize="13"
                               FontFamily="Segoe UI Variable Text, Segoe UI Variable, Segoe UI, sans-serif"
                               Foreground="#60FFFFFF"
                               VerticalAlignment="Center"
                               Margin="34,0,28,0"
                               IsHitTestVisible="False" />

                    <TextBox x:Name="SearchBox"
                             Style="{StaticResource CleanSearchTextBoxStyle}"
                             VerticalAlignment="Center"
                             Margin="34,0,28,0"
                             TextChanged="OnSearchBoxTextChanged"
                             GotFocus="OnSearchBoxGotFocus"
                             LostFocus="OnSearchBoxLostFocus"
                             PreviewKeyDown="OnSearchBoxPreviewKeyDown" />

                    <Button x:Name="ClearSearchButton"
                            HorizontalAlignment="Right"
                            VerticalAlignment="Center"
                            Margin="0,0,5,0"
                            Style="{StaticResource MiniPinButtonStyle}"
                            Width="24"
                            Height="24"
                            Visibility="Collapsed"
                            Click="OnClearSearchClick">
                        <ui:SymbolIcon Symbol="Dismiss20" FontSize="12" Foreground="#90FFFFFF" />
                    </Button>
                </Grid>
            </Border>

            <!-- Mode 1: Alphabetical Grouped Apps List with Breathing Room -->
            <ScrollViewer Grid.Row="2"
                          x:Name="GroupedScrollViewer"
                          controls:AutoHideScrollBehavior.IsEnabled="True"
                          VerticalScrollBarVisibility="Auto"
                          HorizontalScrollBarVisibility="Disabled"
                          Focusable="False"
                          Background="Transparent"
                          Padding="0,2,14,16">
                <ItemsControl x:Name="GroupedItemsControl">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <StackPanel Margin="0,0,0,6">
                                <!-- Group Header Badge: Perfectly aligned with app icon column below -->
                                <Border Width="28"
                                        Height="28"
                                        Background="#14FFFFFF"
                                        BorderThickness="1"
                                        BorderBrush="#1CFFFFFF"
                                        CornerRadius="2"
                                        SnapsToDevicePixels="True"
                                        HorizontalAlignment="Left"
                                        Margin="16,8,0,4">
                                    <TextBlock Text="{Binding Header}"
                                               FontSize="14"
                                               FontWeight="Bold"
                                               FontFamily="Segoe UI Variable Display, Segoe UI Variable Text, Segoe UI, sans-serif"
                                               Foreground="{DynamicResource SystemAccentColorPrimaryBrush}"
                                               HorizontalAlignment="Center"
                                               VerticalAlignment="Center" />
                                </Border>

                                <!-- Apps in this letter group -->
                                <ItemsControl ItemsSource="{Binding Items}">
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate>
                                            <Border Style="{StaticResource AppRowContainerStyle}"
                                                    Tag="{Binding}"
                                                    PreviewMouseLeftButtonDown="OnAppRowPreviewMouseLeftButtonDown"
                                                    PreviewMouseMove="OnAppRowPreviewMouseMove"
                                                    MouseLeftButtonUp="OnAppRowMouseLeftButtonUp"
                                                    ContextMenu="{StaticResource AppItemContextMenu}"
                                                    ContextMenuOpening="OnAppContextMenuOpening">
                                                <Grid>
                                                    <Grid.ColumnDefinitions>
                                                        <ColumnDefinition Width="28" />
                                                        <ColumnDefinition Width="*" />
                                                    </Grid.ColumnDefinitions>

                                                    <Image Grid.Column="0"
                                                           Source="{Binding Icon}"
                                                           Width="22"
                                                           Height="22"
                                                           HorizontalAlignment="Center"
                                                           VerticalAlignment="Center"
                                                           RenderOptions.BitmapScalingMode="HighQuality" />

                                                    <TextBlock Grid.Column="1"
                                                               Text="{Binding Name}"
                                                               FontSize="13"
                                                               Foreground="#E6FFFFFF"
                                                               VerticalAlignment="Center"
                                                               Margin="8,0,8,0"
                                                               TextTrimming="CharacterEllipsis" />
                                                </Grid>
                                            </Border>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                            </StackPanel>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </ScrollViewer>

            <!-- Mode 2: Search Results Flat List with Breathing Room -->
            <ScrollViewer Grid.Row="2"
                          x:Name="SearchResultsScrollViewer"
                          controls:AutoHideScrollBehavior.IsEnabled="True"
                          Visibility="Collapsed"
                          VerticalScrollBarVisibility="Auto"
                          HorizontalScrollBarVisibility="Disabled"
                          Focusable="False"
                          Background="Transparent"
                          Padding="0,2,14,16">
                <StackPanel>
                    <TextBlock x:Name="NoResultsTextBlock"
                               Text="No apps found"
                               FontSize="13"
                               Foreground="#70FFFFFF"
                               HorizontalAlignment="Center"
                               Margin="0,32,0,0"
                               Visibility="Collapsed" />

                    <ListBox x:Name="SearchResultsListBox"
                             Background="Transparent"
                             BorderThickness="0"
                             Padding="0"
                             FocusVisualStyle="{x:Null}"
                             ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                             ScrollViewer.VerticalScrollBarVisibility="Disabled"
                             ItemContainerStyle="{StaticResource FluentSearchListBoxItemStyle}"
                             KeyDown="OnSearchResultsKeyDown"
                             PreviewKeyDown="OnSearchResultsPreviewKeyDown"
                             PreviewTextInput="OnSearchResultsPreviewTextInput">
                        <ListBox.ItemTemplate>
                            <DataTemplate>
                                <Grid Tag="{Binding}"
                                      Background="Transparent"
                                      PreviewMouseLeftButtonDown="OnAppRowPreviewMouseLeftButtonDown"
                                      PreviewMouseMove="OnAppRowPreviewMouseMove"
                                      MouseLeftButtonUp="OnAppRowMouseLeftButtonUp"
                                      ContextMenu="{StaticResource AppItemContextMenu}"
                                      ContextMenuOpening="OnAppContextMenuOpening">

                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="28" />
                                        <ColumnDefinition Width="*" />
                                    </Grid.ColumnDefinitions>

                                    <Image Grid.Column="0"
                                           Source="{Binding Icon}"
                                           Width="22"
                                           Height="22"
                                           HorizontalAlignment="Center"
                                           VerticalAlignment="Center"
                                           RenderOptions.BitmapScalingMode="HighQuality" />

                                    <TextBlock Grid.Column="1"
                                               Text="{Binding Name}"
                                               FontSize="13"
                                               Foreground="#E6FFFFFF"
                                               VerticalAlignment="Center"
                                               Margin="8,0,8,0"
                                               TextTrimming="CharacterEllipsis" />
                                </Grid>
                            </DataTemplate>
                        </ListBox.ItemTemplate>
                    </ListBox>
                </StackPanel>
            </ScrollViewer>
        </Grid>
    </Border>
    </Grid>
</UserControl>
