<ui:FluentWindow x:Class="MetroHub.Presentation.Controls.WebLinkDialog"
                   xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                   xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                   xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
                   WindowBackdropType="Acrylic"
                   WindowCornerPreference="DoNotRound"
                   ExtendsContentIntoTitleBar="True"
                   WindowStyle="None"
                   ResizeMode="NoResize"
                   ShowInTaskbar="False"
                   WindowStartupLocation="CenterOwner"
                   Width="620"
                   Height="360"
                   Background="Transparent"
                   Foreground="#FFFFFF"
                   FontFamily="{DynamicResource AppFontFamily}"
                   RenderOptions.ClearTypeHint="Enabled"
                   TextOptions.TextFormattingMode="Ideal"
                   TextOptions.TextRenderingMode="ClearType"
                   TextOptions.TextHintingMode="Auto"
                   SnapsToDevicePixels="True"
                   UseLayoutRounding="True">

    <Window.Resources>
        <Style x:Key="ModalDismissButtonStyle" TargetType="Button">
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="Width" Value="32" />
            <Setter Property="Height" Value="32" />
            <Setter Property="FocusVisualStyle" Value="{x:Null}" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Border" Background="{TemplateBinding Background}" CornerRadius="{DynamicResource ControlCornerRadius}" SnapsToDevicePixels="True">
                            <Path x:Name="Icon"
                                  Width="10" Height="10"
                                  Data="M 0.5,0.5 L 9.5,9.5 M 0.5,9.5 L 9.5,0.5"
                                  Stroke="#85FFFFFF"
                                  StrokeThickness="1.2"
                                  StrokeStartLineCap="Round"
                                  StrokeEndLineCap="Round"
                                  SnapsToDevicePixels="False"
                                  UseLayoutRounding="False"
                                  HorizontalAlignment="Center"
                                  VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Border" Property="Background" Value="#25FFFFFF" />
                                <Setter TargetName="Icon" Property="Stroke" Value="#FFFFFF" />
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="Border" Property="Background" Value="#35FFFFFF" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="FluentGlassUrlWithPasteInputStyle" TargetType="TextBox">
            <Setter Property="OverridesDefaultStyle" Value="True" />
            <Setter Property="Height" Value="36" />
            <Setter Property="FontSize" Value="{DynamicResource TypeBodyFontSize}" />
            <Setter Property="FontWeight" Value="{DynamicResource TypeBodyFontWeight}" />
            <Setter Property="Foreground" Value="#FFFFFF" />
            <Setter Property="CaretBrush" Value="#FFFFFF" />
            <Setter Property="FocusVisualStyle" Value="{x:Null}" />
            <Setter Property="SnapsToDevicePixels" Value="True" />
            <Setter Property="UseLayoutRounding" Value="True" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="TextBox">
                        <Border x:Name="BoxBorder"
                                Background="#14FFFFFF"
                                BorderBrush="#28FFFFFF"
                                BorderThickness="1"
                                CornerRadius="{DynamicResource ControlCornerRadius}"
                                SnapsToDevicePixels="True">
                            <Grid Margin="10,0,80,0">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>
                                <ui:SymbolIcon x:Name="PrefixIcon"
                                               Symbol="Link24"
                                               FontSize="14"
                                               Foreground="#85FFFFFF"
                                               VerticalAlignment="Center"
                                               Margin="0,0,8,0" />
                                <ScrollViewer x:Name="PART_ContentHost"
                                              Grid.Column="1"
                                              VerticalAlignment="Center"
                                              Focusable="False"
                                              HorizontalScrollBarVisibility="Hidden"
                                              VerticalScrollBarVisibility="Hidden" />
                            </Grid>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="BoxBorder" Property="Background" Value="#1CFFFFFF" />
                                <Setter TargetName="BoxBorder" Property="BorderBrush" Value="#45FFFFFF" />
                                <Setter TargetName="PrefixIcon" Property="Foreground" Value="#B0FFFFFF" />
                            </Trigger>
                            <Trigger Property="IsKeyboardFocused" Value="True">
                                <Setter TargetName="BoxBorder" Property="Background" Value="#22FFFFFF" />
                                <Setter TargetName="BoxBorder" Property="BorderBrush" Value="#65FFFFFF" />
                                <Setter TargetName="PrefixIcon" Property="Foreground" Value="#FFFFFF" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="FluentGlassInputStyle" TargetType="TextBox">
            <Setter Property="OverridesDefaultStyle" Value="True" />
            <Setter Property="Height" Value="36" />
            <Setter Property="FontSize" Value="{DynamicResource TypeBodyFontSize}" />
            <Setter Property="FontWeight" Value="{DynamicResource TypeBodyFontWeight}" />
            <Setter Property="Foreground" Value="#FFFFFF" />
            <Setter Property="CaretBrush" Value="#FFFFFF" />
            <Setter Property="FocusVisualStyle" Value="{x:Null}" />
            <Setter Property="SnapsToDevicePixels" Value="True" />
            <Setter Property="UseLayoutRounding" Value="True" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="TextBox">
                        <Border x:Name="BoxBorder"
                                Background="#14FFFFFF"
                                BorderBrush="#28FFFFFF"
                                BorderThickness="1"
                                CornerRadius="{DynamicResource ControlCornerRadius}"
                                SnapsToDevicePixels="True">
                            <Grid Margin="10,0,10,0">
                                <ScrollViewer x:Name="PART_ContentHost"
                                              VerticalAlignment="Center"
                                              Focusable="False"
                                              HorizontalScrollBarVisibility="Hidden"
                                              VerticalScrollBarVisibility="Hidden" />
                            </Grid>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="BoxBorder" Property="Background" Value="#1CFFFFFF" />
                                <Setter TargetName="BoxBorder" Property="BorderBrush" Value="#45FFFFFF" />
                            </Trigger>
                            <Trigger Property="IsKeyboardFocused" Value="True">
                                <Setter TargetName="BoxBorder" Property="Background" Value="#22FFFFFF" />
                                <Setter TargetName="BoxBorder" Property="BorderBrush" Value="#65FFFFFF" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="FluentGlassRadioButtonStyle" TargetType="RadioButton">
            <Setter Property="OverridesDefaultStyle" Value="True" />
            <Setter Property="FocusVisualStyle" Value="{x:Null}" />
            <Setter Property="VerticalContentAlignment" Value="Center" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="RadioButton">
                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                            <Grid Width="16" Height="16" Margin="0,0,8,0" VerticalAlignment="Center">
                                <Ellipse x:Name="OuterRing"
                                         Width="16" Height="16"
                                         Stroke="#45FFFFFF"
                                         StrokeThickness="1.2"
                                         Fill="#10FFFFFF"
                                         SnapsToDevicePixels="False"
                                         UseLayoutRounding="False" />
                                <Ellipse x:Name="InnerDot"
                                         Width="8" Height="8"
                                         Fill="{DynamicResource SystemAccentColorPrimaryBrush}"
                                         Opacity="0"
                                         SnapsToDevicePixels="False"
                                         UseLayoutRounding="False"
                                         HorizontalAlignment="Center"
                                         VerticalAlignment="Center" />
                            </Grid>
                            <ContentPresenter VerticalAlignment="{TemplateBinding VerticalContentAlignment}" />
                        </StackPanel>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="OuterRing" Property="Stroke" Value="#80FFFFFF" />
                                <Setter TargetName="OuterRing" Property="Fill" Value="#1CFFFFFF" />
                            </Trigger>
                            <Trigger Property="IsChecked" Value="True">
                                <Setter TargetName="OuterRing" Property="Stroke" Value="{DynamicResource SystemAccentColorPrimaryBrush}" />
                                <Setter TargetName="OuterRing" Property="Fill" Value="{DynamicResource SystemAccentColorTertiaryBrush}" />
                                <Setter TargetName="InnerDot" Property="Opacity" Value="1.0" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="FluentCohesivePrimaryButtonStyle" TargetType="Button">
            <Setter Property="OverridesDefaultStyle" Value="True" />
            <Setter Property="Height" Value="32" />
            <Setter Property="MinWidth" Value="110" />
            <Setter Property="Padding" Value="14,0" />
            <Setter Property="FontSize" Value="{DynamicResource TypeBodyStrongFontSize}" />
            <Setter Property="FontWeight" Value="{DynamicResource TypeBodyStrongFontWeight}" />
            <Setter Property="Foreground" Value="#FFFFFF" />
            <Setter Property="FocusVisualStyle" Value="{x:Null}" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="BtnBorder"
                                Background="{DynamicResource SystemAccentColorPrimaryBrush}"
                                CornerRadius="{DynamicResource ControlCornerRadius}"
                                SnapsToDevicePixels="True">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="BtnBorder" Property="Background" Value="{DynamicResource SystemAccentColorSecondaryBrush}" />
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="BtnBorder" Property="Background" Value="{DynamicResource SystemAccentColorTertiaryBrush}" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="FluentCohesiveSecondaryButtonStyle" TargetType="Button">
            <Setter Property="OverridesDefaultStyle" Value="True" />
            <Setter Property="Height" Value="32" />
            <Setter Property="MinWidth" Value="80" />
            <Setter Property="Padding" Value="14,0" />
            <Setter Property="FontSize" Value="{DynamicResource TypeCaptionFontSize}" />
            <Setter Property="FontWeight" Value="{DynamicResource TypeCaptionFontWeight}" />
            <Setter Property="Foreground" Value="#E0FFFFFF" />
            <Setter Property="FocusVisualStyle" Value="{x:Null}" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="BtnBorder"
                                Background="#1AFFFFFF"
                                BorderBrush="#25FFFFFF"
                                BorderThickness="1"
                                CornerRadius="{DynamicResource ControlCornerRadius}"
                                SnapsToDevicePixels="True">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="BtnBorder" Property="Background" Value="#28FFFFFF" />
                                <Setter TargetName="BtnBorder" Property="BorderBrush" Value="#40FFFFFF" />
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="BtnBorder" Property="Background" Value="#35FFFFFF" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>

    <!-- Borderless Window Wrapper -->
    <Border Background="Transparent"
            BorderThickness="0"
            CornerRadius="{DynamicResource ControlCornerRadius}"
            SnapsToDevicePixels="True">
        <Grid RenderOptions.ClearTypeHint="Enabled">
            <Grid.ColumnDefinitions>
                <!-- COLUMN 0: FROSTED ACRYLIC SIDEBAR -->
                <ColumnDefinition Width="155" />
                <!-- COLUMN 1: OBSIDIAN DARK CONTENT PANEL -->
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>

            <!-- ========================================================= -->
            <!-- COLUMN 0: FROSTED ACRYLIC SIDEBAR                        -->
            <!-- ========================================================= -->
            <Grid Grid.Column="0"
                  Background="Transparent">

                <!-- Vertically and Horizontally Centered Glyph Container -->
                <Grid HorizontalAlignment="Center" VerticalAlignment="Center">
                    <Grid>
                        <Image x:Name="WebLinkFaviconImage"
                               Width="42" Height="42"
                               HorizontalAlignment="Center"
                               VerticalAlignment="Center"
                               Visibility="Collapsed"
                               RenderOptions.BitmapScalingMode="HighQuality" />

                        <Image x:Name="WebLinkFallbackIcon"
                               Source="/Assets/link.png"
                               Width="72"
                               Height="72"
                               Stretch="Uniform"
                               HorizontalAlignment="Center"
                               VerticalAlignment="Center"
                               RenderOptions.BitmapScalingMode="HighQuality" />

                        <ui:ProgressRing x:Name="WebLinkSidebarSpinner"
                                         Width="24" Height="24"
                                         IsIndeterminate="True"
                                         HorizontalAlignment="Center"
                                         VerticalAlignment="Center"
                                         Visibility="Collapsed" />
                    </Grid>
                </Grid>
            </Grid>

            <!-- Content Panel -->
            <Border Grid.Column="1"
                    Background="#232323"
                    CornerRadius="0,2,2,0"
                    RenderOptions.ClearTypeHint="Enabled">
                <Grid Margin="24,20,24,20">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>

                    <!-- Header -->
                    <Grid Grid.Row="0" Margin="0,0,0,18">
                        <TextBlock Text="Add Web Shortcut"
                                   FontSize="{DynamicResource TypeHeaderFontSize}"
                                   FontWeight="{DynamicResource TypeHeaderFontWeight}"
                                   Foreground="#FFFFFF"
                                   VerticalAlignment="Center" />

                        <Button HorizontalAlignment="Right"
                                Style="{StaticResource ModalDismissButtonStyle}"
                                Click="OnCloseButtonClick" />
                    </Grid>

                    <!-- Body -->
                    <Grid Grid.Row="1">
                        <StackPanel>
                            <TextBlock Text="Website URL"
                                       FontSize="{DynamicResource TypeCaptionFontSize}"
                                       FontWeight="{DynamicResource TypeCaptionFontWeight}"
                                       Foreground="#95FFFFFF"
                                       Margin="0,0,0,6" />

                            <Grid>
                                <TextBox x:Name="WebLinkUrlInput"
                                         Style="{StaticResource FluentGlassUrlWithPasteInputStyle}"
                                         KeyDown="OnWebLinkInputKeyDown"
                                         TextChanged="OnWebLinkUrlTextChanged" />

                                <Button HorizontalAlignment="Right"
                                        VerticalAlignment="Center"
                                        Style="{StaticResource FluentCohesiveSecondaryButtonStyle}"
                                        Height="26"
                                        Margin="0,0,5,0"
                                        Padding="8,2"
                                        Click="OnWebLinkPasteClick">
                                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                        <ui:SymbolIcon Symbol="ClipboardPaste24" FontSize="12" Margin="0,0,5,0" VerticalAlignment="Center" />
                                        <TextBlock Text="Paste"
                                                   FontSize="{DynamicResource TypeCaptionFontSize}"
                                                   FontWeight="{DynamicResource TypeCaptionFontWeight}"
                                                   VerticalAlignment="Center" />
                                    </StackPanel>
                                </Button>
                            </Grid>

                            <TextBlock Text="Shortcut Label (Optional)"
                                       FontSize="{DynamicResource TypeCaptionFontSize}"
                                       FontWeight="{DynamicResource TypeCaptionFontWeight}"
                                       Foreground="#95FFFFFF"
                                       Margin="0,14,0,6" />
                            <TextBox x:Name="WebLinkTitleInput"
                                     Style="{StaticResource FluentGlassInputStyle}"
                                     KeyDown="OnWebLinkInputKeyDown"
                                     TextChanged="OnWebLinkTitleTextChanged" />

                            <StackPanel Orientation="Horizontal" Margin="0,18,0,0">
                                <RadioButton x:Name="WebLinkDestBothRadio"
                                             Style="{StaticResource FluentGlassRadioButtonStyle}"
                                             GroupName="ShortcutDest"
                                             IsChecked="True"
                                             Margin="0,0,18,0">
                                    <TextBlock Text="Both canvas &amp; sidebar"
                                               FontSize="{DynamicResource TypeCaptionFontSize}"
                                               FontWeight="{DynamicResource TypeCaptionFontWeight}"
                                               Foreground="#95FFFFFF"
                                               VerticalAlignment="Center" />
                                </RadioButton>
                                <RadioButton x:Name="WebLinkDestCanvasRadio"
                                             Style="{StaticResource FluentGlassRadioButtonStyle}"
                                             GroupName="ShortcutDest"
                                             Margin="0,0,18,0">
                                    <TextBlock Text="Canvas only"
                                               FontSize="{DynamicResource TypeCaptionFontSize}"
                                               FontWeight="{DynamicResource TypeCaptionFontWeight}"
                                               Foreground="#95FFFFFF"
                                               VerticalAlignment="Center" />
                                </RadioButton>
                                <RadioButton x:Name="WebLinkDestSidebarRadio"
                                             Style="{StaticResource FluentGlassRadioButtonStyle}"
                                             GroupName="ShortcutDest">
                                    <TextBlock Text="Sidebar only"
                                               FontSize="{DynamicResource TypeCaptionFontSize}"
                                               FontWeight="{DynamicResource TypeCaptionFontWeight}"
                                               Foreground="#95FFFFFF"
                                               VerticalAlignment="Center" />
                                </RadioButton>
                            </StackPanel>

                            <TextBlock x:Name="WebLinkStatusMessage"
                                       FontSize="{DynamicResource TypeCaptionFontSize}"
                                       FontWeight="{DynamicResource TypeCaptionFontWeight}"
                                       Foreground="#FF8080"
                                       Margin="0,8,0,0"
                                       TextWrapping="Wrap"
                                       Visibility="Collapsed" />
                        </StackPanel>
                    </Grid>

                    <!-- Footer -->
                    <Grid Grid.Row="2" Margin="0,16,0,0">
                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                            <Button Content="Add Shortcut"
                                    Style="{StaticResource FluentCohesivePrimaryButtonStyle}"
                                    Margin="0,0,8,0"
                                    Click="OnAddWebLinkClick" />
                            <Button Content="Cancel"
                                    Style="{StaticResource FluentCohesiveSecondaryButtonStyle}"
                                    Click="OnCloseButtonClick" />
                        </StackPanel>
                    </Grid>
                </Grid>
            </Border>
        </Grid>
    </Border>
</ui:FluentWindow>
