<ui:FluentWindow x:Class="MetroHub.Presentation.Controls.WeatherLocationDialog"
                   xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                   xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                   xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
                   xmlns:controls="clr-namespace:MetroHub.Presentation.Controls"
                   WindowBackdropType="Acrylic"
                   WindowCornerPreference="DoNotRound"
                   ExtendsContentIntoTitleBar="True"
                   WindowStyle="None"
                   ResizeMode="NoResize"
                   ShowInTaskbar="False"
                   WindowStartupLocation="CenterOwner"
                   Width="620"
                   Height="360"
                   Background="Transparent"
                   Foreground="#FFFFFF"
                   FontFamily="{DynamicResource AppFontFamily}"
                   RenderOptions.ClearTypeHint="Enabled"
                   TextOptions.TextFormattingMode="Ideal"
                   TextOptions.TextRenderingMode="ClearType"
                   TextOptions.TextHintingMode="Auto"
                   SnapsToDevicePixels="True"
                   UseLayoutRounding="True">

    <Window.Resources>
        <Style x:Key="ModalDismissButtonStyle" TargetType="Button">
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="Width" Value="32" />
            <Setter Property="Height" Value="32" />
            <Setter Property="FocusVisualStyle" Value="{x:Null}" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Border" Background="{TemplateBinding Background}" CornerRadius="{DynamicResource ControlCornerRadius}" SnapsToDevicePixels="True">
                            <Path x:Name="Icon"
                                  Width="10" Height="10"
                                  Data="M 0.5,0.5 L 9.5,9.5 M 0.5,9.5 L 9.5,0.5"
                                  Stroke="#85FFFFFF"
                                  StrokeThickness="1.2"
                                  StrokeStartLineCap="Round"
                                  StrokeEndLineCap="Round"
                                  SnapsToDevicePixels="False"
                                  UseLayoutRounding="False"
                                  HorizontalAlignment="Center"
                                  VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Border" Property="Background" Value="#25FFFFFF" />
                                <Setter TargetName="Icon" Property="Stroke" Value="#FFFFFF" />
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="Border" Property="Background" Value="#35FFFFFF" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="SubtleActionButtonStyle" TargetType="Button">
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="FocusVisualStyle" Value="{x:Null}" />
            <Setter Property="Padding" Value="0" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border Background="{TemplateBinding Background}" SnapsToDevicePixels="True">
                            <ContentPresenter HorizontalAlignment="Left" VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter Property="Opacity" Value="1.0" />
                            </Trigger>
                            <Trigger Property="IsMouseOver" Value="False">
                                <Setter Property="Opacity" Value="0.75" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="FluentGlassSearchInputStyle" TargetType="TextBox">
            <Setter Property="OverridesDefaultStyle" Value="True" />
            <Setter Property="Height" Value="36" />
            <Setter Property="FontSize" Value="{DynamicResource TypeBodyFontSize}" />
            <Setter Property="FontWeight" Value="{DynamicResource TypeBodyFontWeight}" />
            <Setter Property="Foreground" Value="#FFFFFF" />
            <Setter Property="CaretBrush" Value="#FFFFFF" />
            <Setter Property="FocusVisualStyle" Value="{x:Null}" />
            <Setter Property="SnapsToDevicePixels" Value="True" />
            <Setter Property="UseLayoutRounding" Value="True" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="TextBox">
                        <Border x:Name="BoxBorder"
                                Background="#14FFFFFF"
                                BorderBrush="#28FFFFFF"
                                BorderThickness="1"
                                CornerRadius="{DynamicResource ControlCornerRadius}"
                                SnapsToDevicePixels="True">
                            <Grid Margin="10,0,10,0">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>
                                <ui:SymbolIcon x:Name="PrefixIcon"
                                               Symbol="Search24"
                                               FontSize="14"
                                               Foreground="#85FFFFFF"
                                               VerticalAlignment="Center"
                                               Margin="0,0,8,0" />
                                <ScrollViewer x:Name="PART_ContentHost"
                                              Grid.Column="1"
                                              VerticalAlignment="Center"
                                              Focusable="False"
                                              HorizontalScrollBarVisibility="Hidden"
                                              VerticalScrollBarVisibility="Hidden" />
                            </Grid>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="BoxBorder" Property="Background" Value="#1CFFFFFF" />
                                <Setter TargetName="BoxBorder" Property="BorderBrush" Value="#45FFFFFF" />
                                <Setter TargetName="PrefixIcon" Property="Foreground" Value="#B0FFFFFF" />
                            </Trigger>
                            <Trigger Property="IsKeyboardFocused" Value="True">
                                <Setter TargetName="BoxBorder" Property="Background" Value="#22FFFFFF" />
                                <Setter TargetName="BoxBorder" Property="BorderBrush" Value="#65FFFFFF" />
                                <Setter TargetName="PrefixIcon" Property="Foreground" Value="#FFFFFF" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="SuggestionListBoxItemStyle" TargetType="ListBoxItem">
            <Setter Property="OverridesDefaultStyle" Value="True" />
            <Setter Property="FocusVisualStyle" Value="{x:Null}" />
            <Setter Property="Padding" Value="10,6,10,6" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ListBoxItem">
                        <Border x:Name="ItemBorder"
                                Background="Transparent"
                                CornerRadius="{DynamicResource ControlCornerRadius}"
                                Margin="2,1,2,1"
                                Padding="{TemplateBinding Padding}"
                                SnapsToDevicePixels="True">
                            <ContentPresenter />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="ItemBorder" Property="Background" Value="#1CFFFFFF" />
                            </Trigger>
                            <Trigger Property="IsSelected" Value="True">
                                <Setter TargetName="ItemBorder" Property="Background" Value="#2AFFFFFF" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <DataTemplate x:Key="SuggestionItemTemplate">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <TextBlock Text="{Binding Name}"
                           FontSize="{DynamicResource TypeBodyFontSize}"
                           FontWeight="{DynamicResource TypeBodyStrongFontWeight}"
                           Foreground="#FFFFFF"
                           VerticalAlignment="Center"
                           TextTrimming="CharacterEllipsis" />
                <TextBlock Grid.Column="1"
                           Text="{Binding DisplaySubtitle}"
                           FontSize="{DynamicResource TypeCaptionFontSize}"
                           FontWeight="{DynamicResource TypeCaptionFontWeight}"
                           Foreground="#75FFFFFF"
                           VerticalAlignment="Center"
                           Margin="8,0,0,0"
                           TextTrimming="CharacterEllipsis" />
            </Grid>
        </DataTemplate>

        <Style x:Key="FluentCohesivePrimaryButtonStyle" TargetType="Button">
            <Setter Property="OverridesDefaultStyle" Value="True" />
            <Setter Property="Height" Value="32" />
            <Setter Property="MinWidth" Value="110" />
            <Setter Property="Padding" Value="14,0" />
            <Setter Property="FontSize" Value="{DynamicResource TypeBodyStrongFontSize}" />
            <Setter Property="FontWeight" Value="{DynamicResource TypeBodyStrongFontWeight}" />
            <Setter Property="Foreground" Value="#FFFFFF" />
            <Setter Property="FocusVisualStyle" Value="{x:Null}" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="BtnBorder"
                                Background="{DynamicResource SystemAccentColorPrimaryBrush}"
                                CornerRadius="{DynamicResource ControlCornerRadius}"
                                SnapsToDevicePixels="True">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="BtnBorder" Property="Background" Value="{DynamicResource SystemAccentColorSecondaryBrush}" />
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="BtnBorder" Property="Background" Value="{DynamicResource SystemAccentColorTertiaryBrush}" />
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter TargetName="BtnBorder" Property="Opacity" Value="0.4" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="FluentCohesiveSecondaryButtonStyle" TargetType="Button">
            <Setter Property="OverridesDefaultStyle" Value="True" />
            <Setter Property="Height" Value="32" />
            <Setter Property="MinWidth" Value="80" />
            <Setter Property="Padding" Value="14,0" />
            <Setter Property="FontSize" Value="{DynamicResource TypeCaptionFontSize}" />
            <Setter Property="FontWeight" Value="{DynamicResource TypeCaptionFontWeight}" />
            <Setter Property="Foreground" Value="#E0FFFFFF" />
            <Setter Property="FocusVisualStyle" Value="{x:Null}" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="BtnBorder"
                                Background="#1AFFFFFF"
                                BorderBrush="#25FFFFFF"
                                BorderThickness="1"
                                CornerRadius="{DynamicResource ControlCornerRadius}"
                                SnapsToDevicePixels="True">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="BtnBorder" Property="Background" Value="#28FFFFFF" />
                                <Setter TargetName="BtnBorder" Property="BorderBrush" Value="#40FFFFFF" />
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="BtnBorder" Property="Background" Value="#35FFFFFF" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>

    <!-- Borderless Window Wrapper -->
    <Border Background="Transparent"
            BorderThickness="0"
            CornerRadius="{DynamicResource ControlCornerRadius}"
            SnapsToDevicePixels="True">
        <Grid RenderOptions.ClearTypeHint="Enabled">
            <Grid.ColumnDefinitions>
                <!-- COLUMN 0: FROSTED ACRYLIC SIDEBAR -->
                <ColumnDefinition Width="155" />
                <!-- COLUMN 1: OBSIDIAN DARK CONTENT PANEL -->
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>

            <!-- ========================================================= -->
            <!-- COLUMN 0: FROSTED ACRYLIC SIDEBAR                        -->
            <!-- ========================================================= -->
            <Grid Grid.Column="0"
                  Background="Transparent">
                <Grid HorizontalAlignment="Center" VerticalAlignment="Center">
                    <Border Background="Transparent"
                            BorderThickness="0"
                            HorizontalAlignment="Center"
                            VerticalAlignment="Center">
                        <Image Source="/Assets/Weather/Glassmorphic/cloudy-and-rainny.png"
                               Width="72"
                               Height="72"
                               Stretch="Uniform"
                               HorizontalAlignment="Center"
                               VerticalAlignment="Center"
                               RenderOptions.BitmapScalingMode="HighQuality" />
                    </Border>
                </Grid>
            </Grid>

            <!-- COLUMN 1: Content Panel -->
            <Border Grid.Column="1"
                    Background="#232323"
                    CornerRadius="0,2,2,0"
                    RenderOptions.ClearTypeHint="Enabled">
                <Grid Margin="24,20,24,20">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>

                    <!-- Header -->
                    <Grid Grid.Row="0" Margin="0,0,0,18">
                        <TextBlock Text="Change Location"
                                   FontSize="{DynamicResource TypeHeaderFontSize}"
                                   FontWeight="{DynamicResource TypeHeaderFontWeight}"
                                   Foreground="#FFFFFF"
                                   VerticalAlignment="Center" />

                        <Button HorizontalAlignment="Right"
                                Style="{StaticResource ModalDismissButtonStyle}"
                                Click="OnCloseButtonClick" />
                    </Grid>

                    <!-- Body -->
                    <Grid Grid.Row="1">
                        <StackPanel>
                            <TextBlock Text="City Name"
                                       FontSize="{DynamicResource TypeCaptionFontSize}"
                                       FontWeight="{DynamicResource TypeCaptionFontWeight}"
                                       Foreground="#95FFFFFF"
                                       Margin="0,0,0,6" />

                            <Grid>
                                <TextBox x:Name="WeatherCityInput"
                                         Style="{StaticResource FluentGlassSearchInputStyle}"
                                         PreviewKeyDown="OnWeatherInputPreviewKeyDown"
                                         TextChanged="OnWeatherInputTextChanged" />

                                <Popup x:Name="WeatherSuggestionsPopup"
                                       PlacementTarget="{Binding ElementName=WeatherCityInput}"
                                       Placement="Bottom"
                                       VerticalOffset="-1"
                                       HorizontalOffset="0"
                                       StaysOpen="False"
                                       IsOpen="False"
                                       AllowsTransparency="True"
                                       PopupAnimation="Fade">
                                    <Border Width="{Binding ActualWidth, ElementName=WeatherCityInput}"
                                            Background="#232323"
                                            BorderBrush="#40FFFFFF"
                                            BorderThickness="1"
                                            CornerRadius="0,0,2,2"
                                            SnapsToDevicePixels="True">
                                        <ListBox x:Name="WeatherSuggestionsList"
                                                 Background="Transparent"
                                                 BorderThickness="0"
                                                 Padding="0,2,0,2"
                                                 ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                                                 ScrollViewer.VerticalScrollBarVisibility="Auto"
                                                 controls:AutoHideScrollBehavior.IsEnabled="True"
                                                 MaxHeight="172"
                                                 ItemContainerStyle="{StaticResource SuggestionListBoxItemStyle}"
                                                 ItemTemplate="{StaticResource SuggestionItemTemplate}"
                                                 PreviewMouseLeftButtonUp="OnSuggestionListMouseUp"
                                                 PreviewKeyDown="OnSuggestionsListPreviewKeyDown">
                                            <ListBox.Resources>
                                                <Style TargetType="{x:Type ScrollBar}" BasedOn="{StaticResource WidgetFloatingScrollBarStyle}" />
                                            </ListBox.Resources>
                                        </ListBox>
                                    </Border>
                                </Popup>
                            </Grid>

                            <Button Margin="0,12,0,0"
                                    Style="{StaticResource SubtleActionButtonStyle}"
                                    Click="OnWeatherAutoLocationClick">
                                <StackPanel Orientation="Horizontal">
                                    <ui:SymbolIcon Symbol="MyLocation24" FontSize="13" Foreground="#95FFFFFF" Margin="0,0,6,0" VerticalAlignment="Center" />
                                    <TextBlock Text="Reset to automatic location (GPS / IP)"
                                               FontSize="{DynamicResource TypeCaptionFontSize}"
                                               FontWeight="{DynamicResource TypeCaptionFontWeight}"
                                               Foreground="#95FFFFFF"
                                               VerticalAlignment="Center" />
                                </StackPanel>
                            </Button>

                            <StackPanel Orientation="Horizontal" Margin="0,12,0,0">
                                <ui:ProgressRing x:Name="WeatherActionSpinner"
                                                 Width="14" Height="14"
                                                 IsIndeterminate="True"
                                                 Visibility="Collapsed"
                                                 Margin="0,0,6,0" />
                                <TextBlock x:Name="WeatherStatusMessage"
                                           FontSize="{DynamicResource TypeCaptionFontSize}"
                                           FontWeight="{DynamicResource TypeCaptionFontWeight}"
                                           Foreground="#FF8080"
                                           TextWrapping="Wrap"
                                           Visibility="Collapsed" />
                            </StackPanel>
                        </StackPanel>
                    </Grid>

                    <!-- Footer -->
                    <Grid Grid.Row="2" Margin="0,16,0,0">
                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                            <Button Content="Save Location"
                                    Style="{StaticResource FluentCohesivePrimaryButtonStyle}"
                                    Margin="0,0,8,0"
                                    Click="OnSaveLocationClick" />
                            <Button Content="Cancel"
                                    Style="{StaticResource FluentCohesiveSecondaryButtonStyle}"
                                    Click="OnCloseButtonClick" />
                        </StackPanel>
                    </Grid>
                </Grid>
            </Border>
        </Grid>
    </Border>
</ui:FluentWindow>
