<UserControl x:Class="MetroHub.Presentation.Controls.GlyphPresenter"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
             x:Name="Root"
             Background="Transparent"
             Focusable="False">
    <Grid HorizontalAlignment="Center" VerticalAlignment="Center">
        <ui:SymbolIcon x:Name="PART_Symbol"
                       FontSize="{Binding GlyphSize, ElementName=Root}"
                       Foreground="{Binding Foreground, ElementName=Root}"
                       HorizontalAlignment="Center"
                       VerticalAlignment="Center"
                       Visibility="Collapsed" />
        <TextBlock x:Name="PART_Emoji"
                   FontSize="{Binding GlyphSize, ElementName=Root}"
                   FontFamily="Segoe UI Emoji, Segoe UI Variable, Arial, Segoe UI Symbol"
                   Foreground="{Binding Foreground, ElementName=Root}"
                   HorizontalAlignment="Center"
                   VerticalAlignment="Center"
                   TextAlignment="Center"
                   Visibility="Collapsed" />
    </Grid>
</UserControl>
