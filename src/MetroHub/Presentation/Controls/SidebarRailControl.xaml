<UserControl x:Class="MetroHub.Presentation.Controls.SidebarRailControl"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
             mc:Ignorable="d" 
             Width="48"
             Focusable="False"
             Background="Transparent">

    <UserControl.Resources>
        <!-- Modern Windows 11 Fluent Rail Button Style -->
        <Style x:Key="RailButtonStyle" TargetType="Button">
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="Width" Value="48" />
            <Setter Property="Height" Value="42" />
            <Setter Property="Margin" Value="0,1" />
            <Setter Property="Padding" Value="0" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="FocusVisualStyle" Value="{x:Null}" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Grid Background="Transparent">
                            <!-- Hover / Active Background Pill -->
                            <Border x:Name="PillBorder"
                                    Margin="4,1"
                                    CornerRadius="2"
                                    Background="Transparent"
                                    SnapsToDevicePixels="True">
                                <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                            </Border>

                            <!-- Active Left Accent Indicator Bar (3px) -->
                            <Border x:Name="ActiveIndicator"
                                    Width="3"
                                    Height="16"
                                    CornerRadius="1"
                                    HorizontalAlignment="Left"
                                    VerticalAlignment="Center"
                                    Margin="1,0,0,0"
                                    Background="{DynamicResource SystemAccentColorPrimaryBrush}"
                                    Visibility="Collapsed" />
                        </Grid>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="PillBorder" Property="Background" Value="#18FFFFFF" />
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="PillBorder" Property="Background" Value="#2CFFFFFF" />
                            </Trigger>
                            <Trigger Property="Tag" Value="Active">
                                <Setter TargetName="ActiveIndicator" Property="Visibility" Value="Visible" />
                                <Setter TargetName="PillBorder" Property="Background" Value="#14FFFFFF" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Clean Dark Tooltip Style -->
        <Style TargetType="ToolTip">
            <Setter Property="Background" Value="#E6202023" />
            <Setter Property="Foreground" Value="#F5FFFFFF" />
            <Setter Property="BorderBrush" Value="#30FFFFFF" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="Padding" Value="10,6" />
            <Setter Property="FontSize" Value="12" />
            <Setter Property="FontFamily" Value="Segoe UI Variable Text, Segoe UI Variable, Segoe UI, sans-serif" />
            <Setter Property="FontWeight" Value="Normal" />
            <Setter Property="TextOptions.TextFormattingMode" Value="Display" />
            <Setter Property="TextOptions.TextRenderingMode" Value="ClearType" />
            <Setter Property="HasDropShadow" Value="True" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ToolTip">
                        <Border Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="5"
                                Padding="{TemplateBinding Padding}">
                            <ContentPresenter />
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </UserControl.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <!-- Top Section: App List Icon -->
            <RowDefinition Height="Auto" />
            <!-- Middle Spacer -->
            <RowDefinition Height="*" />
            <!-- Bottom Section: System and Folder Shortcuts -->
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <!-- Top Section: Single App List Toggle Button -->
        <StackPanel Grid.Row="0" Margin="0,12,0,0">
            <Button x:Name="AppsToggleButton"
                    Style="{StaticResource RailButtonStyle}"
                    ToolTip="All apps"
                    Click="OnAppsToggleClick">
                <ui:SymbolIcon Symbol="AppsList24" FontSize="20" Foreground="#E0FFFFFF" />
            </Button>
        </StackPanel>

        <!-- Bottom Section: Matching Screenshot 1 -->
        <StackPanel Grid.Row="2" Margin="0,0,0,10">
            <!-- User Account -->
            <Button x:Name="UserButton"
                    Style="{StaticResource RailButtonStyle}"
                    ToolTip="Account"
                    Click="OnUserClick">
                <ui:SymbolIcon Symbol="Person24" FontSize="19" Foreground="#C8FFFFFF" />
            </Button>

            <!-- Documents -->
            <Button x:Name="DocumentsButton"
                    Style="{StaticResource RailButtonStyle}"
                    ToolTip="Documents"
                    Click="OnDocumentsClick">
                <ui:SymbolIcon Symbol="Document24" FontSize="19" Foreground="#C8FFFFFF" />
            </Button>

            <!-- Downloads -->
            <Button x:Name="DownloadsButton"
                    Style="{StaticResource RailButtonStyle}"
                    ToolTip="Downloads"
                    Click="OnDownloadsClick">
                <ui:SymbolIcon Symbol="ArrowDownload24" FontSize="19" Foreground="#C8FFFFFF" />
            </Button>

            <!-- Music -->
            <Button x:Name="MusicButton"
                    Style="{StaticResource RailButtonStyle}"
                    ToolTip="Music"
                    Click="OnMusicClick">
                <ui:SymbolIcon Symbol="MusicNote224" FontSize="19" Foreground="#C8FFFFFF" />
            </Button>

            <!-- Pictures -->
            <Button x:Name="PicturesButton"
                    Style="{StaticResource RailButtonStyle}"
                    ToolTip="Pictures"
                    Click="OnPicturesClick">
                <ui:SymbolIcon Symbol="Image24" FontSize="19" Foreground="#C8FFFFFF" />
            </Button>

            <!-- Videos / Folders -->
            <Button x:Name="VideosButton"
                    Style="{StaticResource RailButtonStyle}"
                    ToolTip="Videos"
                    Click="OnVideosClick">
                <ui:SymbolIcon Symbol="Folder24" FontSize="19" Foreground="#C8FFFFFF" />
            </Button>

            <!-- Quick Controls -->
            <Button x:Name="ControlsButton"
                    Style="{StaticResource RailButtonStyle}"
                    ToolTip="Control Panel"
                    Click="OnControlsClick">
                <ui:SymbolIcon Symbol="Options24" FontSize="19" Foreground="#C8FFFFFF" />
            </Button>

            <!-- Settings -->
            <Button x:Name="SettingsButton"
                    Style="{StaticResource RailButtonStyle}"
                    ToolTip="Settings"
                    Click="OnSettingsClick">
                <ui:SymbolIcon Symbol="Settings24" FontSize="19" Foreground="#C8FFFFFF" />
            </Button>

            <!-- Windows Security -->
            <Button x:Name="SecurityButton"
                    Style="{StaticResource RailButtonStyle}"
                    ToolTip="Windows Security"
                    Click="OnSecurityClick">
                <ui:SymbolIcon Symbol="Shield24" FontSize="19" Foreground="#C8FFFFFF" />
            </Button>

            <!-- Power Button with Flyout Menu -->
            <Button x:Name="PowerButton"
                    Style="{StaticResource RailButtonStyle}"
                    ToolTip="Power"
                    Click="OnPowerClick">
                <ui:SymbolIcon Symbol="Power24" FontSize="19" Foreground="#C8FFFFFF" />
                <Button.ContextMenu>
                    <ContextMenu x:Name="PowerContextMenu">
                        <MenuItem Header="Sleep" Click="OnSleepClick">
                            <MenuItem.Icon>
                                <ui:SymbolIcon Symbol="WeatherMoon24" FontSize="18" />
                            </MenuItem.Icon>
                        </MenuItem>
                        <MenuItem Header="Shut down" Click="OnShutdownClick">
                            <MenuItem.Icon>
                                <ui:SymbolIcon Symbol="Power24" FontSize="18" />
                            </MenuItem.Icon>
                        </MenuItem>
                        <MenuItem Header="Restart" Click="OnRestartClick">
                            <MenuItem.Icon>
                                <ui:SymbolIcon Symbol="ArrowCounterclockwise24" FontSize="18" />
                            </MenuItem.Icon>
                        </MenuItem>
                        <Separator />
                        <MenuItem Header="Lock" Click="OnLockClick">
                            <MenuItem.Icon>
                                <ui:SymbolIcon Symbol="LockClosed24" FontSize="18" />
                            </MenuItem.Icon>
                        </MenuItem>
                    </ContextMenu>
                </Button.ContextMenu>
            </Button>
        </StackPanel>
    </Grid>
</UserControl>
