<UserControl x:Class="MetroHub.Presentation.Controls.GroupHeaderControl"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
             mc:Ignorable="d" 
             Focusable="False"
             Cursor="Arrow">

    <Border x:Name="RootBorder"
            Margin="-6,0,0,0"
            Padding="6,4,6,4"
            CornerRadius="{DynamicResource ControlCornerRadius}"
            Background="Transparent"
            PreviewMouseLeftButtonDown="OnHeaderPreviewMouseDown"
            PreviewMouseMove="OnHeaderPreviewMouseMove"
            PreviewMouseLeftButtonUp="OnHeaderPreviewMouseUp"
            MouseEnter="OnMouseEnter"
            MouseLeave="OnMouseLeave">

        <Border.Style>
            <Style TargetType="Border">
                <Setter Property="Background" Value="Transparent"/>
                <Style.Triggers>
                    <Trigger Property="IsMouseOver" Value="True">
                        <Setter Property="Background" Value="{DynamicResource FluentHoverBrush}"/>
                    </Trigger>
                </Style.Triggers>
            </Style>
        </Border.Style>

        <Border.ContextMenu>
            <ContextMenu x:Name="HeaderContextMenu" Opened="OnHeaderContextMenuOpened">
                <MenuItem x:Name="RenameMenuItem" Header="Rename Group" Click="OnRenameClick">
                    <MenuItem.Icon>
                        <ui:SymbolIcon Symbol="Edit24" FontSize="18" />
                    </MenuItem.Icon>
                </MenuItem>

                <MenuItem x:Name="HeaderColorMenuItem" Header="Header Color">
                    <MenuItem.Icon>
                        <ui:SymbolIcon Symbol="Color24" FontSize="18" />
                    </MenuItem.Icon>
                    <MenuItem Header="Default White" Tag="#F0FFFFFF" Click="OnColorSelectClick">
                        <MenuItem.Icon><Ellipse Width="12" Height="12" Fill="#F0FFFFFF"/></MenuItem.Icon>
                    </MenuItem>
                    <MenuItem Header="Fluent Sky Blue" Tag="#60CDFF" Click="OnColorSelectClick">
                        <MenuItem.Icon><Ellipse Width="12" Height="12" Fill="#60CDFF"/></MenuItem.Icon>
                    </MenuItem>
                    <MenuItem Header="Electric Azure" Tag="#0078D7" Click="OnColorSelectClick">
                        <MenuItem.Icon><Ellipse Width="12" Height="12" Fill="#0078D7"/></MenuItem.Icon>
                    </MenuItem>
                    <MenuItem Header="Emerald Green" Tag="#107C10" Click="OnColorSelectClick">
                        <MenuItem.Icon><Ellipse Width="12" Height="12" Fill="#107C10"/></MenuItem.Icon>
                    </MenuItem>
                    <MenuItem Header="Mint Cyan" Tag="#00B7C3" Click="OnColorSelectClick">
                        <MenuItem.Icon><Ellipse Width="12" Height="12" Fill="#00B7C3"/></MenuItem.Icon>
                    </MenuItem>
                    <MenuItem Header="Neon Orange" Tag="#FF8C00" Click="OnColorSelectClick">
                        <MenuItem.Icon><Ellipse Width="12" Height="12" Fill="#FF8C00"/></MenuItem.Icon>
                    </MenuItem>
                    <MenuItem Header="Electric Amber" Tag="#FFD700" Click="OnColorSelectClick">
                        <MenuItem.Icon><Ellipse Width="12" Height="12" Fill="#FFD700"/></MenuItem.Icon>
                    </MenuItem>
                    <MenuItem Header="Crimson Red" Tag="#FF4343" Click="OnColorSelectClick">
                        <MenuItem.Icon><Ellipse Width="12" Height="12" Fill="#FF4343"/></MenuItem.Icon>
                    </MenuItem>
                    <MenuItem Header="Royal Purple" Tag="#881798" Click="OnColorSelectClick">
                        <MenuItem.Icon><Ellipse Width="12" Height="12" Fill="#881798"/></MenuItem.Icon>
                    </MenuItem>
                    <MenuItem Header="Hot Pink" Tag="#E3008C" Click="OnColorSelectClick">
                        <MenuItem.Icon><Ellipse Width="12" Height="12" Fill="#E3008C"/></MenuItem.Icon>
                    </MenuItem>
                </MenuItem>
                <MenuItem x:Name="TintColorMenuItem" Header="Group Tint Color">
                    <MenuItem.Icon>
                        <ui:SymbolIcon Symbol="PaintBucket24" FontSize="18" Foreground="{DynamicResource TextSecondaryBrush}" />
                    </MenuItem.Icon>
                    <MenuItem Header="None (Transparent)" Tag="None" Click="OnTintColorSelectClick">
                        <MenuItem.Icon><Border Width="12" Height="12" BorderThickness="1" BorderBrush="#80FFFFFF" Background="Transparent" CornerRadius="{DynamicResource ControlCornerRadius}"/></MenuItem.Icon>
                    </MenuItem>
                    <MenuItem Header="Fluent Sky Blue" Tag="#60CDFF" Click="OnTintColorSelectClick">
                        <MenuItem.Icon><Ellipse Width="12" Height="12" Fill="#60CDFF"/></MenuItem.Icon>
                    </MenuItem>
                    <MenuItem Header="Electric Azure" Tag="#0078D7" Click="OnTintColorSelectClick">
                        <MenuItem.Icon><Ellipse Width="12" Height="12" Fill="#0078D7"/></MenuItem.Icon>
                    </MenuItem>
                    <MenuItem Header="Emerald Green" Tag="#107C10" Click="OnTintColorSelectClick">
                        <MenuItem.Icon><Ellipse Width="12" Height="12" Fill="#107C10"/></MenuItem.Icon>
                    </MenuItem>
                    <MenuItem Header="Mint Cyan" Tag="#00B7C3" Click="OnTintColorSelectClick">
                        <MenuItem.Icon><Ellipse Width="12" Height="12" Fill="#00B7C3"/></MenuItem.Icon>
                    </MenuItem>
                    <MenuItem Header="Neon Orange" Tag="#FF8C00" Click="OnTintColorSelectClick">
                        <MenuItem.Icon><Ellipse Width="12" Height="12" Fill="#FF8C00"/></MenuItem.Icon>
                    </MenuItem>
                    <MenuItem Header="Electric Amber" Tag="#FFD700" Click="OnTintColorSelectClick">
                        <MenuItem.Icon><Ellipse Width="12" Height="12" Fill="#FFD700"/></MenuItem.Icon>
                    </MenuItem>
                    <MenuItem Header="Crimson Red" Tag="#FF4343" Click="OnTintColorSelectClick">
                        <MenuItem.Icon><Ellipse Width="12" Height="12" Fill="#FF4343"/></MenuItem.Icon>
                    </MenuItem>
                    <MenuItem Header="Royal Purple" Tag="#881798" Click="OnTintColorSelectClick">
                        <MenuItem.Icon><Ellipse Width="12" Height="12" Fill="#881798"/></MenuItem.Icon>
                    </MenuItem>
                    <MenuItem Header="Hot Pink" Tag="#E3008C" Click="OnTintColorSelectClick">
                        <MenuItem.Icon><Ellipse Width="12" Height="12" Fill="#E3008C"/></MenuItem.Icon>
                    </MenuItem>
                </MenuItem>

                <Separator />

                <MenuItem x:Name="UngroupMenuItem" Header="Ungroup Tiles" Click="OnUngroupClick">
                    <MenuItem.Icon>
                        <ui:SymbolIcon Symbol="SelectAllOn24" FontSize="18" />
                    </MenuItem.Icon>
                </MenuItem>

                <MenuItem x:Name="DeleteGroupMenuItem" Header="Delete Group and Tiles" Click="OnDeleteGroupClick" Foreground="{DynamicResource StatusErrorBrush}">
                    <MenuItem.Icon>
                        <ui:SymbolIcon Symbol="Delete24" FontSize="18" Foreground="{DynamicResource StatusErrorBrush}" />
                    </MenuItem.Icon>
                </MenuItem>
            </ContextMenu>
        </Border.ContextMenu>

        <!-- Root layout: name stretches left, action buttons on right -->
        <Grid>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>

            <!-- Left: Name + drag hint -->
            <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center">
                <!-- Normal Header Label View -->
                <StackPanel x:Name="ViewPanel" Orientation="Horizontal" VerticalAlignment="Center">
                    <TextBlock x:Name="TitleTextBlock"
                               Text="{Binding Title}"
                               FontSize="{DynamicResource TypeSubtitleFontSize}"
                               FontWeight="{DynamicResource TypeSubtitleFontWeight}"
                               FontFamily="{DynamicResource AppDisplayFontFamily}"
                               Foreground="{Binding HeaderColor, TargetNullValue={StaticResource TextPrimaryBrush}, FallbackValue={StaticResource TextPrimaryBrush}}"
                               VerticalAlignment="Center"
                               TextOptions.TextFormattingMode="Ideal"
                               TextOptions.TextRenderingMode="ClearType"
                               TextTrimming="CharacterEllipsis"
                               MaxWidth="260"
                               MouseDown="OnTitleMouseDown" />

                    <!-- Subtle drag / edit indicator on hover -->
                    <ui:SymbolIcon x:Name="DragHintIcon"
                                   Symbol="ReOrder24"
                                   FontSize="17"
                                   Foreground="{DynamicResource TextSubtleBrush}"
                                   Margin="6,0,4,0"
                                   VerticalAlignment="Center"
                                   Opacity="0" />
                </StackPanel>

                <!-- Inline Renaming TextBox: 100% Transparent & Borderless -->
                <TextBox x:Name="EditTextBox"
                         Visibility="Collapsed"
                         FontSize="{DynamicResource TypeSubtitleFontSize}"
                         FontWeight="{DynamicResource TypeSubtitleFontWeight}"
                         FontFamily="{DynamicResource AppDisplayFontFamily}"
                         Foreground="{Binding HeaderColor, TargetNullValue={StaticResource TextPrimaryBrush}, FallbackValue={StaticResource TextPrimaryBrush}}"
                         CaretBrush="{Binding HeaderColor, TargetNullValue='#60CDFF', FallbackValue='#60CDFF'}"
                         Background="Transparent"
                         BorderThickness="0"
                         BorderBrush="Transparent"
                         Padding="0"
                         Margin="0"
                         MinWidth="120"
                         MaxWidth="260"
                         VerticalAlignment="Center"
                         TextOptions.TextFormattingMode="Ideal"
                         TextOptions.TextRenderingMode="ClearType"
                         KeyDown="OnEditKeyDown"
                         LostFocus="OnEditLostFocus">
                    <TextBox.Style>
                        <Style TargetType="TextBox">
                            <Setter Property="Background" Value="Transparent"/>
                            <Setter Property="BorderThickness" Value="0"/>
                            <Setter Property="BorderBrush" Value="Transparent"/>
                            <Setter Property="Template">
                                <Setter.Value>
                                    <ControlTemplate TargetType="TextBox">
                                        <Border Background="Transparent" BorderThickness="0" BorderBrush="Transparent">
                                            <ScrollViewer x:Name="PART_ContentHost" Background="Transparent" />
                                        </Border>
                                    </ControlTemplate>
                                </Setter.Value>
                            </Setter>
                        </Style>
                    </TextBox.Style>
                </TextBox>
            </StackPanel>

            <!-- Right: Lock button (fade in on hover) -->
            <StackPanel Grid.Column="1"
                        x:Name="ActionButtonsPanel"
                        Orientation="Horizontal"
                        VerticalAlignment="Center"
                        Margin="4,0,0,0"
                        Opacity="0">

                <!-- Lock / Unlock button -->
                <Button x:Name="LockButton"
                        Style="{StaticResource WidgetMicroButtonStyle}"
                        ToolTip="Lock group"
                        Click="OnLockClick"
                        PreviewMouseLeftButtonDown="OnActionButtonMouseDown">
                    <ui:SymbolIcon x:Name="LockIcon" Symbol="LockOpen24" FontSize="17"
                                   Foreground="{DynamicResource TextMutedBrush}" />
                </Button>
            </StackPanel>
        </Grid>
    </Border>
</UserControl>
