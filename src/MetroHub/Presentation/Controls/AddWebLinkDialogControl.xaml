<UserControl x:Class="MetroHub.Presentation.Controls.AddWebLinkDialogControl"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
             mc:Ignorable="d" 
             Width="420"
             MinWidth="420"
             Focusable="False"
             SnapsToDevicePixels="True"
             UseLayoutRounding="True"
             TextOptions.TextFormattingMode="Ideal"
             TextOptions.TextRenderingMode="ClearType"
             TextOptions.TextHintingMode="Fixed">

    <UserControl.Resources>
        <!-- Mini Paste Button Style -->
        <Style x:Key="MiniPasteButtonStyle" TargetType="Button">
            <Setter Property="Background" Value="#15FFFFFF" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="Foreground" Value="#B0FFFFFF" />
            <Setter Property="FontSize" Value="11" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="Padding" Value="8,2" />
            <Setter Property="Height" Value="24" />
            <Setter Property="FocusVisualStyle" Value="{x:Null}" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="BtnBorder" Background="{TemplateBinding Background}" CornerRadius="4" SnapsToDevicePixels="True">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" Margin="{TemplateBinding Padding}" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="BtnBorder" Property="Background" Value="#25FFFFFF" />
                                <Setter Property="Foreground" Value="#FFFFFF" />
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="BtnBorder" Property="Background" Value="#35FFFFFF" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </UserControl.Resources>

    <StackPanel Margin="0,4,0,0">
        <!-- 1. Live Icon & Title Preview Card -->
        <Border Background="#12FFFFFF"
                BorderBrush="#20FFFFFF"
                BorderThickness="1"
                CornerRadius="8"
                Padding="14,10"
                Margin="0,0,0,16">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="46" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>

                <!-- Icon Container (42x42) -->
                <Border Grid.Column="0"
                        Width="42"
                        Height="42"
                        CornerRadius="8"
                        Background="#1AFFFFFF"
                        BorderBrush="#20FFFFFF"
                        BorderThickness="1"
                        HorizontalAlignment="Left"
                        VerticalAlignment="Center"
                        SnapsToDevicePixels="True">
                    <Grid>
                        <!-- Real Official High-Res Favicon Image -->
                        <Image x:Name="LivePreviewImage"
                               Width="28"
                               Height="28"
                               HorizontalAlignment="Center"
                               VerticalAlignment="Center"
                               Visibility="Collapsed"
                               RenderOptions.BitmapScalingMode="HighQuality" />

                        <!-- Fallback Vector Globe Icon -->
                        <ui:SymbolIcon x:Name="LivePreviewFallbackIcon"
                                       Symbol="Globe24"
                                       FontSize="22"
                                       Foreground="#60CDFF"
                                       HorizontalAlignment="Center"
                                       VerticalAlignment="Center" />

                        <!-- Subtle Loading Indicator -->
                        <ui:ProgressRing x:Name="LivePreviewSpinner"
                                         Width="18"
                                         Height="18"
                                         IsIndeterminate="False"
                                         HorizontalAlignment="Center"
                                         VerticalAlignment="Center"
                                         Visibility="Collapsed" />
                    </Grid>
                </Border>

                <!-- Site Information -->
                <StackPanel Grid.Column="1" VerticalAlignment="Center" Margin="10,0,0,0">
                    <TextBlock x:Name="LivePreviewTitleText"
                               Text="Website Preview"
                               FontSize="14"
                               FontWeight="SemiBold"
                               Foreground="#FFFFFF"
                               TextTrimming="CharacterEllipsis" />
                    <TextBlock x:Name="LivePreviewDomainText"
                               Text="Enter a URL below..."
                               FontSize="12"
                               Foreground="#80FFFFFF"
                               TextTrimming="CharacterEllipsis"
                               Margin="0,2,0,0" />
                </StackPanel>
            </Grid>
        </Border>

        <!-- 2. URL Input Field -->
        <TextBlock Text="Website URL"
                   FontSize="12"
                   FontWeight="SemiBold"
                   Foreground="#C0FFFFFF"
                   Margin="0,0,0,6" />
        <Border Background="#1CFFFFFF"
                BorderBrush="#35FFFFFF"
                BorderThickness="1"
                CornerRadius="6"
                Height="36"
                Padding="10,0,6,0">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <ui:SymbolIcon Grid.Column="0"
                               Symbol="Globe24"
                               FontSize="16"
                               Foreground="#80FFFFFF"
                               VerticalAlignment="Center"
                               Margin="0,0,8,0" />

                <TextBox x:Name="UrlTextBox"
                         Grid.Column="1"
                         VerticalAlignment="Center"
                         Background="Transparent"
                         BorderThickness="0"
                         Foreground="#FFFFFF"
                         CaretBrush="#60CDFF"
                         FontSize="13"
                         TextChanged="OnUrlTextChanged"
                         KeyDown="OnInputKeyDown" />

                <Button x:Name="PasteButton"
                        Grid.Column="2"
                        Content="Paste"
                        Style="{StaticResource MiniPasteButtonStyle}"
                        VerticalAlignment="Center"
                        Click="OnPasteClick" />
            </Grid>
        </Border>

        <!-- 3. Display Name Input Field -->
        <TextBlock Text="Shortcut Name"
                   FontSize="12"
                   FontWeight="SemiBold"
                   Foreground="#C0FFFFFF"
                   Margin="0,14,0,6" />
        <Border Background="#1CFFFFFF"
                BorderBrush="#35FFFFFF"
                BorderThickness="1"
                CornerRadius="6"
                Height="36"
                Padding="10,0,6,0">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>

                <ui:SymbolIcon Grid.Column="0"
                               Symbol="Rename24"
                               FontSize="16"
                               Foreground="#80FFFFFF"
                               VerticalAlignment="Center"
                               Margin="0,0,8,0" />

                <TextBox x:Name="TitleTextBox"
                         Grid.Column="1"
                         VerticalAlignment="Center"
                         Background="Transparent"
                         BorderThickness="0"
                         Foreground="#FFFFFF"
                         CaretBrush="#60CDFF"
                         FontSize="13"
                         TextChanged="OnTitleTextChanged"
                         KeyDown="OnInputKeyDown" />
            </Grid>
        </Border>

        <!-- 4. Destination Checkboxes -->
        <StackPanel Orientation="Horizontal" Margin="0,16,0,8">
            <CheckBox x:Name="AddToCanvasCheck"
                      Content="Add to Canvas"
                      IsChecked="True"
                      Foreground="#E5FFFFFF"
                      FontSize="13"
                      Margin="0,0,24,0" />
            <CheckBox x:Name="AddToSidebarCheck"
                      Content="Pin to Sidebar"
                      IsChecked="True"
                      Foreground="#E5FFFFFF"
                      FontSize="13" />
        </StackPanel>
    </StackPanel>
</UserControl>
