<ui:FluentWindow x:Class="MetroHub.Presentation.Controls.RadioStationDialog"
                    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
                    xmlns:controls="clr-namespace:MetroHub.Presentation.Controls"
                    WindowBackdropType="Acrylic"
                    WindowCornerPreference="DoNotRound"
                    ExtendsContentIntoTitleBar="True"
                    WindowStyle="None"
                    ResizeMode="NoResize"
                    ShowInTaskbar="False"
                    WindowStartupLocation="CenterOwner"
                    Width="620"
                    Height="420"
                    Background="Transparent"
                    Foreground="#FFFFFF"
                    FontFamily="{DynamicResource AppFontFamily}"
                    RenderOptions.ClearTypeHint="Enabled"
                    TextOptions.TextFormattingMode="Ideal"
                    TextOptions.TextRenderingMode="ClearType"
                    TextOptions.TextHintingMode="Auto"
                    SnapsToDevicePixels="True"
                    UseLayoutRounding="True">

    <Window.Resources>
        <Style x:Key="ModalDismissButtonStyle" TargetType="Button">
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="Width" Value="32" />
            <Setter Property="Height" Value="32" />
            <Setter Property="FocusVisualStyle" Value="{x:Null}" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Border" Background="{TemplateBinding Background}" CornerRadius="{DynamicResource ControlCornerRadius}" SnapsToDevicePixels="True">
                            <Path x:Name="Icon"
                                  Width="10" Height="10"
                                  Data="M 0.5,0.5 L 9.5,9.5 M 0.5,9.5 L 9.5,0.5"
                                  Stroke="#85FFFFFF"
                                  StrokeThickness="1.2"
                                  StrokeStartLineCap="Round"
                                  StrokeEndLineCap="Round"
                                  SnapsToDevicePixels="False"
                                  UseLayoutRounding="False"
                                  RenderOptions.EdgeMode="Unspecified"
                                  HorizontalAlignment="Center"
                                  VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Border" Property="Background" Value="#25FFFFFF" />
                                <Setter TargetName="Icon" Property="Stroke" Value="#FFFFFF" />
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="Border" Property="Background" Value="#35FFFFFF" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="FluentGlassSearchInputStyle" TargetType="TextBox">
            <Setter Property="OverridesDefaultStyle" Value="True" />
            <Setter Property="Height" Value="36" />
            <Setter Property="FontSize" Value="12.5" />
            <Setter Property="Foreground" Value="#FFFFFF" />
            <Setter Property="CaretBrush" Value="#FFFFFF" />
            <Setter Property="SelectionBrush" Value="#40FFFFFF" />
            <Setter Property="SelectionOpacity" Value="0.6" />
            <Setter Property="FocusVisualStyle" Value="{x:Null}" />
            <Setter Property="SnapsToDevicePixels" Value="True" />
            <Setter Property="UseLayoutRounding" Value="True" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="TextBox">
                        <Border x:Name="BoxBorder"
                                Background="#14FFFFFF"
                                BorderBrush="#28FFFFFF"
                                BorderThickness="1"
                                CornerRadius="{DynamicResource ControlCornerRadius}"
                                SnapsToDevicePixels="True">
                            <Grid Margin="10,0,10,0">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>
                                <ui:SymbolIcon x:Name="PrefixIcon"
                                               Symbol="Search24"
                                               FontSize="14"
                                               Foreground="#85FFFFFF"
                                               VerticalAlignment="Center"
                                               Margin="0,0,8,0" />
                                <ScrollViewer x:Name="PART_ContentHost"
                                              Grid.Column="1"
                                              VerticalAlignment="Center"
                                              Focusable="False"
                                              HorizontalScrollBarVisibility="Hidden"
                                              VerticalScrollBarVisibility="Hidden" />
                            </Grid>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="BoxBorder" Property="Background" Value="#1CFFFFFF" />
                                <Setter TargetName="BoxBorder" Property="BorderBrush" Value="#45FFFFFF" />
                                <Setter TargetName="PrefixIcon" Property="Foreground" Value="#B0FFFFFF" />
                            </Trigger>
                            <Trigger Property="IsKeyboardFocused" Value="True">
                                <Setter TargetName="BoxBorder" Property="Background" Value="#22FFFFFF" />
                                <Setter TargetName="BoxBorder" Property="BorderBrush" Value="#65FFFFFF" />
                                <Setter TargetName="PrefixIcon" Property="Foreground" Value="#FFFFFF" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="FluentGlassInputStyle" TargetType="TextBox">
            <Setter Property="OverridesDefaultStyle" Value="True" />
            <Setter Property="Height" Value="36" />
            <Setter Property="FontSize" Value="12.5" />
            <Setter Property="Foreground" Value="#FFFFFF" />
            <Setter Property="CaretBrush" Value="#FFFFFF" />
            <Setter Property="FocusVisualStyle" Value="{x:Null}" />
            <Setter Property="SnapsToDevicePixels" Value="True" />
            <Setter Property="UseLayoutRounding" Value="True" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="TextBox">
                        <Border x:Name="BoxBorder"
                                Background="#14FFFFFF"
                                BorderBrush="#28FFFFFF"
                                BorderThickness="1"
                                CornerRadius="{DynamicResource ControlCornerRadius}"
                                SnapsToDevicePixels="True">
                            <Grid Margin="10,0,10,0">
                                <ScrollViewer x:Name="PART_ContentHost"
                                              VerticalAlignment="Center"
                                              Focusable="False"
                                              HorizontalScrollBarVisibility="Hidden"
                                              VerticalScrollBarVisibility="Hidden" />
                            </Grid>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="BoxBorder" Property="Background" Value="#1CFFFFFF" />
                                <Setter TargetName="BoxBorder" Property="BorderBrush" Value="#45FFFFFF" />
                            </Trigger>
                            <Trigger Property="IsKeyboardFocused" Value="True">
                                <Setter TargetName="BoxBorder" Property="Background" Value="#22FFFFFF" />
                                <Setter TargetName="BoxBorder" Property="BorderBrush" Value="#65FFFFFF" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="FluentGlassUrlWithPasteInputStyle" TargetType="TextBox">
            <Setter Property="OverridesDefaultStyle" Value="True" />
            <Setter Property="Height" Value="36" />
            <Setter Property="FontSize" Value="12.5" />
            <Setter Property="Foreground" Value="#FFFFFF" />
            <Setter Property="CaretBrush" Value="#FFFFFF" />
            <Setter Property="FocusVisualStyle" Value="{x:Null}" />
            <Setter Property="SnapsToDevicePixels" Value="True" />
            <Setter Property="UseLayoutRounding" Value="True" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="TextBox">
                        <Border x:Name="BoxBorder"
                                Background="#14FFFFFF"
                                BorderBrush="#28FFFFFF"
                                BorderThickness="1"
                                CornerRadius="{DynamicResource ControlCornerRadius}"
                                SnapsToDevicePixels="True">
                            <Grid Margin="10,0,80,0">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>
                                <ui:SymbolIcon x:Name="PrefixIcon"
                                               Symbol="Link24"
                                               FontSize="14"
                                               Foreground="#85FFFFFF"
                                               VerticalAlignment="Center"
                                               Margin="0,0,8,0" />
                                <ScrollViewer x:Name="PART_ContentHost"
                                              Grid.Column="1"
                                              VerticalAlignment="Center"
                                              Focusable="False"
                                              HorizontalScrollBarVisibility="Hidden"
                                              VerticalScrollBarVisibility="Hidden" />
                            </Grid>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="BoxBorder" Property="Background" Value="#1CFFFFFF" />
                                <Setter TargetName="BoxBorder" Property="BorderBrush" Value="#45FFFFFF" />
                                <Setter TargetName="PrefixIcon" Property="Foreground" Value="#B0FFFFFF" />
                            </Trigger>
                            <Trigger Property="IsKeyboardFocused" Value="True">
                                <Setter TargetName="BoxBorder" Property="Background" Value="#22FFFFFF" />
                                <Setter TargetName="BoxBorder" Property="BorderBrush" Value="#65FFFFFF" />
                                <Setter TargetName="PrefixIcon" Property="Foreground" Value="#FFFFFF" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="FluentSegmentedTabRadioButtonStyle" TargetType="RadioButton">
            <Setter Property="OverridesDefaultStyle" Value="True" />
            <Setter Property="FocusVisualStyle" Value="{x:Null}" />
            <Setter Property="Height" Value="28" />
            <Setter Property="FontSize" Value="12" />
            <Setter Property="Foreground" Value="#80FFFFFF" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="HorizontalContentAlignment" Value="Center" />
            <Setter Property="VerticalContentAlignment" Value="Center" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="RadioButton">
                        <Border x:Name="TabBorder"
                                Background="Transparent"
                                CornerRadius="{DynamicResource ControlCornerRadius}"
                                Padding="14,0"
                                SnapsToDevicePixels="True">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="TabBorder" Property="Background" Value="#15FFFFFF" />
                                <Setter Property="Foreground" Value="#B0FFFFFF" />
                            </Trigger>
                            <Trigger Property="IsChecked" Value="True">
                                <Setter TargetName="TabBorder" Property="Background" Value="#25FFFFFF" />
                                <Setter Property="Foreground" Value="#FFFFFF" />
                                <Setter Property="FontWeight" Value="SemiBold" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="FluentGlassRadioButtonStyle" TargetType="RadioButton">
            <Setter Property="OverridesDefaultStyle" Value="True" />
            <Setter Property="FocusVisualStyle" Value="{x:Null}" />
            <Setter Property="VerticalContentAlignment" Value="Center" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="RadioButton">
                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                            <Grid Width="16" Height="16" Margin="0,0,8,0" VerticalAlignment="Center">
                                <Ellipse x:Name="OuterRing"
                                         Width="16" Height="16"
                                         Stroke="#45FFFFFF"
                                         StrokeThickness="1.2"
                                         Fill="#10FFFFFF"
                                         SnapsToDevicePixels="False"
                                         UseLayoutRounding="False"
                                         RenderOptions.EdgeMode="Unspecified" />
                                <Ellipse x:Name="InnerDot"
                                         Width="8" Height="8"
                                         Fill="{DynamicResource SystemAccentColorPrimaryBrush}"
                                         Opacity="0"
                                         SnapsToDevicePixels="False"
                                         UseLayoutRounding="False"
                                         RenderOptions.EdgeMode="Unspecified"
                                         HorizontalAlignment="Center"
                                         VerticalAlignment="Center" />
                            </Grid>
                            <ContentPresenter VerticalAlignment="{TemplateBinding VerticalContentAlignment}" />
                        </StackPanel>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="OuterRing" Property="Stroke" Value="#80FFFFFF" />
                                <Setter TargetName="OuterRing" Property="Fill" Value="#1CFFFFFF" />
                            </Trigger>
                            <Trigger Property="IsChecked" Value="True">
                                <Setter TargetName="OuterRing" Property="Stroke" Value="{DynamicResource SystemAccentColorPrimaryBrush}" />
                                <Setter TargetName="OuterRing" Property="Fill" Value="{DynamicResource SystemAccentColorTertiaryBrush}" />
                                <Setter TargetName="InnerDot" Property="Opacity" Value="1.0" />
                            </Trigger>
                            <MultiTrigger>
                                <MultiTrigger.Conditions>
                                    <Condition Property="IsChecked" Value="True" />
                                    <Condition Property="IsMouseOver" Value="True" />
                                </MultiTrigger.Conditions>
                                <Setter TargetName="OuterRing" Property="Stroke" Value="{DynamicResource SystemAccentColorSecondaryBrush}" />
                                <Setter TargetName="InnerDot" Property="Fill" Value="{DynamicResource SystemAccentColorSecondaryBrush}" />
                            </MultiTrigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="FluentCohesiveActionButtonStyle" TargetType="Button">
            <Setter Property="OverridesDefaultStyle" Value="True" />
            <Setter Property="Height" Value="30" />
            <Setter Property="MinWidth" Value="100" />
            <Setter Property="Padding" Value="16,0" />
            <Setter Property="FontSize" Value="12" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="Foreground" Value="#FFFFFF" />
            <Setter Property="FocusVisualStyle" Value="{x:Null}" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="BtnBorder"
                                Background="{DynamicResource SystemAccentColorPrimaryBrush}"
                                CornerRadius="{DynamicResource ControlCornerRadius}"
                                SnapsToDevicePixels="True">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="BtnBorder" Property="Background" Value="{DynamicResource SystemAccentColorSecondaryBrush}" />
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="BtnBorder" Property="Background" Value="{DynamicResource SystemAccentColorTertiaryBrush}" />
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter TargetName="BtnBorder" Property="Background" Value="#25FFFFFF" />
                                <Setter Property="Foreground" Value="#50FFFFFF" />
                                <Setter Property="Cursor" Value="Arrow" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="FluentCohesiveSecondaryButtonStyle" TargetType="Button">
            <Setter Property="OverridesDefaultStyle" Value="True" />
            <Setter Property="Height" Value="26" />
            <Setter Property="Padding" Value="8,2" />
            <Setter Property="FontSize" Value="11" />
            <Setter Property="Foreground" Value="#E0FFFFFF" />
            <Setter Property="FocusVisualStyle" Value="{x:Null}" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="BtnBorder"
                                Background="#1AFFFFFF"
                                BorderBrush="#25FFFFFF"
                                BorderThickness="1"
                                CornerRadius="{DynamicResource ControlCornerRadius}"
                                SnapsToDevicePixels="True">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="BtnBorder" Property="Background" Value="#25FFFFFF" />
                                <Setter TargetName="BtnBorder" Property="BorderBrush" Value="#40FFFFFF" />
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="BtnBorder" Property="Background" Value="#30FFFFFF" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="SuggestionListBoxItemStyle" TargetType="ListBoxItem">
            <Setter Property="OverridesDefaultStyle" Value="True" />
            <Setter Property="FocusVisualStyle" Value="{x:Null}" />
            <Setter Property="Padding" Value="10,6,10,6" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ListBoxItem">
                        <Border x:Name="ItemBorder"
                                Background="Transparent"
                                CornerRadius="{DynamicResource ControlCornerRadius}"
                                Margin="2,1,2,1"
                                Padding="{TemplateBinding Padding}"
                                SnapsToDevicePixels="True">
                            <ContentPresenter />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="ItemBorder" Property="Background" Value="#1CFFFFFF" />
                            </Trigger>
                            <Trigger Property="IsSelected" Value="True">
                                <Setter TargetName="ItemBorder" Property="Background" Value="#2AFFFFFF" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <DataTemplate x:Key="RadioSearchResultItemTemplate">
            <Grid Margin="0,3">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <StackPanel Grid.Column="0" VerticalAlignment="Center">
                    <TextBlock Text="{Binding Name}"
                               FontSize="12.5"
                               FontWeight="SemiBold"
                               Foreground="#FFFFFF"
                               TextTrimming="CharacterEllipsis" />
                    <TextBlock Text="{Binding Subtitle}"
                               FontSize="11"
                               Foreground="#75FFFFFF"
                               Margin="0,2,0,0"
                               TextTrimming="CharacterEllipsis" />
                </StackPanel>
                <Border Grid.Column="1"
                        Background="#15FFFFFF"
                        CornerRadius="{DynamicResource ControlCornerRadius}"
                        Padding="6,2"
                        VerticalAlignment="Center"
                        Margin="8,0,0,0">
                    <TextBlock Text="{Binding BitrateDisplay}"
                               FontSize="10"
                               Foreground="#85FFFFFF" />
                </Border>
            </Grid>
        </DataTemplate>
    </Window.Resources>

    <!-- Borderless Window Wrapper -->
    <Border Background="Transparent"
            BorderThickness="0"
            CornerRadius="{DynamicResource ControlCornerRadius}"
            SnapsToDevicePixels="True">
        <Grid RenderOptions.ClearTypeHint="Enabled">
            <Grid.ColumnDefinitions>
                <!-- COLUMN 0: FROSTED ACRYLIC SIDEBAR -->
                <ColumnDefinition Width="155" />
                <!-- COLUMN 1: OBSIDIAN DARK CONTENT PANEL -->
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>

            <!-- COLUMN 0: FROSTED ACRYLIC SIDEBAR -->
            <Grid Grid.Column="0" Background="Transparent">
                <Grid HorizontalAlignment="Center" VerticalAlignment="Center">
                    <Ellipse Width="80" Height="80" Fill="#184A90E2">
                        <Ellipse.Effect>
                            <BlurEffect Radius="20" />
                        </Ellipse.Effect>
                    </Ellipse>
                    <ui:SymbolIcon Symbol="HeadphonesSoundWave24"
                                   FontSize="56"
                                   Foreground="#D0FFFFFF"
                                   HorizontalAlignment="Center"
                                   VerticalAlignment="Center" />
                </Grid>
            </Grid>

            <!-- COLUMN 1: OBSIDIAN DARK CONTENT PANEL -->
            <Border Grid.Column="1"
                    Background="#232323"
                    CornerRadius="0,2,2,0"
                    RenderOptions.ClearTypeHint="Enabled">
                <Grid Margin="24,20,24,20">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>

                    <!-- Header -->
                    <Grid Grid.Row="0" Margin="0,0,0,18">
                        <TextBlock x:Name="HeaderTitleText"
                                   Text="Add Radio Station"
                                   FontSize="14.5"
                                   FontWeight="SemiBold"
                                   Foreground="#FFFFFF"
                                   VerticalAlignment="Center" />

                        <Button HorizontalAlignment="Right"
                                Style="{StaticResource ModalDismissButtonStyle}"
                                Click="OnCloseButtonClick" />
                    </Grid>

                    <!-- Body: Radio Station Form -->
                    <Grid Grid.Row="1">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="*" />
                            <RowDefinition Height="Auto" />
                        </Grid.RowDefinitions>

                        <!-- Two-Tab Segmented Selector -->
                        <Border Grid.Row="0"
                                Background="#12FFFFFF"
                                CornerRadius="{DynamicResource ControlCornerRadius}"
                                Padding="2"
                                HorizontalAlignment="Left"
                                Margin="0,0,0,10">
                            <StackPanel Orientation="Horizontal">
                                <RadioButton x:Name="RadioSearchTabRadio"
                                             Style="{StaticResource FluentSegmentedTabRadioButtonStyle}"
                                             GroupName="RadioAddTabs"
                                             Content="Search Stations"
                                             IsChecked="True"
                                             Checked="OnRadioTabChanged" />
                                <RadioButton x:Name="RadioDirectTabRadio"
                                             Style="{StaticResource FluentSegmentedTabRadioButtonStyle}"
                                             GroupName="RadioAddTabs"
                                             Content="Direct Stream URL"
                                             Checked="OnRadioTabChanged" />
                            </StackPanel>
                        </Border>

                        <!-- TAB 1: Search Stations Panel -->
                        <Grid Grid.Row="1" x:Name="RadioSearchPanel" Visibility="Visible">
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="*" />
                                <RowDefinition Height="Auto" />
                            </Grid.RowDefinitions>

                            <!-- Search Input Box with Overlay Watermark & Spinner -->
                            <Grid Grid.Row="0">
                                <TextBox x:Name="RadioSearchInput"
                                         Style="{StaticResource FluentGlassSearchInputStyle}"
                                         TextChanged="OnRadioSearchInputTextChanged"
                                         PreviewKeyDown="OnRadioSearchInputKeyDown" />
                                <TextBlock x:Name="RadioSearchWatermark"
                                           Text="Search station name, genre (e.g. lofi, jazz, ambient)..."
                                           FontSize="12"
                                           Foreground="#50FFFFFF"
                                           IsHitTestVisible="False"
                                           VerticalAlignment="Center"
                                           Margin="34,0,10,0" />
                                <ui:ProgressRing x:Name="RadioSearchSpinner"
                                                 Width="14" Height="14"
                                                 IsIndeterminate="True"
                                                 HorizontalAlignment="Right"
                                                 VerticalAlignment="Center"
                                                 Margin="0,0,10,0"
                                                 Visibility="Collapsed" />
                            </Grid>

                            <!-- Search Results List -->
                            <Border Grid.Row="1"
                                    Background="#14FFFFFF"
                                    BorderBrush="#25FFFFFF"
                                    BorderThickness="1"
                                    CornerRadius="{DynamicResource ControlCornerRadius}"
                                    Margin="0,8,0,0"
                                    SnapsToDevicePixels="True">
                                <Grid>
                                    <ListBox x:Name="RadioSearchResultsList"
                                             Background="Transparent"
                                             BorderThickness="0"
                                             Padding="2"
                                             ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                                             ScrollViewer.VerticalScrollBarVisibility="Auto"
                                             controls:AutoHideScrollBehavior.IsEnabled="True"
                                             ItemContainerStyle="{StaticResource SuggestionListBoxItemStyle}"
                                             ItemTemplate="{StaticResource RadioSearchResultItemTemplate}"
                                             SelectionChanged="OnRadioSearchResultsSelectionChanged">
                                        <ListBox.Resources>
                                            <Style TargetType="{x:Type ScrollBar}" BasedOn="{StaticResource WidgetFloatingScrollBarStyle}" />
                                        </ListBox.Resources>
                                    </ListBox>

                                    <!-- Search Initial Hint / Empty Text -->
                                    <TextBlock x:Name="RadioSearchPlaceholderText"
                                               Text="Type 2 or more characters to search 40,000+ online stations"
                                               FontSize="11.5"
                                               Foreground="#60FFFFFF"
                                               HorizontalAlignment="Center"
                                               VerticalAlignment="Center"
                                               IsHitTestVisible="False"
                                               Visibility="Visible" />
                                </Grid>
                            </Border>

                            <!-- Search Status Message -->
                            <TextBlock Grid.Row="2"
                                       x:Name="RadioSearchStatusMessage"
                                       FontSize="11.5"
                                       Foreground="#FF8080"
                                       Margin="0,6,0,0"
                                       TextWrapping="Wrap"
                                       Visibility="Collapsed" />
                        </Grid>

                        <!-- TAB 2: Direct Stream URL Panel -->
                        <Grid Grid.Row="1" x:Name="RadioDirectPanel" Visibility="Collapsed">
                            <StackPanel>
                                <TextBlock Text="Audio Stream URL"
                                           FontSize="12"
                                           Foreground="#95FFFFFF"
                                           Margin="0,0,0,6" />

                                <Grid>
                                    <TextBox x:Name="RadioDirectUrlInput"
                                             Style="{StaticResource FluentGlassUrlWithPasteInputStyle}"
                                             TextChanged="OnRadioDirectUrlTextChanged"
                                             KeyDown="OnRadioDirectInputKeyDown" />
                                    <Button HorizontalAlignment="Right"
                                            VerticalAlignment="Center"
                                            Style="{StaticResource FluentCohesiveSecondaryButtonStyle}"
                                            Height="26"
                                            Margin="0,0,5,0"
                                            Padding="8,2"
                                            Click="OnRadioDirectPasteClick">
                                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                            <ui:SymbolIcon Symbol="ClipboardPaste24" FontSize="12" Margin="0,0,5,0" VerticalAlignment="Center" />
                                            <TextBlock Text="Paste" FontSize="11" VerticalAlignment="Center" />
                                        </StackPanel>
                                    </Button>
                                </Grid>

                                <StackPanel Orientation="Horizontal" Margin="0,6,0,0" MinHeight="18">
                                    <ui:ProgressRing x:Name="RadioProbeSpinner"
                                                     Width="12" Height="12"
                                                     IsIndeterminate="True"
                                                     Visibility="Collapsed"
                                                     Margin="0,0,6,0" />
                                    <ui:SymbolIcon x:Name="RadioProbeIcon"
                                                   Symbol="Checkmark24"
                                                   FontSize="13"
                                                   Visibility="Collapsed"
                                                   Margin="0,0,6,0"
                                                   VerticalAlignment="Center" />
                                    <TextBlock x:Name="RadioProbeStatusText"
                                               Text="Supports MP3/AAC/OGG streams or single-station .pls/.m3u"
                                               FontSize="11.5"
                                               Foreground="#65FFFFFF"
                                               VerticalAlignment="Center" />
                                </StackPanel>

                                <TextBlock Text="Station Name"
                                           FontSize="12"
                                           Foreground="#95FFFFFF"
                                           Margin="0,8,0,6" />
                                <TextBox x:Name="RadioDirectNameInput"
                                         Style="{StaticResource FluentGlassInputStyle}"
                                         TextChanged="OnRadioDirectNameTextChanged"
                                         KeyDown="OnRadioDirectInputKeyDown" />

                                <TextBlock x:Name="RadioDirectStatusMessage"
                                           FontSize="11.5"
                                           Foreground="#FF8080"
                                           Margin="0,6,0,0"
                                           TextWrapping="Wrap"
                                           Visibility="Collapsed" />
                            </StackPanel>
                        </Grid>

                        <!-- Target Category Selector -->
                        <StackPanel Grid.Row="2" Orientation="Horizontal" VerticalAlignment="Center" Margin="0,8,0,0">
                            <TextBlock Text="Category:"
                                       FontSize="12"
                                       Foreground="#80FFFFFF"
                                       VerticalAlignment="Center"
                                       Margin="0,0,12,0" />
                            <RadioButton x:Name="RadioCatAmbient"
                                         Style="{StaticResource FluentGlassRadioButtonStyle}"
                                         GroupName="RadioCategoryTarget"
                                         IsChecked="True"
                                         Margin="0,0,14,0">
                                <TextBlock Text="Ambient" FontSize="12" Foreground="#95FFFFFF" VerticalAlignment="Center" />
                            </RadioButton>
                            <RadioButton x:Name="RadioCatNature"
                                         Style="{StaticResource FluentGlassRadioButtonStyle}"
                                         GroupName="RadioCategoryTarget"
                                         Margin="0,0,14,0">
                                <TextBlock Text="Nature" FontSize="12" Foreground="#95FFFFFF" VerticalAlignment="Center" />
                            </RadioButton>
                            <RadioButton x:Name="RadioCatLofi"
                                         Style="{StaticResource FluentGlassRadioButtonStyle}"
                                         GroupName="RadioCategoryTarget"
                                         Margin="0,0,14,0">
                                <TextBlock Text="Lo-Fi" FontSize="12" Foreground="#95FFFFFF" VerticalAlignment="Center" />
                            </RadioButton>
                            <RadioButton x:Name="RadioCatCoding"
                                         Style="{StaticResource FluentGlassRadioButtonStyle}"
                                         GroupName="RadioCategoryTarget">
                                <TextBlock Text="Coding" FontSize="12" Foreground="#95FFFFFF" VerticalAlignment="Center" />
                            </RadioButton>
                        </StackPanel>
                    </Grid>

                    <!-- Footer: Action Button -->
                    <Grid Grid.Row="2" Margin="0,14,0,0">
                        <Button x:Name="PrimaryActionButton"
                                Style="{StaticResource FluentCohesiveActionButtonStyle}"
                                Content="Add Station"
                                Height="30"
                                MinWidth="100"
                                Padding="16,0"
                                FontSize="12"
                                IsDefault="True"
                                HorizontalAlignment="Right"
                                Click="OnPrimaryActionButtonClick" />
                    </Grid>
                </Grid>
            </Border>
        </Grid>
    </Border>
</ui:FluentWindow>
