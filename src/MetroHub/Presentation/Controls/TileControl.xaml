<UserControl x:Class="MetroHub.Presentation.Controls.TileControl"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:conv="clr-namespace:MetroHub.Presentation.Converters"
             xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
             mc:Ignorable="d"
             Margin="0"
             Cursor="Hand"
             Focusable="False">

    <UserControl.Resources>
        <conv:TileSpanToPixelsConverter x:Key="SpanConverter" />
        <BooleanToVisibilityConverter x:Key="BoolToVis" />
    </UserControl.Resources>

    <Border x:Name="RootBorder"
            CornerRadius="2"
            Width="{Binding SpanX, Converter={StaticResource SpanConverter}}"
            Height="{Binding SpanY, Converter={StaticResource SpanConverter}}"
            RenderTransformOrigin="0.5,0.5"
            SnapsToDevicePixels="True"
            UseLayoutRounding="True"
            ContextMenuOpening="OnContextMenuOpening"
            PreviewMouseRightButtonDown="OnPreviewMouseRightButtonDown">

        <Border.Style>
            <Style TargetType="Border">
                <Setter Property="Opacity" Value="1.0"/>
                <Setter Property="BorderThickness" Value="1"/>
                <Setter Property="BorderBrush" Value="#22FFFFFF"/>
                <Style.Triggers>
                    <DataTrigger Binding="{Binding IsSelected}" Value="True">
                        <Setter Property="BorderBrush" Value="{DynamicResource SystemAccentColorPrimaryBrush}"/>
                    </DataTrigger>
                    <DataTrigger Binding="{Binding IsBeingDragged}" Value="True">
                        <Setter Property="Opacity" Value="0.9"/>
                        <Setter Property="BorderBrush" Value="{DynamicResource SystemAccentColorPrimaryBrush}"/>
                    </DataTrigger>
                </Style.Triggers>
            </Style>
        </Border.Style>

        <Border.RenderTransform>
            <ScaleTransform x:Name="TileScale" ScaleX="1.0" ScaleY="1.0" />
        </Border.RenderTransform>

        <Border.ContextMenu>
            <ContextMenu x:Name="TileContextMenu">
                <MenuItem x:Name="ResizeMenuItem" Header="Resize">
                    <MenuItem Header="Small (1x1)" Click="OnResizeSmallClick" />
                    <MenuItem Header="Medium (2x2)" Click="OnResizeMediumClick" />
                    <MenuItem Header="Wide (4x2)" Click="OnResizeWideClick" />
                </MenuItem>
                <MenuItem x:Name="StyleMenuItem" Header="Style">
                    <MenuItem Header="Default" Click="OnStyleDefaultClick" />
                    <MenuItem Header="Colourful" Click="OnStyleColourfulClick" />
                </MenuItem>
                <Separator x:Name="SingleAppSeparator" />
                <MenuItem x:Name="RunAdminMenuItem" Header="Run as Administrator" Click="OnRunAsAdminClick" />
                <MenuItem x:Name="OpenLocationMenuItem" Header="Open File Location" Click="OnOpenFileLocationClick" />
                <Separator />
                <MenuItem x:Name="UnpinMenuItem" Header="Unpin from MetroHub" Click="OnUnpinClick" Foreground="#FF6B6B" />
            </ContextMenu>
        </Border.ContextMenu>

        <Grid>
            <!-- Fluent Reveal Highlight: Surface Spotlight -->
            <Border x:Name="RevealFillBorder"
                    CornerRadius="2"
                    IsHitTestVisible="False"
                    Opacity="0">
                <Border.Background>
                    <RadialGradientBrush x:Name="RevealFillBrush" MappingMode="Absolute" RadiusX="200" RadiusY="200">
                        <GradientStop Color="#35FFFFFF" Offset="0.0" />
                        <GradientStop Color="#14FFFFFF" Offset="0.5" />
                        <GradientStop Color="#00000000" Offset="1.0" />
                    </RadialGradientBrush>
                </Border.Background>
            </Border>

            <!-- Fluent Reveal Highlight: Edge Illumination -->
            <Border x:Name="RevealEdgeBorder"
                    CornerRadius="2"
                    BorderThickness="1.2"
                    IsHitTestVisible="False"
                    Opacity="0">
                <Border.BorderBrush>
                    <RadialGradientBrush x:Name="RevealEdgeBrush" MappingMode="Absolute" RadiusX="160" RadiusY="160">
                        <GradientStop Color="#FFFFFFFF" Offset="0.0" />
                        <GradientStop Color="#60FFFFFF" Offset="0.5" />
                        <GradientStop Color="#00000000" Offset="1.0" />
                    </RadialGradientBrush>
                </Border.BorderBrush>
            </Border>

            <!-- Content Area: Free of outer constraint margin for exact pixel placement -->
            <Grid SnapsToDevicePixels="True" UseLayoutRounding="True" ClipToBounds="True">
                <!-- 1x1 Small Tile Layout (56x56) -->
                <Grid x:Name="SmallContentGrid" Visibility="{Binding IsSmall, Converter={StaticResource BoolToVis}}">
                    <Image Source="{Binding IconPath}"
                           HorizontalAlignment="Center"
                           VerticalAlignment="Center"
                           Width="28" Height="28"
                           RenderOptions.BitmapScalingMode="HighQuality" />
                </Grid>

                <!-- 2x2 Medium Tile Layout (120x120) -->
                <Grid x:Name="MediumContentGrid" Visibility="{Binding IsMedium, Converter={StaticResource BoolToVis}}">
                    <!-- Icon: Optical Center (balanced breathing room above bottom label) -->
                    <Image Source="{Binding IconPath}"
                           HorizontalAlignment="Center"
                           VerticalAlignment="Center"
                           Width="44" Height="44"
                           Margin="0,0,0,12"
                           RenderOptions.BitmapScalingMode="HighQuality" />

                    <!-- Label: Docked to bottom-left in authentic Segoe UI Variable -->
                    <TextBlock Text="{Binding Title}"
                               VerticalAlignment="Bottom"
                               HorizontalAlignment="Left"
                               Margin="8,0,8,6"
                               FontSize="11.5"
                               FontFamily="Segoe UI Variable Text, Segoe UI Variable, Segoe UI, sans-serif"
                               FontWeight="SemiBold"
                               Foreground="#F0FFFFFF"
                               TextTrimming="CharacterEllipsis"
                               TextWrapping="NoWrap"
                               MaxWidth="104" />
                </Grid>

                <!-- 4x2 Wide Tile Layout (248x120) -->
                <Grid x:Name="WideContentGrid" Visibility="{Binding IsWide, Converter={StaticResource BoolToVis}}">
                    <!-- Icon: Centered in wide tile canvas -->
                    <Image Source="{Binding IconPath}"
                           HorizontalAlignment="Center"
                           VerticalAlignment="Center"
                           Width="46" Height="46"
                           Margin="0,0,0,12"
                           RenderOptions.BitmapScalingMode="HighQuality" />

                    <!-- Label: Docked to bottom-left in authentic Segoe UI Variable -->
                    <TextBlock Text="{Binding Title}"
                               VerticalAlignment="Bottom"
                               HorizontalAlignment="Left"
                               Margin="8,0,8,6"
                               FontSize="11.5"
                               FontFamily="Segoe UI Variable Text, Segoe UI Variable, Segoe UI, sans-serif"
                               FontWeight="SemiBold"
                               Foreground="#F0FFFFFF"
                               TextTrimming="CharacterEllipsis"
                               TextWrapping="NoWrap"
                               MaxWidth="232" />
                </Grid>
            </Grid>

        </Grid>
    </Border>
</UserControl>
