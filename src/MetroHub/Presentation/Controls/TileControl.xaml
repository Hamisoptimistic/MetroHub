<UserControl x:Class="MetroHub.Presentation.Controls.TileControl"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:conv="clr-namespace:MetroHub.Presentation.Converters"
             xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
             xmlns:models="clr-namespace:MetroHub.Core.Models"
             xmlns:widgets="clr-namespace:MetroHub.Widgets"
             xmlns:stub="clr-namespace:MetroHub.Widgets.Catalog.Stub"
             xmlns:clock="clr-namespace:MetroHub.Widgets.Catalog.Clock"
             xmlns:calendar="clr-namespace:MetroHub.Widgets.Catalog.Calendar"
             xmlns:media="clr-namespace:MetroHub.Widgets.Catalog.Media"
             xmlns:behaviors="clr-namespace:MetroHub.Widgets.Behaviors"
             mc:Ignorable="d"
             Margin="0"
             Cursor="Hand"
             Focusable="False"
             SnapsToDevicePixels="True"
             UseLayoutRounding="True"
             TextOptions.TextFormattingMode="Ideal"
             TextOptions.TextRenderingMode="Auto">

    <UserControl.Resources>
        <conv:TileSpanToPixelsConverter x:Key="SpanConverter" />
        <conv:StringToBrushConverter x:Key="StringToBrushConverter" />
        <BooleanToVisibilityConverter x:Key="BoolToVis" />

        <!-- 1. App Tile DataTemplate (Exact original visual layout and ClearType hinting) -->
        <DataTemplate DataType="{x:Type models:TileModel}">
            <Grid SnapsToDevicePixels="True" 
                  UseLayoutRounding="True"
                  RenderOptions.BitmapScalingMode="Fant">
                  
                <!-- 1x1 Small Tile Layout (56x56) -->
                <Grid Visibility="{Binding IsSmall, Converter={StaticResource BoolToVis}}">
                    <Image Source="{Binding IconPath}"
                           HorizontalAlignment="Center"
                           VerticalAlignment="Center"
                           Width="28" Height="28"
                           SnapsToDevicePixels="True"
                           UseLayoutRounding="True"
                           RenderOptions.BitmapScalingMode="Fant" />
                </Grid>

                <!-- 2x2 Medium Tile Layout (120x120) -->
                <Grid Visibility="{Binding IsMedium, Converter={StaticResource BoolToVis}}">
                    <Image Source="{Binding IconPath}"
                           HorizontalAlignment="Center"
                           VerticalAlignment="Center"
                           Width="44" Height="44"
                           Margin="0,0,0,14"
                           SnapsToDevicePixels="True"
                           UseLayoutRounding="True"
                           RenderOptions.BitmapScalingMode="Fant" />

                    <!-- Label: DirectWrite Ideal typography rendering -->
                    <TextBlock Text="{Binding Title}"
                               VerticalAlignment="Bottom"
                               HorizontalAlignment="Left"
                               Margin="8,0,8,6"
                               FontSize="12"
                               FontFamily="Segoe UI Variable Text, Segoe UI Variable, Segoe UI, sans-serif"
                               FontWeight="SemiBold"
                               Foreground="#FFFFFF"
                               SnapsToDevicePixels="True"
                               UseLayoutRounding="True"
                               TextOptions.TextFormattingMode="Ideal"
                               TextOptions.TextRenderingMode="Auto"
                               TextTrimming="CharacterEllipsis"
                               TextWrapping="NoWrap"
                               MaxWidth="104" />
                </Grid>

                <!-- 4x2 Wide Tile Layout (248x120) -->
                <Grid Visibility="{Binding IsWide, Converter={StaticResource BoolToVis}}">
                    <Image Source="{Binding IconPath}"
                           HorizontalAlignment="Center"
                           VerticalAlignment="Center"
                           Width="46" Height="46"
                           Margin="0,0,0,14"
                           SnapsToDevicePixels="True"
                           UseLayoutRounding="True"
                           RenderOptions.BitmapScalingMode="Fant" />

                    <TextBlock Text="{Binding Title}"
                               VerticalAlignment="Bottom"
                               HorizontalAlignment="Left"
                               Margin="8,0,8,6"
                               FontSize="12"
                               FontFamily="Segoe UI Variable Text, Segoe UI Variable, Segoe UI, sans-serif"
                               FontWeight="SemiBold"
                               Foreground="#F5FFFFFF"
                               SnapsToDevicePixels="True"
                               UseLayoutRounding="True"
                               TextOptions.TextFormattingMode="Ideal"
                               TextOptions.TextRenderingMode="Auto"
                               TextTrimming="CharacterEllipsis"
                               TextWrapping="NoWrap"
                               MaxWidth="232" />
                </Grid>
            </Grid>
        </DataTemplate>

        <!-- 2. Stub Widget DataTemplate (Wraps interior in shared WidgetCard shell) -->
        <DataTemplate DataType="{x:Type stub:StubWidgetViewModel}">
            <widgets:WidgetCard>
                <!-- Minimal Stub Widget: Just a colored box with a label and interactive setting test -->
                <Border Background="{Binding BoxColor, Converter={StaticResource StringToBrushConverter}}"
                        CornerRadius="4"
                        Margin="1"
                        Padding="8"
                        SnapsToDevicePixels="True">
                    <Grid>
                        <!-- Label and settings display -->
                        <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center">
                            <TextBlock Text="{Binding Label}"
                                       HorizontalAlignment="Center"
                                       Foreground="#FFFFFF"
                                       FontSize="13"
                                       FontWeight="Bold"
                                       FontFamily="Segoe UI Variable Text, Segoe UI Variable, Segoe UI, sans-serif"
                                       SnapsToDevicePixels="True" />
                            <TextBlock Text="{Binding SettingsSummary}"
                                       HorizontalAlignment="Center"
                                       Foreground="#E0FFFFFF"
                                       FontSize="10"
                                       FontFamily="Segoe UI Variable Text, Segoe UI Variable, Segoe UI, sans-serif"
                                       Margin="0,3,0,0"
                                       SnapsToDevicePixels="True" />
                            <TextBlock Text="Click to cycle color"
                                       HorizontalAlignment="Center"
                                       Foreground="#80FFFFFF"
                                       FontSize="9"
                                       FontFamily="Segoe UI Variable Text, Segoe UI Variable, Segoe UI, sans-serif"
                                       Margin="0,4,0,0"
                                       SnapsToDevicePixels="True" />
                        </StackPanel>
                    </Grid>
                </Border>
            </widgets:WidgetCard>
        </DataTemplate>

        <!-- 3. Clock Widget DataTemplate (Phase 3 Native Widget: Isolated Component) -->
        <DataTemplate DataType="{x:Type clock:ClockWidgetViewModel}">
            <clock:ClockWidgetView />
        </DataTemplate>

        <!-- 4. Calendar Widget DataTemplate (Windows 10 Style Standalone Widget) -->
        <DataTemplate DataType="{x:Type calendar:CalendarWidgetViewModel}">
            <calendar:CalendarWidgetView />
        </DataTemplate>

        <!-- 5. Media Player Widget DataTemplate (Groove Live Tile Style) -->
        <DataTemplate DataType="{x:Type media:MediaWidgetViewModel}">
            <media:MediaWidgetView />
        </DataTemplate>
    </UserControl.Resources>

    <Border x:Name="RootBorder"
            Background="Transparent"
            CornerRadius="2"
            Width="{Binding SpanX, Converter={StaticResource SpanConverter}}"
            Height="{Binding SpanY, Converter={StaticResource SpanConverter}}"
            RenderTransformOrigin="0.5,0.5"
            SnapsToDevicePixels="True"
            UseLayoutRounding="True"
            ContextMenuOpening="OnContextMenuOpening"
            PreviewMouseRightButtonDown="OnPreviewMouseRightButtonDown">

        <Border.Style>
            <Style TargetType="Border">
                <Setter Property="Opacity" Value="1.0"/>
                <Setter Property="BorderThickness" Value="1"/>
                <Setter Property="BorderBrush" Value="#22FFFFFF"/>
                <Style.Triggers>
                    <DataTrigger Binding="{Binding IsSelected}" Value="True">
                        <Setter Property="BorderBrush" Value="{DynamicResource SystemAccentColorPrimaryBrush}"/>
                    </DataTrigger>
                    <DataTrigger Binding="{Binding IsBeingDragged}" Value="True">
                        <Setter Property="Opacity" Value="0.9"/>
                        <Setter Property="BorderBrush" Value="{DynamicResource SystemAccentColorPrimaryBrush}"/>
                    </DataTrigger>
                </Style.Triggers>
            </Style>
        </Border.Style>

        <Border.RenderTransform>
            <ScaleTransform x:Name="TileScale" ScaleX="1.0" ScaleY="1.0" />
        </Border.RenderTransform>

        <Border.ContextMenu>
            <ContextMenu x:Name="TileContextMenu">
                <MenuItem x:Name="ResizeMenuItem" Header="Resize">
                    <MenuItem.Icon>
                        <ui:SymbolIcon Symbol="ResizeLarge16" FontSize="18" Foreground="#D0FFFFFF" />
                    </MenuItem.Icon>
                </MenuItem>
                <MenuItem x:Name="StyleMenuItem" Header="Style">
                    <MenuItem.Icon>
                        <ui:SymbolIcon Symbol="PaintBrush16" FontSize="18" Foreground="#D0FFFFFF" />
                    </MenuItem.Icon>
                    <MenuItem x:Name="StyleDefaultMenuItem" Header="Default" IsCheckable="True" Click="OnStyleDefaultClick" />
                    <MenuItem x:Name="StyleColourfulMenuItem" Header="Colourful" IsCheckable="True" Click="OnStyleColourfulClick" />
                </MenuItem>
                <MenuItem x:Name="GroupMenuItem" Header="Create Group from Tiles" Click="OnGroupTilesClick">
                    <MenuItem.Icon>
                        <ui:SymbolIcon Symbol="FolderAdd24" FontSize="18" Foreground="#D0FFFFFF" />
                    </MenuItem.Icon>
                </MenuItem>
                <MenuItem x:Name="AddToGroupMenuItem" Header="Add to Group">
                    <MenuItem.Icon>
                        <ui:SymbolIcon Symbol="FolderArrowRight24" FontSize="18" Foreground="#D0FFFFFF" />
                    </MenuItem.Icon>
                </MenuItem>
                <Separator x:Name="SingleAppSeparator" />
                <MenuItem x:Name="RunAdminMenuItem" Header="Run as Administrator" Click="OnRunAsAdminClick">
                    <MenuItem.Icon>
                        <ui:SymbolIcon Symbol="Shield32" FontSize="18" Foreground="#D0FFFFFF" />
                    </MenuItem.Icon>
                </MenuItem>
                <MenuItem x:Name="OpenLocationMenuItem" Header="Open File Location" Click="OnOpenFileLocationClick">
                    <MenuItem.Icon>
                        <ui:SymbolIcon Symbol="FolderOpenVertical20" FontSize="18" Foreground="#D0FFFFFF" />
                    </MenuItem.Icon>
                </MenuItem>
                <Separator x:Name="UnpinSeparator" />
                <MenuItem x:Name="UnpinMenuItem" Header="Unpin from MetroHub" Click="OnUnpinClick" Foreground="#FF6B6B">
                    <MenuItem.Icon>
                        <ui:SymbolIcon Symbol="PinOff24" FontSize="18" Foreground="#FF6B6B" />
                    </MenuItem.Icon>
                </MenuItem>
            </ContextMenu>
        </Border.ContextMenu>

        <Grid>
            <!-- Fluent Reveal Highlight: Surface Spotlight -->
            <Border x:Name="RevealFillBorder"
                    CornerRadius="2"
                    IsHitTestVisible="False"
                    Opacity="0">
                <Border.Background>
                    <RadialGradientBrush x:Name="RevealFillBrush" MappingMode="Absolute" RadiusX="200" RadiusY="200">
                        <GradientStop Color="#35FFFFFF" Offset="0.0" />
                        <GradientStop Color="#14FFFFFF" Offset="0.5" />
                        <GradientStop Color="#00000000" Offset="1.0" />
                    </RadialGradientBrush>
                </Border.Background>
            </Border>

            <!-- Fluent Reveal Highlight: Edge Illumination -->
            <Border x:Name="RevealEdgeBorder"
                    CornerRadius="2"
                    BorderThickness="1.2"
                    IsHitTestVisible="False"
                    Opacity="0">
                <Border.BorderBrush>
                    <RadialGradientBrush x:Name="RevealEdgeBrush" MappingMode="Absolute" RadiusX="160" RadiusY="160">
                        <GradientStop Color="#FFFFFFFF" Offset="0.0" />
                        <GradientStop Color="#60FFFFFF" Offset="0.5" />
                        <GradientStop Color="#00000000" Offset="1.0" />
                    </RadialGradientBrush>
                </Border.BorderBrush>
            </Border>

            <!-- Content Area via ContentPresenter: resolved via DataType DataTemplates -->
            <ContentPresenter x:Name="TileContentPresenter"
                              Content="{Binding TileContent}"
                              SnapsToDevicePixels="True"
                              UseLayoutRounding="True" />
        </Grid>
    </Border>
</UserControl>