<UserControl x:Class="MetroHub.Presentation.Controls.TileControl"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:conv="clr-namespace:MetroHub.Presentation.Converters"
             xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
             xmlns:models="clr-namespace:MetroHub.Core.Models"
             xmlns:widgets="clr-namespace:MetroHub.Widgets"
             mc:Ignorable="d"
             Margin="0"
             Focusable="False"
>

    <UserControl.Resources>
        <conv:TileSpanToPixelsConverter x:Key="SpanConverter" />
        <conv:StringToBrushConverter x:Key="StringToBrushConverter" />
        <widgets:WidgetTemplateSelector x:Key="WidgetTemplateSelector" />

        <!-- 1. App Tile DataTemplate (Exact original visual layout and ClearType hinting) -->
        <DataTemplate DataType="{x:Type models:TileModel}">
            <Grid 
                  RenderOptions.BitmapScalingMode="Fant">
                  
                <!-- 1x1 Small Tile Layout (56x56) -->
                <Grid Visibility="{Binding IsSmall, Converter={StaticResource BoolToVis}}">
                    <Image Source="{Binding IconPath, TargetNullValue={x:Null}, FallbackValue={x:Null}}"
                           HorizontalAlignment="Center"
                           VerticalAlignment="Center"
                           Width="28" Height="28"
                           RenderOptions.BitmapScalingMode="Fant" />
                </Grid>

                <!-- 2x2 Medium Tile Layout (120x120) -->
                <Grid Visibility="{Binding IsMedium, Converter={StaticResource BoolToVis}}">
                    <Image Source="{Binding IconPath, TargetNullValue={x:Null}, FallbackValue={x:Null}}"
                           HorizontalAlignment="Center"
                           VerticalAlignment="Center"
                           Width="44" Height="44"
                           Margin="0,0,0,14"
                           RenderOptions.BitmapScalingMode="Fant" />

                    <!-- Label: DirectWrite Ideal typography rendering -->
                    <TextBlock Text="{Binding Title}"
                               VerticalAlignment="Bottom"
                               HorizontalAlignment="Left"
                               Margin="8,0,8,6"
                               FontFamily="{DynamicResource AppFontFamily}"
                               FontSize="{DynamicResource TypeCaptionFontSize}"
                               FontWeight="{DynamicResource TypeCaptionFontWeight}"
                               Foreground="{DynamicResource TextPrimaryBrush}"
                               TextOptions.TextFormattingMode="Ideal"
                               TextOptions.TextRenderingMode="ClearType"
                               TextTrimming="CharacterEllipsis"
                               TextWrapping="NoWrap"
                               MaxWidth="104" />
                </Grid>

                <!-- 4x2 Wide Tile Layout (248x120) -->
                <Grid Visibility="{Binding IsWide, Converter={StaticResource BoolToVis}}">
                    <Image Source="{Binding IconPath, TargetNullValue={x:Null}, FallbackValue={x:Null}}"
                           HorizontalAlignment="Center"
                           VerticalAlignment="Center"
                           Width="46" Height="46"
                           Margin="0,0,0,14"
                           RenderOptions.BitmapScalingMode="Fant" />

                    <TextBlock Text="{Binding Title}"
                               VerticalAlignment="Bottom"
                               HorizontalAlignment="Left"
                               Margin="8,0,8,6"
                               FontFamily="{DynamicResource AppFontFamily}"
                               FontSize="{DynamicResource TypeCaptionFontSize}"
                               FontWeight="{DynamicResource TypeCaptionFontWeight}"
                               Foreground="{DynamicResource TextPrimaryBrush}"
                               TextOptions.TextFormattingMode="Ideal"
                               TextOptions.TextRenderingMode="ClearType"
                               TextTrimming="CharacterEllipsis"
                               TextWrapping="NoWrap"
                               MaxWidth="232" />
                </Grid>
            </Grid>
        </DataTemplate>
    </UserControl.Resources>

    <Border x:Name="RootBorder"
            Background="Transparent"
            CornerRadius="{DynamicResource TileCornerRadius}"
            ClipToBounds="True"
            Width="{Binding SpanX, Converter={StaticResource SpanConverter}}"
            Height="{Binding SpanY, Converter={StaticResource SpanConverter}}"
            RenderTransformOrigin="0.5,0.5"
            RenderOptions.ClearTypeHint="Enabled"
            ContextMenuOpening="OnContextMenuOpening"
            PreviewMouseRightButtonDown="OnPreviewMouseRightButtonDown">

        <Border.Style>
            <Style TargetType="Border">
                <Setter Property="Opacity" Value="1.0"/>
                <Setter Property="BorderThickness" Value="1"/>
                <Setter Property="BorderBrush" Value="#22FFFFFF"/>
                <Style.Triggers>
                    <DataTrigger Binding="{Binding IsSelected}" Value="True">
                        <Setter Property="BorderBrush" Value="{DynamicResource SystemAccentColorPrimaryBrush}"/>
                    </DataTrigger>
                    <DataTrigger Binding="{Binding IsBeingDragged}" Value="True">
                        <Setter Property="Opacity" Value="0.9"/>
                        <Setter Property="BorderBrush" Value="{DynamicResource SystemAccentColorPrimaryBrush}"/>
                    </DataTrigger>
                </Style.Triggers>
            </Style>
        </Border.Style>

        <Border.RenderTransform>
            <ScaleTransform x:Name="TileScale" ScaleX="1.0" ScaleY="1.0" />
        </Border.RenderTransform>

        <Border.ContextMenu>
            <ContextMenu x:Name="TileContextMenu">
                <MenuItem x:Name="ResizeMenuItem" Header="Resize">
                    <MenuItem.Icon>
                        <ui:SymbolIcon Symbol="ResizeLarge16" FontSize="18" Foreground="{DynamicResource TextSecondaryBrush}" />
                    </MenuItem.Icon>
                </MenuItem>
                <MenuItem x:Name="StyleMenuItem" Header="Style">
                    <MenuItem.Icon>
                        <ui:SymbolIcon Symbol="PaintBrush16" FontSize="18" Foreground="{DynamicResource TextSecondaryBrush}" />
                    </MenuItem.Icon>
                    <MenuItem x:Name="StyleDefaultMenuItem" Header="Default" IsCheckable="True" Click="OnStyleDefaultClick" />
                    <MenuItem x:Name="StyleColourfulMenuItem" Header="Colourful" IsCheckable="True" Click="OnStyleColourfulClick" />
                </MenuItem>
                <MenuItem x:Name="GroupMenuItem" Header="Create Group from Tiles" Click="OnGroupTilesClick">
                    <MenuItem.Icon>
                        <ui:SymbolIcon Symbol="FolderAdd24" FontSize="18" Foreground="{DynamicResource TextSecondaryBrush}" />
                    </MenuItem.Icon>
                </MenuItem>
                <MenuItem x:Name="AddToGroupMenuItem" Header="Add to Group">
                    <MenuItem.Icon>
                        <ui:SymbolIcon Symbol="FolderArrowRight24" FontSize="18" Foreground="{DynamicResource TextSecondaryBrush}" />
                    </MenuItem.Icon>
                </MenuItem>
                <Separator x:Name="SingleAppSeparator" />
                <MenuItem x:Name="RunAdminMenuItem" Header="Run as Administrator" Click="OnRunAsAdminClick">
                    <MenuItem.Icon>
                        <ui:SymbolIcon Symbol="Shield32" FontSize="18" Foreground="{DynamicResource TextSecondaryBrush}" />
                    </MenuItem.Icon>
                </MenuItem>
                <MenuItem x:Name="OpenLocationMenuItem" Header="Open File Location" Click="OnOpenFileLocationClick">
                    <MenuItem.Icon>
                        <ui:SymbolIcon Symbol="FolderOpenVertical20" FontSize="18" Foreground="{DynamicResource TextSecondaryBrush}" />
                    </MenuItem.Icon>
                </MenuItem>
                <MenuItem x:Name="CopyUrlMenuItem" Header="Copy Web Link" Visibility="Collapsed" Click="OnCopyUrlClick">
                    <MenuItem.Icon>
                        <ui:SymbolIcon Symbol="Copy24" FontSize="18" Foreground="{DynamicResource TextSecondaryBrush}" />
                    </MenuItem.Icon>
                </MenuItem>
                <Separator x:Name="UnpinSeparator" />
                <MenuItem x:Name="PinToSidebarMenuItem" Header="Pin to Sidebar" Click="OnPinToSidebarClick">
                    <MenuItem.Icon>
                        <ui:SymbolIcon x:Name="PinToSidebarIcon" Symbol="Pin24" FontSize="18" Foreground="{DynamicResource TextSecondaryBrush}" />
                    </MenuItem.Icon>
                </MenuItem>
                <MenuItem x:Name="UnpinMenuItem" Header="Unpin from MetroHub" Click="OnUnpinClick" Foreground="{DynamicResource StatusErrorBrush}">
                    <MenuItem.Icon>
                        <ui:SymbolIcon Symbol="PinOff24" FontSize="18" Foreground="{DynamicResource StatusErrorBrush}" />
                    </MenuItem.Icon>
                </MenuItem>
            </ContextMenu>
        </Border.ContextMenu>

        <Grid>
            <!-- Fluent Reveal Highlight: Surface Spotlight -->
            <Border x:Name="RevealFillBorder"
                    CornerRadius="{DynamicResource TileCornerRadius}"
                    IsHitTestVisible="False"
                    Opacity="0">
                <Border.Style>
                    <Style TargetType="Border">
                        <Setter Property="Visibility" Value="Visible" />
                        <Style.Triggers>
                            <DataTrigger Binding="{Binding TileType}" Value="{x:Static models:TileType.Widget}">
                                <Setter Property="Visibility" Value="Collapsed" />
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </Border.Style>
                <Border.Background>
                    <RadialGradientBrush x:Name="RevealFillBrush" MappingMode="Absolute" RadiusX="200" RadiusY="200">
                        <GradientStop Color="#35FFFFFF" Offset="0.0" />
                        <GradientStop Color="#14FFFFFF" Offset="0.5" />
                        <GradientStop Color="#00000000" Offset="1.0" />
                    </RadialGradientBrush>
                </Border.Background>
            </Border>

            <!-- Content Area via ContentPresenter: resolved dynamically via WidgetTemplateSelector -->
            <ContentPresenter x:Name="TileContentPresenter"
                              Content="{Binding TileContent}"
                              ContentTemplateSelector="{StaticResource WidgetTemplateSelector}"
                              />

            <!-- Fluent Reveal Highlight: Edge Illumination (above ContentPresenter so it shows on top of full-bleed widget content e.g. photos) -->
            <Border x:Name="RevealEdgeBorder"
                    CornerRadius="{DynamicResource TileCornerRadius}"
                    BorderThickness="1.2"
                    IsHitTestVisible="False"
                    Opacity="0">
                <Border.BorderBrush>
                    <RadialGradientBrush x:Name="RevealEdgeBrush" MappingMode="Absolute" RadiusX="160" RadiusY="160">
                        <GradientStop Color="#FFFFFFFF" Offset="0.0" />
                        <GradientStop Color="#60FFFFFF" Offset="0.5" />
                        <GradientStop Color="#00000000" Offset="1.0" />
                    </RadialGradientBrush>
                </Border.BorderBrush>
            </Border>
        </Grid>
    </Border>
</UserControl>