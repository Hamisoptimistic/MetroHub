<ui:FluentWindow x:Class="MetroHub.Presentation.Controls.AcrylicModalWindow"
                  xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                  xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                  xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
                  WindowBackdropType="Acrylic"
                  WindowCornerPreference="DoNotRound"
                  ExtendsContentIntoTitleBar="True"
                  WindowStyle="None"
                  ResizeMode="NoResize"
                  ShowInTaskbar="False"
                  WindowStartupLocation="CenterOwner"
                  Width="620"
                  Height="360"
                  Background="Transparent"
                  Foreground="#FFFFFF"
                  FontFamily="Segoe UI Variable Text, Segoe UI, sans-serif"
                  RenderOptions.ClearTypeHint="Enabled"
                  TextOptions.TextFormattingMode="Ideal"
                  TextOptions.TextRenderingMode="ClearType"
                  TextOptions.TextHintingMode="Auto"
                  SnapsToDevicePixels="True"
                  UseLayoutRounding="True">

    <Window.Resources>
        <!-- Crisp Anti-Aliased DirectWrite TextBlock Style -->
        <Style TargetType="TextBlock">
            <Setter Property="RenderOptions.ClearTypeHint" Value="Enabled" />
            <Setter Property="TextOptions.TextFormattingMode" Value="Ideal" />
            <Setter Property="TextOptions.TextRenderingMode" Value="ClearType" />
            <Setter Property="TextOptions.TextHintingMode" Value="Auto" />
            <Setter Property="SnapsToDevicePixels" Value="True" />
            <Setter Property="UseLayoutRounding" Value="True" />
        </Style>

        <!-- Fluent Icon Anti-Aliasing Style: Eliminates staircase pixelation on curved vector glyphs -->
        <Style TargetType="{x:Type ui:SymbolIcon}">
            <Setter Property="SnapsToDevicePixels" Value="False" />
            <Setter Property="UseLayoutRounding" Value="False" />
            <Setter Property="TextOptions.TextRenderingMode" Value="Grayscale" />
            <Setter Property="TextOptions.TextHintingMode" Value="Animated" />
        </Style>

        <!-- Sleek Fluent Dismiss Button Style (32x32, 2px CornerRadius) -->
        <Style x:Key="ModalDismissButtonStyle" TargetType="Button">
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="Width" Value="32" />
            <Setter Property="Height" Value="32" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="FocusVisualStyle" Value="{x:Null}" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Border" Background="{TemplateBinding Background}" CornerRadius="2" SnapsToDevicePixels="True">
                            <ui:SymbolIcon Symbol="Dismiss16" FontSize="13" Foreground="#85FFFFFF" x:Name="Icon" HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Border" Property="Background" Value="#25FFFFFF" />
                                <Setter TargetName="Icon" Property="Foreground" Value="#FFFFFF" />
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="Border" Property="Background" Value="#35FFFFFF" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Subtle Text Action Button Style -->
        <Style x:Key="SubtleActionButtonStyle" TargetType="Button">
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="FocusVisualStyle" Value="{x:Null}" />
            <Setter Property="Padding" Value="0" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border Background="{TemplateBinding Background}" SnapsToDevicePixels="True">
                            <ContentPresenter HorizontalAlignment="Left" VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter Property="Opacity" Value="1.0" />
                            </Trigger>
                            <Trigger Property="IsMouseOver" Value="False">
                                <Setter Property="Opacity" Value="0.75" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Fluent Glass Input Box Style (CornerRadius: 2px, NO black fill, NO accent indicator) -->
        <Style x:Key="FluentGlassInputStyle" TargetType="TextBox">
            <Setter Property="OverridesDefaultStyle" Value="True" />
            <Setter Property="Height" Value="36" />
            <Setter Property="FontSize" Value="12.5" />
            <Setter Property="Foreground" Value="#FFFFFF" />
            <Setter Property="CaretBrush" Value="#FFFFFF" />
            <Setter Property="FocusVisualStyle" Value="{x:Null}" />
            <Setter Property="SnapsToDevicePixels" Value="True" />
            <Setter Property="UseLayoutRounding" Value="True" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="TextBox">
                        <Border x:Name="BoxBorder"
                                Background="#14FFFFFF"
                                BorderBrush="#28FFFFFF"
                                BorderThickness="1"
                                CornerRadius="2"
                                SnapsToDevicePixels="True">
                            <Grid Margin="10,0,10,0">
                                <ScrollViewer x:Name="PART_ContentHost"
                                              VerticalAlignment="Center"
                                              Focusable="False"
                                              HorizontalScrollBarVisibility="Hidden"
                                              VerticalScrollBarVisibility="Hidden" />
                            </Grid>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="BoxBorder" Property="Background" Value="#1CFFFFFF" />
                                <Setter TargetName="BoxBorder" Property="BorderBrush" Value="#45FFFFFF" />
                            </Trigger>
                            <Trigger Property="IsKeyboardFocused" Value="True">
                                <Setter TargetName="BoxBorder" Property="Background" Value="#22FFFFFF" />
                                <Setter TargetName="BoxBorder" Property="BorderBrush" Value="#65FFFFFF" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Fluent Glass Input Box Style with Embedded Right-Side Button Space -->
        <Style x:Key="FluentGlassUrlWithPasteInputStyle" TargetType="TextBox">
            <Setter Property="OverridesDefaultStyle" Value="True" />
            <Setter Property="Height" Value="36" />
            <Setter Property="FontSize" Value="12.5" />
            <Setter Property="Foreground" Value="#FFFFFF" />
            <Setter Property="CaretBrush" Value="#FFFFFF" />
            <Setter Property="FocusVisualStyle" Value="{x:Null}" />
            <Setter Property="SnapsToDevicePixels" Value="True" />
            <Setter Property="UseLayoutRounding" Value="True" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="TextBox">
                        <Border x:Name="BoxBorder"
                                Background="#14FFFFFF"
                                BorderBrush="#28FFFFFF"
                                BorderThickness="1"
                                CornerRadius="2"
                                SnapsToDevicePixels="True">
                            <Grid Margin="10,0,80,0">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>
                                <ui:SymbolIcon x:Name="PrefixIcon"
                                               Symbol="Link24"
                                               FontSize="14"
                                               Foreground="#85FFFFFF"
                                               VerticalAlignment="Center"
                                               Margin="0,0,8,0" />
                                <ScrollViewer x:Name="PART_ContentHost"
                                              Grid.Column="1"
                                              VerticalAlignment="Center"
                                              Focusable="False"
                                              HorizontalScrollBarVisibility="Hidden"
                                              VerticalScrollBarVisibility="Hidden" />
                            </Grid>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="BoxBorder" Property="Background" Value="#1CFFFFFF" />
                                <Setter TargetName="BoxBorder" Property="BorderBrush" Value="#45FFFFFF" />
                                <Setter TargetName="PrefixIcon" Property="Foreground" Value="#B0FFFFFF" />
                            </Trigger>
                            <Trigger Property="IsKeyboardFocused" Value="True">
                                <Setter TargetName="BoxBorder" Property="Background" Value="#22FFFFFF" />
                                <Setter TargetName="BoxBorder" Property="BorderBrush" Value="#65FFFFFF" />
                                <Setter TargetName="PrefixIcon" Property="Foreground" Value="#FFFFFF" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Fluent Glass Input Box Style with Left Search Icon -->
        <Style x:Key="FluentGlassSearchInputStyle" TargetType="TextBox">
            <Setter Property="OverridesDefaultStyle" Value="True" />
            <Setter Property="Height" Value="36" />
            <Setter Property="FontSize" Value="12.5" />
            <Setter Property="Foreground" Value="#FFFFFF" />
            <Setter Property="CaretBrush" Value="#FFFFFF" />
            <Setter Property="SelectionBrush" Value="#40FFFFFF" />
            <Setter Property="SelectionOpacity" Value="0.6" />
            <Setter Property="FocusVisualStyle" Value="{x:Null}" />
            <Setter Property="SnapsToDevicePixels" Value="True" />
            <Setter Property="UseLayoutRounding" Value="True" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="TextBox">
                        <Border x:Name="BoxBorder"
                                Background="#14FFFFFF"
                                BorderBrush="#28FFFFFF"
                                BorderThickness="1"
                                CornerRadius="2"
                                SnapsToDevicePixels="True">
                            <Grid Margin="10,0,10,0">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>
                                <ui:SymbolIcon x:Name="PrefixIcon"
                                               Symbol="Search24"
                                               FontSize="14"
                                               Foreground="#85FFFFFF"
                                               VerticalAlignment="Center"
                                               Margin="0,0,8,0" />
                                <ScrollViewer x:Name="PART_ContentHost"
                                              Grid.Column="1"
                                              VerticalAlignment="Center"
                                              Focusable="False"
                                              HorizontalScrollBarVisibility="Hidden"
                                              VerticalScrollBarVisibility="Hidden" />
                            </Grid>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="BoxBorder" Property="Background" Value="#1CFFFFFF" />
                                <Setter TargetName="BoxBorder" Property="BorderBrush" Value="#45FFFFFF" />
                                <Setter TargetName="PrefixIcon" Property="Foreground" Value="#B0FFFFFF" />
                            </Trigger>
                            <Trigger Property="IsKeyboardFocused" Value="True">
                                <Setter TargetName="BoxBorder" Property="Background" Value="#22FFFFFF" />
                                <Setter TargetName="BoxBorder" Property="BorderBrush" Value="#65FFFFFF" />
                                <Setter TargetName="PrefixIcon" Property="Foreground" Value="#FFFFFF" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Suggestion ListBoxItem Style -->
        <Style x:Key="SuggestionListBoxItemStyle" TargetType="ListBoxItem">
            <Setter Property="OverridesDefaultStyle" Value="True" />
            <Setter Property="FocusVisualStyle" Value="{x:Null}" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Padding" Value="10,6,10,6" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ListBoxItem">
                        <Border x:Name="ItemBorder"
                                Background="Transparent"
                                CornerRadius="2"
                                Margin="2,1,2,1"
                                Padding="{TemplateBinding Padding}"
                                SnapsToDevicePixels="True">
                            <ContentPresenter />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="ItemBorder" Property="Background" Value="#1CFFFFFF" />
                            </Trigger>
                            <Trigger Property="IsSelected" Value="True">
                                <Setter TargetName="ItemBorder" Property="Background" Value="#2AFFFFFF" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Suggestion Item DataTemplate -->
        <DataTemplate x:Key="SuggestionItemTemplate">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <TextBlock Text="{Binding Name}"
                           FontSize="12.5"
                           FontWeight="Medium"
                           Foreground="#FFFFFF"
                           VerticalAlignment="Center"
                           TextTrimming="CharacterEllipsis" />
                <TextBlock Grid.Column="1"
                           Text="{Binding DisplaySubtitle}"
                           FontSize="11"
                           Foreground="#75FFFFFF"
                           VerticalAlignment="Center"
                           Margin="8,0,0,0"
                           TextTrimming="CharacterEllipsis" />
            </Grid>
        </DataTemplate>
    </Window.Resources>

    <!-- Borderless Window Wrapper (CornerRadius: 2px) -->
    <Border Background="Transparent"
            BorderThickness="0"
            CornerRadius="2"
            SnapsToDevicePixels="True">
        <Grid RenderOptions.ClearTypeHint="Enabled">
            <Grid.ColumnDefinitions>
                <!-- COLUMN 0: FROSTED ACRYLIC SIDEBAR -->
                <ColumnDefinition Width="155" />
                <!-- COLUMN 1: OBSIDIAN DARK CONTENT PANEL -->
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>

            <!-- ========================================================= -->
            <!-- COLUMN 0: FROSTED ACRYLIC SIDEBAR                        -->
            <!-- ========================================================= -->
            <Grid Grid.Column="0"
                  Background="Transparent">

                <!-- Vertically and Horizontally Centered Glyph Container -->
                <Grid HorizontalAlignment="Center" VerticalAlignment="Center">
                    <!-- Mode 1: Weather Icon (No enclosing box) -->
                    <Border x:Name="WeatherSidebarGlyph"
                            Background="Transparent"
                            BorderThickness="0"
                            HorizontalAlignment="Center"
                            VerticalAlignment="Center"
                            Visibility="Visible">
                        <ui:SymbolIcon Symbol="WeatherPartlyCloudyDay24"
                                       FontSize="38"
                                       Foreground="#E5FFFFFF"
                                       HorizontalAlignment="Center"
                                       VerticalAlignment="Center" />
                    </Border>

                    <!-- Mode 2: Web Link Live Favicon / Glyph (No enclosing box) -->
                    <Border x:Name="WebLinkSidebarGlyph"
                            Background="Transparent"
                            BorderThickness="0"
                            HorizontalAlignment="Center"
                            VerticalAlignment="Center"
                            Visibility="Collapsed">
                        <Grid>
                            <Image x:Name="WebLinkFaviconImage"
                                   Width="42" Height="42"
                                   HorizontalAlignment="Center"
                                   VerticalAlignment="Center"
                                   Visibility="Collapsed"
                                   RenderOptions.BitmapScalingMode="HighQuality" />

                            <ui:SymbolIcon x:Name="WebLinkFallbackIcon"
                                           Symbol="Globe24"
                                           FontSize="38"
                                           Foreground="#E5FFFFFF"
                                           HorizontalAlignment="Center"
                                           VerticalAlignment="Center" />

                            <ui:ProgressRing x:Name="WebLinkSidebarSpinner"
                                             Width="24" Height="24"
                                             IsIndeterminate="True"
                                             HorizontalAlignment="Center"
                                             VerticalAlignment="Center"
                                             Visibility="Collapsed" />
                        </Grid>
                    </Border>
                </Grid>
            </Grid>

            <!-- ========================================================= -->
            <!-- COLUMN 1: OBSIDIAN DARK CONTENT PANEL                    -->
            <!-- ========================================================= -->
            <Border Grid.Column="1"
                    Background="#1C1C1C"
                    CornerRadius="0,2,2,0"
                    RenderOptions.ClearTypeHint="Enabled">
                <Grid Margin="24,20,24,20">
                    <Grid.RowDefinitions>
                        <!-- Header (Title + Dismiss '✕') -->
                        <RowDefinition Height="Auto" />
                        <!-- Body (Form Inputs) -->
                        <RowDefinition Height="*" />
                        <!-- Footer (Action Buttons) -->
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>

                    <!-- Header -->
                    <Grid Grid.Row="0" Margin="0,0,0,18">
                        <TextBlock x:Name="HeaderTitleText"
                                   Text="Change Location"
                                   FontSize="14.5"
                                   FontWeight="SemiBold"
                                   Foreground="#FFFFFF"
                                   VerticalAlignment="Center" />

                        <Button HorizontalAlignment="Right"
                                Style="{StaticResource ModalDismissButtonStyle}"
                                Click="OnCloseButtonClick" />
                    </Grid>

                    <!-- Body: Weather Form -->
                    <Grid Grid.Row="1" x:Name="WeatherFormGrid" Visibility="Visible">
                        <StackPanel>
                            <TextBlock Text="City Name"
                                       FontSize="12"
                                       Foreground="#95FFFFFF"
                                       Margin="0,0,0,6" />

                            <!-- Clean Fluent TextBox with 2px radius, no black fill, no accent line -->
                            <Grid>
                                <TextBox x:Name="WeatherCityInput"
                                         Style="{StaticResource FluentGlassSearchInputStyle}"
                                         KeyDown="OnWeatherInputKeyDown"
                                         TextChanged="OnWeatherInputTextChanged" />

                                <Popup x:Name="WeatherSuggestionsPopup"
                                       PlacementTarget="{Binding ElementName=WeatherCityInput}"
                                       Placement="Bottom"
                                       StaysOpen="False"
                                       IsOpen="False"
                                       AllowsTransparency="True"
                                       PopupAnimation="Fade">
                                    <Border Width="{Binding ActualWidth, ElementName=WeatherCityInput}"
                                            Background="#232323"
                                            BorderBrush="#38FFFFFF"
                                            BorderThickness="1"
                                            CornerRadius="2"
                                            Margin="0,4,0,0"
                                            SnapsToDevicePixels="True">
                                        <Border.Effect>
                                            <DropShadowEffect BlurRadius="12" Direction="270" ShadowDepth="4" Opacity="0.45" Color="#000000" />
                                        </Border.Effect>
                                        <ListBox x:Name="WeatherSuggestionsList"
                                                 Background="Transparent"
                                                 BorderThickness="0"
                                                 ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                                                 ScrollViewer.VerticalScrollBarVisibility="Auto"
                                                 MaxHeight="180"
                                                 ItemContainerStyle="{StaticResource SuggestionListBoxItemStyle}"
                                                 ItemTemplate="{StaticResource SuggestionItemTemplate}"
                                                 PreviewMouseLeftButtonUp="OnSuggestionListMouseUp"
                                                 KeyDown="OnSuggestionsListKeyDown" />
                                    </Border>
                                </Popup>
                            </Grid>

                            <!-- Auto-Location Button -->
                            <Button Margin="0,12,0,0"
                                    Style="{StaticResource SubtleActionButtonStyle}"
                                    Click="OnWeatherAutoLocationClick">
                                <StackPanel Orientation="Horizontal">
                                    <ui:SymbolIcon Symbol="MyLocation24" FontSize="13" Foreground="#95FFFFFF" Margin="0,0,6,0" VerticalAlignment="Center" />
                                    <TextBlock Text="Reset to automatic location (GPS / IP)" FontSize="12" Foreground="#95FFFFFF" VerticalAlignment="Center" />
                                </StackPanel>
                            </Button>

                            <!-- Status message / Progress ring -->
                            <StackPanel Orientation="Horizontal" Margin="0,12,0,0">
                                <ui:ProgressRing x:Name="WeatherActionSpinner"
                                                 Width="14" Height="14"
                                                 IsIndeterminate="True"
                                                 Visibility="Collapsed"
                                                 Margin="0,0,6,0" />
                                <TextBlock x:Name="WeatherStatusMessage"
                                           FontSize="11.5"
                                           Foreground="#FF8080"
                                           TextWrapping="Wrap"
                                           Visibility="Collapsed" />
                            </StackPanel>
                        </StackPanel>
                    </Grid>

                    <!-- Body: Web Link Form -->
                    <Grid Grid.Row="1" x:Name="WebLinkFormGrid" Visibility="Collapsed">
                        <StackPanel>
                            <!-- Website URL Label -->
                            <TextBlock Text="Website URL"
                                       FontSize="12"
                                       Foreground="#95FFFFFF"
                                       Margin="0,0,0,6" />

                            <!-- URL Input Box with Embedded WPF-UI Paste Button -->
                            <Grid>
                                <TextBox x:Name="WebLinkUrlInput"
                                         Style="{StaticResource FluentGlassUrlWithPasteInputStyle}"
                                         KeyDown="OnWebLinkInputKeyDown"
                                         TextChanged="OnWebLinkUrlTextChanged" />

                                <!-- Docked Paste Button inside the right edge of the input box -->
                                <Button HorizontalAlignment="Right"
                                        VerticalAlignment="Center"
                                        Style="{StaticResource FluentCohesiveSecondaryButtonStyle}"
                                        Height="26"
                                        Margin="0,0,5,0"
                                        Padding="8,2"
                                        Click="OnWebLinkPasteClick">
                                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                        <ui:SymbolIcon Symbol="ClipboardPaste24" FontSize="12" Margin="0,0,5,0" VerticalAlignment="Center" />
                                        <TextBlock Text="Paste" FontSize="11" VerticalAlignment="Center" />
                                    </StackPanel>
                                </Button>
                            </Grid>

                            <!-- Title Input (14px vertical gap) -->
                            <TextBlock Text="Shortcut Label (Optional)"
                                       FontSize="12"
                                       Foreground="#95FFFFFF"
                                       Margin="0,14,0,6" />
                            <TextBox x:Name="WebLinkTitleInput"
                                     Style="{StaticResource FluentGlassInputStyle}"
                                     KeyDown="OnWebLinkInputKeyDown"
                                     TextChanged="OnWebLinkTitleTextChanged" />

                            <!-- Destination Options: RadioButtons with smooth Segoe UI Variable typography -->
                            <StackPanel Orientation="Horizontal" Margin="0,18,0,0">
                                <RadioButton x:Name="WebLinkDestBothRadio"
                                             GroupName="ShortcutDest"
                                             IsChecked="True"
                                             Cursor="Hand"
                                             Margin="0,0,18,0">
                                    <TextBlock Text="Both canvas &amp; sidebar"
                                               FontSize="12"
                                               Foreground="#95FFFFFF"
                                               VerticalAlignment="Center" />
                                </RadioButton>
                                <RadioButton x:Name="WebLinkDestCanvasRadio"
                                             GroupName="ShortcutDest"
                                             Cursor="Hand"
                                             Margin="0,0,18,0">
                                    <TextBlock Text="Canvas only"
                                               FontSize="12"
                                               Foreground="#95FFFFFF"
                                               VerticalAlignment="Center" />
                                </RadioButton>
                                <RadioButton x:Name="WebLinkDestSidebarRadio"
                                             GroupName="ShortcutDest"
                                             Cursor="Hand">
                                    <TextBlock Text="Sidebar only"
                                               FontSize="12"
                                               Foreground="#95FFFFFF"
                                               VerticalAlignment="Center" />
                                </RadioButton>
                            </StackPanel>

                            <!-- Inline Validation Message -->
                            <TextBlock x:Name="WebLinkStatusMessage"
                                       FontSize="11.5"
                                       Foreground="#FF8080"
                                       Margin="0,8,0,0"
                                       TextWrapping="Wrap"
                                       Visibility="Collapsed" />
                        </StackPanel>
                    </Grid>

                    <!-- Footer: Action Button -->
                    <Grid Grid.Row="2" Margin="0,14,0,0">
                        <Button x:Name="PrimaryActionButton"
                                Style="{StaticResource FluentCohesiveActionButtonStyle}"
                                Content="Apply"
                                Height="30"
                                MinWidth="100"
                                Padding="16,0"
                                FontSize="12"
                                IsDefault="True"
                                HorizontalAlignment="Right"
                                Click="OnPrimaryActionButtonClick" />
                    </Grid>

                </Grid>
            </Border>
        </Grid>
    </Border>
</ui:FluentWindow>
