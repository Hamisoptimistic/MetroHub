<ui:FluentWindow x:Class="MetroHub.Presentation.Controls.AcrylicModalWindow"
                  xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                  xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                  xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
                  xmlns:controls="clr-namespace:MetroHub.Presentation.Controls"
                  WindowBackdropType="Acrylic"
                  WindowCornerPreference="DoNotRound"
                  ExtendsContentIntoTitleBar="True"
                  WindowStyle="None"
                  ResizeMode="NoResize"
                  ShowInTaskbar="False"
                  WindowStartupLocation="CenterOwner"
                  Width="620"
                  Height="360"
                  Background="Transparent"
                  Foreground="#FFFFFF"
                  FontFamily="Segoe UI Variable Text, Segoe UI, sans-serif"
                  RenderOptions.ClearTypeHint="Enabled"
                  TextOptions.TextFormattingMode="Ideal"
                  TextOptions.TextRenderingMode="ClearType"
                  TextOptions.TextHintingMode="Auto"
                  SnapsToDevicePixels="True"
                  UseLayoutRounding="True">

    <Window.Resources>
        <!-- Crisp Anti-Aliased DirectWrite TextBlock Style -->
        <Style TargetType="TextBlock">
            <Setter Property="RenderOptions.ClearTypeHint" Value="Enabled" />
            <Setter Property="TextOptions.TextFormattingMode" Value="Ideal" />
            <Setter Property="TextOptions.TextRenderingMode" Value="ClearType" />
            <Setter Property="TextOptions.TextHintingMode" Value="Auto" />
            <Setter Property="SnapsToDevicePixels" Value="True" />
            <Setter Property="UseLayoutRounding" Value="True" />
        </Style>

        <!-- Fluent Icon Anti-Aliasing Style: Eliminates staircase pixelation on curved vector glyphs -->
        <Style TargetType="{x:Type ui:SymbolIcon}">
            <Setter Property="SnapsToDevicePixels" Value="False" />
            <Setter Property="UseLayoutRounding" Value="False" />
            <Setter Property="TextOptions.TextRenderingMode" Value="Grayscale" />
            <Setter Property="TextOptions.TextHintingMode" Value="Animated" />
        </Style>

        <!-- Sleek Fluent Dismiss Button Style (32x32, 2px CornerRadius) -->
        <Style x:Key="ModalDismissButtonStyle" TargetType="Button">
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="Width" Value="32" />
            <Setter Property="Height" Value="32" />
            <Setter Property="FocusVisualStyle" Value="{x:Null}" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Border" Background="{TemplateBinding Background}" CornerRadius="2" SnapsToDevicePixels="True">
                            <Path x:Name="Icon"
                                  Width="10" Height="10"
                                  Data="M 0.5,0.5 L 9.5,9.5 M 0.5,9.5 L 9.5,0.5"
                                  Stroke="#85FFFFFF"
                                  StrokeThickness="1.2"
                                  StrokeStartLineCap="Round"
                                  StrokeEndLineCap="Round"
                                  SnapsToDevicePixels="False"
                                  UseLayoutRounding="False"
                                  RenderOptions.EdgeMode="Unspecified"
                                  HorizontalAlignment="Center"
                                  VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Border" Property="Background" Value="#25FFFFFF" />
                                <Setter TargetName="Icon" Property="Stroke" Value="#FFFFFF" />
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="Border" Property="Background" Value="#35FFFFFF" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Subtle Text Action Button Style -->
        <Style x:Key="SubtleActionButtonStyle" TargetType="Button">
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="FocusVisualStyle" Value="{x:Null}" />
            <Setter Property="Padding" Value="0" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border Background="{TemplateBinding Background}" SnapsToDevicePixels="True">
                            <ContentPresenter HorizontalAlignment="Left" VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter Property="Opacity" Value="1.0" />
                            </Trigger>
                            <Trigger Property="IsMouseOver" Value="False">
                                <Setter Property="Opacity" Value="0.75" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Fluent Glass Input Box Style (CornerRadius: 2px, NO black fill, NO accent indicator) -->
        <Style x:Key="FluentGlassInputStyle" TargetType="TextBox">
            <Setter Property="OverridesDefaultStyle" Value="True" />
            <Setter Property="Height" Value="36" />
            <Setter Property="FontSize" Value="12.5" />
            <Setter Property="Foreground" Value="#FFFFFF" />
            <Setter Property="CaretBrush" Value="#FFFFFF" />
            <Setter Property="FocusVisualStyle" Value="{x:Null}" />
            <Setter Property="SnapsToDevicePixels" Value="True" />
            <Setter Property="UseLayoutRounding" Value="True" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="TextBox">
                        <Border x:Name="BoxBorder"
                                Background="#14FFFFFF"
                                BorderBrush="#28FFFFFF"
                                BorderThickness="1"
                                CornerRadius="2"
                                SnapsToDevicePixels="True">
                            <Grid Margin="10,0,10,0">
                                <ScrollViewer x:Name="PART_ContentHost"
                                              VerticalAlignment="Center"
                                              Focusable="False"
                                              HorizontalScrollBarVisibility="Hidden"
                                              VerticalScrollBarVisibility="Hidden" />
                            </Grid>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="BoxBorder" Property="Background" Value="#1CFFFFFF" />
                                <Setter TargetName="BoxBorder" Property="BorderBrush" Value="#45FFFFFF" />
                            </Trigger>
                            <Trigger Property="IsKeyboardFocused" Value="True">
                                <Setter TargetName="BoxBorder" Property="Background" Value="#22FFFFFF" />
                                <Setter TargetName="BoxBorder" Property="BorderBrush" Value="#65FFFFFF" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Fluent Glass Input Box Style with Embedded Right-Side Button Space -->
        <Style x:Key="FluentGlassUrlWithPasteInputStyle" TargetType="TextBox">
            <Setter Property="OverridesDefaultStyle" Value="True" />
            <Setter Property="Height" Value="36" />
            <Setter Property="FontSize" Value="12.5" />
            <Setter Property="Foreground" Value="#FFFFFF" />
            <Setter Property="CaretBrush" Value="#FFFFFF" />
            <Setter Property="FocusVisualStyle" Value="{x:Null}" />
            <Setter Property="SnapsToDevicePixels" Value="True" />
            <Setter Property="UseLayoutRounding" Value="True" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="TextBox">
                        <Border x:Name="BoxBorder"
                                Background="#14FFFFFF"
                                BorderBrush="#28FFFFFF"
                                BorderThickness="1"
                                CornerRadius="2"
                                SnapsToDevicePixels="True">
                            <Grid Margin="10,0,80,0">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>
                                <ui:SymbolIcon x:Name="PrefixIcon"
                                               Symbol="Link24"
                                               FontSize="14"
                                               Foreground="#85FFFFFF"
                                               VerticalAlignment="Center"
                                               Margin="0,0,8,0" />
                                <ScrollViewer x:Name="PART_ContentHost"
                                              Grid.Column="1"
                                              VerticalAlignment="Center"
                                              Focusable="False"
                                              HorizontalScrollBarVisibility="Hidden"
                                              VerticalScrollBarVisibility="Hidden" />
                            </Grid>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="BoxBorder" Property="Background" Value="#1CFFFFFF" />
                                <Setter TargetName="BoxBorder" Property="BorderBrush" Value="#45FFFFFF" />
                                <Setter TargetName="PrefixIcon" Property="Foreground" Value="#B0FFFFFF" />
                            </Trigger>
                            <Trigger Property="IsKeyboardFocused" Value="True">
                                <Setter TargetName="BoxBorder" Property="Background" Value="#22FFFFFF" />
                                <Setter TargetName="BoxBorder" Property="BorderBrush" Value="#65FFFFFF" />
                                <Setter TargetName="PrefixIcon" Property="Foreground" Value="#FFFFFF" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Fluent Glass Input Box Style with Left Search Icon -->
        <Style x:Key="FluentGlassSearchInputStyle" TargetType="TextBox">
            <Setter Property="OverridesDefaultStyle" Value="True" />
            <Setter Property="Height" Value="36" />
            <Setter Property="FontSize" Value="12.5" />
            <Setter Property="Foreground" Value="#FFFFFF" />
            <Setter Property="CaretBrush" Value="#FFFFFF" />
            <Setter Property="SelectionBrush" Value="#40FFFFFF" />
            <Setter Property="SelectionOpacity" Value="0.6" />
            <Setter Property="FocusVisualStyle" Value="{x:Null}" />
            <Setter Property="SnapsToDevicePixels" Value="True" />
            <Setter Property="UseLayoutRounding" Value="True" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="TextBox">
                        <Border x:Name="BoxBorder"
                                Background="#14FFFFFF"
                                BorderBrush="#28FFFFFF"
                                BorderThickness="1"
                                CornerRadius="2"
                                SnapsToDevicePixels="True">
                            <Grid Margin="10,0,10,0">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>
                                <ui:SymbolIcon x:Name="PrefixIcon"
                                               Symbol="Search24"
                                               FontSize="14"
                                               Foreground="#85FFFFFF"
                                               VerticalAlignment="Center"
                                               Margin="0,0,8,0" />
                                <ScrollViewer x:Name="PART_ContentHost"
                                              Grid.Column="1"
                                              VerticalAlignment="Center"
                                              Focusable="False"
                                              HorizontalScrollBarVisibility="Hidden"
                                              VerticalScrollBarVisibility="Hidden" />
                            </Grid>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="BoxBorder" Property="Background" Value="#1CFFFFFF" />
                                <Setter TargetName="BoxBorder" Property="BorderBrush" Value="#45FFFFFF" />
                                <Setter TargetName="PrefixIcon" Property="Foreground" Value="#B0FFFFFF" />
                            </Trigger>
                            <Trigger Property="IsKeyboardFocused" Value="True">
                                <Setter TargetName="BoxBorder" Property="Background" Value="#22FFFFFF" />
                                <Setter TargetName="BoxBorder" Property="BorderBrush" Value="#65FFFFFF" />
                                <Setter TargetName="PrefixIcon" Property="Foreground" Value="#FFFFFF" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Suggestion ListBoxItem Style -->
        <Style x:Key="SuggestionListBoxItemStyle" TargetType="ListBoxItem">
            <Setter Property="OverridesDefaultStyle" Value="True" />
            <Setter Property="FocusVisualStyle" Value="{x:Null}" />
            <Setter Property="Padding" Value="10,6,10,6" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ListBoxItem">
                        <Border x:Name="ItemBorder"
                                Background="Transparent"
                                CornerRadius="2"
                                Margin="2,1,2,1"
                                Padding="{TemplateBinding Padding}"
                                SnapsToDevicePixels="True">
                            <ContentPresenter />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="ItemBorder" Property="Background" Value="#1CFFFFFF" />
                            </Trigger>
                            <Trigger Property="IsSelected" Value="True">
                                <Setter TargetName="ItemBorder" Property="Background" Value="#2AFFFFFF" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Suggestion Item DataTemplate -->
        <DataTemplate x:Key="SuggestionItemTemplate">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <TextBlock Text="{Binding Name}"
                           FontSize="12.5"
                           FontWeight="Medium"
                           Foreground="#FFFFFF"
                           VerticalAlignment="Center"
                           TextTrimming="CharacterEllipsis" />
                <TextBlock Grid.Column="1"
                           Text="{Binding DisplaySubtitle}"
                           FontSize="11"
                           Foreground="#75FFFFFF"
                           VerticalAlignment="Center"
                           Margin="8,0,0,0"
                           TextTrimming="CharacterEllipsis" />
            </Grid>
        </DataTemplate>

        <!-- Sleek Fluent Glass RadioButton Style (Silk-Smooth Vector Circles, Zero Pixelation) -->
        <Style x:Key="FluentGlassRadioButtonStyle" TargetType="RadioButton">
            <Setter Property="OverridesDefaultStyle" Value="True" />
            <Setter Property="FocusVisualStyle" Value="{x:Null}" />
            <Setter Property="VerticalContentAlignment" Value="Center" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="RadioButton">
                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                            <Grid Width="16" Height="16" Margin="0,0,8,0" VerticalAlignment="Center">
                                <!-- Outer Ring: Explicitly SnapsToDevicePixels=False for smooth curves -->
                                <Ellipse x:Name="OuterRing"
                                         Width="16" Height="16"
                                         Stroke="#45FFFFFF"
                                         StrokeThickness="1.2"
                                         Fill="#10FFFFFF"
                                         SnapsToDevicePixels="False"
                                         UseLayoutRounding="False"
                                         RenderOptions.EdgeMode="Unspecified" />
                                <!-- Inner Dot: Smooth Anti-Aliased Bullet -->
                                <Ellipse x:Name="InnerDot"
                                         Width="8" Height="8"
                                         Fill="#0078D4"
                                         Opacity="0"
                                         SnapsToDevicePixels="False"
                                         UseLayoutRounding="False"
                                         RenderOptions.EdgeMode="Unspecified"
                                         HorizontalAlignment="Center"
                                         VerticalAlignment="Center" />
                            </Grid>
                            <ContentPresenter VerticalAlignment="{TemplateBinding VerticalContentAlignment}" />
                        </StackPanel>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="OuterRing" Property="Stroke" Value="#80FFFFFF" />
                                <Setter TargetName="OuterRing" Property="Fill" Value="#1CFFFFFF" />
                            </Trigger>
                            <Trigger Property="IsChecked" Value="True">
                                <Setter TargetName="OuterRing" Property="Stroke" Value="#0078D4" />
                                <Setter TargetName="OuterRing" Property="Fill" Value="#250078D4" />
                                <Setter TargetName="InnerDot" Property="Opacity" Value="1.0" />
                            </Trigger>
                            <MultiTrigger>
                                <MultiTrigger.Conditions>
                                    <Condition Property="IsChecked" Value="True" />
                                    <Condition Property="IsMouseOver" Value="True" />
                                </MultiTrigger.Conditions>
                                <Setter TargetName="OuterRing" Property="Stroke" Value="#1A88E0" />
                                <Setter TargetName="InnerDot" Property="Fill" Value="#1A88E0" />
                            </MultiTrigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <!-- Fluent Segmented Tab RadioButton Style (Silk-Smooth Segmented Switcher) -->
        <Style x:Key="FluentSegmentedTabRadioButtonStyle" TargetType="RadioButton">
            <Setter Property="OverridesDefaultStyle" Value="True" />
            <Setter Property="FocusVisualStyle" Value="{x:Null}" />
            <Setter Property="Height" Value="28" />
            <Setter Property="FontSize" Value="12" />
            <Setter Property="Foreground" Value="#80FFFFFF" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="HorizontalContentAlignment" Value="Center" />
            <Setter Property="VerticalContentAlignment" Value="Center" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="RadioButton">
                        <Border x:Name="TabBorder"
                                Background="Transparent"
                                CornerRadius="2"
                                Padding="14,0"
                                SnapsToDevicePixels="True">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="TabBorder" Property="Background" Value="#15FFFFFF" />
                                <Setter Property="Foreground" Value="#B0FFFFFF" />
                            </Trigger>
                            <Trigger Property="IsChecked" Value="True">
                                <Setter TargetName="TabBorder" Property="Background" Value="#25FFFFFF" />
                                <Setter Property="Foreground" Value="#FFFFFF" />
                                <Setter Property="FontWeight" Value="SemiBold" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Radio Search Result Item DataTemplate -->
        <DataTemplate x:Key="RadioSearchResultItemTemplate">
            <Grid Margin="0,3">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <StackPanel Grid.Column="0" VerticalAlignment="Center">
                    <TextBlock Text="{Binding Name}"
                               FontSize="12.5"
                               FontWeight="SemiBold"
                               Foreground="#FFFFFF"
                               TextTrimming="CharacterEllipsis" />
                    <TextBlock Text="{Binding Subtitle}"
                               FontSize="11"
                               Foreground="#75FFFFFF"
                               Margin="0,2,0,0"
                               TextTrimming="CharacterEllipsis" />
                </StackPanel>
                <Border Grid.Column="1"
                        Background="#15FFFFFF"
                        CornerRadius="2"
                        Padding="6,2"
                        VerticalAlignment="Center"
                        Margin="8,0,0,0">
                    <TextBlock Text="{Binding BitrateDisplay}"
                               FontSize="10"
                               Foreground="#85FFFFFF" />
                </Border>
            </Grid>
        </DataTemplate>
    </Window.Resources>

    <!-- Borderless Window Wrapper (CornerRadius: 2px) -->
    <Border Background="Transparent"
            BorderThickness="0"
            CornerRadius="2"
            SnapsToDevicePixels="True">
        <Grid RenderOptions.ClearTypeHint="Enabled">
            <Grid.ColumnDefinitions>
                <!-- COLUMN 0: FROSTED ACRYLIC SIDEBAR -->
                <ColumnDefinition Width="155" />
                <!-- COLUMN 1: OBSIDIAN DARK CONTENT PANEL -->
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>

            <!-- ========================================================= -->
            <!-- COLUMN 0: FROSTED ACRYLIC SIDEBAR                        -->
            <!-- ========================================================= -->
            <Grid Grid.Column="0"
                  Background="Transparent">

                <!-- Vertically and Horizontally Centered Glyph Container -->
                <Grid HorizontalAlignment="Center" VerticalAlignment="Center">
                    <!-- Mode 1: Weather Icon (Glassmorphic image) -->
                    <Border x:Name="WeatherSidebarGlyph"
                            Background="Transparent"
                            BorderThickness="0"
                            HorizontalAlignment="Center"
                            VerticalAlignment="Center"
                            Visibility="Visible">
                        <Image Source="/Assets/Weather/Glassmorphic/cloudy-and-rainny.png"
                               Width="72"
                               Height="72"
                               Stretch="Uniform"
                               HorizontalAlignment="Center"
                               VerticalAlignment="Center"
                               RenderOptions.BitmapScalingMode="HighQuality" />
                    </Border>

                    <!-- Mode 2: Web Link Live Favicon / Glyph (No enclosing box) -->
                    <Border x:Name="WebLinkSidebarGlyph"
                            Background="Transparent"
                            BorderThickness="0"
                            HorizontalAlignment="Center"
                            VerticalAlignment="Center"
                            Visibility="Collapsed">
                        <Grid>
                            <Image x:Name="WebLinkFaviconImage"
                                   Width="42" Height="42"
                                   HorizontalAlignment="Center"
                                   VerticalAlignment="Center"
                                   Visibility="Collapsed"
                                   RenderOptions.BitmapScalingMode="HighQuality" />

                            <Image x:Name="WebLinkFallbackIcon"
                                   Source="/Assets/link.png"
                                   Width="72"
                                   Height="72"
                                   Stretch="Uniform"
                                   HorizontalAlignment="Center"
                                   VerticalAlignment="Center"
                                   RenderOptions.BitmapScalingMode="HighQuality" />

                            <ui:ProgressRing x:Name="WebLinkSidebarSpinner"
                                             Width="24" Height="24"
                                             IsIndeterminate="True"
                                             HorizontalAlignment="Center"
                                             VerticalAlignment="Center"
                                             Visibility="Collapsed" />
                        </Grid>
                    </Border>

                    <!-- Mode 3: Radio Station Vector Glyph (No Cover Art/Favicons) -->
                    <Border x:Name="RadioSidebarGlyph"
                            Background="Transparent"
                            BorderThickness="0"
                            HorizontalAlignment="Center"
                            VerticalAlignment="Center"
                            Visibility="Collapsed">
                        <Grid HorizontalAlignment="Center" VerticalAlignment="Center">
                            <Ellipse Width="80" Height="80"
                                     Fill="#184A90E2">
                                <Ellipse.Effect>
                                    <BlurEffect Radius="20" />
                                </Ellipse.Effect>
                            </Ellipse>
                            <ui:SymbolIcon Symbol="HeadphonesSoundWave24"
                                           FontSize="56"
                                           Foreground="#D0FFFFFF"
                                           HorizontalAlignment="Center"
                                           VerticalAlignment="Center" />
                        </Grid>
                    </Border>
                </Grid>
            </Grid>

            <!-- ========================================================= -->
            <!-- COLUMN 1: OBSIDIAN DARK CONTENT PANEL                    -->
            <!-- ========================================================= -->
            <Border Grid.Column="1"
                    Background="#232323"
                    CornerRadius="0,2,2,0"
                    RenderOptions.ClearTypeHint="Enabled">
                <Grid Margin="24,20,24,20">
                    <Grid.RowDefinitions>
                        <!-- Header (Title + Dismiss '✕') -->
                        <RowDefinition Height="Auto" />
                        <!-- Body (Form Inputs) -->
                        <RowDefinition Height="*" />
                        <!-- Footer (Action Buttons) -->
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>

                    <!-- Header -->
                    <Grid Grid.Row="0" Margin="0,0,0,18">
                        <TextBlock x:Name="HeaderTitleText"
                                   Text="Change Location"
                                   FontSize="14.5"
                                   FontWeight="SemiBold"
                                   Foreground="#FFFFFF"
                                   VerticalAlignment="Center" />

                        <Button HorizontalAlignment="Right"
                                Style="{StaticResource ModalDismissButtonStyle}"
                                Click="OnCloseButtonClick" />
                    </Grid>

                    <!-- Body: Weather Form -->
                    <Grid Grid.Row="1" x:Name="WeatherFormGrid" Visibility="Visible">
                        <StackPanel>
                            <TextBlock Text="City Name"
                                       FontSize="12"
                                       Foreground="#95FFFFFF"
                                       Margin="0,0,0,6" />

                            <!-- Clean Fluent TextBox with 2px radius, no black fill, no accent line -->
                            <Grid>
                                <TextBox x:Name="WeatherCityInput"
                                         Style="{StaticResource FluentGlassSearchInputStyle}"
                                         PreviewKeyDown="OnWeatherInputPreviewKeyDown"
                                         TextChanged="OnWeatherInputTextChanged" />

                                <Popup x:Name="WeatherSuggestionsPopup"
                                       PlacementTarget="{Binding ElementName=WeatherCityInput}"
                                       Placement="Bottom"
                                       VerticalOffset="-1"
                                       HorizontalOffset="0"
                                       StaysOpen="False"
                                       IsOpen="False"
                                       AllowsTransparency="True"
                                       PopupAnimation="Fade">
                                    <Border Width="{Binding ActualWidth, ElementName=WeatherCityInput}"
                                            Background="#232323"
                                            BorderBrush="#40FFFFFF"
                                            BorderThickness="1"
                                            CornerRadius="0,0,2,2"
                                            SnapsToDevicePixels="True">
                                        <ListBox x:Name="WeatherSuggestionsList"
                                                 Background="Transparent"
                                                 BorderThickness="0"
                                                 Padding="0,2,0,2"
                                                 ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                                                 ScrollViewer.VerticalScrollBarVisibility="Auto"
                                                 controls:AutoHideScrollBehavior.IsEnabled="True"
                                                 MaxHeight="172"
                                                 ItemContainerStyle="{StaticResource SuggestionListBoxItemStyle}"
                                                 ItemTemplate="{StaticResource SuggestionItemTemplate}"
                                                 PreviewMouseLeftButtonUp="OnSuggestionListMouseUp"
                                                 PreviewKeyDown="OnSuggestionsListPreviewKeyDown">
                                            <ListBox.Resources>
                                                <Style TargetType="{x:Type ScrollBar}" BasedOn="{StaticResource WidgetFloatingScrollBarStyle}" />
                                            </ListBox.Resources>
                                        </ListBox>
                                    </Border>
                                </Popup>
                            </Grid>

                            <!-- Auto-Location Button -->
                            <Button Margin="0,12,0,0"
                                    Style="{StaticResource SubtleActionButtonStyle}"
                                    Click="OnWeatherAutoLocationClick">
                                <StackPanel Orientation="Horizontal">
                                    <ui:SymbolIcon Symbol="MyLocation24" FontSize="13" Foreground="#95FFFFFF" Margin="0,0,6,0" VerticalAlignment="Center" />
                                    <TextBlock Text="Reset to automatic location (GPS / IP)" FontSize="12" Foreground="#95FFFFFF" VerticalAlignment="Center" />
                                </StackPanel>
                            </Button>

                            <!-- Status message / Progress ring -->
                            <StackPanel Orientation="Horizontal" Margin="0,12,0,0">
                                <ui:ProgressRing x:Name="WeatherActionSpinner"
                                                 Width="14" Height="14"
                                                 IsIndeterminate="True"
                                                 Visibility="Collapsed"
                                                 Margin="0,0,6,0" />
                                <TextBlock x:Name="WeatherStatusMessage"
                                           FontSize="11.5"
                                           Foreground="#FF8080"
                                           TextWrapping="Wrap"
                                           Visibility="Collapsed" />
                            </StackPanel>
                        </StackPanel>
                    </Grid>

                    <!-- Body: Web Link Form -->
                    <Grid Grid.Row="1" x:Name="WebLinkFormGrid" Visibility="Collapsed">
                        <StackPanel>
                            <!-- Website URL Label -->
                            <TextBlock Text="Website URL"
                                       FontSize="12"
                                       Foreground="#95FFFFFF"
                                       Margin="0,0,0,6" />

                            <!-- URL Input Box with Embedded WPF-UI Paste Button -->
                            <Grid>
                                <TextBox x:Name="WebLinkUrlInput"
                                         Style="{StaticResource FluentGlassUrlWithPasteInputStyle}"
                                         KeyDown="OnWebLinkInputKeyDown"
                                         TextChanged="OnWebLinkUrlTextChanged" />

                                <!-- Docked Paste Button inside the right edge of the input box -->
                                <Button HorizontalAlignment="Right"
                                        VerticalAlignment="Center"
                                        Style="{StaticResource FluentCohesiveSecondaryButtonStyle}"
                                        Height="26"
                                        Margin="0,0,5,0"
                                        Padding="8,2"
                                        Click="OnWebLinkPasteClick">
                                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                        <ui:SymbolIcon Symbol="ClipboardPaste24" FontSize="12" Margin="0,0,5,0" VerticalAlignment="Center" />
                                        <TextBlock Text="Paste" FontSize="11" VerticalAlignment="Center" />
                                    </StackPanel>
                                </Button>
                            </Grid>

                            <!-- Title Input (14px vertical gap) -->
                            <TextBlock Text="Shortcut Label (Optional)"
                                       FontSize="12"
                                       Foreground="#95FFFFFF"
                                       Margin="0,14,0,6" />
                            <TextBox x:Name="WebLinkTitleInput"
                                     Style="{StaticResource FluentGlassInputStyle}"
                                     KeyDown="OnWebLinkInputKeyDown"
                                     TextChanged="OnWebLinkTitleTextChanged" />

                            <!-- Destination Options: RadioButtons with smooth Segoe UI Variable typography -->
                            <StackPanel Orientation="Horizontal" Margin="0,18,0,0">
                                <RadioButton x:Name="WebLinkDestBothRadio"
                                             Style="{StaticResource FluentGlassRadioButtonStyle}"
                                             GroupName="ShortcutDest"
                                             IsChecked="True"
                                             Margin="0,0,18,0">
                                    <TextBlock Text="Both canvas &amp; sidebar"
                                               FontSize="12"
                                               Foreground="#95FFFFFF"
                                               VerticalAlignment="Center" />
                                </RadioButton>
                                <RadioButton x:Name="WebLinkDestCanvasRadio"
                                             Style="{StaticResource FluentGlassRadioButtonStyle}"
                                             GroupName="ShortcutDest"
                                             Margin="0,0,18,0">
                                    <TextBlock Text="Canvas only"
                                               FontSize="12"
                                               Foreground="#95FFFFFF"
                                               VerticalAlignment="Center" />
                                </RadioButton>
                                <RadioButton x:Name="WebLinkDestSidebarRadio"
                                             Style="{StaticResource FluentGlassRadioButtonStyle}"
                                             GroupName="ShortcutDest"
                                             >
                                    <TextBlock Text="Sidebar only"
                                               FontSize="12"
                                               Foreground="#95FFFFFF"
                                               VerticalAlignment="Center" />
                                </RadioButton>
                            </StackPanel>

                            <!-- Inline Validation Message -->
                            <TextBlock x:Name="WebLinkStatusMessage"
                                       FontSize="11.5"
                                       Foreground="#FF8080"
                                       Margin="0,8,0,0"
                                       TextWrapping="Wrap"
                                       Visibility="Collapsed" />
                        </StackPanel>
                    </Grid>

                    <!-- Body: Radio Station Form -->
                    <Grid Grid.Row="1" x:Name="RadioFormGrid" Visibility="Collapsed">
                        <Grid.RowDefinitions>
                            <!-- Tab Switcher -->
                            <RowDefinition Height="Auto" />
                            <!-- Active Tab Form Area -->
                            <RowDefinition Height="*" />
                            <!-- Target Category Selector -->
                            <RowDefinition Height="Auto" />
                        </Grid.RowDefinitions>

                        <!-- Two-Tab Segmented Selector -->
                        <Border Grid.Row="0"
                                Background="#12FFFFFF"
                                CornerRadius="2"
                                Padding="2"
                                HorizontalAlignment="Left"
                                Margin="0,0,0,10">
                            <StackPanel Orientation="Horizontal">
                                <RadioButton x:Name="RadioSearchTabRadio"
                                             Style="{StaticResource FluentSegmentedTabRadioButtonStyle}"
                                             GroupName="RadioAddTabs"
                                             Content="Search Stations"
                                             IsChecked="True"
                                             Checked="OnRadioTabChanged" />
                                <RadioButton x:Name="RadioDirectTabRadio"
                                             Style="{StaticResource FluentSegmentedTabRadioButtonStyle}"
                                             GroupName="RadioAddTabs"
                                             Content="Direct Stream URL"
                                             Checked="OnRadioTabChanged" />
                            </StackPanel>
                        </Border>

                        <!-- TAB 1: Search Stations Panel -->
                        <Grid Grid.Row="1" x:Name="RadioSearchPanel" Visibility="Visible">
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="*" />
                                <RowDefinition Height="Auto" />
                            </Grid.RowDefinitions>

                            <!-- Search Input Box with Overlay Watermark & Spinner -->
                            <Grid Grid.Row="0">
                                <TextBox x:Name="RadioSearchInput"
                                         Style="{StaticResource FluentGlassSearchInputStyle}"
                                         TextChanged="OnRadioSearchInputTextChanged"
                                         PreviewKeyDown="OnRadioSearchInputKeyDown" />
                                <TextBlock x:Name="RadioSearchWatermark"
                                           Text="Search station name, genre (e.g. lofi, jazz, ambient)..."
                                           FontSize="12"
                                           Foreground="#50FFFFFF"
                                           IsHitTestVisible="False"
                                           VerticalAlignment="Center"
                                           Margin="34,0,10,0" />
                                <ui:ProgressRing x:Name="RadioSearchSpinner"
                                                 Width="14" Height="14"
                                                 IsIndeterminate="True"
                                                 HorizontalAlignment="Right"
                                                 VerticalAlignment="Center"
                                                 Margin="0,0,10,0"
                                                 Visibility="Collapsed" />
                            </Grid>

                            <!-- Search Results List -->
                            <Border Grid.Row="1"
                                    Background="#14FFFFFF"
                                    BorderBrush="#25FFFFFF"
                                    BorderThickness="1"
                                    CornerRadius="2"
                                    Margin="0,8,0,0"
                                    SnapsToDevicePixels="True">
                                <Grid>
                                    <ListBox x:Name="RadioSearchResultsList"
                                             Background="Transparent"
                                             BorderThickness="0"
                                             Padding="2"
                                             ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                                             ScrollViewer.VerticalScrollBarVisibility="Auto"
                                             controls:AutoHideScrollBehavior.IsEnabled="True"
                                             ItemContainerStyle="{StaticResource SuggestionListBoxItemStyle}"
                                             ItemTemplate="{StaticResource RadioSearchResultItemTemplate}"
                                             SelectionChanged="OnRadioSearchResultsSelectionChanged">
                                        <ListBox.Resources>
                                            <Style TargetType="{x:Type ScrollBar}" BasedOn="{StaticResource WidgetFloatingScrollBarStyle}" />
                                        </ListBox.Resources>
                                    </ListBox>

                                    <!-- Search Initial Hint / Empty Text -->
                                    <TextBlock x:Name="RadioSearchPlaceholderText"
                                               Text="Type 2 or more characters to search 40,000+ online stations"
                                               FontSize="11.5"
                                               Foreground="#60FFFFFF"
                                               HorizontalAlignment="Center"
                                               VerticalAlignment="Center"
                                               IsHitTestVisible="False"
                                               Visibility="Visible" />
                                </Grid>
                            </Border>

                            <!-- Search Status Message -->
                            <TextBlock Grid.Row="2"
                                       x:Name="RadioSearchStatusMessage"
                                       FontSize="11.5"
                                       Foreground="#FF8080"
                                       Margin="0,6,0,0"
                                       TextWrapping="Wrap"
                                       Visibility="Collapsed" />
                        </Grid>

                        <!-- TAB 2: Direct Stream URL Panel -->
                        <Grid Grid.Row="1" x:Name="RadioDirectPanel" Visibility="Collapsed">
                            <StackPanel>
                                <!-- Stream URL Label -->
                                <TextBlock Text="Audio Stream URL"
                                           FontSize="12"
                                           Foreground="#95FFFFFF"
                                           Margin="0,0,0,6" />

                                <!-- URL Input Box with Embedded Paste Button -->
                                <Grid>
                                    <TextBox x:Name="RadioDirectUrlInput"
                                             Style="{StaticResource FluentGlassUrlWithPasteInputStyle}"
                                             TextChanged="OnRadioDirectUrlTextChanged"
                                             KeyDown="OnRadioDirectInputKeyDown" />
                                    <Button HorizontalAlignment="Right"
                                            VerticalAlignment="Center"
                                            Style="{StaticResource FluentCohesiveSecondaryButtonStyle}"
                                            Height="26"
                                            Margin="0,0,5,0"
                                            Padding="8,2"
                                            Click="OnRadioDirectPasteClick">
                                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                            <ui:SymbolIcon Symbol="ClipboardPaste24" FontSize="12" Margin="0,0,5,0" VerticalAlignment="Center" />
                                            <TextBlock Text="Paste" FontSize="11" VerticalAlignment="Center" />
                                        </StackPanel>
                                    </Button>
                                </Grid>

                                <!-- Probe State Live Indicator -->
                                <StackPanel Orientation="Horizontal" Margin="0,6,0,0" MinHeight="18">
                                    <ui:ProgressRing x:Name="RadioProbeSpinner"
                                                     Width="12" Height="12"
                                                     IsIndeterminate="True"
                                                     Visibility="Collapsed"
                                                     Margin="0,0,6,0" />
                                    <ui:SymbolIcon x:Name="RadioProbeIcon"
                                                   Symbol="Checkmark24"
                                                   FontSize="13"
                                                   Visibility="Collapsed"
                                                   Margin="0,0,6,0"
                                                   VerticalAlignment="Center" />
                                    <TextBlock x:Name="RadioProbeStatusText"
                                               Text="Supports MP3/AAC/OGG streams or single-station .pls/.m3u"
                                               FontSize="11.5"
                                               Foreground="#65FFFFFF"
                                               VerticalAlignment="Center" />
                                </StackPanel>

                                <!-- Station Name Input -->
                                <TextBlock Text="Station Name"
                                           FontSize="12"
                                           Foreground="#95FFFFFF"
                                           Margin="0,8,0,6" />
                                <TextBox x:Name="RadioDirectNameInput"
                                         Style="{StaticResource FluentGlassInputStyle}"
                                         TextChanged="OnRadioDirectNameTextChanged"
                                         KeyDown="OnRadioDirectInputKeyDown" />

                                <!-- Inline Validation Message -->
                                <TextBlock x:Name="RadioDirectStatusMessage"
                                           FontSize="11.5"
                                           Foreground="#FF8080"
                                           Margin="0,6,0,0"
                                           TextWrapping="Wrap"
                                           Visibility="Collapsed" />
                            </StackPanel>
                        </Grid>

                        <!-- Target Category Selector -->
                        <StackPanel Grid.Row="2" Orientation="Horizontal" VerticalAlignment="Center" Margin="0,8,0,0">
                            <TextBlock Text="Category:"
                                       FontSize="12"
                                       Foreground="#80FFFFFF"
                                       VerticalAlignment="Center"
                                       Margin="0,0,12,0" />
                            <RadioButton x:Name="RadioCatAmbient"
                                         Style="{StaticResource FluentGlassRadioButtonStyle}"
                                         GroupName="RadioCategoryTarget"
                                         IsChecked="True"
                                         Margin="0,0,14,0">
                                <TextBlock Text="Ambient" FontSize="12" Foreground="#95FFFFFF" VerticalAlignment="Center" />
                            </RadioButton>
                            <RadioButton x:Name="RadioCatNature"
                                         Style="{StaticResource FluentGlassRadioButtonStyle}"
                                         GroupName="RadioCategoryTarget"
                                         Margin="0,0,14,0">
                                <TextBlock Text="Nature" FontSize="12" Foreground="#95FFFFFF" VerticalAlignment="Center" />
                            </RadioButton>
                            <RadioButton x:Name="RadioCatLofi"
                                         Style="{StaticResource FluentGlassRadioButtonStyle}"
                                         GroupName="RadioCategoryTarget"
                                         Margin="0,0,14,0">
                                <TextBlock Text="Lo-Fi" FontSize="12" Foreground="#95FFFFFF" VerticalAlignment="Center" />
                            </RadioButton>
                            <RadioButton x:Name="RadioCatCoding"
                                         Style="{StaticResource FluentGlassRadioButtonStyle}"
                                         GroupName="RadioCategoryTarget">
                                <TextBlock Text="Coding" FontSize="12" Foreground="#95FFFFFF" VerticalAlignment="Center" />
                            </RadioButton>
                        </StackPanel>
                    </Grid>

                    <!-- Footer: Current Location (Left) + Action Button (Right) -->
                    <Grid Grid.Row="2" Margin="0,14,0,0">
                        <StackPanel x:Name="CurrentLocationPanel"
                                    Orientation="Horizontal"
                                    VerticalAlignment="Center"
                                    HorizontalAlignment="Left"
                                    Visibility="Collapsed">
                            <ui:SymbolIcon Symbol="Location24"
                                           FontSize="13"
                                           Foreground="#85FFFFFF"
                                           Margin="0,0,6,0"
                                           VerticalAlignment="Center" />
                            <TextBlock x:Name="CurrentLocationText"
                                       Text="Current Location: ..."
                                       FontSize="12"
                                       Foreground="#85FFFFFF"
                                       VerticalAlignment="Center" />
                        </StackPanel>

                        <Button x:Name="PrimaryActionButton"
                                Style="{StaticResource FluentCohesiveActionButtonStyle}"
                                Content="Apply"
                                Height="30"
                                MinWidth="100"
                                Padding="16,0"
                                FontSize="12"
                                IsDefault="True"
                                HorizontalAlignment="Right"
                                Click="OnPrimaryActionButtonClick" />
                    </Grid>

                </Grid>
            </Border>
        </Grid>
    </Border>
</ui:FluentWindow>
