<UserControl x:Class="MetroHub.Presentation.Controls.FluentVolumeSlider"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             mc:Ignorable="d"
             Height="20"
             MinHeight="18"
             Focusable="False"
             ClipToBounds="False"
             SnapsToDevicePixels="True"
             UseLayoutRounding="True">

    <Grid x:Name="RootContainer"
          Background="Transparent"
          ClipToBounds="False"
          PreviewMouseLeftButtonDown="OnPreviewMouseLeftButtonDown"
          PreviewMouseMove="OnPreviewMouseMove"
          PreviewMouseLeftButtonUp="OnPreviewMouseLeftButtonUp"
          PreviewMouseWheel="OnPreviewMouseWheel"
          MouseEnter="OnMouseEnter"
          MouseLeave="OnMouseLeave"
          SizeChanged="OnSizeChanged"
          SnapsToDevicePixels="True">

        <!-- 1. Dark Glass Background Under-Groove (4px tall) -->
        <Border x:Name="TrackTrough"
                Height="4"
                VerticalAlignment="Center"
                Background="#45000000"
                CornerRadius="2"
                SnapsToDevicePixels="True" />

        <!-- 2. Frosted Unfilled Track Background (4px tall) -->
        <Border x:Name="TrackBg"
                Height="4"
                VerticalAlignment="Center"
                Background="#35FFFFFF"
                CornerRadius="2"
                SnapsToDevicePixels="True" />

        <!-- 3. Active Luminous Accent Progress Fill (4px tall) -->
        <Border x:Name="ProgressFill"
                Height="4"
                HorizontalAlignment="Stretch"
                VerticalAlignment="Center"
                Background="#00B4D8"
                CornerRadius="2"
                SnapsToDevicePixels="True">
            <Border.Clip>
                <RectangleGeometry x:Name="ProgressClip" Rect="0,-10,0,40" />
            </Border.Clip>
        </Border>

        <!-- 4. Fluent Thumb Container (Circular ring thumb, hidden at rest) -->
        <Grid x:Name="SliderThumb"
              HorizontalAlignment="Left"
              VerticalAlignment="Center"
              IsHitTestVisible="False"
              Opacity="0">
            <Grid.RenderTransform>
                <TranslateTransform x:Name="ThumbTranslate" X="0" />
            </Grid.RenderTransform>

            <!-- Hollow ring thumb: white outer ring with transparent center (track shows through) -->
            <Ellipse x:Name="ThumbDot"
                     Width="14"
                     Height="14"
                     Fill="Transparent"
                     Stroke="#FFFFFF"
                     StrokeThickness="3"
                     HorizontalAlignment="Center"
                     VerticalAlignment="Center" />
        </Grid>

    </Grid>
</UserControl>
