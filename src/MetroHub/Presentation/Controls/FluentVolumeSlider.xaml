<UserControl x:Class="MetroHub.Presentation.Controls.FluentVolumeSlider"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             mc:Ignorable="d"
             Height="20"
             MinHeight="18"
             Focusable="False"
             ClipToBounds="False"
             SnapsToDevicePixels="True"
             UseLayoutRounding="True">

    <Grid x:Name="RootContainer"
          Background="Transparent"
          ClipToBounds="False"
          PreviewMouseLeftButtonDown="OnPreviewMouseLeftButtonDown"
          PreviewMouseMove="OnPreviewMouseMove"
          PreviewMouseLeftButtonUp="OnPreviewMouseLeftButtonUp"
          PreviewMouseWheel="OnPreviewMouseWheel"
          MouseEnter="OnMouseEnter"
          MouseLeave="OnMouseLeave"
          SizeChanged="OnSizeChanged"
          SnapsToDevicePixels="True">

        <!-- 1. Active Luminous Accent Progress Fill (Left Segment: 0 -> thumbLeft - gap) -->
        <Grid x:Name="ProgressFillContainer"
              Height="3"
              HorizontalAlignment="Left"
              VerticalAlignment="Center">
            <!-- Glass Under-Groove for depth/contrast -->
            <Border Height="3"
                    Background="#25000000"
                    CornerRadius="1.5"
                    SnapsToDevicePixels="True" />
            <!-- Active Accent Fill Bar -->
            <Border x:Name="ProgressFill"
                    Height="3"
                    Background="#00B4D8"
                    CornerRadius="1.5"
                    SnapsToDevicePixels="True" />
        </Grid>

        <!-- 2. Frosted Unfilled Track (Right Segment: thumbRight + gap -> width) -->
        <Grid x:Name="TrackUnfilledContainer"
              Height="3"
              HorizontalAlignment="Left"
              VerticalAlignment="Center">
            <!-- Glass Under-Groove for depth/contrast -->
            <Border Height="3"
                    Background="#25000000"
                    CornerRadius="1.5"
                    SnapsToDevicePixels="True" />
            <!-- Frosted Unfilled Track Surface -->
            <Border x:Name="TrackUnfilled"
                    Height="3"
                    Background="#38FFFFFF"
                    CornerRadius="1.5"
                    SnapsToDevicePixels="True" />
        </Grid>

        <!-- 3. Fluent Thumb Container (Hollow circular ring thumb, isolated by gaps) -->
        <Grid x:Name="SliderThumb"
              HorizontalAlignment="Left"
              VerticalAlignment="Center"
              IsHitTestVisible="False"
              Opacity="1"
              RenderTransformOrigin="0.5,0.5">
            <Grid.RenderTransform>
                <TransformGroup>
                    <ScaleTransform x:Name="ThumbScale" ScaleX="1.0" ScaleY="1.0" />
                    <TranslateTransform x:Name="ThumbTranslate" X="0" />
                </TransformGroup>
            </Grid.RenderTransform>

            <!-- Crisp hollow ring thumb: white ring with transparent center (fill —gap— ring —gap— unfilled) -->
            <Ellipse x:Name="ThumbDot"
                     Width="14"
                     Height="14"
                     Fill="Transparent"
                     Stroke="#FFFFFF"
                     StrokeThickness="2.5"
                     HorizontalAlignment="Center"
                     VerticalAlignment="Center" />
        </Grid>

    </Grid>
</UserControl>
