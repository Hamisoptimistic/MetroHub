<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:sys="clr-namespace:System;assembly=mscorlib">

    <!-- ========================================================================= -->
    <!-- CENTRAL TYPOGRAPHY & ICON TOKENS                                          -->
    <!-- ========================================================================= -->
    <FontFamily x:Key="AppFontFamily">Segoe UI Variable Text, Segoe UI Variable, Segoe UI, sans-serif</FontFamily>
    <FontFamily x:Key="AppDisplayFontFamily">Segoe UI Variable Display, Segoe UI Variable, Segoe UI, sans-serif</FontFamily>
    <FontFamily x:Key="AppIconFontFamily">Segoe Fluent Icons, Segoe MDL2 Assets, sans-serif</FontFamily>
    <FontFamily x:Key="AppMonoFontFamily">Consolas, Cascadia Code, Segoe UI Mono, monospace</FontFamily>

    <!-- Core Fluent 2 Typography Ramp Tokens (Microsoft Standard) -->
    <!-- Caption: Metadata, timestamps, helper notes, specs, audio bitrates (12px Regular) -->
    <sys:Double x:Key="TypeCaptionFontSize">12</sys:Double>
    <x:Static Member="FontWeights.Normal" x:Key="TypeCaptionFontWeight" />

    <!-- Body: Default content, device names, list rows, inputs (14px Regular) -->
    <sys:Double x:Key="TypeBodyFontSize">14</sys:Double>
    <x:Static Member="FontWeights.Normal" x:Key="TypeBodyFontWeight" />

    <!-- BodyStrong: Selected items, active device, slider readout, buttons (14px SemiBold) -->
    <sys:Double x:Key="TypeBodyStrongFontSize">14</sys:Double>
    <x:Static Member="FontWeights.SemiBold" x:Key="TypeBodyStrongFontWeight" />

    <!-- Header: Widget titles, section headers, dialog titles (16px SemiBold) -->
    <sys:Double x:Key="TypeHeaderFontSize">16</sys:Double>
    <x:Static Member="FontWeights.SemiBold" x:Key="TypeHeaderFontWeight" />

    <!-- Subtitle: Group headers, drawer alphabet letters, categories (18px Bold) -->
    <sys:Double x:Key="TypeSubtitleFontSize">18</sys:Double>
    <x:Static Member="FontWeights.Bold" x:Key="TypeSubtitleFontWeight" />

    <!-- Display: Card readouts, Pomodoro countdown, Speed test number (28px SemiBold) -->
    <sys:Double x:Key="TypeDisplayFontSize">28</sys:Double>
    <x:Static Member="FontWeights.SemiBold" x:Key="TypeDisplayFontWeight" />

    <!-- Hero: Ambient giant readouts (Clock, Weather 24°, Calendar day) (72px Bold) -->
    <sys:Double x:Key="TypeHeroFontSize">72</sys:Double>
    <x:Static Member="FontWeights.Bold" x:Key="TypeHeroFontWeight" />

    <!-- Monospace & Code Tokens (Dino, Notepad editor, Markdown code) (13px Regular) -->
    <sys:Double x:Key="TypeMonoCodeFontSize">13</sys:Double>
    <x:Static Member="FontWeights.Normal" x:Key="TypeMonoCodeFontWeight" />

    <!-- Viewbox Coordinate Tokens (Geometry basis, not physical screen pixels) -->
    <sys:Double x:Key="TypeHeroCoordinateFontSize">100.0</sys:Double>
    <sys:Double x:Key="TypeQuoteBodyCoordinateFontSize">19.5</sys:Double>
    <sys:Double x:Key="TypeCalendarDayCoordinateFontSize">112.0</sys:Double>

    <!-- Harmonized Text Contrast Colors & Brushes -->
    <Color x:Key="TextPrimaryColor">#FFFFFF</Color>
    <SolidColorBrush x:Key="TextPrimaryBrush" Color="{StaticResource TextPrimaryColor}" />
    <Color x:Key="TextSecondaryColor">#D8E2EC</Color>
    <SolidColorBrush x:Key="TextSecondaryBrush" Color="{StaticResource TextSecondaryColor}" />
    <Color x:Key="TextMutedColor">#95A8BE</Color>
    <SolidColorBrush x:Key="TextMutedBrush" Color="{StaticResource TextMutedColor}" />
    <Color x:Key="TextSubtleColor">#70FFFFFF</Color>
    <SolidColorBrush x:Key="TextSubtleBrush" Color="{StaticResource TextSubtleColor}" />
    <Color x:Key="TextDisabledColor">#45FFFFFF</Color>
    <SolidColorBrush x:Key="TextDisabledBrush" Color="{StaticResource TextDisabledColor}" />

    <!-- ========================================================================= -->
    <!-- OBSIDIAN ACRYLIC CONTENTDIALOG THEME TOKENS (WPF-UI 3.0.4)                -->
    <!-- ========================================================================= -->
    <SolidColorBrush x:Key="ContentDialogBackground" Color="#F214161A" />
    <SolidColorBrush x:Key="ContentDialogBorderBrush" Color="#35FFFFFF" />
    <SolidColorBrush x:Key="ContentDialogSmokeFill" Color="#8A08080C" />
    <SolidColorBrush x:Key="SmokeFillColorDefaultBrush" Color="#8A08080C" />
    <SolidColorBrush x:Key="ContentDialogSeparatorBorderBrush" Color="#18FFFFFF" />
    <SolidColorBrush x:Key="ContentDialogTopOverlay" Color="#08FFFFFF" />
    <CornerRadius x:Key="DialogOverlayCornerRadius">10,10,0,0</CornerRadius>
    <CornerRadius x:Key="DialogFooterCornerRadius">0,0,10,10</CornerRadius>

    <!-- ========================================================================= -->
    <!-- UNIVERSAL FLUENT GEOMETRY & INTERACTION TOKENS                            -->
    <!-- ========================================================================= -->
    <!-- Standard Control & Button Corner Radius -->
    <CornerRadius x:Key="ControlCornerRadius">2</CornerRadius>
    <CornerRadius x:Key="ControlCornerRadiusSmall">2</CornerRadius>
    <CornerRadius x:Key="ControlCornerRadiusLarge">4</CornerRadius>

    <!-- ContextMenu & Dropdown Container / Item Radius -->
    <CornerRadius x:Key="ContextMenuCornerRadius">2</CornerRadius>

    <!-- MetroHub Tile Geometry Tokens -->
    <!-- Default: 2 for Subtle Fluent/Metro edge. (0 = Sharp Metro, 2 = Subtle Fluent, 4 = Medium Fluent, 8 = Rounded Fluent) -->
    <CornerRadius x:Key="TileCornerRadius">2</CornerRadius>

    <!-- Universal Fluent Dark-Glass Interaction Brushes -->
    <SolidColorBrush x:Key="FluentHoverBrush" Color="#12FFFFFF" />
    <SolidColorBrush x:Key="FluentPressedBrush" Color="#1EFFFFFF" />
    <SolidColorBrush x:Key="FluentHoverBorderBrush" Color="Transparent" />

    <!-- ========================================================================= -->
    <!-- CENTRAL FLUENT 2 SYSTEM ACCENT COLOR TOKENS                               -->
    <!-- ========================================================================= -->
    <Color x:Key="SystemAccentColor">#4CC2FF</Color>
    <SolidColorBrush x:Key="SystemAccentColorBrush" Color="{StaticResource SystemAccentColor}" />
    <SolidColorBrush x:Key="SystemAccentColorPrimaryBrush" Color="#4CC2FF" />
    <SolidColorBrush x:Key="SystemAccentColorSecondaryBrush" Color="#60CDFF" />
    <SolidColorBrush x:Key="SystemAccentColorTertiaryBrush" Color="#2886C8" />
    <SolidColorBrush x:Key="SystemAccentColorSelectionFill" Color="{StaticResource SystemAccentColor}" Opacity="0.15" />
    <SolidColorBrush x:Key="SystemAccentColorDropSlotFill" Color="{StaticResource SystemAccentColor}" Opacity="0.20" />
    <SolidColorBrush x:Key="SystemAccentColorGroupDropFill" Color="{StaticResource SystemAccentColor}" Opacity="0.08" />

    <!-- ========================================================================= -->
    <!-- UNIVERSAL SEMANTIC STATUS COLORS (Constant across all themes)             -->
    <!-- ========================================================================= -->
    <Color x:Key="StatusSuccessColor">#00E676</Color>
    <SolidColorBrush x:Key="StatusSuccessBrush" Color="{StaticResource StatusSuccessColor}" />
    <Color x:Key="StatusWarningColor">#FFB900</Color>
    <SolidColorBrush x:Key="StatusWarningBrush" Color="{StaticResource StatusWarningColor}" />
    <Color x:Key="StatusDangerColor">#FF453A</Color>
    <SolidColorBrush x:Key="StatusDangerBrush" Color="{StaticResource StatusDangerColor}" />
    <Color x:Key="StatusErrorColor">#FF6B6B</Color>
    <SolidColorBrush x:Key="StatusErrorBrush" Color="{StaticResource StatusErrorColor}" />
    <Color x:Key="StatusInfoColor">#60CDFF</Color>
    <SolidColorBrush x:Key="StatusInfoBrush" Color="{StaticResource StatusInfoColor}" />

    <!-- Universal Hairline Divider Token -->
    <Color x:Key="WidgetDividerColor">#14FFFFFF</Color>
    <SolidColorBrush x:Key="WidgetDividerBrush" Color="{StaticResource WidgetDividerColor}" />

    <!-- ========================================================================= -->
    <!-- FLUENT 2 MOTION & ANIMATION TOKENS                                        -->
    <!-- ========================================================================= -->
    <!-- Standard Microsoft Fluent Durations -->
    <Duration x:Key="FluentDurationFast">0:0:0.100</Duration>
    <Duration x:Key="FluentDurationNormal">0:0:0.200</Duration>
    <Duration x:Key="FluentDurationGentle">0:0:0.350</Duration>

    <!-- Standard Microsoft Fluent Easing Curves -->
    <CubicEase x:Key="FluentDecelerateEase" EasingMode="EaseOut" />
    <CubicEase x:Key="FluentAccelerateEase" EasingMode="EaseIn" />
    <CircleEase x:Key="FluentCircleEase" EasingMode="EaseOut" />
    <QuadraticEase x:Key="FluentStandardEase" EasingMode="EaseOut" />

    <!-- ========================================================================= -->
    <!-- FLUENT 2 ELEVATION & SHADOW TOKENS                                        -->
    <!-- Note: x:Shared="False" ensures independent Freezable instances per element -->
    <!-- ========================================================================= -->
    <DropShadowEffect x:Key="ShadowCard" BlurRadius="14" Direction="270" ShadowDepth="3" Opacity="0.28" Color="#000000" x:Shared="False" />
    <DropShadowEffect x:Key="StudioGlassTextShadow" BlurRadius="28" Direction="270" ShadowDepth="4" Opacity="0.22" Color="#080E1A" x:Shared="False" />
    <DropShadowEffect x:Key="GlowDotSmall" BlurRadius="4" ShadowDepth="0" Opacity="0.8" Color="{DynamicResource SystemAccentColor}" x:Shared="False" />

</ResourceDictionary>
