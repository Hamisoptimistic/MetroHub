<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:sys="clr-namespace:System;assembly=mscorlib"
                    xmlns:po="http://schemas.microsoft.com/winfx/2006/xaml/presentation/options">

    <!-- ========================================================================= -->
    <!-- CENTRAL TYPOGRAPHY & ICON TOKENS                                          -->
    <!-- ========================================================================= -->
    <FontFamily x:Key="AppFontFamily">Segoe UI Variable Text, Segoe UI Variable, Segoe UI, sans-serif</FontFamily>
    <FontFamily x:Key="AppDisplayFontFamily">Segoe UI Variable Display, Segoe UI Variable, Segoe UI, sans-serif</FontFamily>
    <FontFamily x:Key="AppIconFontFamily">Segoe Fluent Icons, Segoe MDL2 Assets, sans-serif</FontFamily>
    <FontFamily x:Key="AppMonoFontFamily">Consolas, Cascadia Code, Segoe UI Mono, monospace</FontFamily>

    <!-- Core Fluent 2 Typography Ramp Tokens (Microsoft Standard) -->
    <!-- Caption: Metadata, timestamps, helper notes, specs, audio bitrates (12px Regular) -->
    <sys:Double x:Key="TypeCaptionFontSize">12</sys:Double>
    <x:Static Member="FontWeights.Normal" x:Key="TypeCaptionFontWeight" />

    <!-- Body: Default content, device names, list rows, inputs (14px Regular) -->
    <sys:Double x:Key="TypeBodyFontSize">14</sys:Double>
    <x:Static Member="FontWeights.Normal" x:Key="TypeBodyFontWeight" />

    <!-- BodyStrong: Selected items, active device, slider readout, buttons (14px SemiBold) -->
    <sys:Double x:Key="TypeBodyStrongFontSize">14</sys:Double>
    <x:Static Member="FontWeights.SemiBold" x:Key="TypeBodyStrongFontWeight" />

    <!-- Header: Widget titles, section headers, dialog titles (16px SemiBold) -->
    <sys:Double x:Key="TypeHeaderFontSize">16</sys:Double>
    <x:Static Member="FontWeights.SemiBold" x:Key="TypeHeaderFontWeight" />

    <!-- Subtitle: Group headers, drawer alphabet letters, categories (18px Bold) -->
    <sys:Double x:Key="TypeSubtitleFontSize">18</sys:Double>
    <x:Static Member="FontWeights.Bold" x:Key="TypeSubtitleFontWeight" />

    <!-- Display: Card readouts, Pomodoro countdown, Speed test number (28px SemiBold) -->
    <sys:Double x:Key="TypeDisplayFontSize">28</sys:Double>
    <x:Static Member="FontWeights.SemiBold" x:Key="TypeDisplayFontWeight" />

    <!-- Hero: Ambient giant readouts (Clock, Weather 24°, Calendar day) (72px Bold) -->
    <sys:Double x:Key="TypeHeroFontSize">72</sys:Double>
    <x:Static Member="FontWeights.Bold" x:Key="TypeHeroFontWeight" />

    <!-- Monospace & Code Tokens (Dino, System Code) (13px Regular) -->
    <sys:Double x:Key="TypeMonoCodeFontSize">13</sys:Double>
    <x:Static Member="FontWeights.Normal" x:Key="TypeMonoCodeFontWeight" />

    <!-- Viewbox Coordinate Tokens (Geometry basis, not physical screen pixels) -->
    <sys:Double x:Key="TypeHeroCoordinateFontSize">100.0</sys:Double>
    <sys:Double x:Key="TypeQuoteBodyCoordinateFontSize">19.5</sys:Double>
    <sys:Double x:Key="TypeCalendarDayCoordinateFontSize">112.0</sys:Double>

    <!-- Responsive Hub UI Scale Factor Token (Default 1.0 = 100%) -->
    <sys:Double x:Key="AppUiScale">1.0</sys:Double>

    <!-- Harmonized 2-Tier Text System (Pure White + Luminous Icy Off-White) -->
    <Color x:Key="TextPrimaryColor">#FFFFFF</Color>
    <SolidColorBrush x:Key="TextPrimaryBrush" Color="{StaticResource TextPrimaryColor}" po:Freeze="True" />
    <Color x:Key="TextSecondaryColor">#D8E2EC</Color>
    <SolidColorBrush x:Key="TextSecondaryBrush" Color="{StaticResource TextSecondaryColor}" po:Freeze="True" />

    <!-- Unified Aliases: All subtitles, descriptions, and labels inherit the single luminous off-white -->
    <Color x:Key="TextMutedColor">#D8E2EC</Color>
    <SolidColorBrush x:Key="TextMutedBrush" Color="{StaticResource TextSecondaryColor}" po:Freeze="True" />
    <Color x:Key="TextSubtleColor">#D8E2EC</Color>
    <SolidColorBrush x:Key="TextSubtleBrush" Color="{StaticResource TextSecondaryColor}" po:Freeze="True" />

    <!-- Utility: Truly Disabled Controls Only -->
    <Color x:Key="TextDisabledColor">#45FFFFFF</Color>
    <SolidColorBrush x:Key="TextDisabledBrush" Color="{StaticResource TextDisabledColor}" po:Freeze="True" />

    <!-- ========================================================================= -->
    <!-- OBSIDIAN ACRYLIC CONTENTDIALOG THEME TOKENS (WPF-UI 3.0.4)                -->
    <!-- ========================================================================= -->
    <SolidColorBrush x:Key="ContentDialogBackground" Color="#F214161A" po:Freeze="True" />
    <SolidColorBrush x:Key="ContentDialogBorderBrush" Color="#35FFFFFF" po:Freeze="True" />
    <SolidColorBrush x:Key="SmokeFillColorDefaultBrush" Color="#1A08080C" po:Freeze="True" />
    <SolidColorBrush x:Key="ContentDialogSeparatorBorderBrush" Color="#18FFFFFF" po:Freeze="True" />
    <SolidColorBrush x:Key="ContentDialogTopOverlay" Color="#08FFFFFF" po:Freeze="True" />
    <CornerRadius x:Key="DialogOverlayCornerRadius">10,10,0,0</CornerRadius>
    <!-- Tier 2 Obsidian Deck Tint (calibrated translucent acrylic tint matching SettingsWindow) -->
    <SolidColorBrush x:Key="DialogPanelBackground" Color="#280D0D11" po:Freeze="True" />
    <SolidColorBrush x:Key="DialogShellBackground" Color="#202020" po:Freeze="True" />
    <SolidColorBrush x:Key="DialogShellBorderBrush" Color="#33FFFFFF" po:Freeze="True" />

    <!-- ========================================================================= -->
    <!-- SHELL & CANVAS CHROME OVERLAY TOKENS                                      -->
    <!-- ========================================================================= -->
    <SolidColorBrush x:Key="ShellBadgeBackground" Color="#F0202022" po:Freeze="True" />
    <SolidColorBrush x:Key="ShellToastBackground" Color="#EE18181C" po:Freeze="True" />
    <CornerRadius x:Key="ToastCornerRadius">8</CornerRadius>

    <!-- ========================================================================= -->
    <!-- CANVAS GROUP COLOR PALETTE (10 Standard Metro/Fluent Accents)             -->
    <!-- ========================================================================= -->
    <Color x:Key="GroupColorDefault">#F0FFFFFF</Color>
    <SolidColorBrush x:Key="GroupBrushDefault" Color="{StaticResource GroupColorDefault}" po:Freeze="True" />

    <Color x:Key="GroupColorSkyBlue">#60CDFF</Color>
    <SolidColorBrush x:Key="GroupBrushSkyBlue" Color="{StaticResource GroupColorSkyBlue}" po:Freeze="True" />

    <Color x:Key="GroupColorAzure">#0078D7</Color>
    <SolidColorBrush x:Key="GroupBrushAzure" Color="{StaticResource GroupColorAzure}" po:Freeze="True" />

    <Color x:Key="GroupColorEmerald">#107C10</Color>
    <SolidColorBrush x:Key="GroupBrushEmerald" Color="{StaticResource GroupColorEmerald}" po:Freeze="True" />

    <Color x:Key="GroupColorCyan">#00B7C3</Color>
    <SolidColorBrush x:Key="GroupBrushCyan" Color="{StaticResource GroupColorCyan}" po:Freeze="True" />

    <Color x:Key="GroupColorOrange">#FF8C00</Color>
    <SolidColorBrush x:Key="GroupBrushOrange" Color="{StaticResource GroupColorOrange}" po:Freeze="True" />

    <Color x:Key="GroupColorAmber">#FFD700</Color>
    <SolidColorBrush x:Key="GroupBrushAmber" Color="{StaticResource GroupColorAmber}" po:Freeze="True" />

    <Color x:Key="GroupColorCrimson">#FF4343</Color>
    <SolidColorBrush x:Key="GroupBrushCrimson" Color="{StaticResource GroupColorCrimson}" po:Freeze="True" />

    <Color x:Key="GroupColorPurple">#881798</Color>
    <SolidColorBrush x:Key="GroupBrushPurple" Color="{StaticResource GroupColorPurple}" po:Freeze="True" />

    <Color x:Key="GroupColorHotPink">#E3008C</Color>
    <SolidColorBrush x:Key="GroupBrushHotPink" Color="{StaticResource GroupColorHotPink}" po:Freeze="True" />

    <!-- ========================================================================= -->
    <!-- UNIVERSAL FLUENT GEOMETRY & INTERACTION TOKENS                            -->
    <!-- ========================================================================= -->
    <!-- Standard Control & Button Corner Radius -->
    <CornerRadius x:Key="ControlCornerRadius">2</CornerRadius>
    <CornerRadius x:Key="ControlCornerRadiusSmall">2</CornerRadius>
    <CornerRadius x:Key="ControlCornerRadiusLarge">4</CornerRadius>
    <CornerRadius x:Key="ControlCornerRadiusBottom">0,0,2,2</CornerRadius>
    <CornerRadius x:Key="ControlCornerRadiusTop">2,2,0,0</CornerRadius>
    <CornerRadius x:Key="TileCornerRadiusRight">0,2,2,0</CornerRadius>

    <!-- Dialog Geometry Tokens (Fluent 2 Window / Modal Spec) -->
    <CornerRadius x:Key="DialogCornerRadius">8</CornerRadius>
    <CornerRadius x:Key="DialogContentPanelCornerRadius">0,7,7,0</CornerRadius>

    <!-- ContextMenu & Dropdown Container / Item Radius -->
    <CornerRadius x:Key="ContextMenuCornerRadius">2</CornerRadius>

    <!-- MetroHub Tile Geometry Tokens -->
    <!-- Default: 2 for Subtle Fluent/Metro edge. (0 = Sharp Metro, 2 = Subtle Fluent, 4 = Medium Fluent, 8 = Rounded Fluent) -->
    <CornerRadius x:Key="TileCornerRadius">2</CornerRadius>

    <!-- Universal Fluent Dark-Glass Interaction Brushes -->
    <SolidColorBrush x:Key="FluentHoverBrush" Color="#12FFFFFF" po:Freeze="True" />
    <SolidColorBrush x:Key="FluentPressedBrush" Color="#1EFFFFFF" po:Freeze="True" />
    <SolidColorBrush x:Key="FluentHoverBorderBrush" Color="Transparent" po:Freeze="True" />

    <!-- Fluent Dark-Glass Surface & Border Tokens -->
    <SolidColorBrush x:Key="SurfaceGlassBrush" Color="#18FFFFFF" po:Freeze="True" />
    <SolidColorBrush x:Key="MonthBackplateBrush" Color="#18FFFFFF" po:Freeze="True" />
    <SolidColorBrush x:Key="SurfaceGlassSubtleBrush" Color="#10FFFFFF" po:Freeze="True" />
    <SolidColorBrush x:Key="SurfaceBorderBrush" Color="#20FFFFFF" po:Freeze="True" />
    <SolidColorBrush x:Key="SurfaceBorderSubtleBrush" Color="#15FFFFFF" po:Freeze="True" />
    <SolidColorBrush x:Key="SurfaceInsetWellBrush" Color="#14000000" po:Freeze="True" />

    <!-- ========================================================================= -->
    <!-- CENTRAL FLUENT 2 SYSTEM ACCENT COLOR TOKENS                               -->
    <!-- ========================================================================= -->
    <Color x:Key="SystemAccentColor">#4CC2FF</Color>
    <SolidColorBrush x:Key="SystemAccentColorBrush" Color="{StaticResource SystemAccentColor}" po:Freeze="True" />
    <SolidColorBrush x:Key="SystemAccentColorPrimaryBrush" Color="{StaticResource SystemAccentColor}" po:Freeze="True" />
    <SolidColorBrush x:Key="SystemAccentColorSolidBrush" Color="{StaticResource SystemAccentColor}" po:Freeze="True" />
    <SolidColorBrush x:Key="SystemAccentColorSecondaryBrush" Color="#60CDFF" po:Freeze="True" />
    <SolidColorBrush x:Key="SystemAccentColorTertiaryBrush" Color="#2886C8" po:Freeze="True" />
    <SolidColorBrush x:Key="SystemAccentColorForegroundBrush" Color="#FFFFFF" po:Freeze="True" />
    <SolidColorBrush x:Key="SystemAccentColorSelectionFill" Color="{StaticResource SystemAccentColor}" Opacity="0.15" po:Freeze="True" />
    <SolidColorBrush x:Key="SystemAccentColorDropSlotFill" Color="{StaticResource SystemAccentColor}" Opacity="0.20" po:Freeze="True" />
    <SolidColorBrush x:Key="SystemAccentColorGroupDropFill" Color="{StaticResource SystemAccentColor}" Opacity="0.08" po:Freeze="True" />

    <!-- ========================================================================= -->
    <!-- UNIVERSAL SEMANTIC STATUS COLORS (Constant across all themes)             -->
    <!-- ========================================================================= -->
    <Color x:Key="StatusSuccessColor">#00E676</Color>
    <Color x:Key="StatusSuccessHoverColor">#00FF85</Color>
    <Color x:Key="StatusSuccessPressedColor">#00CC6A</Color>
    <SolidColorBrush x:Key="StatusSuccessBrush" Color="{StaticResource StatusSuccessColor}" po:Freeze="True" />
    <SolidColorBrush x:Key="StatusSuccessHoverBrush" Color="{StaticResource StatusSuccessHoverColor}" po:Freeze="True" />
    <SolidColorBrush x:Key="StatusSuccessPressedBrush" Color="{StaticResource StatusSuccessPressedColor}" po:Freeze="True" />

    <Color x:Key="StatusWarningColor">#FFB900</Color>
    <Color x:Key="StatusWarningHoverColor">#FFC629</Color>
    <Color x:Key="StatusWarningPressedColor">#E5A600</Color>
    <SolidColorBrush x:Key="StatusWarningBrush" Color="{StaticResource StatusWarningColor}" po:Freeze="True" />
    <SolidColorBrush x:Key="StatusWarningHoverBrush" Color="{StaticResource StatusWarningHoverColor}" po:Freeze="True" />
    <SolidColorBrush x:Key="StatusWarningPressedBrush" Color="{StaticResource StatusWarningPressedColor}" po:Freeze="True" />

    <Color x:Key="StatusDangerColor">#FF453A</Color>
    <Color x:Key="StatusDangerHoverColor">#FF6961</Color>
    <Color x:Key="StatusDangerPressedColor">#D9362C</Color>
    <SolidColorBrush x:Key="StatusDangerBrush" Color="{StaticResource StatusDangerColor}" po:Freeze="True" />
    <SolidColorBrush x:Key="StatusDangerHoverBrush" Color="{StaticResource StatusDangerHoverColor}" po:Freeze="True" />
    <SolidColorBrush x:Key="StatusDangerPressedBrush" Color="{StaticResource StatusDangerPressedColor}" po:Freeze="True" />

    <Color x:Key="StatusErrorColor">#FF6B6B</Color>
    <SolidColorBrush x:Key="StatusErrorBrush" Color="{StaticResource StatusErrorColor}" po:Freeze="True" />
    <Color x:Key="StatusInfoColor">#60CDFF</Color>
    <SolidColorBrush x:Key="StatusInfoBrush" Color="{StaticResource StatusInfoColor}" po:Freeze="True" />
    <Color x:Key="StatusDangerGlowColor">#FF4343</Color>
    <SolidColorBrush x:Key="StatusDangerGlowBrush" Color="{StaticResource StatusDangerGlowColor}" po:Freeze="True" />
    <SolidColorBrush x:Key="StatusDangerSubtleBrush" Color="#22FF4343" po:Freeze="True" />

    <!-- Universal Indicator Dot & Hairline Divider Tokens -->
    <SolidColorBrush x:Key="IndicatorDotInactiveBrush" Color="#25FFFFFF" po:Freeze="True" />
    <Color x:Key="WidgetDividerColor">#14FFFFFF</Color>
    <SolidColorBrush x:Key="WidgetDividerBrush" Color="{StaticResource WidgetDividerColor}" po:Freeze="True" />

    <!-- ========================================================================= -->
    <!-- FLUENT 2 MOTION & ANIMATION TOKENS                                        -->
    <!-- ========================================================================= -->
    <!-- Standard Microsoft Fluent Durations -->
    <Duration x:Key="FluentDurationFast">0:0:0.100</Duration>
    <Duration x:Key="FluentDurationNormal">0:0:0.200</Duration>
    <Duration x:Key="FluentDurationGentle">0:0:0.350</Duration>

    <!-- Standard Microsoft Fluent Easing Curves -->
    <CubicEase x:Key="FluentDecelerateEase" EasingMode="EaseOut" />
    <CubicEase x:Key="FluentAccelerateEase" EasingMode="EaseIn" />
    <CircleEase x:Key="FluentCircleEase" EasingMode="EaseOut" />
    <QuadraticEase x:Key="FluentStandardEase" EasingMode="EaseOut" />

    <!-- ========================================================================= -->
    <!-- FLUENT 2 ELEVATION & SHADOW TOKENS                                        -->
    <!-- Note: x:Shared="False" ensures independent Freezable instances per element -->
    <!-- ========================================================================= -->
    <DropShadowEffect x:Key="ShadowCard" BlurRadius="14" Direction="270" ShadowDepth="3" Opacity="0.28" Color="#000000" x:Shared="False" />
    <DropShadowEffect x:Key="StudioGlassTextShadow" BlurRadius="6" Direction="270" ShadowDepth="2" Opacity="0.30" Color="#080E1A" RenderingBias="Performance" x:Shared="False" />

</ResourceDictionary>
