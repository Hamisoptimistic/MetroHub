<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
                    xmlns:dialogs="clr-namespace:MetroHub.Presentation.Dialogs">

    <!-- ========================================================================= -->
    <!-- COHESIVE FLUENT ACTION BUTTON STYLES                                      -->
    <!-- ========================================================================= -->
    <!-- UNIVERSAL FLUENT COHESIVE BUTTON (Master Button DNA)                      -->
    <!-- Unified Frosted Glass Button: Connect, Cancel, Turn Off, Paste, Options   -->
    <!-- ========================================================================= -->
    <Style x:Key="FluentCohesiveButtonStyle" TargetType="Button">
        <Setter Property="Height" Value="32" />
        <Setter Property="MinWidth" Value="85" />
        <Setter Property="Padding" Value="14,0" />
        <Setter Property="Background" Value="#1CFFFFFF" />
        <Setter Property="BorderBrush" Value="#20FFFFFF" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="Foreground" Value="#F5FFFFFF" />
        <Setter Property="FontFamily" Value="{DynamicResource AppFontFamily}" />
        <Setter Property="FontSize" Value="{DynamicResource TypeBodyStrongFontSize}" />
        <Setter Property="FontWeight" Value="{DynamicResource TypeBodyStrongFontWeight}" />
        <Setter Property="FocusVisualStyle" Value="{x:Null}" />
        <Setter Property="Cursor" Value="Hand" />
        <Setter Property="HorizontalContentAlignment" Value="Center" />
        <Setter Property="VerticalContentAlignment" Value="Center" />
        <Setter Property="SnapsToDevicePixels" Value="True" />
        <Setter Property="UseLayoutRounding" Value="True" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Button">
                    <Border x:Name="ButtonBorder"
                            Background="{TemplateBinding Background}"
                            BorderBrush="{TemplateBinding BorderBrush}"
                            BorderThickness="{TemplateBinding BorderThickness}"
                            CornerRadius="{DynamicResource ControlCornerRadius}">
                        <ContentPresenter HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}"
                                          VerticalAlignment="{TemplateBinding VerticalContentAlignment}"
                                          Margin="{TemplateBinding Padding}" />
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="ButtonBorder" Property="Background" Value="#28FFFFFF" />
                            <Setter TargetName="ButtonBorder" Property="BorderBrush" Value="#38FFFFFF" />
                            <Setter Property="Foreground" Value="{DynamicResource TextPrimaryBrush}" />
                        </Trigger>
                        <Trigger Property="IsPressed" Value="True">
                            <Setter TargetName="ButtonBorder" Property="Background" Value="{DynamicResource FluentPressedBrush}" />
                            <Setter TargetName="ButtonBorder" Property="BorderBrush" Value="#25FFFFFF" />
                            <Setter Property="Foreground" Value="{DynamicResource TextPrimaryBrush}" />
                        </Trigger>
                        <Trigger Property="IsEnabled" Value="False">
                            <Setter TargetName="ButtonBorder" Property="Opacity" Value="0.35" />
                            <Setter Property="Cursor" Value="Arrow" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- Compatibility aliases: seamlessly route legacy keys to the single master style -->
    <Style x:Key="FluentCohesiveActionButtonStyle" TargetType="Button" BasedOn="{StaticResource FluentCohesiveButtonStyle}" />
    <Style x:Key="FluentCohesiveSecondaryButtonStyle" TargetType="Button" BasedOn="{StaticResource FluentCohesiveButtonStyle}" />

    <!-- Universal Fluent Ghost Button Style (Icon / Toolbar / Header Buttons) -->
    <Style x:Key="FluentGhostButtonStyle" TargetType="Button">
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="BorderBrush" Value="Transparent" />
        <Setter Property="BorderThickness" Value="0" />
        <Setter Property="Foreground" Value="#95FFFFFF" />
        <Setter Property="FocusVisualStyle" Value="{x:Null}" />
        <Setter Property="HorizontalContentAlignment" Value="Center" />
        <Setter Property="VerticalContentAlignment" Value="Center" />
        <Setter Property="SnapsToDevicePixels" Value="True" />
        <Setter Property="UseLayoutRounding" Value="True" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Button">
                    <Border x:Name="PillBorder"
                            Background="{TemplateBinding Background}"
                            BorderBrush="{TemplateBinding BorderBrush}"
                            BorderThickness="{TemplateBinding BorderThickness}"
                            CornerRadius="{DynamicResource ControlCornerRadius}"
                            >
                        <ContentPresenter HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}"
                                          VerticalAlignment="{TemplateBinding VerticalContentAlignment}"
                                          Margin="{TemplateBinding Padding}"
                                          />
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="PillBorder" Property="Background" Value="{DynamicResource FluentHoverBrush}" />
                            <Setter Property="Foreground" Value="{DynamicResource TextPrimaryBrush}" />
                        </Trigger>
                        <Trigger Property="IsPressed" Value="True">
                            <Setter TargetName="PillBorder" Property="Background" Value="{DynamicResource FluentPressedBrush}" />
                            <Setter Property="Foreground" Value="{DynamicResource TextPrimaryBrush}" />
                        </Trigger>
                        <Trigger Property="IsEnabled" Value="False">
                            <Setter TargetName="PillBorder" Property="Opacity" Value="0.35" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- Implicit Default Button Style: All standard Buttons inherit sidebar hover by default -->
    <Style TargetType="Button" BasedOn="{StaticResource FluentGhostButtonStyle}" />

    <!-- Universal Fluent Primary Accent Button Style (Dialog Confirm / Save / Add) -->
    <!-- Frosted Glass with Subtle Accent Tint & Border, matching Connect DNA -->
    <Style x:Key="FluentCohesivePrimaryButtonStyle" TargetType="Button">
        <Setter Property="OverridesDefaultStyle" Value="True" />
        <Setter Property="Height" Value="32" />
        <Setter Property="MinWidth" Value="100" />
        <Setter Property="Padding" Value="16,0" />
        <Setter Property="FontSize" Value="{DynamicResource TypeBodyStrongFontSize}" />
        <Setter Property="FontWeight" Value="{DynamicResource TypeBodyStrongFontWeight}" />
        <Setter Property="Foreground" Value="{DynamicResource TextPrimaryBrush}" />
        <Setter Property="FocusVisualStyle" Value="{x:Null}" />
        <Setter Property="Cursor" Value="Hand" />
        <Setter Property="SnapsToDevicePixels" Value="True" />
        <Setter Property="UseLayoutRounding" Value="True" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Button">
                    <Border x:Name="BtnBorder"
                            Background="{DynamicResource FluentPrimaryButtonBackgroundBrush}"
                            BorderBrush="{DynamicResource FluentPrimaryButtonBorderBrush}"
                            BorderThickness="1"
                            CornerRadius="{DynamicResource ControlCornerRadius}">
                        <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" Margin="{TemplateBinding Padding}" />
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="BtnBorder" Property="Background" Value="{DynamicResource FluentPrimaryButtonHoverBackgroundBrush}" />
                            <Setter TargetName="BtnBorder" Property="BorderBrush" Value="{DynamicResource FluentPrimaryButtonHoverBorderBrush}" />
                        </Trigger>
                        <Trigger Property="IsPressed" Value="True">
                            <Setter TargetName="BtnBorder" Property="Background" Value="{DynamicResource FluentPrimaryButtonPressedBackgroundBrush}" />
                            <Setter TargetName="BtnBorder" Property="BorderBrush" Value="{DynamicResource FluentPrimaryButtonPressedBorderBrush}" />
                        </Trigger>
                        <Trigger Property="IsEnabled" Value="False">
                            <Setter TargetName="BtnBorder" Property="Opacity" Value="0.35" />
                            <Setter Property="Cursor" Value="Arrow" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- Universal Modal Window Close / Dismiss Button (32x32 vector "X") -->
    <Style x:Key="ModalDismissButtonStyle" TargetType="Button">
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="BorderThickness" Value="0" />
        <Setter Property="Width" Value="32" />
        <Setter Property="Height" Value="32" />
        <Setter Property="FocusVisualStyle" Value="{x:Null}" />
        <Setter Property="Cursor" Value="Hand" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Button">
                    <Border x:Name="Border" Background="{TemplateBinding Background}" CornerRadius="{DynamicResource ControlCornerRadius}">
                        <Path x:Name="Icon"
                              Width="10" Height="10"
                              Data="M 0.5,0.5 L 9.5,9.5 M 0.5,9.5 L 9.5,0.5"
                              Stroke="#85FFFFFF"
                              StrokeThickness="1.2"
                              StrokeStartLineCap="Round"
                              StrokeEndLineCap="Round"
                              SnapsToDevicePixels="False"
                              UseLayoutRounding="False"
                              HorizontalAlignment="Center"
                              VerticalAlignment="Center" />
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="Border" Property="Background" Value="#25FFFFFF" />
                            <Setter TargetName="Icon" Property="Stroke" Value="{DynamicResource TextPrimaryBrush}" />
                        </Trigger>
                        <Trigger Property="IsPressed" Value="True">
                            <Setter TargetName="Border" Property="Background" Value="#35FFFFFF" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- Compatibility alias for Habit widget edit modal -->
    <Style x:Key="HabitDismissButtonStyle" TargetType="Button" BasedOn="{StaticResource ModalDismissButtonStyle}" />

    <!-- ========================================================================= -->
    <!-- UNIVERSAL FLUENT GLASS INPUT STYLES (Dialogs, Flyouts & Forms)             -->
    <!-- ========================================================================= -->
    <Style x:Key="FluentGlassInputStyle" TargetType="TextBox">
        <Setter Property="OverridesDefaultStyle" Value="True" />
        <Setter Property="Height" Value="36" />
        <Setter Property="FontSize" Value="{DynamicResource TypeBodyFontSize}" />
        <Setter Property="FontWeight" Value="{DynamicResource TypeBodyFontWeight}" />
        <Setter Property="Foreground" Value="{DynamicResource TextPrimaryBrush}" />
        <Setter Property="CaretBrush" Value="{DynamicResource TextPrimaryBrush}" />
        <Setter Property="FocusVisualStyle" Value="{x:Null}" />
        <Setter Property="SnapsToDevicePixels" Value="True" />
        <Setter Property="UseLayoutRounding" Value="True" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="TextBox">
                    <Border x:Name="BoxBorder"
                            Background="{DynamicResource WidgetDividerBrush}"
                            BorderBrush="#28FFFFFF"
                            BorderThickness="1"
                            CornerRadius="{DynamicResource ControlCornerRadius}">
                        <Grid Margin="10,0,10,0">
                            <ScrollViewer x:Name="PART_ContentHost"
                                          VerticalAlignment="Center"
                                          Focusable="False"
                                          HorizontalScrollBarVisibility="Hidden"
                                          VerticalScrollBarVisibility="Hidden" />
                        </Grid>
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="BoxBorder" Property="Background" Value="#1CFFFFFF" />
                            <Setter TargetName="BoxBorder" Property="BorderBrush" Value="#45FFFFFF" />
                        </Trigger>
                        <Trigger Property="IsKeyboardFocused" Value="True">
                            <Setter TargetName="BoxBorder" Property="Background" Value="#22FFFFFF" />
                            <Setter TargetName="BoxBorder" Property="BorderBrush" Value="#65FFFFFF" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style x:Key="FluentGlassSearchInputStyle" TargetType="TextBox">
        <Setter Property="OverridesDefaultStyle" Value="True" />
        <Setter Property="Height" Value="36" />
        <Setter Property="FontSize" Value="{DynamicResource TypeBodyFontSize}" />
        <Setter Property="FontWeight" Value="{DynamicResource TypeBodyFontWeight}" />
        <Setter Property="Foreground" Value="{DynamicResource TextPrimaryBrush}" />
        <Setter Property="CaretBrush" Value="{DynamicResource TextPrimaryBrush}" />
        <Setter Property="SelectionBrush" Value="#40FFFFFF" />
        <Setter Property="SelectionOpacity" Value="0.6" />
        <Setter Property="FocusVisualStyle" Value="{x:Null}" />
        <Setter Property="SnapsToDevicePixels" Value="True" />
        <Setter Property="UseLayoutRounding" Value="True" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="TextBox">
                    <Border x:Name="BoxBorder"
                            Background="{DynamicResource WidgetDividerBrush}"
                            BorderBrush="#28FFFFFF"
                            BorderThickness="1"
                            CornerRadius="{DynamicResource ControlCornerRadius}">
                        <Grid Margin="10,0,10,0">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <ui:SymbolIcon x:Name="PrefixIcon"
                                           Symbol="Search24"
                                           FontSize="14"
                                           Foreground="{DynamicResource TextMutedBrush}"
                                           VerticalAlignment="Center"
                                           Margin="0,0,8,0" />
                            <ScrollViewer x:Name="PART_ContentHost"
                                          Grid.Column="1"
                                          VerticalAlignment="Center"
                                          Focusable="False"
                                          HorizontalScrollBarVisibility="Hidden"
                                          VerticalScrollBarVisibility="Hidden" />
                        </Grid>
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="BoxBorder" Property="Background" Value="#1CFFFFFF" />
                            <Setter TargetName="BoxBorder" Property="BorderBrush" Value="#45FFFFFF" />
                            <Setter TargetName="PrefixIcon" Property="Foreground" Value="#B0FFFFFF" />
                        </Trigger>
                        <Trigger Property="IsKeyboardFocused" Value="True">
                            <Setter TargetName="BoxBorder" Property="Background" Value="#22FFFFFF" />
                            <Setter TargetName="BoxBorder" Property="BorderBrush" Value="#65FFFFFF" />
                            <Setter TargetName="PrefixIcon" Property="Foreground" Value="{DynamicResource TextPrimaryBrush}" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style x:Key="FluentGlassUrlWithPasteInputStyle" TargetType="TextBox">
        <Setter Property="OverridesDefaultStyle" Value="True" />
        <Setter Property="Height" Value="36" />
        <Setter Property="FontSize" Value="{DynamicResource TypeBodyFontSize}" />
        <Setter Property="FontWeight" Value="{DynamicResource TypeBodyFontWeight}" />
        <Setter Property="Foreground" Value="{DynamicResource TextPrimaryBrush}" />
        <Setter Property="CaretBrush" Value="{DynamicResource TextPrimaryBrush}" />
        <Setter Property="FocusVisualStyle" Value="{x:Null}" />
        <Setter Property="SnapsToDevicePixels" Value="True" />
        <Setter Property="UseLayoutRounding" Value="True" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="TextBox">
                    <Border x:Name="BoxBorder"
                            Background="{DynamicResource WidgetDividerBrush}"
                            BorderBrush="#28FFFFFF"
                            BorderThickness="1"
                            CornerRadius="{DynamicResource ControlCornerRadius}">
                        <Grid Margin="10,0,80,0">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <ui:SymbolIcon x:Name="PrefixIcon"
                                           Symbol="Link24"
                                           FontSize="14"
                                           Foreground="{DynamicResource TextMutedBrush}"
                                           VerticalAlignment="Center"
                                           Margin="0,0,8,0" />
                            <ScrollViewer x:Name="PART_ContentHost"
                                          Grid.Column="1"
                                          VerticalAlignment="Center"
                                          Focusable="False"
                                          HorizontalScrollBarVisibility="Hidden"
                                          VerticalScrollBarVisibility="Hidden" />
                        </Grid>
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="BoxBorder" Property="Background" Value="#1CFFFFFF" />
                            <Setter TargetName="BoxBorder" Property="BorderBrush" Value="#45FFFFFF" />
                            <Setter TargetName="PrefixIcon" Property="Foreground" Value="#B0FFFFFF" />
                        </Trigger>
                        <Trigger Property="IsKeyboardFocused" Value="True">
                            <Setter TargetName="BoxBorder" Property="Background" Value="#22FFFFFF" />
                            <Setter TargetName="BoxBorder" Property="BorderBrush" Value="#65FFFFFF" />
                            <Setter TargetName="PrefixIcon" Property="Foreground" Value="{DynamicResource TextPrimaryBrush}" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style x:Key="FluentGlassRadioButtonStyle" TargetType="RadioButton">
        <Setter Property="OverridesDefaultStyle" Value="True" />
        <Setter Property="FocusVisualStyle" Value="{x:Null}" />
        <Setter Property="Cursor" Value="Hand" />
        <Setter Property="VerticalContentAlignment" Value="Center" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="RadioButton">
                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                        <Grid Width="16" Height="16" Margin="0,0,8,0" VerticalAlignment="Center">
                            <Ellipse x:Name="OuterRing"
                                     Width="16" Height="16"
                                     Stroke="#45FFFFFF"
                                     StrokeThickness="1.2"
                                     Fill="#10FFFFFF"
                                     SnapsToDevicePixels="False"
                                     UseLayoutRounding="False" />
                            <Ellipse x:Name="InnerDot"
                                     Width="8" Height="8"
                                     Fill="{DynamicResource SystemAccentColorPrimaryBrush}"
                                     Opacity="0"
                                     SnapsToDevicePixels="False"
                                     UseLayoutRounding="False"
                                     HorizontalAlignment="Center"
                                     VerticalAlignment="Center" />
                        </Grid>
                        <ContentPresenter VerticalAlignment="{TemplateBinding VerticalContentAlignment}" />
                    </StackPanel>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="OuterRing" Property="Stroke" Value="#80FFFFFF" />
                            <Setter TargetName="OuterRing" Property="Fill" Value="#1CFFFFFF" />
                        </Trigger>
                        <Trigger Property="IsChecked" Value="True">
                            <Setter TargetName="OuterRing" Property="Stroke" Value="{DynamicResource SystemAccentColorPrimaryBrush}" />
                            <Setter TargetName="OuterRing" Property="Fill" Value="Transparent" />
                            <Setter TargetName="InnerDot" Property="Opacity" Value="1.0" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>


    <!-- ========================================================================= -->
    <!-- DIRECTWRITE TYPOGRAPHY & ICON DEFAULTS                                    -->
    <!-- ========================================================================= -->
    <Style TargetType="{x:Type TextBlock}">
        <Setter Property="TextOptions.TextFormattingMode" Value="Ideal" />
        <Setter Property="TextOptions.TextRenderingMode" Value="ClearType" />
        <Setter Property="TextOptions.TextHintingMode" Value="Fixed" />
        <Setter Property="SnapsToDevicePixels" Value="True" />
        <Setter Property="UseLayoutRounding" Value="True" />
    </Style>

    <Style TargetType="{x:Type Control}">
        <Setter Property="TextOptions.TextFormattingMode" Value="Ideal" />
        <Setter Property="TextOptions.TextRenderingMode" Value="ClearType" />
        <Setter Property="TextOptions.TextHintingMode" Value="Fixed" />
    </Style>

    <!-- Global Crisp DirectWrite Vector Styling for all current and future WPF-UI Icons -->
    <Style TargetType="{x:Type ui:SymbolIcon}">
        <Setter Property="SnapsToDevicePixels" Value="True" />
        <Setter Property="UseLayoutRounding" Value="True" />
        <Setter Property="Focusable" Value="False" />
        <Setter Property="TextOptions.TextFormattingMode" Value="Ideal" />
        <Setter Property="TextOptions.TextRenderingMode" Value="ClearType" />
        <Setter Property="TextOptions.TextHintingMode" Value="Fixed" />
    </Style>

    <!-- ========================================================================= -->
    <!-- METRO DIALOG WINDOW BASE STYLE & TEMPLATE                                -->
    <!-- Encapsulates the 155px frosted acrylic sidebar and dark form panel        -->
    <!-- ========================================================================= -->
    <Style TargetType="{x:Type dialogs:MetroDialog}" x:Key="{x:Type dialogs:MetroDialog}">
        <Setter Property="WindowBackdropType" Value="Acrylic" />
        <Setter Property="WindowCornerPreference" Value="DoNotRound" />
        <Setter Property="ExtendsContentIntoTitleBar" Value="True" />
        <Setter Property="WindowStyle" Value="None" />
        <Setter Property="ResizeMode" Value="NoResize" />
        <Setter Property="ShowInTaskbar" Value="False" />
        <Setter Property="Width" Value="620" />
        <Setter Property="Height" Value="360" />
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="Foreground" Value="{DynamicResource TextPrimaryBrush}" />
        <Setter Property="FontFamily" Value="{DynamicResource AppFontFamily}" />
        <Setter Property="RenderOptions.ClearTypeHint" Value="Enabled" />
        <Setter Property="TextOptions.TextFormattingMode" Value="Ideal" />
        <Setter Property="TextOptions.TextRenderingMode" Value="ClearType" />
        <Setter Property="TextOptions.TextHintingMode" Value="Auto" />
        <Setter Property="SnapsToDevicePixels" Value="True" />
        <Setter Property="UseLayoutRounding" Value="True" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="{x:Type dialogs:MetroDialog}">
                    <Border Background="Transparent"
                            BorderThickness="0"
                            CornerRadius="{DynamicResource ControlCornerRadius}">
                        <Grid RenderOptions.ClearTypeHint="Enabled">
                            <Grid.ColumnDefinitions>
                                <!-- COLUMN 0: FROSTED ACRYLIC SIDEBAR -->
                                <ColumnDefinition Width="155" />
                                <!-- COLUMN 1: OBSIDIAN DARK CONTENT PANEL -->
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>

                            <!-- COLUMN 0: ACRYLIC SIDEBAR -->
                            <Grid Grid.Column="0" Background="Transparent">
                                <Image Source="{TemplateBinding SidebarIcon}"
                                       Width="72" Height="72"
                                       Stretch="Uniform"
                                       HorizontalAlignment="Center"
                                       VerticalAlignment="Center"
                                       RenderOptions.BitmapScalingMode="HighQuality"
                                       Visibility="{TemplateBinding SidebarIconVisibility}" />
                                <ContentPresenter Content="{TemplateBinding SidebarContent}"
                                                  HorizontalAlignment="Center"
                                                  VerticalAlignment="Center" />
                            </Grid>

                            <!-- COLUMN 1: OBSIDIAN DARK CONTENT PANEL -->
                            <Border Grid.Column="1"
                                    Background="{DynamicResource DialogPanelBackground}"
                                    CornerRadius="0,2,2,0"
                                    RenderOptions.ClearTypeHint="Enabled">
                                <Grid Margin="24,20,24,20">
                                    <Grid.RowDefinitions>
                                        <!-- Row 0: Header (Title + Dismiss [X]) -->
                                        <RowDefinition Height="Auto" />
                                        <!-- Row 1: Dialog Content Body -->
                                        <RowDefinition Height="*" />
                                    </Grid.RowDefinitions>

                                    <!-- Header -->
                                    <Grid Grid.Row="0" Margin="0,0,0,16">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="Auto" />
                                        </Grid.ColumnDefinitions>

                                        <StackPanel VerticalAlignment="Center">
                                            <TextBlock Text="{TemplateBinding Title}"
                                                       FontSize="{DynamicResource TypeHeaderFontSize}"
                                                       FontWeight="{DynamicResource TypeHeaderFontWeight}"
                                                       Foreground="{DynamicResource TextPrimaryBrush}"
                                                       TextTrimming="CharacterEllipsis" />
                                            <TextBlock Text="{TemplateBinding Subtitle}"
                                                       FontSize="{DynamicResource TypeCaptionFontSize}"
                                                       FontWeight="{DynamicResource TypeCaptionFontWeight}"
                                                       Foreground="{DynamicResource TextSecondaryBrush}"
                                                       Margin="0,3,0,0"
                                                       TextTrimming="CharacterEllipsis"
                                                       Visibility="{TemplateBinding SubtitleVisibility}" />
                                        </StackPanel>

                                        <!-- Top-Right Close Button -->
                                        <Button x:Name="PART_CloseButton"
                                                Grid.Column="1"
                                                Style="{DynamicResource ModalDismissButtonStyle}"
                                                VerticalAlignment="Top"
                                                ToolTip="Close (Esc)" />
                                    </Grid>

                                    <!-- Body Content Slot -->
                                    <ContentPresenter Grid.Row="1" />
                                </Grid>
                            </Border>
                        </Grid>
                    </Border>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

</ResourceDictionary>
