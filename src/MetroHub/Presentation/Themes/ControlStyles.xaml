<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
                    xmlns:controls="clr-namespace:MetroHub.Presentation.Controls">

    <!-- ========================================================================= -->
    <!-- 1. UNIVERSAL FLUENT BUTTONS (WinUI 3 / Fluent Standard)                   -->
    <!-- Standardized semantic keys:                                               -->
    <!-- - DefaultButtonStyle: Standard frosted neutral button                     -->
    <!-- - AccentButtonStyle: Solid Windows accent button (Primary action)         -->
    <!-- - SubtleButtonStyle: Borderless transparent icon / ghost button           -->
    <!-- ========================================================================= -->

    <!-- Default / Secondary Neutral Button (Frosted Glass DNA) -->
    <Style x:Key="DefaultButtonStyle" TargetType="Button">
        <Setter Property="Height" Value="32" />
        <Setter Property="MinWidth" Value="85" />
        <Setter Property="Padding" Value="14,0" />
        <Setter Property="Background" Value="#1CFFFFFF" />
        <Setter Property="BorderBrush" Value="#20FFFFFF" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="Foreground" Value="#F5FFFFFF" />
        <Setter Property="FontFamily" Value="{DynamicResource AppFontFamily}" />
        <Setter Property="FontSize" Value="{DynamicResource TypeBodyStrongFontSize}" />
        <Setter Property="FontWeight" Value="{DynamicResource TypeBodyStrongFontWeight}" />
        <Setter Property="FocusVisualStyle" Value="{x:Null}" />
        <Setter Property="Cursor" Value="Hand" />
        <Setter Property="HorizontalContentAlignment" Value="Center" />
        <Setter Property="VerticalContentAlignment" Value="Center" />
        <Setter Property="SnapsToDevicePixels" Value="True" />
        <Setter Property="UseLayoutRounding" Value="True" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Button">
                    <Border x:Name="ButtonBorder"
                            Background="{TemplateBinding Background}"
                            BorderBrush="{TemplateBinding BorderBrush}"
                            BorderThickness="{TemplateBinding BorderThickness}"
                            CornerRadius="{DynamicResource ControlCornerRadius}">
                        <ContentPresenter HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}"
                                          VerticalAlignment="{TemplateBinding VerticalContentAlignment}"
                                          Margin="{TemplateBinding Padding}" />
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="ButtonBorder" Property="Background" Value="#28FFFFFF" />
                            <Setter TargetName="ButtonBorder" Property="BorderBrush" Value="#38FFFFFF" />
                            <Setter Property="Foreground" Value="{DynamicResource TextPrimaryBrush}" />
                        </Trigger>
                        <Trigger Property="IsPressed" Value="True">
                            <Setter TargetName="ButtonBorder" Property="Background" Value="{DynamicResource FluentPressedBrush}" />
                            <Setter TargetName="ButtonBorder" Property="BorderBrush" Value="#25FFFFFF" />
                            <Setter Property="Foreground" Value="{DynamicResource TextPrimaryBrush}" />
                        </Trigger>
                        <Trigger Property="IsEnabled" Value="False">
                            <Setter TargetName="ButtonBorder" Property="Opacity" Value="0.35" />
                            <Setter Property="Cursor" Value="Arrow" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>


    <!-- Subtle / Ghost Button (Borderless icon, toolbar, chevron buttons) -->
    <Style x:Key="SubtleButtonStyle" TargetType="Button">
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="BorderBrush" Value="Transparent" />
        <Setter Property="BorderThickness" Value="0" />
        <Setter Property="Foreground" Value="#95FFFFFF" />
        <Setter Property="FocusVisualStyle" Value="{x:Null}" />
        <Setter Property="HorizontalContentAlignment" Value="Center" />
        <Setter Property="VerticalContentAlignment" Value="Center" />
        <Setter Property="SnapsToDevicePixels" Value="True" />
        <Setter Property="UseLayoutRounding" Value="True" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Button">
                    <Border x:Name="PillBorder"
                            Background="{TemplateBinding Background}"
                            BorderBrush="{TemplateBinding BorderBrush}"
                            BorderThickness="{TemplateBinding BorderThickness}"
                            CornerRadius="{DynamicResource ControlCornerRadius}">
                        <ContentPresenter HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}"
                                          VerticalAlignment="{TemplateBinding VerticalContentAlignment}"
                                          Margin="{TemplateBinding Padding}" />
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="PillBorder" Property="Background" Value="{DynamicResource FluentHoverBrush}" />
                            <Setter Property="Foreground" Value="{DynamicResource TextPrimaryBrush}" />
                        </Trigger>
                        <Trigger Property="IsPressed" Value="True">
                            <Setter TargetName="PillBorder" Property="Background" Value="{DynamicResource FluentPressedBrush}" />
                            <Setter Property="Foreground" Value="{DynamicResource TextPrimaryBrush}" />
                        </Trigger>
                        <Trigger Property="IsEnabled" Value="False">
                            <Setter TargetName="PillBorder" Property="Opacity" Value="0.35" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>


    <!-- Implicit Default Button Style: Bare <Button> elements default to SubtleButtonStyle -->
    <Style TargetType="Button" BasedOn="{StaticResource SubtleButtonStyle}" />

    <!-- Primary Accent Button (Solid dynamic Windows Accent fill) -->
    <Style x:Key="AccentButtonStyle" TargetType="Button">
        <Setter Property="OverridesDefaultStyle" Value="True" />
        <Setter Property="Height" Value="32" />
        <Setter Property="MinWidth" Value="100" />
        <Setter Property="Padding" Value="16,0" />
        <Setter Property="FontSize" Value="{DynamicResource TypeBodyStrongFontSize}" />
        <Setter Property="FontWeight" Value="{DynamicResource TypeBodyStrongFontWeight}" />
        <Setter Property="Foreground" Value="{DynamicResource SystemAccentColorForegroundBrush}" />
        <Setter Property="FocusVisualStyle" Value="{x:Null}" />
        <Setter Property="Cursor" Value="Hand" />
        <Setter Property="SnapsToDevicePixels" Value="True" />
        <Setter Property="UseLayoutRounding" Value="True" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Button">
                    <Border x:Name="BtnBorder"
                            Background="{DynamicResource SystemAccentColorPrimaryBrush}"
                            BorderBrush="{DynamicResource SystemAccentColorPrimaryBrush}"
                            BorderThickness="1"
                            CornerRadius="{DynamicResource ControlCornerRadius}">
                        <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" Margin="{TemplateBinding Padding}" />
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="BtnBorder" Property="Background" Value="{DynamicResource SystemAccentColorSecondaryBrush}" />
                            <Setter TargetName="BtnBorder" Property="BorderBrush" Value="{DynamicResource SystemAccentColorSecondaryBrush}" />
                        </Trigger>
                        <Trigger Property="IsPressed" Value="True">
                            <Setter TargetName="BtnBorder" Property="Background" Value="{DynamicResource SystemAccentColorTertiaryBrush}" />
                            <Setter TargetName="BtnBorder" Property="BorderBrush" Value="{DynamicResource SystemAccentColorTertiaryBrush}" />
                        </Trigger>
                        <Trigger Property="IsEnabled" Value="False">
                            <Setter TargetName="BtnBorder" Property="Opacity" Value="0.35" />
                            <Setter Property="Cursor" Value="Arrow" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>


    <!-- Universal Modal Window Close / Dismiss Button (32x32 vector "X") -->
    <Style x:Key="ModalDismissButtonStyle" TargetType="Button">
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="BorderThickness" Value="0" />
        <Setter Property="Width" Value="32" />
        <Setter Property="Height" Value="32" />
        <Setter Property="FocusVisualStyle" Value="{x:Null}" />
        <Setter Property="Cursor" Value="Hand" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Button">
                    <Border x:Name="Border" Background="{TemplateBinding Background}" CornerRadius="{DynamicResource ControlCornerRadius}">
                        <Path x:Name="Icon"
                              Width="10" Height="10"
                              Data="M 0.5,0.5 L 9.5,9.5 M 0.5,9.5 L 9.5,0.5"
                              Stroke="#85FFFFFF"
                              StrokeThickness="1.2"
                              StrokeStartLineCap="Round"
                              StrokeEndLineCap="Round"
                              SnapsToDevicePixels="False"
                              UseLayoutRounding="False"
                              HorizontalAlignment="Center"
                              VerticalAlignment="Center" />
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="Border" Property="Background" Value="#25FFFFFF" />
                            <Setter TargetName="Icon" Property="Stroke" Value="{DynamicResource TextPrimaryBrush}" />
                        </Trigger>
                        <Trigger Property="IsPressed" Value="True">
                            <Setter TargetName="Border" Property="Background" Value="#35FFFFFF" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- ========================================================================= -->
    <!-- 2. UNIVERSAL FLUENT TOGGLESWITCH                                          -->
    <!-- Brush overrides and styles for WPF-UI's ToggleSwitch control.             -->
    <!-- Dynamically synchronized to the active Windows accent color via            -->
    <!-- SystemAccentColorService.                                                 -->
    <!-- ========================================================================= -->

    <!-- ON state: Active track (System Accent) with Solid Black knob -->
    <SolidColorBrush x:Key="ToggleSwitchFillOn" Color="{StaticResource SystemAccentColor}" />
    <SolidColorBrush x:Key="ToggleSwitchFillOnPointerOver" Color="{StaticResource SystemAccentColor}" />
    <SolidColorBrush x:Key="ToggleSwitchFillOnPressed" Color="{StaticResource SystemAccentColor}" />
    <SolidColorBrush x:Key="ToggleSwitchFillOnDisabled" Color="{StaticResource SystemAccentColor}" Opacity="0.5" />
    <SolidColorBrush x:Key="ToggleSwitchStrokeOn" Color="{StaticResource SystemAccentColor}" />
    <SolidColorBrush x:Key="ToggleSwitchStrokeOnPointerOver" Color="{StaticResource SystemAccentColor}" />
    <SolidColorBrush x:Key="ToggleSwitchStrokeOnPressed" Color="{StaticResource SystemAccentColor}" />
    <SolidColorBrush x:Key="ToggleSwitchKnobFillOn" Color="#000000" />
    <SolidColorBrush x:Key="ToggleSwitchKnobFillOnPointerOver" Color="#1A1A1A" />
    <SolidColorBrush x:Key="ToggleSwitchKnobFillOnPressed" Color="#000000" />
    <SolidColorBrush x:Key="ToggleSwitchKnobFillOnDisabled" Color="#000000" />

    <!-- OFF state: Transparent track, subtle fluent outline, silver knob -->
    <SolidColorBrush x:Key="ToggleSwitchFillOff" Color="Transparent" />
    <SolidColorBrush x:Key="ToggleSwitchFillOffPointerOver" Color="#0DFFFFFF" />
    <SolidColorBrush x:Key="ToggleSwitchFillOffPressed" Color="#18FFFFFF" />
    <SolidColorBrush x:Key="ToggleSwitchFillOffDisabled" Color="Transparent" />
    <SolidColorBrush x:Key="ToggleSwitchStrokeOff" Color="{StaticResource TextSubtleColor}" />
    <SolidColorBrush x:Key="ToggleSwitchStrokeOffPointerOver" Color="#90FFFFFF" />
    <SolidColorBrush x:Key="ToggleSwitchStrokeOffPressed" Color="#55FFFFFF" />
    <SolidColorBrush x:Key="ToggleSwitchStrokeOffDisabled" Color="#35FFFFFF" />
    <SolidColorBrush x:Key="ToggleSwitchKnobFillOff" Color="#CECECE" />
    <SolidColorBrush x:Key="ToggleSwitchKnobFillOffPointerOver" Color="{StaticResource TextPrimaryColor}" />
    <SolidColorBrush x:Key="ToggleSwitchKnobFillOffPressed" Color="#B0B0B0" />
    <SolidColorBrush x:Key="ToggleSwitchKnobFillOffDisabled" Color="#60FFFFFF" />

    <!-- Canonical system-accent ToggleSwitch style -->
    <Style x:Key="FluentAccentToggleSwitchStyle" TargetType="{x:Type ui:ToggleSwitch}" BasedOn="{StaticResource DefaultUiToggleSwitchStyle}">
        <Setter Property="VerticalAlignment" Value="Center" />
        <Setter Property="FocusVisualStyle" Value="{x:Null}" />
        <Style.Resources>
            <SolidColorBrush x:Key="SystemAccentColorBrush" Color="{StaticResource SystemAccentColor}" />
            <SolidColorBrush x:Key="SystemAccentColorSecondaryBrush" Color="{StaticResource SystemAccentColor}" />
            <SolidColorBrush x:Key="SystemAccentColorTertiaryBrush" Color="{StaticResource SystemAccentColor}" />
        </Style.Resources>
    </Style>


    <!-- Implicit default: every ui:ToggleSwitch automatically receives dynamic System Accent styling -->
    <Style TargetType="{x:Type ui:ToggleSwitch}" BasedOn="{StaticResource FluentAccentToggleSwitchStyle}" />

    <!-- Named style: Amber ToggleSwitch (Caffeine, Night Light, Awake) -->
    <Style x:Key="FluentAmberToggleSwitchStyle" TargetType="{x:Type ui:ToggleSwitch}" BasedOn="{StaticResource DefaultUiToggleSwitchStyle}">
        <Setter Property="VerticalAlignment" Value="Center" />
        <Setter Property="FocusVisualStyle" Value="{x:Null}" />
        <Style.Resources>
            <SolidColorBrush x:Key="ToggleSwitchFillOn" Color="{StaticResource StatusWarningColor}" />
            <SolidColorBrush x:Key="ToggleSwitchFillOnPointerOver" Color="{StaticResource StatusWarningHoverColor}" />
            <SolidColorBrush x:Key="ToggleSwitchFillOnPressed" Color="{StaticResource StatusWarningPressedColor}" />
            <SolidColorBrush x:Key="ToggleSwitchFillOnDisabled" Color="{StaticResource StatusWarningColor}" Opacity="0.5" />
            <SolidColorBrush x:Key="ToggleSwitchStrokeOn" Color="{StaticResource StatusWarningColor}" />
            <SolidColorBrush x:Key="ToggleSwitchStrokeOnPointerOver" Color="{StaticResource StatusWarningHoverColor}" />
            <SolidColorBrush x:Key="ToggleSwitchStrokeOnPressed" Color="{StaticResource StatusWarningPressedColor}" />

            <SolidColorBrush x:Key="SystemAccentColorBrush" Color="{StaticResource StatusWarningColor}" />
            <SolidColorBrush x:Key="SystemAccentColorSecondaryBrush" Color="{StaticResource StatusWarningColor}" />
            <SolidColorBrush x:Key="SystemAccentColorTertiaryBrush" Color="{StaticResource StatusWarningPressedColor}" />
        </Style.Resources>
    </Style>

    <!-- Named style: Danger / DND Red ToggleSwitch -->
    <Style x:Key="FluentRedToggleSwitchStyle" TargetType="{x:Type ui:ToggleSwitch}" BasedOn="{StaticResource DefaultUiToggleSwitchStyle}">
        <Setter Property="VerticalAlignment" Value="Center" />
        <Setter Property="FocusVisualStyle" Value="{x:Null}" />
        <Style.Resources>
            <SolidColorBrush x:Key="ToggleSwitchFillOn" Color="{StaticResource StatusDangerColor}" />
            <SolidColorBrush x:Key="ToggleSwitchFillOnPointerOver" Color="{StaticResource StatusDangerHoverColor}" />
            <SolidColorBrush x:Key="ToggleSwitchFillOnPressed" Color="{StaticResource StatusDangerPressedColor}" />
            <SolidColorBrush x:Key="ToggleSwitchFillOnDisabled" Color="{StaticResource StatusDangerColor}" Opacity="0.5" />
            <SolidColorBrush x:Key="ToggleSwitchStrokeOn" Color="{StaticResource StatusDangerColor}" />
            <SolidColorBrush x:Key="ToggleSwitchStrokeOnPointerOver" Color="{StaticResource StatusDangerHoverColor}" />
            <SolidColorBrush x:Key="ToggleSwitchStrokeOnPressed" Color="{StaticResource StatusDangerPressedColor}" />

            <SolidColorBrush x:Key="SystemAccentColorBrush" Color="{StaticResource StatusDangerColor}" />
            <SolidColorBrush x:Key="SystemAccentColorSecondaryBrush" Color="{StaticResource StatusDangerColor}" />
            <SolidColorBrush x:Key="SystemAccentColorTertiaryBrush" Color="{StaticResource StatusDangerPressedColor}" />
        </Style.Resources>
    </Style>

    <!-- ========================================================================= -->
    <!-- UNIVERSAL FLUENT GLASS INPUT STYLES (Dialogs, Flyouts & Forms)             -->
    <!-- ========================================================================= -->
    <Style x:Key="FluentGlassInputStyle" TargetType="TextBox">
        <Setter Property="OverridesDefaultStyle" Value="True" />
        <Setter Property="Height" Value="36" />
        <Setter Property="FontSize" Value="{DynamicResource TypeBodyFontSize}" />
        <Setter Property="FontWeight" Value="{DynamicResource TypeBodyFontWeight}" />
        <Setter Property="Foreground" Value="{DynamicResource TextPrimaryBrush}" />
        <Setter Property="CaretBrush" Value="{DynamicResource TextPrimaryBrush}" />
        <Setter Property="FocusVisualStyle" Value="{x:Null}" />
        <Setter Property="SnapsToDevicePixels" Value="True" />
        <Setter Property="UseLayoutRounding" Value="True" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="TextBox">
                    <Border x:Name="BoxBorder"
                            Background="{DynamicResource WidgetDividerBrush}"
                            BorderBrush="#28FFFFFF"
                            BorderThickness="1"
                            CornerRadius="{DynamicResource ControlCornerRadius}">
                        <Grid Margin="10,0,10,0">
                            <ScrollViewer x:Name="PART_ContentHost"
                                          VerticalAlignment="Center"
                                          Focusable="False"
                                          HorizontalScrollBarVisibility="Hidden"
                                          VerticalScrollBarVisibility="Hidden" />
                        </Grid>
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="BoxBorder" Property="Background" Value="#1CFFFFFF" />
                            <Setter TargetName="BoxBorder" Property="BorderBrush" Value="#45FFFFFF" />
                        </Trigger>
                        <Trigger Property="IsKeyboardFocused" Value="True">
                            <Setter TargetName="BoxBorder" Property="Background" Value="#22FFFFFF" />
                            <Setter TargetName="BoxBorder" Property="BorderBrush" Value="#65FFFFFF" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style x:Key="FluentGlassSearchInputStyle" TargetType="TextBox">
        <Setter Property="OverridesDefaultStyle" Value="True" />
        <Setter Property="Height" Value="36" />
        <Setter Property="FontSize" Value="{DynamicResource TypeBodyFontSize}" />
        <Setter Property="FontWeight" Value="{DynamicResource TypeBodyFontWeight}" />
        <Setter Property="Foreground" Value="{DynamicResource TextPrimaryBrush}" />
        <Setter Property="CaretBrush" Value="{DynamicResource TextPrimaryBrush}" />
        <Setter Property="SelectionBrush" Value="#40FFFFFF" />
        <Setter Property="SelectionOpacity" Value="0.6" />
        <Setter Property="FocusVisualStyle" Value="{x:Null}" />
        <Setter Property="SnapsToDevicePixels" Value="True" />
        <Setter Property="UseLayoutRounding" Value="True" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="TextBox">
                    <Border x:Name="BoxBorder"
                            Background="{DynamicResource WidgetDividerBrush}"
                            BorderBrush="#28FFFFFF"
                            BorderThickness="1"
                            CornerRadius="{DynamicResource ControlCornerRadius}">
                        <Grid Margin="10,0,10,0">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <ui:SymbolIcon x:Name="PrefixIcon"
                                           Symbol="Search24"
                                           FontSize="14"
                                           Foreground="{DynamicResource TextMutedBrush}"
                                           VerticalAlignment="Center"
                                           Margin="0,0,8,0" />
                            <ScrollViewer x:Name="PART_ContentHost"
                                          Grid.Column="1"
                                          VerticalAlignment="Center"
                                          Focusable="False"
                                          HorizontalScrollBarVisibility="Hidden"
                                          VerticalScrollBarVisibility="Hidden" />
                        </Grid>
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="BoxBorder" Property="Background" Value="#1CFFFFFF" />
                            <Setter TargetName="BoxBorder" Property="BorderBrush" Value="#45FFFFFF" />
                            <Setter TargetName="PrefixIcon" Property="Foreground" Value="#B0FFFFFF" />
                        </Trigger>
                        <Trigger Property="IsKeyboardFocused" Value="True">
                            <Setter TargetName="BoxBorder" Property="Background" Value="#22FFFFFF" />
                            <Setter TargetName="BoxBorder" Property="BorderBrush" Value="#65FFFFFF" />
                            <Setter TargetName="PrefixIcon" Property="Foreground" Value="{DynamicResource TextPrimaryBrush}" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style x:Key="FluentGlassUrlWithPasteInputStyle" TargetType="TextBox">
        <Setter Property="OverridesDefaultStyle" Value="True" />
        <Setter Property="Height" Value="36" />
        <Setter Property="FontSize" Value="{DynamicResource TypeBodyFontSize}" />
        <Setter Property="FontWeight" Value="{DynamicResource TypeBodyFontWeight}" />
        <Setter Property="Foreground" Value="{DynamicResource TextPrimaryBrush}" />
        <Setter Property="CaretBrush" Value="{DynamicResource TextPrimaryBrush}" />
        <Setter Property="FocusVisualStyle" Value="{x:Null}" />
        <Setter Property="SnapsToDevicePixels" Value="True" />
        <Setter Property="UseLayoutRounding" Value="True" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="TextBox">
                    <Border x:Name="BoxBorder"
                            Background="{DynamicResource WidgetDividerBrush}"
                            BorderBrush="#28FFFFFF"
                            BorderThickness="1"
                            CornerRadius="{DynamicResource ControlCornerRadius}">
                        <Grid Margin="10,0,80,0">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <ui:SymbolIcon x:Name="PrefixIcon"
                                           Symbol="Link24"
                                           FontSize="14"
                                           Foreground="{DynamicResource TextMutedBrush}"
                                           VerticalAlignment="Center"
                                           Margin="0,0,8,0" />
                            <ScrollViewer x:Name="PART_ContentHost"
                                          Grid.Column="1"
                                          VerticalAlignment="Center"
                                          Focusable="False"
                                          HorizontalScrollBarVisibility="Hidden"
                                          VerticalScrollBarVisibility="Hidden" />
                        </Grid>
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="BoxBorder" Property="Background" Value="#1CFFFFFF" />
                            <Setter TargetName="BoxBorder" Property="BorderBrush" Value="#45FFFFFF" />
                            <Setter TargetName="PrefixIcon" Property="Foreground" Value="#B0FFFFFF" />
                        </Trigger>
                        <Trigger Property="IsKeyboardFocused" Value="True">
                            <Setter TargetName="BoxBorder" Property="Background" Value="#22FFFFFF" />
                            <Setter TargetName="BoxBorder" Property="BorderBrush" Value="#65FFFFFF" />
                            <Setter TargetName="PrefixIcon" Property="Foreground" Value="{DynamicResource TextPrimaryBrush}" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style x:Key="FluentGlassRadioButtonStyle" TargetType="RadioButton">
        <Setter Property="OverridesDefaultStyle" Value="True" />
        <Setter Property="FocusVisualStyle" Value="{x:Null}" />
        <Setter Property="Cursor" Value="Hand" />
        <Setter Property="VerticalContentAlignment" Value="Center" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="RadioButton">
                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                        <Grid Width="16" Height="16" Margin="0,0,8,0" VerticalAlignment="Center">
                            <Ellipse x:Name="OuterRing"
                                     Width="16" Height="16"
                                     Stroke="#45FFFFFF"
                                     StrokeThickness="1.2"
                                     Fill="#10FFFFFF"
                                     SnapsToDevicePixels="False"
                                     UseLayoutRounding="False" />
                            <Ellipse x:Name="InnerDot"
                                     Width="8" Height="8"
                                     Fill="{DynamicResource SystemAccentColorPrimaryBrush}"
                                     Opacity="0"
                                     SnapsToDevicePixels="False"
                                     UseLayoutRounding="False"
                                     HorizontalAlignment="Center"
                                     VerticalAlignment="Center" />
                        </Grid>
                        <ContentPresenter VerticalAlignment="{TemplateBinding VerticalContentAlignment}" />
                    </StackPanel>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="OuterRing" Property="Stroke" Value="#80FFFFFF" />
                            <Setter TargetName="OuterRing" Property="Fill" Value="#1CFFFFFF" />
                        </Trigger>
                        <Trigger Property="IsChecked" Value="True">
                            <Setter TargetName="OuterRing" Property="Stroke" Value="{DynamicResource SystemAccentColorPrimaryBrush}" />
                            <Setter TargetName="OuterRing" Property="Fill" Value="Transparent" />
                            <Setter TargetName="InnerDot" Property="Opacity" Value="1.0" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>


    <!-- ========================================================================= -->
    <!-- 4. UNIVERSAL FLUENT FLOATING SCROLLBAR SYSTEM                             -->
    <!-- 4px ultra-slim floating scrollbar with auto-hiding and expand-on-hover    -->
    <!-- ========================================================================= -->

    <!-- 4px Ultra-Slim Floating ScrollBar (Vertical & Horizontal support) with Smooth Expand-on-Hover -->
    <Style x:Key="WidgetFloatingScrollBarStyle" TargetType="{x:Type ScrollBar}">
        <Setter Property="OverridesDefaultStyle" Value="True" />
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="BorderThickness" Value="0" />
        <Setter Property="Width" Value="10" />
        <Setter Property="MinWidth" Value="10" />
        <Setter Property="Opacity" Value="0.0" />
        <Setter Property="SnapsToDevicePixels" Value="True" />
        <Setter Property="FocusVisualStyle" Value="{x:Null}" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="{x:Type ScrollBar}">
                    <Grid Background="Transparent">
                        <Track x:Name="PART_Track" IsDirectionReversed="True" Focusable="False">
                            <Track.Thumb>
                                <Thumb x:Name="Thumb" Focusable="False">
                                    <Thumb.Template>
                                        <ControlTemplate TargetType="{x:Type Thumb}">
                                            <Grid Background="Transparent">
                                                <Border x:Name="ThumbBorder"
                                                        Width="4"
                                                        HorizontalAlignment="Right"
                                                        Margin="0,2,1,2"
                                                        Background="#45FFFFFF"
                                                        CornerRadius="2"
                                                        />
                                            </Grid>
                                            <ControlTemplate.Triggers>
                                                <Trigger Property="Tag" Value="Expanded">
                                                    <Trigger.EnterActions>
                                                        <BeginStoryboard>
                                                            <Storyboard>
                                                                <DoubleAnimation Storyboard.TargetName="ThumbBorder"
                                                                                 Storyboard.TargetProperty="Width"
                                                                                 To="8"
                                                                                 Duration="{StaticResource FluentDurationFast}">
                                                                    <DoubleAnimation.EasingFunction>
                                                                        <CubicEase EasingMode="EaseOut" />
                                                                    </DoubleAnimation.EasingFunction>
                                                                </DoubleAnimation>
                                                            </Storyboard>
                                                        </BeginStoryboard>
                                                    </Trigger.EnterActions>
                                                    <Trigger.ExitActions>
                                                        <BeginStoryboard>
                                                            <Storyboard>
                                                                <DoubleAnimation Storyboard.TargetName="ThumbBorder"
                                                                                 Storyboard.TargetProperty="Width"
                                                                                 To="4"
                                                                                 Duration="{StaticResource FluentDurationFast}">
                                                                    <DoubleAnimation.EasingFunction>
                                                                        <CubicEase EasingMode="EaseOut" />
                                                                    </DoubleAnimation.EasingFunction>
                                                                </DoubleAnimation>
                                                            </Storyboard>
                                                        </BeginStoryboard>
                                                    </Trigger.ExitActions>
                                                    <Setter TargetName="ThumbBorder" Property="Background" Value="#95FFFFFF" />
                                                    <Setter TargetName="ThumbBorder" Property="CornerRadius" Value="4" />
                                                </Trigger>
                                                <Trigger Property="IsMouseOver" Value="True">
                                                    <Setter TargetName="ThumbBorder" Property="Width" Value="8" />
                                                    <Setter TargetName="ThumbBorder" Property="CornerRadius" Value="4" />
                                                    <Setter TargetName="ThumbBorder" Property="Background" Value="#95FFFFFF" />
                                                </Trigger>
                                                <Trigger Property="IsDragging" Value="True">
                                                    <Setter TargetName="ThumbBorder" Property="Width" Value="8" />
                                                    <Setter TargetName="ThumbBorder" Property="CornerRadius" Value="4" />
                                                    <Setter TargetName="ThumbBorder" Property="Background" Value="#D0FFFFFF" />
                                                </Trigger>
                                            </ControlTemplate.Triggers>
                                        </ControlTemplate>
                                    </Thumb.Template>
                                </Thumb>
                            </Track.Thumb>
                        </Track>
                    </Grid>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="Thumb" Property="Tag" Value="Expanded" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
        <Style.Triggers>
            <Trigger Property="Orientation" Value="Horizontal">
                <Setter Property="Width" Value="Auto" />
                <Setter Property="MinWidth" Value="0" />
                <Setter Property="Height" Value="10" />
                <Setter Property="MinHeight" Value="10" />
                <Setter Property="Template">
                    <Setter.Value>
                        <ControlTemplate TargetType="{x:Type ScrollBar}">
                            <Grid Background="Transparent">
                                <Track x:Name="PART_Track" Focusable="False">
                                    <Track.Thumb>
                                        <Thumb x:Name="Thumb" Focusable="False">
                                            <Thumb.Template>
                                                <ControlTemplate TargetType="{x:Type Thumb}">
                                                    <Grid Background="Transparent">
                                                        <Border x:Name="ThumbBorder"
                                                                Height="4"
                                                                VerticalAlignment="Bottom"
                                                                Margin="2,0,2,1"
                                                                Background="#45FFFFFF"
                                                                CornerRadius="2"
                                                                />
                                                    </Grid>
                                                    <ControlTemplate.Triggers>
                                                        <Trigger Property="Tag" Value="Expanded">
                                                            <Trigger.EnterActions>
                                                                <BeginStoryboard>
                                                                    <Storyboard>
                                                                        <DoubleAnimation Storyboard.TargetName="ThumbBorder"
                                                                                         Storyboard.TargetProperty="Height"
                                                                                         To="8"
                                                                                         Duration="{StaticResource FluentDurationFast}">
                                                                            <DoubleAnimation.EasingFunction>
                                                                                <CubicEase EasingMode="EaseOut" />
                                                                            </DoubleAnimation.EasingFunction>
                                                                        </DoubleAnimation>
                                                                    </Storyboard>
                                                                </BeginStoryboard>
                                                            </Trigger.EnterActions>
                                                            <Trigger.ExitActions>
                                                                <BeginStoryboard>
                                                                    <Storyboard>
                                                                        <DoubleAnimation Storyboard.TargetName="ThumbBorder"
                                                                                         Storyboard.TargetProperty="Height"
                                                                                         To="4"
                                                                                         Duration="{StaticResource FluentDurationFast}">
                                                                            <DoubleAnimation.EasingFunction>
                                                                                <CubicEase EasingMode="EaseOut" />
                                                                            </DoubleAnimation.EasingFunction>
                                                                        </DoubleAnimation>
                                                                    </Storyboard>
                                                                </BeginStoryboard>
                                                            </Trigger.ExitActions>
                                                            <Setter TargetName="ThumbBorder" Property="Background" Value="#95FFFFFF" />
                                                            <Setter TargetName="ThumbBorder" Property="CornerRadius" Value="4" />
                                                        </Trigger>
                                                        <Trigger Property="IsMouseOver" Value="True">
                                                            <Setter TargetName="ThumbBorder" Property="Height" Value="8" />
                                                            <Setter TargetName="ThumbBorder" Property="CornerRadius" Value="4" />
                                                            <Setter TargetName="ThumbBorder" Property="Background" Value="#95FFFFFF" />
                                                        </Trigger>
                                                        <Trigger Property="IsDragging" Value="True">
                                                            <Setter TargetName="ThumbBorder" Property="Height" Value="8" />
                                                            <Setter TargetName="ThumbBorder" Property="CornerRadius" Value="4" />
                                                            <Setter TargetName="ThumbBorder" Property="Background" Value="#D0FFFFFF" />
                                                        </Trigger>
                                                    </ControlTemplate.Triggers>
                                                </ControlTemplate>
                                            </Thumb.Template>
                                        </Thumb>
                                    </Track.Thumb>
                                </Track>
                            </Grid>
                            <ControlTemplate.Triggers>
                                <Trigger Property="IsMouseOver" Value="True">
                                    <Setter TargetName="Thumb" Property="Tag" Value="Expanded" />
                                </Trigger>
                            </ControlTemplate.Triggers>
                        </ControlTemplate>
                    </Setter.Value>
                </Setter>
            </Trigger>
        </Style.Triggers>
    </Style>

    <!-- Canonical alias for FloatingScrollBarStyle -->
    <Style x:Key="FloatingScrollBarStyle" TargetType="{x:Type ScrollBar}" BasedOn="{StaticResource WidgetFloatingScrollBarStyle}" />

    <!-- Shared Floating ScrollViewer Style: Auto-attaches AutoHideScrollBehavior and 4px floating scrollbar -->
    <Style x:Key="WidgetFloatingScrollViewerStyle" TargetType="{x:Type ScrollViewer}">
        <Setter Property="OverridesDefaultStyle" Value="True" />
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="BorderBrush" Value="Transparent" />
        <Setter Property="BorderThickness" Value="0" />
        <Setter Property="HorizontalScrollBarVisibility" Value="Disabled" />
        <Setter Property="VerticalScrollBarVisibility" Value="Auto" />
        <Setter Property="Focusable" Value="False" />
        <Setter Property="FocusVisualStyle" Value="{x:Null}" />
        <Setter Property="controls:AutoHideScrollBehavior.IsEnabled" Value="True" />
        <Setter Property="controls:SmoothScrollBehavior.IsEnabled" Value="True" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="{x:Type ScrollViewer}">
                    <Grid Background="Transparent">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <ScrollContentPresenter x:Name="PART_ScrollContentPresenter"
                                               Grid.Column="0"
                                               Margin="{TemplateBinding Padding}"
                                               CanContentScroll="{TemplateBinding CanContentScroll}" />
                        <ScrollBar Grid.Column="1"
                                   x:Name="PART_VerticalScrollBar"
                                   Style="{StaticResource WidgetFloatingScrollBarStyle}"
                                   Value="{TemplateBinding VerticalOffset}"
                                   Maximum="{TemplateBinding ScrollableHeight}"
                                   ViewportSize="{TemplateBinding ViewportHeight}"
                                   Visibility="{TemplateBinding ComputedVerticalScrollBarVisibility}"
                                   Margin="0,0,0,0" />
                    </Grid>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- Canonical alias for FloatingScrollViewerStyle -->
    <Style x:Key="FloatingScrollViewerStyle" TargetType="{x:Type ScrollViewer}" BasedOn="{StaticResource WidgetFloatingScrollViewerStyle}" />

    <!-- Implicit Default for ScrollBar: Auto-inherits 4px floating scrollbar -->
    <Style TargetType="{x:Type ScrollBar}" BasedOn="{StaticResource WidgetFloatingScrollBarStyle}" />

    <!-- ========================================================================= -->
    <!-- DIRECTWRITE TYPOGRAPHY & ICON DEFAULTS                                    -->
    <!-- ========================================================================= -->
    <Style TargetType="{x:Type TextBlock}">
        <Setter Property="TextOptions.TextFormattingMode" Value="Ideal" />
        <Setter Property="TextOptions.TextRenderingMode" Value="ClearType" />
        <Setter Property="TextOptions.TextHintingMode" Value="Fixed" />
        <Setter Property="SnapsToDevicePixels" Value="True" />
        <Setter Property="UseLayoutRounding" Value="True" />
    </Style>

    <Style TargetType="{x:Type Control}">
        <Setter Property="TextOptions.TextFormattingMode" Value="Ideal" />
        <Setter Property="TextOptions.TextRenderingMode" Value="ClearType" />
        <Setter Property="TextOptions.TextHintingMode" Value="Fixed" />
    </Style>

    <!-- Global Crisp DirectWrite Vector Styling for all current and future WPF-UI Icons -->
    <Style TargetType="{x:Type ui:SymbolIcon}">
        <Setter Property="SnapsToDevicePixels" Value="True" />
        <Setter Property="UseLayoutRounding" Value="True" />
        <Setter Property="Focusable" Value="False" />
        <Setter Property="TextOptions.TextFormattingMode" Value="Ideal" />
        <Setter Property="TextOptions.TextRenderingMode" Value="ClearType" />
        <Setter Property="TextOptions.TextHintingMode" Value="Fixed" />
    </Style>

</ResourceDictionary>
