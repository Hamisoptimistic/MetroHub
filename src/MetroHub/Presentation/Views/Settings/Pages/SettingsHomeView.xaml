<UserControl x:Class="MetroHub.Presentation.Views.Settings.Pages.SettingsHomeView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:po="http://schemas.microsoft.com/winfx/2006/xaml/presentation/options"
             xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
             xmlns:vm="clr-namespace:MetroHub.Presentation.Views.Settings.ViewModels"
             d:DataContext="{d:DesignInstance vm:SettingsHomeViewModel}"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             mc:Ignorable="d"
             Background="Transparent">

    <UserControl.Resources>
        <!-- Tier 2: Elevated Surface Tile for Category Cards -->
        <SolidColorBrush x:Key="CategoryCardBackgroundBrush" Color="#18FFFFFF" po:Freeze="True" />
        <SolidColorBrush x:Key="CategoryCardBorderBrush" Color="#28FFFFFF" po:Freeze="True" />

        <!-- Home Category Card Style -->
        <Style x:Key="HomeCategoryCardStyle" TargetType="ui:CardAction">
            <Setter Property="Background" Value="{StaticResource CategoryCardBackgroundBrush}" />
            <Setter Property="Margin" Value="6" />
            <Setter Property="Padding" Value="20,18" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="BorderBrush" Value="{StaticResource CategoryCardBorderBrush}" />
            <Setter Property="BorderThickness" Value="1" />
        </Style>
    </UserControl.Resources>

    <!-- Master Layout: Row 0 = Tier 1 Hero Header; Row 1 = Tier 2 Obsidian Deck -->
    <Grid>
        <Grid.RowDefinitions>
            <!-- Row 0: Hero Header (Tier 1: MetroDialog Frosted Acrylic) -->
            <RowDefinition Height="Auto" />
            <!-- Row 1: Category Card Grid (Tier 2: MainWindow Acrylic Obsidian) -->
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <!-- ========================================================================= -->
        <!-- ROW 0: HERO HEADER (TIER 1: METRODIALOG FROSTED ACRYLIC)                  -->
        <!-- ========================================================================= -->
        <StackPanel Grid.Row="0" Margin="36,4,36,22">
            <TextBlock Text="Settings"
                       FontSize="28"
                       FontWeight="SemiBold"
                       Foreground="{DynamicResource TextPrimaryBrush}" />
            <TextBlock Text="Configure MetroHub behavior, personalization, and widgets"
                       FontSize="{DynamicResource TypeBodyFontSize}"
                       Foreground="{DynamicResource TextSecondaryBrush}"
                       Margin="0,4,0,0" />
        </StackPanel>

        <!-- ========================================================================= -->
        <!-- ROW 1: CATEGORY CARDS GRID (TIER 2: CALIBRATED OBSIDIAN DECK)             -->
        <!-- ========================================================================= -->
        <Border Grid.Row="1"
                Background="{DynamicResource SettingsTier2ObsidianBrush}"
                BorderBrush="Transparent"
                BorderThickness="0,0.5,0,0">
            <ScrollViewer VerticalScrollBarVisibility="Auto"
                          HorizontalScrollBarVisibility="Disabled">
                <ItemsControl ItemsSource="{Binding Categories}"
                              Margin="30,12,30,24">
                    <ItemsControl.ItemsPanel>
                        <ItemsPanelTemplate>
                            <UniformGrid Columns="2" />
                        </ItemsPanelTemplate>
                    </ItemsControl.ItemsPanel>
                    <ItemsControl.ItemTemplate>
                        <DataTemplate DataType="{x:Type vm:SettingsCategoryItem}">
                            <ui:CardAction Style="{StaticResource HomeCategoryCardStyle}"
                                           Command="{Binding DataContext.SelectCategoryCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                           CommandParameter="{Binding}">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto" />
                                        <ColumnDefinition Width="*" />
                                    </Grid.ColumnDefinitions>
                                    <ui:SymbolIcon Symbol="{Binding Symbol}"
                                                   FontSize="26"
                                                   Foreground="{DynamicResource SystemAccentColorPrimaryBrush}"
                                                   Margin="0,0,16,0"
                                                   VerticalAlignment="Center" />
                                    <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                        <TextBlock Text="{Binding Title}"
                                                   FontSize="15"
                                                   FontWeight="SemiBold"
                                                   Foreground="{DynamicResource TextPrimaryBrush}" />
                                        <TextBlock Text="{Binding Description}"
                                                   FontSize="{DynamicResource TypeCaptionFontSize}"
                                                   Foreground="{DynamicResource TextSecondaryBrush}"
                                                   Margin="0,3,0,0"
                                                   TextWrapping="Wrap" />
                                    </StackPanel>
                                </Grid>
                            </ui:CardAction>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </ScrollViewer>
        </Border>
    </Grid>
</UserControl>
