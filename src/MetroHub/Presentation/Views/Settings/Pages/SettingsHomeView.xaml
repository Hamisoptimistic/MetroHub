<UserControl x:Class="MetroHub.Presentation.Views.Settings.Pages.SettingsHomeView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:po="http://schemas.microsoft.com/winfx/2006/xaml/presentation/options"
             xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
             xmlns:vm="clr-namespace:MetroHub.Presentation.Views.Settings.ViewModels"
             d:DataContext="{d:DesignInstance vm:SettingsHomeViewModel}"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             mc:Ignorable="d"
             Background="Transparent">

    <UserControl.Resources>
        <!-- Fixed Contiguous Fluent Reveal Grid Cell Style (Canonical Material DNA) -->
        <Style x:Key="SettingsCategoryGridCellStyle" TargetType="Button">
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="Margin" Value="6,5" />
            <Setter Property="Height" Value="96" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="FocusVisualStyle" Value="{x:Null}" />
            <Setter Property="HorizontalContentAlignment" Value="Stretch" />
            <Setter Property="VerticalContentAlignment" Value="Stretch" />
            <Setter Property="FontFamily" Value="{DynamicResource AppFontFamily}" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Grid Background="Transparent">
                            <!-- Base Card Plate (100% invisible at rest, soft acrylic plate on hover) -->
                            <Border x:Name="CellBorder"
                                    Background="Transparent"
                                    BorderBrush="Transparent"
                                    BorderThickness="1"
                                    CornerRadius="{DynamicResource TileCornerRadius}"
                                    Padding="20,16">
                                <Grid VerticalAlignment="Center">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto" />
                                        <ColumnDefinition Width="*" />
                                    </Grid.ColumnDefinitions>

                                    <!-- Category Icon (Full Pure White TextPrimaryBrush, Never Muted) -->
                                    <ui:SymbolIcon x:Name="CategoryIcon"
                                                   Symbol="{Binding Symbol}"
                                                   FontSize="{DynamicResource TypeDisplayFontSize}"
                                                   Foreground="{DynamicResource TextPrimaryBrush}"
                                                   Margin="0,0,16,0"
                                                   VerticalAlignment="Center"
                                                   HorizontalAlignment="Center" />

                                    <!-- Category Text Stack (Token-Driven Typography and Colors) -->
                                    <StackPanel x:Name="TextStack"
                                                Grid.Column="1"
                                                VerticalAlignment="Center">
                                        <TextBlock Text="{Binding Title}"
                                                   FontSize="{DynamicResource TypeHeaderFontSize}"
                                                   FontWeight="{DynamicResource TypeHeaderFontWeight}"
                                                   Foreground="{DynamicResource TextPrimaryBrush}"
                                                   TextTrimming="CharacterEllipsis" />
                                        <TextBlock Text="{Binding Description}"
                                                   FontSize="{DynamicResource TypeCaptionFontSize}"
                                                   FontWeight="{DynamicResource TypeCaptionFontWeight}"
                                                   Foreground="{DynamicResource TextSecondaryBrush}"
                                                   Margin="0,3,0,0"
                                                   TextWrapping="Wrap"
                                                   TextTrimming="CharacterEllipsis" />
                                    </StackPanel>
                                </Grid>
                            </Border>

                            <!-- Canvas-Style Radial Fill Highlight (Illuminates card surface under cursor on hover) -->
                            <Border x:Name="PART_RevealFillBorder"
                                    CornerRadius="{DynamicResource TileCornerRadius}"
                                    BorderThickness="1"
                                    BorderBrush="Transparent"
                                    IsHitTestVisible="False"
                                    Opacity="0">
                                <Border.Background>
                                    <RadialGradientBrush x:Name="PART_RevealFillBrush" MappingMode="Absolute" RadiusX="200" RadiusY="160">
                                        <GradientStop Color="#24FFFFFF" Offset="0.0" />
                                        <GradientStop Color="#0AFFFFFF" Offset="0.55" />
                                        <GradientStop Color="#00000000" Offset="1.0" />
                                    </RadialGradientBrush>
                                </Border.Background>
                            </Border>
                        </Grid>

                        <ControlTemplate.Triggers>
                            <!-- Hover State: Reveals subtle dark-glass background plate + soft hairline border -->
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="CellBorder" Property="Background" Value="{DynamicResource FluentHoverBrush}" />
                                <Setter TargetName="CellBorder" Property="BorderBrush" Value="{DynamicResource SurfaceBorderSubtleBrush}" />
                                <Setter TargetName="PART_RevealFillBorder" Property="BorderBrush" Value="{DynamicResource SurfaceBorderBrush}" />
                            </Trigger>

                            <!-- Click / Pressed State: FluentPressedBrush token (#1EFFFFFF) -->
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="CellBorder" Property="Background" Value="{DynamicResource FluentPressedBrush}" />
                                <Setter TargetName="CellBorder" Property="BorderBrush" Value="{DynamicResource ContentDialogBorderBrush}" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </UserControl.Resources>

    <!-- Master Layout: Row 0 = Hero Header; Row 1 = Obsidian Deck -->
    <Grid>
        <Grid.RowDefinitions>
            <!-- Row 0: Clean Header Title (No subtitle) -->
            <RowDefinition Height="Auto" />
            <!-- Row 1: Category Card Grid (3 Columns) -->
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <!-- ========================================================================= -->
        <!-- ROW 0: CLEAN HEADER TITLE (NO SUBTITLE, TOKENIZED TYPOGRAPHY)             -->
        <!-- ========================================================================= -->
        <TextBlock Grid.Row="0"
                   Text="Settings"
                   FontSize="{DynamicResource TypeDisplayFontSize}"
                   FontWeight="{DynamicResource TypeDisplayFontWeight}"
                   Foreground="{DynamicResource TextPrimaryBrush}"
                   Margin="38,16,38,18"
                   VerticalAlignment="Center" />

        <!-- ========================================================================= -->
        <!-- ROW 1: 3-COLUMN FLOATING CATEGORY GRID (TIER 2 OBSIDIAN DECK)             -->
        <!-- ========================================================================= -->
        <Border Grid.Row="1"
                Background="{DynamicResource SettingsTier2ObsidianBrush}"
                BorderBrush="Transparent"
                BorderThickness="0,0.5,0,0">
            <ScrollViewer VerticalScrollBarVisibility="Auto"
                          HorizontalScrollBarVisibility="Disabled">
                <ItemsControl ItemsSource="{Binding Categories}"
                              VerticalAlignment="Top"
                              Margin="32,16,32,24">
                    <ItemsControl.ItemsPanel>
                        <ItemsPanelTemplate>
                            <UniformGrid Columns="3" VerticalAlignment="Top" />
                        </ItemsPanelTemplate>
                    </ItemsControl.ItemsPanel>
                    <ItemsControl.ItemTemplate>
                        <DataTemplate DataType="{x:Type vm:SettingsCategoryItem}">
                            <Button Style="{StaticResource SettingsCategoryGridCellStyle}"
                                    Command="{Binding DataContext.SelectCategoryCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                    CommandParameter="{Binding}"
                                    MouseMove="OnCardMouseMove"
                                    MouseEnter="OnCardMouseEnter"
                                    MouseLeave="OnCardMouseLeave" />
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </ScrollViewer>
        </Border>
    </Grid>
</UserControl>
