<UserControl x:Class="MetroHub.Presentation.Views.Settings.Pages.GeneralPage"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
             xmlns:vm="clr-namespace:MetroHub.Presentation.Views.Settings.ViewModels"
             d:DataContext="{d:DesignInstance vm:GeneralSettingsViewModel}"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             mc:Ignorable="d"
             Background="Transparent">

    <StackPanel>
        <!-- Card 1: Start at Windows Boot -->
        <ui:CardControl>
            <ui:CardControl.Icon>
                <ui:SymbolIcon Symbol="Power24" FontSize="18" />
            </ui:CardControl.Icon>
            <ui:CardControl.Header>
                <StackPanel>
                    <TextBlock Text="Start with Windows"
                               FontSize="{DynamicResource TypeBodyFontSize}"
                               FontWeight="{DynamicResource TypeBodyStrongFontWeight}"
                               Foreground="{DynamicResource TextPrimaryBrush}" />
                    <TextBlock Text="Launch MetroHub automatically when you sign in to Windows"
                               FontSize="{DynamicResource TypeCaptionFontSize}"
                               Foreground="{DynamicResource TextSecondaryBrush}"
                               Margin="0,2,0,0" />
                </StackPanel>
            </ui:CardControl.Header>
            <ui:ToggleSwitch IsChecked="{Binding LaunchAtStartup, Mode=TwoWay}" />
        </ui:CardControl>

        <!-- Card 2: Start Minimized to System Tray -->
        <ui:CardControl>
            <ui:CardControl.Icon>
                <ui:SymbolIcon Symbol="ArrowMinimize24" FontSize="18" />
            </ui:CardControl.Icon>
            <ui:CardControl.Header>
                <StackPanel>
                    <TextBlock Text="Start Minimized"
                               FontSize="{DynamicResource TypeBodyFontSize}"
                               FontWeight="{DynamicResource TypeBodyStrongFontWeight}"
                               Foreground="{DynamicResource TextPrimaryBrush}" />
                    <TextBlock Text="Launch quietly in the background without opening the main window on startup"
                               FontSize="{DynamicResource TypeCaptionFontSize}"
                               Foreground="{DynamicResource TextSecondaryBrush}"
                               Margin="0,2,0,0" />
                </StackPanel>
            </ui:CardControl.Header>
            <ui:ToggleSwitch IsChecked="{Binding StartMinimized, Mode=TwoWay}" />
        </ui:CardControl>

        <!-- Card 3: Close on App Launch -->
        <ui:CardControl>
            <ui:CardControl.Icon>
                <ui:SymbolIcon Symbol="Dismiss24" FontSize="18" />
            </ui:CardControl.Icon>
            <ui:CardControl.Header>
                <StackPanel>
                    <TextBlock Text="Close on App Launch"
                               FontSize="{DynamicResource TypeBodyFontSize}"
                               FontWeight="{DynamicResource TypeBodyStrongFontWeight}"
                               Foreground="{DynamicResource TextPrimaryBrush}" />
                    <TextBlock Text="Hide MetroHub automatically when an application, file, or shortcut is opened"
                               FontSize="{DynamicResource TypeCaptionFontSize}"
                               Foreground="{DynamicResource TextSecondaryBrush}"
                               Margin="0,2,0,0" />
                </StackPanel>
            </ui:CardControl.Header>
            <ui:ToggleSwitch IsChecked="{Binding CloseOnLaunch, Mode=TwoWay}" />
        </ui:CardControl>

        <!-- Card 4: Dismiss on Outside Click -->
        <ui:CardControl>
            <ui:CardControl.Icon>
                <ui:SymbolIcon Symbol="Desktop24" FontSize="18" />
            </ui:CardControl.Icon>
            <ui:CardControl.Header>
                <StackPanel>
                    <TextBlock Text="Dismiss on Outside Click"
                               FontSize="{DynamicResource TypeBodyFontSize}"
                               FontWeight="{DynamicResource TypeBodyStrongFontWeight}"
                               Foreground="{DynamicResource TextPrimaryBrush}" />
                    <TextBlock Text="Hide MetroHub automatically when clicking outside the window or switching apps"
                               FontSize="{DynamicResource TypeCaptionFontSize}"
                               Foreground="{DynamicResource TextSecondaryBrush}"
                               Margin="0,2,0,0" />
                </StackPanel>
            </ui:CardControl.Header>
            <ui:ToggleSwitch IsChecked="{Binding DismissOnDeactivate, Mode=TwoWay}" />
        </ui:CardControl>
    </StackPanel>
</UserControl>

