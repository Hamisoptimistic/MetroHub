<UserControl x:Class="MetroHub.Presentation.Views.Settings.Pages.GeneralPage"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
             xmlns:vm="clr-namespace:MetroHub.Presentation.Views.Settings.ViewModels"
             d:DataContext="{d:DesignInstance vm:GeneralSettingsViewModel}"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             mc:Ignorable="d"
             Background="Transparent">

    <StackPanel>
        <!-- Card 1: Start at Windows Boot -->
        <ui:CardControl>
            <ui:CardControl.Icon>
                <ui:SymbolIcon Symbol="Power24" FontSize="18" />
            </ui:CardControl.Icon>
            <ui:CardControl.Header>
                <StackPanel>
                    <TextBlock Text="Start with Windows"
                               FontSize="{DynamicResource TypeBodyFontSize}"
                               FontWeight="{DynamicResource TypeBodyStrongFontWeight}"
                               Foreground="{DynamicResource TextPrimaryBrush}" />
                    <TextBlock Text="Launch MetroHub automatically when you sign in"
                               FontSize="{DynamicResource TypeCaptionFontSize}"
                               Foreground="{DynamicResource TextSecondaryBrush}"
                               Margin="0,2,0,0" />
                </StackPanel>
            </ui:CardControl.Header>
            <ui:ToggleSwitch IsChecked="{Binding LaunchAtStartup, Mode=TwoWay}" />
        </ui:CardControl>

        <!-- Card 2: Start Minimized to System Tray -->
        <ui:CardControl>
            <ui:CardControl.Icon>
                <ui:SymbolIcon Symbol="ArrowMinimize24" FontSize="18" />
            </ui:CardControl.Icon>
            <ui:CardControl.Header>
                <StackPanel>
                    <TextBlock Text="Start Minimized"
                               FontSize="{DynamicResource TypeBodyFontSize}"
                               FontWeight="{DynamicResource TypeBodyStrongFontWeight}"
                               Foreground="{DynamicResource TextPrimaryBrush}" />
                    <TextBlock Text="Launch quietly in the background on startup"
                               FontSize="{DynamicResource TypeCaptionFontSize}"
                               Foreground="{DynamicResource TextSecondaryBrush}"
                               Margin="0,2,0,0" />
                </StackPanel>
            </ui:CardControl.Header>
            <ui:ToggleSwitch IsChecked="{Binding StartMinimized, Mode=TwoWay}" />
        </ui:CardControl>

        <!-- Card 3: System Tray Icon -->
        <ui:CardControl>
            <ui:CardControl.Icon>
                <ui:SymbolIcon Symbol="AppGeneric24" FontSize="18" />
            </ui:CardControl.Icon>
            <ui:CardControl.Header>
                <StackPanel>
                    <TextBlock Text="System Tray Icon"
                               FontSize="{DynamicResource TypeBodyFontSize}"
                               FontWeight="{DynamicResource TypeBodyStrongFontWeight}"
                               Foreground="{DynamicResource TextPrimaryBrush}" />
                    <TextBlock Text="Display the MetroHub icon in the notification area"
                               FontSize="{DynamicResource TypeCaptionFontSize}"
                               Foreground="{DynamicResource TextSecondaryBrush}"
                               Margin="0,2,0,0" />
                </StackPanel>
            </ui:CardControl.Header>
            <ui:ToggleSwitch IsChecked="{Binding ShowTrayIcon, Mode=TwoWay}" />
        </ui:CardControl>

        <!-- Card: Windows Hibernation -->
        <ui:CardControl>
            <ui:CardControl.Icon>
                <ui:SymbolIcon Symbol="WeatherMoon24" FontSize="18" />
            </ui:CardControl.Icon>
            <ui:CardControl.Header>
                <StackPanel>
                    <TextBlock Text="Windows Hibernation"
                               FontSize="{DynamicResource TypeBodyFontSize}"
                               FontWeight="{DynamicResource TypeBodyStrongFontWeight}"
                               Foreground="{DynamicResource TextPrimaryBrush}" />
                    <TextBlock Text="{Binding HibernateStatusDescription}"
                               FontSize="{DynamicResource TypeCaptionFontSize}"
                               Foreground="{DynamicResource TextSecondaryBrush}"
                               Margin="0,2,0,0" />
                </StackPanel>
            </ui:CardControl.Header>
            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                <TextBlock Text="{Binding HibernateToggleLabel}"
                           FontSize="{DynamicResource TypeBodyFontSize}"
                           Foreground="{DynamicResource TextSecondaryBrush}"
                           VerticalAlignment="Center"
                           Margin="0,0,10,0" />
                <ui:ToggleSwitch IsChecked="{Binding IsHibernateEnabled, Mode=TwoWay}" />
            </StackPanel>
        </ui:CardControl>

        <!-- Card 4: Display (Placed at bottom to prevent dropdown overlap) -->
        <ui:CardControl>
            <ui:CardControl.Icon>
                <ui:SymbolIcon Symbol="Desktop24" FontSize="18" />
            </ui:CardControl.Icon>
            <ui:CardControl.Header>
                <StackPanel>
                    <TextBlock Text="Display"
                               FontSize="{DynamicResource TypeBodyFontSize}"
                               FontWeight="{DynamicResource TypeBodyStrongFontWeight}"
                               Foreground="{DynamicResource TextPrimaryBrush}" />
                    <TextBlock Text="Choose which monitor MetroHub opens on"
                               FontSize="{DynamicResource TypeCaptionFontSize}"
                               Foreground="{DynamicResource TextSecondaryBrush}"
                               Margin="0,2,0,0" />
                </StackPanel>
            </ui:CardControl.Header>
            <ComboBox MinWidth="160"
                      ItemsSource="{Binding TargetDisplays}"
                      SelectedItem="{Binding SelectedTargetDisplay, Mode=TwoWay}" />
        </ui:CardControl>
    </StackPanel>
</UserControl>
