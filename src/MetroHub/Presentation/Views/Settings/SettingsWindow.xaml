<views:BorderlessFluentWindow x:Class="MetroHub.Presentation.Views.Settings.SettingsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:views="clr-namespace:MetroHub.Presentation.Views"
        xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
        Title="Settings"
        Width="920" Height="600"
        MinWidth="800" MinHeight="500"
        WindowStartupLocation="CenterScreen"
        WindowBackdropType="Acrylic"
        WindowCornerPreference="DoNotRound"
        WindowStyle="None"
        ResizeMode="CanResizeWithGrip"
        Background="Transparent"
        ExtendsContentIntoTitleBar="True"
        Foreground="{DynamicResource TextPrimaryBrush}"
        FontFamily="{DynamicResource AppFontFamily}"
        FontSize="{DynamicResource TypeBodyFontSize}"
        TextOptions.TextFormattingMode="Ideal"
        TextOptions.TextRenderingMode="ClearType"
        TextOptions.TextHintingMode="Auto"
        SnapsToDevicePixels="True"
        UseLayoutRounding="True">

    <Window.Resources>
        <!-- Home Card Category Style -->
        <Style x:Key="HomeCategoryCardStyle" TargetType="ui:CardAction">
            <Setter Property="Margin" Value="6" />
            <Setter Property="Padding" Value="20,18" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="BorderBrush" Value="{DynamicResource SurfaceBorderBrush}" />
            <Setter Property="BorderThickness" Value="1" />
        </Style>
    </Window.Resources>

    <!-- Master Layout Grid -->
    <Grid Background="Transparent">
        <Grid.RowDefinitions>
            <!-- Row 0: Custom Header / Titlebar (40px) -->
            <RowDefinition Height="40" />
            <!-- Row 1: Home View Host Area -->
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <!-- ========================================================================= -->
        <!-- ROW 0: CUSTOM TITLEBAR & DRAG STRIP                                      -->
        <!-- ========================================================================= -->
        <Grid Grid.Row="0"
              Background="Transparent"
              PreviewMouseLeftButtonDown="OnTitleBarMouseDown">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>

            <!-- Window Title & Glyph -->
            <StackPanel Grid.Column="0"
                        Orientation="Horizontal"
                        VerticalAlignment="Center"
                        Margin="16,0,0,0">
                <ui:SymbolIcon Symbol="Settings24"
                               FontSize="16"
                               Foreground="{DynamicResource SystemAccentColorPrimaryBrush}"
                               Margin="0,0,8,0" />
                <TextBlock Text="Settings"
                           FontSize="{DynamicResource TypeBodyStrongFontSize}"
                           FontWeight="{DynamicResource TypeHeaderFontWeight}"
                           Foreground="{DynamicResource TextPrimaryBrush}" />
            </StackPanel>

            <!-- Top-Right Close Button -->
            <StackPanel Grid.Column="1"
                        Orientation="Horizontal"
                        VerticalAlignment="Center"
                        Margin="0,0,8,0">
                <Button x:Name="CloseButton"
                        Style="{DynamicResource ModalDismissButtonStyle}"
                        Click="OnCloseButtonClick"
                        ToolTip="Close (Esc)" />
            </StackPanel>
        </Grid>

        <!-- ========================================================================= -->
        <!-- ROW 1: PHASE 1 HOME VIEW (CATEGORY CARDS GRID)                            -->
        <!-- ========================================================================= -->
        <Grid x:Name="HomeViewHost"
              Grid.Row="1"
              Margin="36,12,36,24">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
            </Grid.RowDefinitions>

            <!-- Home Hero Header -->
            <StackPanel Grid.Row="0" Margin="0,0,0,24">
                <TextBlock Text="Settings"
                           FontSize="26"
                           FontWeight="SemiBold"
                           Foreground="{DynamicResource TextPrimaryBrush}" />
                <TextBlock Text="Configure MetroHub behavior, personalization, and widgets"
                           FontSize="{DynamicResource TypeBodyFontSize}"
                           Foreground="{DynamicResource TextSecondaryBrush}"
                           Margin="0,4,0,0" />
            </StackPanel>

            <!-- 6 Category Cards Grid -->
            <ScrollViewer Grid.Row="1"
                          VerticalScrollBarVisibility="Auto"
                          HorizontalScrollBarVisibility="Disabled">
                <UniformGrid Columns="2" Margin="0,0,0,12">

                    <!-- 1. General -->
                    <ui:CardAction Style="{StaticResource HomeCategoryCardStyle}"
                                   Tag="General"
                                   Click="OnCategoryCardClick">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <ui:SymbolIcon Symbol="Power24"
                                           FontSize="28"
                                           Foreground="{DynamicResource SystemAccentColorPrimaryBrush}"
                                           Margin="0,0,16,0"
                                           VerticalAlignment="Center" />
                            <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                <TextBlock Text="General"
                                           FontSize="15"
                                           FontWeight="SemiBold"
                                           Foreground="{DynamicResource TextPrimaryBrush}" />
                                <TextBlock Text="Startup at login, exit on launch, and hub behavior"
                                           FontSize="{DynamicResource TypeCaptionFontSize}"
                                           Foreground="{DynamicResource TextSecondaryBrush}"
                                           Margin="0,3,0,0"
                                           TextWrapping="Wrap" />
                            </StackPanel>
                        </Grid>
                    </ui:CardAction>

                    <!-- 2. Personalization -->
                    <ui:CardAction Style="{StaticResource HomeCategoryCardStyle}"
                                   Tag="Personalization"
                                   Click="OnCategoryCardClick">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <ui:SymbolIcon Symbol="PaintBucket24"
                                           FontSize="28"
                                           Foreground="{DynamicResource SystemAccentColorPrimaryBrush}"
                                           Margin="0,0,16,0"
                                           VerticalAlignment="Center" />
                            <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                <TextBlock Text="Personalization"
                                           FontSize="15"
                                           FontWeight="SemiBold"
                                           Foreground="{DynamicResource TextPrimaryBrush}" />
                                <TextBlock Text="Theme mode, acrylic backdrops, wallpapers, and tile corners"
                                           FontSize="{DynamicResource TypeCaptionFontSize}"
                                           Foreground="{DynamicResource TextSecondaryBrush}"
                                           Margin="0,3,0,0"
                                           TextWrapping="Wrap" />
                            </StackPanel>
                        </Grid>
                    </ui:CardAction>

                    <!-- 3. Canvas & Workspaces -->
                    <ui:CardAction Style="{StaticResource HomeCategoryCardStyle}"
                                   Tag="Canvas"
                                   Click="OnCategoryCardClick">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <ui:SymbolIcon Symbol="Grid24"
                                           FontSize="28"
                                           Foreground="{DynamicResource SystemAccentColorPrimaryBrush}"
                                           Margin="0,0,16,0"
                                           VerticalAlignment="Center" />
                            <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                <TextBlock Text="Canvas &amp; Workspaces"
                                           FontSize="15"
                                           FontWeight="SemiBold"
                                           Foreground="{DynamicResource TextPrimaryBrush}" />
                                <TextBlock Text="Canvas scroll orientation and slide direction"
                                           FontSize="{DynamicResource TypeCaptionFontSize}"
                                           Foreground="{DynamicResource TextSecondaryBrush}"
                                           Margin="0,3,0,0"
                                           TextWrapping="Wrap" />
                            </StackPanel>
                        </Grid>
                    </ui:CardAction>

                    <!-- 4. Shortcuts & Hotkeys -->
                    <ui:CardAction Style="{StaticResource HomeCategoryCardStyle}"
                                   Tag="Shortcuts"
                                   Click="OnCategoryCardClick">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <ui:SymbolIcon Symbol="Keyboard24"
                                           FontSize="28"
                                           Foreground="{DynamicResource SystemAccentColorPrimaryBrush}"
                                           Margin="0,0,16,0"
                                           VerticalAlignment="Center" />
                            <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                <TextBlock Text="Shortcuts &amp; Hotkeys"
                                           FontSize="15"
                                           FontWeight="SemiBold"
                                           Foreground="{DynamicResource TextPrimaryBrush}" />
                                <TextBlock Text="Global activation shortcut and workspace direct keys"
                                           FontSize="{DynamicResource TypeCaptionFontSize}"
                                           Foreground="{DynamicResource TextSecondaryBrush}"
                                           Margin="0,3,0,0"
                                           TextWrapping="Wrap" />
                            </StackPanel>
                        </Grid>
                    </ui:CardAction>

                    <!-- 5. Widgets Defaults -->
                    <ui:CardAction Style="{StaticResource HomeCategoryCardStyle}"
                                   Tag="Widgets"
                                   Click="OnCategoryCardClick">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <ui:SymbolIcon Symbol="AppGeneric24"
                                           FontSize="28"
                                           Foreground="{DynamicResource SystemAccentColorPrimaryBrush}"
                                           Margin="0,0,16,0"
                                           VerticalAlignment="Center" />
                            <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                <TextBlock Text="Widgets"
                                           FontSize="15"
                                           FontWeight="SemiBold"
                                           Foreground="{DynamicResource TextPrimaryBrush}" />
                                <TextBlock Text="Universal defaults for clock, weather units, and calendar"
                                           FontSize="{DynamicResource TypeCaptionFontSize}"
                                           Foreground="{DynamicResource TextSecondaryBrush}"
                                           Margin="0,3,0,0"
                                           TextWrapping="Wrap" />
                            </StackPanel>
                        </Grid>
                    </ui:CardAction>

                    <!-- 6. About & Updates -->
                    <ui:CardAction Style="{StaticResource HomeCategoryCardStyle}"
                                   Tag="About"
                                   Click="OnCategoryCardClick">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <ui:SymbolIcon Symbol="Info24"
                                           FontSize="28"
                                           Foreground="{DynamicResource SystemAccentColorPrimaryBrush}"
                                           Margin="0,0,16,0"
                                           VerticalAlignment="Center" />
                            <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                <TextBlock Text="About &amp; Updates"
                                           FontSize="15"
                                           FontWeight="SemiBold"
                                           Foreground="{DynamicResource TextPrimaryBrush}" />
                                <TextBlock Text="Version information, Velopack updater, and application logs"
                                           FontSize="{DynamicResource TypeCaptionFontSize}"
                                           Foreground="{DynamicResource TextSecondaryBrush}"
                                           Margin="0,3,0,0"
                                           TextWrapping="Wrap" />
                            </StackPanel>
                        </Grid>
                    </ui:CardAction>

                </UniformGrid>
            </ScrollViewer>
        </Grid>
    </Grid>
</views:BorderlessFluentWindow>
