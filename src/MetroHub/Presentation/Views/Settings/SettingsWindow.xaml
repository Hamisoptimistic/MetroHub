<views:BorderlessFluentWindow x:Class="MetroHub.Presentation.Views.Settings.SettingsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:views="clr-namespace:MetroHub.Presentation.Views"
        xmlns:vm="clr-namespace:MetroHub.Presentation.Views.Settings.ViewModels"
        xmlns:pages="clr-namespace:MetroHub.Presentation.Views.Settings.Pages"
        xmlns:behaviors="clr-namespace:MetroHub.Presentation.Controls.Behaviors"
        xmlns:controls="clr-namespace:MetroHub.Presentation.Controls"
        Title="Settings"
        Width="960" Height="640"
        MinWidth="720" MinHeight="460"
        WindowStartupLocation="CenterOwner"
        WindowBackdropType="Acrylic"
        WindowCornerPreference="DoNotRound"
        WindowStyle="None"
        ResizeMode="NoResize"
        ShowInTaskbar="False"
        Background="Transparent"
        ExtendsContentIntoTitleBar="True"
        Foreground="{DynamicResource TextPrimaryBrush}"
        FontFamily="{DynamicResource AppFontFamily}"
        FontSize="{DynamicResource TypeBodyFontSize}"
        TextOptions.TextFormattingMode="Ideal"
        TextOptions.TextRenderingMode="ClearType"
        TextOptions.TextHintingMode="Auto"
        SnapsToDevicePixels="True"
        UseLayoutRounding="True">

    <Window.Resources>
        <!-- View Model DataTemplates -->
        <DataTemplate DataType="{x:Type vm:SettingsHomeViewModel}">
            <pages:SettingsHomeView />
        </DataTemplate>
        <DataTemplate DataType="{x:Type vm:SettingsDetailLayoutViewModel}">
            <pages:SettingsDetailLayout />
        </DataTemplate>
        <DataTemplate DataType="{x:Type vm:GeneralSettingsViewModel}">
            <pages:GeneralPage />
        </DataTemplate>
        <DataTemplate DataType="{x:Type vm:SidebarSettingsViewModel}">
            <pages:SidebarPage />
        </DataTemplate>
    </Window.Resources>

    <!-- Master Fluent Acrylic Shell with sharp Metro hairline border -->
    <Border Background="Transparent"
            BorderBrush="{DynamicResource SurfaceBorderBrush}"
            BorderThickness="1"
            CornerRadius="{DynamicResource TileCornerRadius}"
            SnapsToDevicePixels="True">
        <!-- Master Layout Grid (Full-Bleed Viewport with Floating Titlebar Overlay) -->
        <Grid Background="Transparent"
              controls:ClipHelper.IsCornerClipped="True"
              controls:ClipHelper.CornerRadius="{DynamicResource TileCornerRadius}"
              controls:ClipHelper.BorderThickness="1">
            <!-- Full-Bleed Content Host (CurrentView covers all window bounds Y=0..640) -->
            <ContentControl Content="{Binding CurrentView}"
                            behaviors:FluentTransitionBehavior.IsEnabled="True"
                            Focusable="False" />

            <!-- ========================================================================= -->
            <!-- TOP-RIGHT CLOSE [X] BUTTON (NON-DRAGGABLE WINDOW)                         -->
            <!-- ========================================================================= -->
            <StackPanel HorizontalAlignment="Right"
                        VerticalAlignment="Top"
                        Margin="0,8,10,0">
                <Button x:Name="CloseButton"
                        Style="{DynamicResource ModalDismissButtonStyle}"
                        Click="OnCloseButtonClick"
                        ToolTip="Close (Esc)" />
            </StackPanel>
        </Grid>
    </Border>
</views:BorderlessFluentWindow>
