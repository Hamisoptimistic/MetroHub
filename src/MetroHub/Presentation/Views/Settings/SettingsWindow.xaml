<views:BorderlessFluentWindow x:Class="MetroHub.Presentation.Views.Settings.SettingsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:po="http://schemas.microsoft.com/winfx/2006/xaml/presentation/options"
        xmlns:views="clr-namespace:MetroHub.Presentation.Views"
        xmlns:vm="clr-namespace:MetroHub.Presentation.Views.Settings.ViewModels"
        xmlns:pages="clr-namespace:MetroHub.Presentation.Views.Settings.Pages"
        Title="Settings"
        Width="960" Height="640"
        MinWidth="720" MinHeight="460"
        WindowStartupLocation="CenterOwner"
        WindowBackdropType="Acrylic"
        WindowCornerPreference="DoNotRound"
        WindowStyle="None"
        ResizeMode="NoResize"
        ShowInTaskbar="False"
        Background="Transparent"
        ExtendsContentIntoTitleBar="True"
        Foreground="{DynamicResource TextPrimaryBrush}"
        FontFamily="{DynamicResource AppFontFamily}"
        FontSize="{DynamicResource TypeBodyFontSize}"
        TextOptions.TextFormattingMode="Ideal"
        TextOptions.TextRenderingMode="ClearType"
        TextOptions.TextHintingMode="Auto"
        SnapsToDevicePixels="True"
        UseLayoutRounding="True">

    <Window.Resources>
        <!-- Tier 2: Calibrated Obsidian Deck Tint (16% delta tint over MainWindow's 60% Acrylic) -->
        <SolidColorBrush x:Key="SettingsTier2ObsidianBrush" Color="#280D0D11" po:Freeze="True" />

        <!-- View Model DataTemplates -->
        <DataTemplate DataType="{x:Type vm:SettingsHomeViewModel}">
            <pages:SettingsHomeView />
        </DataTemplate>
    </Window.Resources>

    <!-- Master Layout Grid (Tier 1: Uniform MetroDialog Frosted Acrylic) -->
    <Grid Background="Transparent">
        <Grid.RowDefinitions>
            <!-- Row 0: Custom Titlebar Drag Strip & Close [X] (36px) -->
            <RowDefinition Height="36" />
            <!-- Row 1: Content Host (CurrentView) -->
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <!-- ========================================================================= -->
        <!-- ROW 0: CLEAN TITLEBAR (DRAG STRIP + CLOSE BUTTON ONLY)                   -->
        <!-- ========================================================================= -->
        <Grid Grid.Row="0" Background="Transparent">
            <Grid.ColumnDefinitions>
                <!-- Column 0: Full Drag Area (No text/icons) -->
                <ColumnDefinition Width="*" />
                <!-- Column 1: Close [X] Button -->
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>

            <!-- Invisible Drag Strip -->
            <Border Grid.Column="0"
                    Background="Transparent"
                    MouseLeftButtonDown="OnTitleBarMouseDown" />

            <!-- Top-Right Close Button -->
            <StackPanel Grid.Column="1"
                        Orientation="Horizontal"
                        VerticalAlignment="Center"
                        Margin="0,0,10,0">
                <Button x:Name="CloseButton"
                        Style="{DynamicResource ModalDismissButtonStyle}"
                        Click="OnCloseButtonClick"
                        ToolTip="Close (Esc)" />
            </StackPanel>
        </Grid>

        <!-- ========================================================================= -->
        <!-- ROW 1: CONTENT VIEWPORT HOST                                             -->
        <!-- ========================================================================= -->
        <ContentControl Grid.Row="1"
                        Content="{Binding CurrentView}"
                        Focusable="False" />
    </Grid>
</views:BorderlessFluentWindow>
