<views:BorderlessFluentWindow x:Class="MetroHub.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:views="clr-namespace:MetroHub.Presentation.Views"
        xmlns:controls="clr-namespace:MetroHub.Presentation.Controls"
        xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
        mc:Ignorable="d"
        Title="MetroHub"
        ResizeMode="NoResize"
        ExtendsContentIntoTitleBar="True"
        WindowBackdropType="None"
        Background="Transparent"
        WindowCornerPreference="DoNotRound"
        WindowStyle="None"
        BorderThickness="0"
        BorderBrush="Transparent"
        AllowsTransparency="False"
        ShowInTaskbar="False"
        Topmost="True"
        FontFamily="{DynamicResource AppFontFamily}"
        FontSize="{DynamicResource TypeBodyFontSize}"
        FontWeight="{DynamicResource TypeBodyFontWeight}"
        TextOptions.TextFormattingMode="Ideal"
        TextOptions.TextRenderingMode="ClearType"
        TextOptions.TextHintingMode="Fixed"
        SnapsToDevicePixels="True"
        UseLayoutRounding="True"
        RenderOptions.ClearTypeHint="Enabled"
        PreviewKeyDown="OnWindowPreviewKeyDown"
        SourceInitialized="OnSourceInitialized"
        Deactivated="OnWindowDeactivated"
        AllowDrop="True"
        DragOver="OnWindowDragOver"
        DragLeave="OnWindowDragLeave"
        Drop="OnWindowDrop">

    <views:BorderlessFluentWindow.Resources>
    </views:BorderlessFluentWindow.Resources>

    <!-- WPF Transparent brush passes mouse hit-tests while remaining invisible so DWM Mica renders directly -->
   <Grid x:Name="RootGrid" 
          Background="Transparent"
          Opacity="1"
          RenderTransformOrigin="0.5, 0.5"
          RenderOptions.ClearTypeHint="Enabled"
          TextOptions.TextFormattingMode="Ideal"
          TextOptions.TextRenderingMode="ClearType"
          TextOptions.TextHintingMode="Fixed"
          PreviewMouseLeftButtonDown="OnCanvasPreviewMouseDown"
          PreviewMouseMove="OnCanvasPreviewMouseMove"
          PreviewMouseLeftButtonUp="OnCanvasPreviewMouseUp"
          MouseLeave="OnCanvasMouseLeave">
        <Grid.ColumnDefinitions>
            <!-- Left Navigation Sidebar Rail (Fixed 48px, Full Height) -->
            <ColumnDefinition Width="48" />
            <!-- Main Canvas Content Area -->
            <ColumnDefinition Width="*" />
        </Grid.ColumnDefinitions>

        <!-- Background Layer: Custom / Desktop Wallpaper with Fluent Dark Scrim -->
        <Grid x:Name="CustomWallpaperHost"
              Grid.Column="0"
              Grid.ColumnSpan="2"
              Panel.ZIndex="-100"
              ClipToBounds="True"
              IsHitTestVisible="False"
              Focusable="False"
              Visibility="Collapsed">
            <Rectangle x:Name="ShaderHost"
                       Fill="#000000"
                       HorizontalAlignment="Stretch"
                       VerticalAlignment="Stretch"
                       Visibility="Collapsed" />
            <Image x:Name="WallpaperImage"
                   Stretch="UniformToFill"
                   HorizontalAlignment="Center"
                   VerticalAlignment="Top"
                   Margin="0,0,0,-90"
                   RenderOptions.BitmapScalingMode="Linear">
                <Image.RenderTransform>
                    <TranslateTransform x:Name="WallpaperTranslateTransform" />
                </Image.RenderTransform>
            </Image>
            <!-- Hardware-accelerated video wallpaper player (Media Foundation EVR + DXVA2 hardware decode) -->
            <MediaElement x:Name="WallpaperVideo"
                          Stretch="UniformToFill"
                          HorizontalAlignment="Center"
                          VerticalAlignment="Top"
                          Margin="0,0,0,-90"
                          LoadedBehavior="Manual"
                          UnloadedBehavior="Manual"
                          Volume="0"
                          IsMuted="True"
                          ScrubbingEnabled="False"
                          IsHitTestVisible="False"
                          Focusable="False"
                          RenderOptions.BitmapScalingMode="LowQuality"
                          RenderOptions.EdgeMode="Aliased"
                          Visibility="Collapsed"
                          MediaOpened="OnWallpaperVideoMediaOpened"
                          MediaEnded="OnWallpaperVideoMediaEnded"
                          MediaFailed="OnWallpaperVideoMediaFailed">
                <MediaElement.RenderTransform>
                    <TranslateTransform x:Name="WallpaperVideoTranslateTransform" />
                </MediaElement.RenderTransform>
            </MediaElement>
            <!-- Fluent Dark Scrim Overlay (ensures 4.5:1 text readability across all images and live video) -->
            <Border x:Name="WallpaperScrim"
                    Background="#80000000" />
        </Grid>

        <!-- Left Sidebar Navigation Rail (Spans full window height) -->
        <controls:SidebarRailControl x:Name="SidebarRail"
                                     Grid.Column="0"
                                     VerticalAlignment="Stretch"
                                     Panel.ZIndex="2000"
                                     AppsToggleRequested="OnSidebarAppsToggleRequested"
                                     AddWebLinkRequested="OnSidebarAddWebLinkRequested"
                                     SettingsRequested="OnSidebarSettingsRequested"
                                     MouseEnter="OnSidebarRailMouseEnter"
                                     MouseLeave="OnSidebarRailMouseLeave">
            <controls:SidebarRailControl.RenderTransform>
                <TranslateTransform X="-52" />
            </controls:SidebarRailControl.RenderTransform>
        </controls:SidebarRailControl>

        <!-- 5px Invisible Hit-Test Strip along the left screen edge to detect hover intent -->
        <Border x:Name="LeftEdgeHoverStrip"
                Grid.Column="0"
                HorizontalAlignment="Left"
                Width="5"
                VerticalAlignment="Stretch"
                Background="Transparent"
                Panel.ZIndex="1999"
                MouseEnter="OnLeftEdgeHoverStripMouseEnter"
                MouseLeave="OnLeftEdgeHoverStripMouseLeave"
                AllowDrop="True"
                DragEnter="OnLeftEdgeHoverStripDragEnter" />

        <!-- Main Application Content Area (Tile Canvas) in Column 1 -->
        <Grid x:Name="MainContentAreaGrid"
              Grid.Column="1">

            <!-- Main Open Tile Canvas: Free placement drag and drop anywhere -->
            <ScrollViewer x:Name="ContentScrollViewer"
                          controls:AutoHideScrollBehavior.IsEnabled="True"
                          controls:SmoothPhysicsScrollBehavior.IsEnabled="True"
                          VerticalScrollBarVisibility="Auto"
                          HorizontalScrollBarVisibility="Disabled"
                          Background="Transparent"
                          Focusable="False">

            <Grid x:Name="MainCanvasGrid"
                  Background="Transparent"
                  PreviewMouseRightButtonDown="OnCanvasPreviewMouseRightButtonDown">
                <Grid.ContextMenu>
                    <ContextMenu x:Name="CanvasContextMenu"
                                 Opened="OnCanvasContextMenuOpened">
                        <ContextMenu.Resources>
                            <!-- Cap submenu flyouts to exactly ~15 visible items (460px) with smooth scrolling -->
                            <Style TargetType="{x:Type ScrollViewer}" BasedOn="{StaticResource FloatingScrollViewerStyle}">
                                <Setter Property="MaxHeight" Value="460" />
                                <Setter Property="VerticalScrollBarVisibility" Value="Auto" />
                                <Setter Property="HorizontalScrollBarVisibility" Value="Disabled" />
                                <Setter Property="CanContentScroll" Value="True" />
                            </Style>
                        </ContextMenu.Resources>

                        <!-- Modular Catalogs: Apps -->
                        <MenuItem x:Name="AppsMenuItem"
                                  Header="Apps"
                                  SubmenuOpened="OnAppsSubmenuOpened">
                            <MenuItem.Icon>
                                <ui:SymbolIcon Symbol="AppsAddIn24" FontSize="20" Foreground="{DynamicResource TextSecondaryBrush}" />
                            </MenuItem.Icon>
                            <MenuItem.ItemsPanel>
                                <ItemsPanelTemplate>
                                    <VirtualizingStackPanel IsVirtualizing="True"
                                                            VirtualizationMode="Recycling" />
                                </ItemsPanelTemplate>
                            </MenuItem.ItemsPanel>
                            <MenuItem.ItemContainerStyle>
                                <Style TargetType="{x:Type MenuItem}" BasedOn="{StaticResource {x:Type MenuItem}}">
                                    <Setter Property="MinHeight" Value="30" />
                                    <Setter Property="Padding" Value="10,4,14,4" />
                                    <Setter Property="Header" Value="{Binding}" />
                                    <Setter Property="HeaderTemplate">
                                        <Setter.Value>
                                            <DataTemplate>
                                                <Grid VerticalAlignment="Center">
                                                    <Grid.ColumnDefinitions>
                                                        <ColumnDefinition Width="24" />
                                                        <ColumnDefinition Width="*" />
                                                    </Grid.ColumnDefinitions>
                                                    <Image Grid.Column="0"
                                                           Source="{Binding Icon, TargetNullValue={x:Null}, FallbackValue={x:Null}}"
                                                           Width="20" Height="20"
                                                           HorizontalAlignment="Center"
                                                           VerticalAlignment="Center"
                                                           RenderOptions.BitmapScalingMode="HighQuality"
                                                           />
                                                    <TextBlock Grid.Column="1"
                                                               Text="{Binding Name}"
                                                               VerticalAlignment="Center"
                                                               Margin="10,0,8,0"
                                                               FontSize="{DynamicResource TypeBodyFontSize}"
                                                               FontWeight="{DynamicResource TypeBodyFontWeight}"
                                                               Foreground="{DynamicResource TextPrimaryBrush}" />
                                                </Grid>
                                            </DataTemplate>
                                        </Setter.Value>
                                    </Setter>
                                    <EventSetter Event="Click" Handler="OnAppMenuItemClick" />
                                </Style>
                            </MenuItem.ItemContainerStyle>
                            <MenuItem Header="Loading applications..." IsEnabled="False" />
                        </MenuItem>

                        <!-- Modular Catalogs: Widgets -->
                        <MenuItem x:Name="WidgetsMenuItem"
                                  Header="Widgets"
                                  SubmenuOpened="OnWidgetsSubmenuOpened">
                            <MenuItem.Icon>
                                <ui:SymbolIcon Symbol="AppGeneric24" FontSize="20" Foreground="{DynamicResource TextSecondaryBrush}" />
                            </MenuItem.Icon>
                            <MenuItem Header="Loading widgets..." IsEnabled="False" />
                        </MenuItem>

                        <!-- Add Web Link -->
                        <MenuItem Header="Add Web Link..."
                                  Click="OnCanvasAddWebLinkClick">
                            <MenuItem.Icon>
                                <ui:SymbolIcon Symbol="Globe24" FontSize="20" Foreground="{DynamicResource TextSecondaryBrush}" />
                            </MenuItem.Icon>
                        </MenuItem>

                        <MenuItem Header="Add Custom Tile..." Click="OnAddTileClick">
                            <MenuItem.Icon>
                                <ui:SymbolIcon Symbol="Add24" FontSize="20" />
                            </MenuItem.Icon>
                        </MenuItem>

                        <MenuItem x:Name="PasteCanvasMenuItem"
                                  Header="Paste"
                                  InputGestureText="Ctrl+V"
                                  Click="OnCanvasPasteClick">
                            <MenuItem.Icon>
                                <ui:SymbolIcon Symbol="ClipboardPaste24" FontSize="20" Foreground="{DynamicResource TextSecondaryBrush}" />
                            </MenuItem.Icon>
                        </MenuItem>

                        <Separator x:Name="GroupSectionSeparator" />

                        <!-- Group Creation (Visible when right-clicking empty space outside a group) -->
                        <MenuItem x:Name="CreateGroupCanvasMenuItem"
                                  Header="Create Group"
                                  Click="OnCreateGroupCanvasClick">
                            <MenuItem.Icon>
                                <ui:SymbolIcon Symbol="FolderAdd24" FontSize="20" />
                            </MenuItem.Icon>
                        </MenuItem>

                        <!-- Dynamic Group Options (Visible when right-clicking empty space inside a group) -->
                        <MenuItem x:Name="RenameGroupCanvasMenuItem"
                                  Header="Rename Group"
                                  Visibility="Collapsed"
                                  Click="OnCanvasRenameGroupClick">
                            <MenuItem.Icon>
                                <ui:SymbolIcon Symbol="Edit24" FontSize="20" />
                            </MenuItem.Icon>
                        </MenuItem>

                        <MenuItem x:Name="GroupHeaderColorCanvasMenuItem"
                                  Header="Header Color"
                                  Visibility="Collapsed">
                            <MenuItem.Icon>
                                <ui:SymbolIcon Symbol="Color24" FontSize="20" />
                            </MenuItem.Icon>
                            <MenuItem Header="Default White" Tag="#F0FFFFFF" Click="OnCanvasGroupColorSelectClick">
                                <MenuItem.Icon><Ellipse Width="12" Height="12" Fill="{DynamicResource GroupBrushDefault}"/></MenuItem.Icon>
                            </MenuItem>
                            <MenuItem Header="Fluent Sky Blue" Tag="#60CDFF" Click="OnCanvasGroupColorSelectClick">
                                <MenuItem.Icon><Ellipse Width="12" Height="12" Fill="{DynamicResource GroupBrushSkyBlue}"/></MenuItem.Icon>
                            </MenuItem>
                            <MenuItem Header="Electric Azure" Tag="#0078D7" Click="OnCanvasGroupColorSelectClick">
                                <MenuItem.Icon><Ellipse Width="12" Height="12" Fill="{DynamicResource GroupBrushAzure}"/></MenuItem.Icon>
                            </MenuItem>
                            <MenuItem Header="Emerald Green" Tag="#107C10" Click="OnCanvasGroupColorSelectClick">
                                <MenuItem.Icon><Ellipse Width="12" Height="12" Fill="{DynamicResource GroupBrushEmerald}"/></MenuItem.Icon>
                            </MenuItem>
                            <MenuItem Header="Mint Cyan" Tag="#00B7C3" Click="OnCanvasGroupColorSelectClick">
                                <MenuItem.Icon><Ellipse Width="12" Height="12" Fill="{DynamicResource GroupBrushCyan}"/></MenuItem.Icon>
                            </MenuItem>
                            <MenuItem Header="Neon Orange" Tag="#FF8C00" Click="OnCanvasGroupColorSelectClick">
                                <MenuItem.Icon><Ellipse Width="12" Height="12" Fill="{DynamicResource GroupBrushOrange}"/></MenuItem.Icon>
                            </MenuItem>
                            <MenuItem Header="Electric Amber" Tag="#FFD700" Click="OnCanvasGroupColorSelectClick">
                                <MenuItem.Icon><Ellipse Width="12" Height="12" Fill="{DynamicResource GroupBrushAmber}"/></MenuItem.Icon>
                            </MenuItem>
                            <MenuItem Header="Crimson Red" Tag="#FF4343" Click="OnCanvasGroupColorSelectClick">
                                <MenuItem.Icon><Ellipse Width="12" Height="12" Fill="{DynamicResource GroupBrushCrimson}"/></MenuItem.Icon>
                            </MenuItem>
                            <MenuItem Header="Royal Purple" Tag="#881798" Click="OnCanvasGroupColorSelectClick">
                                <MenuItem.Icon><Ellipse Width="12" Height="12" Fill="{DynamicResource GroupBrushPurple}"/></MenuItem.Icon>
                            </MenuItem>
                            <MenuItem Header="Hot Pink" Tag="#E3008C" Click="OnCanvasGroupColorSelectClick">
                                <MenuItem.Icon><Ellipse Width="12" Height="12" Fill="{DynamicResource GroupBrushHotPink}"/></MenuItem.Icon>
                            </MenuItem>
                        </MenuItem>

                        <MenuItem x:Name="GroupTintColorCanvasMenuItem"
                                  Header="Group Tint Color"
                                  Visibility="Collapsed">
                            <MenuItem.Icon>
                                <ui:SymbolIcon Symbol="PaintBucket24" FontSize="20" Foreground="{DynamicResource TextSecondaryBrush}" />
                            </MenuItem.Icon>
                            <MenuItem Header="None" Tag="None" Click="OnCanvasGroupTintColorSelectClick" />
                            <MenuItem Header="Fluent Sky Blue" Tag="#60CDFF" Click="OnCanvasGroupTintColorSelectClick">
                                <MenuItem.Icon><Ellipse Width="12" Height="12" Fill="{DynamicResource GroupBrushSkyBlue}"/></MenuItem.Icon>
                            </MenuItem>
                            <MenuItem Header="Electric Azure" Tag="#0078D7" Click="OnCanvasGroupTintColorSelectClick">
                                <MenuItem.Icon><Ellipse Width="12" Height="12" Fill="{DynamicResource GroupBrushAzure}"/></MenuItem.Icon>
                            </MenuItem>
                            <MenuItem Header="Emerald Green" Tag="#107C10" Click="OnCanvasGroupTintColorSelectClick">
                                <MenuItem.Icon><Ellipse Width="12" Height="12" Fill="{DynamicResource GroupBrushEmerald}"/></MenuItem.Icon>
                            </MenuItem>
                            <MenuItem Header="Mint Cyan" Tag="#00B7C3" Click="OnCanvasGroupTintColorSelectClick">
                                <MenuItem.Icon><Ellipse Width="12" Height="12" Fill="{DynamicResource GroupBrushCyan}"/></MenuItem.Icon>
                            </MenuItem>
                            <MenuItem Header="Neon Orange" Tag="#FF8C00" Click="OnCanvasGroupTintColorSelectClick">
                                <MenuItem.Icon><Ellipse Width="12" Height="12" Fill="{DynamicResource GroupBrushOrange}"/></MenuItem.Icon>
                            </MenuItem>
                            <MenuItem Header="Electric Amber" Tag="#FFD700" Click="OnCanvasGroupTintColorSelectClick">
                                <MenuItem.Icon><Ellipse Width="12" Height="12" Fill="{DynamicResource GroupBrushAmber}"/></MenuItem.Icon>
                            </MenuItem>
                            <MenuItem Header="Crimson Red" Tag="#FF4343" Click="OnCanvasGroupTintColorSelectClick">
                                <MenuItem.Icon><Ellipse Width="12" Height="12" Fill="{DynamicResource GroupBrushCrimson}"/></MenuItem.Icon>
                            </MenuItem>
                            <MenuItem Header="Royal Purple" Tag="#881798" Click="OnCanvasGroupTintColorSelectClick">
                                <MenuItem.Icon><Ellipse Width="12" Height="12" Fill="{DynamicResource GroupBrushPurple}"/></MenuItem.Icon>
                            </MenuItem>
                            <MenuItem Header="Hot Pink" Tag="#E3008C" Click="OnCanvasGroupTintColorSelectClick">
                                <MenuItem.Icon><Ellipse Width="12" Height="12" Fill="{DynamicResource GroupBrushHotPink}"/></MenuItem.Icon>
                            </MenuItem>
                        </MenuItem>

                        <MenuItem x:Name="LockGroupCanvasMenuItem"
                                  Header="Lock Group"
                                  Visibility="Collapsed"
                                  Click="OnCanvasLockGroupClick">
                            <MenuItem.Icon>
                                <ui:SymbolIcon x:Name="LockGroupCanvasIcon" Symbol="LockClosed24" FontSize="20" />
                            </MenuItem.Icon>
                        </MenuItem>

                        <MenuItem x:Name="UngroupCanvasMenuItem"
                                  Header="Ungroup Tiles"
                                  Visibility="Collapsed"
                                  Click="OnCanvasUngroupClick">
                            <MenuItem.Icon>
                                <ui:SymbolIcon Symbol="SelectAllOn24" FontSize="20" />
                            </MenuItem.Icon>
                        </MenuItem>

                        <MenuItem x:Name="DeleteGroupCanvasMenuItem"
                                  Header="Delete Group and Tiles"
                                  Foreground="{DynamicResource StatusErrorBrush}"
                                  Visibility="Collapsed"
                                  Click="OnCanvasDeleteGroupClick">
                            <MenuItem.Icon>
                                <ui:SymbolIcon Symbol="Delete24" FontSize="20" Foreground="{DynamicResource StatusErrorBrush}" />
                            </MenuItem.Icon>
                        </MenuItem>

                        <Separator x:Name="GlobalSettingsSeparator" />

                        <MenuItem x:Name="BackgroundCanvasMenuItem" Header="Background">
                            <MenuItem.Icon>
                                <ui:SymbolIcon Symbol="PaintBucket24" FontSize="20" Foreground="{DynamicResource TextSecondaryBrush}" />
                            </MenuItem.Icon>
                            <MenuItem x:Name="BackdropMicaItem" Header="Mica" IsCheckable="True" Click="OnBackdropMicaClick" />
                            <MenuItem x:Name="BackdropAcrylicItem" Header="Acrylic" IsCheckable="True" Click="OnBackdropAcrylicClick" />
                            <Separator />
                            <MenuItem x:Name="BackdropDesktopWallpaperItem" Header="Desktop Wallpaper" IsCheckable="True" Click="OnBackdropDesktopWallpaperClick" />
                            <MenuItem x:Name="BackdropBingDailyItem" Header="Bing Daily" IsCheckable="True" Click="OnBackdropBingDailyClick" />
                            <MenuItem x:Name="BackdropSpotlightDailyItem" Header="Windows Spotlight" IsCheckable="True" Click="OnBackdropSpotlightDailyClick" />
                            <MenuItem x:Name="BackdropCustomImageItem" Header="Custom Picture..." IsCheckable="True" Click="OnBackdropCustomImageClick" />
                            <MenuItem x:Name="ImageEffectsMenu" Header="Image Effects">
                                <MenuItem x:Name="ImageEffectNoneItem" Header="None" IsCheckable="True" Click="OnImageEffectNoneClick" />
                                <MenuItem x:Name="ImageEffectBlurItem" Header="Frosted Blur" IsCheckable="True" Click="OnImageEffectBlurClick" />
                                <MenuItem x:Name="ImageEffectWaterRippleItem" Header="Water Ripple" IsCheckable="True" Click="OnImageEffectWaterRippleClick" />
                            </MenuItem>
                            <Separator />
                            <MenuItem x:Name="LiveWallpapersMenu" Header="Live Wallpapers">
                                <MenuItem x:Name="LiveStarfieldItem" Header="Starfield" IsCheckable="True" Click="OnLiveStarfieldClick" />
                                <MenuItem x:Name="LiveCyberTunnelItem" Header="Cyber Tunnel" IsCheckable="True" Click="OnLiveCyberTunnelClick" />
                                <MenuItem x:Name="LiveFluidWavesItem" Header="Fluid Waves" IsCheckable="True" Click="OnLiveFluidWavesClick" />
                                <MenuItem x:Name="LiveNeonClockItem" Header="Neon Clock" IsCheckable="True" Click="OnLiveNeonClockClick" />
                                <MenuItem x:Name="LiveCircuitItem" Header="Circuit" IsCheckable="True" Click="OnLiveCircuitClick" />
                                <MenuItem x:Name="LiveEtherItem" Header="Ether" IsCheckable="True" Click="OnLiveEtherClick" />
                                <MenuItem x:Name="LiveSmokeFogItem" Header="Smoke &amp; Fog" IsCheckable="True" Click="OnLiveSmokeFogClick" />
                                <MenuItem x:Name="LiveKalisetItem" Header="Kaliset" IsCheckable="True" Click="OnLiveKalisetClick" />
                                <MenuItem x:Name="LiveKoiPondItem" Header="Koi Pond" IsCheckable="True" Click="OnLiveKoiPondClick" />
                                <MenuItem x:Name="LiveInkItem" Header="Ink Flow" IsCheckable="True" Click="OnLiveInkClick" />
                                <MenuItem x:Name="LiveWaterCausticsItem" Header="Water Caustics" IsCheckable="True" Click="OnLiveWaterCausticsClick" />
                                <MenuItem x:Name="LivePebblesMenu" Header="Pebbles">
                                    <MenuItem x:Name="LivePebblesRoseItem" Header="Rose" IsCheckable="True" Click="OnLivePebblesRoseClick" />
                                    <MenuItem x:Name="LivePebblesAmberItem" Header="Amber" IsCheckable="True" Click="OnLivePebblesAmberClick" />
                                    <MenuItem x:Name="LivePebblesIceItem" Header="Ice" IsCheckable="True" Click="OnLivePebblesIceClick" />
                                    <MenuItem x:Name="LivePebblesObsidianItem" Header="Obsidian" IsCheckable="True" Click="OnLivePebblesObsidianClick" />
                                    <MenuItem x:Name="LivePebblesRerankItem" Header="Violet Neon" IsCheckable="True" Click="OnLivePebblesRerankClick" />
                                    <MenuItem x:Name="LivePebblesTranslateItem" Header="Teal Coral" IsCheckable="True" Click="OnLivePebblesTranslateClick" />
                                </MenuItem>
                                <MenuItem x:Name="LivePlanetsMenu" Header="Planets">
                                    <MenuItem x:Name="LivePlanetProceduralItem" Header="Procedural Planet" IsCheckable="True" Click="OnLivePlanetProceduralClick" />
                                    <MenuItem x:Name="LiveEarthRealtimeItem" Header="Earth (Realtime 24h Sync)" IsCheckable="True" Click="OnLiveEarthRealtimeClick" />
                                    <MenuItem x:Name="LiveEarthCinematicItem" Header="Earth (Cinematic Spin)" IsCheckable="True" Click="OnLiveEarthCinematicClick" />
                                    <MenuItem x:Name="LiveMarsItem" Header="Mars" IsCheckable="True" Click="OnLiveMarsClick" />
                                    <MenuItem x:Name="LiveJupiterItem" Header="Jupiter" IsCheckable="True" Click="OnLiveJupiterClick" />
                                    <MenuItem x:Name="LiveVenusItem" Header="Venus" IsCheckable="True" Click="OnLiveVenusClick" />
                                    <MenuItem x:Name="LiveMercuryItem" Header="Mercury" IsCheckable="True" Click="OnLiveMercuryClick" />
                                    <MenuItem x:Name="LiveMoonItem" Header="Moon" IsCheckable="True" Click="OnLiveMoonClick" />
                                </MenuItem>
                                <Separator />
                                <MenuItem x:Name="LiveCustomVideoItem" Header="Custom Video..." IsCheckable="True" Click="OnLiveCustomVideoClick" />
                            </MenuItem>
                            <Separator />
                            <MenuItem Header="Wallpaper Dimming">
                                <MenuItem x:Name="DimLightItem" Header="Light" IsCheckable="True" Click="OnWallpaperDimLightClick" />
                                <MenuItem x:Name="DimBalancedItem" Header="Balanced" IsCheckable="True" Click="OnWallpaperDimBalancedClick" />
                                <MenuItem x:Name="DimHeavyItem" Header="Heavy" IsCheckable="True" Click="OnWallpaperDimHeavyClick" />
                            </MenuItem>
                            <MenuItem Header="Wallpaper Parallax">
                                <MenuItem x:Name="ParallaxEnabledItem" Header="Enabled" IsCheckable="True" Click="OnParallaxEnabledClick" />
                                <MenuItem x:Name="ParallaxDisabledItem" Header="Disabled" IsCheckable="True" Click="OnParallaxDisabledClick" />
                            </MenuItem>
                        </MenuItem>

                        <MenuItem x:Name="TileCornersCanvasMenuItem" Header="Tile Corners">
                            <MenuItem.Icon>
                                <ui:SymbolIcon Symbol="Shapes24" FontSize="20" Foreground="{DynamicResource TextSecondaryBrush}" />
                            </MenuItem.Icon>
                            <MenuItem x:Name="TileCornerSharpItem" Header="Sharp Metro (0px)" IsCheckable="True" Click="OnTileCornerSharpClick" />
                            <MenuItem x:Name="TileCornerSubtleItem" Header="Subtle Edge (2px)" IsCheckable="True" Click="OnTileCornerSubtleClick" />
                            <MenuItem x:Name="TileCornerMediumItem" Header="Medium Fluent (4px)" IsCheckable="True" Click="OnTileCornerMediumClick" />
                            <MenuItem x:Name="TileCornerRoundedItem" Header="Rounded Fluent (8px)" IsCheckable="True" Click="OnTileCornerRoundedClick" />
                        </MenuItem>
                    </ContextMenu>
                </Grid.ContextMenu>
                <!-- Drop Target Slot Indicator (snaps to grid in real-time) -->
                <Canvas x:Name="DropIndicatorCanvas" IsHitTestVisible="False" Panel.ZIndex="2000">
                    <Border x:Name="DropSlotIndicator"
                            Visibility="Collapsed"
                            CornerRadius="{DynamicResource TileCornerRadius}"
                            BorderThickness="1.5"
                            BorderBrush="{DynamicResource SystemAccentColorPrimaryBrush}"
                            Background="{DynamicResource SystemAccentColorDropSlotFill}" />
                </Canvas>

                <!-- Rubber-band (Marquee) Multi-Tile Selection Box -->
                <Canvas x:Name="RubberBandCanvas" IsHitTestVisible="False" Panel.ZIndex="3000">
                    <Rectangle x:Name="RubberBandBox"
                               Visibility="Collapsed"
                               Fill="{DynamicResource SystemAccentColorSelectionFill}"
                               Stroke="{DynamicResource SystemAccentColorPrimaryBrush}"
                               StrokeThickness="1"
                               RadiusX="3"
                               RadiusY="3" />
                </Canvas>

                <!-- Group Drag-to-Add Perimeter Glow & Floating Badge -->
                <Canvas x:Name="GroupDropHighlightCanvas" IsHitTestVisible="False" Panel.ZIndex="2500">
                    <Border x:Name="GroupDropPerimeterBorder"
                            Visibility="Collapsed"
                            CornerRadius="{DynamicResource TileCornerRadius}"
                            BorderThickness="1"
                            BorderBrush="{DynamicResource SystemAccentColorPrimaryBrush}"
                            Background="{DynamicResource SystemAccentColorGroupDropFill}"
                            RenderTransformOrigin="0.5,0.5">
                        <Border.RenderTransform>
                            <TranslateTransform x:Name="GroupDropPerimeterTranslate" X="0" Y="0" />
                        </Border.RenderTransform>
                    </Border>

                    <!-- Thin 1x1 Red Glowing Border for 1x1 Gap Drop Warning Feedback -->
                    <Border x:Name="GapDropWarningBorder"
                            Visibility="Collapsed"
                            Width="56" Height="56"
                            CornerRadius="{DynamicResource TileCornerRadius}"
                            BorderThickness="1.5"
                            BorderBrush="{DynamicResource StatusDangerGlowBrush}"
                            Background="{DynamicResource StatusDangerSubtleBrush}"
                            IsHitTestVisible="False" />

                    <!-- WPF-UI Fluent Card Style Floating Badge -->
                    <Border x:Name="GroupDropFloatingBadge"
                            Visibility="Collapsed"
                            CornerRadius="{DynamicResource ControlCornerRadiusLarge}"
                            Background="{DynamicResource ShellBadgeBackground}"
                            BorderThickness="1"
                            BorderBrush="{DynamicResource SurfaceBorderBrush}"
                            Padding="10,6,12,6">
                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                            <ui:SymbolIcon x:Name="GroupDropBadgeIcon"
                                           Symbol="Add24"
                                           FontSize="13"
                                           Foreground="{DynamicResource SystemAccentColorPrimaryBrush}"
                                           Margin="0,0,8,0"
                                           VerticalAlignment="Center" />
                            <TextBlock x:Name="GroupDropBadgeText"
                                       Text="Add to Section"
                                       FontSize="{DynamicResource TypeCaptionFontSize}"
                                       FontWeight="{DynamicResource TypeBodyStrongFontWeight}"
                                       Foreground="{DynamicResource TextPrimaryBrush}"
                                       VerticalAlignment="Center" />
                        </StackPanel>
                    </Border>

                    <!-- Horizontal Group Insertion Drop Line -->
                    <Border x:Name="GroupInsertionLine"
                            Visibility="Collapsed"
                            Height="3"
                            CornerRadius="1.5"
                            Background="{DynamicResource SystemAccentColorPrimaryBrush}" />
                </Canvas>

                <!-- Retained Workspaces Host Grid: houses WorkspaceCanvasControl instances per workspace -->
                <Grid x:Name="CanvasHostPanel" Background="Transparent" ClipToBounds="True" />

            </Grid>
        </ScrollViewer>

        </Grid>

        <!-- All Apps Slide-out Drawer Host (Clipped to Column 1 so it cannot bleed over Sidebar Rail) -->
        <Grid Grid.Column="1"
              Grid.Row="0"
              Grid.RowSpan="2"
              ClipToBounds="True"
              Panel.ZIndex="1500">
            <controls:AllAppsDrawerControl x:Name="AllAppsDrawer"
                                           HorizontalAlignment="Left"
                                           VerticalAlignment="Stretch"
                                           AppPinRequested="OnDrawerAppPinRequested"
                                           AppUnpinRequested="OnDrawerAppUnpinRequested"
                                           FilePinRequested="OnDrawerFilePinRequested"
                                           FileUnpinRequested="OnDrawerFileUnpinRequested"
                                           AppLaunchRequested="OnDrawerAppLaunchRequested"
                                           ShellHideRequested="OnDrawerShellHideRequested"
                                           Opened="OnDrawerOpened"
                                           Closing="OnDrawerClosing"
                                           Closed="OnDrawerClosed" />
        </Grid>

        <!-- Ambient Canvas Focus Scrim (Softly dims the background canvas when Settings or Dialog is active) -->
        <Border x:Name="AmbientFocusScrim"
                Grid.Column="0"
                Grid.ColumnSpan="2"
                Background="{DynamicResource SmokeFillColorDefaultBrush}"
                Opacity="0"
                IsHitTestVisible="False"
                MouseLeftButtonDown="OnAmbientFocusScrimMouseDown"
                Panel.ZIndex="3000" />

        <!-- Universal WPF-UI Modal ContentDialog Host Presenter (Spans entire window above all layers) -->
        <ContentPresenter x:Name="RootContentDialogPresenter"
                          Grid.Column="0"
                          Grid.ColumnSpan="2"
                          HorizontalAlignment="Stretch"
                          VerticalAlignment="Stretch"
                          Panel.ZIndex="9999" />
    </Grid>
</views:BorderlessFluentWindow>