<Application x:Class="MetroHub.App"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:local="clr-namespace:MetroHub"
             xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml">
    <Application.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ui:ThemesDictionary Theme="Dark" />
                <ui:ControlsDictionary />
                <ResourceDictionary Source="/Widgets/WidgetStyles.xaml" />
            </ResourceDictionary.MergedDictionaries>

            <!-- Central Typography & Icon Tokens -->
            <FontFamily x:Key="AppFontFamily">Segoe UI Variable Text, Segoe UI Variable, Segoe UI, sans-serif</FontFamily>
            <FontFamily x:Key="AppDisplayFontFamily">Segoe UI Variable Display, Segoe UI Variable, Segoe UI, sans-serif</FontFamily>
            <FontFamily x:Key="AppIconFontFamily">Segoe Fluent Icons, Segoe MDL2 Assets, sans-serif</FontFamily>
            <FontFamily x:Key="AppMonoFontFamily">Consolas, Cascadia Code, Segoe UI Mono, monospace</FontFamily>

            <!-- Obsidian Acrylic ContentDialog Theme Tokens (WPF-UI 3.0.4) -->
            <SolidColorBrush x:Key="ContentDialogBackground" Color="#F214161A" />
            <SolidColorBrush x:Key="ContentDialogBorderBrush" Color="#35FFFFFF" />
            <SolidColorBrush x:Key="ContentDialogSmokeFill" Color="#8A08080C" />
            <SolidColorBrush x:Key="SmokeFillColorDefaultBrush" Color="#8A08080C" />
            <SolidColorBrush x:Key="ContentDialogSeparatorBorderBrush" Color="#18FFFFFF" />
            <SolidColorBrush x:Key="ContentDialogTopOverlay" Color="#08FFFFFF" />
            <CornerRadius x:Key="DialogOverlayCornerRadius">10,10,0,0</CornerRadius>
            <CornerRadius x:Key="DialogFooterCornerRadius">0,0,10,10</CornerRadius>

            <!-- ========================================================================= -->
            <!-- UNIVERSAL FLUENT GEOMETRY & INTERACTION TOKENS                            -->
            <!-- ========================================================================= -->
            <!-- Standard Control & Button Corner Radius (Universal 2px for all buttons & controls) -->
            <CornerRadius x:Key="ControlCornerRadius">2</CornerRadius>
            <CornerRadius x:Key="ControlCornerRadiusSmall">2</CornerRadius>
            <CornerRadius x:Key="ControlCornerRadiusLarge">4</CornerRadius>

            <!-- ContextMenu & Dropdown Container / Item Radius (Crisp 2px) -->
            <CornerRadius x:Key="ContextMenuCornerRadius">2</CornerRadius>

            <!-- Universal Fluent Dark-Glass Interaction Brushes (Matching Sidebar Sheen) -->
            <SolidColorBrush x:Key="FluentHoverBrush" Color="#12FFFFFF" />
            <SolidColorBrush x:Key="FluentPressedBrush" Color="#1EFFFFFF" />
            <SolidColorBrush x:Key="FluentHoverBorderBrush" Color="Transparent" />


            <!-- Cohesive Fluent Action Button Styles (Matching Sleek Wi-Fi Connect & Modal Submit) -->
            <Style x:Key="FluentCohesiveActionButtonStyle" TargetType="Button">
                <Setter Property="Background" Value="#1CFFFFFF" />
                <Setter Property="BorderBrush" Value="Transparent" />
                <Setter Property="BorderThickness" Value="0" />
                <Setter Property="Foreground" Value="#F5FFFFFF" />
                <Setter Property="FontFamily" Value="{DynamicResource AppFontFamily}" />
                <Setter Property="FontSize" Value="12" />
                <Setter Property="FontWeight" Value="SemiBold" />
                <Setter Property="Cursor" Value="Hand" />
                <Setter Property="FocusVisualStyle" Value="{x:Null}" />
                <Setter Property="HorizontalContentAlignment" Value="Center" />
                <Setter Property="VerticalContentAlignment" Value="Center" />
                <Setter Property="SnapsToDevicePixels" Value="True" />
                <Setter Property="UseLayoutRounding" Value="True" />
                <Setter Property="Template">
                    <Setter.Value>
                        <ControlTemplate TargetType="Button">
                            <Border x:Name="ButtonBorder"
                                    Background="{TemplateBinding Background}"
                                    BorderBrush="{TemplateBinding BorderBrush}"
                                    BorderThickness="{TemplateBinding BorderThickness}"
                                    CornerRadius="{StaticResource ControlCornerRadius}"
                                    SnapsToDevicePixels="True">
                                <ContentPresenter HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}"
                                                  VerticalAlignment="{TemplateBinding VerticalContentAlignment}"
                                                  Margin="{TemplateBinding Padding}"
                                                  SnapsToDevicePixels="True" />
                            </Border>
                            <ControlTemplate.Triggers>
                                <Trigger Property="IsMouseOver" Value="True">
                                    <Setter TargetName="ButtonBorder" Property="Background" Value="#25FFFFFF" />
                                    <Setter Property="Foreground" Value="#FFFFFF" />
                                </Trigger>
                                <Trigger Property="IsPressed" Value="True">
                                    <Setter TargetName="ButtonBorder" Property="Background" Value="{StaticResource FluentPressedBrush}" />
                                    <Setter Property="Foreground" Value="#FFFFFF" />
                                </Trigger>
                                <Trigger Property="IsEnabled" Value="False">
                                    <Setter TargetName="ButtonBorder" Property="Opacity" Value="0.35" />
                                </Trigger>
                            </ControlTemplate.Triggers>
                        </ControlTemplate>
                    </Setter.Value>
                </Setter>
            </Style>

            <Style x:Key="FluentCohesiveSecondaryButtonStyle" TargetType="Button" BasedOn="{StaticResource FluentCohesiveActionButtonStyle}">
                <Setter Property="Background" Value="#10FFFFFF" />
                <Setter Property="BorderBrush" Value="Transparent" />
                <Setter Property="BorderThickness" Value="0" />
                <Setter Property="Foreground" Value="#B5FFFFFF" />
                <Style.Triggers>
                    <Trigger Property="IsMouseOver" Value="True">
                        <Setter Property="Background" Value="{StaticResource FluentHoverBrush}" />
                        <Setter Property="Foreground" Value="#FFFFFF" />
                    </Trigger>
                    <Trigger Property="IsPressed" Value="True">
                        <Setter Property="Background" Value="{StaticResource FluentPressedBrush}" />
                    </Trigger>
                    <Trigger Property="IsEnabled" Value="False">
                        <Setter Property="Opacity" Value="0.35" />
                    </Trigger>
                </Style.Triggers>
            </Style>

            <!-- Universal Fluent Ghost Button Style (Icon / Toolbar / Header Buttons) -->
            <Style x:Key="FluentGhostButtonStyle" TargetType="Button">
                <Setter Property="Background" Value="Transparent" />
                <Setter Property="BorderBrush" Value="Transparent" />
                <Setter Property="BorderThickness" Value="0" />
                <Setter Property="Foreground" Value="#95FFFFFF" />
                <Setter Property="Cursor" Value="Hand" />
                <Setter Property="FocusVisualStyle" Value="{x:Null}" />
                <Setter Property="HorizontalContentAlignment" Value="Center" />
                <Setter Property="VerticalContentAlignment" Value="Center" />
                <Setter Property="SnapsToDevicePixels" Value="True" />
                <Setter Property="UseLayoutRounding" Value="True" />
                <Setter Property="Template">
                    <Setter.Value>
                        <ControlTemplate TargetType="Button">
                            <Border x:Name="PillBorder"
                                    Background="{TemplateBinding Background}"
                                    BorderBrush="{TemplateBinding BorderBrush}"
                                    BorderThickness="{TemplateBinding BorderThickness}"
                                    CornerRadius="{StaticResource ControlCornerRadius}"
                                    SnapsToDevicePixels="True"
                                    UseLayoutRounding="True">
                                <ContentPresenter HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}"
                                                  VerticalAlignment="{TemplateBinding VerticalContentAlignment}"
                                                  Margin="{TemplateBinding Padding}"
                                                  SnapsToDevicePixels="True" />
                            </Border>
                            <ControlTemplate.Triggers>
                                <Trigger Property="IsMouseOver" Value="True">
                                    <Setter TargetName="PillBorder" Property="Background" Value="{StaticResource FluentHoverBrush}" />
                                    <Setter Property="Foreground" Value="#FFFFFF" />
                                </Trigger>
                                <Trigger Property="IsPressed" Value="True">
                                    <Setter TargetName="PillBorder" Property="Background" Value="{StaticResource FluentPressedBrush}" />
                                    <Setter Property="Foreground" Value="#FFFFFF" />
                                </Trigger>
                                <Trigger Property="IsEnabled" Value="False">
                                    <Setter TargetName="PillBorder" Property="Opacity" Value="0.35" />
                                </Trigger>
                            </ControlTemplate.Triggers>
                        </ControlTemplate>
                    </Setter.Value>
                </Setter>
            </Style>

            <!-- Implicit Default Button Style: All standard Buttons inherit sidebar hover by default -->
            <Style TargetType="Button" BasedOn="{StaticResource FluentGhostButtonStyle}" />

            <!-- Universal Windows 11 Fluent Dark-Glass ToolTip Style (2px Corners, Deep Obsidian Acrylic, Zero Square Artifacts) -->
            <Style TargetType="{x:Type ToolTip}">
                <Setter Property="OverridesDefaultStyle" Value="True" />
                <Setter Property="Background" Value="#F214161A" />
                <Setter Property="BorderBrush" Value="#25FFFFFF" />
                <Setter Property="BorderThickness" Value="1" />
                <Setter Property="Foreground" Value="#F0FFFFFF" />
                <Setter Property="FontFamily" Value="{DynamicResource AppFontFamily}" />
                <Setter Property="FontSize" Value="12" />
                <Setter Property="FontWeight" Value="Normal" />
                <Setter Property="Padding" Value="8,4,8,4" />
                <Setter Property="SnapsToDevicePixels" Value="True" />
                <Setter Property="UseLayoutRounding" Value="True" />
                <Setter Property="HasDropShadow" Value="False" />
                <Setter Property="Template">
                    <Setter.Value>
                        <ControlTemplate TargetType="{x:Type ToolTip}">
                            <Border Background="{TemplateBinding Background}"
                                    BorderBrush="{TemplateBinding BorderBrush}"
                                    BorderThickness="{TemplateBinding BorderThickness}"
                                    CornerRadius="{DynamicResource ControlCornerRadius}"
                                    Padding="{TemplateBinding Padding}"
                                    SnapsToDevicePixels="True"
                                    UseLayoutRounding="True">
                                <Border.Effect>
                                    <DropShadowEffect ShadowDepth="2" Direction="270" Opacity="0.45" BlurRadius="10" Color="#000000" />
                                </Border.Effect>
                                <ContentPresenter HorizontalAlignment="Left"
                                                  VerticalAlignment="Center"
                                                  SnapsToDevicePixels="True" />
                            </Border>
                        </ControlTemplate>
                    </Setter.Value>
                </Setter>
            </Style>

            <!-- Universal Fluent ScrollBar: 100% Transparent Track (No grey background gutter ever), Translucent White Thumb -->
            <Style x:Key="ScrollBarPageButtonStyle" TargetType="{x:Type RepeatButton}">
                <Setter Property="OverridesDefaultStyle" Value="True" />
                <Setter Property="Background" Value="Transparent" />
                <Setter Property="Focusable" Value="False" />
                <Setter Property="IsTabStop" Value="False" />
                <Setter Property="Template">
                    <Setter.Value>
                        <ControlTemplate TargetType="{x:Type RepeatButton}">
                            <Rectangle Fill="Transparent" />
                        </ControlTemplate>
                    </Setter.Value>
                </Setter>
            </Style>

            <!-- Universal Fluent ScrollBar Thumbs: 4px thin pill at rest (matching AudioControls), smoothly expands to 9px on hover/drag -->
            <Style x:Key="UniversalScrollVerticalThumbStyle" TargetType="{x:Type Thumb}">
                <Setter Property="OverridesDefaultStyle" Value="True" />
                <Setter Property="IsTabStop" Value="False" />
                <Setter Property="Template">
                    <Setter.Value>
                        <ControlTemplate TargetType="{x:Type Thumb}">
                            <Grid Background="Transparent">
                                <Border x:Name="ThumbBorder"
                                        Width="4"
                                        HorizontalAlignment="Right"
                                        Margin="0,2,2,2"
                                        Background="#45FFFFFF"
                                        CornerRadius="2"
                                        SnapsToDevicePixels="True" />
                            </Grid>
                            <ControlTemplate.Triggers>
                                <Trigger Property="Tag" Value="Expanded">
                                    <Trigger.EnterActions>
                                        <BeginStoryboard>
                                            <Storyboard>
                                                <DoubleAnimation Storyboard.TargetName="ThumbBorder"
                                                                 Storyboard.TargetProperty="Width"
                                                                 To="8"
                                                                 Duration="0:0:0.12">
                                                    <DoubleAnimation.EasingFunction>
                                                        <CubicEase EasingMode="EaseOut" />
                                                    </DoubleAnimation.EasingFunction>
                                                </DoubleAnimation>
                                            </Storyboard>
                                        </BeginStoryboard>
                                    </Trigger.EnterActions>
                                    <Trigger.ExitActions>
                                        <BeginStoryboard>
                                            <Storyboard>
                                                <DoubleAnimation Storyboard.TargetName="ThumbBorder"
                                                                 Storyboard.TargetProperty="Width"
                                                                 To="4"
                                                                 Duration="0:0:0.16">
                                                    <DoubleAnimation.EasingFunction>
                                                        <CubicEase EasingMode="EaseOut" />
                                                    </DoubleAnimation.EasingFunction>
                                                </DoubleAnimation>
                                            </Storyboard>
                                        </BeginStoryboard>
                                    </Trigger.ExitActions>
                                    <Setter TargetName="ThumbBorder" Property="Background" Value="#95FFFFFF" />
                                    <Setter TargetName="ThumbBorder" Property="CornerRadius" Value="4" />
                                </Trigger>
                                <Trigger Property="IsMouseOver" Value="True">
                                    <Setter TargetName="ThumbBorder" Property="Width" Value="8" />
                                    <Setter TargetName="ThumbBorder" Property="CornerRadius" Value="4" />
                                    <Setter TargetName="ThumbBorder" Property="Background" Value="#95FFFFFF" />
                                </Trigger>
                                <Trigger Property="IsDragging" Value="True">
                                    <Setter TargetName="ThumbBorder" Property="Width" Value="8" />
                                    <Setter TargetName="ThumbBorder" Property="CornerRadius" Value="4" />
                                    <Setter TargetName="ThumbBorder" Property="Background" Value="#D0FFFFFF" />
                                </Trigger>
                            </ControlTemplate.Triggers>
                        </ControlTemplate>
                    </Setter.Value>
                </Setter>
            </Style>

            <Style x:Key="UniversalScrollHorizontalThumbStyle" TargetType="{x:Type Thumb}">
                <Setter Property="OverridesDefaultStyle" Value="True" />
                <Setter Property="IsTabStop" Value="False" />
                <Setter Property="Template">
                    <Setter.Value>
                        <ControlTemplate TargetType="{x:Type Thumb}">
                            <Grid Background="Transparent">
                                <Border x:Name="ThumbBorder"
                                        Height="4"
                                        VerticalAlignment="Bottom"
                                        Margin="2,0,2,2"
                                        Background="#45FFFFFF"
                                        CornerRadius="2"
                                        SnapsToDevicePixels="True" />
                            </Grid>
                            <ControlTemplate.Triggers>
                                <Trigger Property="Tag" Value="Expanded">
                                    <Trigger.EnterActions>
                                        <BeginStoryboard>
                                            <Storyboard>
                                                <DoubleAnimation Storyboard.TargetName="ThumbBorder"
                                                                 Storyboard.TargetProperty="Height"
                                                                 To="8"
                                                                 Duration="0:0:0.12">
                                                    <DoubleAnimation.EasingFunction>
                                                        <CubicEase EasingMode="EaseOut" />
                                                    </DoubleAnimation.EasingFunction>
                                                </DoubleAnimation>
                                            </Storyboard>
                                        </BeginStoryboard>
                                    </Trigger.EnterActions>
                                    <Trigger.ExitActions>
                                        <BeginStoryboard>
                                            <Storyboard>
                                                <DoubleAnimation Storyboard.TargetName="ThumbBorder"
                                                                 Storyboard.TargetProperty="Height"
                                                                 To="4"
                                                                 Duration="0:0:0.16">
                                                    <DoubleAnimation.EasingFunction>
                                                        <CubicEase EasingMode="EaseOut" />
                                                    </DoubleAnimation.EasingFunction>
                                                </DoubleAnimation>
                                            </Storyboard>
                                        </BeginStoryboard>
                                    </Trigger.ExitActions>
                                    <Setter TargetName="ThumbBorder" Property="Background" Value="#95FFFFFF" />
                                    <Setter TargetName="ThumbBorder" Property="CornerRadius" Value="4" />
                                </Trigger>
                                <Trigger Property="IsMouseOver" Value="True">
                                    <Setter TargetName="ThumbBorder" Property="Height" Value="8" />
                                    <Setter TargetName="ThumbBorder" Property="CornerRadius" Value="4" />
                                    <Setter TargetName="ThumbBorder" Property="Background" Value="#95FFFFFF" />
                                </Trigger>
                                <Trigger Property="IsDragging" Value="True">
                                    <Setter TargetName="ThumbBorder" Property="Height" Value="8" />
                                    <Setter TargetName="ThumbBorder" Property="CornerRadius" Value="4" />
                                    <Setter TargetName="ThumbBorder" Property="Background" Value="#D0FFFFFF" />
                                </Trigger>
                            </ControlTemplate.Triggers>
                        </ControlTemplate>
                    </Setter.Value>
                </Setter>
            </Style>

            <Style x:Key="UniversalScrollThumbStyle" TargetType="{x:Type Thumb}" BasedOn="{StaticResource UniversalScrollVerticalThumbStyle}" />

            <Style TargetType="{x:Type ScrollBar}">
                <Setter Property="OverridesDefaultStyle" Value="True" />
                <Setter Property="SnapsToDevicePixels" Value="True" />
                <Setter Property="Background" Value="Transparent" />
                <Setter Property="BorderBrush" Value="Transparent" />
                <Setter Property="BorderThickness" Value="0" />
                <Style.Triggers>
                    <Trigger Property="Orientation" Value="Vertical">
                        <Setter Property="Width" Value="12" />
                        <Setter Property="MinWidth" Value="12" />
                        <Setter Property="Template">
                            <Setter.Value>
                                <ControlTemplate TargetType="{x:Type ScrollBar}">
                                    <Grid Background="Transparent">
                                        <Track x:Name="PART_Track" IsDirectionReversed="True">
                                            <Track.DecreaseRepeatButton>
                                                <RepeatButton Command="ScrollBar.PageUpCommand"
                                                              Style="{StaticResource ScrollBarPageButtonStyle}" />
                                            </Track.DecreaseRepeatButton>
                                            <Track.Thumb>
                                                <Thumb x:Name="Thumb" Style="{StaticResource UniversalScrollVerticalThumbStyle}" />
                                            </Track.Thumb>
                                            <Track.IncreaseRepeatButton>
                                                <RepeatButton Command="ScrollBar.PageDownCommand"
                                                              Style="{StaticResource ScrollBarPageButtonStyle}" />
                                            </Track.IncreaseRepeatButton>
                                        </Track>
                                    </Grid>
                                    <ControlTemplate.Triggers>
                                        <Trigger Property="IsMouseOver" Value="True">
                                            <Setter TargetName="Thumb" Property="Tag" Value="Expanded" />
                                        </Trigger>
                                    </ControlTemplate.Triggers>
                                </ControlTemplate>
                            </Setter.Value>
                        </Setter>
                    </Trigger>
                    <Trigger Property="Orientation" Value="Horizontal">
                        <Setter Property="Height" Value="12" />
                        <Setter Property="MinHeight" Value="12" />
                        <Setter Property="Template">
                            <Setter.Value>
                                <ControlTemplate TargetType="{x:Type ScrollBar}">
                                    <Grid Background="Transparent">
                                        <Track x:Name="PART_Track">
                                            <Track.DecreaseRepeatButton>
                                                <RepeatButton Command="ScrollBar.PageLeftCommand"
                                                              Style="{StaticResource ScrollBarPageButtonStyle}" />
                                            </Track.DecreaseRepeatButton>
                                            <Track.Thumb>
                                                <Thumb x:Name="Thumb" Style="{StaticResource UniversalScrollHorizontalThumbStyle}" />
                                            </Track.Thumb>
                                            <Track.IncreaseRepeatButton>
                                                <RepeatButton Command="ScrollBar.PageRightCommand"
                                                              Style="{StaticResource ScrollBarPageButtonStyle}" />
                                            </Track.IncreaseRepeatButton>
                                        </Track>
                                    </Grid>
                                    <ControlTemplate.Triggers>
                                        <Trigger Property="IsMouseOver" Value="True">
                                            <Setter TargetName="Thumb" Property="Tag" Value="Expanded" />
                                        </Trigger>
                                    </ControlTemplate.Triggers>
                                </ControlTemplate>
                            </Setter.Value>
                        </Setter>
                    </Trigger>
                </Style.Triggers>
            </Style>

            <!-- Universal DirectWrite Typography & Icon Defaults: Crisp vector outlines, zero color fringing across all future UI -->
            <Style TargetType="{x:Type TextBlock}">
                <Setter Property="TextOptions.TextFormattingMode" Value="Ideal" />
                <Setter Property="TextOptions.TextRenderingMode" Value="ClearType" />
                <Setter Property="TextOptions.TextHintingMode" Value="Fixed" />
                <Setter Property="SnapsToDevicePixels" Value="True" />
                <Setter Property="UseLayoutRounding" Value="True" />
            </Style>

            <Style TargetType="{x:Type Control}">
                <Setter Property="TextOptions.TextFormattingMode" Value="Ideal" />
                <Setter Property="TextOptions.TextRenderingMode" Value="ClearType" />
                <Setter Property="TextOptions.TextHintingMode" Value="Fixed" />
            </Style>

            <!-- Global Crisp DirectWrite Vector Styling for all current and future WPF-UI Icons -->
            <Style TargetType="{x:Type ui:SymbolIcon}">
                <Setter Property="SnapsToDevicePixels" Value="True" />
                <Setter Property="UseLayoutRounding" Value="True" />
                <Setter Property="Focusable" Value="False" />
                <Setter Property="TextOptions.TextFormattingMode" Value="Ideal" />
                <Setter Property="TextOptions.TextRenderingMode" Value="ClearType" />
                <Setter Property="TextOptions.TextHintingMode" Value="Fixed" />
            </Style>

            <!-- Authentic Windows 11 Fluent ContextMenu Style with Integrated Responsive Scaling -->
            <Style TargetType="{x:Type ContextMenu}">
                <Setter Property="FontFamily" Value="{StaticResource AppFontFamily}" />
                <Setter Property="FontSize" Value="14" />
                <Setter Property="FontWeight" Value="Normal" />
                <Setter Property="RenderOptions.ClearTypeHint" Value="Enabled" />
                <Setter Property="TextOptions.TextFormattingMode" Value="Ideal" />
                <Setter Property="TextOptions.TextRenderingMode" Value="ClearType" />
                <Setter Property="TextOptions.TextHintingMode" Value="Fixed" />
                <Setter Property="LayoutTransform">
                    <Setter.Value>
                        <ScaleTransform ScaleX="{Binding Source={x:Static local:MainWindow.Current}, Path=CurrentScale, FallbackValue=1.0}"
                                        ScaleY="{Binding Source={x:Static local:MainWindow.Current}, Path=CurrentScale, FallbackValue=1.0}" />
                    </Setter.Value>
                </Setter>
                <Setter Property="Foreground" Value="{DynamicResource ContextMenuForeground}" />
                <Setter Property="Background" Value="{DynamicResource ContextMenuBackground}" />
                <Setter Property="BorderBrush" Value="{DynamicResource ContextMenuBorderBrush}" />
                <Setter Property="MinWidth" Value="140" />
                <Setter Property="Padding" Value="0,3,0,3" />
                <Setter Property="Margin" Value="0" />
                <Setter Property="HasDropShadow" Value="False" />
                <Setter Property="Grid.IsSharedSizeScope" Value="True" />
                <Setter Property="SnapsToDevicePixels" Value="True" />
                <Setter Property="UseLayoutRounding" Value="True" />
                <Setter Property="OverridesDefaultStyle" Value="True" />
                <Setter Property="Template">
                    <Setter.Value>
                        <ControlTemplate TargetType="{x:Type ContextMenu}">
                            <Border x:Name="Border"
                                    BorderThickness="1"
                                    Padding="0,3,0,3"
                                    CornerRadius="{StaticResource ContextMenuCornerRadius}"
                                    BorderBrush="{TemplateBinding BorderBrush}"
                                    Background="{TemplateBinding Background}"
                                    SnapsToDevicePixels="True"
                                    UseLayoutRounding="True">
                                <Border.RenderTransform>
                                    <TranslateTransform x:Name="MenuTranslate" Y="0" />
                                </Border.RenderTransform>
                                <StackPanel Orientation="Vertical"
                                            IsItemsHost="True"
                                            ClipToBounds="True"
                                            KeyboardNavigation.DirectionalNavigation="Cycle" />
                            </Border>
                            <ControlTemplate.Triggers>
                                <Trigger Property="IsOpen" Value="True">
                                    <Trigger.EnterActions>
                                        <BeginStoryboard>
                                            <Storyboard>
                                                <!-- Smooth 12px subtle glide matching WPF-UI design language without window clipping -->
                                                <DoubleAnimation Storyboard.TargetName="Border"
                                                                 Storyboard.TargetProperty="(UIElement.RenderTransform).(TranslateTransform.Y)"
                                                                 From="-12" To="0"
                                                                 Duration="0:0:0.16">
                                                    <DoubleAnimation.EasingFunction>
                                                        <CircleEase EasingMode="EaseOut" />
                                                    </DoubleAnimation.EasingFunction>
                                                </DoubleAnimation>
                                                <!-- Smooth opacity fade in -->
                                                <DoubleAnimation Storyboard.TargetName="Border"
                                                                 Storyboard.TargetProperty="Opacity"
                                                                 From="0.0" To="1.0"
                                                                 Duration="0:0:0.14">
                                                    <DoubleAnimation.EasingFunction>
                                                        <CircleEase EasingMode="EaseOut" />
                                                    </DoubleAnimation.EasingFunction>
                                                </DoubleAnimation>
                                            </Storyboard>
                                        </BeginStoryboard>
                                    </Trigger.EnterActions>
                                </Trigger>
                            </ControlTemplate.Triggers>
                        </ControlTemplate>
                    </Setter.Value>
                </Setter>
            </Style>

            <!-- Universal Fluent ContextMenu Separator Style: Crisp, visible hairline divider matching Sidebar -->
            <Style TargetType="{x:Type Separator}">
                <Setter Property="OverridesDefaultStyle" Value="True" />
                <Setter Property="SnapsToDevicePixels" Value="True" />
                <Setter Property="UseLayoutRounding" Value="True" />
                <Setter Property="Template">
                    <Setter.Value>
                        <ControlTemplate TargetType="{x:Type Separator}">
                            <Grid Height="12" Background="Transparent" SnapsToDevicePixels="True">
                                <Rectangle Height="1"
                                           Margin="10,0,10,0"
                                           Fill="#45FFFFFF"
                                           SnapsToDevicePixels="True"
                                           UseLayoutRounding="True"
                                           VerticalAlignment="Center" />
                            </Grid>
                        </ControlTemplate>
                    </Setter.Value>
                </Setter>
            </Style>

            <!-- Universal Fluent SubmenuItem Template: Zero Square Checkbox, Modern Far-Left Active Pill Indicator -->
            <ControlTemplate x:Key="UniversalFluentSubmenuItemTemplate" TargetType="{x:Type MenuItem}">
                <Border x:Name="Border"
                        Background="Transparent"
                        CornerRadius="{StaticResource ContextMenuCornerRadius}"
                        Margin="4,1,4,1"
                        SnapsToDevicePixels="True"
                        UseLayoutRounding="True">
                    <Grid Height="{TemplateBinding MinHeight}">
                        <!-- Windows 11 Fluent Active Selection Indicator: Sleek vertical accent pill docked to far-left -->
                        <Border x:Name="ActiveIndicator"
                                HorizontalAlignment="Left"
                                VerticalAlignment="Center"
                                Width="3"
                                Height="16"
                                CornerRadius="1.5"
                                Margin="2,0,0,0"
                                Background="{DynamicResource SystemAccentColorPrimaryBrush}"
                                Visibility="Collapsed"
                                SnapsToDevicePixels="True" />

                        <!-- Content Grid: Icon + Header + InputGestureText -->
                        <Grid Margin="12,5,10,5" VerticalAlignment="Center">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" SharedSizeGroup="Shortcut" />
                            </Grid.ColumnDefinitions>

                            <ContentPresenter x:Name="IconHost"
                                              Content="{TemplateBinding Icon}"
                                              Margin="0,0,8,0"
                                              VerticalAlignment="Center"
                                              Grid.Column="0" />

                            <ContentPresenter x:Name="HeaderHost"
                                              ContentSource="Header"
                                              RecognizesAccessKey="True"
                                              VerticalAlignment="Center"
                                              TextElement.Foreground="{TemplateBinding Foreground}"
                                              Grid.Column="1" />

                            <TextBlock x:Name="InputGestureHost"
                                       Text="{TemplateBinding InputGestureText}"
                                       FontSize="11"
                                       Foreground="{DynamicResource TextFillColorDisabledBrush}"
                                       Margin="20,0,0,0"
                                       VerticalAlignment="Center"
                                       Grid.Column="2" />
                        </Grid>
                    </Grid>
                </Border>
                <ControlTemplate.Triggers>
                    <Trigger Property="Icon" Value="{x:Null}">
                        <Setter TargetName="IconHost" Property="Visibility" Value="Collapsed" />
                    </Trigger>
                    <Trigger Property="InputGestureText" Value="{x:Null}">
                        <Setter TargetName="InputGestureHost" Property="Visibility" Value="Collapsed" />
                    </Trigger>
                    <Trigger Property="InputGestureText" Value="">
                        <Setter TargetName="InputGestureHost" Property="Visibility" Value="Collapsed" />
                    </Trigger>
                    <!-- Active/Selected Pill Indicator: Triggers automatically whenever IsChecked is True -->
                    <Trigger Property="IsChecked" Value="True">
                        <Setter TargetName="ActiveIndicator" Property="Visibility" Value="Visible" />
                    </Trigger>
                    <Trigger Property="IsHighlighted" Value="True">
                        <Setter TargetName="Border" Property="Background" Value="{DynamicResource MenuBarItemBackgroundSelected}" />
                    </Trigger>
                    <Trigger Property="IsEnabled" Value="False">
                        <Setter Property="Foreground" Value="{DynamicResource TextFillColorDisabledBrush}" />
                        <Setter TargetName="ActiveIndicator" Property="Opacity" Value="0.4" />
                    </Trigger>
                </ControlTemplate.Triggers>
            </ControlTemplate>

            <!-- Universal Fluent SubmenuHeader Template: Parent items with sub-menus & smooth popup -->
            <ControlTemplate x:Key="UniversalFluentSubmenuHeaderTemplate" TargetType="{x:Type MenuItem}">
                <Grid>
                    <Border x:Name="Border"
                            Background="Transparent"
                            CornerRadius="{StaticResource ContextMenuCornerRadius}"
                            Margin="4,1,4,1"
                            SnapsToDevicePixels="True"
                            UseLayoutRounding="True">
                        <Grid Height="{TemplateBinding MinHeight}">
                            <!-- Active indicator on SubmenuHeader if ever checked -->
                            <Border x:Name="ActiveIndicator"
                                    HorizontalAlignment="Left"
                                    VerticalAlignment="Center"
                                    Width="3"
                                    Height="16"
                                    CornerRadius="1.5"
                                    Margin="2,0,0,0"
                                    Background="{DynamicResource SystemAccentColorPrimaryBrush}"
                                    Visibility="Collapsed"
                                    SnapsToDevicePixels="True" />

                            <Grid Margin="12,5,10,5" VerticalAlignment="Center">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>

                                <ContentPresenter x:Name="IconHost"
                                                  Content="{TemplateBinding Icon}"
                                                  Margin="0,0,8,0"
                                                  VerticalAlignment="Center"
                                                  Grid.Column="0" />

                                <ContentPresenter x:Name="HeaderHost"
                                                  ContentSource="Header"
                                                  RecognizesAccessKey="True"
                                                  VerticalAlignment="Center"
                                                  TextElement.Foreground="{TemplateBinding Foreground}"
                                                  Grid.Column="1" />

                                <ui:SymbolIcon x:Name="Chevron"
                                               Symbol="ChevronRight20"
                                               FontSize="14"
                                               Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                                               VerticalAlignment="Center"
                                               Margin="12,0,0,0"
                                               Grid.Column="2" />
                            </Grid>
                        </Grid>
                    </Border>
                    <Popup x:Name="Popup"
                           IsOpen="{TemplateBinding IsSubmenuOpen}"
                           Placement="Right"
                           VerticalOffset="-3"
                           PopupAnimation="None"
                           AllowsTransparency="True"
                           Focusable="False">
                        <Border x:Name="SubmenuBorder"
                                BorderThickness="1"
                                Padding="0,3,0,3"
                                CornerRadius="{StaticResource ContextMenuCornerRadius}"
                                BorderBrush="{DynamicResource ContextMenuBorderBrush}"
                                Background="{DynamicResource ContextMenuBackground}"
                                Margin="8,6,8,12"
                                SnapsToDevicePixels="True"
                                UseLayoutRounding="True"
                                CacheMode="BitmapCache">
                            <Border.LayoutTransform>
                                <ScaleTransform ScaleX="{Binding Source={x:Static local:MainWindow.Current}, Path=CurrentScale, FallbackValue=1.0}"
                                                ScaleY="{Binding Source={x:Static local:MainWindow.Current}, Path=CurrentScale, FallbackValue=1.0}" />
                            </Border.LayoutTransform>
                            <Border.RenderTransform>
                                <TranslateTransform x:Name="SubmenuTranslate" Y="0" />
                            </Border.RenderTransform>
                            <Border.Effect>
                                <DropShadowEffect ShadowDepth="4" Direction="270" Opacity="0.35" BlurRadius="16" />
                            </Border.Effect>
                            <ui:PassiveScrollViewer CanContentScroll="True"
                                                    HorizontalScrollBarVisibility="Disabled"
                                                    VerticalScrollBarVisibility="Auto"
                                                    MaxHeight="460">
                                <StackPanel IsItemsHost="True"
                                            KeyboardNavigation.DirectionalNavigation="Cycle" />
                            </ui:PassiveScrollViewer>
                        </Border>
                    </Popup>
                </Grid>
                <ControlTemplate.Triggers>
                    <Trigger Property="Icon" Value="{x:Null}">
                        <Setter TargetName="IconHost" Property="Visibility" Value="Collapsed" />
                    </Trigger>
                    <Trigger Property="IsChecked" Value="True">
                        <Setter TargetName="ActiveIndicator" Property="Visibility" Value="Visible" />
                    </Trigger>
                    <Trigger Property="IsHighlighted" Value="True">
                        <Setter TargetName="Border" Property="Background" Value="{DynamicResource MenuBarItemBackgroundSelected}" />
                    </Trigger>
                    <Trigger Property="IsEnabled" Value="False">
                        <Setter Property="Foreground" Value="{DynamicResource TextFillColorDisabledBrush}" />
                        <Setter TargetName="ActiveIndicator" Property="Opacity" Value="0.4" />
                        <Setter TargetName="Chevron" Property="Foreground" Value="{DynamicResource TextFillColorDisabledBrush}" />
                    </Trigger>
                    <Trigger Property="IsSubmenuOpen" Value="True">
                        <Trigger.EnterActions>
                            <BeginStoryboard>
                                <Storyboard>
                                    <DoubleAnimation Storyboard.TargetName="SubmenuBorder"
                                                     Storyboard.TargetProperty="(UIElement.RenderTransform).(TranslateTransform.Y)"
                                                     From="-8" To="0"
                                                     Duration="0:0:0.14">
                                        <DoubleAnimation.EasingFunction>
                                            <CircleEase EasingMode="EaseOut" />
                                        </DoubleAnimation.EasingFunction>
                                    </DoubleAnimation>
                                    <DoubleAnimation Storyboard.TargetName="SubmenuBorder"
                                                     Storyboard.TargetProperty="Opacity"
                                                     From="0.0" To="1.0"
                                                     Duration="0:0:0.12">
                                        <DoubleAnimation.EasingFunction>
                                            <CircleEase EasingMode="EaseOut" />
                                        </DoubleAnimation.EasingFunction>
                                    </DoubleAnimation>
                                </Storyboard>
                            </BeginStoryboard>
                        </Trigger.EnterActions>
                    </Trigger>
                </ControlTemplate.Triggers>
            </ControlTemplate>

            <!-- Universal Windows 11 Fluent MenuItem Style (Automatic for all existing and future context menus) -->
            <Style TargetType="{x:Type MenuItem}">
                <Setter Property="FontFamily" Value="{StaticResource AppFontFamily}" />
                <Setter Property="FontSize" Value="14" />
                <Setter Property="FontWeight" Value="Normal" />
                <Setter Property="Foreground" Value="{DynamicResource ContextMenuForeground}" />
                <Setter Property="RenderOptions.ClearTypeHint" Value="Enabled" />
                <Setter Property="TextOptions.TextFormattingMode" Value="Ideal" />
                <Setter Property="TextOptions.TextRenderingMode" Value="ClearType" />
                <Setter Property="TextOptions.TextHintingMode" Value="Fixed" />
                <Setter Property="SnapsToDevicePixels" Value="True" />
                <Setter Property="UseLayoutRounding" Value="True" />
                <Setter Property="MinHeight" Value="32" />
                <Setter Property="OverridesDefaultStyle" Value="True" />
                <Setter Property="Template" Value="{StaticResource UniversalFluentSubmenuItemTemplate}" />
                <Style.Triggers>
                    <Trigger Property="Role" Value="TopLevelItem">
                        <Setter Property="Template" Value="{StaticResource UniversalFluentSubmenuItemTemplate}" />
                    </Trigger>
                    <Trigger Property="Role" Value="SubmenuItem">
                        <Setter Property="Template" Value="{StaticResource UniversalFluentSubmenuItemTemplate}" />
                    </Trigger>
                    <Trigger Property="Role" Value="SubmenuHeader">
                        <Setter Property="Template" Value="{StaticResource UniversalFluentSubmenuHeaderTemplate}" />
                    </Trigger>
                    <Trigger Property="Role" Value="TopLevelHeader">
                        <Setter Property="Template" Value="{StaticResource UniversalFluentSubmenuHeaderTemplate}" />
                    </Trigger>
                </Style.Triggers>
            </Style>
        </ResourceDictionary>
    </Application.Resources>
</Application>