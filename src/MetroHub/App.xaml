<Application x:Class="MetroHub.App"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:local="clr-namespace:MetroHub"
             xmlns:conv="clr-namespace:MetroHub.Presentation.Converters"
             xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml">
    <Application.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ui:ThemesDictionary Theme="Dark" />
                <ui:ControlsDictionary />
                <ResourceDictionary Source="pack://application:,,,/MetroHub;component/Presentation/Themes/Tokens.xaml" />
                <ResourceDictionary Source="pack://application:,,,/MetroHub;component/Presentation/Themes/ControlStyles.xaml" />
                <ResourceDictionary Source="pack://application:,,,/MetroHub;component/Presentation/Themes/ContextMenuStyles.xaml" />
                <ResourceDictionary Source="pack://application:,,,/MetroHub;component/Presentation/Dialogs/MetroDialog.xaml" />
                <ResourceDictionary Source="pack://application:,,,/MetroHub;component/Widgets/WidgetStyles.xaml" />
            </ResourceDictionary.MergedDictionaries>

            <conv:IconPathToBitmapConverter x:Key="IconConverter" />

            <!-- Global High-DPI Crisp Font Rendering Enforcement -->
            <Style TargetType="{x:Type Window}">
                <Setter Property="TextOptions.TextFormattingMode" Value="Ideal" />
                <Setter Property="TextOptions.TextRenderingMode" Value="ClearType" />
            </Style>
            <Style TargetType="{x:Type TextBlock}">
                <Setter Property="TextOptions.TextFormattingMode" Value="Ideal" />
            </Style>
        </ResourceDictionary>
    </Application.Resources>
</Application>