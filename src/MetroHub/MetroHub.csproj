<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0-windows10.0.19041.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <UseWPF>true</UseWPF>
    <ApplicationIcon>Assets\app.ico</ApplicationIcon>
    <NoWarn>$(NoWarn);NU1701</NoWarn>
    <!-- Performance & Footprint Flags -->
    <ServerGarbageCollection>false</ServerGarbageCollection>
    <TieredPGO>true</TieredPGO>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="CommunityToolkit.Mvvm" Version="8.4.2" />
    <PackageReference Include="Dubya.WindowsMediaController" Version="2.5.6" />
    <PackageReference Include="gong-wpf-dragdrop" Version="4.0.0" />
    <PackageReference Include="Hardcodet.NotifyIcon.Wpf" Version="2.0.1" />
    <PackageReference Include="Microsoft.Xaml.Behaviors.Wpf" Version="1.1.158" />
    <PackageReference Include="System.Management" Version="9.0.0" />
    <PackageReference Include="WPF-UI" Version="3.0.4" />
  </ItemGroup>

  <ItemGroup>
    <Resource Include="Assets\Fonts\**\*.ttf" />
    <None Remove="Assets\*.png" />
    <Resource Include="Assets\*.png" />
    <None Remove="Assets\Weather\*.png" />
    <Resource Include="Assets\Weather\*.png" />
    <None Remove="Assets\Weather\Meteocons\*.png" />
    <Resource Include="Assets\Weather\Meteocons\*.png" />
    <None Remove="Assets\Weather\Glassmorphic\*.png" />
    <Resource Include="Assets\Weather\Glassmorphic\*.png" />
    <None Remove="Assets\quotes.json" />
    <Resource Include="Assets\quotes.json" />
    <None Remove="Assets\Rover\*.png" />
    <Resource Include="Assets\Rover\*.png" />
    <None Remove="Assets\Rover\*.json" />
    <Resource Include="Assets\Rover\*.json" />
    <None Remove="Assets\Rover\Sounds\*.mp3" />
    <Resource Include="Assets\Rover\Sounds\*.mp3" />
    <Content Include="Assets\Rover\Sounds\*.mp3">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </Content>
    <None Update="Assets\**">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </None>
  </ItemGroup>

</Project>
