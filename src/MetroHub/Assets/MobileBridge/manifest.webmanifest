{
  "id": "metrohub-phone-bridge",
  "name": "MetroHub Phone Bridge",
  "short_name": "MetroHub",
  "description": "Send links, notes, and photos from this phone straight onto your MetroHub canvas over local Wi-Fi.",
  "start_url": "./",
  "scope": "./",
  "display": "standalone",
  "display_override": [ "standalone" ],
  "orientation": "portrait",
  "background_color": "#0f1115",
  "theme_color": "#0f1115",
  "icons": [
    { "src": "icon-192.png", "sizes": "192x192", "type": "image/png", "purpose": "any" },
    { "src": "icon-512.png", "sizes": "512x512", "type": "image/png", "purpose": "any" },
    { "src": "icon-512.png", "sizes": "512x512", "type": "image/png", "purpose": "maskable" }
  ],
  "share_target": {
    "action": "share-target",
    "method": "POST",
    "enctype": "multipart/form-data",
    "params": {
      "title": "title",
      "text": "text",
      "url": "url",
      "files": [
        {
          "name": "photos",
          "accept": ["image/*"]
        }
      ]
    }
  }
}
