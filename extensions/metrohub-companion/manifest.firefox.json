{
  "manifest_version": 3,
  "name": "MetroHub Companion",
  "version": "1.0.0",
  "description": "Send links directly to your MetroHub desktop canvas as customizable tiles.",
  "permissions": [
    "activeTab",
    "contextMenus",
    "storage"
  ],
  "host_permissions": [
    "http://127.0.0.1:48842/*",
    "http://127.0.0.1:48843/*",
    "http://127.0.0.1:48844/*",
    "http://127.0.0.1:48845/*",
    "http://127.0.0.1:48846/*"
  ],
  "action": {
    "default_popup": "popup.html",
    "default_icon": {
      "16": "icons/icon16.png",
      "48": "icons/icon48.png",
      "128": "icons/icon128.png"
    }
  },
  "icons": {
    "16": "icons/icon16.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "background": {
    "scripts": ["background.js"]
  },
  "commands": {
    "pin_tab": {
      "suggested_key": {
        "default": "Alt+M"
      },
      "description": "Send active tab to MetroHub"
    }
  },
  "browser_specific_settings": {
    "gecko": {
      "id": "companion@metrohub.local"
    }
  }
}
